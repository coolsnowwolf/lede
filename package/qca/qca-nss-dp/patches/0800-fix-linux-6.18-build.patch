From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] qca-nss-dp: consume external compiler flags

Linux 6.18 no longer consumes EXTRA_CFLAGS in the top-level Kbuild.
Add the package-provided include paths to the module flags directly.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/Makefile
+++ b/Makefile
@@ -119,5 +119,6 @@
 endif
 
 ccflags-y += $(NSS_DP_INCLUDE)
+ccflags-y += $(EXTRA_CFLAGS)
 ccflags-y += -Wall -Werror
 ccflags-y += -DEDMA_DEBUG_LEVEL=2
--- a/nss_dp_main.c
+++ b/nss_dp_main.c
@@ -19,6 +19,7 @@
 #include "nss_dp_dev.h"
 
 #include <linux/kernel.h>
+#include <linux/hash.h>
 #include <linux/module.h>
 #include <linux/version.h>
 #include <linux/of.h>
@@ -526,7 +527,11 @@
 	}
 
 	hash = skb_get_hash(skb);
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+	rxflow = &flow_table->flows[hash_32(hash, flow_table->log)];
+#else
 	rxflow = &flow_table->flows[hash & flow_table->mask];
+#endif
 	rxcpu = (uint32_t)rxflow->cpu;
 
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 9, 0))
@@ -1093,7 +1098,9 @@
 
 static struct platform_driver nss_dp_drv = {
 	.probe = nss_dp_probe,
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0))
+	#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+	.remove = nss_dp_remove,
+	#elif (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0))
 	.remove_new = nss_dp_remove,
 #else
 	.remove = nss_dp_remove,
