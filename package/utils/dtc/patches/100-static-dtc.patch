From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] meson: build dtc statically on request

The Meson --prefer-static option only changes library preference and does
not make the resulting executable static.  Restore an explicit option that
links dtc against the static libfdt target and passes -static only to dtc.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/meson.build
+++ b/meson.build
@@ -55,10 +55,17 @@
 subdir('libfdt')
 
 dtc_tools = []
+libfdt_tools_dep = libfdt_dep
+if get_option('static-build')
+  libfdt_tools_dep = declare_dependency(
+    include_directories: libfdt_inc,
+    link_with: libfdt.get_static_lib(),
+  )
+endif
 util_dep = declare_dependency(
   sources: ['util.c', version_gen_h],
   include_directories: '.',
-  dependencies: libfdt_dep
+  dependencies: libfdt_tools_dep
 )
 
 if get_option('tools') and not wheel_only
@@ -105,6 +112,7 @@
       yamltree,
     ],
     dependencies: [util_dep, yaml],
+    link_args: get_option('static-build') ? ['-static'] : [],
     install: true,
   )
 
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -10,5 +10,7 @@
        description: 'Build pylibfdt Python library')
 option('tests', type: 'boolean', value: true,
        description: 'Build tests')
+option('static-build', type: 'boolean', value: false,
+       description: 'Build dtc as a static executable')
 option('wheel-only', type: 'boolean', value: false,
        description: 'building from meson-python')
