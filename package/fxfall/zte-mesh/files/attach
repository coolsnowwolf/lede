#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# The controller's sandbox hands one end of its private wire to this
# namespace as "lab-peer". Rename it and keep it in the LAN bridge. Every
# sandbox start creates a fresh wire, so this has to run for the whole life
# of the service.

BR=${1:-br-lan}
PORT=zmesh0

while :; do
	if [ -d "/sys/class/net/lab-peer" ]; then
		ip link set dev lab-peer name "$PORT" 2>/dev/null
	fi
	if [ -d "/sys/class/net/$PORT" ] && [ ! -e "/sys/class/net/$BR/brif/$PORT" ]; then
		ip link set dev "$PORT" master "$BR" 2>/dev/null &&
			ip link set dev "$PORT" up 2>/dev/null &&
			logger -t zte-mesh "attached $PORT to $BR"
	fi
	sleep 1
done
