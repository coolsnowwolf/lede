msgid "ZTE SQM"
msgstr "ZTE 硬件 SQM"

msgid "Manage WAN upload and download rates with the SR1010 hardware shaper."
msgstr "使用 SR1010 硬件整形器管理 WAN 上传和下载速率。"

msgid "WAN SQM"
msgstr "WAN 流量整形"

msgid "Enable SQM"
msgstr "启用 SQM"

msgid "WAN interface"
msgstr "WAN 接口"

msgid "eth0 (SR1010 physical WAN)"
msgstr "eth0（SR1010 物理 WAN 口）"

msgid "The NPU hardware shaper currently supports the physical WAN device eth0. PPPoE and VLAN interfaces are not valid shaper targets."
msgstr "当前 NPU 硬件整形仅支持物理 WAN 设备 eth0；PPPoE 和 VLAN 虚拟接口不能作为整形目标。"

msgid "Upload limit (kbit/s)"
msgstr "上传限速（kbit/s）"

msgid "0 disables upload shaping. NPU hardware mode supports up to 2500000 kbit/s."
msgstr "设为 0 表示不限制上传；NPU 硬件模式最高支持 2500000 kbit/s。"

msgid "Download limit (kbit/s)"
msgstr "下载限速（kbit/s）"

msgid "0 disables download shaping. In NPU mode the rate is shared across all queues on the LAN conduit."
msgstr "设为 0 表示不限制下载；NPU 模式下，下载速率由 LAN 通道的端口整形器在所有队列间统一限制。"

msgid "Traffic priority mode"
msgstr "流量优先模式"

msgid "Balanced"
msgstr "均衡模式"

msgid "Balanced mode assigns each TCP/UDP hardware flow direction independently to NPU queues 1-7 from its flow tuple."
msgstr "均衡模式根据流表五元组，分别把 TCP/UDP 硬件流的两个方向分配到 NPU 队列 1–7。"
