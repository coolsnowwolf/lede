{
	"luci-app-zte-sqm": {
		"description": "Control SR1010 pure NPU hardware SQM",
		"read": {
			"file": {
				"/etc/init.d/sqm-npu enable": [ "exec" ],
				"/etc/init.d/sqm-npu reload": [ "exec" ],
				"/etc/init.d/sqm-npu disable": [ "exec" ],
				"/etc/init.d/sqm-npu stop": [ "exec" ]
			},
			"uci": [ "sqm-npu" ]
		},
		"write": {
			"uci": [ "sqm-npu" ]
		}
	}
}
