msgstr "下次启动"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:94
#: htdocs/luci-static/resources/view/system/zte-fwslot.js:123
msgid "State"
msgstr "状态"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:45
msgid "Switch and reboot"
msgstr "切换并重启"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:32
#: htdocs/luci-static/resources/view/system/zte-fwslot.js:51
msgid "Switch firmware slot"
msgstr "切换固件槽位"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:109
msgid "Switch to slot %d (%s) and reboot"
msgstr "切换到槽位 %d（%s）并重启"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:91
#: htdocs/luci-static/resources/view/system/zte-fwslot.js:120
msgid "System"
msgstr "系统"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:78
msgid "The firmware slots cannot be read: %s"
msgstr "无法读取固件槽位：%s"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:103
msgid "The other slot holds no firmware."
msgstr "另一个槽位里没有固件。"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:33
msgid ""
"The router checks the firmware in slot %d (%s). If it is intact, the router "
"restarts into it. Nothing is erased."
msgstr "路由器会先检查槽位 %d（%s）中的固件，确认完好后重启进入该系统。不会擦除任何内容。"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:58
#: htdocs/luci-static/resources/view/system/zte-fwslot.js:67
msgid "The router did not switch: %s"
msgstr "路由器没有切换：%s"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:115
msgid ""
"The router has two firmware slots. Each holds a complete system, for example "
"this one and the vendor firmware. The router starts the slot that was "
"installed or selected last. Switching erases nothing."
msgstr "路由器有两个固件槽位，每个槽位存放一个完整的系统，例如当前系统和原厂固件。路由器启动最近安装或最近选择的那个槽位。切换不会擦除任何内容。"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:63
msgid ""
"The router is restarting into slot %d. This page does not reload by itself, "
"because the other system may use a different address."
msgstr "路由器正在重启进入槽位 %d。由于另一个系统可能使用不同的地址，本页面不会自动刷新。"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:101
msgid "The running slot is unknown, so switching is not available."
msgstr "无法确定当前运行的槽位，因此不能切换。"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:35
msgid "The web interface of that system may be at a different address."
msgstr "该系统的网页界面可能使用不同的地址。"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:23
msgid "Vendor firmware"
msgstr "原厂固件"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:92
#: htdocs/luci-static/resources/view/system/zte-fwslot.js:121
msgid "Version"
msgstr "版本"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:78
msgid "no slot information"
msgstr "没有槽位信息"

#: htdocs/luci-static/resources/view/system/zte-fwslot.js:58
msgid "unknown error"
msgstr "未知错误"
