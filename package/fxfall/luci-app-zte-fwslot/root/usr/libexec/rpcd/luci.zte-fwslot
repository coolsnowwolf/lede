#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# rpcd plugin for the firmware slot page: shows the two firmware slots of the
# ZXSLC SR1010 and starts the other one.
#
#   ubus call luci.zte-fwslot info
#   ubus call luci.zte-fwslot switch '{"reboot":true}'

FWSLOT=${ZTE_FWSLOT:-/usr/sbin/zte-fwslot}

# Text for use inside a JSON string.
esc() {
	printf '%s' "$1" | tr '\n\t' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

case "$1" in
list)
	printf '{ "info": {}, "switch": { "reboot": true } }\n'
	;;
call)
	case "$2" in
	info)
		if out=$("$FWSLOT" info -j 2>&1); then
			printf '%s\n' "$out"
		else
			printf '{ "error": "%s" }\n' "$(esc "$out")"
		fi
		;;
	switch)
		read -r input
		msg=$("$FWSLOT" switch 2>&1)
		rc=$?
		printf '{ "result": %d, "message": "%s" }\n' "$rc" "$(esc "$msg")"

		# Give rpcd time to hand the answer to the browser first. The
		# subshell must not keep rpcd's pipes open.
		if [ "$rc" -eq 0 ] &&
		   printf '%s' "$input" | grep -Eq '"reboot"[[:space:]]*:[[:space:]]*true'; then
			( sleep 3; sync; reboot ) >/dev/null 2>&1 </dev/null &
		fi
		;;
	esac
	;;
esac
