From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] tools: stm32image: support Darwin byte order conversions

Use the macOS SDK byte order helpers on Darwin, which has no Linux
asm/byteorder.h. Keep the Linux include and conversion definitions intact.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/tools/stm32image/stm32image.c
+++ b/tools/stm32image/stm32image.c
@@ -4,7 +4,14 @@
  * SPDX-License-Identifier: BSD-3-Clause
  */
 
+#ifdef __APPLE__
+#include <libkern/OSByteOrder.h>
+#define __be32_to_cpu(x) OSSwapBigToHostInt32(x)
+#define __le32_to_cpu(x) OSSwapLittleToHostInt32(x)
+#define __cpu_to_le32(x) OSSwapHostToLittleInt32(x)
+#else
 #include <asm/byteorder.h>
+#endif
 #include <errno.h>
 #include <fcntl.h>
 #include <stdint.h>
