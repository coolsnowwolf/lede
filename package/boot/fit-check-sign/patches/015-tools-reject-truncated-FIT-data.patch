From: lean <chenlin@fnnas.com>
Subject: [PATCH] tools: reject truncated FIT data before verifying hashes

Validate the FDT and all image payload ranges against the mapped file
before hash verification to avoid SIGBUS on truncated external FIT data.

Signed-off-by: lean <chenlin@fnnas.com>
---
--- a/tools/fit_check_sign.c
+++ b/tools/fit_check_sign.c
@@ -23,6 +23,29 @@
 #include <image.h>
 #include <u-boot/crc.h>
 
+static int fit_file_check_bounds(const void *fit, size_t file_size)
+{
+	int images, node;
+
+	if (fdt_check_full(fit, file_size))
+		return -1;
+	images = fdt_path_offset(fit, "/images");
+	if (images < 0)
+		return -1;
+
+	fdt_for_each_subnode(node, fit, images) {
+		const void *data;
+		size_t size, offset;
+
+		if (fit_image_get_data(fit, node, &data, &size))
+			return -1;
+		offset = (uintptr_t)data - (uintptr_t)fit;
+		if (offset > file_size || size > file_size - offset)
+			return -1;
+	}
+	return 0;
+}
+
 static void usage(char *cmdname)
 {
 	fprintf(stderr, "Usage: %s -f fit file -k key file -c config name\n"
@@ -74,6 +97,12 @@
 	ffd = mmap_fdt(cmdname, fdtfile, 0, &fit_blob, &fsbuf, false, true);
 	if (ffd < 0)
 		return EXIT_FAILURE;
+	if (fit_file_check_bounds(fit_blob, fsbuf.st_size)) {
+		fprintf(stderr, "%s: Truncated or invalid FIT image\n", cmdname);
+		munmap(fit_blob, fsbuf.st_size);
+		close(ffd);
+		return EXIT_FAILURE;
+	}
 	if (keyfile) {
 		kfd = mmap_fdt(cmdname, keyfile, 0, &key_blob, &ksbuf, false, true);
 		if (kfd < 0)
