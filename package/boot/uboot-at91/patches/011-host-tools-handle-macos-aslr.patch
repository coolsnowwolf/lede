From: Sergey V. Lobanov <sergey@lobanov.in>
Subject: [PATCH] mkimage: fix segfault on macOS arm64

Adjust the Mach-O section address by the runtime image slide when
locating the image type pointer table in a position-independent tool.

Upstream: https://github.com/u-boot/u-boot/commit/54ee416050f1d0b3c93d6ec1708f5925e57aa6bf
Reviewed-by: Jessica Clarke <jrtc27@jrtc27.com>
Signed-off-by: Sergey V. Lobanov <sergey@lobanov.in>
Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/tools/imagetool.h
+++ b/tools/imagetool.h
@@ -265,11 +265,13 @@
  *  b) we need a API call to get the respective section symbols */
 #if defined(__MACH__)
 #include <mach-o/getsect.h>
+#include <mach-o/dyld.h>
 
 #define INIT_SECTION(name)  do {					\
 		unsigned long name ## _len;				\
 		char *__cat(pstart_, name) = getsectdata("__DATA",	\
 			#name, &__cat(name, _len));			\
+		__cat(pstart_, name) += _dyld_get_image_vmaddr_slide(0);\
 		char *__cat(pstop_, name) = __cat(pstart_, name) +	\
 			__cat(name, _len);				\
 		__cat(__start_, name) = (void *)__cat(pstart_, name);	\
