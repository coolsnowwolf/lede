From 772c66821241fd432fec3f1b92d41b3dab39923b Mon Sep 17 00:00:00 2001
From: Vitaliy Sochnev <sochnev.v.74@gmail.com>
Date: Sun, 20 Sep 2026 17:13:07 +0300
Subject: [PATCH] airoha: add TRNG node in AN7583 dtsi

The AN7583 has the same True Random Number Generator block as the
EN7581, at the same address and on the same interrupt.

Signed-off-by: Vitaliy Sochnev <sochnev.v.74@gmail.com>
---
 arch/arm/dts/an7583.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

--- a/arch/arm/dts/an7583.dtsi
+++ b/arch/arm/dts/an7583.dtsi
@@ -252,6 +252,12 @@
 			status = "disable";
 		};
 
+		rng@1faa1000 {
+			compatible = "airoha,en7581-trng";
+			reg = <0x0 0x1faa1000 0x0 0xc04>;
+			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
 		snfi: spi@1fa10000 {
 			compatible = "airoha,en7581-snand";
 			reg = <0x0 0x1fa10000 0x0 0x140>,
