Subject: [PATCH] powerpc: mpc85xx: support building with a 64-bit toolchain

The generic PowerPC BFD architecture can resolve to common64 when the
linker defaults to powerpc64, even with the ELF32 emulation selected.
Select the 32-bit architecture explicitly for U-Boot and SPL.

Use the existing 64-by-32 division helper in PAMU so the private libgcc
implementation does not need a compiler-provided __udivdi3 routine.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/arch/powerpc/cpu/mpc85xx/u-boot.lds
+++ b/arch/powerpc/cpu/mpc85xx/u-boot.lds
@@ -11,7 +11,7 @@
 #define RESET_VECTOR_ADDRESS	0xfffffffc
 #endif
 
-OUTPUT_ARCH(powerpc)
+OUTPUT_ARCH(powerpc:common)
 ENTRY(_start)
 
 SECTIONS
--- a/arch/powerpc/cpu/mpc85xx/u-boot-spl.lds
+++ b/arch/powerpc/cpu/mpc85xx/u-boot-spl.lds
@@ -8,7 +8,7 @@
 
 #include "config.h"
 
-OUTPUT_ARCH(powerpc)
+OUTPUT_ARCH(powerpc:common)
 
 SECTIONS
 {
--- a/arch/powerpc/cpu/mpc8xxx/fsl_pamu.c
+++ b/arch/powerpc/cpu/mpc8xxx/fsl_pamu.c
@@ -9,6 +9,7 @@
 #include <log.h>
 #include <linux/bitops.h>
 #include <linux/log2.h>
+#include <linux/math64.h>
 #include <malloc.h>
 #include <asm/fsl_pamu.h>
 #include <asm/io.h>
@@ -364,7 +365,7 @@
 {
 	uint32_t win_cnt = DEFAULT_NUM_SUBWINDOWS;
 
-	while (win_cnt && (size/win_cnt) < PAMU_PAGE_SIZE)
+	while (win_cnt && div_u64(size, win_cnt) < PAMU_PAGE_SIZE)
 		win_cnt >>= 1;
 
 	return win_cnt;
