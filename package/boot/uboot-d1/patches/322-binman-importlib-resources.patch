From: Yannic Moog <y.moog@phytec.de>
Subject: [PATCH] binman: replace pkg_resources with importlib.resources

Adapt U-Boot commit 538719cb6a77934d069e0e64f264457a59a9ebfc to
2024.01 so binman works without the removed setuptools pkg_resources
module. Use package-relative resources as upstream does, retaining
read_binary and contents for Python versions before the files API.

Signed-off-by: Yannic Moog <y.moog@phytec.de>
Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/tools/binman/control.py
+++ b/tools/binman/control.py
@@ -8,12 +8,11 @@
 from collections import OrderedDict
 import glob
 try:
-    import importlib.resources
+    import importlib.resources as importlib_resources
 except ImportError:  # pragma: no cover
     # for Python 3.6
     import importlib_resources
 import os
-import pkg_resources
 import re
 
 import sys
@@ -96,7 +95,10 @@
             msg = ''
         return tag, msg
 
-    my_data = pkg_resources.resource_string(__name__, 'missing-blob-help')
+    if hasattr(importlib_resources, 'files'):
+        my_data = importlib_resources.files(__package__).joinpath('missing-blob-help').read_bytes()
+    else:
+        my_data = importlib_resources.read_binary(__package__, 'missing-blob-help')
     re_tag = re.compile('^([-a-z0-9]+):$')
     result = {}
     tag = None
@@ -151,8 +153,13 @@
     Returns:
         Set of paths to entry class filenames
     """
-    glob_list = pkg_resources.resource_listdir(__name__, 'etype')
-    glob_list = [fname for fname in glob_list if fname.endswith('.py')]
+    if hasattr(importlib_resources, 'files'):
+        entries = importlib_resources.files(__package__).joinpath('etype')
+        glob_list = [entry.name for entry in entries.iterdir()
+                     if entry.name.endswith('.py') and entry.is_file()]
+    else:
+        glob_list = [fname for fname in importlib_resources.contents(__package__ + '.etype')
+                     if fname.endswith('.py')]
     return set([os.path.splitext(os.path.basename(item))[0]
                 for item in glob_list
                 if include_testing or '_testing' not in item])
@@ -735,7 +742,7 @@
     global state
 
     if args.full_help:
-        with importlib.resources.path('binman', 'README.rst') as readme:
+        with importlib_resources.path('binman', 'README.rst') as readme:
             tools.print_full_help(str(readme))
         return 0
 
