Subject: [PATCH] pylibfdt: link Python extensions as bundles on Darwin

Allow the Python interpreter to resolve Python C API symbols when loading
its extension module on macOS. Preserve the shared-link flags on Linux.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/scripts/dtc/pylibfdt/Makefile
+++ b/scripts/dtc/pylibfdt/Makefile
@@ -18,7 +18,7 @@
 
 quiet_cmd_pymod = PYMOD   $@
       cmd_pymod = unset CROSS_COMPILE; unset CFLAGS; \
-		CC="$(HOSTCC)" LDSHARED="$(HOSTCC) -shared " \
+		CC="$(HOSTCC)" LDSHARED="$(HOSTCC) $(if $(filter Darwin,$(shell uname -s)),-bundle -undefined dynamic_lookup,-shared)" \
 		LDFLAGS="$(HOSTLDFLAGS)" \
 		VERSION="$(PEP_VERSION)" \
 		CPPFLAGS="$(HOSTCFLAGS) -I$(LIBFDT_srcdir)" OBJDIR=$(obj) \
