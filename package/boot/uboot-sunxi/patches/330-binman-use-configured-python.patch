Subject: [PATCH] binman: run with the configured Python interpreter

Use the same Python interpreter as pylibfdt instead of looking up python3
again through the binman shebang. This prevents loading a module built
for another Python ABI when host tools become available during a build.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/Makefile
+++ b/Makefile
@@ -1671,7 +1671,7 @@
 endif
 
 quiet_cmd_binman = BINMAN  $@
-cmd_binman = $(srctree)/tools/binman/binman $(if $(BINMAN_DEBUG),-D) \
+cmd_binman = $(PYTHON3) $(srctree)/tools/binman/binman $(if $(BINMAN_DEBUG),-D) \
 		$(foreach f,$(BINMAN_TOOLPATHS),--toolpath $(f)) \
                 --toolpath $(objtree)/tools \
 		$(if $(BINMAN_VERBOSE),-v$(BINMAN_VERBOSE)) \
