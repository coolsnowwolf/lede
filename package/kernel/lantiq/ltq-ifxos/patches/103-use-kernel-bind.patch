From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] ifxos: use kernel_bind for socket binding

Use the kernel socket helper instead of guessing the proto_ops bind
argument type from the kernel stable version. The sockaddr_unsized
conversion is not present in every kernel carrying that version.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/src/linux/ifxos_linux_socket_drv.c
+++ b/src/linux/ifxos_linux_socket_drv.c
@@ -249,11 +249,7 @@
 
    IFXOS_RETURN_IF_POINTER_NULL(pSocAddr, IFX_ERROR);
 
-#if LINUX_VERSION_CODE < KERNEL_VERSION(6,18,57)
-   ret = (socFd->ops->bind(socFd, (struct sockaddr*) pSocAddr, sizeof(IFXOS_sockAddr_t)));
-#else
-   ret = (socFd->ops->bind(socFd, (struct sockaddr_unsized*) pSocAddr, sizeof(IFXOS_sockAddr_t)));
-#endif
+   ret = kernel_bind(socFd, (struct sockaddr *) pSocAddr, sizeof(IFXOS_sockAddr_t));
 
    if (ret != 0)
    {
