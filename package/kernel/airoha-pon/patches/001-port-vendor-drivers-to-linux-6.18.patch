+static int sif_addr_bytes(u32 word_addr, u8 word_addr_len, u8 *buf)
+{
+	int i;
+
+	if (!word_addr_len || word_addr_len > sizeof(word_addr))
+		return -EINVAL;
 
-	led_init();
-	gpioctl_init();
+	for (i = 0; i < word_addr_len; i++)
+		buf[i] = word_addr >> (8 * (word_addr_len - i - 1));
 
 	return 0;
 }
 
-static void __exit legacy_api_exit(void)
+u16 SIF_X_Read(u8 channel, u16 clk_div, u8 dev_addr, u8 word_addr_len,
+		u32 word_addr, u8 *buf, u16 len)
 {
-	led_exit();
-	gpioctl_exit();
-	remove_proc_entry("legacy_api", NULL);
-	printk("legacy_api_removed\n");
+	struct i2c_adapter *adap;
+	struct i2c_msg msgs[2];
+	u8 addr_buf[sizeof(word_addr)];
+	int ret;
+
+	(void)clk_div;
+	ret = sif_addr_bytes(word_addr, word_addr_len, addr_buf);
+	if (ret)
+		return 0;
+
+	adap = i2c_get_adapter(channel);
+	if (!adap)
+		return 0;
+
+	msgs[0] = (struct i2c_msg) {
+		.addr = dev_addr & 0x7f,
+		.buf = addr_buf,
+		.len = word_addr_len,
+	};
+	msgs[1] = (struct i2c_msg) {
+		.addr = dev_addr & 0x7f,
+		.flags = I2C_M_RD,
+		.buf = buf,
+		.len = len,
+	};
+	ret = i2c_transfer(adap, msgs, ARRAY_SIZE(msgs));
+	i2c_put_adapter(adap);
+
+	return ret == ARRAY_SIZE(msgs);
 }
+EXPORT_SYMBOL(SIF_X_Read);
 
-module_init(legacy_api_init);
-module_exit(legacy_api_exit);
+u16 SIF_X_Write(u8 channel, u16 clk_div, u8 dev_addr, u8 word_addr_len,
+		u32 word_addr, u8 *buf, u16 len)
+{
+	struct i2c_adapter *adap;
+	struct i2c_msg msg;
+	u8 *transfer_buf;
+	int ret;
+
+	(void)clk_div;
+	if (!word_addr_len || word_addr_len > sizeof(word_addr))
+		return 0;
+
+	transfer_buf = kmalloc(word_addr_len + len, GFP_KERNEL);
+	if (!transfer_buf)
+		return 0;
+	if (sif_addr_bytes(word_addr, word_addr_len, transfer_buf)) {
+		kfree(transfer_buf);
+		return 0;
+	}
+	memcpy(transfer_buf + word_addr_len, buf, len);
+
+	adap = i2c_get_adapter(channel);
+	if (!adap) {
+		kfree(transfer_buf);
+		return 0;
+	}
+	msg = (struct i2c_msg) {
+		.addr = dev_addr & 0x7f,
+		.buf = transfer_buf,
+		.len = word_addr_len + len,
+	};
+	ret = i2c_transfer(adap, &msg, 1);
+	i2c_put_adapter(adap);
+	kfree(transfer_buf);
 
-MODULE_LICENSE("GPL");
-MODULE_DESCRIPTION("Legacy API driver");
+	return ret == 1;
+}
+EXPORT_SYMBOL(SIF_X_Write);
