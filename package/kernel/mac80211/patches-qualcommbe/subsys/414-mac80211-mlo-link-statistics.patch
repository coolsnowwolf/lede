 	u32 _portid, i;
@@ -2328,8 +2363,10 @@ static void mac80211_hwsim_tx(struct iee
 								 hdr, &link_sta);
 		}
 
-		if (link_sta)
+		if (link_sta) {
 			peer = link_sta;
+			tx_link_sta = link_sta;
+		}
 
 		if (unlikely(!bss_conf)) {
 			/* if it's an MLO STA, it might have deactivated all
@@ -2424,6 +2461,10 @@ static void mac80211_hwsim_tx(struct iee
 			return;
 	}
 
+	if (tx_link_sta && control->sta->valid_links)
+		mac80211_hwsim_link_tx_account(tx_link_sta, skb, tx_len,
+					       channel->band);
+
 	/* wmediumd mode check */
 	_portid = READ_ONCE(data->wmediumd);
 
@@ -3030,6 +3071,7 @@ static int mac80211_hwsim_sta_add(struct
 		     sta->valid_links);
 		sp->active_links_rx = sta->valid_links;
 	}
+	sp->link_tx_valid = sta->valid_links;
 
 	spin_lock_init(&sp->nan_sched.lock);
 
@@ -3740,15 +3782,59 @@ static int mac80211_hwsim_change_sta_lin
 					   u16 old_links, u16 new_links)
 {
 	struct hwsim_sta_priv *sp = (void *)sta->drv_priv;
+	unsigned long added = sta->valid_links & ~sp->link_tx_valid;
+	unsigned int link_id;
 
 	hwsim_check_sta_magic(sta);
 
 	if (vif->type == NL80211_IFTYPE_STATION)
 		sp->active_links_rx = new_links;
 
+	/* old_links and new_links hold active links only */
+	for_each_set_bit(link_id, &added, IEEE80211_MLD_MAX_NUM_LINKS)
+		memset(&sp->link_tx[link_id], 0, sizeof(sp->link_tx[link_id]));
+	sp->link_tx_valid = sta->valid_links;
+
 	return 0;
 }
 
+static void
+mac80211_hwsim_link_sta_statistics(struct ieee80211_hw *hw,
+				   struct ieee80211_vif *vif,
+				   struct ieee80211_link_sta *link_sta,
+				   struct link_station_info *link_sinfo)
+{
+	struct hwsim_sta_priv *sp = (void *)link_sta->sta->drv_priv;
+	struct hwsim_link_tx_stats *stats = &sp->link_tx[link_sta->link_id];
+	struct ieee80211_tx_rate rate;
+	enum nl80211_band band;
+	int ac;
+
+	link_sinfo->tx_bytes = 0;
+	link_sinfo->tx_packets = 0;
+	link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_BYTES64) |
+			      BIT_ULL(NL80211_STA_INFO_TX_PACKETS);
+
+	if (READ_ONCE(stats->link_sta) != link_sta)
+		return;
+
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		link_sinfo->tx_bytes += stats->bytes[ac];
+		link_sinfo->tx_packets += stats->packets[ac];
+	}
+
+	rate = stats->last_rate;
+	smp_rmb();
+	band = READ_ONCE(stats->band);
+
+	if (!ieee80211_rate_valid(&rate))
+		return;
+
+	ieee80211_tx_rate_to_rate_info(hw->wiphy->bands[band], &rate,
+				       &link_sinfo->txrate);
+	link_sinfo->filled |= BIT_ULL(NL80211_STA_INFO_TX_BITRATE);
+}
+
