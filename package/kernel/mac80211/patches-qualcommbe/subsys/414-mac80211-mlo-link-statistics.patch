--- a/drivers/net/wireless/virtual/mac80211_hwsim_i.h
+++ b/drivers/net/wireless/virtual/mac80211_hwsim_i.h
@@ -24,11 +24,23 @@ struct hwsim_sta_nan_sched {
 	} maps[CFG80211_NAN_MAX_PEER_MAPS];
 };
 
+struct hwsim_link_tx_stats {
+	const struct ieee80211_link_sta *link_sta;
+	u64 bytes[IEEE80211_NUM_ACS];
+	u32 packets[IEEE80211_NUM_ACS];
+	struct ieee80211_tx_rate last_rate;
+	enum nl80211_band band;
+};
+
 struct hwsim_sta_priv {
 	u32 magic;
 	unsigned int last_link;
 	u16 active_links_rx;
 
+	/* mac80211 books TX on the default link only */
+	struct hwsim_link_tx_stats link_tx[IEEE80211_MLD_MAX_NUM_LINKS];
+	u16 link_tx_valid;
+
 	/* NAN peer schedule - must be accessed under nan_sched.lock */
 	struct hwsim_sta_nan_sched nan_sched;
 };
--- a/drivers/net/wireless/virtual/mac80211_hwsim_main.c
+++ b/drivers/net/wireless/virtual/mac80211_hwsim_main.c
@@ -2255,6 +2255,39 @@ static void mac80211_hwsim_tx_rate_fill(
 		mac80211_hwsim_tx_ht(rate, peer, bw);
 }
 
+/* Counted as ieee80211_tx_h_stats() counts on the default link: the length
+ * before encryption, and one packet for all fragments of an MSDU.
+ */
+static void mac80211_hwsim_link_tx_account(struct ieee80211_link_sta *link_sta,
+					   struct sk_buff *skb, unsigned int len,
+					   enum nl80211_band band)
+{
+	struct hwsim_sta_priv *sp = (void *)link_sta->sta->drv_priv;
+	struct hwsim_link_tx_stats *stats = &sp->link_tx[link_sta->link_id];
+	struct ieee80211_tx_rate *rate = &IEEE80211_SKB_CB(skb)->control.rates[0];
+	struct ieee80211_hdr *hdr = (void *)skb->data;
+	int ac = skb_get_queue_mapping(skb);
+
+	/* mac80211 may not report the removal of a link added again */
+	if (READ_ONCE(stats->link_sta) != link_sta) {
+		memset(stats, 0, sizeof(*stats));
+		WRITE_ONCE(stats->link_sta, link_sta);
+	}
+
+	stats->bytes[ac] += len;
+	if (ieee80211_is_ctl(hdr->frame_control) ||
+	    ieee80211_is_first_frag(hdr->seq_ctrl))
+		stats->packets[ac]++;
+
+	if (!ieee80211_is_data(hdr->frame_control) || !ieee80211_rate_valid(rate))
+		return;
+
+	/* the reader takes no lock: a rate is never read against an older band */
+	WRITE_ONCE(stats->band, band);
+	smp_wmb();
+	stats->last_rate = *rate;
+}
+
