+/* The ids a ring hands out, as a table indexed by id with a stack of the
+ * free ones: the descriptor cookie names the buffer directly. Id 0 is never
+ * handed out, because the refill path treats it as invalid. Callers of the
+ * id helpers hold bufs_lock.
+ */
+static int ath11k_dp_rx_bufs_init(struct dp_rxdma_ring *rx_ring)
+{
+	u32 num = rx_ring->bufs_max * 2 + 1;
+	u32 id;
+
+	rx_ring->bufs = kcalloc(num, sizeof(*rx_ring->bufs), GFP_KERNEL);
+	rx_ring->free_ids = kcalloc(num, sizeof(*rx_ring->free_ids),
+				    GFP_KERNEL);
+	if (!rx_ring->bufs || !rx_ring->free_ids) {
+		kfree(rx_ring->bufs);
+		kfree(rx_ring->free_ids);
+		rx_ring->bufs = NULL;
+		rx_ring->free_ids = NULL;
+		return -ENOMEM;
+	}
+
+	rx_ring->num_ids = num;
+	rx_ring->num_free = 0;
+	for (id = num; id-- > 1;)
+		rx_ring->free_ids[rx_ring->num_free++] = id;
+
+	return 0;
+}
+
+static int ath11k_dp_rx_buf_get_id(struct dp_rxdma_ring *rx_ring,
+				   struct sk_buff *skb)
+{
+	u32 id;
+
+	if (unlikely(!rx_ring->num_free))
+		return -ENOSPC;
+
+	id = rx_ring->free_ids[--rx_ring->num_free];
+	rx_ring->bufs[id] = skb;
+
+	return id;
+}
+
+static struct sk_buff *ath11k_dp_rx_buf_lookup(struct dp_rxdma_ring *rx_ring,
+					       u32 id)
+{
+	if (unlikely(id >= rx_ring->num_ids))
+		return NULL;
+
+	return rx_ring->bufs[id];
+}
+
+static void ath11k_dp_rx_buf_put_id(struct dp_rxdma_ring *rx_ring, u32 id)
+{
+	if (unlikely(id >= rx_ring->num_ids || !rx_ring->bufs[id]))
+		return;
+
+	rx_ring->bufs[id] = NULL;
+	rx_ring->free_ids[rx_ring->num_free++] = id;
+}
+
+static bool ath11k_dp_rx_buf_is_pp(struct sk_buff *skb)
+{
+	return skb->pp_recycle && skb->head_frag;
+}
+
+static void ath11k_dp_rx_unmap_buf(struct ath11k_base *ab, struct sk_buff *skb,
+				   enum dma_data_direction dir)
+{
+	struct ath11k_skb_rxcb *rxcb = ATH11K_SKB_RXCB(skb);
+	unsigned int len = skb->len + skb_tailroom(skb);
+
+	if (ath11k_dp_rx_buf_is_pp(skb))
+		dma_sync_single_for_cpu(ab->dev, rxcb->paddr, len,
+					DMA_BIDIRECTIONAL);
+	else
+		dma_unmap_single(ab->dev, rxcb->paddr, len, dir);
+}
+
+static dma_addr_t ath11k_dp_rx_pp_dma_addr(struct sk_buff *skb)
+{
+	struct page *page = virt_to_head_page(skb->data);
+
+	return page_pool_get_dma_addr(page) +
+	       (skb->data - (u8 *)page_address(page));
+}
+
+static struct sk_buff *ath11k_dp_rx_pp_alloc_skb(struct dp_rxdma_ring *rx_ring)
+{
+	struct sk_buff *skb;
+	unsigned int offset;
+	struct page *page;
+	void *va;
+
+	page = page_pool_dev_alloc_frag(rx_ring->page_pool, &offset,
+					DP_RX_PP_FRAG_SIZE);
+	if (!page)
+		return NULL;
+
+	va = page_address(page) + offset;
+	skb = build_skb(va, DP_RX_PP_FRAG_SIZE);
+	if (!skb) {
+		page_pool_put_full_page(rx_ring->page_pool, page, false);
+		return NULL;
+	}
+
+	skb_mark_for_recycle(skb);
+
+	return skb;
+}
