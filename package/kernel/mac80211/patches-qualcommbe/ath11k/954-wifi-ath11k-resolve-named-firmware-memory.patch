-			ab->qmi.target_mem[idx].paddr = (phys_addr_t) addr;
+			ab->qmi.target_mem[idx].paddr = region.start;
 			ab->qmi.target_mem[idx].vaddr = NULL;
 			ab->qmi.target_mem[idx].size = ab->qmi.target_mem[i].size;
 			ab->qmi.target_mem[idx].type = ab->qmi.target_mem[i].type;
@@ -2328,7 +2404,9 @@ static int ath11k_qmi_load_file_target_m
 	struct qmi_wlanfw_bdf_download_resp_msg_v01 resp;
 	struct qmi_txn txn;
 	const u8 *temp = data;
-	u32 addr;
+	phys_addr_t paddr;
+	u32 offset = type == ATH11K_QMI_FILE_TYPE_CALDATA ?
+		     ab->hw_params.fw.cal_offset : 0;
 	void __iomem *bdf_addr = NULL;
 	int ret = 0;
 	u32 remaining = len;
@@ -2340,9 +2418,16 @@ static int ath11k_qmi_load_file_target_m
 	memset(&resp, 0, sizeof(resp));
 
 	if (ab->hw_params.fixed_bdf_addr) {
-		if(of_property_read_u32(ab->dev->of_node, "qcom,bdf-addr", &addr))
-			addr = ab->hw_params.bdf_addr;
-		bdf_addr = ioremap(addr, ab->hw_params.fw.board_size);
+		if (offset > ab->hw_params.fw.board_size ||
+		    len > ab->hw_params.fw.board_size - offset) {
+			ret = -EINVAL;
+			goto err_free_req;
+		}
+		ret = ath11k_qmi_get_bdf_addr(ab, ab->hw_params.fw.board_size,
+					      &paddr);
+		if (ret)
+			goto err_free_req;
+		bdf_addr = ioremap(paddr, ab->hw_params.fw.board_size);
 		if (!bdf_addr) {
 			ath11k_warn(ab, "qmi ioremap error for bdf_addr\n");
 			ret = -EIO;
@@ -2380,10 +2465,7 @@ static int ath11k_qmi_load_file_target_m
 		}
 
 		if (ab->hw_params.fixed_bdf_addr) {
-			if (type == ATH11K_QMI_FILE_TYPE_CALDATA)
-				bdf_addr += ab->hw_params.fw.cal_offset;
-
-			memcpy_toio(bdf_addr, temp, len);
+			memcpy_toio(bdf_addr + offset, temp, len);
 		}
 
 		ret = qmi_txn_init(&ab->qmi.handle, &txn,
