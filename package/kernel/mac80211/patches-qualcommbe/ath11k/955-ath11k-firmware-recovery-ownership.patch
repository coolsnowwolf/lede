From: ViKing <viking.yfy@qq.com>
Date: Wed, 28 Oct 2026 13:34:14 +0800
Subject: [PATCH] wifi: ath11k: preserve radio and datapath ownership through recovery

ath11k_connect_pdev_htc_service() initialises tx_ce_desc_wq. Firmware crash
recovery calls it again through ath11k_core_start() ->
ath11k_wmi_connect(), while a WMI command on a part without credit flow can
still be sleeping on that queue in ath11k_wmi_cmd_send(). finish_wait()
then removes the entry from a list head that was reset under it:

ath11k_core_qmi_firmware_ready() serves both the cold boot and the firmware
crash recovery path. ath11k_mac_allocate() returns early once
ATH11K_FLAG_REGISTERED is set, so on a recovery the radios are the ones
mac80211 has held since the cold boot and no allocation takes place.

Since commit 32be3ca4cf78 ("wifi: ath11k: HAL SRNG: don't deinitialize and
re-initialize again") recovery zeroes the hal state instead of freeing and
reallocating it, but a failed recovery still calls
ath11k_hal_srng_deinit(). This frees the ring pointer buffers and the ring
configuration, which only probe allocates, while the rings still point into
them. Driver removal then walks the copy engine rings through the freed
buffers:

ath11k_core_reconfigure_on_crash() clears ATH11K_FLAG_CRASH_FLUSH right
after ath11k_hal_srng_clear() zeroes the rings, but ath11k_ce_init_pipes()
and ath11k_dp_alloc() rebuild them only later. A WMI command sent in
between passes the CRASH_FLUSH check in ath11k_ce_send() and dereferences
the NULL tail pointer of the cleared ring:

ath11k_core_restart() brings the firmware up outside mac80211's restart, so
cfg80211 operations keep sending WMI commands while the HTC services
reconnect and before the firmware reports ready. These commands crash the
restarting firmware again, and recovery then fails on the unified ready
timeout:

Merged from:
  955-01-wifi-ath11k-initialise-the-CE-descriptor-waitqueue-o.patch
  955-02-wifi-ath11k-keep-the-radios-when-a-firmware-recovery.patch
  955-03-wifi-ath11k-keep-the-srng-allocations-when-a-firmwar.patch
  955-04-wifi-ath11k-clear-CRASH_FLUSH-only-after-recovery-re.patch
  955-05-wifi-ath11k-hold-back-WMI-commands-while-the-firmwar.patch

Based on work by:
  Julius Bairaktaris <julius@bairaktaris.de>

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath11k/ce.c
+++ b/drivers/net/wireless/ath/ath11k/ce.c
@@ -470,6 +470,14 @@ static struct sk_buff *ath11k_ce_complet
 
 	srng = &ab->hal.srng_list[pipe->src_ring->hal_ring_id];
 
+	/* A recovery that failed before ath11k_ce_init_pipes() leaves the
+	 * ring, lock included, as ath11k_hal_srng_clear() zeroed it.
+	 */
+	if (!srng->u.src_ring.tp_addr) {
+		spin_unlock_bh(&ab->ce.ce_lock);
+		return ERR_PTR(-EIO);
+	}
+
 	spin_lock_bh(&srng->lock);
 
 	ath11k_hal_srng_access_begin(ab, srng);
@@ -718,6 +726,9 @@ int ath11k_ce_send(struct ath11k_base *a
 	u8 byte_swap_data = 0;
 	int num_used;
 
+	if (test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags))
+		return -ESHUTDOWN;
+
 	/* Check if some entries could be regained by handling tx completion if
 	 * the CE has interrupts disabled and the used entries is more than the
 	 * defined usage threshold.
@@ -740,9 +751,6 @@ int ath11k_ce_send(struct ath11k_base *a
 			ath11k_ce_poll_send_completed(ab, pipe->pipe_num);
 	}
 
-	if (test_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags))
-		return -ESHUTDOWN;
-
 	spin_lock_bh(&ab->ce.ce_lock);
 
 	write_index = pipe->src_ring->write_index;
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -2377,7 +2377,8 @@ static int ath11k_core_start(struct ath1
 err_reo_cleanup:
 	ath11k_dp_pdev_reo_cleanup(ab);
 err_mac_destroy:
-	ath11k_mac_destroy(ab);
+	if (!test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags))
+		ath11k_mac_destroy(ab);
 err_hif_stop:
 	ath11k_hif_stop(ab);
 err_wmi_detach:
@@ -2439,6 +2440,8 @@ int ath11k_core_qmi_firmware_ready(struc
 		goto err_firmware_stop;
 	}
 
+	clear_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags);
+
 	if (ath11k_frame_mode == ATH11K_HW_TXRX_RAW)
 		set_bit(ATH11K_FLAG_RAW_MODE, &ab->dev_flags);
 
@@ -2461,8 +2464,10 @@ int ath11k_core_qmi_firmware_ready(struc
 
 err_core_stop:
 	ath11k_core_stop(ab);
-	ath11k_mac_destroy(ab);
+	if (!test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags))
+		ath11k_mac_destroy(ab);
 err_dp_free:
+	set_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags);
 	ath11k_dp_free(ab);
 	mutex_unlock(&ab->core_lock);
 err_firmware_stop:
@@ -2500,19 +2505,13 @@ static int ath11k_core_reconfigure_on_cr
 
 	ab->free_vdev_map = (1LL << (ab->num_radios * TARGET_NUM_VDEVS(ab))) - 1;
 
-	clear_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags);
-
 	ret = ath11k_core_qmi_firmware_ready(ab);
 	if (ret)
-		goto err_hal_srng_deinit;
+		return ret;
 
 	clear_bit(ATH11K_FLAG_RECOVERY, &ab->dev_flags);
 
 	return 0;
-
-err_hal_srng_deinit:
-	ath11k_hal_srng_deinit(ab);
-	return ret;
 }
 
 void ath11k_core_halt(struct ath11k *ar)
@@ -2926,6 +2925,7 @@ struct ath11k_base *ath11k_core_alloc(st
 				      enum ath11k_bus bus)
 {
 	struct ath11k_base *ab;
+	int i;
 
 	ab = kzalloc(sizeof(*ab) + priv_size, GFP_KERNEL);
 	if (!ab)
@@ -2952,6 +2952,10 @@ struct ath11k_base *ath11k_core_alloc(st
 	INIT_LIST_HEAD(&ab->peers);
 	init_waitqueue_head(&ab->peer_mapping_wq);
 	init_waitqueue_head(&ab->wmi_ab.tx_credits_wq);
+
+	for (i = 0; i < ARRAY_SIZE(ab->wmi_ab.wmi); i++)
+		init_waitqueue_head(&ab->wmi_ab.wmi[i].tx_ce_desc_wq);
+
 	init_waitqueue_head(&ab->qmi.cold_boot_waitq);
 	INIT_WORK(&ab->restart_work, ath11k_core_restart);
 	INIT_WORK(&ab->update_11d_work, ath11k_update_11d);
--- a/drivers/net/wireless/ath/ath11k/wmi.c
+++ b/drivers/net/wireless/ath/ath11k/wmi.c
@@ -303,6 +303,10 @@ int ath11k_wmi_cmd_send(struct ath11k_pd
 
 	might_sleep();
 
+	if (test_bit(ATH11K_FLAG_RECOVERY, &ab->dev_flags) &&
+	    current_work() != &ab->restart_work)
+		return -ESHUTDOWN;
+
 	if (ab->hw_params.credit_flow) {
 		wait_event_timeout(wmi_ab->tx_credits_wq, ({
 			ret = ath11k_wmi_cmd_send_nowait(wmi, skb, cmd_id);
@@ -9066,7 +9070,6 @@ static int ath11k_connect_pdev_htc_servi
 	ab->wmi_ab.wmi_endpoint_id[pdev_idx] = conn_resp.eid;
 	ab->wmi_ab.wmi[pdev_idx].eid = conn_resp.eid;
 	ab->wmi_ab.max_msg_len[pdev_idx] = conn_resp.max_msg_len;
-	init_waitqueue_head(&ab->wmi_ab.wmi[pdev_idx].tx_ce_desc_wq);
 
 	return 0;
 }
