 		if (ret) {
 			ath12k_warn(ar->ab, "failed to delete peer vdev_id %d addr %pM\n",
 				    arg->vdev_id, arg->peer_addr);
-			ath12k_peer_delete_wait_unregister(ar, &wait);
+			if (sta && sta->mlo &&
