+static int ath12k_mac_peer_assoc_status(struct ath12k *ar,
+						u32 vdev_id,
+						const u8 *addr)
+{
+	struct ath12k_dp_link_peer *peer;
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ar->ab);
+	struct ath12k_sta *ahsta = NULL;
+	u32 status;
+
+	spin_lock_bh(&dp->dp_lock);
+	peer = ath12k_dp_link_peer_find_by_vdev_and_addr(dp, vdev_id,
+								 addr);
+	if (!peer) {
+		spin_unlock_bh(&dp->dp_lock);
+		ath12k_warn(ar->ab,
+			    "failed to find peer %pM after assoc confirmation on vdev %u\n",
+				    addr, vdev_id);
+		return -ENOENT;
+	}
+
+	status = peer->assoc_status;
+	if (peer->sta)
+		ahsta = ath12k_sta_to_ahsta(peer->sta);
+	spin_unlock_bh(&dp->dp_lock);
+
+	if (status == U32_MAX) {
+		ath12k_warn(ar->ab,
+			    "peer assoc confirmation did not match %pM on vdev %u\n",
+				    addr, vdev_id);
+		return -EPROTO;
+	}
+
+	if (status) {
+		ath12k_warn(ar->ab,
+			    "firmware rejected peer assoc for %pM on vdev %u status %u\n",
+				    addr, vdev_id, status);
+		if (ahsta)
+			ath12k_peer_ml_quarantine(ath12k_ar_to_ah(ar), ahsta,
+						  status);
+		return -EINVAL;
+	}
+
+	return 0;
+}
