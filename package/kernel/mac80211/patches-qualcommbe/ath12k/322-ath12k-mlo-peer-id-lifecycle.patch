 		arsta = wiphy_dereference(ah->hw->wiphy, ahsta->link[link_id]);
-		if (!arvif || !arsta)
+		if (!arvif || !arsta) {
+			ath12k_hw_warn(ah,
+				       "missing link state %u while deleting ML peer %pM\n",
+				       link_id, sta->addr);
+			err_ret = -ENOENT;
 			continue;
+		}
 
 		ar = arvif->ar;
-		if (!ar)
+		if (!ar) {
+			ath12k_hw_warn(ah,
+				       "missing radio for link %u while deleting ML peer %pM\n",
+				       link_id, sta->addr);
+			err_ret = -ENODEV;
 			continue;
