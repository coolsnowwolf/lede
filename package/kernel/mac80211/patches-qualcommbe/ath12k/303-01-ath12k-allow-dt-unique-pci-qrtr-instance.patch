From: ViKing <viking.yfy@qq.com>
Date: Sun, 25 Oct 2026 14:06:01 +0800
Subject: [PATCH] wifi: ath12k: allow unique PCI QRTR instance from DT

Some embedded QCN9274 firmware needs the PCI-derived QRTR instance even
without the MULTI_QRTR_ID feature flag. Let the board opt in so IPQ9574
ath11k AHB and ath12k PCI services can coexist, preserving other boards.

Link: https://github.com/kravasuper/openwrt/commit/790d036a178c0f695c2f60d490d194091b35e595
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -689,6 +689,12 @@ static int ath12k_pci_config_irq(struct
 	return 0;
 }
 
+static bool ath12k_pci_needs_unique_qrtr_node(struct ath12k_base *ab)
+{
+	return ath12k_fw_feature_supported(ab, ATH12K_FW_FEATURE_MULTI_QRTR_ID) ||
+	       of_property_read_bool(ab->dev->of_node, "qcom,force-unique-qrtr-id");
+}
+
 static void ath12k_pci_init_qmi_ce_config(struct ath12k_base *ab)
 {
 	struct ath12k_qmi_ce_cfg *cfg = &ab->qmi.ce_cfg;
@@ -703,7 +709,7 @@ static void ath12k_pci_init_qmi_ce_confi
 	cfg->svc_to_ce_map_len = ab->hw_params->svc_to_ce_map_len;
 	ab->qmi.service_ins_id = ab->hw_params->qmi_service_ins_id;
 
-	if (ath12k_fw_feature_supported(ab, ATH12K_FW_FEATURE_MULTI_QRTR_ID)) {
+	if (ath12k_pci_needs_unique_qrtr_node(ab)) {
 		ab_pci->qmi_instance =
 			u32_encode_bits(pci_domain_nr(bus), DOMAIN_NUMBER_MASK) |
 			u32_encode_bits(bus->number, BUS_NUMBER_MASK);
@@ -1454,7 +1460,7 @@ int ath12k_pci_power_up(struct ath12k_ba
 
 	ath12k_pci_msi_enable(ab_pci);
 
-	if (ath12k_fw_feature_supported(ab, ATH12K_FW_FEATURE_MULTI_QRTR_ID))
+	if (ath12k_pci_needs_unique_qrtr_node(ab))
 		ath12k_pci_update_qrtr_node_id(ab);
 
 	ret = ath12k_mhi_start(ab_pci);
