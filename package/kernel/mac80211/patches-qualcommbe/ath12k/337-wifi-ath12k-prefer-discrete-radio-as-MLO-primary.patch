+				    arsta->addr, arvif->vdev_id, ret);
+			goto free_peer;
+		}
 	}
 
 	if (ab->hw_params->vdev_start_delay &&
@@ -7442,6 +7444,7 @@ static int ath12k_mac_handle_link_sta_st
 					    enum ieee80211_sta_state new_state)
 {
 	struct ieee80211_vif *vif = ath12k_ahvif_to_vif(arvif->ahvif);
+	struct ieee80211_sta *sta = ath12k_ahsta_to_sta(arsta->ahsta);
 	struct ieee80211_bss_conf *link_conf;
 	struct ath12k *ar = arvif->ar;
 	struct ath12k_reg_info *reg_info;
@@ -7478,14 +7481,25 @@ static int ath12k_mac_handle_link_sta_st
 	 * peer associated to AP/Mesh/ADHOC vif type.
 	 */
 	} else if (old_state == IEEE80211_STA_AUTH &&
-		   new_state == IEEE80211_STA_ASSOC &&
-		   (vif->type == NL80211_IFTYPE_AP ||
+		   new_state == IEEE80211_STA_ASSOC) {
+		if (sta->mlo) {
+			ret = ath12k_dp_peer_setup(ar, arvif->vdev_id, arsta->addr);
+			if (ret) {
+				ath12k_warn(ab,
+					    "failed to setup dp for peer %pM on vdev %i (%d)\n",
+					    arsta->addr, arvif->vdev_id, ret);
+				goto exit;
+			}
+		}
+
+		if (vif->type == NL80211_IFTYPE_AP ||
 		    vif->type == NL80211_IFTYPE_MESH_POINT ||
-		    vif->type == NL80211_IFTYPE_ADHOC)) {
-		ret = ath12k_mac_station_assoc(ar, arvif, arsta, false);
-		if (ret)
-			ath12k_warn(ab, "Failed to associate station: %pM\n",
-				    arsta->addr);
+		    vif->type == NL80211_IFTYPE_ADHOC) {
+			ret = ath12k_mac_station_assoc(ar, arvif, arsta, false);
+			if (ret)
+				ath12k_warn(ab, "Failed to associate station: %pM\n",
+					    arsta->addr);
+		}
 
 	/* IEEE80211_STA_ASSOC -> IEEE80211_STA_AUTHORIZED: set peer status as
 	 * authorized
@@ -7965,6 +7979,7 @@ int ath12k_mac_op_sta_state(struct ieee8
 
 			arsta->is_assoc_link = true;
 			ahsta->assoc_link_id = link_id;
+			ahsta->primary_link_id = link_id;
 		}
 	}
 
@@ -8287,6 +8302,35 @@ static struct ath12k_link_sta *ath12k_ma
 	return arsta;
 }
 
+static u8 ath12k_mac_mlo_select_primary_link(struct ath12k_hw *ah,
+					      struct ath12k_vif *ahvif,
+					      struct ath12k_sta *ahsta,
+					      unsigned long links)
+{
+	struct ath12k_link_vif *arvif;
+	u8 link_id;
+
+	lockdep_assert_wiphy(ah->hw->wiphy);
+
+	if (WARN_ON(!links))
+		return ahsta->assoc_link_id;
+
+	for_each_set_bit(link_id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		arvif = wiphy_dereference(ah->hw->wiphy,
+					 ahvif->link[link_id]);
+		if (!arvif || !arvif->ar)
+			continue;
+
+		if (arvif->ar->ab->hw_params->is_plink_preferable)
+			return link_id;
+	}
+
+	if (links & BIT(ahsta->assoc_link_id))
+		return ahsta->assoc_link_id;
+
+	return __ffs(links);
+}
+
 int ath12k_mac_op_change_sta_links(struct ieee80211_hw *hw,
 				   struct ieee80211_vif *vif,
 				   struct ieee80211_sta *sta,
@@ -8299,6 +8343,7 @@ int ath12k_mac_op_change_sta_links(struc
 	struct ath12k_link_sta *arsta;
 	unsigned long valid_links;
 	struct ath12k *ar;
+	u8 primary_link_id;
 	u8 link_id;
 	int ret;
 
@@ -8349,6 +8394,16 @@ int ath12k_mac_op_change_sta_links(struc
 		}
 	}
 
+	/* This path does not implement live primary-link migration. */
+	if (ahsta->state < IEEE80211_STA_ASSOC) {
+		primary_link_id = ath12k_mac_mlo_select_primary_link(
+			ah, ahvif, ahsta, ahsta->links_map);
+		ahsta->primary_link_id = primary_link_id;
+		ath12k_dbg(NULL, ATH12K_DBG_MAC,
+			   "mac ML STA %pM primary link set to %u\n",
+			   sta->addr, primary_link_id);
+	}
+
 	return 0;
 }
 EXPORT_SYMBOL(ath12k_mac_op_change_sta_links);
@@ -9752,7 +9807,7 @@ u8 ath12k_mac_get_tx_link(struct ieee802
 	 */
 	if (info_flags & IEEE80211_TX_CTL_HW_80211_ENCAP ||
 	    ieee80211_is_data(hdr->frame_control))
-		return ahsta->assoc_link_id;
+		return ahsta->primary_link_id;
 
 	/* 802.11 frame cases */
 	if (link == IEEE80211_LINK_UNSPECIFIED)
