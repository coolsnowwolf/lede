From: JiaY-shi <shi05275@163.com>
Date: Wed, 28 Oct 2026 13:34:14 +0800
Subject: [PATCH] wifi: ath12k: prefer discrete radio as MLO primary

Qualcomm's driver marks IPQ5332 as unsuitable for automatic primary-link
selection and marks QCN9274 as preferable.  Selecting the association link
unconditionally can make the IPQ5332 UserPD the primary UMAC when a client
first associates on 2.4 GHz, even though an active QCN9274 partner exists.

Primary-link selection in TIP also depends on delaying data-path setup until
all partner peers have been created.  Keep MLO peers without a primary data
path at creation time, select the first preferable created link, and perform
REO/TID setup during the AUTH-to-ASSOC transition only on that link.  This
avoids moving shared MLD reorder queues after they have already been created
on the association link.  Non-MLO peer setup remains unchanged.

Use the selected link consistently for the WMI primary-UMAC flags and data
transmission.  Keep the association link as a fallback, and do not change the
primary after association because this backport does not include TIP's live
UMAC migration machinery.

Signed-off-by: JiaY-shi <shi05275@163.com>
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/peer.c
+++ b/drivers/net/wireless/ath/ath12k/peer.c
@@ -331,8 +331,8 @@ int ath12k_peer_create(struct ath12k *ar
 				peer->ml_id = ml_peer_id;
 			ether_addr_copy(peer->ml_addr, sta->addr);
 
-			/* the assoc link is considered primary for now */
-			peer->primary_link = arsta->is_assoc_link;
+			/* Set after all partner peers exist and primary is selected. */
+			peer->primary_link = false;
 			peer->mlo = true;
 		} else {
 			peer->ml_id = ATH12K_MLO_PEER_ID_INVALID;
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -514,7 +514,7 @@ struct ath12k_link_sta {
 	s8 rssi_beacon;
 	s8 chain_signal[IEEE80211_MAX_CHAINS];
 
-	/* For now the assoc link will be considered primary */
+	/* Whether this link was used for association. */
 	bool is_assoc_link;
 
 	 /* for firmware use only */
@@ -532,6 +532,8 @@ struct ath12k_sta {
 	/* indicates bitmap of link sta created in FW */
 	u16 links_map;
 	u8 assoc_link_id;
+	/* protected by wiphy lock */
+	u8 primary_link_id;
 	u16 ml_peer_id;
 	u16 free_logical_link_idx_map;
 
--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -48,6 +48,7 @@ int ath12k_dp_peer_setup(struct ath12k *
 {
 	struct ath12k_base *ab = ar->ab;
 	struct ath12k_dp_link_peer *peer;
+	struct ath12k_sta *ahsta;
 	u32 reo_dest;
 	int ret = 0, tid;
 	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
@@ -64,6 +65,34 @@ int ath12k_dp_peer_setup(struct ath12k *
 		return ret;
 	}
 
+	spin_lock_bh(&dp->dp_lock);
+	peer = ath12k_dp_link_peer_find_by_vdev_and_addr(dp, vdev_id, addr);
+	if (!peer || !peer->dp_peer) {
+		ath12k_warn(ab, "failed to find peer %pM on vdev %d for dp setup\n",
+			    addr, vdev_id);
+		spin_unlock_bh(&dp->dp_lock);
+		return -ENOENT;
+	}
+
+	if (peer->mlo) {
+		if (!peer->sta) {
+			ath12k_warn(ab, "MLO peer %pM on vdev %d has no station\n",
+				    addr, vdev_id);
+			spin_unlock_bh(&dp->dp_lock);
+			return -EINVAL;
+		}
+
+		ahsta = ath12k_sta_to_ahsta(peer->sta);
+		if (peer->link_id != ahsta->primary_link_id) {
+			peer->primary_link = false;
+			spin_unlock_bh(&dp->dp_lock);
+			return 0;
+		}
+	}
+
+	peer->primary_link = true;
+	spin_unlock_bh(&dp->dp_lock);
+
 	for (tid = 0; tid <= IEEE80211_NUM_TIDS; tid++) {
 		ret = ath12k_dp_rx_peer_tid_setup(ar, addr, vdev_id, tid, 1, 0,
 						  HAL_PN_TYPE_NONE);
