+static void ath12k_qmi_unmap_fixed_mem(struct ath12k_base *ab,
+				      struct ath12k_qmi_fixed_mem *mem)
+{
+	lockdep_assert_held(&ab->ag->mutex);
+
+	if (!mem->ioaddr)
+		return;
+
+	iounmap(mem->ioaddr);
+
+	memset(mem, 0, sizeof(*mem));
+}
+
+static void ath12k_qmi_begin_fixed_request(struct ath12k_base *ab)
+{
+	int i;
+
+	lockdep_assert_held(&ab->ag->mutex);
+
+	for (i = 0; i < ARRAY_SIZE(ab->qmi.fixed_mem); i++)
+		ab->qmi.fixed_mem[i].used = false;
+}
+
+static void ath12k_qmi_prune_fixed_mem(struct ath12k_base *ab)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ab->qmi.fixed_mem); i++) {
+		if (!ab->qmi.fixed_mem[i].used)
+			ath12k_qmi_unmap_fixed_mem(ab, &ab->qmi.fixed_mem[i]);
+	}
+}
+
+static int ath12k_qmi_map_fixed_mem(struct ath12k_base *ab, int idx,
+				   phys_addr_t paddr, u32 size, u32 type)
+{
+	struct ath12k_qmi_fixed_mem *mem = &ab->qmi.fixed_mem[idx];
+	struct target_mem_chunk *chunk = &ab->qmi.target_mem[idx];
+	void __iomem *ioaddr;
+
+	lockdep_assert_held(&ab->ag->mutex);
+	if (!size)
+		return -EINVAL;
+
+	if (!mem->ioaddr || mem->paddr != paddr || mem->size != size ||
+	    mem->type != type) {
+		/* Keep the previous owner reachable if mapping the replacement fails. */
+		ioaddr = ioremap(paddr, size);
+		if (!ioaddr)
+			return -EIO;
+
+		ath12k_qmi_unmap_fixed_mem(ab, mem);
+		mem->ioaddr = ioaddr;
+		mem->paddr = paddr;
+		mem->size = size;
+		mem->type = type;
+	}
+
+	mem->used = true;
+	chunk->paddr = mem->paddr;
+	chunk->v.ioaddr = mem->ioaddr;
+	chunk->size = size;
+	chunk->type = type;
+	return 0;
+}
