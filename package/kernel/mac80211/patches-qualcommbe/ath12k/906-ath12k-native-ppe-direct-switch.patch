+bool ath12k_wifi7_ds_hw1_registered(struct ath12k_base *ab)
+{
+	return ath12k_wifi7_ds_hw1_compat(ab) &&
+	       READ_ONCE(ath12k_ab_to_dp(ab)->ds);
+}
