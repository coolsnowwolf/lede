+int ath12k_dp_rx_htt_ds_cfg(struct ath12k_base *ab)
+{
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
+	struct sk_buff *skb;
+	__le32 *info;
+	u32 flags;
+	int ret;
+
+	skb = ath12k_htc_alloc_skb(ab, sizeof(*info));
+	if (!skb)
+		return -ENOMEM;
+	info = skb_put(skb, sizeof(*info));
+	/* QSDK RXOLE override: REO destination 6 is REO2PPE. Keep raw,
+	 * native-Wi-Fi and IP fragments on the ordinary receive path.
+	 */
+	flags = 0x19 | BIT(8) | (6 << 9) | BIT(16) | BIT(17) | BIT(18);
+	if (ab->hw_rev == ATH12K_HW_QCN9274_HW10)
+		flags |= BIT(15);
+	*info = cpu_to_le32(flags);
+	ret = ath12k_htc_send(&ab->htc, dp->eid, skb);
+	if (ret)
+		dev_kfree_skb_any(skb);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ath12k_dp_rx_htt_ds_cfg);
