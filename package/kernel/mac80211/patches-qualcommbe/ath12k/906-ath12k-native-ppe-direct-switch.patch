+int ath12k_wmi_config_peer_ds(struct ath12k *ar, const u8 *addr,
+			      u32 vdev_id, u32 source_vp, bool enable)
+{
+	/* WLAN.WBE.1.6 PPE routing command: fixed 32-byte ABI (tag 0x3ea). */
+	struct {
+		__le32 tlv_header;
+		struct ath12k_wmi_mac_addr_params mac;
+		__le32 routing, service_code, priority_valid, source_vp, vdev_id;
+	} *cmd;
+	struct sk_buff *skb;
+	u32 routing = enable ? 1 : 0;
+	int ret;
+
+	skb = ath12k_wmi_alloc_skb(ar->wmi->wmi_ab, sizeof(*cmd));
+	if (!skb)
+		return -ENOMEM;
+	cmd = (void *)skb->data;
+	memset(cmd, 0, sizeof(*cmd));
+	cmd->tlv_header = ath12k_wmi_tlv_cmd_hdr(0x3ea, sizeof(*cmd));
+	ether_addr_copy(cmd->mac.addr, addr);
+	/* Keep association/key exchange on the CPU route until authorization. */
+	if (!enable && source_vp && ar->ab->hw_rev == ATH12K_HW_QCN9274_HW10)
+		routing = 2;
+	cmd->routing = cpu_to_le32(routing);
+	cmd->service_code = cpu_to_le32(12);
+	cmd->source_vp = cpu_to_le32(source_vp);
+	cmd->vdev_id = cpu_to_le32(vdev_id);
+	ret = ath12k_wmi_cmd_send(ar->wmi, skb, WMI_PEER_CONFIG_PPE_DS_CMDID);
+	if (ret)
+		dev_kfree_skb(skb);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ath12k_wmi_config_peer_ds);
