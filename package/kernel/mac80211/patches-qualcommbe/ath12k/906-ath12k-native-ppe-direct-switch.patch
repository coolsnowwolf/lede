+static void ath12k_ds_free_buffers(struct ath12k_ds *ds)
+{
+	struct ath12k_ds_buffer *buffer;
+	struct ath12k_tx_desc_info *desc;
+	unsigned int i;
+
+	for (i = 0; i < ds->buffer_count; i++) {
+		buffer = &ds->buffers[i];
+		desc = buffer->desc;
+		dma_unmap_single(ds->dp->dev, buffer->paddr,
+				 ATH12K_DS_BUFFER_SIZE, DMA_BIDIRECTIONAL);
+		dev_kfree_skb(desc->skb);
+		desc->skb = NULL;
+		desc->ds_index = 0;
+		ath12k_dp_tx_release_txbuf(ds->dp, desc, desc->pool_id);
+	}
+	kfree(ds->buffers);
+}
+
+static int ath12k_ds_alloc_buffers(struct ath12k_ds *ds)
+{
+	struct ath12k_tx_desc_info *desc;
+	struct ath12k_ds_buffer *buffer;
+	struct sk_buff *skb;
+	dma_addr_t paddr;
+	unsigned int i;
+
+	ds->buffers = kcalloc(ATH12K_DS_BUFFER_COUNT, sizeof(*ds->buffers), GFP_KERNEL);
+	if (!ds->buffers)
+		return -ENOMEM;
+	for (i = 0; i < ATH12K_DS_BUFFER_COUNT; i++) {
+		skb = alloc_skb(ATH12K_DS_BUFFER_SIZE + DP_RX_BUFFER_ALIGN_SIZE, GFP_KERNEL);
+		if (!skb)
+			return -ENOMEM;
+		skb_reserve(skb, PTR_ALIGN(skb->data, DP_RX_BUFFER_ALIGN_SIZE) - skb->data);
+		memset(skb->cb, 0, sizeof(skb->cb));
+		paddr = dma_map_single(ds->dp->dev, skb->data,
+				       ATH12K_DS_BUFFER_SIZE, DMA_BIDIRECTIONAL);
+		if (dma_mapping_error(ds->dp->dev, paddr)) {
+			dev_kfree_skb(skb);
+			return -EIO;
+		}
+		if (!paddr || paddr > U32_MAX - ATH12K_DS_BUFFER_SIZE + 1)
+			goto fail_mapping;
+		desc = ath12k_dp_tx_assign_buffer(ds->dp, i % ATH12K_HW_MAX_QUEUES);
+		if (!desc)
+			goto fail_mapping;
+		desc->skb = skb;
+		desc->ds_index = i + 1;
+		buffer = &ds->buffers[i];
+		buffer->desc = desc;
+		buffer->paddr = paddr;
+		list_add_tail(&buffer->list, &ds->free_buffers);
+		ds->buffer_count++;
+	}
+	return 0;
+
+fail_mapping:
+	dma_unmap_single(ds->dp->dev, paddr, ATH12K_DS_BUFFER_SIZE, DMA_BIDIRECTIONAL);
+	dev_kfree_skb(skb);
+	return -ENOSPC;
+}
+
+/* FW reinject completions describe an Ethernet frame in the mapped buffer.
+ * Copy exceptional packets only: the reusable DMA storage must never become
+ * an skb owned by mac80211. Resolve its destination against authorized peers.
+ */
+static void ath12k_ds_reinject(struct ath12k_ds *ds,
+			       struct ath12k_ds_buffer *buffer,
+			       const struct htt_tx_wbm_completion *status,
+			       struct sk_buff_head *queue)
+{
+	struct ath12k_ds_peer *peer;
+	struct net_device *dev = NULL;
+	struct sk_buff *skb;
+	u16 len = le32_get_bits(status->info2, GENMASK(31, 16));
+	u8 tid = le32_get_bits(status->info3, GENMASK(4, 0));
+	unsigned long flags;
+	bool ambiguous = false;
+	const u8 *data = buffer->desc->skb->data;
+
+	if (len < ETH_HLEN || len > ATH12K_DS_BUFFER_SIZE || tid > 15)
+		goto fault;
+	dma_sync_single_for_cpu(ds->dp->dev, buffer->paddr,
+				ATH12K_DS_BUFFER_SIZE, DMA_BIDIRECTIONAL);
+	spin_lock_irqsave(&ds->peer_lock, flags);
+	hash_for_each_possible(ds->peer_vps, peer, hash,
+			       ether_addr_to_u64(data)) {
+		if (!READ_ONCE(peer->enabled) || !ether_addr_equal(data, peer->addr))
+			continue;
+		if (dev && dev != peer->dev) {
+			ambiguous = true;
+			break;
+		}
+		dev = peer->dev;
+	}
+	if (dev && !ambiguous)
+		dev_hold(dev);
+	spin_unlock_irqrestore(&ds->peer_lock, flags);
+	if (!dev || ambiguous)
+		goto sync_fault;
+	skb = dev_alloc_skb(len);
+	if (skb) {
+		skb_put_data(skb, data, len);
+		skb->dev = dev;
+		skb->protocol = ((struct ethhdr *)skb->data)->h_proto;
+		skb_reset_mac_header(skb);
+		skb->priority = tid & 7;
+		__skb_queue_tail(queue, skb);
+	} else {
+		dev_put(dev);
+	}
+	dma_sync_single_for_device(ds->dp->dev, buffer->paddr,
+				   ATH12K_DS_BUFFER_SIZE, DMA_BIDIRECTIONAL);
+	return;
+
+sync_fault:
+	dma_sync_single_for_device(ds->dp->dev, buffer->paddr,
+				   ATH12K_DS_BUFFER_SIZE, DMA_BIDIRECTIONAL);
+fault:
+	WRITE_ONCE(ds->faulted, true);
+}
+
+int ath12k_wifi7_ds_service(struct ath12k_dp *dp, int budget)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+	struct hal_wbm_completion_ring_tx *status;
+	struct ath12k_tx_desc_info *desc;
+	struct ath12k_ds_buffer *buffer;
+	struct hal_srng *srng;
+	struct sk_buff_head reinject;
+	struct sk_buff *skb;
+	struct net_device *dev;
+	unsigned long flags;
+	u32 cookie, info;
+	unsigned int completed = 0, acked = 0, dropped = 0;
+	int done = 0;
+	int quota;
+
+	if (!ds || !ds->complete_ready || READ_ONCE(ds->stopped) ||
+	    READ_ONCE(ds->quarantined) || budget <= 0)
+		return 0;
+	/* QSDK charges four lightweight PPE completions per NAPI budget unit.
+	 * Bound each batch and round its cost up so a full batch requests
+	 * another poll instead of completing NAPI with work on the ring.
+	 */
+	quota = (budget << 2) - 1;
+	__skb_queue_head_init(&reinject);
+	srng = ath12k_ds_srng(ds, &ds->complete);
+	spin_lock_irqsave(&srng->lock, flags);
+	ath12k_hal_srng_access_begin(dp->ab, srng);
+	/* The ring lock already excludes IRQs. Recycle one completion batch
+	 * under the buffer-pool lock instead of locking and counting each
+	 * packet separately; publish the counters once after the batch.
+	 */
+	spin_lock(&ds->tx_lock);
+	while (done < quota) {
+		status = ath12k_hal_srng_dst_get_next_entry(dp->ab, srng);
+		if (!status)
+			break;
+		done++;
+		info = le32_to_cpu(status->info0);
+		/* Ring 6 uses software conversion. Never trust a hardware VA. */
+		if (info & (HAL_WBM_COMPL_TX_INFO0_CC_DONE |
+			    HAL_WBM_COMPL_TX_INFO0_WBM_INTERNAL_ERROR))
+			goto bad_cookie;
+		cookie = le32_get_bits(status->buf_va_hi, BUFFER_ADDR_INFO1_SW_COOKIE);
+		desc = ath12k_dp_get_tx_desc(dp, cookie);
+		if (!desc || !desc->ds_index || desc->ds_index > ds->buffer_count)
+			goto bad_cookie;
+		buffer = &ds->buffers[desc->ds_index - 1];
+		if (buffer->desc != desc || !buffer->in_use) {
+			goto bad_cookie;
+		}
+		if (FIELD_GET(HAL_WBM_COMPL_TX_INFO0_REL_SRC_MODULE, info) !=
+		    HAL_WBM_REL_SRC_MODULE_TQM) {
+			struct htt_tx_wbm_completion *htt = (void *)status;
+			u32 source = FIELD_GET(HAL_WBM_COMPL_TX_INFO0_REL_SRC_MODULE, info);
+			u32 fw_status = U32_MAX;
+
+			atomic64_inc(&ds->tx_exception);
+			if (source == HAL_WBM_REL_SRC_MODULE_FW)
+				fw_status = le32_get_bits(htt->info0,
+							HTT_TX_WBM_COMP_INFO0_STATUS);
+			if (source != HAL_WBM_REL_SRC_MODULE_FW) {
+				WRITE_ONCE(ds->faulted, true);
+				continue;
+			}
+			if (fw_status == HAL_WBM_REL_HTT_TX_COMP_STATUS_REINJ ||
+			    fw_status == HAL_WBM_REL_HTT_TX_COMP_STATUS_INSPECT)
+				ath12k_ds_reinject(ds, buffer, htt, &reinject);
+			else if (fw_status >= HAL_WBM_REL_HTT_TX_COMP_STATUS_MAX ||
+				 fw_status == HAL_WBM_REL_HTT_TX_COMP_STATUS_MEC_NOTIFY)
+				WRITE_ONCE(ds->faulted, true);
+			/* FW owns an ambiguous completion; keep its storage mapped. */
+			if (READ_ONCE(ds->faulted)) {
+				continue;
+			}
+		}
+		if (FIELD_GET(HAL_WBM_COMPL_TX_INFO0_REL_SRC_MODULE, info) ==
+		    HAL_WBM_REL_SRC_MODULE_TQM) {
+			if (FIELD_GET(HAL_WBM_COMPL_TX_INFO0_TQM_RELEASE_REASON, info) ==
+			    HAL_WBM_TQM_REL_REASON_FRAME_ACKED)
+				acked++;
+			else
+				dropped++;
+		}
+		buffer->in_use = false;
+		list_add_tail(&buffer->list, &ds->free_buffers);
+		completed++;
+		continue;
+
+bad_cookie:
+		atomic64_inc(&ds->bad_cookie);
+		WRITE_ONCE(ds->faulted, true);
+	}
+	spin_unlock(&ds->tx_lock);
+	if (done)
+		ath12k_hal_srng_access_end(dp->ab, srng);
+	spin_unlock_irqrestore(&srng->lock, flags);
+	atomic64_add(completed, &ds->tx_completed);
+	atomic64_add(acked, &ds->tx_acked);
+	atomic64_add(dropped, &ds->tx_dropped);
+	while ((skb = __skb_dequeue(&reinject))) {
+		dev = skb->dev;
+		dev_queue_xmit(skb);
+		dev_put(dev);
+	}
+	ath12k_ds_flush_rx(ds);
+	if (ds->handle && !READ_ONCE(ds->faulted)) {
+		qcom_ppe_ds_sync(ds->handle);
+		if (completed)
+			qcom_ppe_ds_refill_ready(ds->handle);
+	}
+	if (READ_ONCE(ds->faulted))
+		ath12k_ds_fault(ds);
+	return (done + 3) >> 2;
+}
+
+/* control_lock held. The hardware rings stay registered across a VAP's
+ * lifetime; the first supported peer starts the shared transport.
+ */
+static int ath12k_ds_start(struct ath12k_ds *ds)
+{
+	struct ath12k_base *ab = ds->dp->ab;
+	u32 reg, val;
+	int i, ret;
+
+	if (ds->started)
+		return ds->stopped || ds->faulted ? -ESHUTDOWN : 0;
+	reg = HAL_SEQ_WCSS_UMAC_REO_REG + HAL_REO1_DEST_RING_CTRL_IX_0;
+	val = ath12k_hif_read32(ab, reg);
+	i = ab->device_id;
+	if (!test_bit(i, &ds->reo_mapped)) {
+		ds->reo_map[i] = val & GENMASK(27, 24);
+		set_bit(i, &ds->reo_mapped);
+	}
+	val &= ~GENMASK(27, 24);
+	val |= FIELD_PREP(GENMASK(27, 24), 11);
+	ath12k_hif_write32(ab, reg, val);
+	ret = ath12k_dp_rx_htt_ds_cfg(ab);
+	if (ret)
+		return ret;
+	/* REO2PPE_DEST_INFO was added in QCN9274 hw2.0. */
+	if (HAL_REO2PPE_DEST_INFO(&ab->hal))
+		ath12k_hif_write32(ab, HAL_SEQ_WCSS_UMAC_REO_REG +
+				   HAL_REO2PPE_DEST_INFO(&ab->hal),
+				   HAL_REO2PPE_DEST_INFO_VALUE);
+	reg = HAL_SEQ_WCSS_UMAC_TCL_REG + HAL_TCL_DS_RBM_MAPPING_OFFSET;
+	val = ath12k_hif_read32(ab, reg);
+	val &= ~GENMASK(31, HAL_TCL_DS_RBM_MAPPING_SHIFT);
+	val |= (u32)HAL_WBM2SW_DS_RBM_ID << HAL_TCL_DS_RBM_MAPPING_SHIFT;
+	ath12k_hif_write32(ab, reg, val);
+	ret = qcom_ppe_ds_start(ds->handle);
+	if (!ret)
+		ds->started = true;
+	else
+		ath12k_ds_fault(ds);
+	return ret;
+}
+
+static int ath12k_ds_bind_vif(struct ath12k_ds *ds, struct ath12k_link_vif *arvif)
+{
+	struct ath12k_vif *vif = arvif->ahvif;
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif->vif);
+	struct ath12k_ds_vp *vp;
+	u32 config, bank_config;
+	int i, ret, bank, port;
+
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++)
+		if (ds->vps[i].vif == vif)
+			return ds->vps[i].closing ? -ESHUTDOWN : ds->vps[i].port;
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++)
+		if (!ds->vps[i].reserved)
+			break;
+	if (i == ATH12K_DS_VP_COUNT || !wdev || !wdev->netdev)
+		return -ENOSPC;
+	ret = ath12k_ds_start(ds);
+	if (ret)
+		return ret;
+	bank_config = ds->dp->ops->tx_get_vdev_bank_config(ds->dp->ab, arvif);
+	bank_config &= ~(HAL_TX_BANK_CONFIG_ENCAP_TYPE |
+			 HAL_TX_BANK_CONFIG_VDEV_ID_CHECK_EN |
+			 HAL_TX_BANK_CONFIG_PMAC_ID);
+	bank_config |= FIELD_PREP(HAL_TX_BANK_CONFIG_ENCAP_TYPE,
+				  HAL_TCL_ENCAP_TYPE_ETHERNET);
+	/* The native bank resolves the destination through the peer AST. */
+	bank_config |= FIELD_PREP(HAL_TX_BANK_CONFIG_PMAC_ID, 3);
+	bank = ath12k_dp_tx_get_bank_config(ds->dp, bank_config);
+	if (bank < 0)
+		return -ENOSPC;
+	port = qcom_ppe_ds_vp_alloc(ds->handle, wdev->netdev);
+	if (port < 0) {
+		ath12k_dp_tx_put_bank_profile(ds->dp, bank);
+		return port;
+	}
+	config = FIELD_PREP(GENMASK(7, 0), port) |
+		 FIELD_PREP(GENMASK(9, 8), 3) |
+		 FIELD_PREP(GENMASK(15, 10), bank) |
+		 FIELD_PREP(GENMASK(23, 16), arvif->vdev_id);
+	ath12k_hif_write32(ds->dp->ab, ATH12K_DS_VP_TABLE + i * 4, config);
+	/* Finish the WLAN table write before PPE can publish a descriptor. */
+	ath12k_hif_read32(ds->dp->ab, ATH12K_DS_VP_TABLE + i * 4);
+	/* Publish direct delivery only after all tracked peer submissions. */
+	vp = &ds->vps[i];
+	vp->reserved = true;
+	vp->vif = vif;
+	vp->dev = wdev->netdev;
+	dev_hold(vp->dev);
+	vp->port = port;
+	vp->bank = bank;
+	return port;
+}
+
+/* control_lock held. Queue selection belongs to the netdev, not a peer. */
+static int ath12k_ds_route_vif(struct ath12k_ds *ds, struct ath12k_vif *vif,
+			       bool direct)
+{
+	struct ath12k_ds_vp *vp;
+	int i, ret;
+
+	lockdep_assert_held(&ds->control_lock);
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+		vp = &ds->vps[i];
+		if (vp->vif != vif || vp->direct == direct)
+			continue;
+		if (direct && (vp->closing || ds->stopped || ds->faulted))
+			return -ESHUTDOWN;
+		ret = qcom_ppe_ds_vp_route(ds->handle, vp->port, direct);
+		if (ret) {
+			ath12k_ds_fault(ds);
+			return ret;
+		}
+		vp->direct = direct;
+		if (direct)
+			ds->route_direct++;
+		else
+			ds->route_cpu++;
+	}
+	return 0;
+}
+
+/* Keep CPU delivery while any authorized peer lacks a submitted route. */
+static bool ath12k_ds_vif_can_direct(struct ath12k_ds *ds,
+				     struct ath12k_vif *vif)
+{
+	struct ath12k_ds_peer *peer;
+	bool found = false;
+
+	lockdep_assert_held(&ds->control_lock);
+	list_for_each_entry(peer, &ds->peers, list) {
+		if (peer->vif != vif)
+			continue;
+		found = true;
+		if (!peer->enabled || !peer->authorized)
+			return false;
+	}
+	return found;
+}
+
+static int ath12k_ds_peer_disable(struct ath12k_ds_peer *peer)
+{
+	int ret;
+
+	if (!peer->enabled ||
+	    test_bit(ATH12K_FLAG_CRASH_FLUSH, &peer->ar->ab->dev_flags))
+		return 0;
+	ret = ath12k_wmi_config_peer_ds(peer->ar, peer->addr, peer->vdev, 0, false);
+	if (!ret)
+		WRITE_ONCE(peer->enabled, false);
+	return ret;
+}
+
+static int ath12k_ds_peer_cpu(struct ath12k_ds *ds,
+			      struct ath12k_ds_peer *peer)
+{
+	int ret, error;
+
+	ret = ath12k_ds_route_vif(ds, peer->vif, false);
+	error = ath12k_ds_peer_disable(peer);
+	if (error) {
+		ath12k_ds_fault(ds);
+		if (!ret)
+			ret = error;
+	}
+	return ret;
+}
+
+static int ath12k_ds_peer_update(struct ath12k *ar,
+				 struct ath12k_link_vif *arvif,
+				 struct ath12k_link_sta *arsta, bool authorized)
+{
+	struct ath12k_sta *ahsta = arsta->ahsta;
+	struct ieee80211_sta *sta = ath12k_ahsta_to_sta(ahsta);
+	struct ath12k_ds_peer *peer;
+	struct ath12k_ds *ds;
+	struct wireless_dev *wdev;
+	enum ath12k_ds_fallback fallback;
+	bool direct;
+	int port, ret = 0;
+
+	if (arvif->ahvif->vif->type != NL80211_IFTYPE_AP)
+		return 0;
+	/* AHB and MLO peers keep the ordinary WiFi/PPE path. */
+	ds = ath12k_ab_to_dp(ar->ab)->ds;
+	if (!ds)
+		return 0;
+	lockdep_assert_wiphy(ar->ah->hw->wiphy);
+	fallback = sta->mlo ? ATH12K_DS_FALLBACK_MLO : ATH12K_DS_FALLBACK_NONE;
+	mutex_lock(&ds->control_lock);
+	if (ds->stopped || ds->faulted)
+		goto unlock;
+	list_for_each_entry(peer, &ds->peers, list)
+		if (peer->ar == ar && peer->vif == arvif->ahvif &&
+		    peer->vdev == arvif->vdev_id &&
+		    ether_addr_equal(peer->addr, arsta->addr)) {
+			peer->authorized |= authorized;
+			if (authorized && !peer->enabled && !fallback) {
+				port = ath12k_ds_bind_vif(ds, arvif);
+				if (port < 0) {
+					ret = port;
+					goto peer_fault;
+				}
+				ret = ath12k_wmi_config_peer_ds(ar, arsta->addr,
+								arvif->vdev_id, port, true);
+				if (ret)
+					goto peer_fault;
+				WRITE_ONCE(peer->enabled, true);
+			}
+			direct = ath12k_ds_vif_can_direct(ds, arvif->ahvif);
+			ret = ath12k_ds_route_vif(ds, arvif->ahvif, direct);
+			goto unlock;
+		}
+	wdev = ieee80211_vif_to_wdev(arvif->ahvif->vif);
+	if (!wdev || !wdev->netdev) {
+		ret = -ENODEV;
+		goto fault;
+	}
+	peer = kzalloc(sizeof(*peer), GFP_KERNEL);
+	if (!peer) {
+		ret = -ENOMEM;
+		goto fault;
+	}
+	peer->ar = ar;
+	peer->vdev = arvif->vdev_id;
+	peer->vif = arvif->ahvif;
+	peer->dev = wdev->netdev;
+	peer->fallback = fallback;
+	peer->authorized = authorized;
+	ether_addr_copy(peer->addr, arsta->addr);
+	dev_hold(peer->dev);
+	spin_lock_bh(&ds->peer_lock);
+	list_add_tail(&peer->list, &ds->peers);
+	hash_add(ds->peer_vps, &peer->hash, ether_addr_to_u64(peer->addr));
+	spin_unlock_bh(&ds->peer_lock);
+	if (fallback) {
+		ds->fallback_events[fallback]++;
+		ret = ath12k_ds_route_vif(ds, arvif->ahvif, false);
+		goto unlock;
+	}
+	port = ath12k_ds_bind_vif(ds, arvif);
+	if (port < 0) {
+		ret = port;
+		goto peer_fault;
+	}
+	direct = authorized || ar->ab->hw_rev != ATH12K_HW_QCN9274_HW10;
+	ret = ath12k_wmi_config_peer_ds(ar, arsta->addr, arvif->vdev_id, port, direct);
+	if (ret)
+		goto peer_fault;
+	WRITE_ONCE(peer->enabled, direct);
+	ret = ath12k_ds_route_vif(ds, arvif->ahvif,
+				  ath12k_ds_vif_can_direct(ds, arvif->ahvif));
+	if (!ret)
+		goto unlock;
+peer_fault:
+	ath12k_ds_peer_cpu(ds, peer);
+	peer->fallback = ATH12K_DS_FALLBACK_CONTROL;
+	ds->fallback_events[ATH12K_DS_FALLBACK_CONTROL]++;
+fault:
+	ath12k_ds_fault(ds);
+unlock:
+	mutex_unlock(&ds->control_lock);
+	return ret;
+}
+
+int ath12k_wifi7_ds_peer_setup(struct ath12k *ar, struct ath12k_link_vif *arvif,
+			       struct ath12k_link_sta *arsta)
+{
+	if (!ath12k_wifi7_ds_hw1_compat(ar->ab))
+		return 0;
+	return ath12k_ds_peer_update(ar, arvif, arsta, false);
+}
+
+int ath12k_wifi7_ds_sta_state(struct ath12k *ar,
+			      struct ath12k_link_vif *arvif,
+			      struct ath12k_link_sta *arsta, bool enable)
+{
+	struct ath12k_ds_peer *peer, *tmp;
+	struct ath12k_ds *ds;
+	struct ath12k_dp *dp;
+	int i, error, ret = 0;
+
+	if (enable)
+		return ath12k_ds_peer_update(ar, arvif, arsta, true);
+	if (arvif->ahvif->vif->type != NL80211_IFTYPE_AP)
+		return 0;
+	ds = ath12k_ab_to_dp(ar->ab)->ds;
+	if (!ds)
+		return 0;
+	lockdep_assert_wiphy(ar->ah->hw->wiphy);
+	/* Primary/link maps may already have changed at teardown. */
+	for (i = 0; i < ATH12K_MAX_DEVICES; i++) {
+		dp = ar->ab->ag->dp_hw_grp.dp[i];
+		if (!dp || !dp->ds)
+			continue;
+		ds = dp->ds;
+		mutex_lock(&ds->control_lock);
+		list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+			if (peer->ar != ar || peer->vif != arvif->ahvif ||
+			    peer->vdev != arvif->vdev_id ||
+			    !ether_addr_equal(peer->addr, arsta->addr))
+				continue;
+			error = ath12k_ds_peer_cpu(ds, peer);
+			if (!ret)
+				ret = error;
+			spin_lock_bh(&ds->peer_lock);
+			list_del(&peer->list);
+			hash_del(&peer->hash);
+			spin_unlock_bh(&ds->peer_lock);
+			dev_put(peer->dev);
+			kfree(peer);
+		}
+		if (!ds->stopped && !ds->faulted)
+			ath12k_ds_route_vif(ds, arvif->ahvif,
+					    ath12k_ds_vif_can_direct(ds, arvif->ahvif));
+		mutex_unlock(&ds->control_lock);
+	}
+	return ret;
+}
+
+void ath12k_wifi7_ds_vif_remove(struct ath12k_link_vif *arvif,
+			       bool before, bool deleted)
+{
+	struct ath12k_hw_group *ag = arvif->ar->ab->ag;
+	struct ath12k_ds_peer *peer, *tmp;
+	struct ath12k_ds_vp *vp;
+	struct ath12k_ds *ds;
+	struct ath12k_dp *dp;
+	int n, i, ret, retry;
+	bool fault;
+
+	for (n = 0; n < ATH12K_MAX_DEVICES; n++) {
+		dp = ag->dp_hw_grp.dp[n];
+		if (!dp || !dp->ds)
+			continue;
+		ds = dp->ds;
+		fault = false;
+		mutex_lock(&ds->control_lock);
+		if (ds->quarantined) {
+			/* Keep hardware bank/VP leases and all DMA, but do not pin a
+			 * netdevice or mac80211 vif behind an inert quarantine.
+			 */
+			list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+				if (peer->vif != arvif->ahvif)
+					continue;
+				spin_lock_bh(&ds->peer_lock);
+				list_del(&peer->list);
+				hash_del(&peer->hash);
+				spin_unlock_bh(&ds->peer_lock);
+				dev_put(peer->dev);
+				kfree(peer);
+			}
+			for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+				vp = &ds->vps[i];
+				if (vp->vif != arvif->ahvif)
+					continue;
+				vp->vif = NULL;
+				vp->closing = true;
+				if (vp->dev) {
+					dev_put(vp->dev);
+					vp->dev = NULL;
+				}
+			}
+			mutex_unlock(&ds->control_lock);
+			continue;
+		}
+		if (before) {
+			if (ath12k_ds_route_vif(ds, arvif->ahvif, false))
+				fault = true;
+			list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+				if (peer->vif != arvif->ahvif)
+					continue;
+				if (ath12k_ds_peer_disable(peer))
+					fault = true;
+				spin_lock_bh(&ds->peer_lock);
+				list_del(&peer->list);
+				hash_del(&peer->hash);
+				spin_unlock_bh(&ds->peer_lock);
+				dev_put(peer->dev);
+				kfree(peer);
+			}
+		}
+		for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+			vp = &ds->vps[i];
+			if (vp->vif != arvif->ahvif)
+				continue;
+			if (before) {
+				vp->closing = true;
+				ret = qcom_ppe_ds_vp_route(ds->handle, vp->port, false);
+				for (retry = 0; !ret && retry < 200; retry++) {
+					qcom_ppe_ds_sync(ds->handle);
+					if (ath12k_ds_tcl_cons(ds) ==
+					    ath12k_ds_srng(ds, &ds->tcl)->u.src_ring.hp /
+					    ath12k_ds_srng(ds, &ds->tcl)->entry_size) {
+						vp->drained = true;
+						break;
+					}
+					usleep_range(1000, 2000);
+				}
+				if (ret || !vp->drained)
+					fault = true;
+			} else {
+				/* Software references end with the interface. The reserved
+				 * bit keeps unacknowledged VP/bank leases unavailable even
+				 * after both vif and netdev pointers have been withdrawn.
+				 */
+				vp->vif = NULL;
+				if (vp->dev) {
+					dev_put(vp->dev);
+					vp->dev = NULL;
+				}
+				if (!deleted || !vp->drained || ds->faulted)
+					continue;
+				ath12k_hif_write32(dp->ab, ATH12K_DS_VP_TABLE + i * 4, 0);
+				ath12k_hif_read32(dp->ab, ATH12K_DS_VP_TABLE + i * 4);
+				ret = qcom_ppe_ds_vp_free(ds->handle, vp->port);
+				if (ret) {
+					fault = true;
+					continue;
+				}
+				ath12k_dp_tx_put_bank_profile(dp, vp->bank);
+				memset(vp, 0, sizeof(*vp));
+			}
+		}
+		mutex_unlock(&ds->control_lock);
+		if (fault)
+			ath12k_ds_fault(ds);
+	}
+}
+
+int ath12k_wifi7_ds_stop(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+	struct ath12k_ds_peer *peer;
+	int i, err, control_error = 0, ret = 0;
+
+	if (!ds)
+		return 0;
+	if (current_work() != &ds->fault_work)
+		cancel_work_sync(&ds->fault_work);
+	mutex_lock(&ds->control_lock);
+	if (ds->quarantined) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	if (ds->stopped) {
+		ret = ds->stop_control_error;
+		goto unlock;
+	}
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++)
+		if (ds->vps[i].reserved) {
+			err = qcom_ppe_ds_vp_route(ds->handle, ds->vps[i].port, false);
+			if (err)
+				ath12k_warn(dp->ab,
+					    "DS VP CPU route failed: %d; stop will retry\n", err);
+		}
+	list_for_each_entry(peer, &ds->peers, list) {
+		err = ath12k_ds_peer_disable(peer);
+		if (err && !control_error)
+			control_error = err;
+	}
+	ds->stop_control_error = control_error;
+	if (ds->reo_ready) {
+		ath12k_wifi7_hal_ds_disable(dp->ab, ath12k_ds_srng(ds, &ds->reo));
+		/* Observe the final DMA head writeback before EDMA drains. */
+		usleep_range(1000, 2000);
+		if (ds->handle)
+			qcom_ppe_ds_sync(ds->handle);
+	}
+	if (ds->handle)
+		ret = qcom_ppe_ds_stop(ds->handle);
+	if (ds->tcl_ready)
+		ath12k_wifi7_hal_ds_disable(dp->ab, ath12k_ds_srng(ds, &ds->tcl));
+	if (!ret)
+		WRITE_ONCE(ds->stopped, true);
+	if (!ret) {
+		for_each_set_bit(i, &ds->reo_mapped, ATH12K_MAX_DEVICES) {
+			struct ath12k_dp *partner = dp->ab->ag->dp_hw_grp.dp[i];
+			u32 reg = HAL_SEQ_WCSS_UMAC_REO_REG +
+				  HAL_REO1_DEST_RING_CTRL_IX_0;
+			u32 val;
+
+			if (!partner ||
+			    test_bit(ATH12K_FLAG_CRASH_FLUSH, &partner->ab->dev_flags))
+				continue;
+			val = ath12k_hif_read32(partner->ab, reg);
+			val = (val & ~GENMASK(27, 24)) | ds->reo_map[i];
+			ath12k_hif_write32(partner->ab, reg, val);
+		}
+		ds->reo_mapped = 0;
+	}
+	if (control_error) {
+		ath12k_warn(dp->ab, "DS CPU peer routing unconfirmed: %d\n", control_error);
+		if (!ret)
+			ret = control_error;
+	}
+unlock:
+	mutex_unlock(&ds->control_lock);
+	return ret;
+}
+
+bool ath12k_wifi7_ds_dma_stopped(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+
+	return !ds || READ_ONCE(ds->stopped);
+}
+
+void ath12k_wifi7_ds_quarantine(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+
+	if (!ds)
+		return;
+	mutex_lock(&ds->control_lock);
+	if (ds->handle)
+		qcom_ppe_ds_detach(ds->handle);
+	WRITE_ONCE(ds->faulted, true);
+	WRITE_ONCE(ds->quarantined, true);
+	mutex_unlock(&ds->control_lock);
+}
+
+int ath12k_wifi7_ds_cleanup(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = dp->ds;
+	struct ath12k_ds_peer *peer, *tmp;
+	int ret, i;
+
+	if (!ds)
+		return 0;
+	cancel_work_sync(&ds->fault_work);
+	debugfs_remove(ds->debugfs);
+	ds->debugfs = NULL;
+	if (ds->quarantined)
+		goto quarantine;
+	if (ds->handle) {
+		ret = qcom_ppe_ds_unregister(ds->handle);
+		if (ret) {
+			ath12k_dp_ds_quarantine_group(dp->ab->ag);
+			ath12k_wifi7_ds_quarantine(dp);
+			dp->ds_quarantined = true;
+			goto quarantine;
+		}
+		ds->handle = NULL;
+	}
+	WRITE_ONCE(ds->stopped, true);
+	list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+		list_del(&peer->list);
+		hash_del(&peer->hash);
+		dev_put(peer->dev);
+		kfree(peer);
+	}
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+		if (!ds->vps[i].reserved)
+			continue;
+		ath12k_dp_tx_put_bank_profile(dp, ds->vps[i].bank);
+		if (ds->vps[i].dev)
+			dev_put(ds->vps[i].dev);
+	}
+	/* The caller must already have synchronized WLAN IRQ/NAPI and stopped
+	 * WLAN DMA before releasing the shared rings and completion buffers.
+	 */
+	if (ds->complete_ready)
+		ath12k_dp_srng_cleanup(dp->ab, &ds->complete);
+	if (ds->reo_ready)
+		ath12k_dp_srng_cleanup(dp->ab, &ds->reo);
+	if (ds->tcl_ready)
+		ath12k_dp_srng_cleanup(dp->ab, &ds->tcl);
+	ath12k_ds_free_buffers(ds);
+	dp->ds = NULL;
+	kfree(ds);
+	return 0;
+quarantine:
+	list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+		list_del(&peer->list);
+		hash_del(&peer->hash);
+		dev_put(peer->dev);
+		kfree(peer);
+	}
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+		if (ds->vps[i].dev)
+			dev_put(ds->vps[i].dev);
+		ds->vps[i].dev = NULL;
+		ds->vps[i].vif = NULL;
+	}
+	ds->dp = NULL;
+	return -EIO;
+}
+
+int ath12k_wifi7_ds_setup(struct ath12k_dp *dp)
+{
+	struct qcom_ppe_ds_config config = {};
+	struct ath12k_ds *ds;
+	int ret, i;
+
+	if (!qcom_ppe_ds_available())
+		return 0;
+	if (dp->ab->hw_rev != ATH12K_HW_QCN9274_HW10 &&
+	    dp->ab->hw_rev != ATH12K_HW_QCN9274_HW20)
+		return 0;
+	/* Unknown HW1 firmware and raw RX keep the ordinary CPU datapath. */
+	if (dp->ab->hw_rev == ATH12K_HW_QCN9274_HW10 &&
+	    (!ath12k_wifi7_ds_hw1_compat(dp->ab) ||
+	     test_bit(ATH12K_FLAG_RAW_MODE, &dp->ab->dev_flags)))
+		return 0;
+
+	dp->ds_rx_bidir = true;
+	ds = kzalloc(sizeof(*ds), GFP_KERNEL);
+	if (!ds)
+		return -ENOMEM;
+	ds->dp = dp;
+	mutex_init(&ds->control_lock);
+	spin_lock_init(&ds->peer_lock);
+	INIT_LIST_HEAD(&ds->peers);
+	hash_init(ds->peer_vps);
+	ds->hw1_compat = ath12k_wifi7_ds_hw1_compat(dp->ab);
+	INIT_WORK(&ds->fault_work, ath12k_ds_fault_work);
+	spin_lock_init(&ds->tx_lock);
+	spin_lock_init(&ds->rx_lock);
+	INIT_LIST_HEAD(&ds->free_buffers);
+	for (i = 0; i < ATH12K_MAX_DEVICES; i++)
+		INIT_LIST_HEAD(&ds->pending_rx[i]);
+	dp->ds = ds;
+	ret = ath12k_ds_alloc_buffers(ds);
+	if (ret)
+		goto fail;
+	ret = ath12k_dp_srng_setup(dp->ab, &ds->tcl, HAL_PPE2TCL, 0, 0,
+				   ATH12K_DS_RING_ENTRIES);
+	if (ret)
+		goto fail;
+	ds->tcl_ready = true;
+	ret = ath12k_dp_srng_setup(dp->ab, &ds->reo, HAL_REO2PPE, 0, 0,
+				   ATH12K_DS_RING_ENTRIES);
+	if (ret)
+		goto fail;
+	ds->reo_ready = true;
+	ret = ath12k_dp_srng_setup(dp->ab, &ds->complete, HAL_WBM2SW_RELEASE,
+				   HAL_WBM2SW_DS_RING_NUM, 0, ATH12K_DS_RING_ENTRIES);
+	if (ret)
+		goto fail;
+	ds->complete_ready = true;
+	config.wlan_dev = dp->dev;
+	config.ops = &ath12k_ds_ops;
+	config.priv = ds;
+	config.ppe2tcl = ath12k_ds_srng(ds, &ds->tcl)->ring_base_paddr;
+	config.reo2ppe = ath12k_ds_srng(ds, &ds->reo)->ring_base_paddr;
+	config.ppe2tcl_count = ATH12K_DS_RING_ENTRIES;
+	config.reo2ppe_count = ATH12K_DS_RING_ENTRIES;
+	config.buffer_size = ATH12K_DS_BUFFER_SIZE;
+	ds->handle = qcom_ppe_ds_register(&config);
+	if (IS_ERR(ds->handle)) {
+		ret = PTR_ERR(ds->handle);
+		ds->handle = NULL;
+		goto fail;
+	}
+	/* Registration only. VP/peer setup must complete before starting DMA. */
+	if (dp->ab->debugfs_soc)
+		ds->debugfs = debugfs_create_file("direct_switch", 0400,
+						 dp->ab->debugfs_soc, ds,
+						 &ath12k_ds_stats_fops);
+	ath12k_info(dp->ab, "native PPE Direct Switch rings registered (CPU fallback until authorization)\n");
+	return 0;
+
+fail:
+	ath12k_wifi7_ds_cleanup(dp);
+	return ret;
+}
