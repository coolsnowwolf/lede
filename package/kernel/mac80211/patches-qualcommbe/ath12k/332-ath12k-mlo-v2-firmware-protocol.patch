-						   peer_id);
-		if (ret)
-			ath12k_warn(ab,
-				    "failed to fix up peer id %u for dp peer %pM: %d\n",
-				    peer_id, peer_addr, ret);
+static void ath12k_dp_htt_mlo_peer_unmap_handler(struct ath12k_base *ab,
+						 struct sk_buff *skb)
+{
+	const __le32 *info0 = (const __le32 *)skb->data;
+	u16 peer_id;
+
+	if (skb->len < sizeof(*info0)) {
+		ath12k_warn(ab, "unexpected htt mlo peer unmap event len %u\n",
+			    skb->len);
+		return;
 	}
+
+	peer_id = le32_get_bits(*info0,
+				HTT_T2H_MLO_PEER_UNMAP_INFO0_MLO_PEER_ID);
+	peer_id |= ATH12K_PEER_ML_ID_VALID;
+
+	ath12k_dp_peer_mlo_unmap_event(ab, peer_id);
 }
 
