+static int
+ath12k_qmi_fill_mlo_adjacent_info(struct ath12k_base *ab,
+				  struct wlfw_host_mlo_chip_info_s_v02 *info)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+	struct wlfw_host_mlo_chip_info_s_v01 *adj_info;
+	struct ath12k_base *adjacent_ab;
+	u32 adjacent_index[QMI_WLFW_MAX_NUM_MLO_ADJ_CHIPS_V01];
+	u32 index;
+	int i, j, link, num_adjacent = 0;
+
+	lockdep_assert_held(&ag->mutex);
+
+	if (ag->num_devices <= 1)
+		return 0;
+
+	/* The DT graph describes a circular WSI chain.  The preceding and
+	 * following entries are the only possible adjacent chips.  In a
+	 * two-chip group both directions lead to the same neighbour.
+	 */
+	index = (ab->wsi_info.index + ag->num_devices - 1) % ag->num_devices;
+	adjacent_index[num_adjacent++] = index;
+
+	index = (ab->wsi_info.index + 1) % ag->num_devices;
+	if (index != adjacent_index[0])
+		adjacent_index[num_adjacent++] = index;
+
+	for (i = 0; i < num_adjacent; i++) {
+		adjacent_ab = NULL;
+		for (j = 0; j < ag->num_devices; j++) {
+			if (ag->ab[j] &&
+			    ag->ab[j]->wsi_info.index == adjacent_index[i]) {
+				adjacent_ab = ag->ab[j];
+				break;
+			}
+		}
+
+		if (!adjacent_ab ||
+		    adjacent_ab->device_id == ATH12K_INVALID_DEVICE_ID ||
+		    !adjacent_ab->qmi.num_radios ||
+		    adjacent_ab->qmi.num_radios == U8_MAX ||
+		    adjacent_ab->qmi.num_radios >
+				QMI_WLFW_MAX_NUM_MLO_LINKS_PER_CHIP_V01) {
+			ath12k_err(ab, "invalid MLO adjacent chip at WSI index %u\n",
+				   adjacent_index[i]);
+			return -EINVAL;
+		}
+
+		adj_info = &info->mlo_adj_chip_info[i];
+		adj_info->chip_id = adjacent_ab->device_id;
+		adj_info->num_local_links = adjacent_ab->qmi.num_radios;
+
+		for (link = 0; link < adj_info->num_local_links; link++) {
+			adj_info->hw_link_id[link] =
+				adjacent_ab->wsi_info.hw_link_id_base + link;
+			adj_info->valid_mlo_link_id[link] = 1;
+		}
+
+		ath12k_dbg(ab, ATH12K_DBG_QMI,
+			   "MLO adjacent chip id %d WSI index %u links %d\n",
+			   adj_info->chip_id, adjacent_index[i],
+			   adj_info->num_local_links);
+	}
+
+	info->num_adj_chips = num_adjacent;
+
+	return 0;
+}
