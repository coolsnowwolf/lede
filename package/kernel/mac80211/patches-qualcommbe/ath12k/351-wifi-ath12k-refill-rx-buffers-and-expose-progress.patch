From: ViKing <viking.yfy@qq.com>
Date: Sun, 25 Oct 2026 14:06:01 +0800
Subject: [PATCH] wifi: ath12k: service RX returns and refill buffers

IPQ5332 RX error buffers are returned through WBM SW3, while the legacy
wbm2host-rx-release AHB vector belongs to a distinct hardware error ring.
Manual uplink traffic fills the unserviced SW3 ring with 6143 descriptors,
exhausts the host packet buffers and triggers missing-ACK kickout followed
by a receive stall. Normal packet-buffer refilling alone cannot reclaim
descriptors that remain in the WBM return ring.

Use the fourth WBM completion vector for the IPQ5332 SW3 RX error ring.
Its three TX rings use SW0 through SW2, so SW3 is not a TX completion ring.
Preserve other hardware IRQ mappings and the normal IRQ/NAPI lifecycle.

Check RX buffer low-water refill at RX/error NAPI exits, including budget
exhaustion, and register the AHB refill vector declared by the ring mask.
Use the descriptor's partner device for WBM refilling, as already used
for DMA unmapping. Keep the common threshold, locks and descriptor pool;
do not add a timer, recovery loop or polling workaround.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/ahb.c
+++ b/drivers/net/wireless/ath/ath12k/ahb.c
@@ -705,13 +705,28 @@ static int ath12k_ahb_config_ext_irq(str
 				irq_grp->irqs[num_irq++] = reo2host_exception;
 
 			if (ring_mask->rx_wbm_rel[i] & BIT(j) &&
-			    num_irq < ATH12K_EXT_IRQ_NUM_MAX)
-				irq_grp->irqs[num_irq++] = wbm2host_rx_release;
+			    num_irq < ATH12K_EXT_IRQ_NUM_MAX) {
+				irq_idx = wbm2host_rx_release;
+				/* IPQ5332 returns RX errors through WBM SW3. The
+				 * legacy RX release vector is a separate error
+				 * ring; the fourth completion vector serves SW3.
+				 */
+				if (ab->hw_rev == ATH12K_HW_IPQ5332_HW10)
+					irq_idx = wbm2host_tx_completions_ring1 -
+						  HAL_WBM2SW_REL_ERR_RING_NUM;
+				irq_grp->irqs[num_irq++] = irq_idx;
+			}
 
 			if (ring_mask->reo_status[i] & BIT(j) &&
 			    num_irq < ATH12K_EXT_IRQ_NUM_MAX)
 				irq_grp->irqs[num_irq++] = reo2host_status;
 
+			if (ring_mask->host2rxdma[i] & BIT(j) &&
+			    j < ab->hw_params->max_radios &&
+			    num_irq < ATH12K_EXT_IRQ_NUM_MAX)
+				irq_grp->irqs[num_irq++] =
+					host2rxdma_host_buf_ring_mac1 - j;
+
 			if (ring_mask->rx_mon_dest[i] & BIT(j) &&
 			    num_irq < ATH12K_EXT_IRQ_NUM_MAX)
 				irq_grp->irqs[num_irq++] =
@@ -725,14 +740,18 @@ static int ath12k_ahb_config_ext_irq(str
 
 			irq = platform_get_irq_byname(ab->pdev,
 						      irq_name[irq_idx]);
+			if (irq < 0)
+				return irq;
 			ab->irq_num[irq_idx] = irq;
 			irq_set_status_flags(irq, IRQ_NOAUTOEN | IRQ_DISABLE_UNLAZY);
 			ret = devm_request_irq(ab->dev, irq,
 					       ath12k_ahb_ext_interrupt_handler,
 					       IRQF_TRIGGER_RISING,
 					       irq_name[irq_idx], irq_grp);
-			if (ret)
+			if (ret) {
 				ath12k_warn(ab, "failed request_irq for %d\n", irq);
+				return ret;
+			}
 		}
 	}
 
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/dp.c
@@ -127,16 +127,23 @@ static int ath12k_wifi7_dp_service_srng(
 	if (dp->hw_params->ring_mask->reo_status[grp_id])
 		ath12k_wifi7_dp_rx_process_reo_status(dp);
 
-	if (dp->hw_params->ring_mask->host2rxdma[grp_id]) {
+	/* TODO: Implement handler for other interrupts */
+
+done:
+	/* Recycled descriptors may be on the free list after a burst. Normal
+	 * RX groups lack the refill IRQ, and an exhausted packet budget must
+	 * not skip a low-water refill. The common helper checks ring space.
+	 */
+	if (dp->hw_params->ring_mask->host2rxdma[grp_id] ||
+	    dp->hw_params->ring_mask->rx[grp_id] ||
+	    dp->hw_params->ring_mask->rx_err[grp_id] ||
+	    dp->hw_params->ring_mask->rx_wbm_rel[grp_id]) {
 		struct dp_rxdma_ring *rx_ring = &dp->rx_refill_buf_ring;
 		LIST_HEAD(list);
 
 		ath12k_dp_rx_bufs_replenish(dp, rx_ring, &list, 0);
 	}
 
-	/* TODO: Implement handler for other interrupts */
-
-done:
 	return tot_work_done;
 }
 
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/dp_rx.c
@@ -2052,7 +2052,7 @@ int ath12k_wifi7_dp_rx_process_wbm_err(s
 		partner_dp = ath12k_dp_hw_grp_to_dp(dp_hw_grp, device_id);
 		rx_ring = &partner_dp->rx_refill_buf_ring;
 
-		ath12k_dp_rx_bufs_replenish(dp, rx_ring,
+		ath12k_dp_rx_bufs_replenish(partner_dp, rx_ring,
 					    &rx_desc_used_list[device_id],
 					    num_buffs_reaped[device_id]);
 	}
