From dabc3c5b89b6fb2bf45cbc452a52067de2e8fc8b Mon Sep 17 00:00:00 2001
From: ViKing <viking.yfy@qq.com>
Date: Sun, 25 Oct 2026 12:10:24 +0800
Subject: [PATCH] wifi: ath12k: fix MSI descriptor lookup with pci_irq_vector

Use the allocated PCI IRQ vector to find the MSI descriptor, with a
legacy pdev->irq fallback for compatibility.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
 drivers/net/wireless/ath/ath12k/pci.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -790,7 +790,9 @@ static int ath12k_pci_msi_alloc(struct a
 
 	ath12k_pci_msi_disable(ab_pci);
 
-	msi_desc = irq_get_msi_desc(ab_pci->pdev->irq);
+	msi_desc = irq_get_msi_desc(pci_irq_vector(ab_pci->pdev, 0));
+	if (!msi_desc)
+		msi_desc = irq_get_msi_desc(ab_pci->pdev->irq);
 	if (!msi_desc) {
 		ath12k_err(ab, "msi_desc is NULL!\n");
 		ret = -EINVAL;
@@ -821,7 +823,9 @@ static int ath12k_pci_config_msi_data(st
 {
 	struct msi_desc *msi_desc;
 
-	msi_desc = irq_get_msi_desc(ab_pci->pdev->irq);
+	msi_desc = irq_get_msi_desc(pci_irq_vector(ab_pci->pdev, 0));
+	if (!msi_desc)
+		msi_desc = irq_get_msi_desc(ab_pci->pdev->irq);
 	if (!msi_desc) {
 		ath12k_err(ab_pci->ab, "msi_desc is NULL!\n");
 		pci_free_irq_vectors(ab_pci->pdev);
