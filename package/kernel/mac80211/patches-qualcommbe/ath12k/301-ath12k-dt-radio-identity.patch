 	phy_id_map = le32_to_cpu(svc_rdy_ext->pref_hw_mode_caps.phy_id_map);
 	soc->fw_pdev_count = 0;
 
-	while (phy_id_map && soc->num_radios < MAX_RADIOS) {
+	while (phy_id_map && soc->num_radios < max_radios) {
 		ret = ath12k_pull_mac_phy_cap_svc_ready_ext(wmi_handle,
 							    svc_rdy_ext,
 							    hw_mode_id, soc->num_radios,
