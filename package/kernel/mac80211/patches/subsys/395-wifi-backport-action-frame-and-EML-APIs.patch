From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] wifi: backport action frame and EML APIs

New mt76 versions use the action frame field-size helper and generic EML
delay names from newer wireless-next. Backport the small API surface without
replacing the 6.18.39 backports release.

Keep the legacy object-like IEEE80211_MIN_ACTION_SIZE use working through
an enum constant while providing the new function-like form.  Overlay the
new direct action_code member on the existing action union so the layout and
old member paths remain unchanged.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
 a/include/linux/ieee80211-eht.h | 4 ++++
 a/include/linux/ieee80211.h     | 9 +++++++--
 2 files changed, 12 insertions(+), 2 deletions(-)

--- a/include/linux/ieee80211-eht.h
+++ b/include/linux/ieee80211-eht.h
@@ -486,12 +486,16 @@
 
 #define IEEE80211_EML_CAP_EMLSR_SUPP			0x0001
 #define IEEE80211_EML_CAP_EMLSR_PADDING_DELAY		0x000e
+#define IEEE80211_EML_CAP_EML_PADDING_DELAY		\
+	IEEE80211_EML_CAP_EMLSR_PADDING_DELAY
 #define  IEEE80211_EML_CAP_EMLSR_PADDING_DELAY_0US		0
 #define  IEEE80211_EML_CAP_EMLSR_PADDING_DELAY_32US		1
 #define  IEEE80211_EML_CAP_EMLSR_PADDING_DELAY_64US		2
 #define  IEEE80211_EML_CAP_EMLSR_PADDING_DELAY_128US		3
 #define  IEEE80211_EML_CAP_EMLSR_PADDING_DELAY_256US		4
 #define IEEE80211_EML_CAP_EMLSR_TRANSITION_DELAY	0x0070
+#define IEEE80211_EML_CAP_EML_TRANSITION_DELAY		\
+	IEEE80211_EML_CAP_EMLSR_TRANSITION_DELAY
 #define  IEEE80211_EML_CAP_EMLSR_TRANSITION_DELAY_0US		0
 #define  IEEE80211_EML_CAP_EMLSR_TRANSITION_DELAY_16US		1
 #define  IEEE80211_EML_CAP_EMLSR_TRANSITION_DELAY_32US		2
--- a/include/linux/ieee80211.h
+++ b/include/linux/ieee80211.h
@@ -1228,6 +1228,9 @@
 		struct {
 			u8 category;
 			union {
+				u8 action_code;
+				union {
+					u8 action_code;
 				struct {
 					u8 action_code;
 					u8 dialog_token;
@@ -1373,7 +1376,8 @@
 					u8 control;
 					u8 variable[];
 				} __packed eml_omn;
-			} u;
+				} u;
+			};
 		} __packed action;
 		DECLARE_FLEX_ARRAY(u8, body); /* Generic frame body */
 	} u;
@@ -1391,7 +1395,13 @@
 #define BSS_MEMBERSHIP_SELECTOR_MIN	BSS_MEMBERSHIP_SELECTOR_EHT_PHY
 
 /* mgmt header + 1 byte category code */
-#define IEEE80211_MIN_ACTION_SIZE offsetof(struct ieee80211_mgmt, u.action.u)
+enum {
+	IEEE80211_MIN_ACTION_SIZE = offsetof(struct ieee80211_mgmt, u.action.u),
+};
+
+/* Also support checking the size of individual action frame fields. */
+#define IEEE80211_MIN_ACTION_SIZE(type) \
+	offsetofend(struct ieee80211_mgmt, u.action.u.type)
 
 
 /* Management MIC information element (IEEE 802.11w) */
