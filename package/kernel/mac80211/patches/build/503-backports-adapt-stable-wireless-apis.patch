Subject: [PATCH] backports: adapt to stable wireless API changes

Linux 6.12.119 provides sk_requests_wifi_status and Linux 6.18.65
uses a typed namespace callback. Use the native interfaces where present.
Include linux/hex.h explicitly for mac_pton on Linux 7.3.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/backport-include/net/sock.h
+++ b/backport-include/net/sock.h
@@ -23,12 +23,13 @@
 #define sk_error_report(sk) LINUX_BACKPORT(sk_error_report(sk))
 #endif /* <= 5.14 */
 
-#if LINUX_VERSION_IS_LESS(6,16,0)
+#if LINUX_VERSION_IS_LESS(6, 16, 0) && \
+    !LINUX_VERSION_IN_RANGE(6, 12, 119, 6, 13, 0)
 static inline bool
 sk_requests_wifi_status(struct sock *sk)
 {
 	return sk && sk_fullsock(sk) && sock_flag(sk, SOCK_WIFI_STATUS);
 }
-#endif /* <= 6.16 */
+#endif /* missing sk_requests_wifi_status */
 
 #endif /* __BACKPORT_NET_SOCK_H */
--- a/net/wireless/sysfs.c
+++ b/net/wireless/sysfs.c
@@ -154,6 +154,15 @@
 #define WIPHY_PM_OPS NULL
 #endif
 
+#if LINUX_VERSION_IS_GEQ(7, 0, 0) || \
+    LINUX_VERSION_IN_RANGE(6, 18, 65, 6, 19, 0)
+static const struct ns_common *wiphy_namespace(const struct device *d)
+{
+	struct wiphy *wiphy = container_of(d, struct wiphy, dev);
+
+	return to_ns_common(wiphy_net(wiphy));
+}
+#else
 static const void *wiphy_namespace(const struct device *d)
 {
 	struct wiphy *wiphy = container_of(d, struct wiphy, dev);
@@ -161,6 +170,8 @@
 	return wiphy_net(wiphy);
 }
 
+#endif
+
 struct class ieee80211_class = {
 	.name = "ieee80211",
 	.dev_release = wiphy_dev_release,
--- a/net/wireless/sysfs.c
+++ b/net/wireless/sysfs.c
@@ -9,6 +9,7 @@
  */
 
 #include <linux/device.h>
+#include <linux/hex.h>
 #include <linux/module.h>
 #include <linux/netdevice.h>
 #include <linux/nl80211.h>
--- a/net/mac80211/debugfs_netdev.c
+++ b/net/mac80211/debugfs_netdev.c
@@ -6,6 +6,7 @@
  */
 
 #include <linux/kernel.h>
+#include <linux/hex.h>
 #include <linux/device.h>
 #include <linux/if.h>
 #include <linux/if_ether.h>
