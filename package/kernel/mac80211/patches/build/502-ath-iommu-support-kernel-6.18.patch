From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] ath: use paging IOMMU domains on Linux 6.18

Linux 6.18 removed iommu_domain_alloc(). Use the device-based paging
domain helper while retaining the older-kernel backport path.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/drivers/net/wireless/ath/ath10k/snoc.c
+++ b/drivers/net/wireless/ath/ath10k/snoc.c
@@ -1630,10 +1630,14 @@
 
 	ar_snoc->fw.dev = &pdev->dev;
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	iommu_dom = iommu_paging_domain_alloc(ar_snoc->fw.dev);
+#else
 	iommu_dom = iommu_domain_alloc(&platform_bus_type);
-	if (!iommu_dom) {
+#endif
+	if (IS_ERR_OR_NULL(iommu_dom)) {
 		ath10k_err(ar, "failed to allocate iommu domain\n");
-		ret = -ENOMEM;
+		ret = iommu_dom ? PTR_ERR(iommu_dom) : -ENOMEM;
 		goto err_unregister;
 	}
 
--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -1074,10 +1074,14 @@
 
 	ab_ahb->fw.dev = &pdev->dev;
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	iommu_dom = iommu_paging_domain_alloc(ab_ahb->fw.dev);
+#else
 	iommu_dom = iommu_domain_alloc(&platform_bus_type);
-	if (!iommu_dom) {
+#endif
+	if (IS_ERR_OR_NULL(iommu_dom)) {
 		ath11k_err(ab, "failed to allocate iommu domain\n");
-		ret = -ENOMEM;
+		ret = iommu_dom ? PTR_ERR(iommu_dom) : -ENOMEM;
 		goto err_unregister;
 	}
 
