From: lean <chenlin@fnnas.com>
Subject: [PATCH] cfg80211: handle netns_immutable in Linux 6.12.114

Linux 6.12.114 backports the netns_local rename from Linux 6.15.
Keep the original API for earlier 6.12 releases.

Signed-off-by: lean <chenlin@fnnas.com>

--- a/net/wireless/core.c
+++ b/net/wireless/core.c
@@ -162,11 +162,21 @@
 	list_for_each_entry(wdev, &rdev->wiphy.wdev_list, list) {
 		if (!wdev->netdev)
 			continue;
+#if LINUX_VERSION_IS_GEQ(6,15,0) || \
+    (LINUX_VERSION_IS_GEQ(6,12,114) && LINUX_VERSION_IS_LESS(6,13,0))
 		wdev->netdev->netns_immutable = false;
+#elif LINUX_VERSION_IS_GEQ(6,12,0)
+		wdev->netdev->netns_local = false;
+#endif
 		err = dev_change_net_namespace(wdev->netdev, net, "wlan%d");
 		if (err)
 			break;
+#if LINUX_VERSION_IS_GEQ(6,15,0) || \
+    (LINUX_VERSION_IS_GEQ(6,12,114) && LINUX_VERSION_IS_LESS(6,13,0))
 		wdev->netdev->netns_immutable = true;
+#elif LINUX_VERSION_IS_GEQ(6,12,0)
+		wdev->netdev->netns_local = true;
+#endif
 	}
 
 	if (err) {
@@ -178,11 +188,21 @@
 						     list) {
 			if (!wdev->netdev)
 				continue;
+#if LINUX_VERSION_IS_GEQ(6,15,0) || \
+    (LINUX_VERSION_IS_GEQ(6,12,114) && LINUX_VERSION_IS_LESS(6,13,0))
 			wdev->netdev->netns_immutable = false;
+#elif LINUX_VERSION_IS_GEQ(6,12,0)
+			wdev->netdev->netns_local = false;
+#endif
 			err = dev_change_net_namespace(wdev->netdev, net,
 							"wlan%d");
 			WARN_ON(err);
+#if LINUX_VERSION_IS_GEQ(6,15,0) || \
+    (LINUX_VERSION_IS_GEQ(6,12,114) && LINUX_VERSION_IS_LESS(6,13,0))
 			wdev->netdev->netns_immutable = true;
+#elif LINUX_VERSION_IS_GEQ(6,12,0)
+			wdev->netdev->netns_local = true;
+#endif
 		}
 
 		return err;
@@ -1549,7 +1569,12 @@
 		SET_NETDEV_DEVTYPE(dev, &wiphy_type);
 		wdev->netdev = dev;
 		/* can only change netns with wiphy */
+#if LINUX_VERSION_IS_GEQ(6,15,0) || \
+    (LINUX_VERSION_IS_GEQ(6,12,114) && LINUX_VERSION_IS_LESS(6,13,0))
 		dev->netns_immutable = true;
+#elif LINUX_VERSION_IS_GEQ(6,12,0)
+		dev->netns_local = true;
+#endif
 
 		cfg80211_init_wdev(wdev);
 		break;
