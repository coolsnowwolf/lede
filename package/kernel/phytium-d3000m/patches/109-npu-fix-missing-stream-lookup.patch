From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] phytium: npu fix missing stream lookup

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/npu_driver/phytium-npu/phytium_npu_workqueue.c
+++ b/npu_driver/phytium-npu/phytium_npu_workqueue.c
@@ -48,10 +48,10 @@
 
 	list_for_each_entry_safe(nesstream, tmp, &sess->stream_list, stream_list_entry) {
 		if (nesstream->nustream.estream.sid == stream_id)
-			break;
+			return nesstream;
 	}
 
-	return nesstream;
+	return NULL;
 }
 
 static struct npu_user_stream_rsp *
