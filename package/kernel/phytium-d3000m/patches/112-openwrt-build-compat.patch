 #if LINUX_VERSION_CODE < KERNEL_VERSION(6, 17, 0)
-	info = drm_get_format_info(dev, mode_cmd->pixel_format,
-					   mode_cmd->modifier[0]);
+	info = drm_get_format_info(dev, mode_cmd);
 #endif
 	if (!info)
 		return ERR_PTR(-EINVAL);
@@ -342,8 +341,15 @@
 	return NULL;
 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 17, 0)
 static const struct drm_format_info *ftd330_get_format_info(u32 format, u64 modifier)
 {
+#else
+static const struct drm_format_info *ftd330_get_format_info(const struct drm_mode_fb_cmd2 *cmd)
+{
+	u32 format = cmd->pixel_format;
+	u64 modifier = cmd->modifier[0];
+#endif
 	if (fourcc_mod_is_custom_format(modifier))
 		return ftd330_lookup_format_info(ftd330_formats_custom, ARRAY_SIZE(ftd330_formats_custom),
 						     format);
