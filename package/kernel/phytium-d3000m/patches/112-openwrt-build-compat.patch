+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 11, 0)
+	.vmap = npu_system_heap_vmap_legacy,
+	.vunmap = npu_system_heap_vunmap_legacy,
+#else
 	.vmap = npu_system_heap_vmap,
 	.vunmap = npu_system_heap_vunmap,
+#endif
