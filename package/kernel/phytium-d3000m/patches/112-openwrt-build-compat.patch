 };
 
@@ -347,7 +369,11 @@
 	}
 
 	/* create the pdmabuf */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 11, 0)
+	exp_info.exp_name = "npu_heap";
+#else
 	exp_info.exp_name = dma_heap_get_name(heap);
+#endif
 	exp_info.ops = &npu_system_heap_buf_ops;
 	exp_info.size = buffer->req_len;
 	exp_info.flags = fd_flags;
@@ -374,8 +400,30 @@
 	return ERR_PTR(ret);
 }
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 11, 0)
+static int npu_system_heap_alloc_legacy(struct dma_heap *heap, unsigned long len,
+				       unsigned long fd_flags, unsigned long heap_flags)
+{
+	struct dma_buf *buf;
+	int fd;
+
+	buf = npu_system_heap_alloc(heap, len, fd_flags, heap_flags);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+
+	fd = dma_buf_fd(buf, fd_flags);
+	if (fd < 0)
+		dma_buf_put(buf);
+	return fd;
+}
+#endif
+
 static const struct dma_heap_ops npu_system_heap_ops = {
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 11, 0)
+	.allocate = npu_system_heap_alloc_legacy,
+#else
 	.allocate = npu_system_heap_alloc,
+#endif
 };
 
 static int npu_system_heap_create(void)
