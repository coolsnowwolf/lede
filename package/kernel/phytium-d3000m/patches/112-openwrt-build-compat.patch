 MODULE_IMPORT_NS("DMA_BUF_HEAP");
+#endif
 MODULE_AUTHOR("Cheng Quan <chengquan@phytium.com.cn>");
 MODULE_DESCRIPTION("Phytium NPU DMA BUF heap driver");
--- a/npu_driver/include/linux/phytium_npu_compat.h
+++ b/npu_driver/include/linux/phytium_npu_compat.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef PHYTIUM_NPU_COMPAT_H
+#define PHYTIUM_NPU_COMPAT_H
+
+#include <linux/version.h>
+#include <linux/dma-buf.h>
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 11, 0)
+struct iosys_map {
+	void *vaddr;
+};
+
+static inline void iosys_map_set_vaddr(struct iosys_map *map, void *vaddr)
+{
+	map->vaddr = vaddr;
+}
+
+static inline void iosys_map_clear(struct iosys_map *map)
+{
+	map->vaddr = NULL;
+}
+
+static inline int phytium_dma_buf_vmap(struct dma_buf *buf, struct iosys_map *map)
+{
+	map->vaddr = dma_buf_vmap(buf);
+	return map->vaddr ? 0 : -ENOMEM;
+}
+
+static inline void phytium_dma_buf_vunmap(struct dma_buf *buf, struct iosys_map *map)
+{
+	dma_buf_vunmap(buf, map->vaddr);
+	iosys_map_clear(map);
+}
+#define dma_buf_vmap phytium_dma_buf_vmap
+#define dma_buf_vunmap phytium_dma_buf_vunmap
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(5, 18, 0)
+#include <linux/dma-buf-map.h>
+#define iosys_map dma_buf_map
+#define iosys_map_set_vaddr dma_buf_map_set_vaddr
+#define iosys_map_clear dma_buf_map_clear
+#else
+#include <linux/iosys-map.h>
+#endif
+
+#endif
