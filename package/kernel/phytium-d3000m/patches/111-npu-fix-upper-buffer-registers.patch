From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] phytium: npu fix upper buffer registers

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/npu_driver/phytium-npu/phytium_npu_dev.c
+++ b/npu_driver/phytium-npu/phytium_npu_dev.c
@@ -95,7 +95,7 @@
 		pr_err("Not find stream fd %d", nusstream->stream_fd);
 		return -EFAULT;
 	}
-	REGWRITE64(npudev, NPU_CH0_CMD_BASE_ADDRESS, nmmap->virt_addr);
+	REGWRITE64(npudev, NPU_CH0_CMD_BASE_ADDRESS, nmmap->virt_addr + nusstream->stream_off);
 
 	for (i = 0; i < nestream->all; i++) {
 		if (!nestream->fd[i])
@@ -107,10 +107,14 @@
 		}
 		if (nusstream->stream_fd == nestream->fd[i])
 			continue;
-		if (i < 8)
-			REGWRITE64(npudev, NPU_CH0_ADDR0 + nusstream->idx[i] * 8, nmmap->virt_addr);
+		if (nusstream->idx[i] >= NPU_MAX_DMA_ADDRS)
+			return -EINVAL;
+		if (nusstream->idx[i] < 8)
+			REGWRITE64(npudev, NPU_CH0_ADDR0 + nusstream->idx[i] * 8,
+				   nmmap->virt_addr + nusstream->bufoffsets[i]);
 		else
-			REGWRITE64(npudev, NPU_CH0_ADDR8 + nusstream->idx[i] * 8, nmmap->virt_addr);
+			REGWRITE64(npudev, NPU_CH0_ADDR8 + (nusstream->idx[i] - 8) * 8,
+				   nmmap->virt_addr + nusstream->bufoffsets[i]);
 		address_used |= 0x1 << nusstream->idx[i];
 		if (!(nmmap->map_type & NPU_MAP_TYPE_INFERENCE))
 			address_used |= 0x1 << (nusstream->idx[i] + 16);
