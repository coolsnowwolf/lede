`define GCREG_AHBVGPU_USER_CONTROL_HANG_CHECK_COUNTER_SIZE                     8

/* 0:only one vgpu reset will goes to dir , the other vgpu reset will goes to **
** dir until the previous vgpu reset dir done;   1:each vgpu reset dir        **
