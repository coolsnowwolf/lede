/* Register gcregAHBVGPUControl0 **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Clock Control Register for VGPU */

`define gcregAHBVGPUControl0RegAddrs                                    16'h0081
`define GCREG_AHBVGPU_CONTROL0_MSB                                            15
`define GCREG_AHBVGPU_CONTROL0_LSB                                             0
`define GCREG_AHBVGPU_CONTROL0_BLK                                             0
`define GCREG_AHBVGPU_CONTROL0_Count                                           1
`define GCREG_AHBVGPU_CONTROL0_FieldMask                            32'h0000FFFF
`define GCREG_AHBVGPU_CONTROL0_ReadMask                             32'h0000FFFF
`define GCREG_AHBVGPU_CONTROL0_WriteMask                            32'h0000FFFF
`define GCREG_AHBVGPU_CONTROL0_ResetValue                           32'h00000000

/* Disable 3D clock. Software core clock disable signal for 3d modules        **
** (clk_3d). When set to 1, this clock is frozen.                             */
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CLK3_D_MSB                              0
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CLK3_D_LSB                              0
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CLK3_D_SIZE                             1

/* Disable 2D clock. Software clock disable signal. Both bits CLK3D_DIS and   **
** CLK2D_DIS should be controlled by software. The AXI interface clock is the **
** only block not stalled at this point.                                      */
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CLK2_D_MSB                              1
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CLK2_D_LSB                              1
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CLK2_D_SIZE                             1

/* Core clock frequency scale value.(reset=1) */
`define GCREG_AHBVGPU_CONTROL0_FSCALE_VAL_MSB                                  8
`define GCREG_AHBVGPU_CONTROL0_FSCALE_VAL_LSB                                  2
`define GCREG_AHBVGPU_CONTROL0_FSCALE_VAL_SIZE                                 7

/* Core clock frequency scale value enable. When writing a 1 to this bit, it  **
** updates the frequency scale factor with the value FSCALE_VAL[6:0]. The bit **
** must be set back to 0 after that. If this bit is set and FSCALE_VAL=0 (an  **
** invalid combination), the HREADYOUT output signal will get stuck to 0.     */
`define GCREG_AHBVGPU_CONTROL0_FSCALE_CMD_LOAD_MSB                             9
`define GCREG_AHBVGPU_CONTROL0_FSCALE_CMD_LOAD_LSB                             9
`define GCREG_AHBVGPU_CONTROL0_FSCALE_CMD_LOAD_SIZE                            1

/* Disables clock gating for rams. */
`define GCREG_AHBVGPU_CONTROL0_DISABLE_RAM_CLOCK_GATING_MSB                   10
`define GCREG_AHBVGPU_CONTROL0_DISABLE_RAM_CLOCK_GATING_LSB                   10
`define GCREG_AHBVGPU_CONTROL0_DISABLE_RAM_CLOCK_GATING_SIZE                   1

/* Disables ram power optimization */
`define GCREG_AHBVGPU_CONTROL0_DISABLE_RAM_POWER_OPTIMIZATION_MSB             11
`define GCREG_AHBVGPU_CONTROL0_DISABLE_RAM_POWER_OPTIMIZATION_LSB             11
`define GCREG_AHBVGPU_CONTROL0_DISABLE_RAM_POWER_OPTIMIZATION_SIZE             1

/* Isolate GPU bit. Used for power on/off, isolation only for multi-core      **
** GPUs.                                                                      */
`define GCREG_AHBVGPU_CONTROL0_ISOLATE_GPU_MSB                                12
`define GCREG_AHBVGPU_CONTROL0_ISOLATE_GPU_LSB                                12
`define GCREG_AHBVGPU_CONTROL0_ISOLATE_GPU_SIZE                                1

/* Soft resets the L2. */
`define GCREG_AHBVGPU_CONTROL0_SOFT_RESET_L2_MSB                              13
`define GCREG_AHBVGPU_CONTROL0_SOFT_RESET_L2_LSB                              13
`define GCREG_AHBVGPU_CONTROL0_SOFT_RESET_L2_SIZE                              1

/* Soft reset global */
`define GCREG_AHBVGPU_CONTROL0_SOFT_RESET_GLOBAL_MSB                          14
`define GCREG_AHBVGPU_CONTROL0_SOFT_RESET_GLOBAL_LSB                          14
`define GCREG_AHBVGPU_CONTROL0_SOFT_RESET_GLOBAL_SIZE                          1

/* Disables core speed up during AHB access. */
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CORE_SPEED_UP_MSB                      15
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CORE_SPEED_UP_LSB                      15
`define GCREG_AHBVGPU_CONTROL0_DISABLE_CORE_SPEED_UP_SIZE                      1

