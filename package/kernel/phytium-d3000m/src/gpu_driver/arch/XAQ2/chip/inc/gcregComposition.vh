/* Semaphore/stall before composition. */
`define   GCREG_CE_EXECUTE_DO_SEMAPHORE_BEFORE                              2'h1
/* Semaphore/stall after composition. */
`define   GCREG_CE_EXECUTE_DO_SEMAPHORE_AFTER                               2'h2
/* Semaphore/stall before and after composition. */
`define   GCREG_CE_EXECUTE_DO_SEMAPHORE_BEFORE_AFTER                        2'h3

/* Perform a PE flush after composition is done. */
