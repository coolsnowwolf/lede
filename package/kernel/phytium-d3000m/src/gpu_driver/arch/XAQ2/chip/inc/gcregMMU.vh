`define GCREG_MMU_CONFIG_MASK_OUT_OF_BOUND_MSB                                29
`define GCREG_MMU_CONFIG_MASK_OUT_OF_BOUND_LSB                                29
`define GCREG_MMU_CONFIG_MASK_OUT_OF_BOUND_SIZE                                1
`define   GCREG_MMU_CONFIG_MASK_OUT_OF_BOUND_ENABLED                        1'h0
`define   GCREG_MMU_CONFIG_MASK_OUT_OF_BOUND_MASKED                         1'h1

/* Secure mode. */
`define GCREG_MMU_CONFIG_SECURITY_MSB                                         30
`define GCREG_MMU_CONFIG_SECURITY_LSB                                         30
`define GCREG_MMU_CONFIG_SECURITY_SIZE                                         1
`define   GCREG_MMU_CONFIG_SECURITY_NON_SECURE_MODE                         1'h0
`define   GCREG_MMU_CONFIG_SECURITY_SECURE_MODE                             1'h1

/* Mask Security field. */
`define GCREG_MMU_CONFIG_MASK_SECURITY_MSB                                    31
`define GCREG_MMU_CONFIG_MASK_SECURITY_LSB                                    31
`define GCREG_MMU_CONFIG_MASK_SECURITY_SIZE                                    1
`define   GCREG_MMU_CONFIG_MASK_SECURITY_ENABLED                            1'h0
`define   GCREG_MMU_CONFIG_MASK_SECURITY_MASKED                             1'h1

/* Register gcregMMUDcControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* DC MMU control registers  */

`define gcregMMUDcControlRegAddrs                                       16'h006C
`define GCREG_MMU_DC_CONTROL_MSB                                              15
`define GCREG_MMU_DC_CONTROL_LSB                                               0
`define GCREG_MMU_DC_CONTROL_BLK                                               0
`define GCREG_MMU_DC_CONTROL_Count                                             1
`define GCREG_MMU_DC_CONTROL_FieldMask                              32'h0000000F
`define GCREG_MMU_DC_CONTROL_ReadMask                               32'h00000003
`define GCREG_MMU_DC_CONTROL_WriteMask                              32'h0000000F
`define GCREG_MMU_DC_CONTROL_ResetValue                             32'h00000001

`define GCREG_MMU_DC_CONTROL_DC_SECURITY_MSB                                   0
`define GCREG_MMU_DC_CONTROL_DC_SECURITY_LSB                                   0
`define GCREG_MMU_DC_CONTROL_DC_SECURITY_SIZE                                  1

`define GCREG_MMU_DC_CONTROL_PANEL_SECURITY_MSB                                1
`define GCREG_MMU_DC_CONTROL_PANEL_SECURITY_LSB                                1
`define GCREG_MMU_DC_CONTROL_PANEL_SECURITY_SIZE                               1

/* StrictMode enable, for non-secure mode. */
`define GCREG_MMU_DC_CONTROL_STRICT_MODE_MSB                                   2
`define GCREG_MMU_DC_CONTROL_STRICT_MODE_LSB                                   2
`define GCREG_MMU_DC_CONTROL_STRICT_MODE_SIZE                                  1
`define   GCREG_MMU_DC_CONTROL_STRICT_MODE_DISABLE                          1'h0
`define   GCREG_MMU_DC_CONTROL_STRICT_MODE_ENABLE                           1'h1

/* SecurityViolationException enable. */
`define GCREG_MMU_DC_CONTROL_SECURITY_VIOL_EXCEPTION_MSB                       3
`define GCREG_MMU_DC_CONTROL_SECURITY_VIOL_EXCEPTION_LSB                       3
`define GCREG_MMU_DC_CONTROL_SECURITY_VIOL_EXCEPTION_SIZE                      1
`define   GCREG_MMU_DC_CONTROL_SECURITY_VIOL_EXCEPTION_DISABLE              1'h0
`define   GCREG_MMU_DC_CONTROL_SECURITY_VIOL_EXCEPTION_ENABLE               1'h1

/* Register gcregMMUPTFlush **
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* flush cache line with specified VMID.  */

`define gcregMMUPTFlushRegAddrs                                         16'h006D
`define GCREG_MMUPT_FLUSH_MSB                                                 15
`define GCREG_MMUPT_FLUSH_LSB                                                  0
`define GCREG_MMUPT_FLUSH_BLK                                                  0
`define GCREG_MMUPT_FLUSH_Count                                                1
`define GCREG_MMUPT_FLUSH_FieldMask                                 32'h8000000F
`define GCREG_MMUPT_FLUSH_ReadMask                                  32'h8000000F
`define GCREG_MMUPT_FLUSH_WriteMask                                 32'h8000000F
`define GCREG_MMUPT_FLUSH_ResetValue                                32'h00000000

/* flush line which has this VMID */
`define GCREG_MMUPT_FLUSH_FLUSH_VMID_MSB                                       3
`define GCREG_MMUPT_FLUSH_FLUSH_VMID_LSB                                       0
`define GCREG_MMUPT_FLUSH_FLUSH_VMID_SIZE                                      4

/* 0:only flush line with specified VMID, 1:flush all. */
`define GCREG_MMUPT_FLUSH_FLUSH_CMD_MSB                                       31
`define GCREG_MMUPT_FLUSH_FLUSH_CMD_LSB                                       31
`define GCREG_MMUPT_FLUSH_FLUSH_CMD_SIZE                                       1

/*******************************************************************************
**                       ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~                      **
**                       Command gcregMMUTableArrayEntry                      **
**                       ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~                      **
*******************************************************************************/

/* Offset gcregMMUTableArrayEntryLow
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Set the mode for the Master TLB. */
`define GCREG_MMU_TABLE_ARRAY_ENTRY_LOW_MODE_MSB                               0
`define GCREG_MMU_TABLE_ARRAY_ENTRY_LOW_MODE_LSB                               0
`define GCREG_MMU_TABLE_ARRAY_ENTRY_LOW_MODE_SIZE                              1
/* The Master TLB is 4kB in size and contains 1024 entries. Each page can be  **
** 4kB or 64kB in size.                                                       */
`define   GCREG_MMU_TABLE_ARRAY_ENTRY_LOW_MODE_MODE4_K                      1'h0
/* The Master TLB is 1kB in size and contains 256 entries. Each page can be   **
** 4kB, 64kB, 1MB or 16MB in size.                                            */
`define   GCREG_MMU_TABLE_ARRAY_ENTRY_LOW_MODE_MODE1_K                      1'h1

/* Upper bits of the page aligned (depending on the mode) master TLB. */
`define GCREG_MMU_TABLE_ARRAY_ENTRY_LOW_ADDRESS_MSB                           31
`define GCREG_MMU_TABLE_ARRAY_ENTRY_LOW_ADDRESS_LSB                           10
`define GCREG_MMU_TABLE_ARRAY_ENTRY_LOW_ADDRESS_SIZE                          22

/* Offset gcregMMUTableArrayEntryHigh
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Upper 8-bits of the master TLB address to form a true 40-bit address. */
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_MSB                        7
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_LSB                        0
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_SIZE                       8

/* Bit that defines whether the master TLB address is secure or not. */
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_SECURE_MSB                 8
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_SECURE_LSB                 8
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_SECURE_SIZE                1

/* Bit that defines whether the master TLB address is shareable or not. */
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_SHAREABLE_MSB              9
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_SHAREABLE_LSB              9
`define GCREG_MMU_TABLE_ARRAY_ENTRY_HIGH_MASTER_TLB_SHAREABLE_SIZE             1

