** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Up to 4 registers that will hold the original address that generated an    **
** exception. This register is obsolete.                                      */

`define gcregMMUExceptionRegAddrs                                       14'h0019
`define GCREG_MMU_EXCEPTION_MSB                                               15
`define GCREG_MMU_EXCEPTION_LSB                                                2
`define GCREG_MMU_EXCEPTION_BLK                                                2
`define GCREG_MMU_EXCEPTION_Count                                              4
`define GCREG_MMU_EXCEPTION_FieldMask                               32'hFFFFFFFF
`define GCREG_MMU_EXCEPTION_ReadMask                                32'hFFFFFFFF
`define GCREG_MMU_EXCEPTION_WriteMask                               32'hFFFFFFFF
`define GCREG_MMU_EXCEPTION_ResetValue                              32'h00000000

/* Address that generated an exception. */
`define GCREG_MMU_EXCEPTION_ADDRESS_MSB                                       31
`define GCREG_MMU_EXCEPTION_ADDRESS_LSB                                        0
`define GCREG_MMU_EXCEPTION_ADDRESS_SIZE                                      32

/* Register gcregMMUConfiguration **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* MMU Configuration Register.  Memory Management Unit configuration.  For    **
** cores prior to v620 this register controls the master TLB of the MMU.  For **
** cores from v620, most fields are obsolete and replaced by fields in        **
** gcregAHBMMU* registers. For cores from v620, only bits 4 and 7 are         **
** available.                                                                 */

`define gcregMMUConfigurationRegAddrs                                   16'h0061
`define GCREG_MMU_CONFIGURATION_MSB                                           15
`define GCREG_MMU_CONFIGURATION_LSB                                            0
`define GCREG_MMU_CONFIGURATION_BLK                                            0
`define GCREG_MMU_CONFIGURATION_Count                                          1
`define GCREG_MMU_CONFIGURATION_FieldMask                           32'hFFFFFD99
`define GCREG_MMU_CONFIGURATION_ReadMask                            32'hFFFFFD99
`define GCREG_MMU_CONFIGURATION_WriteMask                           32'hFFFFFD99
`define GCREG_MMU_CONFIGURATION_ResetValue                          32'h00000000

/* Set the mode for the Master TLB. This field is obsolete. */
`define GCREG_MMU_CONFIGURATION_MODE_MSB                                       0
`define GCREG_MMU_CONFIGURATION_MODE_LSB                                       0
`define GCREG_MMU_CONFIGURATION_MODE_SIZE                                      1
/* The Master TLB is 4kB in size and contains 1024 entries.  Each page can be **
** 4kB or 64kB in size.                                                       */
`define   GCREG_MMU_CONFIGURATION_MODE_MODE4_K                              1'h0
/* The Master TLB is 1kB in size and contains 256 entries.  Each page can be  **
** 4kB, 64kB, 1MB or 16MB in size.                                            */
`define   GCREG_MMU_CONFIGURATION_MODE_MODE1_K                              1'h1

/* Mask Mode field. This field is obsolete.  */
`define GCREG_MMU_CONFIGURATION_MASK_MODE_MSB                                  3
`define GCREG_MMU_CONFIGURATION_MASK_MODE_LSB                                  3
`define GCREG_MMU_CONFIGURATION_MASK_MODE_SIZE                                 1
`define   GCREG_MMU_CONFIGURATION_MASK_MODE_ENABLED                         1'h0
`define   GCREG_MMU_CONFIGURATION_MASK_MODE_MASKED                          1'h1

/* Flush the MMU caches.  */
`define GCREG_MMU_CONFIGURATION_FLUSH_MSB                                      4
`define GCREG_MMU_CONFIGURATION_FLUSH_LSB                                      4
`define GCREG_MMU_CONFIGURATION_FLUSH_SIZE                                     1
`define   GCREG_MMU_CONFIGURATION_FLUSH_FLUSH                               1'h1

/* Mask Flush field. */
`define GCREG_MMU_CONFIGURATION_MASK_FLUSH_MSB                                 7
`define GCREG_MMU_CONFIGURATION_MASK_FLUSH_LSB                                 7
`define GCREG_MMU_CONFIGURATION_MASK_FLUSH_SIZE                                1
`define   GCREG_MMU_CONFIGURATION_MASK_FLUSH_ENABLED                        1'h0
`define   GCREG_MMU_CONFIGURATION_MASK_FLUSH_MASKED                         1'h1

/* Mask for Address field.  This field is obsolete.  */
`define GCREG_MMU_CONFIGURATION_MASK_ADDRESS_MSB                               8
`define GCREG_MMU_CONFIGURATION_MASK_ADDRESS_LSB                               8
`define GCREG_MMU_CONFIGURATION_MASK_ADDRESS_SIZE                              1
`define   GCREG_MMU_CONFIGURATION_MASK_ADDRESS_ENABLED                      1'h0
`define   GCREG_MMU_CONFIGURATION_MASK_ADDRESS_MASKED                       1'h1

/* Upper bits of the page aligned (depending on the mode)  master TLB.  This  **
** field is obsolete.                                                         */
`define GCREG_MMU_CONFIGURATION_ADDRESS_MSB                                   31
`define GCREG_MMU_CONFIGURATION_ADDRESS_LSB                                   10
`define GCREG_MMU_CONFIGURATION_ADDRESS_SIZE                                  22

