/* Register gcPulseEater **
** ~~~~~~~~~~~~~~~~~~~~~ */

/* Pulse Eater Parameter Register.  Auto pulse eater parameters. */

`define gcPulseEaterRegAddrs                                            16'h0043
`define GC_PULSE_EATER_MSB                                                    15
`define GC_PULSE_EATER_LSB                                                     0
`define GC_PULSE_EATER_BLK                                                     0
`define GC_PULSE_EATER_Count                                                   1
`define GC_PULSE_EATER_FieldMask                                    32'hFFFFFFFF
`define GC_PULSE_EATER_ReadMask                                     32'hFFFFFFFF
`define GC_PULSE_EATER_WriteMask                                    32'hFFFFFFFF
`define GC_PULSE_EATER_ResetValue                                   32'h015B0880

/* Fscale_cmd_load for shader.  */
`define GC_PULSE_EATER_FSCALE_CMD_LOAD_SH_MSB                                  0
`define GC_PULSE_EATER_FSCALE_CMD_LOAD_SH_LSB                                  0
`define GC_PULSE_EATER_FSCALE_CMD_LOAD_SH_SIZE                                 1

/* Fscale value for shader. This can be used to change the upper boundary     **
** for the SH clock from its reset value. For example, you can set the shader **
**  clock upper bound to 32 (half of the shader input clock default value of  **
** 64)  by setting the value of this FSCALE_VAL_SH field to 32 (0x20).  The   **
** state of the auto pulse-eater is not changed.                              */
`define GC_PULSE_EATER_FSCALE_VAL_SH_MSB                                       7
`define GC_PULSE_EATER_FSCALE_VAL_SH_LSB                                       1
`define GC_PULSE_EATER_FSCALE_VAL_SH_SIZE                                      7

/* Period is calculated by shifting 0x40 (64) left with this value. */
`define GC_PULSE_EATER_PERIOD_MSB                                             15
`define GC_PULSE_EATER_PERIOD_LSB                                              8
`define GC_PULSE_EATER_PERIOD_SIZE                                             8

/* Enable auto pulse eater for SH. If 0, SH will be pulse eaten same as the   **
** core.                                                                      */
`define GC_PULSE_EATER_ENABLE_AUTO_PULSE_SH_MSB                               16
`define GC_PULSE_EATER_ENABLE_AUTO_PULSE_SH_LSB                               16
`define GC_PULSE_EATER_ENABLE_AUTO_PULSE_SH_SIZE                               1

/* Disable the auto pulse eater for the core. */
`define GC_PULSE_EATER_DISABLE_AUTO_PULSE_MSB                                 17
`define GC_PULSE_EATER_DISABLE_AUTO_PULSE_LSB                                 17
`define GC_PULSE_EATER_DISABLE_AUTO_PULSE_SIZE                                 1

/* When this is set, the logic will find the pulse skip values but will not   **
** set them to the pulse eater. This is to make it possible for external DVFS **
** methods to work.                                                           */
`define GC_PULSE_EATER_EXTERNAL_CONTROL_MSB                                   18
`define GC_PULSE_EATER_EXTERNAL_CONTROL_LSB                                   18
`define GC_PULSE_EATER_EXTERNAL_CONTROL_SIZE                                   1

/* Don't slow down if pe is stalling. Only look at idle. */
`define GC_PULSE_EATER_MASK_PE_STALL_MSB                                      19
`define GC_PULSE_EATER_MASK_PE_STALL_LSB                                      19
`define GC_PULSE_EATER_MASK_PE_STALL_SIZE                                      1

/* Use pulse count register value as max value. */
`define GC_PULSE_EATER_UPPER_BOUND_ENABLE_MSB                                 20
`define GC_PULSE_EATER_UPPER_BOUND_ENABLE_LSB                                 20
`define GC_PULSE_EATER_UPPER_BOUND_ENABLE_SIZE                                 1

/* Add the minPulseCount as offset. */
`define GC_PULSE_EATER_ADD_OFFSET_MSB                                         21
`define GC_PULSE_EATER_ADD_OFFSET_LSB                                         21
`define GC_PULSE_EATER_ADD_OFFSET_SIZE                                         1

/* Disable pulse eater when it is non idle for 64 cycles. */
`define GC_PULSE_EATER_ENABLE_FAST_START_MSB                                  22
`define GC_PULSE_EATER_ENABLE_FAST_START_LSB                                  22
`define GC_PULSE_EATER_ENABLE_FAST_START_SIZE                                  1

/* Use only the idle signal. */
`define GC_PULSE_EATER_ONLY_IDLE_MSB                                          23
`define GC_PULSE_EATER_ONLY_IDLE_LSB                                          23
`define GC_PULSE_EATER_ONLY_IDLE_SIZE                                          1

/* Don't make the pulse count less than this value. */
`define GC_PULSE_EATER_MIN_PULSE_COUNT_MSB                                    30
`define GC_PULSE_EATER_MIN_PULSE_COUNT_LSB                                    24
`define GC_PULSE_EATER_MIN_PULSE_COUNT_SIZE                                    7

/* This is new logic. If there is something wrong with the mc_idle signal, we **
** can discard it.                                                            */
`define GC_PULSE_EATER_MASK_MC_IDLE_MSB                                       31
`define GC_PULSE_EATER_MASK_MC_IDLE_LSB                                       31
`define GC_PULSE_EATER_MASK_MC_IDLE_SIZE                                       1

