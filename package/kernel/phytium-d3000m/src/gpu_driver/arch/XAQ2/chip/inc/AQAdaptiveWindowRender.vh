`define GCREG_BIN_PER_DRAW_STATES_ADDR_Count                                   1
`define GCREG_BIN_PER_DRAW_STATES_ADDR_FieldMask                    32'hFFFFFFFF
`define GCREG_BIN_PER_DRAW_STATES_ADDR_ReadMask                     32'hFFFFFFFF
`define GCREG_BIN_PER_DRAW_STATES_ADDR_WriteMask                    32'hFFFFFFFF
`define GCREG_BIN_PER_DRAW_STATES_ADDR_ResetValue                   32'h00000000

/* Set this register to indicate a draw state and draw data pair. Any         **
** redundant or insufficient programming to this register will cause the GPU  **
** internal states messed up and cause fail/hang on the AWR mode.             */
`define GCREG_BIN_PER_DRAW_STATES_ADDR_ADDRESS_MSB                            31
`define GCREG_BIN_PER_DRAW_STATES_ADDR_ADDRESS_LSB                             0
`define GCREG_BIN_PER_DRAW_STATES_ADDR_ADDRESS_SIZE                           32

