`define GCREG_BIN_STATE_DIFF_PER_FLUSH_BIN_ADDR_WriteMask           32'hFFFFFFFF
`define GCREG_BIN_STATE_DIFF_PER_FLUSH_BIN_ADDR_ResetValue          32'h00000000

/* This register sets StateDiffs between two flush-bins. */
`define GCREG_BIN_STATE_DIFF_PER_FLUSH_BIN_ADDR_ADDRESS_MSB                   31
