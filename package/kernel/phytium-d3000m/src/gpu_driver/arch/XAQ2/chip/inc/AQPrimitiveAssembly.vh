/* Register gcregPALineAdjustSub **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Value to add to move a vertex to the negative side of a line (towards 0). */

`define gcregPALineAdjustSubRegAddrs                                    16'h028E
`define GCREG_PA_LINE_ADJUST_SUB_MSB                                          15
`define GCREG_PA_LINE_ADJUST_SUB_LSB                                           0
`define GCREG_PA_LINE_ADJUST_SUB_BLK                                           0
`define GCREG_PA_LINE_ADJUST_SUB_Count                                         1
`define GCREG_PA_LINE_ADJUST_SUB_FieldMask                          32'hFFFFFFFF
`define GCREG_PA_LINE_ADJUST_SUB_ReadMask                           32'hFFFFFFFF
`define GCREG_PA_LINE_ADJUST_SUB_WriteMask                          32'hFFFFFFFF
`define GCREG_PA_LINE_ADJUST_SUB_ResetValue                         32'h00000000

`define GCREG_PA_LINE_ADJUST_SUB_FL32_VALUE_MSB                               31
`define GCREG_PA_LINE_ADJUST_SUB_FL32_VALUE_LSB                                0
`define GCREG_PA_LINE_ADJUST_SUB_FL32_VALUE_SIZE                              32

/* Register gcregPALineAdjustAdd **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Value to add to move a vertex to the positive side of a line (towards      **
** infinity).                                                                 */

`define gcregPALineAdjustAddRegAddrs                                    16'h028F
`define GCREG_PA_LINE_ADJUST_ADD_MSB                                          15
`define GCREG_PA_LINE_ADJUST_ADD_LSB                                           0
`define GCREG_PA_LINE_ADJUST_ADD_BLK                                           0
`define GCREG_PA_LINE_ADJUST_ADD_Count                                         1
`define GCREG_PA_LINE_ADJUST_ADD_FieldMask                          32'hFFFFFFFF
`define GCREG_PA_LINE_ADJUST_ADD_ReadMask                           32'hFFFFFFFF
`define GCREG_PA_LINE_ADJUST_ADD_WriteMask                          32'hFFFFFFFF
`define GCREG_PA_LINE_ADJUST_ADD_ResetValue                         32'h00000000

`define GCREG_PA_LINE_ADJUST_ADD_FL32_VALUE_MSB                               31
`define GCREG_PA_LINE_ADJUST_ADD_FL32_VALUE_LSB                                0
`define GCREG_PA_LINE_ADJUST_ADD_FL32_VALUE_SIZE                              32

/* Register gcregPAClipW **
** ~~~~~~~~~~~~~~~~~~~~~ */

/* Value to use for W clipping. */

`define gcregPAClipWRegAddrs                                            16'h02A0
`define GCREG_PA_CLIP_W_MSB                                                   15
`define GCREG_PA_CLIP_W_LSB                                                    0
`define GCREG_PA_CLIP_W_BLK                                                    0
`define GCREG_PA_CLIP_W_Count                                                  1
`define GCREG_PA_CLIP_W_FieldMask                                   32'hFFFFFFFF
`define GCREG_PA_CLIP_W_ReadMask                                    32'hFFFFFFFF
`define GCREG_PA_CLIP_W_WriteMask                                   32'hFFFFFFFF
`define GCREG_PA_CLIP_W_ResetValue                                  32'h00000000

/* The value here is used to compute the minimum W value against which a      **
** vertex is going to be clipped to guarantee it will not overflow the world  **
** coordinate system. Program this value as max(ViewportWidth / 2,            **
** ViewportHeight / 2) / (8388607 - gcregPAMaxPointSize / 2). This equals to  **
** max(ViewportWidth, ViewportHeight) / (16777214 - gcregPAMaxPointSize). For **
** example, for a 640x480 viewport and a 8192 maximum point size, this value  **
** would be programmed as 640 / (16777214 - 8192). NOTE: Make sure you don't  **
** program the line width registers more than the gcregPAMaxPointSize,        **
** otherwise lines could overflow.                                            */
`define GCREG_PA_CLIP_W_FL32_MSB                                              31
`define GCREG_PA_CLIP_W_FL32_LSB                                               0
`define GCREG_PA_CLIP_W_FL32_SIZE                                             32

/* Register gcregPAMaxPointSize **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Maximum size for points in order not to overflow. */

`define gcregPAMaxPointSizeRegAddrs                                     16'h02A1
`define GCREG_PA_MAX_POINT_SIZE_MSB                                           15
`define GCREG_PA_MAX_POINT_SIZE_LSB                                            0
`define GCREG_PA_MAX_POINT_SIZE_BLK                                            0
`define GCREG_PA_MAX_POINT_SIZE_Count                                          1
`define GCREG_PA_MAX_POINT_SIZE_FieldMask                           32'hFFFFFFFF
`define GCREG_PA_MAX_POINT_SIZE_ReadMask                            32'hFFFFFFFF
`define GCREG_PA_MAX_POINT_SIZE_WriteMask                           32'hFFFFFFFF
`define GCREG_PA_MAX_POINT_SIZE_ResetValue                          32'h00000000

/* Any incoming point size is clamped to this value. Together with            **
** gcregPAClipW this will guarntee points won't overflow after they are       **
** converted to triangles.                                                    */
`define GCREG_PA_MAX_POINT_SIZE_FL32_MSB                                      31
`define GCREG_PA_MAX_POINT_SIZE_FL32_LSB                                       0
`define GCREG_PA_MAX_POINT_SIZE_FL32_SIZE                                     32

/* Register gcregPAClipControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Control the clipping. */

`define gcregPAClipControlRegAddrs                                      16'h02A2
`define GCREG_PA_CLIP_CONTROL_MSB                                             15
`define GCREG_PA_CLIP_CONTROL_LSB                                              0
`define GCREG_PA_CLIP_CONTROL_BLK                                              0
`define GCREG_PA_CLIP_CONTROL_Count                                            1
`define GCREG_PA_CLIP_CONTROL_FieldMask                             32'h77111111
`define GCREG_PA_CLIP_CONTROL_ReadMask                              32'h77111111
`define GCREG_PA_CLIP_CONTROL_WriteMask                             32'h77111111
`define GCREG_PA_CLIP_CONTROL_ResetValue                            32'h00000000

/* Control clipping. If enabled, each primitive is guaranteed to be clipped   **
** with the front frustum. If disabled, each primitive is still trivial       **
** rejected, but no clipping is performed.                                    */
`define GCREG_PA_CLIP_CONTROL_CLIP_DISABLE_MSB                                 0
`define GCREG_PA_CLIP_CONTROL_CLIP_DISABLE_LSB                                 0
`define GCREG_PA_CLIP_CONTROL_CLIP_DISABLE_SIZE                                1
`define   GCREG_PA_CLIP_CONTROL_CLIP_DISABLE_ENABLED                        1'h0
`define   GCREG_PA_CLIP_CONTROL_CLIP_DISABLE_DISABLED                       1'h1

/* Control W-plane clipping. If enabled, when clipping against the front      **
** frustum, two t values get computed, one for the intersection with the Z=0  **
** plane and one for the intersection with the W=Wmin plane.                  */
`define GCREG_PA_CLIP_CONTROL_CLIP_WPLANE_DISABLE_MSB                          4
`define GCREG_PA_CLIP_CONTROL_CLIP_WPLANE_DISABLE_LSB                          4
`define GCREG_PA_CLIP_CONTROL_CLIP_WPLANE_DISABLE_SIZE                         1
`define   GCREG_PA_CLIP_CONTROL_CLIP_WPLANE_DISABLE_ENABLED                 1'h0
`define   GCREG_PA_CLIP_CONTROL_CLIP_WPLANE_DISABLE_DISABLED                1'h1

/* Control frutsum clipping of lines. If enabled, an overflowing line         **
** primitive will be clipped against the entire frustum. If disabled, lines   **
** are only clipped against the front frustum.                                */
`define GCREG_PA_CLIP_CONTROL_CLIP_LINE_DISABLE_MSB                            8
`define GCREG_PA_CLIP_CONTROL_CLIP_LINE_DISABLE_LSB                            8
`define GCREG_PA_CLIP_CONTROL_CLIP_LINE_DISABLE_SIZE                           1
`define   GCREG_PA_CLIP_CONTROL_CLIP_LINE_DISABLE_ENABLED                   1'h0
`define   GCREG_PA_CLIP_CONTROL_CLIP_LINE_DISABLE_DISABLED                  1'h1

/* Control frutsum clipping of triangles. If enabled, an overflowing triangle **
** primitive will be clipped against the entire frustum. If disabled,         **
** triangles are only clipped against the front frustum.                      */
`define GCREG_PA_CLIP_CONTROL_CLIP_TRIANGLE_DISABLE_MSB                       12
`define GCREG_PA_CLIP_CONTROL_CLIP_TRIANGLE_DISABLE_LSB                       12
`define GCREG_PA_CLIP_CONTROL_CLIP_TRIANGLE_DISABLE_SIZE                       1
`define   GCREG_PA_CLIP_CONTROL_CLIP_TRIANGLE_DISABLE_ENABLED               1'h0
`define   GCREG_PA_CLIP_CONTROL_CLIP_TRIANGLE_DISABLE_DISABLED              1'h1

/* Control clamping of coordinates. If enabled, any vertex x/y coordinates    **
** are clamped to a range from -8388607 to 8388607.                           */
`define GCREG_PA_CLIP_CONTROL_CLAMP_COORDINATES_DISABLE_MSB                   16
`define GCREG_PA_CLIP_CONTROL_CLAMP_COORDINATES_DISABLE_LSB                   16
`define GCREG_PA_CLIP_CONTROL_CLAMP_COORDINATES_DISABLE_SIZE                   1
`define   GCREG_PA_CLIP_CONTROL_CLAMP_COORDINATES_DISABLE_ENABLED           1'h0
`define   GCREG_PA_CLIP_CONTROL_CLAMP_COORDINATES_DISABLE_DISABLED          1'h1

/* Control clipped vertices with w<=0 are handled. */
`define GCREG_PA_CLIP_CONTROL_CLIP_NEGATIVE_W_MSB                             20
`define GCREG_PA_CLIP_CONTROL_CLIP_NEGATIVE_W_LSB                             20
`define GCREG_PA_CLIP_CONTROL_CLIP_NEGATIVE_W_SIZE                             1
/* Clamp the W to smallW value. */
`define   GCREG_PA_CLIP_CONTROL_CLIP_NEGATIVE_W_CLAMP                       1'h0
/* Drop the primitive. */
`define   GCREG_PA_CLIP_CONTROL_CLIP_NEGATIVE_W_DROP                        1'h1

/* Control far-Z clipping. */
`define GCREG_PA_CLIP_CONTROL_CLIP_FAR_Z_MSB                                  24
`define GCREG_PA_CLIP_CONTROL_CLIP_FAR_Z_LSB                                  24
`define GCREG_PA_CLIP_CONTROL_CLIP_FAR_Z_SIZE                                  1
/* Far-Z clipping is enabled. */
`define   GCREG_PA_CLIP_CONTROL_CLIP_FAR_Z_ENABLED                          1'h0
/* Far-Z clipping is disabled. */
`define   GCREG_PA_CLIP_CONTROL_CLIP_FAR_Z_DISABLED                         1'h1

/* Adjust far-Z clipping. */
`define GCREG_PA_CLIP_CONTROL_ADJUST_FAR_Z_MSB                                25
`define GCREG_PA_CLIP_CONTROL_ADJUST_FAR_Z_LSB                                25
`define GCREG_PA_CLIP_CONTROL_ADJUST_FAR_Z_SIZE                                1
/* Enable Far-Z adjustment control. */
`define   GCREG_PA_CLIP_CONTROL_ADJUST_FAR_Z_ENABLED                        1'h0
/* Disable Far-Z adjustment control. */
`define   GCREG_PA_CLIP_CONTROL_ADJUST_FAR_Z_DISABLED                       1'h1

/* Control near&far Z clipping. */
`define GCREG_PA_CLIP_CONTROL_CLIP_Z_MSB                                      26
`define GCREG_PA_CLIP_CONTROL_CLIP_Z_LSB                                      26
`define GCREG_PA_CLIP_CONTROL_CLIP_Z_SIZE                                      1
/* Z clipping is enabled. */
`define   GCREG_PA_CLIP_CONTROL_CLIP_Z_ENABLED                              1'h0
/* Z clipping is disabled. */
`define   GCREG_PA_CLIP_CONTROL_CLIP_Z_DISABLED                             1'h1

/* Control denorms. */
`define GCREG_PA_CLIP_CONTROL_DENORM_MSB                                      28
`define GCREG_PA_CLIP_CONTROL_DENORM_LSB                                      28
`define GCREG_PA_CLIP_CONTROL_DENORM_SIZE                                      1
/* Any incoming denorm will be flushed to 0. */
`define   GCREG_PA_CLIP_CONTROL_DENORM_CLAMP_TO_ZERO                        1'h0
/* Any incoming denorm will be passed through. */
`define   GCREG_PA_CLIP_CONTROL_DENORM_PASS_THROUGH                         1'h1

/* Control Z range in clip space. */
`define GCREG_PA_CLIP_CONTROL_ZRANGE_MSB                                      29
`define GCREG_PA_CLIP_CONTROL_ZRANGE_LSB                                      29
`define GCREG_PA_CLIP_CONTROL_ZRANGE_SIZE                                      1
/* 0 < Z < W. */
