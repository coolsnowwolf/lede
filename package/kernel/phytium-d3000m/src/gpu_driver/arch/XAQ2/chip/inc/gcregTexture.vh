`define   GCREG_TX_CONTROL_YUV_EX_INTERLACED_PROGRESSIVE                    1'h0
/* When the YUV data is interlaced, the vertical tile size is divided by two. */
`define   GCREG_TX_CONTROL_YUV_EX_INTERLACED_INTERLACED                     1'h1

