`define   GCREG_TEXTURE_STATE_TEXTURE_REQUEST_SIZE_BYTES64                  2'h0
/* Force HW request 128 Bytes, for ompressionDEC or tileStatus enabled. */
`define   GCREG_TEXTURE_STATE_TEXTURE_REQUEST_SIZE_BYTES128                 2'h1
/* Force HW request 160 Bytes, for tiled D32FS8 texture. */
`define   GCREG_TEXTURE_STATE_TEXTURE_REQUEST_SIZE_BYTES160                 2'h2
/* Force HW request 256 Bytes, for tileStatus enabled. */
`define   GCREG_TEXTURE_STATE_TEXTURE_REQUEST_SIZE_BYTES256                 2'h3

/* Offset gcregTextureState
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Texture height of baseLevel. */
`define GCREG_TEXTURE_STATE_TEXTURE_HEIGHT_MSB                                15
`define GCREG_TEXTURE_STATE_TEXTURE_HEIGHT_LSB                                 0
`define GCREG_TEXTURE_STATE_TEXTURE_HEIGHT_SIZE                               16

/* Texture depth of baseLevel. */
