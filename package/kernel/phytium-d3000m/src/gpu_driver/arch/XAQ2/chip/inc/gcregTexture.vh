/* Offset gcregTextureStateYuv
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Horizontal sampling of the UV. */
`define GCREG_TEXTURE_STATE_YUV_FORMAT_X_MSB                                   1
`define GCREG_TEXTURE_STATE_YUV_FORMAT_X_LSB                                   0
`define GCREG_TEXTURE_STATE_YUV_FORMAT_X_SIZE                                  2
/* No UV are present. */
`define   GCREG_TEXTURE_STATE_YUV_FORMAT_X_NONE                             2'h0
/* One Y per UV. */
`define   GCREG_TEXTURE_STATE_YUV_FORMAT_X_ONE                              2'h1
/* Two Y's per UV. */
`define   GCREG_TEXTURE_STATE_YUV_FORMAT_X_TWO                              2'h2
/* Four Y's per UV. */
`define   GCREG_TEXTURE_STATE_YUV_FORMAT_X_FOUR                             2'h3

/* Veritcal smapling of the UV. */
`define GCREG_TEXTURE_STATE_YUV_FORMAT_Y_MSB                                   5
`define GCREG_TEXTURE_STATE_YUV_FORMAT_Y_LSB                                   4
`define GCREG_TEXTURE_STATE_YUV_FORMAT_Y_SIZE                                  2
/* No UV are present. */
`define   GCREG_TEXTURE_STATE_YUV_FORMAT_Y_NONE                             2'h0
/* One Y per UV. */
`define   GCREG_TEXTURE_STATE_YUV_FORMAT_Y_ONE                              2'h1
/* Two Y's per UV. */
`define   GCREG_TEXTURE_STATE_YUV_FORMAT_Y_TWO                              2'h2
/* Four Y's per UV. */
`define   GCREG_TEXTURE_STATE_YUV_FORMAT_Y_FOUR                             2'h3

/* The bits of each vaild channel. */
`define GCREG_TEXTURE_STATE_YUV_CHANNEL_BITS_MSB                               6
`define GCREG_TEXTURE_STATE_YUV_CHANNEL_BITS_LSB                               6
`define GCREG_TEXTURE_STATE_YUV_CHANNEL_BITS_SIZE                              1
/* Every channel is 8 bits. */
`define   GCREG_TEXTURE_STATE_YUV_CHANNEL_BITS_BITS8                        1'h0
/* Every channel is 10 bits. */
`define   GCREG_TEXTURE_STATE_YUV_CHANNEL_BITS_BITS10                       1'h1

/* Number of components between Y's. */
`define GCREG_TEXTURE_STATE_YUV_YOFFSET_MSB                                   10
`define GCREG_TEXTURE_STATE_YUV_YOFFSET_LSB                                    8
`define GCREG_TEXTURE_STATE_YUV_YOFFSET_SIZE                                   3

/* The externed tile modes for all Y/U/V planes. */
`define GCREG_TEXTURE_STATE_YUV_TILE_EX_MSB                                   11
`define GCREG_TEXTURE_STATE_YUV_TILE_EX_LSB                                   11
`define GCREG_TEXTURE_STATE_YUV_TILE_EX_SIZE                                   1
/* This field is invalid. */
`define   GCREG_TEXTURE_STATE_YUV_TILE_EX_NO_EXTERNED                       1'h0
/* ST defined tile mode. */
`define   GCREG_TEXTURE_STATE_YUV_TILE_EX_CUSTOMER0                         1'h1

/* Number of components between U's. */
`define GCREG_TEXTURE_STATE_YUV_UOFFSET_MSB                                   14
`define GCREG_TEXTURE_STATE_YUV_UOFFSET_LSB                                   12
`define GCREG_TEXTURE_STATE_YUV_UOFFSET_SIZE                                   3

/* Number of components between V's. */
`define GCREG_TEXTURE_STATE_YUV_VOFFSET_MSB                                   18
`define GCREG_TEXTURE_STATE_YUV_VOFFSET_LSB                                   16
`define GCREG_TEXTURE_STATE_YUV_VOFFSET_SIZE                                   3

/* YUV P010 format family. */
`define GCREG_TEXTURE_STATE_YUV_IS_P010_MSB                                   19
`define GCREG_TEXTURE_STATE_YUV_IS_P010_LSB                                   19
`define GCREG_TEXTURE_STATE_YUV_IS_P010_SIZE                                   1

/* Enable interleaving (everything in one plane). When enabled, the swizzle   **
** fields will determine the ordering within the packed pixel. For hardware,  **
** the Y plane determines the starting point of the pixel. The swizzle fields **
** will determine the final YUV layout of each pixel. So, when interleaving   **
** is turned on, you actually only need to program the Y plane, since that is **
** the only thing hardware will look at.                                      */
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVED_MSB                               20
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVED_LSB                               20
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVED_SIZE                               1
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVED_PLANAR                        1'h0
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVED_INTERLEAVED                   1'h1

/* YUV interlacing. */
`define GCREG_TEXTURE_STATE_YUV_INTERLACED_MSB                                21
`define GCREG_TEXTURE_STATE_YUV_INTERLACED_LSB                                21
`define GCREG_TEXTURE_STATE_YUV_INTERLACED_SIZE                                1
`define   GCREG_TEXTURE_STATE_YUV_INTERLACED_PROGRESSIVE                    1'h0
/* When the YUV data is interlaced, the vertical tile size is divided by two. */
`define   GCREG_TEXTURE_STATE_YUV_INTERLACED_INTERLACED                     1'h1

/* Select plane for Y in interleaving. */
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_Y_MSB                      23
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_Y_LSB                      22
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_Y_SIZE                      2
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_Y_PLANE_Y              2'h0
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_Y_PLANE_U              2'h1
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_Y_PLANE_V              2'h2

/* Select plane for U in interleaving. */
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_U_MSB                      25
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_U_LSB                      24
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_U_SIZE                      2
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_U_PLANE_Y              2'h0
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_U_PLANE_U              2'h1
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_U_PLANE_V              2'h2

/* Select plane for V in interleaving. */
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_V_MSB                      27
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_V_LSB                      26
`define GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_V_SIZE                      2
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_V_PLANE_Y              2'h0
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_V_PLANE_U              2'h1
`define   GCREG_TEXTURE_STATE_YUV_INTERLEAVE_SWIZZLE_V_PLANE_V              2'h2

/* Select Y tiling. */
`define GCREG_TEXTURE_STATE_YUV_TILE_Y_MSB                                    29
`define GCREG_TEXTURE_STATE_YUV_TILE_Y_LSB                                    28
`define GCREG_TEXTURE_STATE_YUV_TILE_Y_SIZE                                    2
