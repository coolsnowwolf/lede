`define   GCREG_TX_CONTROL_YUV_EX_INTERLEAVE_SWIZZLE_Y_PLANE_V              2'h2

/* Select plane for U in interleaving. */
`define GCREG_TX_CONTROL_YUV_EX_INTERLEAVE_SWIZZLE_U_MSB                      25
`define GCREG_TX_CONTROL_YUV_EX_INTERLEAVE_SWIZZLE_U_LSB                      24
`define GCREG_TX_CONTROL_YUV_EX_INTERLEAVE_SWIZZLE_U_SIZE                      2
