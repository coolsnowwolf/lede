/* Register gcregSEClipCompareRight **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* There is a precision issue in SE with very large triangles. When it        **
** computes the intersection of a point with the clipping box, it gets off by **
** a fraction of the pixel, which in some cases could cause the entire        **
** triangle to be culled. The next set of registers will add another value    **
** where SE has to compare against in order to determine in/out. In case of   **
** false positives, RA will still have valid edge equations to throw these    **
** pixels out.                                                                */

`define gcregSEClipCompareRightRegAddrs                                 16'h0308
`define GCREG_SE_CLIP_COMPARE_RIGHT_MSB                                       15
`define GCREG_SE_CLIP_COMPARE_RIGHT_LSB                                        0
`define GCREG_SE_CLIP_COMPARE_RIGHT_BLK                                        0
`define GCREG_SE_CLIP_COMPARE_RIGHT_Count                                      1
`define GCREG_SE_CLIP_COMPARE_RIGHT_FieldMask                       32'hFFFFFFFF
`define GCREG_SE_CLIP_COMPARE_RIGHT_ReadMask                        32'hFFFFFFFF
`define GCREG_SE_CLIP_COMPARE_RIGHT_WriteMask                       32'hFFFFFFFF
`define GCREG_SE_CLIP_COMPARE_RIGHT_ResetValue                      32'h00000000

/* Right X value to compare against. */
`define GCREG_SE_CLIP_COMPARE_RIGHT_FL32_MSB                                  31
`define GCREG_SE_CLIP_COMPARE_RIGHT_FL32_LSB                                   0
`define GCREG_SE_CLIP_COMPARE_RIGHT_FL32_SIZE                                 32

