`define GCREG_NN_INST_WORD31_NN_BATCH_OUTIMAGE_RANK_MSB                       26
`define GCREG_NN_INST_WORD31_NN_BATCH_OUTIMAGE_RANK_LSB                       26
`define GCREG_NN_INST_WORD31_NN_BATCH_OUTIMAGE_RANK_SIZE                       1
