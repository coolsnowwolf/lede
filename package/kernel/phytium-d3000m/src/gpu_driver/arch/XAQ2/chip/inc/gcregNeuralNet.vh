`define GCREG_NN_INST_WORD50_OP_FUSE_FUNCTION_LSB                             26
`define GCREG_NN_INST_WORD50_OP_FUSE_FUNCTION_SIZE                             4

/* output image of NN is in ZIV or CHW mode. 0 CHW(including transpose        **
** phase1), 1 ZIV                                                             */
`define GCREG_NN_INST_WORD50_OUT_IMAGE_ZIV_MODE_MSB                           30
`define GCREG_NN_INST_WORD50_OUT_IMAGE_ZIV_MODE_LSB                           30
`define GCREG_NN_INST_WORD50_OUT_IMAGE_ZIV_MODE_SIZE                           1
`define   GCREG_NN_INST_WORD50_OUT_IMAGE_ZIV_MODE_CHW                       1'h0
`define   GCREG_NN_INST_WORD50_OUT_IMAGE_ZIV_MODE_ZIV                       1'h1

/* Clamp out U16 to U10 range[0,1023] for special vivo network */
`define GCREG_NN_INST_WORD50_NN_CLAMP_U16_TO_U10_MSB                          31
`define GCREG_NN_INST_WORD50_NN_CLAMP_U16_TO_U10_LSB                          31
`define GCREG_NN_INST_WORD50_NN_CLAMP_U16_TO_U10_SIZE                          1
`define   GCREG_NN_INST_WORD50_NN_CLAMP_U16_TO_U10_DISABLE                  1'h0
`define   GCREG_NN_INST_WORD50_NN_CLAMP_U16_TO_U10_ENABLE                   1'h1

/* Offset gcregNNInstWord51
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Set kernel Stream Buffer start address in VIPSRAM for Stream Mode The      **
** kernel Stream Buffer start address need align tp 256 Byte(VS physic width) **
** The real Addr = KernelStreamCacheBuffStartAddr << 6                        */
`define GCREG_NN_INST_WORD51_KERNEL_STREAM_CACHE_BUFF_START_ADDR_MSB          25
`define GCREG_NN_INST_WORD51_KERNEL_STREAM_CACHE_BUFF_START_ADDR_LSB           0
`define GCREG_NN_INST_WORD51_KERNEL_STREAM_CACHE_BUFF_START_ADDR_SIZE         26

