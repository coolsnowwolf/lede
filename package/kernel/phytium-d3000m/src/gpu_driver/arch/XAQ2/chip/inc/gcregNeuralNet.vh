`define GCREG_NN_INST_WORD35_NN2ND_IMAGE_AXI_ID_OFFSET_MSB                    27
`define GCREG_NN_INST_WORD35_NN2ND_IMAGE_AXI_ID_OFFSET_LSB                    26
`define GCREG_NN_INST_WORD35_NN2ND_IMAGE_AXI_ID_OFFSET_SIZE                    2

/* Specifies the 2nd inImage data type, begin from v9.1. */
