`define GCREG_NN_INST_WORD44_IN_IMAGE_ADDR_OFFSET_ID_LSB                      19
`define GCREG_NN_INST_WORD44_IN_IMAGE_ADDR_OFFSET_ID_SIZE                      2

/* 2'b00: turned off 2'b01: turned on, will be used as next layer's 1st img   **
** 2'b10: turned on, will be used as next layer's 2nd img 2'b11: not used     */
`define GCREG_NN_INST_WORD44_OUT_IMAGE_BANK_BRICK_MODE_MSB                    22
`define GCREG_NN_INST_WORD44_OUT_IMAGE_BANK_BRICK_MODE_LSB                    21
`define GCREG_NN_INST_WORD44_OUT_IMAGE_BANK_BRICK_MODE_SIZE                    2
`define   GCREG_NN_INST_WORD44_OUT_IMAGE_BANK_BRICK_MODE_DISABLE            2'h0
`define   GCREG_NN_INST_WORD44_OUT_IMAGE_BANK_BRICK_MODE_OUT_AS_FIRST_IMG   2'h1
`define   GCREG_NN_INST_WORD44_OUT_IMAGE_BANK_BRICK_MODE_OUT_AS_SEC_IMG     2'h2
`define   GCREG_NN_INST_WORD44_OUT_IMAGE_BANK_BRICK_MODE_NOT_USED           2'h3

/* 0: turned off 1: turned on */
`define GCREG_NN_INST_WORD44_IN_IMAGE_BANK_BRICK_MODE_MSB                     23
`define GCREG_NN_INST_WORD44_IN_IMAGE_BANK_BRICK_MODE_LSB                     23
`define GCREG_NN_INST_WORD44_IN_IMAGE_BANK_BRICK_MODE_SIZE                     1
`define   GCREG_NN_INST_WORD44_IN_IMAGE_BANK_BRICK_MODE_DISABLE             1'h0
`define   GCREG_NN_INST_WORD44_IN_IMAGE_BANK_BRICK_MODE_ENABLE              1'h1

/* 0: turned off 1: turned on */
`define GCREG_NN_INST_WORD44_SECOND_IMAGE_BANK_BRICK_MODE_MSB                 24
`define GCREG_NN_INST_WORD44_SECOND_IMAGE_BANK_BRICK_MODE_LSB                 24
`define GCREG_NN_INST_WORD44_SECOND_IMAGE_BANK_BRICK_MODE_SIZE                 1
`define   GCREG_NN_INST_WORD44_SECOND_IMAGE_BANK_BRICK_MODE_DISABLE         1'h0
`define   GCREG_NN_INST_WORD44_SECOND_IMAGE_BANK_BRICK_MODE_ENABLE          1'h1

/* bit6To0 were WORD4[24:18] bit7 was WORD28[31:31] */
`define GCREG_NN_INST_WORD44_OUT_IMAGE_TILE_XSIZE_BIT9_TO8_MSB                26
`define GCREG_NN_INST_WORD44_OUT_IMAGE_TILE_XSIZE_BIT9_TO8_LSB                25
