`define GCREG_NN_INST_WORD44_SP_ENHANCE_DUAL_INPUT_LSB                        29
`define GCREG_NN_INST_WORD44_SP_ENHANCE_DUAL_INPUT_SIZE                        1

/* 0:Denorm  Don't flush to zero 1:Denorm  flush to zero */
