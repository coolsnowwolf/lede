`define GCREG_NN_INST_WORD47_SECOND_IN_IMAGE_BASE_ADDR_INC_BIT23_TO16_MSB      7
`define GCREG_NN_INST_WORD47_SECOND_IN_IMAGE_BASE_ADDR_INC_BIT23_TO16_LSB      0
