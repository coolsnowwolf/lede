`define GCREG_NN_INST_WORD50_SEC_IMG_STREAM_CACHE_BUFF_START_ADDR_MSB         25
`define GCREG_NN_INST_WORD50_SEC_IMG_STREAM_CACHE_BUFF_START_ADDR_LSB          0
`define GCREG_NN_INST_WORD50_SEC_IMG_STREAM_CACHE_BUFF_START_ADDR_SIZE        26

/* Nn op fuse function */
