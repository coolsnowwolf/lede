`define   GCREG_NN_INST_WORD31_NN_BATCH_OUTIMAGE_RANK_CNHW                  1'h1

/* bit[5] is Word23[0], bit[4:0] is Word31[31:27], begin from v9.0 */
`define GCREG_NN_INST_WORD31_NN_AXI_READ_CYCLE_RATIO_BIT0_TO4_MSB             31
`define GCREG_NN_INST_WORD31_NN_AXI_READ_CYCLE_RATIO_BIT0_TO4_LSB             27
