/* Offset gcregNNInstWord32
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* inImageXstride for 2nd bitstream, tensor add will use. */
`define GCREG_NN_INST_WORD32_SECOND_BIT_STREAM_XSTRIDE_MSB                    15
`define GCREG_NN_INST_WORD32_SECOND_BIT_STREAM_XSTRIDE_LSB                     0
`define GCREG_NN_INST_WORD32_SECOND_BIT_STREAM_XSTRIDE_SIZE                   16

/* inImageYstride for 2nd bitstream, tensor add will use. */
`define GCREG_NN_INST_WORD32_SECOND_BIT_STREAM_YSTRIDE_MSB                    31
`define GCREG_NN_INST_WORD32_SECOND_BIT_STREAM_YSTRIDE_LSB                    16
`define GCREG_NN_INST_WORD32_SECOND_BIT_STREAM_YSTRIDE_SIZE                   16

/* Offset gcregNNInstWord33
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

`define GCREG_NN_INST_WORD33_SECOND_IN_IMAGE_PAD_TO_SLICE_MSB                  0
`define GCREG_NN_INST_WORD33_SECOND_IN_IMAGE_PAD_TO_SLICE_LSB                  0
`define GCREG_NN_INST_WORD33_SECOND_IN_IMAGE_PAD_TO_SLICE_SIZE                 1
`define   GCREG_NN_INST_WORD33_SECOND_IN_IMAGE_PAD_TO_SLICE_DISABLE         1'h0
/* Second BitStream/inImage Pad to Slice, tensor add will use. */
`define   GCREG_NN_INST_WORD33_SECOND_IN_IMAGE_PAD_TO_SLICE_ENABLE          1'h1

/* Specifies the size of the circular buffer,begin from v9.0. */
`define GCREG_NN_INST_WORD33_NN_SECOND_INIMAGE_CIRCULAR_BUFFER_SIZE_MSB       26
`define GCREG_NN_INST_WORD33_NN_SECOND_INIMAGE_CIRCULAR_BUFFER_SIZE_LSB        1
`define GCREG_NN_INST_WORD33_NN_SECOND_INIMAGE_CIRCULAR_BUFFER_SIZE_SIZE      26

/* Number of transpose interleaved channels in the second inImage, 0 means 1  **
** channal or non-transposed, begin from v9.0.                                */
`define GCREG_NN_INST_WORD33_SECOND_INIMAGE_TRANSPOSE_CH_MINUS_ONE_MSB        30
`define GCREG_NN_INST_WORD33_SECOND_INIMAGE_TRANSPOSE_CH_MINUS_ONE_LSB        27
`define GCREG_NN_INST_WORD33_SECOND_INIMAGE_TRANSPOSE_CH_MINUS_ONE_SIZE        4

/* Post Process Low Power Mode.  */
`define GCREG_NN_INST_WORD33_PP_LOW_POWER_MODE_MSB                            31
`define GCREG_NN_INST_WORD33_PP_LOW_POWER_MODE_LSB                            31
`define GCREG_NN_INST_WORD33_PP_LOW_POWER_MODE_SIZE                            1
`define   GCREG_NN_INST_WORD33_PP_LOW_POWER_MODE_DISABLE                    1'h0
`define   GCREG_NN_INST_WORD33_PP_LOW_POWER_MODE_ENABLE                     1'h1

/* Offset gcregNNInstWord34
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* unit in bytes. Input Base Address, begin from v9.0. */
`define GCREG_NN_INST_WORD34_NN_SECOND_INPUT_BASE_ADDRESS_MSB                 31
`define GCREG_NN_INST_WORD34_NN_SECOND_INPUT_BASE_ADDRESS_LSB                  0
`define GCREG_NN_INST_WORD34_NN_SECOND_INPUT_BASE_ADDRESS_SIZE                32

/* Offset gcregNNInstWord35
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Specifies the end of the circular buffer, begin from v9.0. */
`define GCREG_NN_INST_WORD35_NN2ND_IMAGE_CIRC_BUF_END_ADDR_PLUS1_MSB          25
`define GCREG_NN_INST_WORD35_NN2ND_IMAGE_CIRC_BUF_END_ADDR_PLUS1_LSB           0
`define GCREG_NN_INST_WORD35_NN2ND_IMAGE_CIRC_BUF_END_ADDR_PLUS1_SIZE         26

/* AXI ID Offset for 2nd InImage, Only valid when both                        **
** NN_1st_inimage_transpose_ch_minus_one = 0,  and                            **
