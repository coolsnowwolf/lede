`define GCREG_NN_INST_WORD35_NN2ND_INPUT_IMAGE_DATA_TYPE_LSB                  28
`define GCREG_NN_INST_WORD35_NN2ND_INPUT_IMAGE_DATA_TYPE_SIZE                  4

/* Offset gcregNNInstWord36
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* SE4M9 format,14 bit[13:0], begin from v9.0. In v9.2, SE5M9 format is 15    **
** bit, 15 bit[14:14], put in word40 [31:31] bit                              */
`define GCREG_NN_INST_WORD36_TENSOR_ADD_CONSTANT_MSB                          13
`define GCREG_NN_INST_WORD36_TENSOR_ADD_CONSTANT_LSB                           0
`define GCREG_NN_INST_WORD36_TENSOR_ADD_CONSTANT_SIZE                         14

/* Bit [1:0] of NN Out put Depeth to space stride y, bit[3:2] in              **
** word43[31:30].                                                             */
`define GCREG_NN_INST_WORD36_OUT_D2_SSY_MINUS1_BIT0TO1_MSB                    15
`define GCREG_NN_INST_WORD36_OUT_D2_SSY_MINUS1_BIT0TO1_LSB                    14
`define GCREG_NN_INST_WORD36_OUT_D2_SSY_MINUS1_BIT0TO1_SIZE                    2

/* for 40 bits VA: 32 bits slice = {secondBitStreamSliceBit31to16,            **
** secondBitStreamYStride}                                                    */
`define GCREG_NN_INST_WORD36_SECOND_BIT_STREAM_SLICE_BIT31TO16_MSB            31
`define GCREG_NN_INST_WORD36_SECOND_BIT_STREAM_SLICE_BIT31TO16_LSB            16
`define GCREG_NN_INST_WORD36_SECOND_BIT_STREAM_SLICE_BIT31TO16_SIZE           16

/* Offset gcregNNInstWord37
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* for 40bits VA: addr={KernelBaseAddrBit39To32, Word5[26, 0], 0b000000} */
`define GCREG_NN_INST_WORD37_KERNEL_BASE_ADDR_BIT39_TO32_MSB                   7
`define GCREG_NN_INST_WORD37_KERNEL_BASE_ADDR_BIT39_TO32_LSB                   0
`define GCREG_NN_INST_WORD37_KERNEL_BASE_ADDR_BIT39_TO32_SIZE                  8

/* for 40bits VA: addr={InputBaseAddrBit39To32, NN_input_base_address[31:0]} */
`define GCREG_NN_INST_WORD37_INPUT_BASE_ADDR_BIT39_TO32_MSB                   15
`define GCREG_NN_INST_WORD37_INPUT_BASE_ADDR_BIT39_TO32_LSB                    8
`define GCREG_NN_INST_WORD37_INPUT_BASE_ADDR_BIT39_TO32_SIZE                   8

/* For 40bits VA addr={OutputBaseAddrBit32To39, NN_output_base_address} */
`define GCREG_NN_INST_WORD37_OUTPUT_BASE_ADDR_BIT39_TO32_MSB                  23
`define GCREG_NN_INST_WORD37_OUTPUT_BASE_ADDR_BIT39_TO32_LSB                  16
`define GCREG_NN_INST_WORD37_OUTPUT_BASE_ADDR_BIT39_TO32_SIZE                  8

/* For 40bits VA: size={inImageCBSizeBit39To32, inImageCircularBufSize[25:0], **
** 0b000000}                                                                  */
`define GCREG_NN_INST_WORD37_IN_IMAGE_CB_SIZE_BIT39_TO32_MSB                  31
`define GCREG_NN_INST_WORD37_IN_IMAGE_CB_SIZE_BIT39_TO32_LSB                  24
`define GCREG_NN_INST_WORD37_IN_IMAGE_CB_SIZE_BIT39_TO32_SIZE                  8

/* Offset gcregNNInstWord38
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* For 40bits VA: addr={inImageCBEndAddrPlus1Bit39To32,                       **
