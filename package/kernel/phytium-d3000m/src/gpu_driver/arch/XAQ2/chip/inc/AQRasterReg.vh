`define GCREG_CENTROIDS_CENTROID_X_1_5_9_13_LSB                                8
`define GCREG_CENTROIDS_CENTROID_X_1_5_9_13_SIZE                               4

/* Sub-pixel y location for centroids 1 (+0), 5 (+1), 9 (+2), and 13 (+3). */
`define GCREG_CENTROIDS_CENTROID_Y_1_5_9_13_MSB                               15
`define GCREG_CENTROIDS_CENTROID_Y_1_5_9_13_LSB                               12
