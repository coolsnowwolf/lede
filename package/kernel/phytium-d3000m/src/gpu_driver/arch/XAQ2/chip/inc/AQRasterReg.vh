`define GCREG_CENTROIDS_WriteMask                                   32'hFFFFFFFF
`define GCREG_CENTROIDS_ResetValue                                  32'h00000000

/* Sub-pixel x location for centroids 0 (+0), 4 (+1), 8 (+2), and 12 (+3). */
`define GCREG_CENTROIDS_CENTROID_X_0_4_8_12_MSB                                3
`define GCREG_CENTROIDS_CENTROID_X_0_4_8_12_LSB                                0
`define GCREG_CENTROIDS_CENTROID_X_0_4_8_12_SIZE                               4

/* Sub-pixel y location for centroids 0 (+0), 4 (+1), 8 (+2), and 12 (+3). */
