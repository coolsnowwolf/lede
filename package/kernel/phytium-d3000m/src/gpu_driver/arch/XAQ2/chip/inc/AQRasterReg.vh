/* Register gcregRAControlHZ **
** ~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define gcregRAControlHZRegAddrs                                        16'h0388
`define GCREG_RA_CONTROL_HZ_MSB                                               15
`define GCREG_RA_CONTROL_HZ_LSB                                                0
`define GCREG_RA_CONTROL_HZ_BLK                                                0
`define GCREG_RA_CONTROL_HZ_Count                                              1
`define GCREG_RA_CONTROL_HZ_FieldMask                               32'h00117131
`define GCREG_RA_CONTROL_HZ_ReadMask                                32'h00117131
`define GCREG_RA_CONTROL_HZ_WriteMask                               32'h00117131
`define GCREG_RA_CONTROL_HZ_ResetValue                              32'h00000000

/* HZ format. */
`define GCREG_RA_CONTROL_HZ_FORMAT_MSB                                         0
`define GCREG_RA_CONTROL_HZ_FORMAT_LSB                                         0
`define GCREG_RA_CONTROL_HZ_FORMAT_SIZE                                        1
/* 16-bit min/max HZ, 32-bit per HZ entry. */
`define   GCREG_RA_CONTROL_HZ_FORMAT_HZ16_MIN_MAX                           1'h0
/* 24-bit min/max HZ, 64-bit per HZ entry. */
`define   GCREG_RA_CONTROL_HZ_FORMAT_HZ24_MIN_MAX                           1'h1

/* HZ format for level 1. */
`define GCREG_RA_CONTROL_HZ_MODE1_MSB                                          5
`define GCREG_RA_CONTROL_HZ_MODE1_LSB                                          4
`define GCREG_RA_CONTROL_HZ_MODE1_SIZE                                         2
/* HZ is disabled. */
`define   GCREG_RA_CONTROL_HZ_MODE1_DISABLED                                2'h0
/* HZ is read-only enabled (after pre-pass). */
`define   GCREG_RA_CONTROL_HZ_MODE1_READ_ONLY                               2'h1
/* HZ is fully enabled. */
`define   GCREG_RA_CONTROL_HZ_MODE1_ENABLED                                 2'h2

/* HZ tile size for level 1. */
`define GCREG_RA_CONTROL_HZ_LEVEL1_MSB                                         8
`define GCREG_RA_CONTROL_HZ_LEVEL1_LSB                                         8
`define GCREG_RA_CONTROL_HZ_LEVEL1_SIZE                                        1
/* One HZ value per 2x2 Z pixels. */
`define   GCREG_RA_CONTROL_HZ_LEVEL1_TILE2X2                                1'h0
/* One HZ value per 4x4 Z pixels. */
`define   GCREG_RA_CONTROL_HZ_LEVEL1_TILE4X4                                1'h1

/* Depth compare mode for HZ. */
`define GCREG_RA_CONTROL_HZ_COMPARE_MSB                                       14
`define GCREG_RA_CONTROL_HZ_COMPARE_LSB                                       12
`define GCREG_RA_CONTROL_HZ_COMPARE_SIZE                                       3
/* Always false. */
`define   GCREG_RA_CONTROL_HZ_COMPARE_NEVER                                 3'h0
/* Z(min) < HZ(max). */
`define   GCREG_RA_CONTROL_HZ_COMPARE_LESS                                  3'h1
/* Z(min) <= HZ(max) and Z(max) >= HZ(min). */
`define   GCREG_RA_CONTROL_HZ_COMPARE_EQUAL                                 3'h2
/* Z(min) <= HZ(max). */
`define   GCREG_RA_CONTROL_HZ_COMPARE_LESS_EQUAL                            3'h3
/* Z(max) > HZ(min). */
`define   GCREG_RA_CONTROL_HZ_COMPARE_GREATER                               3'h4
/* Always true. */
`define   GCREG_RA_CONTROL_HZ_COMPARE_NOT_EQUAL                             3'h5
/* Z(max) >= HZ(min). */
`define   GCREG_RA_CONTROL_HZ_COMPARE_GREATER_EQUAL                         3'h6
/* Always true. */
`define   GCREG_RA_CONTROL_HZ_COMPARE_ALWAYS                                3'h7

/* Kill pixels after HZ has been updated. */
`define GCREG_RA_CONTROL_HZ_KILL_MSB                                          16
`define GCREG_RA_CONTROL_HZ_KILL_LSB                                          16
`define GCREG_RA_CONTROL_HZ_KILL_SIZE                                          1
/* Don't kill any pixels. */
`define   GCREG_RA_CONTROL_HZ_KILL_NONE                                     1'h0
/* Update HZ buffers and kill the pixels after this is done. So, after        **
** processing the final level of HZ tile, nothing is sent down the pipe in    **
** the rasterizer. This is useful in a pre-pass that creates a HZ buffer.     */
`define   GCREG_RA_CONTROL_HZ_KILL_HZ_PRE_PASS                              1'h1

/* Control how HZ is handled in MSAA. */
`define GCREG_RA_CONTROL_HZ_MSAA_MSB                                          20
`define GCREG_RA_CONTROL_HZ_MSAA_LSB                                          20
`define GCREG_RA_CONTROL_HZ_MSAA_SIZE                                          1
/* Z$ updates 64-bit of HZ data and MSAA works with 4x4 tiles. */
`define   GCREG_RA_CONTROL_HZ_MSAA_NORMAL                                   1'h0
/* Z$ doesn't update HZ and MSAA works with 8x8 tiles. */
`define   GCREG_RA_CONTROL_HZ_MSAA_PRE_PASS                                 1'h1

