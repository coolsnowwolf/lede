`define GCREG_CENTROIDS_CENTROID_Y_0_4_8_12_LSB                                4
`define GCREG_CENTROIDS_CENTROID_Y_0_4_8_12_SIZE                               4

/* Sub-pixel x location for centroids 1 (+0), 5 (+1), 9 (+2), and 13 (+3). */
