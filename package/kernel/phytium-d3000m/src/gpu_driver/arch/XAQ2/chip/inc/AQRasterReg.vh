`define GCREG_RA_CONTROL_DISABLE_ZCONTROL_SIZE                                 1
/* Enable Z computation in raster pipe. */
`define   GCREG_RA_CONTROL_DISABLE_ZCONTROL_ENABLED                         1'h0
/* Disable Z computation in raster pipe. */
`define   GCREG_RA_CONTROL_DISABLE_ZCONTROL_DISABLED                        1'h1

/* Determin usage of integer Z in the raster pipe. */
`define GCREG_RA_CONTROL_ZMODE_MSB                                            16
`define GCREG_RA_CONTROL_ZMODE_LSB                                            16
`define GCREG_RA_CONTROL_ZMODE_SIZE                                            1
/* Use integer Z until a triangle under- or overflows, at which point the     **
** rasterization will slow down and be done in FP32.                          */
`define   GCREG_RA_CONTROL_ZMODE_AUTOMATIC                                  1'h0
/* Use a slow FP32 interpolation, regardless of triangle overflow or not. */
`define   GCREG_RA_CONTROL_ZMODE_FLOAT                                      1'h1

/* Control whether or not precise Z is required on the centroid in the Pixel  **
** Shader.                                                                    */
`define GCREG_RA_CONTROL_CENTROID_Z_MSB                                       20
`define GCREG_RA_CONTROL_CENTROID_Z_LSB                                       20
`define GCREG_RA_CONTROL_CENTROID_Z_SIZE                                       1
/* Compute average depth on center of point before sending it to Pixel        **
** Shader.                                                                    */
`define   GCREG_RA_CONTROL_CENTROID_Z_AVERAGE                               1'h0
/* Interpolate Z for the centroid. */
`define   GCREG_RA_CONTROL_CENTROID_Z_CENTROID                              1'h1

/* Control bit whether to clamp Z to Pixel Shader or not. */
`define GCREG_RA_CONTROL_SHADER_ZCLAMP_MSB                                    23
`define GCREG_RA_CONTROL_SHADER_ZCLAMP_LSB                                    23
`define GCREG_RA_CONTROL_SHADER_ZCLAMP_SIZE                                    1
`define   GCREG_RA_CONTROL_SHADER_ZCLAMP_DISABLED                           1'h0
`define   GCREG_RA_CONTROL_SHADER_ZCLAMP_ENABLED                            1'h1

/* Control bit whether to send FP32 Z to Pixel Shader or not. */
`define GCREG_RA_CONTROL_SHADER_Z_MSB                                         24
`define GCREG_RA_CONTROL_SHADER_Z_LSB                                         24
`define GCREG_RA_CONTROL_SHADER_Z_SIZE                                         1
/* The FP32 Z value gets forced to 0 (to save power) before sending to PS. */
`define   GCREG_RA_CONTROL_SHADER_Z_DISABLED                                1'h0
/* FP32 Z value gets sent to the PS. */
`define   GCREG_RA_CONTROL_SHADER_Z_ENABLED                                 1'h1

/* Control bit whether to send sub-samples to Pixel Shader or not. */
`define GCREG_RA_CONTROL_SHADER_SUB_SAMPLES_MSB                               25
`define GCREG_RA_CONTROL_SHADER_SUB_SAMPLES_LSB                               25
`define GCREG_RA_CONTROL_SHADER_SUB_SAMPLES_SIZE                               1
/* Integer sub-samples are not sent to PS. */
`define   GCREG_RA_CONTROL_SHADER_SUB_SAMPLES_DISABLED                      1'h0
/* Integer sub-samples are sent to PS. */
`define   GCREG_RA_CONTROL_SHADER_SUB_SAMPLES_ENABLED                       1'h1

/* Control bit whether to send FP32 W to Pixel Shader or not. */
`define GCREG_RA_CONTROL_SHADER_W_MSB                                         26
`define GCREG_RA_CONTROL_SHADER_W_LSB                                         26
`define GCREG_RA_CONTROL_SHADER_W_SIZE                                         1
/* The FP32 W value gets forced to 0 (to save power) before sending to PS. */
`define   GCREG_RA_CONTROL_SHADER_W_DISABLED                                1'h0
/* FP32 W value gets sent to the PS. */
`define   GCREG_RA_CONTROL_SHADER_W_ENABLED                                 1'h1

/* 8x8, 4x4 quad raster direction. */
`define GCREG_RA_CONTROL_QUAD_DIRECTION_MSB                                   27
`define GCREG_RA_CONTROL_QUAD_DIRECTION_LSB                                   27
`define GCREG_RA_CONTROL_QUAD_DIRECTION_SIZE                                   1
`define   GCREG_RA_CONTROL_QUAD_DIRECTION_ZIG_ZAG                           1'h0
`define   GCREG_RA_CONTROL_QUAD_DIRECTION_CYCLE                             1'h1

/* Select Z control for rasterizer. */
`define GCREG_RA_CONTROL_ZSELECT_MSB                                          29
`define GCREG_RA_CONTROL_ZSELECT_LSB                                          28
`define GCREG_RA_CONTROL_ZSELECT_SIZE                                          2
/* Rasterizer process all Z values. */
`define   GCREG_RA_CONTROL_ZSELECT_READ_WRITE                               2'h0
/* Rasterizer only reads Z, doesn't update Z. */
`define   GCREG_RA_CONTROL_ZSELECT_READ                                     2'h1
/* Rasterizer doesn't process any Z. */
