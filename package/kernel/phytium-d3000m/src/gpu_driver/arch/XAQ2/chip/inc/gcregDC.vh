`define   DCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_FRAME_CNT                8'h05
`define   DCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_INPUT_DBI_CMD_CNT        8'h06
`define   DCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_OUTPUT_DBI_CMD_CNT       8'h07
`define   DCREG_DEBUG_COUNTER_SELECT_SELECT_DEBUG_SIGNALS0                 8'h08
`define   DCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_AXI_OVERLAY0_RD_REQ_CNT  8'h09
`define   DCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_AXI_OVERLAY0_RD_LAST_CNT 8'h0A
`define   DCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_AXI_OVERLAY0_REQ_BURST_CNT 8'h0B
`define   DCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_AXI_OVERLAY0_RD_BURST_CUNT 8'h0C
