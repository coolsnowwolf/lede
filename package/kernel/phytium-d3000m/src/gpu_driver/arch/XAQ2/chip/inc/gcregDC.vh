`define   DCREG_DBI_TYPEC_CFG_SCL_SEL_SDA_CLK                               1'h1

/* SCL Twrh means number of DBI_AC_TIME_UNIT of sdaClk for scl staying low    **
** This field need to be at least 1                                           */
`define DCREG_DBI_TYPEC_CFG_SCL_TWRH_MSB                                      19
`define DCREG_DBI_TYPEC_CFG_SCL_TWRH_LSB                                      12
`define DCREG_DBI_TYPEC_CFG_SCL_TWRH_SIZE                                      8

/* SCL Twrl menas number of DBI_AC_TIME_UNIT of sdaClk for scl staying high   **
** This field need to be at least 1                                           */
`define DCREG_DBI_TYPEC_CFG_SCL_TWRL_MSB                                      11
`define DCREG_DBI_TYPEC_CFG_SCL_TWRL_LSB                                       4
`define DCREG_DBI_TYPEC_CFG_SCL_TWRL_SIZE                                      8

/* DCX Tas means number of DBI_AC_TIME_UNIT of sdaClk to be ahead of scl.     **
** Only works for Option3. Option1/2 will ignore this setting. This field     **
** need to be at least 1                                                      */
`define DCREG_DBI_TYPEC_CFG_TAS_MSB                                            3
`define DCREG_DBI_TYPEC_CFG_TAS_LSB                                            0
`define DCREG_DBI_TYPEC_CFG_TAS_SIZE                                           4

