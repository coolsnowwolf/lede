`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_END                             5'h02
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_NOP                             5'h03
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_START_DE                        5'h04
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_DX8_DRAW_PRIMITIVE              5'h05
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_DX8_DRAW_INDEX_PRIMITIVE        5'h06
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_WAIT                            5'h07
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_LINK                            5'h08
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_STALL                           5'h09
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_CALL                            5'h0A
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_RETURN                          5'h0B
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_DRAW_INSTANCED                  5'h0C
`define   AQ_COMMAND_CALL64_COMMAND_OPCODE_CHIP_ENABLE                     5'h0D
