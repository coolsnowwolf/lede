`define GCCMD_DRAW_INSTANCED_COMMAND_CmdAddrs                           16'h0F1C

/* Conditional execution. */
`define GCCMD_DRAW_INSTANCED_COMMAND_CONDITIONAL_MSB                          26
`define GCCMD_DRAW_INSTANCED_COMMAND_CONDITIONAL_LSB                          24
`define GCCMD_DRAW_INSTANCED_COMMAND_CONDITIONAL_SIZE                          3
/* Always execute. */
`define   GCCMD_DRAW_INSTANCED_COMMAND_CONDITIONAL_ALWAYS                   3'h0
/* Execute when the oldest occlusion query returned a valid pixel. */
`define   GCCMD_DRAW_INSTANCED_COMMAND_CONDITIONAL_OCCLUSION_ONE            3'h1
/* Execute when the oldest occlusion query returned no valid pixels. */
`define   GCCMD_DRAW_INSTANCED_COMMAND_CONDITIONAL_OCCLUSION_NONE           3'h2
/* Execute when the oldest occlusion query returned a valid pixel and also    **
** pop the occlusion query from the FIFO.                                     */
`define   GCCMD_DRAW_INSTANCED_COMMAND_CONDITIONAL_OCCLUSION_ONE_POP        3'h3
/* Execute when the oldest occlusion query returned no valid pixels and also  **
** pop the occlusion query from the FIFO.                                     */
`define   GCCMD_DRAW_INSTANCED_COMMAND_CONDITIONAL_OCCLUSION_NONE_POP       3'h4

