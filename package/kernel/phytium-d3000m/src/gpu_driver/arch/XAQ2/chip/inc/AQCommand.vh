*******************************************************************************/

`define AQCommandCall64CmdAddrs                                         16'h0F68
`define AQ_COMMAND_CALL64_Address                                      18'h03DA0
`define AQ_COMMAND_CALL64_Count                                                6

/* Offset Command
** ~~~~~~~~~~~~~~ */
`define AQ_COMMAND_CALL64_COMMAND_Index                                        0
`define AQ_COMMAND_CALL64_COMMAND_CmdAddrs                              16'h0F68

/* Conditional execution. */
`define AQ_COMMAND_CALL64_COMMAND_CONDITIONAL_MSB                             26
`define AQ_COMMAND_CALL64_COMMAND_CONDITIONAL_LSB                             24
`define AQ_COMMAND_CALL64_COMMAND_CONDITIONAL_SIZE                             3
/* Always execute. */
`define   AQ_COMMAND_CALL64_COMMAND_CONDITIONAL_ALWAYS                      3'h0
/* Execute when the oldest occlusion query returned a valid pixel. */
`define   AQ_COMMAND_CALL64_COMMAND_CONDITIONAL_OCCLUSION_ONE               3'h1
/* Execute when the oldest occlusion query returned no valid pixels. */
`define   AQ_COMMAND_CALL64_COMMAND_CONDITIONAL_OCCLUSION_NONE              3'h2
/* Execute when the oldest occlusion query returned a valid pixel and also    **
** pop the occlusion query from the FIFO.                                     */
`define   AQ_COMMAND_CALL64_COMMAND_CONDITIONAL_OCCLUSION_ONE_POP           3'h3
/* Execute when the oldest occlusion query returned no valid pixels and also  **
** pop the occlusion query from the FIFO.                                     */
`define   AQ_COMMAND_CALL64_COMMAND_CONDITIONAL_OCCLUSION_NONE_POP          3'h4

/* Number of 64-bit words to fetch.  Make sure this number is not too low,    **
** nothing else will be fetched.  So, make sure that the last command in the  **
** new command buffer is either an END, a LINK, a CALL, or a RETURN.          */
`define AQ_COMMAND_CALL64_COMMAND_PREFETCH_MSB                                15
`define AQ_COMMAND_CALL64_COMMAND_PREFETCH_LSB                                 0
`define AQ_COMMAND_CALL64_COMMAND_PREFETCH_SIZE                               16

