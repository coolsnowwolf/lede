/* Register gcDisplayPriority **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Controls the priority of the display controller requests. This works like  **
** a PWM. One register gives the period, and the other gives the ON time.     **
** When PWM is ON, display requests are accepted if both display and the      **
** other request is valid. If it is OFF, the other request will be accepted.  **
** If only one request is valid, it takes the bus regardless of the PWM bit.  */

`define gcDisplayPriorityRegAddrs                                       16'h010D
`define GC_DISPLAY_PRIORITY_MSB                                               15
`define GC_DISPLAY_PRIORITY_LSB                                                0
`define GC_DISPLAY_PRIORITY_BLK                                                0
`define GC_DISPLAY_PRIORITY_Count                                              1
`define GC_DISPLAY_PRIORITY_FieldMask                               32'h0000FFFF
`define GC_DISPLAY_PRIORITY_ReadMask                                32'h0000FFFF
`define GC_DISPLAY_PRIORITY_WriteMask                               32'h0000FFFF
`define GC_DISPLAY_PRIORITY_ResetValue                              32'h00000102

`define GC_DISPLAY_PRIORITY_PERIOD_MSB                                         7
`define GC_DISPLAY_PRIORITY_PERIOD_LSB                                         0
`define GC_DISPLAY_PRIORITY_PERIOD_SIZE                                        8

`define GC_DISPLAY_PRIORITY_HIGH_MSB                                          15
`define GC_DISPLAY_PRIORITY_HIGH_LSB                                           8
`define GC_DISPLAY_PRIORITY_HIGH_SIZE                                          8

