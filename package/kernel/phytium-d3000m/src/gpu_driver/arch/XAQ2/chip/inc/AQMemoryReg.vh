/* Register gcDebugSignalsL2 **
** ~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* 32 bit debug signal from L2.  This register has no reset value. */

`define gcDebugSignalsL2RegAddrs                                        16'h0159
`define GC_DEBUG_SIGNALS_L2_MSB                                               15
`define GC_DEBUG_SIGNALS_L2_LSB                                                0
`define GC_DEBUG_SIGNALS_L2_BLK                                                0
`define GC_DEBUG_SIGNALS_L2_Count                                              1
`define GC_DEBUG_SIGNALS_L2_FieldMask                               32'hFFFFFFFF
`define GC_DEBUG_SIGNALS_L2_ReadMask                                32'hFFFFFFFF
`define GC_DEBUG_SIGNALS_L2_WriteMask                               32'h00000000
`define GC_DEBUG_SIGNALS_L2_ResetValue                              32'h00000000

/* Signals according to select signal: 00 -> total number of AXI0 read        **
** requests 01 -> total number of AXI1 read requests 02 -> total number of    **
** AXI0 read return requests 03 -> total number of AXI1 read return requests  **
** 04 -> total number of AXI0 write requests 05 -> total number of AXI1 write **
** requests 06 -> total number of AXI0 write requests 07 -> total number of   **
** AXI1 write requests 08 -> total number of read transactions requested by   **
** AXI0 09 -> total number of read transactions requested by AXI1 0A -> total **
** number of AXI0 read return transactions 0B -> total number of AXI1 read    **
** return transactions 0C -> total number of write transactions requested by  **
** AXI0 0D -> total number of write transactions requested by AXI1 0E ->      **
** total number of AXI0 write transactions 0F -> total number of AXI1 write   **
** transactions 10 -> AXI0 mini/max latency, 11 -> AXI0 total latency 12 ->   **
** AXI0 total number of request 13 -> AXI1 min/max latency, 14 -> AXI1 total  **
** latency 15 -> AXI1 total number of request 16 -> AXI0/1 outstanding        **
** read/write request count 17 -> AXI maximum outstanding read/write/all      **
** request count 18 -> number of AXI0 read request stalled 19 -> number of    **
** AXI0 write request stalled 1A -> number of AXI0 write data stalled 1B ->   **
** number of AXI1 read request stalled 1C -> number of AXI1 write request     **
** stalled 1D -> number of AXI1 write data stalled FF-> Signature =           **
** 0x22222222.                                                                */
`define GC_DEBUG_SIGNALS_L2_SIGNAL_MSB                                        31
`define GC_DEBUG_SIGNALS_L2_SIGNAL_LSB                                         0
`define GC_DEBUG_SIGNALS_L2_SIGNAL_SIZE                                       32

