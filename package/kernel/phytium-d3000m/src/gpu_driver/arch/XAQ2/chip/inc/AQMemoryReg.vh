** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Composition trigger. */

`define gcregCETriggerAsyncRegAddrs                                     16'h0155
`define GCREG_CE_TRIGGER_ASYNC_MSB                                            15
`define GCREG_CE_TRIGGER_ASYNC_LSB                                             0
`define GCREG_CE_TRIGGER_ASYNC_BLK                                             0
`define GCREG_CE_TRIGGER_ASYNC_Count                                           1
`define GCREG_CE_TRIGGER_ASYNC_FieldMask                            32'h00000003
`define GCREG_CE_TRIGGER_ASYNC_ReadMask                             32'h00000003
`define GCREG_CE_TRIGGER_ASYNC_WriteMask                            32'h00000003
`define GCREG_CE_TRIGGER_ASYNC_ResetValue                           32'h00000000

/* This field triggers a composition.  The RA will send this state down to    **
** other blocks so they know they are inside a composition.  Once the         **
** composition is done, the RA will send this state with the Idle value down  **
** the pipe.                                                                  */
`define GCREG_CE_TRIGGER_ASYNC_EXECUTE_MSB                                     1
`define GCREG_CE_TRIGGER_ASYNC_EXECUTE_LSB                                     0
`define GCREG_CE_TRIGGER_ASYNC_EXECUTE_SIZE                                    2
/* Not doing any composition. */
`define   GCREG_CE_TRIGGER_ASYNC_EXECUTE_IDLE                               2'h0
/* Trigger a rectangle. */
`define   GCREG_CE_TRIGGER_ASYNC_EXECUTE_TRIGGER                            2'h1
/* Load states. The load state buffer consists of address/data pairs, each    **
** pair being 64-bit in size. The very first entry is special. The address    **
** needs to be 0xFFFFFFFF and the data contains the total number of states    **
** inside the state buffer. Make sure to kick of a Trigger, otherwise no      **
** rectngle is generated.                                                     */
`define   GCREG_CE_TRIGGER_ASYNC_EXECUTE_LOAD                               2'h3

