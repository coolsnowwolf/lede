/* Register gcDebugSignalsPPa **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* 32 bit debug signal from PPa.  This register has no reset value. */

`define gcDebugSignalsPPaRegAddrs                                       16'h0166
`define GC_DEBUG_SIGNALS_PPA_MSB                                              15
`define GC_DEBUG_SIGNALS_PPA_LSB                                               0
`define GC_DEBUG_SIGNALS_PPA_BLK                                               0
`define GC_DEBUG_SIGNALS_PPA_Count                                             1
`define GC_DEBUG_SIGNALS_PPA_FieldMask                              32'hFFFFFFFF
`define GC_DEBUG_SIGNALS_PPA_ReadMask                               32'hFFFFFFFF
`define GC_DEBUG_SIGNALS_PPA_WriteMask                              32'h00000000
`define GC_DEBUG_SIGNALS_PPA_ResetValue                             32'h00000000

/* Signals according to select signal: 00 -> Various signals from input       **
** stage. See RTL for details. 01 -> Various signals from input stage. See    **
** RTL for details. 02 -> Various signals from input stage. See RTL for       **
** details. 03 -> total vertex count 04 -> input primitive count 05 -> output **
** primitive count 06 -> depth clipped primitive count 07 -> trivial rejected **
** primitive count 08 -> culled primitive count 09 -> dropped primitive count **
** 0A -> frustum cipped primitive count 0B -> ClipFrustum debug 0C -> PA Non  **
** Idle Starve count 0D -> PA starve count 0E -> PA stall count 0F -> PA      **
** Process count FF -> Signature = 0x0000aaaa                                 */
`define GC_DEBUG_SIGNALS_PPA_SIGNAL_MSB                                       31
`define GC_DEBUG_SIGNALS_PPA_SIGNAL_LSB                                        0
`define GC_DEBUG_SIGNALS_PPA_SIGNAL_SIZE                                      32

