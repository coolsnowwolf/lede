/* Register gcregSWControlVXSBI0 **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* This field is set for one input of Isp2NpuDisconnect of dual SBI input;    **
** another Isp2NpuDisconnect in gcregSWControlDualSBIInput bits 1:0  AHB      **
** ISP-NPU Signal Software Control SBI Register 0.                            */

`define gcregSWControlVXSBI0RegAddrs                                    16'h5FBF
`define GCREG_SW_CONTROL_VXSBI0_MSB                                           15
`define GCREG_SW_CONTROL_VXSBI0_LSB                                            0
`define GCREG_SW_CONTROL_VXSBI0_BLK                                            0
`define GCREG_SW_CONTROL_VXSBI0_Count                                          1
`define GCREG_SW_CONTROL_VXSBI0_FieldMask                           32'h0000001B
`define GCREG_SW_CONTROL_VXSBI0_ReadMask                            32'h0000001B
`define GCREG_SW_CONTROL_VXSBI0_WriteMask                           32'h0000001B
`define GCREG_SW_CONTROL_VXSBI0_ResetValue                          32'h00000000

/* Disconnect ISP2NPU VSBI signals or not.  Value 0 connect to ISP.  Write 1  **
** to disconnnect ISP2NPU SBI signals. and Connect to software control        **
** registers.  This step is needed before using the SBI_Wr field for software **
** control.  Value 2 connect to pattern generator.                            */
`define GCREG_SW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_MSB                        1
`define GCREG_SW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_LSB                        0
`define GCREG_SW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_SIZE                       2
`define   GCREG_SW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_ISP                   2'h0
`define   GCREG_SW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_SOFT_CONTROL          2'h1
`define   GCREG_SW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_PATTERN_GEN           2'h2

/* This field is set for one input of Npu2IspDisconnect of dual SBI input;    **
** another Npu2IspDisconnect in gcregSWControlDualSBIInput bits 4:3  Value 0  **
** connect to ISP.  Indicate to disconnect NPU2ISP SBI signals or not.  Value **
** 1 means connect software - controlled regsiters.  This step is needed      **
** before using the SBI_rd field for software control.  Value 2 means connect **
** to checksum generator.                                                     */
`define GCREG_SW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_MSB                        4
`define GCREG_SW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_LSB                        3
`define GCREG_SW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_SIZE                       2
`define   GCREG_SW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_ISP                   2'h0
`define   GCREG_SW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_SOFT_CONTROL          2'h1
`define   GCREG_SW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_CHECK_SUM_GEN         2'h2

