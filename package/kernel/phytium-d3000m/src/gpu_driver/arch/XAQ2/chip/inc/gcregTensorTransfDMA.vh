`define GCREG_PTN_GEN_BAYER_IMAGE_DUAL_SBI_INPUT_WriteMask          32'hFFFFFFFF
`define GCREG_PTN_GEN_BAYER_IMAGE_DUAL_SBI_INPUT_ResetValue         32'h0C001100

/* Default is 4352, must be even */
