/* Register gcregDenoisePostProcess **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* DenoisePostProcess Shadow Register.  */

`define gcregDenoisePostProcessRegAddrs                                 16'h5FCD
`define GCREG_DENOISE_POST_PROCESS_MSB                                        15
`define GCREG_DENOISE_POST_PROCESS_LSB                                         0
`define GCREG_DENOISE_POST_PROCESS_BLK                                         0
`define GCREG_DENOISE_POST_PROCESS_Count                                       1
`define GCREG_DENOISE_POST_PROCESS_FieldMask                        32'h000003FF
`define GCREG_DENOISE_POST_PROCESS_ReadMask                         32'h000003FF
`define GCREG_DENOISE_POST_PROCESS_WriteMask                        32'h000003FF
`define GCREG_DENOISE_POST_PROCESS_ResetValue                       32'h00000000

/* Set for DenoisePostProcess Mask mode.  SourceMask Bit2 is in               **
** gcregDenoisePostProcess bit8.  0    Mask(0:3) = {4{DMA4(4)}} (V400         **
** compatible setting) 1    Mask(0:3) = DMA2(0:3) 2    Mask(0:3) = DMA4(4:7)  **
** 3    Mask(0:3) = {4{DMA4(4)}}, NewMask = DMA4[5] 4    Mask(0:3) =          **
** DMA4(4:7), NewMask = DMA4[8] 5~7  Unused                                   */
`define GCREG_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_MSB                         1
`define GCREG_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_LSB                         0
`define GCREG_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_SIZE                        2

/* Set for DenoisePostProcess Bypass Multiplication Logic.  0 : Support       **
** DenoisePostProcess V400; 1 : Support DenoisePostProcess V500, Bypass       **
** Multiplication Logic.                                                      */
`define GCREG_DENOISE_POST_PROCESS_ONE_SUB_MASK_MSB                            2
`define GCREG_DENOISE_POST_PROCESS_ONE_SUB_MASK_LSB                            2
`define GCREG_DENOISE_POST_PROCESS_ONE_SUB_MASK_SIZE                           1

/* Set for V500 to Bypass DenoisePostProcess.  1 to bypass the Denoise Post   **
** Process module in V500. With register gcregTTDMisc Bit[2], DPP bypass in   **
** V400. Out = PSI Out 2                                                      */
`define GCREG_DENOISE_POST_PROCESS_BYPASS_V500_MSB                             3
`define GCREG_DENOISE_POST_PROCESS_BYPASS_V500_LSB                             3
`define GCREG_DENOISE_POST_PROCESS_BYPASS_V500_SIZE                            1

/* The field set for DMA2 support UINT16.  1 : UINT16 ; 0 : INT16  */
`define GCREG_DENOISE_POST_PROCESS_DMA2_FORMAT_MSB                             4
`define GCREG_DENOISE_POST_PROCESS_DMA2_FORMAT_LSB                             4
`define GCREG_DENOISE_POST_PROCESS_DMA2_FORMAT_SIZE                            1

/* The field set for DMA3 support UINT16.  1 : UINT16 ; 0 : INT16  */
`define GCREG_DENOISE_POST_PROCESS_DMA3_FORMAT_MSB                             5
`define GCREG_DENOISE_POST_PROCESS_DMA3_FORMAT_LSB                             5
`define GCREG_DENOISE_POST_PROCESS_DMA3_FORMAT_SIZE                            1

/* The field set for DMA4 support UINT16.  1 : UINT16 ; 0 : INT16  */
`define GCREG_DENOISE_POST_PROCESS_DMA4_FORMAT_MSB                             6
`define GCREG_DENOISE_POST_PROCESS_DMA4_FORMAT_LSB                             6
`define GCREG_DENOISE_POST_PROCESS_DMA4_FORMAT_SIZE                            1

/* The field set for DPP out support UINT16.  1 : UINT16 ; 0 : INT16  */
`define GCREG_DENOISE_POST_PROCESS_OUT_FORMAT_MSB                              7
`define GCREG_DENOISE_POST_PROCESS_OUT_FORMAT_LSB                              7
`define GCREG_DENOISE_POST_PROCESS_OUT_FORMAT_SIZE                             1

/* Set for DenoisePostProcess Mask mode.  SourceMask Bit0-1 is in             **
** gcregDenoisePostProcess bit0:1.  0    Mask(0:3) = {4{DMA4(4)}} (V400       **
** compatible setting) 1    Mask(0:3) = DMA2(0:3) 2    Mask(0:3) = DMA4(4:7)  **
** 3    Mask(0:3) = {4{DMA4(4)}}, NewMask = DMA4[5] 4    Mask(0:3) =          **
** DMA4(4:7), NewMask = DMA4[8] 5~7  Unused                                   */
`define GCREG_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_BIT2_MSB                    8
`define GCREG_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_BIT2_LSB                    8
`define GCREG_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_BIT2_SIZE                   1

/* The field set to check if clip res mask output.  0    Don't clip  1        **
** Clip                                                                       */
`define GCREG_DENOISE_POST_PROCESS_RES_MASK_CLIP_MSB                           9
`define GCREG_DENOISE_POST_PROCESS_RES_MASK_CLIP_LSB                           9
`define GCREG_DENOISE_POST_PROCESS_RES_MASK_CLIP_SIZE                          1

/* Register gcregSWControlDualSBIInput **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Support Dual SBI input. */

`define gcregSWControlDualSBIInputRegAddrs                              16'h5FCE
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_MSB                                   15
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_LSB                                    0
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_BLK                                    0
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_Count                                  1
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_FieldMask                   32'h0000001F
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_ReadMask                    32'h0000001F
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_WriteMask                   32'h0000001F
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_ResetValue                  32'h00000000

/* This field is set for one input of Isp2NpuDisconnect of dual SBI input;    **
** another Isp2NpuDisconnect in gcregSWControlVXSBI0 bits 1:0  Disconnect     **
** ISP2NPU VSBI signals or not.  Value 0 connect to ISP.  Write 1 to          **
** disconnnect ISP2NPU SBI signals. and Connect to software control           **
** registers.  This step is needed before using the SBI_Wr field for software **
** control.  Value 2 connect to pattern generator.                            */
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_MSB                1
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_LSB                0
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_SIZE               2
`define   GCREG_SW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_ISP           2'h0
`define   GCREG_SW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_SOFT_CONTROL  2'h1
`define   GCREG_SW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_PATTERN_GEN   2'h2

/* Set 1 to bypass the OCM, PSI input will get data directly from producer    **
** without OCM.  This field is set for one input of OCMBypass of dual SBI     **
** input; another OCMBypass in gcregTTDMisc bits 2.                           */
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_OCM_BYPASS_MSB                         2
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_OCM_BYPASS_LSB                         2
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_OCM_BYPASS_SIZE                        1

/* This field is set for one input of Npu2IspDisconnect of dual SBI input;    **
** another Npu2IspDisconnect in gcregSWControlVXSBI0 bits 4:3  Value 0        **
** connect to ISP.  Indicate to disconnect NPU2ISP SBI signals or not.  Value **
** 1 means connect software - controlled regsiters.  This step is needed      **
** before using the SBI_rd field for software control.  Value 2 means connect **
** to checksum generator.                                                     */
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_MSB                4
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_LSB                3
`define GCREG_SW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_SIZE               2
`define   GCREG_SW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_ISP           2'h0
`define   GCREG_SW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_SOFT_CONTROL  2'h1
`define   GCREG_SW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_CHECK_SUM_GEN 2'h2

/* Register gcregPtnGenBayerImageDualSBIInput **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

