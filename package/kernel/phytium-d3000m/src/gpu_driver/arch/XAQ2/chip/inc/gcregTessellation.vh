`define GCREG_TES_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_WRAP_MSB     31
`define GCREG_TES_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_WRAP_LSB     31
