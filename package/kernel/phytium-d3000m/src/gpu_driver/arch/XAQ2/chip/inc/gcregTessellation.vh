/* Register gcregTCSAttribute **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Specifications for the TCS attribute memory. The maximum size of an entire **
** patch is 4096 components, which is 16kB. However, we do require the        **
** tessellation factors to be stored in attribute memory as well, so the      **
** final number is 16,416 bytes.                                              */

`define gcregTCSAttributeRegAddrs                                       16'h5287
`define GCREG_TCS_ATTRIBUTE_MSB                                               15
`define GCREG_TCS_ATTRIBUTE_LSB                                                0
`define GCREG_TCS_ATTRIBUTE_BLK                                                0
`define GCREG_TCS_ATTRIBUTE_Count                                              1
`define GCREG_TCS_ATTRIBUTE_FieldMask                               32'hFFF7FF3F
`define GCREG_TCS_ATTRIBUTE_ReadMask                                32'hFFF7FF3F
`define GCREG_TCS_ATTRIBUTE_WriteMask                               32'hFFF7FF3F
`define GCREG_TCS_ATTRIBUTE_ResetValue                              32'h00000000

/* Size per control point, specified in 16-byte quantities. The maximum size  **
** is 512 bytes, or a value of 32 16-byte quantities.                         */
`define GCREG_TCS_ATTRIBUTE_CONTROL_POINT_SIZE_MSB                             5
`define GCREG_TCS_ATTRIBUTE_CONTROL_POINT_SIZE_LSB                             0
`define GCREG_TCS_ATTRIBUTE_CONTROL_POINT_SIZE_SIZE                            6

/* Offset from the start of the allocated patch attribute memory to the       **
** per-patch data, specified in 16-byte quantities. The maximum offset would  **
** be 16,384 bytes, or a value of 1024 16-byte quantities. This value can be  **
** computed by multiplying the ControlPointSize by the number of output       **
** control points, rounded up to the next multiple of 4 if the data is        **
** interleaved, and rounding the final result up to the next 16-byte          **
** boundary.                                                                  */
`define GCREG_TCS_ATTRIBUTE_PER_PATCH_OFFSET_MSB                              18
`define GCREG_TCS_ATTRIBUTE_PER_PATCH_OFFSET_LSB                               8
`define GCREG_TCS_ATTRIBUTE_PER_PATCH_OFFSET_SIZE                             11

/* Size per patch, specified in 16-byte quantities. The maximum size is 16416 **
** bytes, or a value of 1026 16-byte quantities. This value can be computed   **
** by adding the per-patch size to the PerPatchOffset and rounding the result **
** up to the next 16-byte boundary.                                           */
`define GCREG_TCS_ATTRIBUTE_PATCH_SIZE_MSB                                    30
`define GCREG_TCS_ATTRIBUTE_PATCH_SIZE_LSB                                    20
`define GCREG_TCS_ATTRIBUTE_PATCH_SIZE_SIZE                                   11

/* Linear or interleaved layout for control point attributes. */
`define GCREG_TCS_ATTRIBUTE_LAYOUT_MSB                                        31
`define GCREG_TCS_ATTRIBUTE_LAYOUT_LSB                                        31
`define GCREG_TCS_ATTRIBUTE_LAYOUT_SIZE                                        1
/* The control point attributes are stored interleaved in attribute memory. */
`define   GCREG_TCS_ATTRIBUTE_LAYOUT_INTERLEAVED                            1'h0
/* The control point attributes are stored linearly in attribute memory. */
`define   GCREG_TCS_ATTRIBUTE_LAYOUT_LINEAR                                 1'h1

