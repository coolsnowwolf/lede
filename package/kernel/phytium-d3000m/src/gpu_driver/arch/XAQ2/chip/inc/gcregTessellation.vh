/* Offset of the TES texture descriptor lock. */
`define GCREG_TES_SAMPLER_LOCK_TXD_OFFSET_MSB                                 31
`define GCREG_TES_SAMPLER_LOCK_TXD_OFFSET_LSB                                 16
`define GCREG_TES_SAMPLER_LOCK_TXD_OFFSET_SIZE                                16

/* Register gcregTESThrottleEx **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Extended throttling control for the tessellation evaluation shader. */

`define gcregTESThrottleExRegAddrs                                      16'h52CD
`define GCREG_TES_THROTTLE_EX_MSB                                             15
`define GCREG_TES_THROTTLE_EX_LSB                                              0
`define GCREG_TES_THROTTLE_EX_BLK                                              0
`define GCREG_TES_THROTTLE_EX_Count                                            1
`define GCREG_TES_THROTTLE_EX_FieldMask                             32'h00003FFF
`define GCREG_TES_THROTTLE_EX_ReadMask                              32'h00003FFF
`define GCREG_TES_THROTTLE_EX_WriteMask                             32'h00003FFF
`define GCREG_TES_THROTTLE_EX_ResetValue                            32'h00000000

/* Limit the number of patches per group. */
`define GCREG_TES_THROTTLE_EX_MAX_PATCHES_MSB                                  7
`define GCREG_TES_THROTTLE_EX_MAX_PATCHES_LSB                                  0
`define GCREG_TES_THROTTLE_EX_MAX_PATCHES_SIZE                                 8

/* Limit the minimum number of 1024-byte pages in attribute memory. NOTE:     **
** Make sure the value is big enough to fit at least one group worth of data, **
** or the hardware will just hang.                                            */
`define GCREG_TES_THROTTLE_EX_MIN_PAGES_MSB                                   13
`define GCREG_TES_THROTTLE_EX_MIN_PAGES_LSB                                    8
`define GCREG_TES_THROTTLE_EX_MIN_PAGES_SIZE                                   6

/* Register gcregTESAttributeGlobalControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Memory backed attribute buffer control for TES. */

`define gcregTESAttributeGlobalControlRegAddrs                          16'h52CE
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MSB                                15
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_LSB                                 0
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_BLK                                 0
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_Count                               1
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_FieldMask                32'hFFFFF0F1
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_ReadMask                 32'hFFFFF0F1
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_WriteMask                32'hFFFFF0F1
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_ResetValue               32'h00000000

/* Attribute buffer is in memory or USC. 0: in USC, 1: in memory. */
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_ATTRIBUTE_IN_MEM_MSB                0
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_ATTRIBUTE_IN_MEM_LSB                0
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_ATTRIBUTE_IN_MEM_SIZE               1
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_ATTRIBUTE_IN_MEM_DISABLED      1'h0
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_ATTRIBUTE_IN_MEM_ENABLED       1'h1

/* Size (BYTES) of TES attribute buffer per cluster: */
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_MSB            7
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_LSB            4
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_SIZE           4
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_IS1K      4'h0
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_IS2K      4'h1
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_IS4K      4'h2
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_IS8K      4'h3
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_IS16K     4'h4
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_IS32K     4'h5
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_IS64K     4'h6
`define   GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_MEM_SIZE_PER_CLUSTER_IS128K    4'h7

/* Base of TES attribute buffer, 4KB aligned. */
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_BASE_ADDR_MSB                      31
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_BASE_ADDR_LSB                      12
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_BASE_ADDR_SIZE                     20

/* Register gcregTESAttributeGlobalControlHi **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Bits[63:32] of gcregTESAttributeGlobalControl, upper 32 bits of TES        **
** attribute buffer base address.                                             */

`define gcregTESAttributeGlobalControlHiRegAddrs                        16'h52CF
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_MSB                             15
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_LSB                              0
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_BLK                              0
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_Count                            1
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_FieldMask             32'h0000FFFF
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_ReadMask              32'h0000FFFF
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_WriteMask             32'h0000FFFF
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_ResetValue            32'h00000000

/* Base of TES attribute buffer, current only 40-bits VA is supported. */
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_BASE_ADDR_MSB                   15
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_BASE_ADDR_LSB                    0
`define GCREG_TES_ATTRIBUTE_GLOBAL_CONTROL_HI_BASE_ADDR_SIZE                  16

/* Register gcregTESInstructionHi **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Bits[63:32] of gcregTESInstruction, address of the tessellation evaluation **
** shader program.                                                            */

`define gcregTESInstructionHiRegAddrs                                   16'h52D8
`define GCREG_TES_INSTRUCTION_HI_MSB                                          15
`define GCREG_TES_INSTRUCTION_HI_LSB                                           0
`define GCREG_TES_INSTRUCTION_HI_BLK                                           0
`define GCREG_TES_INSTRUCTION_HI_Count                                         1
`define GCREG_TES_INSTRUCTION_HI_FieldMask                          32'h0000FFFF
`define GCREG_TES_INSTRUCTION_HI_ReadMask                           32'h0000FFFF
`define GCREG_TES_INSTRUCTION_HI_WriteMask                          32'h0000FFFF
`define GCREG_TES_INSTRUCTION_HI_ResetValue                         32'h00000000

/* Supports virtual addresses up to 48-bits. */
`define GCREG_TES_INSTRUCTION_HI_ADDRESS_MSB                                  15
`define GCREG_TES_INSTRUCTION_HI_ADDRESS_LSB                                   0
`define GCREG_TES_INSTRUCTION_HI_ADDRESS_SIZE                                 16

