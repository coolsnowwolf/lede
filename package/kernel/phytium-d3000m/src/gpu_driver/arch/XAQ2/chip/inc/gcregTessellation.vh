/* Register gcregTPGControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Control for fixed function tessellation primitive generator. */

`define gcregTPGControlRegAddrs                                         16'h52C0
`define GCREG_TPG_CONTROL_MSB                                                 15
`define GCREG_TPG_CONTROL_LSB                                                  0
`define GCREG_TPG_CONTROL_BLK                                                  0
`define GCREG_TPG_CONTROL_Count                                                1
`define GCREG_TPG_CONTROL_FieldMask                                 32'h17F7F333
`define GCREG_TPG_CONTROL_ReadMask                                  32'h17F7F333
`define GCREG_TPG_CONTROL_WriteMask                                 32'h17F7F333
`define GCREG_TPG_CONTROL_ResetValue                                32'h00040000

/* Tessellation primitive mode. */
`define GCREG_TPG_CONTROL_MODE_MSB                                             1
`define GCREG_TPG_CONTROL_MODE_LSB                                             0
`define GCREG_TPG_CONTROL_MODE_SIZE                                            2
/* Tessellation of triangles. */
`define   GCREG_TPG_CONTROL_MODE_TRIANGLE                                   2'h0
/* Tessellation of quads. */
`define   GCREG_TPG_CONTROL_MODE_QUAD                                       2'h1
/* Tessellation of Isolines. */
`define   GCREG_TPG_CONTROL_MODE_ISO_LINE                                   2'h2

/* Spacing mode for edge tessellation. Fractional spacing generates n-2 equal **
** length segments and two additional shorter segments. If n-fraction equals  **
** to 0, the two addition segments are the same as the other segments. If     **
** n-fraction equals to 2, there are no additional segments generated.        */
`define GCREG_TPG_CONTROL_SPACING_MSB                                          5
`define GCREG_TPG_CONTROL_SPACING_LSB                                          4
`define GCREG_TPG_CONTROL_SPACING_SIZE                                         2
/* Round up to nearest integer between 1 and 64. */
`define   GCREG_TPG_CONTROL_SPACING_EQUAL                                   2'h0
/* Round up to nearest power of two between 1 and 64. */
`define   GCREG_TPG_CONTROL_SPACING_POWER_OF_TWO                            2'h1
/* Round up to nearest odd integer between 1 and 63. */
`define   GCREG_TPG_CONTROL_SPACING_FRACTIONAL_ODD                          2'h2
/* Round up to nearest even integer between 2 and 64. */
`define   GCREG_TPG_CONTROL_SPACING_FRACTIONAL_EVEN                         2'h3

/* Output topology. */
`define GCREG_TPG_CONTROL_TOPOLOGY_MSB                                         9
`define GCREG_TPG_CONTROL_TOPOLOGY_LSB                                         8
`define GCREG_TPG_CONTROL_TOPOLOGY_SIZE                                        2
/* Each tessellated vertex is a point. */
`define   GCREG_TPG_CONTROL_TOPOLOGY_POINT                                  2'h0
/* Generate ISO lines */
`define   GCREG_TPG_CONTROL_TOPOLOGY_LINE                                   2'h1
/* Generate clock-wise triangles. */
`define   GCREG_TPG_CONTROL_TOPOLOGY_TRIANGLE_CW                            2'h2
/* Generate counter-clock-wise triangles. */
`define   GCREG_TPG_CONTROL_TOPOLOGY_TRIANGLE_CCW                           2'h3

/* Maximum tessellation factor. */
`define GCREG_TPG_CONTROL_MAX_FACTOR_MSB                                      18
`define GCREG_TPG_CONTROL_MAX_FACTOR_LSB                                      12
`define GCREG_TPG_CONTROL_MAX_FACTOR_SIZE                                      7

/* If all tessellation values are less than the given threshold, ring walking **
** will be used. Otherwise, slice walking will be used.                       */
`define GCREG_TPG_CONTROL_THRESHOLD_MSB                                       26
`define GCREG_TPG_CONTROL_THRESHOLD_LSB                                       20
`define GCREG_TPG_CONTROL_THRESHOLD_SIZE                                       7

/* Force all tessellation factors to be 1 and do the tessellation. */
`define GCREG_TPG_CONTROL_FORCE_TRIVIAL_TESSELLATION_MSB                      28
`define GCREG_TPG_CONTROL_FORCE_TRIVIAL_TESSELLATION_LSB                      28
`define GCREG_TPG_CONTROL_FORCE_TRIVIAL_TESSELLATION_SIZE                      1
`define   GCREG_TPG_CONTROL_FORCE_TRIVIAL_TESSELLATION_DISABLED             1'h0
`define   GCREG_TPG_CONTROL_FORCE_TRIVIAL_TESSELLATION_ENABLED              1'h1

