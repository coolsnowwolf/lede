`define gcregFeBinSizeRegAddrs                                          16'h6813
`define GCREG_FE_BIN_SIZE_MSB                                                 15
`define GCREG_FE_BIN_SIZE_LSB                                                  0
`define GCREG_FE_BIN_SIZE_BLK                                                  0
`define GCREG_FE_BIN_SIZE_Count                                                1
`define GCREG_FE_BIN_SIZE_FieldMask                                 32'hFFFFFFFF
`define GCREG_FE_BIN_SIZE_ReadMask                                  32'hFFFFFFFF
`define GCREG_FE_BIN_SIZE_WriteMask                                 32'hFFFFFFFF
`define GCREG_FE_BIN_SIZE_ResetValue                                32'h00000000

/* Max size of the binning data structure per MP head in bytes. */
`define GCREG_FE_BIN_SIZE_SIZE_MSB                                            31
`define GCREG_FE_BIN_SIZE_SIZE_LSB                                             0
`define GCREG_FE_BIN_SIZE_SIZE_SIZE                                           32

/*******************************************************************************
**                             ~~~~~~~~~~~~~~~~~~~                            **
**                             Command AttriFormat                            **
**                             ~~~~~~~~~~~~~~~~~~~                            **
*******************************************************************************/

/* Offset AttriFormat
** ~~~~~~~~~~~~~~~~~~ */

/* Format for each attribute. */
`define ATTRI_FORMAT_ATTRI_FORMAT_MSB                                          4
`define ATTRI_FORMAT_ATTRI_FORMAT_LSB                                          0
`define ATTRI_FORMAT_ATTRI_FORMAT_SIZE                                         5
/* 8-bit signed integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_BYTE                                   5'h00
/* 8-bit unsigned integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_UBYTE                                  5'h01
/* 16-bit signed integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_SHORT                                  5'h02
/* 16-bit unsigned integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_USHORT                                 5'h03
/* 32-bit signed integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_INT                                    5'h04
/* 32-bit unsigned integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_UINT                                   5'h05
/* Packed signed 10-bit integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_DEC                                    5'h06
/* Packed unsigned 10-bit integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_UDEC                                   5'h07
/* 32-bit floating point. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_FLOAT                                  5'h08
/* 16-bit floating point. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_FLOAT16                                5'h09
`define   ATTRI_FORMAT_ATTRI_FORMAT_COLOR                                  5'h0A
/* 16.16 fixed point. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_FIXED16_DOT16                          5'h0B
/* Packed signed 10-bit integer in reverse order. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_GL_INT_10_10_10_2                      5'h0C
/* Unpacked signed 10-bit integer in reverse order. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_GL_UINT_10_10_10_2                     5'h0D
/* Sign-extended 8-bit integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_INT8                                   5'h0E
/* Sign-extended 16-bit integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_INT16                                  5'h0F
/* Shadow copy for 32-bit integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_INT32                                  5'h08
/* true support 32-bit integer. */
`define   ATTRI_FORMAT_ATTRI_FORMAT_TRUE_INT32                             5'h10
/* D3D11 FORMAT R11G11B10_FLOAT */
`define   ATTRI_FORMAT_ATTRI_FORMAT_R11G11B10_UFLOAT                       5'h11

