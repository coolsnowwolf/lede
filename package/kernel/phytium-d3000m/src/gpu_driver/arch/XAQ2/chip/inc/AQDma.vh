/* Register gcregFEAttribute (32 in total) **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Definition for 32 attributes. */

`define gcregFEAttributeRegAddrs                                         11'h2F0
`define GCREG_FE_ATTRIBUTE_MSB                                                15
`define GCREG_FE_ATTRIBUTE_LSB                                                 5
`define GCREG_FE_ATTRIBUTE_BLK                                                 0
`define GCREG_FE_ATTRIBUTE_Count                                              32
`define GCREG_FE_ATTRIBUTE_FieldMask                                32'hFFFFFFFF
`define GCREG_FE_ATTRIBUTE_ReadMask                                 32'hFFFFFFFF
`define GCREG_FE_ATTRIBUTE_WriteMask                                32'hFFFFFFFF
`define GCREG_FE_ATTRIBUTE_ResetValue                               32'h00000000

/* Format for each attribute. */
`define GCREG_FE_ATTRIBUTE_FORMAT_MSB                                          3
`define GCREG_FE_ATTRIBUTE_FORMAT_LSB                                          0
`define GCREG_FE_ATTRIBUTE_FORMAT_SIZE                                         4
/* 8-bit signed integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_BYTE                                    4'h0
/* 8-bit unsigned integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_UBYTE                                   4'h1
/* 16-bit signed integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_SHORT                                   4'h2
/* 16-bit unsigned integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_USHORT                                  4'h3
/* 32-bit signed integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_INT                                     4'h4
/* 32-bit unsigned integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_UINT                                    4'h5
/* Packed signed 10-bit integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_DEC                                     4'h6
/* Packed unsigned 10-bit integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_UDEC                                    4'h7
/* 32-bit floating point. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_FLOAT                                   4'h8
/* 16-bit floating point. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_FLOAT16                                 4'h9
`define   GCREG_FE_ATTRIBUTE_FORMAT_COLOR                                   4'hA
/* 16.16 fixed point. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_FIXED16_DOT16                           4'hB
/* Packed signed 10-bit integer in reverse order. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_GL_INT_10_10_10_2                       4'hC
/* Unpacked signed 10-bit integer in reverse order. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_GL_UINT_10_10_10_2                      4'hD
/* Sign-extended 8-bit integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_INT8                                    4'hE
/* Sign-extended 16-bit integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_INT16                                   4'hF
/* Shadow copy for 32-bit integer. */
`define   GCREG_FE_ATTRIBUTE_FORMAT_INT32                                   4'h8

/* Control endian swapping. */
`define GCREG_FE_ATTRIBUTE_ENDIAN_CONTROL_MSB                                  5
`define GCREG_FE_ATTRIBUTE_ENDIAN_CONTROL_LSB                                  4
`define GCREG_FE_ATTRIBUTE_ENDIAN_CONTROL_SIZE                                 2
/* No swapping. */
`define   GCREG_FE_ATTRIBUTE_ENDIAN_CONTROL_NO_SWAP                         2'h0
/* Swap at 16-bit boundary: 0123->1032. */
`define   GCREG_FE_ATTRIBUTE_ENDIAN_CONTROL_SWAP_WORD                       2'h1
/* Swap at 32-bit boundary: 0123->3210. */
`define   GCREG_FE_ATTRIBUTE_ENDIAN_CONTROL_SWAP_DWORD                      2'h2
/* Swap at 64-bit boundary: 01234567->76543210. */
`define   GCREG_FE_ATTRIBUTE_ENDIAN_CONTROL_SWAP_DDWORD                     2'h3

/* The entire attribute is generic - it is missing from the stream, but the   **
** Vertex Shader expects it.                                                  */
`define GCREG_FE_ATTRIBUTE_GENERIC_MSB                                         6
`define GCREG_FE_ATTRIBUTE_GENERIC_LSB                                         6
`define GCREG_FE_ATTRIBUTE_GENERIC_SIZE                                        1
`define   GCREG_FE_ATTRIBUTE_GENERIC_DISABLE                                1'h0
`define   GCREG_FE_ATTRIBUTE_GENERIC_ENABLE                                 1'h1

/* the format bit4. command AttriFormat define */
`define GCREG_FE_ATTRIBUTE_FORMAT_BIT4_MSB                                     7
`define GCREG_FE_ATTRIBUTE_FORMAT_BIT4_LSB                                     7
`define GCREG_FE_ATTRIBUTE_FORMAT_BIT4_SIZE                                    1

/* Indicating the stream number the element is associated with. */
`define GCREG_FE_ATTRIBUTE_STREAM_ID_MSB                                      11
`define GCREG_FE_ATTRIBUTE_STREAM_ID_LSB                                       8
`define GCREG_FE_ATTRIBUTE_STREAM_ID_SIZE                                      4

`define GCREG_FE_ATTRIBUTE_SIZE_MSB                                           13
`define GCREG_FE_ATTRIBUTE_SIZE_LSB                                           12
`define GCREG_FE_ATTRIBUTE_SIZE_SIZE                                           2
/* One component. */
`define   GCREG_FE_ATTRIBUTE_SIZE_ONE                                       2'h1
/* Two components. */
`define   GCREG_FE_ATTRIBUTE_SIZE_TWO                                       2'h2
/* Three components. */
`define   GCREG_FE_ATTRIBUTE_SIZE_THREE                                     2'h3
/* Four components. */
`define   GCREG_FE_ATTRIBUTE_SIZE_FOUR                                      2'h0

`define GCREG_FE_ATTRIBUTE_NORMALIZE_MSB                                      15
`define GCREG_FE_ATTRIBUTE_NORMALIZE_LSB                                      14
`define GCREG_FE_ATTRIBUTE_NORMALIZE_SIZE                                      2
/* No normalization. */
`define   GCREG_FE_ATTRIBUTE_NORMALIZE_DISABLE                              2'h0
/* D3D-like normalization. */
`define   GCREG_FE_ATTRIBUTE_NORMALIZE_D3D                                  2'h1
/* OpenGL-like normalization. */
`define   GCREG_FE_ATTRIBUTE_NORMALIZE_OPEN_GL                              2'h2

/* Offset into the vertex stream for the element. */
`define GCREG_FE_ATTRIBUTE_OFFSET_MSB                                         31
`define GCREG_FE_ATTRIBUTE_OFFSET_LSB                                         16
`define GCREG_FE_ATTRIBUTE_OFFSET_SIZE                                        16

