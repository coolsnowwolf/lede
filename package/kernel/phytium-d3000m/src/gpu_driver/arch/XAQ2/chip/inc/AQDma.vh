/* Register AQCmdBufferAddr **
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Command Buffer Address Register.  Base address for the command buffer. The **
** address must be 64-byte aligned.  Before MMU is enabled, the register is   **
** set with a physical address.  After MMU is enabled, the register is set    **
** with a virtual address  which is translated through the MMU to get the     **
** corresponding  physical addresses to access memory over AXI.  You can      **
** write all bits (the virtual bit is legacy).  This register cannot be read. **
**  To check the value of the current fetch  address use AQFEDebugCurCmdAdr.  **
** This WRITE ONLY  register has no set reset value.                          */

`define AQCmdBufferAddrRegAddrs                                         16'h0195
`define AQ_CMD_BUFFER_ADDR_MSB                                                15
`define AQ_CMD_BUFFER_ADDR_LSB                                                 0
`define AQ_CMD_BUFFER_ADDR_BLK                                                 0
