`define AQ_CMD_BUFFER_ADDR_FieldMask                                32'hFFFFFFFF
`define AQ_CMD_BUFFER_ADDR_ReadMask                                 32'h00000000
`define AQ_CMD_BUFFER_ADDR_WriteMask                                32'hFFFFFFFC
`define AQ_CMD_BUFFER_ADDR_ResetValue                               32'h00000000

/* Lower 31 bits of address. */
`define AQ_CMD_BUFFER_ADDR_ADDRESS_MSB                                        30
`define AQ_CMD_BUFFER_ADDR_ADDRESS_LSB                                         0
`define AQ_CMD_BUFFER_ADDR_ADDRESS_SIZE                                       31

/* When MMU2 is present - you can write all bits of this register. */
`define AQ_CMD_BUFFER_ADDR_TYPE_MSB                                           31
`define AQ_CMD_BUFFER_ADDR_TYPE_LSB                                           31
`define AQ_CMD_BUFFER_ADDR_TYPE_SIZE                                           1
`define   AQ_CMD_BUFFER_ADDR_TYPE_SYSTEM                                    1'h0
`define   AQ_CMD_BUFFER_ADDR_TYPE_VIRTUAL_SYSTEM                            1'h1

