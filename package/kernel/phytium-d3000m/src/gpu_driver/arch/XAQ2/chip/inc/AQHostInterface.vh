/* Register GCChipId **
** ~~~~~~~~~~~~~~~~~ */

/* Chip Identification Register.  Shows the ID for the chip in BCD.  This     **
** READ ONLY register has no set reset value.  It varies with the             **
** implementation.                                                            */

`define GCChipIdRegAddrs                                                16'h0008
`define GC_CHIP_ID_MSB                                                        15
`define GC_CHIP_ID_LSB                                                         0
`define GC_CHIP_ID_BLK                                                         0
`define GC_CHIP_ID_Count                                                       1
`define GC_CHIP_ID_FieldMask                                        32'hFFFFFFFF
`define GC_CHIP_ID_ReadMask                                         32'hFFFFFFFF
`define GC_CHIP_ID_WriteMask                                        32'h00000000
`define GC_CHIP_ID_ResetValue                                       32'h00000000

/* Id. */
`define GC_CHIP_ID_ID_MSB                                                     31
`define GC_CHIP_ID_ID_LSB                                                      0
`define GC_CHIP_ID_ID_SIZE                                                    32

/* Register GCChipRev **
** ~~~~~~~~~~~~~~~~~~ */

/* Chip Revision Register.  Shows the revision for the chip in BCD.  This     **
** READ ONLY register has no set reset value.  It varies with the             **
** implementation.                                                            */

`define GCChipRevRegAddrs                                               16'h0009
`define GC_CHIP_REV_MSB                                                       15
`define GC_CHIP_REV_LSB                                                        0
`define GC_CHIP_REV_BLK                                                        0
`define GC_CHIP_REV_Count                                                      1
`define GC_CHIP_REV_FieldMask                                       32'hFFFFFFFF
`define GC_CHIP_REV_ReadMask                                        32'hFFFFFFFF
`define GC_CHIP_REV_WriteMask                                       32'h00000000
`define GC_CHIP_REV_ResetValue                                      32'h00000000

/* Revision. This value may vary between releases and can be ignored during   **
** test.                                                                      */
`define GC_CHIP_REV_REV_MSB                                                   31
`define GC_CHIP_REV_REV_LSB                                                    0
`define GC_CHIP_REV_REV_SIZE                                                  32

