/* Register gcTotalCycles **
** ~~~~~~~~~~~~~~~~~~~~~~ */

/* Total Cycles Register. Total cycles. This register is a free running       **
** counter.  It can be reset by writing 0 to it.                              */

`define gcTotalCyclesRegAddrs                                           16'h001E
`define GC_TOTAL_CYCLES_MSB                                                   15
`define GC_TOTAL_CYCLES_LSB                                                    0
`define GC_TOTAL_CYCLES_BLK                                                    0
`define GC_TOTAL_CYCLES_Count                                                  1
`define GC_TOTAL_CYCLES_FieldMask                                   32'hFFFFFFFF
`define GC_TOTAL_CYCLES_ReadMask                                    32'hFFFFFFFF
`define GC_TOTAL_CYCLES_WriteMask                                   32'hFFFFFFFF
`define GC_TOTAL_CYCLES_ResetValue                                  32'h00000000

/* Total cycles. */
`define GC_TOTAL_CYCLES_CYCLES_MSB                                            31
`define GC_TOTAL_CYCLES_CYCLES_LSB                                             0
`define GC_TOTAL_CYCLES_CYCLES_SIZE                                           32

/* Register gcTotalIdleCycles **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Total Idle Cycles Register. Total cycles where the GPU is idle. It is      **
** reset when  gcTotalCycles register is written to. It looks at all the      **
** blocks but FE when determining the IP is idle.                             */

`define gcTotalIdleCyclesRegAddrs                                       16'h001F
`define GC_TOTAL_IDLE_CYCLES_MSB                                              15
`define GC_TOTAL_IDLE_CYCLES_LSB                                               0
`define GC_TOTAL_IDLE_CYCLES_BLK                                               0
`define GC_TOTAL_IDLE_CYCLES_Count                                             1
`define GC_TOTAL_IDLE_CYCLES_FieldMask                              32'hFFFFFFFF
`define GC_TOTAL_IDLE_CYCLES_ReadMask                               32'hFFFFFFFF
`define GC_TOTAL_IDLE_CYCLES_WriteMask                              32'hFFFFFFFF
`define GC_TOTAL_IDLE_CYCLES_ResetValue                             32'h00000000

/* Total idle cycles. */
`define GC_TOTAL_IDLE_CYCLES_CYCLES_MSB                                       31
`define GC_TOTAL_IDLE_CYCLES_CYCLES_LSB                                        0
`define GC_TOTAL_IDLE_CYCLES_CYCLES_SIZE                                      32

