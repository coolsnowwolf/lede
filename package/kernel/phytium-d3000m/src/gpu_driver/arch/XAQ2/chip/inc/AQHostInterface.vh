`define   GC_AXI_CONTROL_SPLIT_SIZE_BYTE64                                  3'h1
`define   GC_AXI_CONTROL_SPLIT_SIZE_BYTE128                                 3'h2
`define   GC_AXI_CONTROL_SPLIT_SIZE_BYTE256                                 3'h3
`define   GC_AXI_CONTROL_SPLIT_SIZE_BYTE512                                 3'h4
`define   GC_AXI_CONTROL_SPLIT_SIZE_BYTE1024                                3'h5
`define   GC_AXI_CONTROL_SPLIT_SIZE_BUS0                                    3'h6
`define   GC_AXI_CONTROL_SPLIT_SIZE_BUS1                                    3'h7

/* Disable FE Split Requests. */
