/* Register AQIntrAcknowledge **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Interrupt Acknowledge Register.  Each bit represents a  corresponding      **
** event being triggered.  Reading from this  register clears the outstanding **
** interrupt.  READ ONLY.                                                     */

`define AQIntrAcknowledgeRegAddrs                                       16'h0004
`define AQ_INTR_ACKNOWLEDGE_MSB                                               15
`define AQ_INTR_ACKNOWLEDGE_LSB                                                0
