`define GCREG_HI_CHIP_PATCH_REV_WriteMask                           32'h00000000
`define GCREG_HI_CHIP_PATCH_REV_ResetValue                          32'h00000000

/* This value will vary each release and can be ignored during test.  */
`define GCREG_HI_CHIP_PATCH_REV_PATCH_REV_MSB                                  7
`define GCREG_HI_CHIP_PATCH_REV_PATCH_REV_LSB                                  0
`define GCREG_HI_CHIP_PATCH_REV_PATCH_REV_SIZE                                 8

