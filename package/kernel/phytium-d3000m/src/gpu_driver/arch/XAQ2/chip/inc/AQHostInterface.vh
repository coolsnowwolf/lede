**  It varies with the implementation.                                        */

`define GCChipDateRegAddrs                                              16'h000A
`define GC_CHIP_DATE_MSB                                                      15
`define GC_CHIP_DATE_LSB                                                       0
`define GC_CHIP_DATE_BLK                                                       0
`define GC_CHIP_DATE_Count                                                     1
