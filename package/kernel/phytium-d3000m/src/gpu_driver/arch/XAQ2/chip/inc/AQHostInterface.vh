/* 2 AXI split size. 0: disable split 1: bit6 of address used to appoint      **
** which bus use 2: bit7 of address used to appoint which bus use 3: bit8 of  **
** address used to appoint which bus use 4: bit9 of address used to appoint   **
** which bus use 5: bit10 of address used to appoint which bus use 6: always  **
** use BUS0, reset value is 6 7: always use BUS1                              */
`define GC_AXI_CONTROL_SPLIT_SIZE_MSB                                          3
`define GC_AXI_CONTROL_SPLIT_SIZE_LSB                                          1
`define GC_AXI_CONTROL_SPLIT_SIZE_SIZE                                         3
