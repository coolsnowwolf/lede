/* Register gcProductId **
** ~~~~~~~~~~~~~~~~~~~~ */

/* Product ID Register.  Shows Product ID. READ ONLY.  */

`define gcProductIdRegAddrs                                             16'h002A
`define GC_PRODUCT_ID_MSB                                                     15
`define GC_PRODUCT_ID_LSB                                                      0
`define GC_PRODUCT_ID_BLK                                                      0
`define GC_PRODUCT_ID_Count                                                    1
`define GC_PRODUCT_ID_FieldMask                                     32'hFFFFFFFF
`define GC_PRODUCT_ID_ReadMask                                      32'hFFFFFFFF
`define GC_PRODUCT_ID_WriteMask                                     32'h00000000
`define GC_PRODUCT_ID_ResetValue                                    32'h00000000

/* 0:None-no extra letter on the product name  1:N-Nano  2:L-Lite  3:UL-Ultra **
** Lite  4:If TYPE = 8, core is VIP*Pico.  5:NU-Nano Ultra  6:NL-Nano Lite    **
** 7:NU3-Nano Ultra3  8:XSVX  9:NU2(NanoUltra2)  B:LXSVX(Lite with TS/GS +    **
** Vision)  C:ULXS(UltraLite with TS/GS)  D:VX(Vision, no TS/GS)  E:LVX(Lite  **
** with Vision)  F:ULVX(UntraLite with Vision)  If TYPE=5(VIP),bit 3          **
** indicates float support: 0 = Float is supported; 1= Float is not           **
** supported.  This value varies per product variant. Its reset value can be  **
** ignored during test.                                                       */
`define GC_PRODUCT_ID_GRADE_LEVEL_MSB                                          3
`define GC_PRODUCT_ID_GRADE_LEVEL_LSB                                          0
`define GC_PRODUCT_ID_GRADE_LEVEL_SIZE                                         4

/* Product Number. This value varies per product. Its reset value can be      **
** ignored during test.                                                       */
`define GC_PRODUCT_ID_NUM_MSB                                                 23
`define GC_PRODUCT_ID_NUM_LSB                                                  4
`define GC_PRODUCT_ID_NUM_SIZE                                                20

/* 0:GC (GCOCORE 3D and 2D+3D Graphic Cores) 1:DEC (Decode/Encode engine)     **
** 2:DC (Dosplay Controller) 3:VG (Vector Graphics) 4:SC (Scalar Graphics)    **
** 5:VIP (Vision Image Processor: OpenVX/VIP only core) 6:CC (Compute Core:   **
** OpenCL, no Vision, no 3D) 7:GC GCCORE 2D only 8: Low Power Vision/AI;  9:  **
** CYP (Cypher Processor);  A: GC+AI, 3D plus VIP/AI).                        */
`define GC_PRODUCT_ID_TYPE_MSB                                                27
`define GC_PRODUCT_ID_TYPE_LSB                                                24
`define GC_PRODUCT_ID_TYPE_SIZE                                                4

/* If Type is 2 (DC), 1: Ultra If TYPE=0, 1: NanoUltra31.  */
`define GC_PRODUCT_ID_AUX_MSB                                                 31
`define GC_PRODUCT_ID_AUX_LSB                                                 28
`define GC_PRODUCT_ID_AUX_SIZE                                                 4

