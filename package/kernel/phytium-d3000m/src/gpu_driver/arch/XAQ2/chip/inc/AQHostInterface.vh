`define AQ_INTR_ACKNOWLEDGE_ReadMask                                32'hFFFFFFFF
`define AQ_INTR_ACKNOWLEDGE_WriteMask                               32'h00000000
`define AQ_INTR_ACKNOWLEDGE_ResetValue                              32'h00000000

/* for each interrupt event, 0=Clear, 1=InterruptActive Bit 31 is             **
** AXI_BUS_ERROR interrupt.                                                   */
`define AQ_INTR_ACKNOWLEDGE_INTR_VEC_MSB                                      31
`define AQ_INTR_ACKNOWLEDGE_INTR_VEC_LSB                                       0
`define AQ_INTR_ACKNOWLEDGE_INTR_VEC_SIZE                                     32

