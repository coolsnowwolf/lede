`define GCREG_AHB_INTR_STATUS_VIP_PARITY_MSB                                   0
`define GCREG_AHB_INTR_STATUS_VIP_PARITY_LSB                                   0
`define GCREG_AHB_INTR_STATUS_VIP_PARITY_SIZE                                  1

/* AHB register for FP8 format support on VIP V9.2.1 feature.  NN output      **
** check NaN or INF interrupt register.  Set by the happening of Output error **
** & NNOutputNanInfDetected IntrEnbl is 1. Automatically cleared after        **
** reading when the read value is 1. 0: output NaN/INF not detected; 1:       **
** output NaN/INF detected.                                                   */
`define GCREG_AHB_INTR_STATUS_NAN_INF_DETECTED_MSB                             1
`define GCREG_AHB_INTR_STATUS_NAN_INF_DETECTED_LSB                             1
