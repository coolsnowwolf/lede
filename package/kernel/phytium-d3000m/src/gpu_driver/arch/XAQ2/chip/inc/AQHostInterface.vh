/* Register AQHiClockControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Clock Control Register.  This register provides basic controls for  clock  **
** enable, frequency scaling value and core isolation.                        */

`define AQHiClockControlRegAddrs                                        16'h0000
`define AQ_HI_CLOCK_CONTROL_MSB                                               15
`define AQ_HI_CLOCK_CONTROL_LSB                                                0
`define AQ_HI_CLOCK_CONTROL_BLK                                                0
`define AQ_HI_CLOCK_CONTROL_Count                                              1
`define AQ_HI_CLOCK_CONTROL_FieldMask                               32'h3FFF7FFF
`define AQ_HI_CLOCK_CONTROL_ReadMask                                32'h3FFF7FFF
`define AQ_HI_CLOCK_CONTROL_WriteMask                               32'h3FF87FFF
`define AQ_HI_CLOCK_CONTROL_ResetValue                              32'h00070900

/* Disable 3D clock. Software core clock disable signal  for 3d modules       **
** (clk_3d). When set to 1, this clock  is frozen.                            */
`define AQ_HI_CLOCK_CONTROL_CLK3D_DIS_MSB                                      0
`define AQ_HI_CLOCK_CONTROL_CLK3D_DIS_LSB                                      0
`define AQ_HI_CLOCK_CONTROL_CLK3D_DIS_SIZE                                     1

/* Disable 2D clock.  Software clock disable signal. Both bits  CLK3D_DIS and **
** CLK2D_DIS should be controlled by software.  The AXI interface clock is    **
** the only block not stalled  at this point.                                 */
`define AQ_HI_CLOCK_CONTROL_CLK2D_DIS_MSB                                      1
`define AQ_HI_CLOCK_CONTROL_CLK2D_DIS_LSB                                      1
`define AQ_HI_CLOCK_CONTROL_CLK2D_DIS_SIZE                                     1

/* Core clock frequency scale value.(reset=1) */
`define AQ_HI_CLOCK_CONTROL_FSCALE_VAL_MSB                                     8
`define AQ_HI_CLOCK_CONTROL_FSCALE_VAL_LSB                                     2
`define AQ_HI_CLOCK_CONTROL_FSCALE_VAL_SIZE                                    7

/* Core clock frequency scale value enable.  When writing a 1 to this bit, it **
**  updates the frequency scale factor with the value  FSCALE_VAL[6:0]. The   **
** bit must be set back to 0 after  that. If this bit is set and FSCALE_VAL=0 **
** (an invalid  combination), the HREADYOUT output signal will get stuck  to  **
** 0.                                                                         */
`define AQ_HI_CLOCK_CONTROL_FSCALE_CMD_LOAD_MSB                                9
`define AQ_HI_CLOCK_CONTROL_FSCALE_CMD_LOAD_LSB                                9
`define AQ_HI_CLOCK_CONTROL_FSCALE_CMD_LOAD_SIZE                               1

/* Disables clock gating for rams. */
`define AQ_HI_CLOCK_CONTROL_DISABLE_RAM_CLOCK_GATING_MSB                      10
`define AQ_HI_CLOCK_CONTROL_DISABLE_RAM_CLOCK_GATING_LSB                      10
`define AQ_HI_CLOCK_CONTROL_DISABLE_RAM_CLOCK_GATING_SIZE                      1

/* Disable debug registers. If this bit is 1, debug  registers are clock      **
** gated.(reset=1) For cores from v620x, this field is obsolete.  Use         **
** gcregHiAHBControl[1]DEBUG_MODE instead.                                    */
`define AQ_HI_CLOCK_CONTROL_DISABLE_DEBUG_REGISTERS_MSB                       11
`define AQ_HI_CLOCK_CONTROL_DISABLE_DEBUG_REGISTERS_LSB                       11
`define AQ_HI_CLOCK_CONTROL_DISABLE_DEBUG_REGISTERS_SIZE                       1

/* Soft resets the IP. For cores from v620x, this field is obsolete. Use      **
** gcregHiAHBControl[0]SOFT_RESET instead.                                    */
`define AQ_HI_CLOCK_CONTROL_SOFT_RESET_MSB                                    12
`define AQ_HI_CLOCK_CONTROL_SOFT_RESET_LSB                                    12
`define AQ_HI_CLOCK_CONTROL_SOFT_RESET_SIZE                                    1

/* Disables ram power optimization. */
`define AQ_HI_CLOCK_CONTROL_DISABLE_RAM_POWER_OPTIMIZATION_MSB                13
`define AQ_HI_CLOCK_CONTROL_DISABLE_RAM_POWER_OPTIMIZATION_LSB                13
`define AQ_HI_CLOCK_CONTROL_DISABLE_RAM_POWER_OPTIMIZATION_SIZE                1

/* Disables core speed up during AHB access. */
`define AQ_HI_CLOCK_CONTROL_DISABLE_CORE_SPEED_UP_MSB                         14
`define AQ_HI_CLOCK_CONTROL_DISABLE_CORE_SPEED_UP_LSB                         14
`define AQ_HI_CLOCK_CONTROL_DISABLE_CORE_SPEED_UP_SIZE                         1

/* 3D pipe is idle or not present. */
`define AQ_HI_CLOCK_CONTROL_IDLE3_D_MSB                                       16
`define AQ_HI_CLOCK_CONTROL_IDLE3_D_LSB                                       16
`define AQ_HI_CLOCK_CONTROL_IDLE3_D_SIZE                                       1

/* 2D pipe is idle or not present. */
`define AQ_HI_CLOCK_CONTROL_IDLE2_D_MSB                                       17
`define AQ_HI_CLOCK_CONTROL_IDLE2_D_LSB                                       17
`define AQ_HI_CLOCK_CONTROL_IDLE2_D_SIZE                                       1

/* VG pipe is idle or not present. */
`define AQ_HI_CLOCK_CONTROL_IDLE_VG_MSB                                       18
`define AQ_HI_CLOCK_CONTROL_IDLE_VG_LSB                                       18
`define AQ_HI_CLOCK_CONTROL_IDLE_VG_SIZE                                       1

/* Isolate GPU bit. Used for power on/off, isolation  only for multi-core     **
** GPUs.                                                                      */
`define AQ_HI_CLOCK_CONTROL_ISOLATE_GPU_MSB                                   19
`define AQ_HI_CLOCK_CONTROL_ISOLATE_GPU_LSB                                   19
`define AQ_HI_CLOCK_CONTROL_ISOLATE_GPU_SIZE                                   1

/* Determines which HI/MC to use while reading registers.  For CC+TC and      **
** CC,TC use differnet register instance,  Value 0~7 means CC, value 8~15     **
** means TC.                                                                  */
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_REG_SELECT_MSB                         23
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_REG_SELECT_LSB                         20
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_REG_SELECT_SIZE                         4

/* Force all the transactions to go to one AXI.  */
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_USE_SINGLE_AXI_MSB                     27
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_USE_SINGLE_AXI_LSB                     24
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_USE_SINGLE_AXI_SIZE                     4

/* Soft resets the L2. */
`define AQ_HI_CLOCK_CONTROL_SOFT_RESET_L2_MSB                                 28
`define AQ_HI_CLOCK_CONTROL_SOFT_RESET_L2_LSB                                 28
`define AQ_HI_CLOCK_CONTROL_SOFT_RESET_L2_SIZE                                 1

/* One cluster has one copy of AHB register untill adding TC. When this bit   **
** set to 1, will do select write. The Register selceted  Refer to field      **
** multiPipeRegSelect. When set to 0, do broadcast write.  Write Register     **
** will broad cast to all Register instance.                                  */
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_REG_WR_SELECT_MSB                      29
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_REG_WR_SELECT_LSB                      29
`define AQ_HI_CLOCK_CONTROL_MULTI_PIPE_REG_WR_SELECT_SIZE                      1

