`define GC_CHIP_DATE_DATE_MSB                                                 31
`define GC_CHIP_DATE_DATE_LSB                                                  0
`define GC_CHIP_DATE_DATE_SIZE                                                32

/* Register GCChipTime **
** ~~~~~~~~~~~~~~~~~~~ */

/* Chip Time Register.  Shows the release time for the IP.  This register has **
