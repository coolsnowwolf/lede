/* Register gcregQueryStatus **
** ~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Register for debugging FPGA */

`define gcregQueryStatusRegAddrs                                        16'h11E3
`define GCREG_QUERY_STATUS_MSB                                                15
`define GCREG_QUERY_STATUS_LSB                                                 0
`define GCREG_QUERY_STATUS_BLK                                                 0
