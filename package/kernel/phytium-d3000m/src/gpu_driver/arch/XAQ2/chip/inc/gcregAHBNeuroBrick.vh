`define GCREG_QUERY_STATUS_WriteMask                                32'h00010FFF
`define GCREG_QUERY_STATUS_ResetValue                               32'h00000000

/* Write only. 0: Frame done. Query if hardware finish one frame, if status   **
** is 1, software can read data. 1: Busy Status of one layer with LayerID     **
** defined in bits[9:0]. 2,3 reserved not used.                               */
`define GCREG_QUERY_STATUS_QUERY_TYPE_MSB                                      1
`define GCREG_QUERY_STATUS_QUERY_TYPE_LSB                                      0
`define GCREG_QUERY_STATUS_QUERY_TYPE_SIZE                                     2

/* Write only, LayerID of layed want to process, from 0, max support 1024     **
** layers. When QueryType is Frame Done, LayerID not used.                    */
`define GCREG_QUERY_STATUS_LAYER_ID_MSB                                       11
`define GCREG_QUERY_STATUS_LAYER_ID_LSB                                        2
`define GCREG_QUERY_STATUS_LAYER_ID_SIZE                                      10

/* Value 1: Frame done if QueryType 0. Layed(with LayerID) is busy. Value 0: */
`define GCREG_QUERY_STATUS_STATUS_MSB                                         16
`define GCREG_QUERY_STATUS_STATUS_LSB                                         16
`define GCREG_QUERY_STATUS_STATUS_SIZE                                         1

