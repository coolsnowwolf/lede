`define AQ_VERTEX_ELEMENT_CONFIG_GEOMETRY_CACHE_LSB                            8
`define AQ_VERTEX_ELEMENT_CONFIG_GEOMETRY_CACHE_SIZE                           1
/* Use VSOutputBuffer field to determine the number of cached vertices. */
`define   AQ_VERTEX_ELEMENT_CONFIG_GEOMETRY_CACHE_DISABLE                   1'h0
/* Override the VSOutputBuffer field and use 64 vertices between FE and GS.   **
** PA still stays at whatever VSOutputBuffer is set to.                       */
