`define   AQ_VERTEX_ELEMENT_CONFIG_CACHE_DISABLE_ENABLED                    1'h0
`define   AQ_VERTEX_ELEMENT_CONFIG_CACHE_DISABLE_DISABLED                   1'h1

/* Program for 64-vertex attribute cache for Geometry Shader. */
