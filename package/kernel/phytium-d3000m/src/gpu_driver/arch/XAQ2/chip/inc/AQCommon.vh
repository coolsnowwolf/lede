/* Register gcregWindowControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* L2 window control. */

`define gcregWindowControlRegAddrs                                      16'h0E0F
`define GCREG_WINDOW_CONTROL_MSB                                              15
`define GCREG_WINDOW_CONTROL_LSB                                               0
`define GCREG_WINDOW_CONTROL_BLK                                               0
`define GCREG_WINDOW_CONTROL_Count                                             1
`define GCREG_WINDOW_CONTROL_FieldMask                              32'h00000333
`define GCREG_WINDOW_CONTROL_ReadMask                               32'h00000333
`define GCREG_WINDOW_CONTROL_WriteMask                              32'h00000333
`define GCREG_WINDOW_CONTROL_ResetValue                             32'h00000000

/* Enable L2 windowing for color.  All addresses will be offsets into the L2  **
** cache for reading/writing.  Only the resolve will actually write to DDR    **
** memory.                                                                    */
`define GCREG_WINDOW_CONTROL_COLOR_MSB                                         1
`define GCREG_WINDOW_CONTROL_COLOR_LSB                                         0
`define GCREG_WINDOW_CONTROL_COLOR_SIZE                                        2
`define   GCREG_WINDOW_CONTROL_COLOR_DISABLE                                2'h0
`define   GCREG_WINDOW_CONTROL_COLOR_INTERNAL                               2'h1
`define   GCREG_WINDOW_CONTROL_COLOR_EXTERNAL                               2'h2

/* Enable L2 windowing for depth.  All addresses will be offsets into the L2  **
** cache for reading/writing.                                                 */
`define GCREG_WINDOW_CONTROL_DEPTH_MSB                                         5
`define GCREG_WINDOW_CONTROL_DEPTH_LSB                                         4
`define GCREG_WINDOW_CONTROL_DEPTH_SIZE                                        2
`define   GCREG_WINDOW_CONTROL_DEPTH_DISABLE                                2'h0
`define   GCREG_WINDOW_CONTROL_DEPTH_INTERNAL                               2'h1
`define   GCREG_WINDOW_CONTROL_DEPTH_EXTERNAL                               2'h2

/* Enable L2 windowing for vertex and index streams.  The L2 cache will read  **
** data until the cache is full, after which it will just fetch the data from **
** DDR.  The cashe needs to be invalidated when a new frame starts (after all **
** windows have been processed for the current render buffer).                */
`define GCREG_WINDOW_CONTROL_STREAMS_MSB                                       9
`define GCREG_WINDOW_CONTROL_STREAMS_LSB                                       8
`define GCREG_WINDOW_CONTROL_STREAMS_SIZE                                      2
`define   GCREG_WINDOW_CONTROL_STREAMS_DISABLE                              2'h0
`define   GCREG_WINDOW_CONTROL_STREAMS_ENABLE                               2'h1
`define   GCREG_WINDOW_CONTROL_STREAMS_INVALIDATE                           2'h2

