`define   AQ_VERTEX_ELEMENT_CONFIG_VS_OUTPUT_BUFFER_SIZE8                   2'h1
`define   AQ_VERTEX_ELEMENT_CONFIG_VS_OUTPUT_BUFFER_SIZE16                  2'h2

