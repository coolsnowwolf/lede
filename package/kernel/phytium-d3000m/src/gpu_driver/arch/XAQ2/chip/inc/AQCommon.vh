`define GCREG_USC_CONTROL_WriteMask                                 32'h007F0F77
`define GCREG_USC_CONTROL_ResetValue                                32'h00000001

/* Number of 1024-byte pages allocated for the global cache memory in cache   **
** memory. others are attribute memory before V63, attribute memory and       **
** attribute cache for V63.                                                   */
`define GCREG_USC_CONTROL_CACHE_PAGES_MSB                                      2
`define GCREG_USC_CONTROL_CACHE_PAGES_LSB                                      0
`define GCREG_USC_CONTROL_CACHE_PAGES_SIZE                                     3
/* All cache memory is allocated for the global cache; */
`define   GCREG_USC_CONTROL_CACHE_PAGES_FULL                                3'h0
/* 1/2 of the cache memory is allocated for the global cache. */
`define   GCREG_USC_CONTROL_CACHE_PAGES_HALF                                3'h1
/* 1/4 of the cache memory is allocated for the global cache.  */
`define   GCREG_USC_CONTROL_CACHE_PAGES_QUARTER                             3'h2
/* 1/8 of the cache memory is allocated for the global cache. */
`define   GCREG_USC_CONTROL_CACHE_PAGES_EIGHTH                              3'h3
/* 1/16 of the cache memory is allocated for the global cache. */
`define   GCREG_USC_CONTROL_CACHE_PAGES_SIXTEENTH                           3'h4
/* 1/32 of the cache memory is allocated for the global cache. */
`define   GCREG_USC_CONTROL_CACHE_PAGES_THIRTYSECOND                        3'h5
/* 3/4 of the cache memory is allocated for the global cache. */
`define   GCREG_USC_CONTROL_CACHE_PAGES_THREE_QUARTER                       3'h6
/* No cache memory is allocated for the global cache. */
`define   GCREG_USC_CONTROL_CACHE_PAGES_NONE                                3'h7

/* USC execution order mode. */
`define GCREG_USC_CONTROL_ORDER_MODE_MSB                                       6
`define GCREG_USC_CONTROL_ORDER_MODE_LSB                                       4
`define GCREG_USC_CONTROL_ORDER_MODE_SIZE                                      3
/* Out of order execution. Best performance. */
`define   GCREG_USC_CONTROL_ORDER_MODE_NORMAL                               3'h0
/* Force USC to execute commands in the receiving order if atomic command is  **
** detected in pipe.                                                          */
`define   GCREG_USC_CONTROL_ORDER_MODE_IN_ORDER_WITH_ATOMIC                 3'h1
/* Force USC to execute commands in the receiving order */
`define   GCREG_USC_CONTROL_ORDER_MODE_IN_ORDER_ALWAYS                      3'h2
/* Force USC to only execute one group at a time if atomic command is         **
** detected in pipe.                                                          */
`define   GCREG_USC_CONTROL_ORDER_MODE_SINGLE_GROUP_WITH_ATOMIC             3'h3
/* Force USC to only execute one group at a time */
`define   GCREG_USC_CONTROL_ORDER_MODE_SINGLE_GROUP_ALWAYS                  3'h4

/* Number of 1024-byte pages allocated for the attribute cache in cache       **
** memory.                                                                    */
`define GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_MSB                              11
`define GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_LSB                               8
`define GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_SIZE                              4
/* All cache memory is allocated for the attribute cache. */
`define   GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_FULL                         4'h0
/* 1/2 of the cache memory is allocated for the attributes cache. */
`define   GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_HALF                         4'h1
/* 1/4 of the cache memory is allocated for the attributes cache. */
`define   GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_QUARTER                      4'h2
/* 1/8 of the cache memory is allocated for the attributes cache. */
`define   GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_EIGHTH                       4'h3
/* 1/16 of the cache memory is allocated for the attributes cache. */
`define   GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_SIXTEENTH                    4'h4
/* 1/32 of the cache memory is allocated for the attributes cache. */
`define   GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_THIRTYSECOND                 4'h5
/* 3/4 of the cache memory is allocated for the attributes cache. */
`define   GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_THREE_QUARTER                4'h6
/* No cache memoryis allocated for the attributes cache. */
`define   GCREG_USC_CONTROL_ATTRIB_CACHE_PAGES_NONE                         4'h7

/* Address bit the specifies the memory controller to be used if two memory   **
** controllers are present. Valid range is [0,25]. Note that the address      **
