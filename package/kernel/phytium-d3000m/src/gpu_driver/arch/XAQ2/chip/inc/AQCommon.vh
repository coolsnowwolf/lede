`define AQ_VERTEX_ELEMENT_CONFIG_FieldMask                          32'h00011113
`define AQ_VERTEX_ELEMENT_CONFIG_ReadMask                           32'h00011113
`define AQ_VERTEX_ELEMENT_CONFIG_WriteMask                          32'h00011113
`define AQ_VERTEX_ELEMENT_CONFIG_ResetValue                         32'h00000001

/* Size of VS output buffer. */
