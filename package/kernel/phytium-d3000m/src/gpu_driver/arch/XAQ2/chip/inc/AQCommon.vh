/* Register gcregMultiSampleConfig **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Multi-Sample configuration register. */

`define gcregMultiSampleConfigRegAddrs                                  16'h0E06
`define GCREG_MULTI_SAMPLE_CONFIG_MSB                                         15
`define GCREG_MULTI_SAMPLE_CONFIG_LSB                                          0
`define GCREG_MULTI_SAMPLE_CONFIG_BLK                                          0
`define GCREG_MULTI_SAMPLE_CONFIG_Count                                        1
`define GCREG_MULTI_SAMPLE_CONFIG_FieldMask                         32'h9FFFFFFB
`define GCREG_MULTI_SAMPLE_CONFIG_ReadMask                          32'h9FFFFFFB
`define GCREG_MULTI_SAMPLE_CONFIG_WriteMask                         32'h9FFFFFFB
`define GCREG_MULTI_SAMPLE_CONFIG_ResetValue                        32'h00000000

/* Multi-Sample mode. */
`define GCREG_MULTI_SAMPLE_CONFIG_MODE_MSB                                     1
`define GCREG_MULTI_SAMPLE_CONFIG_MODE_LSB                                     0
`define GCREG_MULTI_SAMPLE_CONFIG_MODE_SIZE                                    2
`define   GCREG_MULTI_SAMPLE_CONFIG_MODE_OFF                                2'h0
`define   GCREG_MULTI_SAMPLE_CONFIG_MODE_MSAA2                              2'h1
`define   GCREG_MULTI_SAMPLE_CONFIG_MODE_MSAA4                              2'h2
`define   GCREG_MULTI_SAMPLE_CONFIG_MODE_MSAA8                              2'h3

/* Mask bits 1:0. */
`define GCREG_MULTI_SAMPLE_CONFIG_MASK_MODE_MSB                                3
`define GCREG_MULTI_SAMPLE_CONFIG_MASK_MODE_LSB                                3
`define GCREG_MULTI_SAMPLE_CONFIG_MASK_MODE_SIZE                               1
`define   GCREG_MULTI_SAMPLE_CONFIG_MASK_MODE_ENABLED                       1'h0
`define   GCREG_MULTI_SAMPLE_CONFIG_MASK_MODE_MASKED                        1'h1

/* Multi-Sample enable bits.  If all bits are zero, then the attributes will  **
** be computed as if multi-sampling is disabled, but the resulting pixel will **
** be replicated inside the render target and depth buffer.                   */
`define GCREG_MULTI_SAMPLE_CONFIG_ENABLE_MSB                                   7
`define GCREG_MULTI_SAMPLE_CONFIG_ENABLE_LSB                                   4
`define GCREG_MULTI_SAMPLE_CONFIG_ENABLE_SIZE                                  4

/* Mask bits 7:4. */
`define GCREG_MULTI_SAMPLE_CONFIG_MASK_ENABLE_MSB                              8
`define GCREG_MULTI_SAMPLE_CONFIG_MASK_ENABLE_LSB                              8
`define GCREG_MULTI_SAMPLE_CONFIG_MASK_ENABLE_SIZE                             1
`define   GCREG_MULTI_SAMPLE_CONFIG_MASK_ENABLE_ENABLED                     1'h0
