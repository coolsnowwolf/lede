/* Register gcregOcclusionControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Occlusion query control. */

`define gcregOcclusionControlRegAddrs                                   16'h0E18
`define GCREG_OCCLUSION_CONTROL_MSB                                           15
`define GCREG_OCCLUSION_CONTROL_LSB                                            0
`define GCREG_OCCLUSION_CONTROL_BLK                                            0
`define GCREG_OCCLUSION_CONTROL_Count                                          1
`define GCREG_OCCLUSION_CONTROL_FieldMask                           32'h00000007
`define GCREG_OCCLUSION_CONTROL_ReadMask                            32'h00000007
`define GCREG_OCCLUSION_CONTROL_WriteMask                           32'h00000007
`define GCREG_OCCLUSION_CONTROL_ResetValue                          32'h00000000

/* Occlusion query mode. */
`define GCREG_OCCLUSION_CONTROL_MODE_MSB                                       2
`define GCREG_OCCLUSION_CONTROL_MODE_LSB                                       0
`define GCREG_OCCLUSION_CONTROL_MODE_SIZE                                      3
/* Occlusion query counts number of valid pixels. */
`define   GCREG_OCCLUSION_CONTROL_MODE_COUNT                                3'h0
/* Occlusion query aborts any incoming triangle after the first valid pixel   **
** has been found.                                                            */
`define   GCREG_OCCLUSION_CONTROL_MODE_BOOLEAN                              3'h1
/* Occlusion query aborts any incoming triangle after the first valid pixel   **
** has been found. It also sends the result the FE for conditional execution. */
`define   GCREG_OCCLUSION_CONTROL_MODE_BOOLEAN_CONDITIONAL                  3'h2
/* Occlusion query counts number of valid pixels. */
`define   GCREG_OCCLUSION_CONTROL_MODE_COUNT_EARLY                          3'h3
/* Occlusion query aborts any incoming triangle after the first valid pixel   **
** has been found.                                                            */
`define   GCREG_OCCLUSION_CONTROL_MODE_BOOLEAN_EARLY                        3'h4
/* Occlusion query aborts any incoming triangle after the first valid pixel   **
** has been found. It also sends the result the FE for conditional execution. */
`define   GCREG_OCCLUSION_CONTROL_MODE_BOOLEAN_CONDITIONAL_EARLY            3'h5
/* No pixels get culled and only Pixel Engine is counting visible pixels. */
`define   GCREG_OCCLUSION_CONTROL_MODE_RENDER                               3'h6
/* No pixels get culled and only Raster is counting visible pixels when RA    **
** write depth.                                                               */
`define   GCREG_OCCLUSION_CONTROL_MODE_RENDER_IN_RA                         3'h7

