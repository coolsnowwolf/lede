`define GCREG_VARYINGS_WriteMask                                    32'hF000007E
`define GCREG_VARYINGS_ResetValue                                   32'h00000000

/* Number of packed components. Note that bit 0 is always 0 so GC1000 only    **
** supports an even number of components - they are always grouped in pairs.  */
