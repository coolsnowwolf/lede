/*******************************************************************************
**                                ~~~~~~~~~~~~~                               **
**                                Command Token                               **
**                                ~~~~~~~~~~~~~                               **
*******************************************************************************/

/* Offset gcdefToken
** ~~~~~~~~~~~~~~~~~ */

`define GCDEF_TOKEN_OPCODE_MSB                                                 3
`define GCDEF_TOKEN_OPCODE_LSB                                                 0
`define GCDEF_TOKEN_OPCODE_SIZE                                                4
/* Sent by FE to inform a reset of the primitive ID. */
`define   GCDEF_TOKEN_OPCODE_RESET_PRIMITIVE_ID                             4'h0
/* Sent by TPG to inform end of patch. */
`define   GCDEF_TOKEN_OPCODE_END_OF_PATCH                                   4'h1
/* Sent by FE to inform end of draw. */
`define   GCDEF_TOKEN_OPCODE_END_OF_DRAW                                    4'h2
/* Close a shader group. Same as EndOfDraw except that the result cache is    **
** not flushed.                                                               */
`define   GCDEF_TOKEN_OPCODE_CLOSE_GROUP                                    4'h3
/* Change the state set for RTL. */
`define   GCDEF_TOKEN_OPCODE_CHANGE_STATE_SET                               4'h4
/* Mark the beginning of a state load out of the bottom of the g-pipe shader. */
`define   GCDEF_TOKEN_OPCODE_STATE_OUT_BOTTOM                               4'h5
/* Release the partial page and snap to the next page boundary. */
`define   GCDEF_TOKEN_OPCODE_SNAP_TO_PAGE                                   4'h6
/* Increase Primitive ID, sent by WD. */
`define   GCDEF_TOKEN_OPCODE_INCREASE_PRIMITIVE_ID                          4'h7
/* switch from stateLoad, sent by WD to PPA. */
`define   GCDEF_TOKEN_OPCODE_START_DATA                                     4'h8
/* Reset InstanceID, sent by FE. */
`define   GCDEF_TOKEN_OPCODE_RESET_INSTANCE_ID                              4'h9
/* Reset states. */
`define   GCDEF_TOKEN_OPCODE_RESET_STATE_SET                                4'hA
/* Set the Primitive ID, send by WD to GPIPE.  */
`define   GCDEF_TOKEN_OPCODE_SET_PRIMITIVE_ID                               4'hB
/* flush WD deferred vertices. */
`define   GCDEF_TOKEN_OPCODE_FLUSH_WD_VTX_COMPLETIONS                       4'hC
/* PPA Invaild 2 line cache.  */
`define   GCDEF_TOKEN_OPCODE_INVALIDATE_PPA2_LINE_CACHE                     4'hD
/* Increment the binner data structure index by provided 20-bit payload. */
`define   GCDEF_TOKEN_OPCODE_BINPTR_INC                                     4'hE
/* Sent by TPG to inform end of TPG Batch. */
`define   GCDEF_TOKEN_OPCODE_END_OF_TPG_BATCH                               4'hF

/* Client selection bit. */
`define GCDEF_TOKEN_CLIENT_MSB                                                 8
`define GCDEF_TOKEN_CLIENT_LSB                                                 4
`define GCDEF_TOKEN_CLIENT_SIZE                                                5
/* No client selected. */
`define   GCDEF_TOKEN_CLIENT_NONE                                          5'h00
/* Release VS partial page. */
`define   GCDEF_TOKEN_CLIENT_VS                                            5'h01
/* Release TCS partial page. */
`define   GCDEF_TOKEN_CLIENT_TCS                                           5'h02
/* Release TES partial page. */
`define   GCDEF_TOKEN_CLIENT_TES                                           5'h04
/* Release GS partial page. */
`define   GCDEF_TOKEN_CLIENT_GS                                            5'h08
/* Release PS/CS partial page. */
`define   GCDEF_TOKEN_CLIENT_PS                                            5'h10

