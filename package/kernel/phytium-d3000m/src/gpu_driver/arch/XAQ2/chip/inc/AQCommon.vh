/* Register gcregOcclusionAddress **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Address where to store the results of the occlusion query. Writing this    **
** state also resets the occlusion query counters puts the pipe in occlusion  **
** query mode.  When this mode is set, no pixels will be rendered and the     **
** rasterizer only counts the valid number of pixels that would have been     **
** rendered. Make sure you program the rasterizer to EarlyZ instead of        **
** HierarchicalZ if you want a precise result.                                */

`define gcregOcclusionAddressRegAddrs                                   16'h0E09
`define GCREG_OCCLUSION_ADDRESS_MSB                                           15
`define GCREG_OCCLUSION_ADDRESS_LSB                                            0
`define GCREG_OCCLUSION_ADDRESS_BLK                                            0
`define GCREG_OCCLUSION_ADDRESS_Count                                          1
`define GCREG_OCCLUSION_ADDRESS_FieldMask                           32'hFFFFFFFF
`define GCREG_OCCLUSION_ADDRESS_ReadMask                            32'hFFFFFFFC
`define GCREG_OCCLUSION_ADDRESS_WriteMask                           32'hFFFFFFFC
`define GCREG_OCCLUSION_ADDRESS_ResetValue                          32'h00000000

`define GCREG_OCCLUSION_ADDRESS_TYPE_MSB                                      31
`define GCREG_OCCLUSION_ADDRESS_TYPE_LSB                                      31
`define GCREG_OCCLUSION_ADDRESS_TYPE_SIZE                                      1
`define   GCREG_OCCLUSION_ADDRESS_TYPE_SYSTEM                               1'h0
`define   GCREG_OCCLUSION_ADDRESS_TYPE_VIRTUAL_SYSTEM                       1'h1

`define GCREG_OCCLUSION_ADDRESS_ADDRESS_MSB                                   30
`define GCREG_OCCLUSION_ADDRESS_ADDRESS_LSB                                    0
`define GCREG_OCCLUSION_ADDRESS_ADDRESS_SIZE                                  31

/* Register gcregOcclusionData **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* The result of the occlusion query.  Sendind this state will instruct the   **
** rasteriser to stop the occlusion query and return the result of the        **
** occlusion query to the pixel shader by modifying the value of this state.  */

`define gcregOcclusionDataRegAddrs                                      16'h0E0C
`define GCREG_OCCLUSION_DATA_MSB                                              15
`define GCREG_OCCLUSION_DATA_LSB                                               0
`define GCREG_OCCLUSION_DATA_BLK                                               0
`define GCREG_OCCLUSION_DATA_Count                                             1
`define GCREG_OCCLUSION_DATA_FieldMask                              32'hFFFFFFFF
`define GCREG_OCCLUSION_DATA_ReadMask                               32'hFFFFFFFF
`define GCREG_OCCLUSION_DATA_WriteMask                              32'hFFFFFFFF
`define GCREG_OCCLUSION_DATA_ResetValue                             32'h00000000

`define GCREG_OCCLUSION_DATA_COUNTER_MSB                                      31
`define GCREG_OCCLUSION_DATA_COUNTER_LSB                                       0
`define GCREG_OCCLUSION_DATA_COUNTER_SIZE                                     32

