`define GCREG_USC_CONTROL_MEMORY_CONTROLLER_SELECT_MSB                        20
`define GCREG_USC_CONTROL_MEMORY_CONTROLLER_SELECT_LSB                        16
`define GCREG_USC_CONTROL_MEMORY_CONTROLLER_SELECT_SIZE                        5

