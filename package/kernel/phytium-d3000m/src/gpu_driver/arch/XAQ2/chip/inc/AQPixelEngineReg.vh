`define GCREG_PE_CONFIG_LOGIC_OP_LSB                                           0
`define GCREG_PE_CONFIG_LOGIC_OP_SIZE                                          4
/* 0 */
`define   GCREG_PE_CONFIG_LOGIC_OP_CLEAR                                    4'h0
/* inverse(S or D) */
`define   GCREG_PE_CONFIG_LOGIC_OP_NOR                                      4'h1
/* invese(S) and D */
`define   GCREG_PE_CONFIG_LOGIC_OP_AND_INVERTED                             4'h2
/* inverse(S) */
`define   GCREG_PE_CONFIG_LOGIC_OP_COPY_INVERTED                            4'h3
/* s and inverse(D) */
`define   GCREG_PE_CONFIG_LOGIC_OP_AND_REVERSE                              4'h4
/* inverse(D) */
`define   GCREG_PE_CONFIG_LOGIC_OP_INVERT                                   4'h5
/* S xor D */
`define   GCREG_PE_CONFIG_LOGIC_OP_XOR                                      4'h6
/* inverse(S and D) */
`define   GCREG_PE_CONFIG_LOGIC_OP_NAND                                     4'h7
/* S and D */
`define   GCREG_PE_CONFIG_LOGIC_OP_AND                                      4'h8
/* inverse(S xor D) */
`define   GCREG_PE_CONFIG_LOGIC_OP_EQUIV                                    4'h9
/* D */
`define   GCREG_PE_CONFIG_LOGIC_OP_NOOP                                     4'hA
/* inverse(S) or D */
`define   GCREG_PE_CONFIG_LOGIC_OP_OR_INVERTED                              4'hB
/* S */
`define   GCREG_PE_CONFIG_LOGIC_OP_COPY                                     4'hC
/* S or inverse(D) */
`define   GCREG_PE_CONFIG_LOGIC_OP_OR_REVERSE                               4'hD
/* S or D */
`define   GCREG_PE_CONFIG_LOGIC_OP_OR                                       4'hE
/* 1 */
`define   GCREG_PE_CONFIG_LOGIC_OP_SET                                      4'hF

/* Mask LogicOp field. */
`define GCREG_PE_CONFIG_MASK_LOGIC_OP_MSB                                      4
`define GCREG_PE_CONFIG_MASK_LOGIC_OP_LSB                                      4
`define GCREG_PE_CONFIG_MASK_LOGIC_OP_SIZE                                     1
`define   GCREG_PE_CONFIG_MASK_LOGIC_OP_ENABLED                             1'h0
`define   GCREG_PE_CONFIG_MASK_LOGIC_OP_MASKED                              1'h1

