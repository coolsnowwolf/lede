/* Control the number of pixel pipes. */
`define GCREG_PE_CONFIG_EX_PIPE_ENABLE_MSB                                     0
`define GCREG_PE_CONFIG_EX_PIPE_ENABLE_LSB                                     0
`define GCREG_PE_CONFIG_EX_PIPE_ENABLE_SIZE                                    1
/* Both Pixel Engines are enabled, working interleaved. */
`define   GCREG_PE_CONFIG_EX_PIPE_ENABLE_BOTH                               1'h0
/* Only one of the two Pixel Engines is enabled. */
`define   GCREG_PE_CONFIG_EX_PIPE_ENABLE_SINGLE                             1'h1

/* Safety bit to disable bug1293 fix just in case the fix breaks up the main  **
** pipe.                                                                      */
`define GCREG_PE_CONFIG_EX_BUG1293_FIX_DISABLE_MSB                             3
`define GCREG_PE_CONFIG_EX_BUG1293_FIX_DISABLE_LSB                             3
`define GCREG_PE_CONFIG_EX_BUG1293_FIX_DISABLE_SIZE                            1
/* Default setting - allow hardware to have the bug fix active. */
`define   GCREG_PE_CONFIG_EX_BUG1293_FIX_DISABLE_AUTOMATIC                  1'h0
/* Hardware will stop using the bug fix in case the fix causes unexpected     **
** issues.                                                                    */
`define   GCREG_PE_CONFIG_EX_BUG1293_FIX_DISABLE_DISABLE                    1'h1

/* Control automatic hardware clock gating if only one Pixel Engine is        **
