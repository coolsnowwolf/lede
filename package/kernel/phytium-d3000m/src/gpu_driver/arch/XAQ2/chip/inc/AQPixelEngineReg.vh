`define GCREG_PE_CONFIG_EX_CLOCK_GATING_MSB                                    4
`define GCREG_PE_CONFIG_EX_CLOCK_GATING_LSB                                    4
`define GCREG_PE_CONFIG_EX_CLOCK_GATING_SIZE                                   1
/* Default setting - allow hardware to clock gate the second Pixel Engine if  **
** only one is enabled.                                                       */
`define   GCREG_PE_CONFIG_EX_CLOCK_GATING_AUTOMATIC                         1'h0
/* Hardware will never clock gate the second Pixel Engine. */
`define   GCREG_PE_CONFIG_EX_CLOCK_GATING_DISABLE                           1'h1

