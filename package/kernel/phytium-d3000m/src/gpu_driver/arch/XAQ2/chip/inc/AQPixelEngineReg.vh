/* When enabled, if any incoming pixel from the Pixel Shader has a 0 alpha,   **
** the pixel will be treated as if the mask is disabled - it never gets into  **
** the prefetch FIFO's. You can enable this when blending is turned on and    **
** the mode is set to SRCALPHA for source and 1-SRCALPHA for destination and  **
** the operation is add. Also, make sure there would be no conflict for the   **
** depth pipe (stenciling has to be turned off).                              */
`define GCREG_PE_CONFIG_EARLY_ALPHA_KILL_MSB                                  28
`define GCREG_PE_CONFIG_EARLY_ALPHA_KILL_LSB                                  28
`define GCREG_PE_CONFIG_EARLY_ALPHA_KILL_SIZE                                  1
`define   GCREG_PE_CONFIG_EARLY_ALPHA_KILL_DISABLE                          1'h0
`define   GCREG_PE_CONFIG_EARLY_ALPHA_KILL_ENABLE                           1'h1

