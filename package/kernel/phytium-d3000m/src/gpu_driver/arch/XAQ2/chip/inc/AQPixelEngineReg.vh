/* Register gcregPEAlphaConfig **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Extended alpha blend control. */

`define gcregPEAlphaConfigRegAddrs                                      16'h0530
`define GCREG_PE_ALPHA_CONFIG_MSB                                             15
`define GCREG_PE_ALPHA_CONFIG_LSB                                              0
`define GCREG_PE_ALPHA_CONFIG_BLK                                              0
`define GCREG_PE_ALPHA_CONFIG_Count                                            1
`define GCREG_PE_ALPHA_CONFIG_FieldMask                             32'h9DDDFFFF
`define GCREG_PE_ALPHA_CONFIG_ReadMask                              32'h9DDDFFFF
`define GCREG_PE_ALPHA_CONFIG_WriteMask                             32'h9DDDFFFF
`define GCREG_PE_ALPHA_CONFIG_ResetValue                            32'h00000000

/* Alpha blending mode. */
`define GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_MSB                                   3
`define GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_LSB                                   0
`define GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_SIZE                                  4
/* Use AQAlphaBlend state to configure the blending mode. */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_LEGACY                           4'h0
/* C = Cs * Cd. */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_MULTIPLY                         4'h1
/* C = Cs + Cd - Cs * Cd. */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_SCREEN                           4'h2
/* If Cd <= 0.5: C = 2 * Cs * Cd, else C = 1 - 2 * (1 - Cs) * (1 - Cd). */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_OVERLAY                          4'h3
/* C = min(Cs, Cd). */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_DARKEN                           4'h4
/* C = max(Cs, Cd). */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_LIGHTEN                          4'h5
/* If Cs <= 0.5: C = 2 * Cs * Cd, else C = 1 - 2 * (1 - Cs) * (1 - Cd). */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_HARDLIGHT                        4'h6
/* C = abs(Cd - Cs). */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_DIFFERENCE                       4'h7
/* C = Cs + Cd - 2 * Cs - Cd. */
`define   GCREG_PE_ALPHA_CONFIG_ALPHA_MODE_EXCLUSION                        4'h8

/* Determine if alpha needs to be multiplied into the color channels. */
