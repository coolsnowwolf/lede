/* Register gcregMMUAHBSafeNonSecureAddress **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* MMU Non-Secure Memory Safe Zone Address Register. A 64-byte address that   **
** will acts as a 'safe' zone.  Any  address that would cause an exception is **
** routed to this safe  zone.  Reads will happen and writes will go to this   **
** address,  but with a write-enable of 0.  This register can only be         **
** programmed once after a reset - any  attempt to write to this register     **
** after the initial  write-after-reset will be ignored.  This is in          **
** Non-secure memory.                                                         */

`define gcregMMUAHBSafeNonSecureAddressRegAddrs                         16'h00E6
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_MSB                              15
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_LSB                               0
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_BLK                               0
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_Count                             1
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_FieldMask              32'hFFFFFFFF
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_ReadMask               32'hFFFFFFC0
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_WriteMask              32'hFFFFFFC0
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_ResetValue             32'h00000000

/* MMU Non-Secure Safe Zone Address. */
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_ADDRESS_MSB                      31
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_ADDRESS_LSB                       0
`define GCREG_MMUAHB_SAFE_NON_SECURE_ADDRESS_ADDRESS_SIZE                     32

/* Register gcregMMUAHBSafeSecureAddress **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* MMU Secure Memory Safe Zone Address Register. A 64-byte address that will  **
** acts as a 'safe' zone.  Any  address that would cause an exception is      **
** routed to this safe  zone.  Reads will happen and writes will go to this   **
** address,  but with a write-enable of 0.  This register can only be         **
** programmed once after a reset - any  attempt to write to this register     **
** after the initial  write-after-reset will be ignored.  This is in Secure   **
** memory.                                                                    */

`define gcregMMUAHBSafeSecureAddressRegAddrs                            16'h00E7
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_MSB                                  15
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_LSB                                   0
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_BLK                                   0
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_Count                                 1
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_FieldMask                  32'hFFFFFFFF
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_ReadMask                   32'hFFFFFFC0
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_WriteMask                  32'hFFFFFFC0
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_ResetValue                 32'h00000000

/* MMU Secure Memory Safe Zone Address. */
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_ADDRESS_MSB                          31
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_ADDRESS_LSB                           0
`define GCREG_MMUAHB_SAFE_SECURE_ADDRESS_ADDRESS_SIZE                         32

/* Register gcregMMUAHBSafeAddressExt **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* MMU Safe Address Extension Register.  Extended configuration register that **
** holds the upper bits of  safe Address.                                     */

`define gcregMMUAHBSafeAddressExtRegAddrs                               16'h00E8
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_MSB                                     15
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_LSB                                      0
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_BLK                                      0
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_Count                                    1
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_FieldMask                     32'hC0FFC0FF
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_ReadMask                      32'hC0FFC0FF
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_WriteMask                     32'hC0FFC0FF
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_ResetValue                    32'h00000000

/* Upper 8-bits of the safe address to form a true 40-bit  address. This is   **
** for the address in Non-secure memory.                                      */
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_NON_SECURE_MSB              7
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_NON_SECURE_LSB              0
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_NON_SECURE_SIZE             8

/* Bit that defines whether the safe address is shareable or  not.  */
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_NON_SECURE_SHAREABLE_MSB   14
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_NON_SECURE_SHAREABLE_LSB   14
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_NON_SECURE_SHAREABLE_SIZE   1

/* Mask bits 0 through 14. */
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_NON_SECURE_MSB        15
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_NON_SECURE_LSB        15
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_NON_SECURE_SIZE        1
`define   GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_NON_SECURE_ENABLED 1'h0
`define   GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_NON_SECURE_MASKED 1'h1

/* Upper 8-bits of the safe address to form a true 40-bit  address. This is   **
** for Secure Address                                                         */
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_SECURE_MSB                 23
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_SECURE_LSB                 16
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_SECURE_SIZE                 8

/* Bit that defines whether the safe address is shareable or  not. */
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_SECURE_SHAREABLE_MSB       30
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_SECURE_SHAREABLE_LSB       30
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_SAFE_ADDRESS_SECURE_SHAREABLE_SIZE       1

/* Mask bits 0 through 14.  */
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_SECURE_MSB            31
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_SECURE_LSB            31
`define GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_SECURE_SIZE            1
`define   GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_SECURE_ENABLED    1'h0
`define   GCREG_MMUAHB_SAFE_ADDRESS_EXT_MASK_SAFE_ADDRESS_SECURE_MASKED     1'h1

/* Register gcregCmdBufferAHBCtrl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Command Buffer Control Register.  Since this is a write only register is   **
** has no reset value.  WRITE_ONLY.  For cores from v620x, use this register  **
** instead of AQCmdBufferCtrl.                                                */

`define gcregCmdBufferAHBCtrlRegAddrs                                   16'h00E9
`define GCREG_CMD_BUFFER_AHB_CTRL_MSB                                         15
