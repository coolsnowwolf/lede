`define GCREG_MMUAHB_CONTROL_WriteMask                              32'h000007FF
`define GCREG_MMUAHB_CONTROL_ResetValue                             32'h00000000

/* Enable the MMU. For security reasons, once the MMU is  enabled it cannot   **
** be disabled anymore. writeOnce.                                            */
`define GCREG_MMUAHB_CONTROL_MMU_MSB                                           0
`define GCREG_MMUAHB_CONTROL_MMU_LSB                                           0
`define GCREG_MMUAHB_CONTROL_MMU_SIZE                                          1
`define   GCREG_MMUAHB_CONTROL_MMU_DISABLE                                  1'h0
`define   GCREG_MMUAHB_CONTROL_MMU_ENABLE                                   1'h1

/* StrictMode enable, for secure mode. */
`define GCREG_MMUAHB_CONTROL_STRICT_MODE_MSB                                   1
`define GCREG_MMUAHB_CONTROL_STRICT_MODE_LSB                                   1
`define GCREG_MMUAHB_CONTROL_STRICT_MODE_SIZE                                  1
`define   GCREG_MMUAHB_CONTROL_STRICT_MODE_DISABLE                          1'h0
`define   GCREG_MMUAHB_CONTROL_STRICT_MODE_ENABLE                           1'h1

/* OutOfBoundException enable. */
`define GCREG_MMUAHB_CONTROL_OUT_OF_BOUND_EXCEPTION_MSB                        2
`define GCREG_MMUAHB_CONTROL_OUT_OF_BOUND_EXCEPTION_LSB                        2
`define GCREG_MMUAHB_CONTROL_OUT_OF_BOUND_EXCEPTION_SIZE                       1
`define   GCREG_MMUAHB_CONTROL_OUT_OF_BOUND_EXCEPTION_DISABLE               1'h0
`define   GCREG_MMUAHB_CONTROL_OUT_OF_BOUND_EXCEPTION_ENABLE                1'h1

/* SecurityViolationException enable. */
`define GCREG_MMUAHB_CONTROL_SECURITY_VIOL_EXCEPTION_MSB                       3
`define GCREG_MMUAHB_CONTROL_SECURITY_VIOL_EXCEPTION_LSB                       3
`define GCREG_MMUAHB_CONTROL_SECURITY_VIOL_EXCEPTION_SIZE                      1
`define   GCREG_MMUAHB_CONTROL_SECURITY_VIOL_EXCEPTION_DISABLE              1'h0
`define   GCREG_MMUAHB_CONTROL_SECURITY_VIOL_EXCEPTION_ENABLE               1'h1

