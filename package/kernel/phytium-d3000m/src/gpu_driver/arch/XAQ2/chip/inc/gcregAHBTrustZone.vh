`define GCREG_CMD_BUFFER_AHB_CTRL_WriteMask                         32'h0031FFFF
`define GCREG_CMD_BUFFER_AHB_CTRL_ResetValue                        32'h00000000

/* Number of 64-bit words to fetch from the command buffer.  */
`define GCREG_CMD_BUFFER_AHB_CTRL_PREFETCH_MSB                                15
`define GCREG_CMD_BUFFER_AHB_CTRL_PREFETCH_LSB                                 0
`define GCREG_CMD_BUFFER_AHB_CTRL_PREFETCH_SIZE                               16

/* Enable the command parser.  */
`define GCREG_CMD_BUFFER_AHB_CTRL_ENABLE_MSB                                  16
`define GCREG_CMD_BUFFER_AHB_CTRL_ENABLE_LSB                                  16
`define GCREG_CMD_BUFFER_AHB_CTRL_ENABLE_SIZE                                  1
`define   GCREG_CMD_BUFFER_AHB_CTRL_ENABLE_DISABLE                          1'h0
`define   GCREG_CMD_BUFFER_AHB_CTRL_ENABLE_ENABLE                           1'h1

/* Control endian swapping. This field is reserved. */
`define GCREG_CMD_BUFFER_AHB_CTRL_ENDIAN_CONTROL_MSB                          21
`define GCREG_CMD_BUFFER_AHB_CTRL_ENDIAN_CONTROL_LSB                          20
`define GCREG_CMD_BUFFER_AHB_CTRL_ENDIAN_CONTROL_SIZE                          2
`define   GCREG_CMD_BUFFER_AHB_CTRL_ENDIAN_CONTROL_NO_SWAP                  2'h0
