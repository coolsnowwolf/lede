/* Register gcregMMUAHBControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Memory Management Unit Control Register.  Control register that enables    **
** the Memory Management Unit (MMU) (only time shot).                         */

`define gcregMMUAHBControlRegAddrs                                      16'h00E2
`define GCREG_MMUAHB_CONTROL_MSB                                              15
`define GCREG_MMUAHB_CONTROL_LSB                                               0
`define GCREG_MMUAHB_CONTROL_BLK                                               0
`define GCREG_MMUAHB_CONTROL_Count                                             1
`define GCREG_MMUAHB_CONTROL_FieldMask                              32'h000007FF
