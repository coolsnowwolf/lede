`define GCREG_DEBUG_COUNTER_SELECT_ReadMask                         32'h000000FF
`define GCREG_DEBUG_COUNTER_SELECT_WriteMask                        32'h000000FF
`define GCREG_DEBUG_COUNTER_SELECT_ResetValue                       32'h00000000

/* Write a value to this field to pick up from 0~255 counters.                **
** Then the counter will be on gcregDebugCounterValue.                        **
** 8'h0 : TotalAXIRdReqCnt     //request number                               **
** 8'h1 : TotalAXIRdLastCnt    //read return data last number                 **
** 8'h2 : TotalAXIReqBurstCnt  //number of 8bytes of reqeust bytes            **
** 8'h3 : TotalAXIRdBurstCunt  //number of 8bytes of read return data         **
** 8'h4 : TotalPixelCnt        //total pixels sent                            **
** 8'h5 : TotalFrameCnt        //total frame sent                             **
** 8'h6 : TotalInputDbiCmdCnt  //total dbi input cmd                          **
** 8'h7 : TotalOutputDbiCmdCnt //total dbi output cmd                         **
** 8'h8 : DebugSignals0        //debug signals                                **
** 8'hFF: reset all debug counters                                            */
`define GCREG_DEBUG_COUNTER_SELECT_SELECT_MSB                                  7
`define GCREG_DEBUG_COUNTER_SELECT_SELECT_LSB                                  0
`define GCREG_DEBUG_COUNTER_SELECT_SELECT_SIZE                                 8
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_AXI_RD_REQ_CNT           8'h00
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_AXI_RD_LAST_CNT          8'h01
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_AXI_REQ_BURST_CNT        8'h02
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_AXI_RD_BURST_CUNT        8'h03
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_PIXEL_CNT                8'h04
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_FRAME_CNT                8'h05
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_INPUT_DBI_CMD_CNT        8'h06
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_TOTAL_OUTPUT_DBI_CMD_CNT       8'h07
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_DEBUG_SIGNALS0                 8'h08
`define   GCREG_DEBUG_COUNTER_SELECT_SELECT_RESET_ALL_DEBUG_COUNTERS       8'hFF

