`define   GCREG_FRAME_BUFFER_CONFIG_MODE_LINEAR                             1'h0
`define   GCREG_FRAME_BUFFER_CONFIG_MODE_TILE4X4                            1'h1

/* The format of the frame buffer.  None means there is no frame buffer and   **
