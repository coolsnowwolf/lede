`define AQ_PIXEL_SHADER_INST_Count                                          1024
`define AQ_PIXEL_SHADER_INST_FieldMask                              32'hFFFFFFFF
`define AQ_PIXEL_SHADER_INST_ReadMask                               32'hFFFFFFFF
`define AQ_PIXEL_SHADER_INST_WriteMask                              32'hFFFFFFFF
