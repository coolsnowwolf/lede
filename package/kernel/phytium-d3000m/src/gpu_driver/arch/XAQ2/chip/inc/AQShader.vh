`define GCREG_PS_UNPACK_VARYING6_LSB                                          24
`define GCREG_PS_UNPACK_VARYING6_SIZE                                          3

/* Number of components for varyings 7, 15, and 23. 0 means the varying is    **
** turned off.                                                                */
`define GCREG_PS_UNPACK_VARYING7_MSB                                          30
`define GCREG_PS_UNPACK_VARYING7_LSB                                          28
`define GCREG_PS_UNPACK_VARYING7_SIZE                                          3

