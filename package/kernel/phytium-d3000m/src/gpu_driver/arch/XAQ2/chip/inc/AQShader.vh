`define GCREG_GPIPE_LOAD_BALANCING_WriteMask                        32'h00000FF1
`define GCREG_GPIPE_LOAD_BALANCING_ResetValue                       32'h00000000

/* if HW FIFO entry counter reaches or beyond this number, PS is of high      **
