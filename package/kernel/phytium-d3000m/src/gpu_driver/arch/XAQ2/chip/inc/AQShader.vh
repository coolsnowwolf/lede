/* The shader waits for a number of vertices to arrive before executing       **
** because the internal execution granularity is much larger than a vertex.   **
** The shader will stop waiting and start executing after 16 times this many  **
** cycles have elapsed without receiving anything.                            */
`define AQ_VERTEX_SHADER_INPUT_CONTROL_TIMEOUT_MSB                            12
`define AQ_VERTEX_SHADER_INPUT_CONTROL_TIMEOUT_LSB                             8
`define AQ_VERTEX_SHADER_INPUT_CONTROL_TIMEOUT_SIZE                            5

