`define   GCREG_GPIPE_LOAD_BALANCING_HIGH_WM_SIZE_HALF                      1'h0

/* timeslice specification for below the HighWM: typically should prioritize  **
** gpipe more.  N/16.0 is the percentage of issue slots which favor gpipe     */
`define GCREG_GPIPE_LOAD_BALANCING_GPIPE_TIMESLICE_BELOW_WM_MSB                7
`define GCREG_GPIPE_LOAD_BALANCING_GPIPE_TIMESLICE_BELOW_WM_LSB                4
`define GCREG_GPIPE_LOAD_BALANCING_GPIPE_TIMESLICE_BELOW_WM_SIZE               4

/* timeslice specification for at or above the HighWM: typically should       **
** prioritize gpipe more.  N/16.0 is the percentage of issue slots which      **
** favor gpipe                                                                */
`define GCREG_GPIPE_LOAD_BALANCING_GPIPE_TIMESLICE_ABOVE_WM_MSB               11
`define GCREG_GPIPE_LOAD_BALANCING_GPIPE_TIMESLICE_ABOVE_WM_LSB                8
