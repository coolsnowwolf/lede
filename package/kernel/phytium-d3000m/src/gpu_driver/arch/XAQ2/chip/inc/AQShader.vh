`define GCREG_SHADER_STATIC_BANK_SWAP_LSB                                     10
`define GCREG_SHADER_STATIC_BANK_SWAP_SIZE                                     1
`define   GCREG_SHADER_STATIC_BANK_SWAP_ENABLE                              1'h0
`define   GCREG_SHADER_STATIC_BANK_SWAP_DISABLE                             1'h1

/* Select between little endian and big endian for memory accesses. */
`define GCREG_SHADER_STATIC_ENDIAN_CONTROL_MSB                                28
`define GCREG_SHADER_STATIC_ENDIAN_CONTROL_LSB                                28
