/* Offset gcregSHVision
** ~~~~~~~~~~~~~~~~~~~~ */

/* EVIS opcodes. */
`define GCREG_SH_VISION_OPCODE_MSB                                             5
`define GCREG_SH_VISION_OPCODE_LSB                                             0
`define GCREG_SH_VISION_OPCODE_SIZE                                            6
`define   GCREG_SH_VISION_OPCODE_ABS_DIFF                                  6'h01
`define   GCREG_SH_VISION_OPCODE_IADD                                      6'h02
`define   GCREG_SH_VISION_OPCODE_IACC_SQ                                   6'h03
`define   GCREG_SH_VISION_OPCODE_LERP                                      6'h04
`define   GCREG_SH_VISION_OPCODE_FILTER                                    6'h05
`define   GCREG_SH_VISION_OPCODE_MAG_PHASE                                 6'h06
`define   GCREG_SH_VISION_OPCODE_MUL_SHIFT                                 6'h07
`define   GCREG_SH_VISION_OPCODE_DP16X1                                    6'h08
`define   GCREG_SH_VISION_OPCODE_DP8X2                                     6'h09
`define   GCREG_SH_VISION_OPCODE_DP4X4                                     6'h0A
`define   GCREG_SH_VISION_OPCODE_DP2X8                                     6'h0B
`define   GCREG_SH_VISION_OPCODE_CLAMP                                     6'h0C
`define   GCREG_SH_VISION_OPCODE_BI_LINEAR                                 6'h0D
`define   GCREG_SH_VISION_OPCODE_SELECT_ADD                                6'h0E
`define   GCREG_SH_VISION_OPCODE_ATOMIC_ADD                                6'h0F
`define   GCREG_SH_VISION_OPCODE_BIT_EXTRACT                               6'h10
`define   GCREG_SH_VISION_OPCODE_BIT_REPLACE                               6'h11
`define   GCREG_SH_VISION_OPCODE_DP32X1                                    6'h12
`define   GCREG_SH_VISION_OPCODE_DP16X2                                    6'h13
`define   GCREG_SH_VISION_OPCODE_DP8X4                                     6'h14
`define   GCREG_SH_VISION_OPCODE_DP4X8                                     6'h15
`define   GCREG_SH_VISION_OPCODE_DP2X16                                    6'h16
`define   GCREG_SH_VISION_OPCODE_INDEX_ADD                                 6'h17
`define   GCREG_SH_VISION_OPCODE_VERT_MIN3                                 6'h18
`define   GCREG_SH_VISION_OPCODE_VERT_MAX3                                 6'h19
`define   GCREG_SH_VISION_OPCODE_VERT_MED3                                 6'h1A
`define   GCREG_SH_VISION_OPCODE_HORZ_MIN3                                 6'h1B
`define   GCREG_SH_VISION_OPCODE_HORZ_MAX3                                 6'h1C
`define   GCREG_SH_VISION_OPCODE_HORZ_MED3                                 6'h1D
`define   GCREG_SH_VISION_OPCODE_GATHER                                    6'h1E
`define   GCREG_SH_VISION_OPCODE_SCATTER                                   6'h1F
`define   GCREG_SH_VISION_OPCODE_ATOMIC_S                                  6'h20

/* Filter type. */
`define GCREG_SH_VISION_FILTER_MSB                                            11
`define GCREG_SH_VISION_FILTER_LSB                                             8
`define GCREG_SH_VISION_FILTER_SIZE                                            4
/* Compute a 3x3 box filter: |1/9, 1/9, 1/9, 1/9, 1/9, 1/9, 1/9, 1/9, 1/9|. */
`define   GCREG_SH_VISION_FILTER_BOX                                        4'h0
/* Compute a 3x3 Gaussian filter: |1/16, 2/16, 1/16, 2/16, 4/16, 2/16, 1/16,  **
** 2/16, 1/16|.                                                               */
`define   GCREG_SH_VISION_FILTER_GAUSSIAN                                   4'h1
/* Compute a 3x3 Sobel filter in the x-direction: |-1, 0, 1, -2, 0, 2, -1, 0, **
** 1|.                                                                        */
`define   GCREG_SH_VISION_FILTER_SOBEL_X                                    4'h2
/* Compute a 3x3 Sobel filter in the y-direction: |-1, -2, -1, 0, 0, 0, 1, 2, **
** 1|.                                                                        */
`define   GCREG_SH_VISION_FILTER_SOBEL_Y                                    4'h3
/* Compute a 3x3 Scharr filter in the x-direction: |3, 0, -3, 10, 0, -10, 3,  **
** 0, -3|.                                                                    */
`define   GCREG_SH_VISION_FILTER_SCHARR_X                                   4'h4
/* Compute a 3x3 Scharr filter in the y-direction: |3, 10, 3, 0, 0, 0, -3,    **
** -10, -3|.                                                                  */
`define   GCREG_SH_VISION_FILTER_SCHARR_Y                                   4'h5
/* Get the maximum from a 3x3 kernel. */
`define   GCREG_SH_VISION_FILTER_MAX                                        4'h8
/* Get the minimum from a 3x3 kernel. */
`define   GCREG_SH_VISION_FILTER_MIN                                        4'h9
/* Get the median from a 3x3 kernel. */
`define   GCREG_SH_VISION_FILTER_MEDIAN                                     4'hA

/* DotProduct Rounding mode. */
`define GCREG_SH_VISION_ROUNDING_MSB                                          13
`define GCREG_SH_VISION_ROUNDING_LSB                                          12
`define GCREG_SH_VISION_ROUNDING_SIZE                                          2
/* Truncate (for integers). */
`define   GCREG_SH_VISION_ROUNDING_TRUNCATE                                 2'h0
/* Round to zero (for floats). */
`define   GCREG_SH_VISION_ROUNDING_TOWARD_ZERO                              2'h0
/* Round half to infinity (for integers). */
`define   GCREG_SH_VISION_ROUNDING_SIMPLE_ROUNDING                          2'h1
/* Round half to +/- infinity (for floats). */
`define   GCREG_SH_VISION_ROUNDING_HALF_UP                                  2'h1
/* Round half to nearest even. */
`define   GCREG_SH_VISION_ROUNDING_HALF_NEAREST_EVEN                        2'h2

