`define GCREG_PS_TRIGGER_NN_COMMAND_EVENT_ID_LSB                               0
`define GCREG_PS_TRIGGER_NN_COMMAND_EVENT_ID_SIZE                              5

/* The most significant 26 bits of NN command buffer base address.  The least **
** significant 6 bits of NN command buffer base address should be zeros.      **
