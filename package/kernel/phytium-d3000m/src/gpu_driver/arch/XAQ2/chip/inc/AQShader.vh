`define GCREG_PS_OUTPUT_MODE_CONTROL0_MSB                                      3
`define GCREG_PS_OUTPUT_MODE_CONTROL0_LSB                                      0
`define GCREG_PS_OUTPUT_MODE_CONTROL0_SIZE                                     4
