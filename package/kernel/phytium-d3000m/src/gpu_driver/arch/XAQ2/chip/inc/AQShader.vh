`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_UNIT_CLUSTER                   2'h2

/* Hardware native debug stop type. 0: PC equals to reference PC. 1:          **
** Instruction count equals to reference instruction count. 2: Call depth is  **
** greater than reference call depth. 3: Call depth is less than reference    **
** call depth. 4: Call depth equals to reference call depth. 5: Call depth is **
** less than or equals to reference call depth. 6: PC equals reference PC and **
** Call depth equals to reference call depth. 7: PC equals reference PC or    **
** Call depth equals to reference call depth. 8: Write data to local storage  **
** address. 9: Read data from local storage address. 10: Write data to or     **
** read data from local storage address. 11: Write data to global address.    **
** 12: Read data from global storage address. 13: Write data to or read data  **
** from global storage address. 14: Immediately debug. 15: Kernel end.        */
`define GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_MSB                            8
`define GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_LSB                            4
`define GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_SIZE                           5
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_EQ_PC                    5'h00
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_EQ_INST_COUNT            5'h01
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_GT_CALL_DEPTH            5'h02
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_LT_CALL_DEPTH            5'h03
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_EQ_CALL_DEPTH            5'h04
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_LT_EQ_CALL_DEPTH         5'h05
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_EQ_PC_AND_EQ_CALL_DEPTH  5'h06
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_EQ_PC_OR_EQ_CALL_DEPTH   5'h07
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_DATA_WRITE_AT_LOCAL_ADDRESS 5'h08
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_DATA_READ_AT_LOCAL_ADDRESS 5'h09
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_DATA_WRITE_OR_READ_AT_LOCAL_ADDRESS 5'h0A
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_DATA_WRITE_AT_GLOBAL_ADDRESS 5'h0B
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_DATA_READ_AT_GLOBAL_ADDRESS 5'h0C
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_DATA_WRITE_OR_READ_AT_GLOBAL_ADDRESS 5'h0D
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_IMMEDIATELY              5'h0E
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_KERNEL_END               5'h0F
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_KERNEL_START             5'h10
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_NOT_IN_PC_RANGE          5'h11
`define   GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_TYPE_LT_EQ_CALL_DEPTH_AND_NOT_IN_PC_RANGE 5'h12

