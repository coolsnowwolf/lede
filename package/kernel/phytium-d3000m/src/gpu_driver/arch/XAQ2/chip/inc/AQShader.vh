`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_RA2SH_VALID_AND_READY_           8'h07
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_RA2SH_VALID_AND_READY            8'h08
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_STATE_LOAD_TO_DATA_WAIT_FOR_IDLE 8'h09
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_DATA_TO_STATE_LOAD_WAIT_FOR_IDLE 8'h0A
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_STATE_LOAD_TO_DATA_TRANSITIONS   8'h0B
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_STATE_LOADS                      8'h0C
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_INPUT_ATTRIBUTES                 8'h0D
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_INPUT_TIMEOUTS                   8'h0E
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_WRITE_GENERATE_ATTRIBUTES        8'h0F
/* This is the count divided by the smallest power of 2 number >= the number  **
** of cores.                                                                  */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_INSTRUCTIONS_EXECUTED            8'h10
/* This is the number of instructions executed for an entire group.  It       **
** increments by 1 regardless of how many vertices in the group needed that   **
** instruction                                                                */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_GROUP_INSTRUCTIONS_EXECUTED      8'h11
/* The only available groups are texture loads, and the texture request fifo  **
** is full                                                                    */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_TEXTURE_REQUEST_FIFO_LIMITED     8'h12
/* This is the number of incoming pixel that got shaded.  Some of them may    **
** not be covered at all, but they need to be shaded anyway because of quad   **
** granularity.  This number may be slightly less than the number computed    **
** from the group count because generated quads are not included in this      **
** count.                                                                     */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_SHADED_PIXELS                    8'h13
/* The number of incoming covered pixels that got shaded */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_SHADED_COVERED_PIXELS            8'h14
/* These are the covered pixels that are texkilled.  Uncovered pixels that    **
** are texkilled are not counted.                                             */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_TEXKILLED_PIXELS                 8'h15
/* The number of shaded pixels output from the shader */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_OUTPUT_SHADED_PIXELS             8'h16
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_GROUPS                           8'h17
/* This is the number of quads from the RA that were discarded */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_DISCARDED_QUADS                  8'h18
/* This is the number of attributes that were discarded as a result of the    **
** quad discarding                                                            */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_DISCARDED_ATTRIBUTES             8'h19
/* This is the number of quads discarded while idle */
`define   AQ_PIXEL_SHADER_PERFORMANCE_SEL_IDLE_DISCARDED_QUADS             8'h1A
