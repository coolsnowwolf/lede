/* Min. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_MIN                         3'h1
/* Max. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_MAX                         3'h2
/* And. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_AND                         3'h3
/* Or. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_OR                          3'h4
/* Xor. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_XOR                         3'h5
/* Inc. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_INC                         3'h6
/* Dec. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_DEC                         3'h7

