/* Register gcregGSControl **
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* Geometry Shader control. */

`define gcregGSControlRegAddrs                                          16'h0440
`define GCREG_GS_CONTROL_MSB                                                  15
`define GCREG_GS_CONTROL_LSB                                                   0
`define GCREG_GS_CONTROL_BLK                                                   0
`define GCREG_GS_CONTROL_Count                                                 1
`define GCREG_GS_CONTROL_FieldMask                                  32'h3F37F3F1
`define GCREG_GS_CONTROL_ReadMask                                   32'h3F37F3F1
`define GCREG_GS_CONTROL_WriteMask                                  32'h3F37F3F1
`define GCREG_GS_CONTROL_ResetValue                                 32'h00000000

/* The Geometry Shader execution mode. */
`define GCREG_GS_CONTROL_MODE_MSB                                              0
`define GCREG_GS_CONTROL_MODE_LSB                                              0
`define GCREG_GS_CONTROL_MODE_SIZE                                             1
/* The Geometry Shader will copy the incoming primitives to the output. */
`define   GCREG_GS_CONTROL_MODE_BYPASS                                      1'h0
/* The Geometry Shader will shade the incoming primitives. */
`define   GCREG_GS_CONTROL_MODE_ENABLE                                      1'h1

/* Number of output varyings. */
`define GCREG_GS_CONTROL_OUTPUT_COUNT_MSB                                      9
`define GCREG_GS_CONTROL_OUTPUT_COUNT_LSB                                      4
`define GCREG_GS_CONTROL_OUTPUT_COUNT_SIZE                                     6

/* Number of temporary registers used by the Geometry Shader. */
`define GCREG_GS_CONTROL_TEMP_COUNT_MSB                                       18
`define GCREG_GS_CONTROL_TEMP_COUNT_LSB                                       12
`define GCREG_GS_CONTROL_TEMP_COUNT_SIZE                                       7

/* Start of the input vertices addresses. */
`define GCREG_GS_CONTROL_INPUT_START_MSB                                      21
`define GCREG_GS_CONTROL_INPUT_START_LSB                                      20
`define GCREG_GS_CONTROL_INPUT_START_SIZE                                      2
/* Start the remap at r0.z component. This can only be used if there or 4 or  **
** less input vertices and no restart, StreamOut, or IDs are required.        */
`define   GCREG_GS_CONTROL_INPUT_START_R0Z                                  2'h0
/* Start the remap at r1.x component. */
`define   GCREG_GS_CONTROL_INPUT_START_R1X                                  2'h1
/* Start the remap at r1.z component. This can only be used if there or 4 or  **
** less input vertices.                                                       */
`define   GCREG_GS_CONTROL_INPUT_START_R1Z                                  2'h2
/* Start the remap at r2.x component. */
`define   GCREG_GS_CONTROL_INPUT_START_R2X                                  2'h3

/* Contol whether or not the restart bits need to be allocated or not. This   **
** field needs to be set if the shader is using the Restart opcode.           */
`define GCREG_GS_CONTROL_HAS_RESTART_MSB                                      24
`define GCREG_GS_CONTROL_HAS_RESTART_LSB                                      24
`define GCREG_GS_CONTROL_HAS_RESTART_SIZE                                      1

/* Contol whether or not the streamout buffers need to be allocated from the  **
** attriubute memory.                                                         */
`define GCREG_GS_CONTROL_HAS_STREAM_OUT_MSB                                   25
`define GCREG_GS_CONTROL_HAS_STREAM_OUT_LSB                                   25
`define GCREG_GS_CONTROL_HAS_STREAM_OUT_SIZE                                   1

/* Contol whether or not the primitive ID needs to be accesed by the shader   **
** program.                                                                   */
`define GCREG_GS_CONTROL_HAS_PRIMITIVE_ID_MSB                                 26
`define GCREG_GS_CONTROL_HAS_PRIMITIVE_ID_LSB                                 26
`define GCREG_GS_CONTROL_HAS_PRIMITIVE_ID_SIZE                                 1
/* The primitive ID is not required. */
`define   GCREG_GS_CONTROL_HAS_PRIMITIVE_ID_NO                              1'h0
/* The primitive ID is required. This can be stored in r0.z, r0.w, or r1.x,   **
** depending on whether or not Restart or StreamOut is required.              */
`define   GCREG_GS_CONTROL_HAS_PRIMITIVE_ID_YES                             1'h1

/* Contol whether or not the instance ID needs to be accessed by the shader   **
** program.                                                                   */
`define GCREG_GS_CONTROL_HAS_INSTANCE_ID_MSB                                  27
`define GCREG_GS_CONTROL_HAS_INSTANCE_ID_LSB                                  27
`define GCREG_GS_CONTROL_HAS_INSTANCE_ID_SIZE                                  1
/* The instance ID is not required. */
`define   GCREG_GS_CONTROL_HAS_INSTANCE_ID_NO                               1'h0
/* The instance ID is required. This can be stored in r0.z, r0.w, r1.x or     **
** r1.y, depending on whether or not Restart or StreamOut is required.        */
`define   GCREG_GS_CONTROL_HAS_INSTANCE_ID_YES                              1'h1

/* Number of components for last attribute during emit. */
`define GCREG_GS_CONTROL_LAST_ATTRIBUTE_MSB                                   29
`define GCREG_GS_CONTROL_LAST_ATTRIBUTE_LSB                                   28
`define GCREG_GS_CONTROL_LAST_ATTRIBUTE_SIZE                                   2
/* Four components. */
`define   GCREG_GS_CONTROL_LAST_ATTRIBUTE_FOUR                              2'h0
/* One component. */
`define   GCREG_GS_CONTROL_LAST_ATTRIBUTE_ONE                               2'h1
/* Two components. */
`define   GCREG_GS_CONTROL_LAST_ATTRIBUTE_TWO                               2'h2
/* Three components. */
`define   GCREG_GS_CONTROL_LAST_ATTRIBUTE_THREE                             2'h3

