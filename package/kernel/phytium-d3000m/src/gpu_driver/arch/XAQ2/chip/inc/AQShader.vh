/* 64 byte swizzle. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_SWIZZLE_SWIZZLE64                     2'h2
/* 128 byte swizzle. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_SWIZZLE_SWIZZLE128                    2'h3

/* Prefetch size in L3. */
`define GCREG_ASYNC_COPY_DESCRIPTOR_L3_PROMOTION_MSB                          12
`define GCREG_ASYNC_COPY_DESCRIPTOR_L3_PROMOTION_LSB                          11
`define GCREG_ASYNC_COPY_DESCRIPTOR_L3_PROMOTION_SIZE                          2
/* None. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_L3_PROMOTION_NONE                     2'h0
/* fetch 64byte. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_L3_PROMOTION_BYTE64                   2'h1
/* fetch 128byte. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_L3_PROMOTION_BYTE128                  2'h2
/* fetch 256byte. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_L3_PROMOTION_BYTE256                  2'h3

/* Out of bound. */
`define GCREG_ASYNC_COPY_DESCRIPTOR_OOB_FILL_MSB                              13
`define GCREG_ASYNC_COPY_DESCRIPTOR_OOB_FILL_LSB                              13
`define GCREG_ASYNC_COPY_DESCRIPTOR_OOB_FILL_SIZE                              1
/* Zero. */
