/* uint16. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_U16                         4'h1
/* uint32. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_U32                         4'h2
/* int32. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_INT32                       4'h3
/* uint64. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_U64                         4'h4
/* int64. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_INT64                       4'h5
/* float16. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_FL16                        4'h6
/* float32. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_FL32                        4'h7
/* float64. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_FL64                        4'h8
/* BFloat16. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_BF16                        4'h9
/* Float32 flush subnormal inputs to sign-preserving zero. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_FL32_FTZ                    4'hA
/* TFloat32. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_TF32                        4'hB
/* TFloat32 flush subnormal inputs to sign-preserving zero. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_TF32_FTZ                    4'hC

/* tensor dimension. */
`define GCREG_ASYNC_COPY_DESCRIPTOR_TENSOR_DIM_MSB                             6
`define GCREG_ASYNC_COPY_DESCRIPTOR_TENSOR_DIM_LSB                             4
`define GCREG_ASYNC_COPY_DESCRIPTOR_TENSOR_DIM_SIZE                            3
/* 1 Dimension. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_TENSOR_DIM_DIM1                       3'h0
/* 2 Dimension. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_TENSOR_DIM_DIM2                       3'h1
/* 3 Dimension. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_TENSOR_DIM_DIM3                       3'h2
/* 4 Dimension. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_TENSOR_DIM_DIM4                       3'h3
/* 5 Dimension. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_TENSOR_DIM_DIM5                       3'h4

/* Interleave. */
`define GCREG_ASYNC_COPY_DESCRIPTOR_INTERLEAVE_MSB                             8
`define GCREG_ASYNC_COPY_DESCRIPTOR_INTERLEAVE_LSB                             7
`define GCREG_ASYNC_COPY_DESCRIPTOR_INTERLEAVE_SIZE                            2
/* none. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_INTERLEAVE_NONE                       2'h0
/* 16byte Interleave. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_INTERLEAVE_INTERLEAVE16               2'h1
/* 32byte Interleave. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_INTERLEAVE_INTERLEAVE32               2'h2

/* Swizzle. */
