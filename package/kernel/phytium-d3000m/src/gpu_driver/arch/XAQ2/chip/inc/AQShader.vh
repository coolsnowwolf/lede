`define GCREG_SHADER_MISC_CONFIG_WriteMask                          32'h0000FFFF
`define GCREG_SHADER_MISC_CONFIG_ResetValue                         32'h00000000

/* Single precision floating point output color to internal format converter  **
** rounding control.                                                          */
`define GCREG_SHADER_MISC_CONFIG_OUT_COLOR_ROUNDING_MSB                        0
`define GCREG_SHADER_MISC_CONFIG_OUT_COLOR_ROUNDING_LSB                        0
`define GCREG_SHADER_MISC_CONFIG_OUT_COLOR_ROUNDING_SIZE                       1
`define   GCREG_SHADER_MISC_CONFIG_OUT_COLOR_ROUNDING_DISABLE               1'h0
`define   GCREG_SHADER_MISC_CONFIG_OUT_COLOR_ROUNDING_ENABLE                1'h1

/* RTE rounding mode for math unit */
`define GCREG_SHADER_MISC_CONFIG_RTNE_ROUNDING_MSB                             1
`define GCREG_SHADER_MISC_CONFIG_RTNE_ROUNDING_LSB                             1
`define GCREG_SHADER_MISC_CONFIG_RTNE_ROUNDING_SIZE                            1
`define   GCREG_SHADER_MISC_CONFIG_RTNE_ROUNDING_DISABLE                    1'h0
`define   GCREG_SHADER_MISC_CONFIG_RTNE_ROUNDING_ENABLE                     1'h1

/* Precision control for Pixel Shader. */
`define GCREG_SHADER_MISC_CONFIG_PS_PRECISION_MSB                              2
`define GCREG_SHADER_MISC_CONFIG_PS_PRECISION_LSB                              2
`define GCREG_SHADER_MISC_CONFIG_PS_PRECISION_SIZE                             1
/* High precision (32-bit floating point). */
`define   GCREG_SHADER_MISC_CONFIG_PS_PRECISION_HIGH                        1'h0
/* Medium precision (16-bit floating point).  Implies dual-16 mode. */
`define   GCREG_SHADER_MISC_CONFIG_PS_PRECISION_MEDIUM                      1'h1

/* Integer2Float treatment of NANs. */
`define GCREG_SHADER_MISC_CONFIG_CONVERT_NAN_MSB                               3
`define GCREG_SHADER_MISC_CONFIG_CONVERT_NAN_LSB                               3
`define GCREG_SHADER_MISC_CONFIG_CONVERT_NAN_SIZE                              1
/* Flush NANs to zero on saturate or F2I (default). */
`define   GCREG_SHADER_MISC_CONFIG_CONVERT_NAN_ZERO                         1'h0
/* Alias NANs to INF for saturate and F2I.  Bug compatible mode with previous **
** chips.                                                                     */
`define   GCREG_SHADER_MISC_CONFIG_CONVERT_NAN_INFINITY                     1'h1

/* Select the shift count for relative addressing (GPGPU). A value of 0       **
** serves as the compatibility mode. In this mode, a0/aL just gets added to   **
** the Local Storage address. Any other value means that the 9-bit Local      **
** Storage address Gets shifted by this many bits to index the proper region  **
** inside Local Storage for the workgroup.                                    */
`define GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_OFFSET_SHIFT_MSB                  7
`define GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_OFFSET_SHIFT_LSB                  4
`define GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_OFFSET_SHIFT_SIZE                 4

`define GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_INDEX_STRIDE_MSB                  9
`define GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_INDEX_STRIDE_LSB                  8
`define GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_INDEX_STRIDE_SIZE                 2
/* a0/aL strides are register wide. */
`define   GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_INDEX_STRIDE_COMPATIBLE      2'h0
/* a0/aL strides are based on the instruction type (1, 2, or 4 bytes). */
`define   GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_INDEX_STRIDE_ADAPTIVE        2'h1
/* a0/aL strides are 1 byte. */
`define   GCREG_SHADER_MISC_CONFIG_LS_RELATIVE_INDEX_STRIDE_BYTE            2'h2

/* PixelOverlapInterlock. */
`define GCREG_SHADER_MISC_CONFIG_PIXEL_OVERLAP_INTERLOCK_MSB                  10
`define GCREG_SHADER_MISC_CONFIG_PIXEL_OVERLAP_INTERLOCK_LSB                  10
`define GCREG_SHADER_MISC_CONFIG_PIXEL_OVERLAP_INTERLOCK_SIZE                  1
`define   GCREG_SHADER_MISC_CONFIG_PIXEL_OVERLAP_INTERLOCK_ENABLE           1'h1
`define   GCREG_SHADER_MISC_CONFIG_PIXEL_OVERLAP_INTERLOCK_DISABLE          1'h0

/* Specifies if  vertex shader instruction has RT_query. */
`define GCREG_SHADER_MISC_CONFIG_VS_RTQUERY_MSB                               11
`define GCREG_SHADER_MISC_CONFIG_VS_RTQUERY_LSB                               11
`define GCREG_SHADER_MISC_CONFIG_VS_RTQUERY_SIZE                               1
`define   GCREG_SHADER_MISC_CONFIG_VS_RTQUERY_ENABLE                        1'h1
`define   GCREG_SHADER_MISC_CONFIG_VS_RTQUERY_DISABLE                       1'h0

/* Specifies if  tessellation control shader instruction has RT_query. */
`define GCREG_SHADER_MISC_CONFIG_TCS_RTQUERY_MSB                              12
`define GCREG_SHADER_MISC_CONFIG_TCS_RTQUERY_LSB                              12
`define GCREG_SHADER_MISC_CONFIG_TCS_RTQUERY_SIZE                              1
`define   GCREG_SHADER_MISC_CONFIG_TCS_RTQUERY_ENABLE                       1'h1
