/* Hardware native debug stop unit, it includes ShaderGroup, WorkGroup,       **
** Cluster.                                                                   */
`define GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_UNIT_MSB                            2
`define GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_UNIT_LSB                            1
`define GCREG_HW_NATIVE_DEBUG_CONTROL_STOP_UNIT_SIZE                           2
