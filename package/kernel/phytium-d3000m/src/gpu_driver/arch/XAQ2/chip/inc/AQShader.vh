`define GCREG_SHADER_STATIC_DUAL_ISSUE_LSB                                     8
`define GCREG_SHADER_STATIC_DUAL_ISSUE_SIZE                                    1
`define   GCREG_SHADER_STATIC_DUAL_ISSUE_DISABLE                            1'h0
`define   GCREG_SHADER_STATIC_DUAL_ISSUE_ENABLE                             1'h1

/* Control whether two-group fast reissue is enabled or disabled */
`define GCREG_SHADER_STATIC_TWO_GROUP_FAST_REISSUE_MSB                         9
`define GCREG_SHADER_STATIC_TWO_GROUP_FAST_REISSUE_LSB                         9
`define GCREG_SHADER_STATIC_TWO_GROUP_FAST_REISSUE_SIZE                        1
`define   GCREG_SHADER_STATIC_TWO_GROUP_FAST_REISSUE_DISABLE                1'h0
`define   GCREG_SHADER_STATIC_TWO_GROUP_FAST_REISSUE_ENABLE                 1'h1

/* Control whether temp register bank swap is enabled or disabled */
