/* NAN. */
`define   GCREG_ASYNC_COPY_DESCRIPTOR_OOB_FILL_NAN                          1'h1

/* Reduce opcode. */
`define GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_MSB                             16
`define GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_LSB                             14
`define GCREG_ASYNC_COPY_DESCRIPTOR_REDUCE_OP_SIZE                             3
/* Add. */
