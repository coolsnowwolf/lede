/* Register AQPixelShaderColorOut **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* register selection for each of the supported render targets. */

`define AQPixelShaderColorOutRegAddrs                                   16'h0401
`define AQ_PIXEL_SHADER_COLOR_OUT_MSB                                         15
`define AQ_PIXEL_SHADER_COLOR_OUT_LSB                                          0
`define AQ_PIXEL_SHADER_COLOR_OUT_BLK                                          0
`define AQ_PIXEL_SHADER_COLOR_OUT_Count                                        1
`define AQ_PIXEL_SHADER_COLOR_OUT_FieldMask                         32'h3F3F3F3F
`define AQ_PIXEL_SHADER_COLOR_OUT_ReadMask                          32'h3F3F3F3F
`define AQ_PIXEL_SHADER_COLOR_OUT_WriteMask                         32'h3F3F3F3F
`define AQ_PIXEL_SHADER_COLOR_OUT_ResetValue                        32'h00000000

/* This temporary register specified by this field will be sent to the PE as  **
** the data for render target 0.  In PSPrecision=Medium mode, this is used if **
** render target 0 is medium precision or for thread t0 if render target 0 is **
** high precision.                                                            */
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS_MSB                                  5
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS_LSB                                  0
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS_SIZE                                 6

/* This temporary register specified by this field will be sent to the PE as  **
** the data for render target 1.  In PSPrecision=Medium mode, this is used if **
** render target 1 is medium precision or for thread t0 if render target 1 is **
** high precision.                                                            */
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS1_MSB                                13
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS1_LSB                                 8
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS1_SIZE                                6

/* This temporary register specified by this field will be sent to the PE as  **
** the data for render target 2.  In PSPrecision=Medium mode, this is used if **
** render target 2 is medium precision or for thread t0 if render target 2 is **
** high precision.                                                            */
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS2_MSB                                21
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS2_LSB                                16
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS2_SIZE                                6

/* This temporary register specified by this field will be sent to the PE as  **
** the data for render target 3.  In PSPrecision=Medium mode, this is used if **
** render target 3 is medium precision or for thread t0 if render target 3 is **
** high precision.                                                            */
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS3_MSB                                29
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS3_LSB                                24
`define AQ_PIXEL_SHADER_COLOR_OUT_ADDRESS3_SIZE                                6

/* Register AQPixelShaderInputControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQPixelShaderInputControlRegAddrs                               16'h0402
`define AQ_PIXEL_SHADER_INPUT_CONTROL_MSB                                     15
`define AQ_PIXEL_SHADER_INPUT_CONTROL_LSB                                      0
`define AQ_PIXEL_SHADER_INPUT_CONTROL_BLK                                      0
`define AQ_PIXEL_SHADER_INPUT_CONTROL_Count                                    1
`define AQ_PIXEL_SHADER_INPUT_CONTROL_FieldMask                     32'hFF9F1F3F
`define AQ_PIXEL_SHADER_INPUT_CONTROL_ReadMask                      32'hFF9F1F3F
`define AQ_PIXEL_SHADER_INPUT_CONTROL_WriteMask                     32'hFF9F1F3F
`define AQ_PIXEL_SHADER_INPUT_CONTROL_ResetValue                    32'h00000000

/* This count should match the number of cycles of data sent from the RA.  In **
** multisample mode, this value must be 1 larger than the value derived       **
** purely from the program because of the additional cycle needed to transfer **
** multisample depth.                                                         */
`define AQ_PIXEL_SHADER_INPUT_CONTROL_COUNT_MSB                                5
`define AQ_PIXEL_SHADER_INPUT_CONTROL_COUNT_LSB                                0
`define AQ_PIXEL_SHADER_INPUT_CONTROL_COUNT_SIZE                               6

/* The shader may wait for a number of quads to arrive before executing       **
** because the internal execution granularity can be much larger than a quad. **
**  The shader will stop waiting and start executing after 16 times this many **
** cycles have elapsed without receiving anything.                            */
`define AQ_PIXEL_SHADER_INPUT_CONTROL_TIMEOUT_MSB                             12
`define AQ_PIXEL_SHADER_INPUT_CONTROL_TIMEOUT_LSB                              8
`define AQ_PIXEL_SHADER_INPUT_CONTROL_TIMEOUT_SIZE                             5

/* This count corresponds to the number of high precision varyings present as **
** inputs to the pixel shader.  The compiler must guarantee that all high     **
** precision varyings are packed as the first N varyings.                     */
`define AQ_PIXEL_SHADER_INPUT_CONTROL_HIGHP_VARYINGS_COUNT_MSB                20
`define AQ_PIXEL_SHADER_INPUT_CONTROL_HIGHP_VARYINGS_COUNT_LSB                16
`define AQ_PIXEL_SHADER_INPUT_CONTROL_HIGHP_VARYINGS_COUNT_SIZE                5

`define AQ_PIXEL_SHADER_INPUT_CONTROL_POS_HPVECFMT_MSB                        23
`define AQ_PIXEL_SHADER_INPUT_CONTROL_POS_HPVECFMT_LSB                        23
`define AQ_PIXEL_SHADER_INPUT_CONTROL_POS_HPVECFMT_SIZE                        1
`define   AQ_PIXEL_SHADER_INPUT_CONTROL_POS_HPVECFMT_HPV4                   1'h0
`define   AQ_PIXEL_SHADER_INPUT_CONTROL_POS_HPVECFMT_HPV2                   1'h1

/* If PSPrecision=Medium, the position info can be packed into an opaque      **
** mediump footprint (1 temp register), thereby reducing the PS register      **
** usage and improving latency tolerance; however, this adds the              **
** restriction/requirement that position cannot be read or written by the     **
** shader program.  If the shader program satisfies this requirement,         **
** HighpPosition should be set to Disable; otherwise, HighpPosition should be **
** set to Enable, thereby increasing the number of temp registers required    **
** for position to two.  This field is a don't care if PSPrecision=High.      */
`define AQ_PIXEL_SHADER_INPUT_CONTROL_HIGHP_POSITION_MSB                      24
`define AQ_PIXEL_SHADER_INPUT_CONTROL_HIGHP_POSITION_LSB                      24
`define AQ_PIXEL_SHADER_INPUT_CONTROL_HIGHP_POSITION_SIZE                      1
`define   AQ_PIXEL_SHADER_INPUT_CONTROL_HIGHP_POSITION_ENABLE               1'h1
`define   AQ_PIXEL_SHADER_INPUT_CONTROL_HIGHP_POSITION_DISABLE              1'h0

/* This bit control if enable pixel shader input stall */
`define AQ_PIXEL_SHADER_INPUT_CONTROL_PIXEL_INPUT_STALL_MSB                   25
`define AQ_PIXEL_SHADER_INPUT_CONTROL_PIXEL_INPUT_STALL_LSB                   25
`define AQ_PIXEL_SHADER_INPUT_CONTROL_PIXEL_INPUT_STALL_SIZE                   1
`define   AQ_PIXEL_SHADER_INPUT_CONTROL_PIXEL_INPUT_STALL_ENABLE            1'h1
`define   AQ_PIXEL_SHADER_INPUT_CONTROL_PIXEL_INPUT_STALL_DISABLE           1'h0

/* This is the Stall cycle count when input stall is enable The stall cycle   **
** is programmed count * 8 the programmed count is at least 4                 */
`define AQ_PIXEL_SHADER_INPUT_CONTROL_PIXEL_INPUT_STALL_COUNT_MSB             30
`define AQ_PIXEL_SHADER_INPUT_CONTROL_PIXEL_INPUT_STALL_COUNT_LSB             26
`define AQ_PIXEL_SHADER_INPUT_CONTROL_PIXEL_INPUT_STALL_COUNT_SIZE             5

`define AQ_PIXEL_SHADER_INPUT_CONTROL_SUBSAMPLE_HPVECFMT_MSB                  31
`define AQ_PIXEL_SHADER_INPUT_CONTROL_SUBSAMPLE_HPVECFMT_LSB                  31
`define AQ_PIXEL_SHADER_INPUT_CONTROL_SUBSAMPLE_HPVECFMT_SIZE                  1
`define   AQ_PIXEL_SHADER_INPUT_CONTROL_SUBSAMPLE_HPVECFMT_HPV4             1'h0
`define   AQ_PIXEL_SHADER_INPUT_CONTROL_SUBSAMPLE_HPVECFMT_HPV2             1'h1

/* Register AQPixelShaderTemporaryRegisterControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQPixelShaderTemporaryRegisterControlRegAddrs                   16'h0403
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_MSB                        15
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_LSB                         0
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_BLK                         0
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_Count                       1
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_FieldMask        32'hC000007F
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_ReadMask         32'hC000007F
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_WriteMask        32'hC000007F
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_ResetValue       32'h00000000

/* This specifies the number of temporary registers to allocate for each      **
** pixel.  The inclusive temporary register range that may be used by this    **
** pixel is r[0] to r[AQPixelShaderTemporaryRegisterControl.Count-1].  In     **
** multisample mode, this value must be 1 larger than the value derived       **
** purely from the program because the multisample depth value is             **
** automatically placed at the end of the range.                              */
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_COUNT_MSB                   6
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_COUNT_LSB                   0
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_COUNT_SIZE                  7

/* Sub Sample Mask Location */
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_SUB_SAMPLE_MASK_LOCATION_MSB 31
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_SUB_SAMPLE_MASK_LOCATION_LSB 30
`define AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_SUB_SAMPLE_MASK_LOCATION_SIZE 2
/* sub sample Mask is in sub sample depth register. */
`define   AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_SUB_SAMPLE_MASK_LOCATION_SUB_Z 2'h0
/* sub sample Mask is in Z register. */
`define   AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_SUB_SAMPLE_MASK_LOCATION_Z 2'h1
/* sub sample Mask is in W register. */
`define   AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_SUB_SAMPLE_MASK_LOCATION_W 2'h2
/* sub sample Mask is in smask register. */
`define   AQ_PIXEL_SHADER_TEMPORARY_REGISTER_CONTROL_SUB_SAMPLE_MASK_LOCATION_SMASK 2'h3

/* Register AQPixelShaderControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQPixelShaderControlRegAddrs                                    16'h0404
`define AQ_PIXEL_SHADER_CONTROL_MSB                                           15
`define AQ_PIXEL_SHADER_CONTROL_LSB                                            0
`define AQ_PIXEL_SHADER_CONTROL_BLK                                            0
`define AQ_PIXEL_SHADER_CONTROL_Count                                          1
`define AQ_PIXEL_SHADER_CONTROL_FieldMask                           32'h003F1F1F
`define AQ_PIXEL_SHADER_CONTROL_ReadMask                            32'h003F1F1F
`define AQ_PIXEL_SHADER_CONTROL_WriteMask                           32'h003F1F1F
`define AQ_PIXEL_SHADER_CONTROL_ResetValue                          32'h00000000

/* Pixel shading is bypassed when this is enabled.  Data transactions from    **
** the RA pass through the shader to the PE unmodified.  This only works is   **
** MSAA is not enabled.                                                       */
`define AQ_PIXEL_SHADER_CONTROL_BYPASS_SHADING_MSB                             0
`define AQ_PIXEL_SHADER_CONTROL_BYPASS_SHADING_LSB                             0
`define AQ_PIXEL_SHADER_CONTROL_BYPASS_SHADING_SIZE                            1
`define   AQ_PIXEL_SHADER_CONTROL_BYPASS_SHADING_DISABLE                    1'h0
`define   AQ_PIXEL_SHADER_CONTROL_BYPASS_SHADING_ENABLE                     1'h1

/* Enabling this causes the data sent to the PE for render target 0 to be     **
** clamped to :unorm:[0.0f, 1.0f],snorm:[-1.0f, 1.0f].                        */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE_MSB                         1
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE_LSB                         1
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE_SIZE                        1
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE_DISABLE                1'h0
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE_ENABLE                 1'h1

/* Enabling this causes the data sent to the PE for render target 1 to be     **
** clamped to :unorm:[0.0f, 1.0f],snorm:[-1.0f, 1.0f].                        */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE1_MSB                        2
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE1_LSB                        2
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE1_SIZE                       1
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE1_DISABLE               1'h0
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE1_ENABLE                1'h1

/* Enabling this causes the data sent to the PE for render target 2 to be     **
** clamped to :unorm:[0.0f, 1.0f],snorm:[-1.0f, 1.0f].                        */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE2_MSB                        3
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE2_LSB                        3
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE2_SIZE                       1
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE2_DISABLE               1'h0
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE2_ENABLE                1'h1

/* Enabling this causes the data sent to the PE for render target 3 to be     **
** clamped to :unorm:[0.0f, 1.0f],snorm:[-1.0f, 1.0f].                        */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE3_MSB                        4
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE3_LSB                        4
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE3_SIZE                       1
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE3_DISABLE               1'h0
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_SATURATE3_ENABLE                1'h1

/* Number of data sent to the PE - 1.  The shader always starts counting with **
** render target 0, and will end at render target 0 + ColorOutCount.          */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_COUNT_MSB                           11
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_COUNT_LSB                            8
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_COUNT_SIZE                           4

/* Stuff MSAA depth information into sideband. */
`define AQ_PIXEL_SHADER_CONTROL_MSAA_SIDEBAND_MSB                             12
`define AQ_PIXEL_SHADER_CONTROL_MSAA_SIDEBAND_LSB                             12
`define AQ_PIXEL_SHADER_CONTROL_MSAA_SIDEBAND_SIZE                             1
`define   AQ_PIXEL_SHADER_CONTROL_MSAA_SIDEBAND_REGISTERS                   1'h0
`define   AQ_PIXEL_SHADER_CONTROL_MSAA_SIDEBAND_SIDEBAND                    1'h1

/* Alpha channel control for output target 0. */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA0_MSB                          16
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA0_LSB                          16
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA0_SIZE                          1
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA0_USER                     1'h0
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA0_ONE                      1'h1

/* Alpha channel control for output target 1. */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA1_MSB                          17
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA1_LSB                          17
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA1_SIZE                          1
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA1_USER                     1'h0
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA1_ONE                      1'h1

/* Alpha channel control for output target 2. */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA2_MSB                          18
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA2_LSB                          18
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA2_SIZE                          1
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA2_USER                     1'h0
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA2_ONE                      1'h1

/* Alpha channel control for output target 3. */
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA3_MSB                          19
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA3_LSB                          19
`define AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA3_SIZE                          1
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA3_USER                     1'h0
`define   AQ_PIXEL_SHADER_CONTROL_COLOR_OUT_ALPHA3_ONE                      1'h1

/* GLSampleMask is enabled in ps which mean PS output pixel mask = input mask **
** & GLSampleMask                                                             */
`define AQ_PIXEL_SHADER_CONTROL_GL_SAMPLE_MASK_ENABLE_MSB                     20
`define AQ_PIXEL_SHADER_CONTROL_GL_SAMPLE_MASK_ENABLE_LSB                     20
`define AQ_PIXEL_SHADER_CONTROL_GL_SAMPLE_MASK_ENABLE_SIZE                     1
`define   AQ_PIXEL_SHADER_CONTROL_GL_SAMPLE_MASK_ENABLE_DISABLED            1'h0
`define   AQ_PIXEL_SHADER_CONTROL_GL_SAMPLE_MASK_ENABLE_ENABLED             1'h1

/* Decide when to close a PS group. RasterLast is not a production mode; it   **
** is only for making behavior deterministic for verification purposes.       */
`define AQ_PIXEL_SHADER_CONTROL_PS_GROUP_END_CONTROL_MSB                      21
`define AQ_PIXEL_SHADER_CONTROL_PS_GROUP_END_CONTROL_LSB                      21
`define AQ_PIXEL_SHADER_CONTROL_PS_GROUP_END_CONTROL_SIZE                      1
`define   AQ_PIXEL_SHADER_CONTROL_PS_GROUP_END_CONTROL_WAIT_IDLE            1'h0
`define   AQ_PIXEL_SHADER_CONTROL_PS_GROUP_END_CONTROL_RASTER_LAST          1'h1

/* Register AQPixelShaderPerformanceCounter **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQPixelShaderPerformanceCounterRegAddrs                         16'h0405
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_MSB                               15
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_LSB                                0
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_BLK                                0
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_Count                              1
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_FieldMask               32'hFFFFFFFF
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_ReadMask                32'hFFFFFFFF
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_WriteMask               32'hFFFFFFFF
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_ResetValue              32'h00000000

/* This is set with a value from AQPixelShaderPerformanceSel */
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL0_MSB                           7
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL0_LSB                           0
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL0_SIZE                          8

/* This is set with a value from AQPixelShaderPerformanceSel */
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL1_MSB                          15
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL1_LSB                           8
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL1_SIZE                          8

/* This is set with a value from AQPixelShaderPerformanceSel */
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL2_MSB                          23
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL2_LSB                          16
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL2_SIZE                          8

/* This is set with a value from AQPixelShaderPerformanceSel */
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL3_MSB                          31
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL3_LSB                          24
`define AQ_PIXEL_SHADER_PERFORMANCE_COUNTER_SEL3_SIZE                          8

/* Register AQPixelShaderConst (1024 in total) **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* address % 4 == 0 for the x component                1 for the y component  **
**               2 for the z component                3 for the w component   */

`define AQPixelShaderConstRegAddrs                                         6'h07
`define AQ_PIXEL_SHADER_CONST_MSB                                             15
`define AQ_PIXEL_SHADER_CONST_LSB                                             10
`define AQ_PIXEL_SHADER_CONST_BLK                                             10
`define AQ_PIXEL_SHADER_CONST_Count                                         1024
`define AQ_PIXEL_SHADER_CONST_FieldMask                             32'hFFFFFFFF
`define AQ_PIXEL_SHADER_CONST_ReadMask                              32'hFFFFFFFF
`define AQ_PIXEL_SHADER_CONST_WriteMask                             32'hFFFFFFFF
`define AQ_PIXEL_SHADER_CONST_ResetValue                            32'h00000000

`define AQ_PIXEL_SHADER_CONST_VALUE_MSB                                       31
`define AQ_PIXEL_SHADER_CONST_VALUE_LSB                                        0
`define AQ_PIXEL_SHADER_CONST_VALUE_SIZE                                      32

/* Register AQPixelShaderStartPC **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQPixelShaderStartPCRegAddrs                                    16'h0406
`define AQ_PIXEL_SHADER_START_PC_MSB                                          15
`define AQ_PIXEL_SHADER_START_PC_LSB                                           0
`define AQ_PIXEL_SHADER_START_PC_BLK                                           0
`define AQ_PIXEL_SHADER_START_PC_Count                                         1
`define AQ_PIXEL_SHADER_START_PC_FieldMask                          32'h03FF0FFF
`define AQ_PIXEL_SHADER_START_PC_ReadMask                           32'h03FF0FFF
`define AQ_PIXEL_SHADER_START_PC_WriteMask                          32'h03FF0FFF
`define AQ_PIXEL_SHADER_START_PC_ResetValue                         32'h01000000

/* Memory index of the first pixel shader instruction. Every instruction      **
** takes 16 bytes, therefore to compute the actual memory location of a       **
** particular istruction, multiply its memory index by 16. For example, if    **
** shader program starts at instruction 10, set PcOffset field to 10 and the  **
** actual memory location will be 10 * 16 = 160.                              */
`define AQ_PIXEL_SHADER_START_PC_PC_OFFSET_MSB                                11
`define AQ_PIXEL_SHADER_START_PC_PC_OFFSET_LSB                                 0
`define AQ_PIXEL_SHADER_START_PC_PC_OFFSET_SIZE                               12

/* This field is not used; use gcregPixelShaderConst.BaseOffset register      **
** instead.                                                                   */
`define AQ_PIXEL_SHADER_START_PC_CONST_OFFSET_MSB                             25
`define AQ_PIXEL_SHADER_START_PC_CONST_OFFSET_LSB                             16
`define AQ_PIXEL_SHADER_START_PC_CONST_OFFSET_SIZE                            10

/* Register gcregPSProgram **
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* Pixel Shader program location register. Used together with gcregVSProgram, **
** gcregVSShaderCode and gcregPSShaderCode registers.                         */

`define gcregPSProgramRegAddrs                                          16'h0407
`define GCREG_PS_PROGRAM_MSB                                                  15
`define GCREG_PS_PROGRAM_LSB                                                   0
`define GCREG_PS_PROGRAM_BLK                                                   0
`define GCREG_PS_PROGRAM_Count                                                 1
`define GCREG_PS_PROGRAM_FieldMask                                  32'hFFFFFFFF
`define GCREG_PS_PROGRAM_ReadMask                                   32'hFFFFFFFF
`define GCREG_PS_PROGRAM_WriteMask                                  32'hFFFFFFFF
`define GCREG_PS_PROGRAM_ResetValue                                 32'h00000100

/* The address of the first instruction. */
`define GCREG_PS_PROGRAM_START_MSB                                            15
`define GCREG_PS_PROGRAM_START_LSB                                             0
`define GCREG_PS_PROGRAM_START_SIZE                                           16

/* The address of the last instruction. */
`define GCREG_PS_PROGRAM_END_MSB                                              31
`define GCREG_PS_PROGRAM_END_LSB                                              16
`define GCREG_PS_PROGRAM_END_SIZE                                             16

/* Register gcregOCLFeatureControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define gcregOCLFeatureControlRegAddrs                                  16'h0408
`define GCREG_OCL_FEATURE_CONTROL_MSB                                         15
`define GCREG_OCL_FEATURE_CONTROL_LSB                                          0
`define GCREG_OCL_FEATURE_CONTROL_BLK                                          0
`define GCREG_OCL_FEATURE_CONTROL_Count                                        1
`define GCREG_OCL_FEATURE_CONTROL_FieldMask                         32'h00000001
`define GCREG_OCL_FEATURE_CONTROL_ReadMask                          32'h00000001
`define GCREG_OCL_FEATURE_CONTROL_WriteMask                         32'h00000001
`define GCREG_OCL_FEATURE_CONTROL_ResetValue                        32'h00000001

/* When set Enables broadcast logic in local storage registers */
`define GCREG_OCL_FEATURE_CONTROL_ENABLE_LS_BROADCAST_MSB                      0
`define GCREG_OCL_FEATURE_CONTROL_ENABLE_LS_BROADCAST_LSB                      0
`define GCREG_OCL_FEATURE_CONTROL_ENABLE_LS_BROADCAST_SIZE                     1
`define   GCREG_OCL_FEATURE_CONTROL_ENABLE_LS_BROADCAST_DISABLE             1'h0
`define   GCREG_OCL_FEATURE_CONTROL_ENABLE_LS_BROADCAST_ENABLE              1'h1

/* Register gcregPixelShaderConst **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define gcregPixelShaderConstRegAddrs                                   16'h0409
`define GCREG_PIXEL_SHADER_CONST_MSB                                          15
`define GCREG_PIXEL_SHADER_CONST_LSB                                           0
`define GCREG_PIXEL_SHADER_CONST_BLK                                           0
`define GCREG_PIXEL_SHADER_CONST_Count                                         1
`define GCREG_PIXEL_SHADER_CONST_FieldMask                          32'h000003FF
`define GCREG_PIXEL_SHADER_CONST_ReadMask                           32'h000003FF
`define GCREG_PIXEL_SHADER_CONST_WriteMask                          32'h000003FF
`define GCREG_PIXEL_SHADER_CONST_ResetValue                         32'h00000100

/* Memory index of the first pixel shader constant register. Every constant   **
** register takes 16 bytes, therefore to compute the actual memory location   **
** of a particular constant register, multiply its memory index by 16. For    **
** example, if constant bank starts at constant register 10, set BaseOffset   **
** field to 10 and the actual memory location will be 10 * 16 = 160.          */
`define GCREG_PIXEL_SHADER_CONST_BASE_OFFSET_MSB                               9
`define GCREG_PIXEL_SHADER_CONST_BASE_OFFSET_LSB                               0
`define GCREG_PIXEL_SHADER_CONST_BASE_OFFSET_SIZE                             10

/* Register gcregPSInstruction **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Address of the shader program. The program buffer needs to be 256-byte     **
** aligned in both starting address and size. But it is possible to point all **
** the shaders to the same address and use the gcregVSProgram and             **
** gcregPSProgram states to program the proper starting instruction.          */

`define gcregPSInstructionRegAddrs                                      16'h040A
`define GCREG_PS_INSTRUCTION_MSB                                              15
`define GCREG_PS_INSTRUCTION_LSB                                               0
`define GCREG_PS_INSTRUCTION_BLK                                               0
`define GCREG_PS_INSTRUCTION_Count                                             1
`define GCREG_PS_INSTRUCTION_FieldMask                              32'hFFFFFFFF
`define GCREG_PS_INSTRUCTION_ReadMask                               32'hFFFFFF00
`define GCREG_PS_INSTRUCTION_WriteMask                              32'hFFFFFF00
`define GCREG_PS_INSTRUCTION_ResetValue                             32'h00000000

/* 256-byte aligned address. */
`define GCREG_PS_INSTRUCTION_ADDRESS_MSB                                      31
`define GCREG_PS_INSTRUCTION_ADDRESS_LSB                                       0
`define GCREG_PS_INSTRUCTION_ADDRESS_SIZE                                     32

/* Register gcregPSOutputControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Control the Pixel Shader output for MRT's 4 through 7. */

`define gcregPSOutputControlRegAddrs                                    16'h040B
`define GCREG_PS_OUTPUT_CONTROL_MSB                                           15
`define GCREG_PS_OUTPUT_CONTROL_LSB                                            0
`define GCREG_PS_OUTPUT_CONTROL_BLK                                            0
`define GCREG_PS_OUTPUT_CONTROL_Count                                          1
`define GCREG_PS_OUTPUT_CONTROL_FieldMask                           32'hFFFFFFFF
`define GCREG_PS_OUTPUT_CONTROL_ReadMask                            32'hFFFFFFFF
`define GCREG_PS_OUTPUT_CONTROL_WriteMask                           32'hFFFFFFFF
`define GCREG_PS_OUTPUT_CONTROL_ResetValue                          32'h00000000

/* This temporary register specified by this field will be sent to the PE as  **
** the data for render target 4.  In PSPrecision=Medium mode, this is used if **
** render target 4 is medium precision or for thread t0 if render target 4 is **
** high precision.                                                            */
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT4_MSB                                    5
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT4_LSB                                    0
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT4_SIZE                                   6

/* Alpha control for MRT 4. */
`define GCREG_PS_OUTPUT_CONTROL_ALPHA4_MSB                                     6
`define GCREG_PS_OUTPUT_CONTROL_ALPHA4_LSB                                     6
`define GCREG_PS_OUTPUT_CONTROL_ALPHA4_SIZE                                    1
`define   GCREG_PS_OUTPUT_CONTROL_ALPHA4_USER                               1'h0
`define   GCREG_PS_OUTPUT_CONTROL_ALPHA4_ONE                                1'h1

/* Enable output saturation for render target 4. */
`define GCREG_PS_OUTPUT_CONTROL_SATURATE4_MSB                                  7
`define GCREG_PS_OUTPUT_CONTROL_SATURATE4_LSB                                  7
`define GCREG_PS_OUTPUT_CONTROL_SATURATE4_SIZE                                 1

/* This temporary register specified by this field will be sent to the PE as  **
** the data for render target 5.  In PSPrecision=Medium mode, this is used if **
** render target 5 is medium precision or for thread t0 if render target 5 is **
** high precision.                                                            */
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT5_MSB                                   13
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT5_LSB                                    8
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT5_SIZE                                   6

/* Alpha control for MRT 5. */
`define GCREG_PS_OUTPUT_CONTROL_ALPHA5_MSB                                    14
`define GCREG_PS_OUTPUT_CONTROL_ALPHA5_LSB                                    14
`define GCREG_PS_OUTPUT_CONTROL_ALPHA5_SIZE                                    1
`define   GCREG_PS_OUTPUT_CONTROL_ALPHA5_USER                               1'h0
`define   GCREG_PS_OUTPUT_CONTROL_ALPHA5_ONE                                1'h1

/* Enable output saturation for render target 5. */
`define GCREG_PS_OUTPUT_CONTROL_SATURATE5_MSB                                 15
`define GCREG_PS_OUTPUT_CONTROL_SATURATE5_LSB                                 15
`define GCREG_PS_OUTPUT_CONTROL_SATURATE5_SIZE                                 1

/* This temporary register specified by this field will be sent to the PE as  **
** the data for render target 6.  In PSPrecision=Medium mode, this is used if **
** render target 6 is medium precision or for thread t0 if render target 6 is **
** high precision.                                                            */
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT6_MSB                                   21
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT6_LSB                                   16
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT6_SIZE                                   6

/* Alpha control for MRT 6. */
`define GCREG_PS_OUTPUT_CONTROL_ALPHA6_MSB                                    22
`define GCREG_PS_OUTPUT_CONTROL_ALPHA6_LSB                                    22
`define GCREG_PS_OUTPUT_CONTROL_ALPHA6_SIZE                                    1
`define   GCREG_PS_OUTPUT_CONTROL_ALPHA6_USER                               1'h0
`define   GCREG_PS_OUTPUT_CONTROL_ALPHA6_ONE                                1'h1

/* Enable output saturation for render target 6. */
`define GCREG_PS_OUTPUT_CONTROL_SATURATE6_MSB                                 23
`define GCREG_PS_OUTPUT_CONTROL_SATURATE6_LSB                                 23
`define GCREG_PS_OUTPUT_CONTROL_SATURATE6_SIZE                                 1

/* This temporary register specified by this field will be sent to the PE as  **
** the data for render target 7.  In PSPrecision=Medium mode, this is used if **
** render target 7 is medium precision or for thread t0 if render target 7 is **
** high precision.                                                            */
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT7_MSB                                   29
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT7_LSB                                   24
`define GCREG_PS_OUTPUT_CONTROL_OUTPUT7_SIZE                                   6

/* Alpha control for MRT 7. */
`define GCREG_PS_OUTPUT_CONTROL_ALPHA7_MSB                                    30
`define GCREG_PS_OUTPUT_CONTROL_ALPHA7_LSB                                    30
`define GCREG_PS_OUTPUT_CONTROL_ALPHA7_SIZE                                    1
`define   GCREG_PS_OUTPUT_CONTROL_ALPHA7_USER                               1'h0
`define   GCREG_PS_OUTPUT_CONTROL_ALPHA7_ONE                                1'h1

/* Enable output saturation for render target 7. */
`define GCREG_PS_OUTPUT_CONTROL_SATURATE7_MSB                                 31
`define GCREG_PS_OUTPUT_CONTROL_SATURATE7_LSB                                 31
`define GCREG_PS_OUTPUT_CONTROL_SATURATE7_SIZE                                 1

/* Register gcregPSOutputMode **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Control the Pixel Shader color output conversion for each MRT. */

`define gcregPSOutputModeRegAddrs                                       16'h040C
`define GCREG_PS_OUTPUT_MODE_MSB                                              15
`define GCREG_PS_OUTPUT_MODE_LSB                                               0
`define GCREG_PS_OUTPUT_MODE_BLK                                               0
`define GCREG_PS_OUTPUT_MODE_Count                                             1
`define GCREG_PS_OUTPUT_MODE_FieldMask                              32'hFFFFFFFF
`define GCREG_PS_OUTPUT_MODE_ReadMask                               32'hFFFFFFFF
`define GCREG_PS_OUTPUT_MODE_WriteMask                              32'hFFFFFFFF
`define GCREG_PS_OUTPUT_MODE_ResetValue                             32'h00000000

