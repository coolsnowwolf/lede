/* Register gcregShaderMiscConfig **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Shader configuration register. */

`define gcregShaderMiscConfigRegAddrs                                   16'h5580
`define GCREG_SHADER_MISC_CONFIG_MSB                                          15
`define GCREG_SHADER_MISC_CONFIG_LSB                                           0
`define GCREG_SHADER_MISC_CONFIG_BLK                                           0
