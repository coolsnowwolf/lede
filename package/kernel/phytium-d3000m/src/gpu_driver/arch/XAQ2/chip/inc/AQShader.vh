`define GCREG_PS_TRIGGER_NN_COMMAND_BUFFER_ADDR_MSB                           31
`define GCREG_PS_TRIGGER_NN_COMMAND_BUFFER_ADDR_LSB                            6
`define GCREG_PS_TRIGGER_NN_COMMAND_BUFFER_ADDR_SIZE                          26

