/* Offset AQVertexShaderPerformance
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

`define AQ_VERTEX_SHADER_PERFORMANCE_SEL_MSB                                   7
`define AQ_VERTEX_SHADER_PERFORMANCE_SEL_LSB                                   0
`define AQ_VERTEX_SHADER_PERFORMANCE_SEL_SIZE                                  8
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_NONE                            8'h00
/* The ready used for the sh2tx counters do not look at the sideband fifo     **
** status.  The sideband fifo should never be full, so this will still give   **
** an accurate count                                                          */
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_SH2TX_VALID__AND_READY_         8'h01
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_SH2TX_VALID__AND_READY          8'h02
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_SH2TX_VALID_AND_READY_          8'h03
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_SH2TX_VALID_AND_READY           8'h04
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TX2SH_VALID__AND_READY_         8'h05
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TX2SH_VALID__AND_READY          8'h06
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TX2SH_VALID_AND_READY_          8'h07
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TX2SH_VALID_AND_READY           8'h08
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_SH2PA_VALID__AND_READY_         8'h09
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_SH2PA_VALID__AND_READY          8'h0A
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_SH2PA_VALID_AND_READY_          8'h0B
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_SH2PA_VALID_AND_READY           8'h0C
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_FE2SH_VALID__AND_READY_         8'h0D
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_FE2SH_VALID__AND_READY          8'h0E
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_FE2SH_VALID_AND_READY_          8'h0F
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_FE2SH_VALID_AND_READY           8'h10
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TEXTURE_REQUEST_FIFO_ALMOST_FULL 8'h11
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TEXTURE_SIDEBAND_FIFO_FULL      8'h12
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TEXTURE_RETURN_CHECK_FIFO_FULL  8'h13
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_STATE_LOAD_TO_DATA_WAIT_FOR_IDLE 8'h14
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_DATA_TO_STATE_LOAD_WAIT_FOR_IDLE 8'h15
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_STATE_LOAD_TO_DATA_TRANSITIONS  8'h16
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_STATE_LOADS                     8'h17
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_VERTEX_CACHE_HITS               8'h18
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_VERTEX_CACHE_MISSES             8'h19
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_INPUT_ATTRIBUTES                8'h1A
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_INPUT_TIMEOUTS                  8'h1B
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_WRITE_GENERATE_ATTRIBUTES       8'h1C
/* All of the groups that still need to execute more instructions are         **
** suspended waiting for texture data.  This is the status for the entire     **
** shader.                                                                    */
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_ALL_UNFINISHED_GROUPS_WAITING_FOR_TEXTURE 8'h1D
/* There are pending texture requests but no instructions are executing.      **
** This is the status for the entire shader.                                  */
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_PENDING_TEXTURES_WITHOUT_INSTRUCTION_EXECUTION 8'h1E
/* This is the count divided by the smallest power of 2 number >= the number  **
** of cores.                                                                  */
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_INSTRUCTIONS_EXECUTED           8'h1F
/* This is the number of instructions executed for an entire group.  It       **
** increments by 1 regardless of how many vertices in the group needed that   **
** instruction                                                                */
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_GROUP_INSTRUCTIONS_EXECUTED     8'h20
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_OUTPUT_BUFFER_BANK_COLLISIONS   8'h21
/* The only available groups are texture loads, and the texture request fifo  **
** is full                                                                    */
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TEXTURE_REQUEST_FIFO_LIMITED    8'h22
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_GROUPS                          8'h23
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_VERTICES                        8'h24
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_HALF_GROUPS_OR_PAGES_IN_USE     8'h25
/* This is the SH busy not the VS busy. */
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_BUSY                            8'h26
/* This does not include discarded texture loads. */
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_TEXTURE_LOADS                   8'h27
`define   AQ_VERTEX_SHADER_PERFORMANCE_SEL_DISCARDED_TEXTURE_LOADS         8'h28

