/* Register gcregSHSamplerArbitration **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Specify the arbitration policy for texture instructions. More consecutive  **
** groups to the same texture sampler improves texture cache locality, thus   **
** potentially improving both the texture cache hit-rate and the row-bank     **
** locality of misses. Too many groups issued out-of-order could potentially  **
** introduce de-pipelining. To balance these goals, this state specifies for  **
** texture loads, the maximum number of consecutive out-of-order groups       **
** issued to the same texture sampler.                                        */

`define gcregSHSamplerArbitrationRegAddrs                               16'h0221
`define GCREG_SH_SAMPLER_ARBITRATION_MSB                                      15
`define GCREG_SH_SAMPLER_ARBITRATION_LSB                                       0
`define GCREG_SH_SAMPLER_ARBITRATION_BLK                                       0
`define GCREG_SH_SAMPLER_ARBITRATION_Count                                     1
`define GCREG_SH_SAMPLER_ARBITRATION_FieldMask                      32'h00003F3F
`define GCREG_SH_SAMPLER_ARBITRATION_ReadMask                       32'h00003F3F
`define GCREG_SH_SAMPLER_ARBITRATION_WriteMask                      32'h00003F3F
`define GCREG_SH_SAMPLER_ARBITRATION_ResetValue                     32'h00000000

/* Maximum number of PS groups issued out-of-order to the same sampler. 0     **
** enforces in-order (previous behavior). 63 removes the out-of-order limit   **
** completely.                                                                */
`define GCREG_SH_SAMPLER_ARBITRATION_PS_GROUP_LIMIT_MSB                        5
`define GCREG_SH_SAMPLER_ARBITRATION_PS_GROUP_LIMIT_LSB                        0
`define GCREG_SH_SAMPLER_ARBITRATION_PS_GROUP_LIMIT_SIZE                       6
/* No out-of-order execution of groups for texlds. */
`define   GCREG_SH_SAMPLER_ARBITRATION_PS_GROUP_LIMIT_IN_ORDER             6'h00
/* No limit to the number of out-of-order groups. */
`define   GCREG_SH_SAMPLER_ARBITRATION_PS_GROUP_LIMIT_UNLIMITED            6'h3F

/* Maximum number of VS groups issued out-of-order to the same sampler.       **
** Unimplemented on 5.2.3. 0 enforces in-order (previous behavior). 63        **
** removes the out-of-order limit completely.                                 */
`define GCREG_SH_SAMPLER_ARBITRATION_VS_GROUP_LIMIT_MSB                       13
`define GCREG_SH_SAMPLER_ARBITRATION_VS_GROUP_LIMIT_LSB                        8
`define GCREG_SH_SAMPLER_ARBITRATION_VS_GROUP_LIMIT_SIZE                       6
/* No out-of-order execution of groups for texlds. */
`define   GCREG_SH_SAMPLER_ARBITRATION_VS_GROUP_LIMIT_IN_ORDER             6'h00
/* No limit to the number of out-of-order groups. */
`define   GCREG_SH_SAMPLER_ARBITRATION_VS_GROUP_LIMIT_UNLIMITED            6'h3F

/* Register gcregSHPowerManagement **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Specify the power-management policies for vertex shader and pixel shader,  **
** specifically how many cores should be allowed to be active for each.       */

`define gcregSHPowerManagementRegAddrs                                  16'h0222
`define GCREG_SH_POWER_MANAGEMENT_MSB                                         15
`define GCREG_SH_POWER_MANAGEMENT_LSB                                          0
`define GCREG_SH_POWER_MANAGEMENT_BLK                                          0
`define GCREG_SH_POWER_MANAGEMENT_Count                                        1
`define GCREG_SH_POWER_MANAGEMENT_FieldMask                         32'h00000077
`define GCREG_SH_POWER_MANAGEMENT_ReadMask                          32'h00000077
`define GCREG_SH_POWER_MANAGEMENT_WriteMask                         32'h00000077
`define GCREG_SH_POWER_MANAGEMENT_ResetValue                        32'h00000077

/* Number of cores - 1 to enable when executing PS shaders. 7 allows all      **
** cores to be active.                                                        */
`define GCREG_SH_POWER_MANAGEMENT_PS_ACTIVE_CORES_MSB                          2
`define GCREG_SH_POWER_MANAGEMENT_PS_ACTIVE_CORES_LSB                          0
`define GCREG_SH_POWER_MANAGEMENT_PS_ACTIVE_CORES_SIZE                         3
`define   GCREG_SH_POWER_MANAGEMENT_PS_ACTIVE_CORES_ALL                     3'h7

/* Number of cores - 1 to enable when executing VS shaders. 7 allows all      **
** cores to be active.                                                        */
`define GCREG_SH_POWER_MANAGEMENT_VS_ACTIVE_CORES_MSB                          6
`define GCREG_SH_POWER_MANAGEMENT_VS_ACTIVE_CORES_LSB                          4
`define GCREG_SH_POWER_MANAGEMENT_VS_ACTIVE_CORES_SIZE                         3
`define   GCREG_SH_POWER_MANAGEMENT_VS_ACTIVE_CORES_ALL                     3'h7

