`define   GCREG_SHADER_CONFIG_CONVERT_NAN_INFINITY                          1'h1

/* Bugfix 869. Manage if threads will be stalled when using atomics. */
`define GCREG_SHADER_CONFIG_ATOMIC_ROBUSTNESS_MSB                             31
`define GCREG_SHADER_CONFIG_ATOMIC_ROBUSTNESS_LSB                             31
`define GCREG_SHADER_CONFIG_ATOMIC_ROBUSTNESS_SIZE                             1
/* Full speed. */
`define   GCREG_SHADER_CONFIG_ATOMIC_ROBUSTNESS_DISABLED                    1'h0
/* Stall stores to an L1$ bank if atomic RMWs are in flight for that bank. */
`define   GCREG_SHADER_CONFIG_ATOMIC_ROBUSTNESS_ENABLED                     1'h1

/* Register gcregVertexShaderConst **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define gcregVertexShaderConstRegAddrs                                  16'h0219
