`define   GCREG_SHADER_CONFIG_PIXEL_XY_FRAC_POWER_OPTIMIZATION_DISABLE      1'h1

/* Control the A0 power optimization feature. */
`define GCREG_SHADER_CONFIG_A0_POWER_OPTIMIZATION_MSB                         19
`define GCREG_SHADER_CONFIG_A0_POWER_OPTIMIZATION_LSB                         19
`define GCREG_SHADER_CONFIG_A0_POWER_OPTIMIZATION_SIZE                         1
