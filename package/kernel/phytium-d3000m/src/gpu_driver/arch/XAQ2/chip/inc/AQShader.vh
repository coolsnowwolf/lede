`define GCREG_TW_SHADER_INFO2_WriteMask                             32'hF3F3FFFF
`define GCREG_TW_SHADER_INFO2_ResetValue                            32'h00000000

/* Specifies the number of local storage registers used per work group. */
`define GCREG_TW_SHADER_INFO2_LOCAL_COUNT_MSB                                 15
`define GCREG_TW_SHADER_INFO2_LOCAL_COUNT_LSB                                  0
`define GCREG_TW_SHADER_INFO2_LOCAL_COUNT_SIZE                                16

/* Specifies if shader instruction has barrier. */
`define GCREG_TW_SHADER_INFO2_BARRIER_MSB                                     16
`define GCREG_TW_SHADER_INFO2_BARRIER_LSB                                     16
`define GCREG_TW_SHADER_INFO2_BARRIER_SIZE                                     1
`define   GCREG_TW_SHADER_INFO2_BARRIER_NOT_PRESENT                         1'h1
`define   GCREG_TW_SHADER_INFO2_BARRIER_PRESENT                             1'h0

/* Specifies if a TriggerNN instruction is present in the shader program. */
`define GCREG_TW_SHADER_INFO2_NN_TRIGGER_MSB                                  17
`define GCREG_TW_SHADER_INFO2_NN_TRIGGER_LSB                                  17
`define GCREG_TW_SHADER_INFO2_NN_TRIGGER_SIZE                                  1
`define   GCREG_TW_SHADER_INFO2_NN_TRIGGER_NOT_PRESENT                      1'h1
`define   GCREG_TW_SHADER_INFO2_NN_TRIGGER_PRESENT                          1'h0

/* Specifies the number of consecutive workgroups dispatched to one cluster   **
** before dispatching to the next cluster. Settable: 0 - 63 (for 1 to 64 WG). */
`define GCREG_TW_SHADER_INFO2_WORK_GROUP_IN_CLUSTER_MSB                       25
`define GCREG_TW_SHADER_INFO2_WORK_GROUP_IN_CLUSTER_LSB                       20
`define GCREG_TW_SHADER_INFO2_WORK_GROUP_IN_CLUSTER_SIZE                       6

/* Specifies what value should be exported on the Local ID's W field.  If     **
** Disabled, the Local ID's W field will be written to zero and the           **
** gcregPSCSThrottle throttles for both WorkGroupCountInShaderGroup and the   **
** MaxRunningWorkGroupsMinusOne will be disabled.  The LocalStorageBase       **
** generates a byte-address for use as a base for the current workgroup with  **
** load.local and store.local instructions.  The RunningWorkGroupID generates **
** an ID in the range [0..MaxRunningWorkGroupsMinusOne] local to each         **
** cluster. This ID can be used for creating shared (per-workgroup) spaces or **
** private (per-thread) spaces within global memory.  Prior to v800, if both  **
** LocalStorageBase and RunningWorkGroupID are needed, use RunningWorkGroupID **
** and multiply by gcregTWShaderInfo2.LocalCount*16 within the shader program **
** to generate the LocalStorageBase.  For v800 and beyond, if both            **
** LocalStorageBase and RunningWorkGroupID are needed, use RunningWorkGroupID **
** and multiply by (gcregTWShaderInfo2.LocalCount %                           **
** gcregPSCSThrottle.WorkGroupCountInShaderGroup)*16 within the shader        **
** program to generate the LocalStorageBase.  Note that in the common case of **
** no micro-workgroups, the LocalStorageBase will always be 0 for v800 and    **
** beyond.  v6.3: LocalStorageBase is not small-batch friendly.  Small-batch  **
** barriers should be used before a threadwalker v6.3: trigger which uses     **
** local storage.                                                             */
`define GCREG_TW_SHADER_INFO2_LOCAL_ID_W_MSB                                  29
`define GCREG_TW_SHADER_INFO2_LOCAL_ID_W_LSB                                  28
`define GCREG_TW_SHADER_INFO2_LOCAL_ID_W_SIZE                                  2
`define   GCREG_TW_SHADER_INFO2_LOCAL_ID_W_DISABLED                         2'h0
`define   GCREG_TW_SHADER_INFO2_LOCAL_ID_W_LOCAL_STORAGE_BASE               2'h1
`define   GCREG_TW_SHADER_INFO2_LOCAL_ID_W_RUNNING_WORK_GROUP_ID            2'h2

/* Hight 2 bits for LocalCount. */
`define GCREG_TW_SHADER_INFO2_LOCAL_COUNT_HIGH_TWO_BITS_MSB                   31
`define GCREG_TW_SHADER_INFO2_LOCAL_COUNT_HIGH_TWO_BITS_LSB                   30
`define GCREG_TW_SHADER_INFO2_LOCAL_COUNT_HIGH_TWO_BITS_SIZE                   2

