`define GCREG_SHADER_STATIC_FieldMask                               32'h100007FF
`define GCREG_SHADER_STATIC_ReadMask                                32'h100007FF
`define GCREG_SHADER_STATIC_WriteMask                               32'h100007FF
`define GCREG_SHADER_STATIC_ResetValue                              32'h00000000

/* Control the preswizzle power optimization feature. */
`define GCREG_SHADER_STATIC_PRESWIZZLE_POWER_OPTIMIZATION_MSB                  0
`define GCREG_SHADER_STATIC_PRESWIZZLE_POWER_OPTIMIZATION_LSB                  0
`define GCREG_SHADER_STATIC_PRESWIZZLE_POWER_OPTIMIZATION_SIZE                 1
`define   GCREG_SHADER_STATIC_PRESWIZZLE_POWER_OPTIMIZATION_ENABLE          1'h0
`define   GCREG_SHADER_STATIC_PRESWIZZLE_POWER_OPTIMIZATION_DISABLE         1'h1

/* Control the A0 power optimization feature. */
`define GCREG_SHADER_STATIC_A0_POWER_OPTIMIZATION_MSB                          1
`define GCREG_SHADER_STATIC_A0_POWER_OPTIMIZATION_LSB                          1
`define GCREG_SHADER_STATIC_A0_POWER_OPTIMIZATION_SIZE                         1
`define   GCREG_SHADER_STATIC_A0_POWER_OPTIMIZATION_ENABLE                  1'h0
`define   GCREG_SHADER_STATIC_A0_POWER_OPTIMIZATION_DISABLE                 1'h1

/* CYA for disabling the half-register dependency tracking logic for dual16. */
`define GCREG_SHADER_STATIC_HALF_REGISTER_DEPENDENCY_MSB                       2
`define GCREG_SHADER_STATIC_HALF_REGISTER_DEPENDENCY_LSB                       2
`define GCREG_SHADER_STATIC_HALF_REGISTER_DEPENDENCY_SIZE                      1
`define   GCREG_SHADER_STATIC_HALF_REGISTER_DEPENDENCY_ENABLE               1'h0
`define   GCREG_SHADER_STATIC_HALF_REGISTER_DEPENDENCY_DISABLE              1'h1

/* By default (Enable), we never initialize components of input registers not **
** assigned to a varying. In single32-mode, by setting this bit to Disable,   **
** we have the option to disable this power  optimization by writing zeros to **
** these otherwise uninitialized input registers.  In dual16-mode,  this      **
** power optimization cannot be disabled.                                     */
`define GCREG_SHADER_STATIC_VARYING_PACKING_POWER_OPTIMIZATION_MSB             3
`define GCREG_SHADER_STATIC_VARYING_PACKING_POWER_OPTIMIZATION_LSB             3
`define GCREG_SHADER_STATIC_VARYING_PACKING_POWER_OPTIMIZATION_SIZE            1
`define   GCREG_SHADER_STATIC_VARYING_PACKING_POWER_OPTIMIZATION_ENABLE     1'h0
`define   GCREG_SHADER_STATIC_VARYING_PACKING_POWER_OPTIMIZATION_DISABLE    1'h1

/* Enable/Disable small batch in geometry pipe. */
`define GCREG_SHADER_STATIC_GPIPE_SMALL_BATCH_MSB                              4
`define GCREG_SHADER_STATIC_GPIPE_SMALL_BATCH_LSB                              4
`define GCREG_SHADER_STATIC_GPIPE_SMALL_BATCH_SIZE                             1
`define   GCREG_SHADER_STATIC_GPIPE_SMALL_BATCH_ENABLE                      1'h0
`define   GCREG_SHADER_STATIC_GPIPE_SMALL_BATCH_DISABLE                     1'h1

/* Enable/Disable small batch in pixel pipe. */
`define GCREG_SHADER_STATIC_PIXEL_SMALL_BATCH_MSB                              5
`define GCREG_SHADER_STATIC_PIXEL_SMALL_BATCH_LSB                              5
`define GCREG_SHADER_STATIC_PIXEL_SMALL_BATCH_SIZE                             1
`define   GCREG_SHADER_STATIC_PIXEL_SMALL_BATCH_ENABLE                      1'h0
`define   GCREG_SHADER_STATIC_PIXEL_SMALL_BATCH_DISABLE                     1'h1

/* Enable/Disable snap to page for disabled shader types. */
`define GCREG_SHADER_STATIC_SNAP_DISABLED_STAGES_MSB                           6
`define GCREG_SHADER_STATIC_SNAP_DISABLED_STAGES_LSB                           6
`define GCREG_SHADER_STATIC_SNAP_DISABLED_STAGES_SIZE                          1
`define   GCREG_SHADER_STATIC_SNAP_DISABLED_STAGES_ENABLE                   1'h0
`define   GCREG_SHADER_STATIC_SNAP_DISABLED_STAGES_DISABLE                  1'h1

/* By default (Enable), shader will issue multi work group in one shader      **
** group when the work group. count is less than one shader group if disable  **
** shader will issue one work group in one shader group                       */
`define GCREG_SHADER_STATIC_MULTI_WORK_GROUP_PACK_OPTIMIZATION_MSB             7
`define GCREG_SHADER_STATIC_MULTI_WORK_GROUP_PACK_OPTIMIZATION_LSB             7
`define GCREG_SHADER_STATIC_MULTI_WORK_GROUP_PACK_OPTIMIZATION_SIZE            1
`define   GCREG_SHADER_STATIC_MULTI_WORK_GROUP_PACK_OPTIMIZATION_ENABLE     1'h0
`define   GCREG_SHADER_STATIC_MULTI_WORK_GROUP_PACK_OPTIMIZATION_DISABLE    1'h1

/* Control whether dual-issue is enabled or disabled */
