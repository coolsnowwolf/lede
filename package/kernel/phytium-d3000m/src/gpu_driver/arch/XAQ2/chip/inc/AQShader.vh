`define   GCREG_PS_OUTPUT_MODE_CONTROL0_INTEGER16                           4'h1
`define   GCREG_PS_OUTPUT_MODE_CONTROL0_INTEGER32                           4'h2
`define   GCREG_PS_OUTPUT_MODE_CONTROL0_UNSIGNED8                           4'h3
`define   GCREG_PS_OUTPUT_MODE_CONTROL0_UNSIGNED16                          4'h4
`define   GCREG_PS_OUTPUT_MODE_CONTROL0_SIGNED8                             4'h5
