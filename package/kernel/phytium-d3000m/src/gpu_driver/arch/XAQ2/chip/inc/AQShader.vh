`define   GCREG_SHADER_CONFIG_A0_POWER_OPTIMIZATION_DISABLE                 1'h1

/* Select the shift count for relative addressing (GPGPU). A value of 0       **
** serves as the compatibility mode. In this mode, a0/aL just gets added to   **
** the Local Storage address. Any other value means that the 9-bit Local      **
** Storage address Gets shifted by this many bits to index the proper region  **
** inside Local Storage for the workgroup.                                    */
`define GCREG_SHADER_CONFIG_LS_RELATIVE_OFFSET_SHIFT_MSB                      23
`define GCREG_SHADER_CONFIG_LS_RELATIVE_OFFSET_SHIFT_LSB                      20
`define GCREG_SHADER_CONFIG_LS_RELATIVE_OFFSET_SHIFT_SIZE                      4

`define GCREG_SHADER_CONFIG_LS_RELATIVE_INDEX_STRIDE_MSB                      25
`define GCREG_SHADER_CONFIG_LS_RELATIVE_INDEX_STRIDE_LSB                      24
`define GCREG_SHADER_CONFIG_LS_RELATIVE_INDEX_STRIDE_SIZE                      2
/* a0/aL strides are register wide. */
`define   GCREG_SHADER_CONFIG_LS_RELATIVE_INDEX_STRIDE_COMPATIBLE           2'h0
/* a0/aL strides are based on the instruction type (1, 2, or 4 bytes). */
`define   GCREG_SHADER_CONFIG_LS_RELATIVE_INDEX_STRIDE_ADAPTIVE             2'h1
/* a0/aL strides are 1 byte. */
`define   GCREG_SHADER_CONFIG_LS_RELATIVE_INDEX_STRIDE_BYTE                 2'h2

