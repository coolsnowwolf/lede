`define GCREG_VS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_LENGTH_M1_LSB 28
`define GCREG_VS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_LENGTH_M1_SIZE 1

/* The specified PC wll be the very last PC of the vertex shader. After this  **
