`define GCREG_VS_INSTRUCTION_PREFETCH_END_FieldMask                 32'h000FFFFF
`define GCREG_VS_INSTRUCTION_PREFETCH_END_ReadMask                  32'h000FFFFF
`define GCREG_VS_INSTRUCTION_PREFETCH_END_WriteMask                 32'h000FFFFF
`define GCREG_VS_INSTRUCTION_PREFETCH_END_ResetValue                32'h00000000

/* The specified PC wll be the very last PC of the vertex shader. After this  **
** - no more instructions will be prefetched.                                 */
`define GCREG_VS_INSTRUCTION_PREFETCH_END_PC_MSB                              19
