`define GCREG_GS_ATTRIBUTE_GLOBAL_CONTROL_HI_ReadMask               32'h0000FFFF
`define GCREG_GS_ATTRIBUTE_GLOBAL_CONTROL_HI_WriteMask              32'h0000FFFF
`define GCREG_GS_ATTRIBUTE_GLOBAL_CONTROL_HI_ResetValue             32'h00000000

