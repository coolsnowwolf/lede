`define AQ_PIXEL_SHADER_END_PC_FieldMask                            32'h00000FFF
`define AQ_PIXEL_SHADER_END_PC_ReadMask                             32'h00000FFF
`define AQ_PIXEL_SHADER_END_PC_WriteMask                            32'h00000FFF
`define AQ_PIXEL_SHADER_END_PC_ResetValue                           32'h00000000

/* GC500 - A program will terminate when the PC equals this number.  The      **
** instruction with an address equal to this number will never be executed    **
** because termination happens before execution.                              */
`define AQ_PIXEL_SHADER_END_PC_ADDRESS_MSB                                    11
`define AQ_PIXEL_SHADER_END_PC_ADDRESS_LSB                                     0
`define AQ_PIXEL_SHADER_END_PC_ADDRESS_SIZE                                   12

/* Register AQPixelShaderInst (1024 in total) **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQPixelShaderInstRegAddrs                                          6'h06
