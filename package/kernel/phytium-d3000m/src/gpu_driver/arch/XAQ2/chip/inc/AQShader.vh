`define GCREG_GS_ATTRIBUTE_VERTEX_SIZE_LSB                                     0
`define GCREG_GS_ATTRIBUTE_VERTEX_SIZE_SIZE                                    8

/* Size per thread. Each thread is an instance or a primitive, contain all    **
** possible vertices generated. Specified in 16-byte quantaties. The maximum  **
** value is 1024 components, or 4096 bytes, or 256 16-byte quantities.        */
