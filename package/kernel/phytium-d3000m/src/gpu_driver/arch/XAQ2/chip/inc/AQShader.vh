`define   GCREG_PS_OUTPUT_MODE_CONTROL0_UNSIGNED32                          4'h8
`define   GCREG_PS_OUTPUT_MODE_CONTROL0_SIGNED32                            4'h9

/* Control output conversion for render target 1. */
`define GCREG_PS_OUTPUT_MODE_CONTROL1_MSB                                      7
`define GCREG_PS_OUTPUT_MODE_CONTROL1_LSB                                      4
