/* Register gcregPSRelativeEnd **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Relative End PC. */

`define gcregPSRelativeEndRegAddrs                                      16'h0424
`define GCREG_PS_RELATIVE_END_MSB                                             15
`define GCREG_PS_RELATIVE_END_LSB                                              0
`define GCREG_PS_RELATIVE_END_BLK                                              0
`define GCREG_PS_RELATIVE_END_Count                                            1
`define GCREG_PS_RELATIVE_END_FieldMask                             32'h001FFFFF
`define GCREG_PS_RELATIVE_END_ReadMask                              32'h001FFFFF
`define GCREG_PS_RELATIVE_END_WriteMask                             32'h001FFFFF
`define GCREG_PS_RELATIVE_END_ResetValue                            32'h00000000

/* The value is equal to (End PC - Start PC). The program will terminate once **
** the PC reaches startPC + relativeEndPC                                     */
`define GCREG_PS_RELATIVE_END_PC_MSB                                          20
`define GCREG_PS_RELATIVE_END_PC_LSB                                           0
`define GCREG_PS_RELATIVE_END_PC_SIZE                                         21

/* Register gcregPSInstructionPrefetchRelativeEnd **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Set the Pixel Shader end instruction counter of the program after which    **
** prefetching will stop. The value should be equal to real prefetch end -    **
** start PC.                                                                  */

`define gcregPSInstructionPrefetchRelativeEndRegAddrs                   16'h0425
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_MSB                        15
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_LSB                         0
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_BLK                         0
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_Count                       1
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_FieldMask        32'h900FFFFF
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_ReadMask         32'h900FFFFF
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_WriteMask        32'h900FFFFF
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_ResetValue       32'h00000000

/* Wrap autoprefetch back to startpc (default). To completely disable         **
** autoprefetching, must disable wrapping and set prefetch relative end to 0. */
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_WRAP_MSB      31
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_WRAP_LSB      31
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_WRAP_SIZE      1
`define   GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_WRAP_ENABLE 1'h0
`define   GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_WRAP_DISABLE 1'h1

/* Number of lines to autoprefetch (minus 1). */
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_LENGTH_M1_MSB 28
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_LENGTH_M1_LSB 28
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_AUTOPREFETCH_LENGTH_M1_SIZE 1

/* The specified PC wll be the very last PC of the pixel shader. After this - **
** no more instructions will be prefetched.                                   */
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_PC_MSB                     19
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_PC_LSB                      0
`define GCREG_PS_INSTRUCTION_PREFETCH_RELATIVE_END_PC_SIZE                    20

/* Register gcregPSMax **
** ~~~~~~~~~~~~~~~~~~~ */

/* Maximum values for a various number of things. */

`define gcregPSMaxRegAddrs                                              16'h0426
`define GCREG_PS_MAX_MSB                                                      15
`define GCREG_PS_MAX_LSB                                                       0
`define GCREG_PS_MAX_BLK                                                       0
`define GCREG_PS_MAX_Count                                                     1
`define GCREG_PS_MAX_FieldMask                                      32'h000F07FF
`define GCREG_PS_MAX_ReadMask                                       32'h000F07FF
`define GCREG_PS_MAX_WriteMask                                      32'h000F07FF
`define GCREG_PS_MAX_ResetValue                                     32'h00000000

/* Maximum render array index value. If a programmed render array index is    **
** out of bounds, the pixel just gets dropped.                                */
`define GCREG_PS_MAX_RENDER_ARRAY_INDEX_MSB                                    7
`define GCREG_PS_MAX_RENDER_ARRAY_INDEX_LSB                                    0
`define GCREG_PS_MAX_RENDER_ARRAY_INDEX_SIZE                                   8

/* For DX11 and later, render array needs to support 2048 dimensions, it      **
** needs 11 bits. This is maximum render array index value bit 8 ~ 10, the    **
** bit 0 ~ 7 is set by field RenderArrayIndex. If a programmed render array   **
** index is out of bounds, the pixel just gets dropped.                       */
`define GCREG_PS_MAX_RENDER_ARRAY_INDEX_BIT8_10_MSB                           10
`define GCREG_PS_MAX_RENDER_ARRAY_INDEX_BIT8_10_LSB                            8
`define GCREG_PS_MAX_RENDER_ARRAY_INDEX_BIT8_10_SIZE                           3

/* Maximum viewport array index value. If a programmed viewport array index   **
** is out of bounds, the default viewport will be used.                       */
`define GCREG_PS_MAX_VIEWPORT_ARRAY_INDEX_MSB                                 19
`define GCREG_PS_MAX_VIEWPORT_ARRAY_INDEX_LSB                                 16
`define GCREG_PS_MAX_VIEWPORT_ARRAY_INDEX_SIZE                                 4

/* Register gcregPSCSThrottle **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Throttling control for the compute shader. */

`define gcregPSCSThrottleRegAddrs                                       16'h0427
`define GCREG_PSCS_THROTTLE_MSB                                               15
`define GCREG_PSCS_THROTTLE_LSB                                                0
`define GCREG_PSCS_THROTTLE_BLK                                                0
`define GCREG_PSCS_THROTTLE_Count                                              1
`define GCREG_PSCS_THROTTLE_FieldMask                               32'hFFFFFFFF
`define GCREG_PSCS_THROTTLE_ReadMask                                32'hFFFFFFFF
`define GCREG_PSCS_THROTTLE_WriteMask                               32'hFFFFFFFF
`define GCREG_PSCS_THROTTLE_ResetValue                              32'h00000000

/* This field is re-used in the Graphic mode. In the Graphic mode, it means   **
** the total number of 1024-byte pages that is used for the LocalStorage      **
** (LSPC) for VS/TCS/TES/GS/PS shader clients. Make sure that the value is    **
** big enough to fit at least one group of the local storage for all the      **
** shader clients, or the hardware will just hang.  The GPIPE attribute data  **
** and the LSPC all share the same attribute memory inside the USC, make sure **
** the total memory will not exceed the attribute memory size.  In the        **
** computing mode, the define is un-changed. It is the maximum number of      **
** 1024-byte pages for the Computer Shader local storage.                     */
`define GCREG_PSCS_THROTTLE_ATTRIB_MAX_PAGES_MSB                               7
`define GCREG_PSCS_THROTTLE_ATTRIB_MAX_PAGES_LSB                               0
`define GCREG_PSCS_THROTTLE_ATTRIB_MAX_PAGES_SIZE                              8

/* Work group count in one shader group if                                    **
** gcregTWShaderInfo.ThreadAllocation==1 and don't care otherwise. This is a  **
** throttle for limiting the number of small workgroups which can fit within  **
** a single shader group. If gcregTWShaderInfo2.LocalIdW==Disabled, then this **
** throttle is disabled.                                                      */
`define GCREG_PSCS_THROTTLE_WORK_GROUP_COUNT_IN_SHADER_GROUP_MSB              15
`define GCREG_PSCS_THROTTLE_WORK_GROUP_COUNT_IN_SHADER_GROUP_LSB               8
`define GCREG_PSCS_THROTTLE_WORK_GROUP_COUNT_IN_SHADER_GROUP_SIZE              8

/* Maximum number of workgroups which can fit within a single cluster         **
** simultaneously, minus 1. This is a throttle for limiting the total number  **
** of workgroups within a cluster. If gcregTWShaderInfo2.LocalIdW==Disabled,  **
** then this throttle is disabled.                                            */
`define GCREG_PSCS_THROTTLE_MAX_RUNNING_WORK_GROUPS_MINUS_ONE_MSB             27
`define GCREG_PSCS_THROTTLE_MAX_RUNNING_WORK_GROUPS_MINUS_ONE_LSB             16
`define GCREG_PSCS_THROTTLE_MAX_RUNNING_WORK_GROUPS_MINUS_ONE_SIZE            12

/* Hight 4 bits for AttribMaxPages. */
`define GCREG_PSCS_THROTTLE_ATTRIB_MAX_PAGES_HIGH_FOUR_BITS_MSB               31
`define GCREG_PSCS_THROTTLE_ATTRIB_MAX_PAGES_HIGH_FOUR_BITS_LSB               28
`define GCREG_PSCS_THROTTLE_ATTRIB_MAX_PAGES_HIGH_FOUR_BITS_SIZE               4

