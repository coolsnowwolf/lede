`define GCREG_VERTEX_SHADER_CONST_WriteMask                         32'h000003FF
`define GCREG_VERTEX_SHADER_CONST_ResetValue                        32'h00000000

/* Memory index of the first vertex shader constant register. Every constant  **
** register takes 16 bytes, therefore to compute the actual memory location   **
** of a particular constant register, multiply its memory index by 16. For    **
** example, if constant bank starts at constant register 10, set BaseOffset   **
** field to 10 and the actual memory location will be 10 * 16 = 160.          */
`define GCREG_VERTEX_SHADER_CONST_BASE_OFFSET_MSB                              9
`define GCREG_VERTEX_SHADER_CONST_BASE_OFFSET_LSB                              0
`define GCREG_VERTEX_SHADER_CONST_BASE_OFFSET_SIZE                            10

/* Register gcregSHCacheControl **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Control the instruction cache. */

`define gcregSHCacheControlRegAddrs                                     16'h021A
`define GCREG_SH_CACHE_CONTROL_MSB                                            15
`define GCREG_SH_CACHE_CONTROL_LSB                                             0
`define GCREG_SH_CACHE_CONTROL_BLK                                             0
`define GCREG_SH_CACHE_CONTROL_Count                                           1
`define GCREG_SH_CACHE_CONTROL_FieldMask                            32'h000003F1
`define GCREG_SH_CACHE_CONTROL_ReadMask                             32'h000003F1
`define GCREG_SH_CACHE_CONTROL_WriteMask                            32'h000003F1
`define GCREG_SH_CACHE_CONTROL_ResetValue                           32'h00000000

/* Control the cache mode. Note that this state will be loaded from the VS.   **
** So, if the cache mode is changed, better make sure the PS is not executing **
** anything.                                                                  */
`define GCREG_SH_CACHE_CONTROL_MODE_MSB                                        0
`define GCREG_SH_CACHE_CONTROL_MODE_LSB                                        0
`define GCREG_SH_CACHE_CONTROL_MODE_SIZE                                       1
/* Instructions will be loaded through the states. */
