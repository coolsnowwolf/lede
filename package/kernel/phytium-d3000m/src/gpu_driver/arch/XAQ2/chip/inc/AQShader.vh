/* Register gcregGpipeLoadBalancing **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* load balancing between gpipe and pixel pipe. */

`define gcregGpipeLoadBalancingRegAddrs                                 16'h042A
