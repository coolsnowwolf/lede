`define AQ_VERTEX_SHADER_END_PC_ResetValue                          32'h00000000

/* GC500 - A program will terminate when the PC equals this number.  The      **
** instruction with an address equal to this number will never be executed    **
** because termination happens before execution.  It is legal to set this to  **
** point to the last location in the instruction ram plus one.  For example,  **
** in an implementation with an 8 entry instruction ram, the last entry is 7. **
**  In that case, it is legal to set the EndPC to 8.                          */
`define AQ_VERTEX_SHADER_END_PC_ADDRESS_MSB                                   11
`define AQ_VERTEX_SHADER_END_PC_ADDRESS_LSB                                    0
`define AQ_VERTEX_SHADER_END_PC_ADDRESS_SIZE                                  12

