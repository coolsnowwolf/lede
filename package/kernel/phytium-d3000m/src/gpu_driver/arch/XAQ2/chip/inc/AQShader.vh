/* Register gcregTWConfig **
** ~~~~~~~~~~~~~~~~~~~~~~ */
`define gcregTWConfigRegAddrs                                           16'h0240
`define GCREG_TW_CONFIG_MSB                                                   15
`define GCREG_TW_CONFIG_LSB                                                    0
`define GCREG_TW_CONFIG_BLK                                                    0
`define GCREG_TW_CONFIG_Count                                                  1
`define GCREG_TW_CONFIG_FieldMask                                   32'hF7FFF773
`define GCREG_TW_CONFIG_ReadMask                                    32'hF7FFF773
`define GCREG_TW_CONFIG_WriteMask                                   32'hF7FFF773
`define GCREG_TW_CONFIG_ResetValue                                  32'h00000000

/* Number of dimensions of work-items (default to single dimension). */
`define GCREG_TW_CONFIG_WORK_DIM_MSB                                           1
`define GCREG_TW_CONFIG_WORK_DIM_LSB                                           0
`define GCREG_TW_CONFIG_WORK_DIM_SIZE                                          2
`define   GCREG_TW_CONFIG_WORK_DIM_DEFAULT                                  2'h0
`define   GCREG_TW_CONFIG_WORK_DIM_ONE                                      2'h1
`define   GCREG_TW_CONFIG_WORK_DIM_TWO                                      2'h2
`define   GCREG_TW_CONFIG_WORK_DIM_THREE                                    2'h3

/* Positions of XYZ-components in the traversal-order of the innermost 3      **
** loops. This field should be restricted to the range [0..WorkDim * 2 - 1].  */
`define GCREG_TW_CONFIG_TRAVERSE_ORDER_MSB                                     6
`define GCREG_TW_CONFIG_TRAVERSE_ORDER_LSB                                     4
`define GCREG_TW_CONFIG_TRAVERSE_ORDER_SIZE                                    3
`define   GCREG_TW_CONFIG_TRAVERSE_ORDER_XYZ                                3'h0
`define   GCREG_TW_CONFIG_TRAVERSE_ORDER_XZY                                3'h1
`define   GCREG_TW_CONFIG_TRAVERSE_ORDER_YXZ                                3'h2
`define   GCREG_TW_CONFIG_TRAVERSE_ORDER_ZXY                                3'h3
`define   GCREG_TW_CONFIG_TRAVERSE_ORDER_YZX                                3'h4
`define   GCREG_TW_CONFIG_TRAVERSE_ORDER_ZYX                                3'h5

/* Enable swathing within the Thread Walker (X axis). */
`define GCREG_TW_CONFIG_SWATH_ENABLE_X_MSB                                     8
`define GCREG_TW_CONFIG_SWATH_ENABLE_X_LSB                                     8
`define GCREG_TW_CONFIG_SWATH_ENABLE_X_SIZE                                    1
`define   GCREG_TW_CONFIG_SWATH_ENABLE_X_DISABLE                            1'h0
`define   GCREG_TW_CONFIG_SWATH_ENABLE_X_ENABLE                             1'h1

/* Enable swathing within the Thread Walker (Y axis). */
`define GCREG_TW_CONFIG_SWATH_ENABLE_Y_MSB                                     9
`define GCREG_TW_CONFIG_SWATH_ENABLE_Y_LSB                                     9
`define GCREG_TW_CONFIG_SWATH_ENABLE_Y_SIZE                                    1
`define   GCREG_TW_CONFIG_SWATH_ENABLE_Y_DISABLE                            1'h0
`define   GCREG_TW_CONFIG_SWATH_ENABLE_Y_ENABLE                             1'h1

/* Enable swathing within the Thread Walker (Z axis). */
`define GCREG_TW_CONFIG_SWATH_ENABLE_Z_MSB                                    10
`define GCREG_TW_CONFIG_SWATH_ENABLE_Z_LSB                                    10
`define GCREG_TW_CONFIG_SWATH_ENABLE_Z_SIZE                                    1
`define   GCREG_TW_CONFIG_SWATH_ENABLE_Z_DISABLE                            1'h0
`define   GCREG_TW_CONFIG_SWATH_ENABLE_Z_ENABLE                             1'h1

/* Maximum number of workgroups minus 1 in {X,Y,Z} dimension to traverse to   **
** make up a swath, if swathing is enabled. If swathing isn't enabled for the **
** {X,Y,Z} dimension, the swath size will be the whole dimension within the   **
** NDRange. The NDRange is stepped out in swaths in the outermost loop of the **
** walker.                                                                    */
`define GCREG_TW_CONFIG_SWATH_SIZE_X_MSB                                      15
`define GCREG_TW_CONFIG_SWATH_SIZE_X_LSB                                      12
`define GCREG_TW_CONFIG_SWATH_SIZE_X_SIZE                                      4

/* Maximum number of workgroups minus 1 in {X,Y,Z} dimension to traverse to   **
** make up a swath, if swathing is enabled. If swathing isn't enabled for the **
** {X,Y,Z} dimension, the swath size will be the whole dimension within the   **
** NDRange. The NDRange is stepped out in swaths in the outermost loop of the **
** walker.                                                                    */
`define GCREG_TW_CONFIG_SWATH_SIZE_Y_MSB                                      19
`define GCREG_TW_CONFIG_SWATH_SIZE_Y_LSB                                      16
`define GCREG_TW_CONFIG_SWATH_SIZE_Y_SIZE                                      4

/* Maximum number of workgroups minus 1 in {X,Y,Z} dimension to traverse to   **
** make up a swath, if swathing is enabled. If swathing isn't enabled for the **
** {X,Y,Z} dimension, the swath size will be the whole dimension within the   **
** NDRange. The NDRange is stepped out in swaths in the outermost loop of the **
** walker.                                                                    */
`define GCREG_TW_CONFIG_SWATH_SIZE_Z_MSB                                      23
`define GCREG_TW_CONFIG_SWATH_SIZE_Z_LSB                                      20
`define GCREG_TW_CONFIG_SWATH_SIZE_Z_SIZE                                      4

/* Order and method to pass the three values (local, group and global IDs) to **
** the shader. (L) stands for local ID, (W) stands for work-group ID, (G)     **
** stands for global ID. The first value of the three is accessible through   **
** OpenCL register type, the other two are accessible through temporary       **
** registers.                                                                 */
`define GCREG_TW_CONFIG_VALUE_ORDER_MSB                                       26
`define GCREG_TW_CONFIG_VALUE_ORDER_LSB                                       24
`define GCREG_TW_CONFIG_VALUE_ORDER_SIZE                                       3
`define   GCREG_TW_CONFIG_VALUE_ORDER_GLW                                   3'h0
`define   GCREG_TW_CONFIG_VALUE_ORDER_GWL                                   3'h1
`define   GCREG_TW_CONFIG_VALUE_ORDER_LGW                                   3'h2
`define   GCREG_TW_CONFIG_VALUE_ORDER_WGL                                   3'h3
`define   GCREG_TW_CONFIG_VALUE_ORDER_LWG                                   3'h4
`define   GCREG_TW_CONFIG_VALUE_ORDER_WLG                                   3'h5

/* Select in which direction the thread walker will use a 32-bit workgroup    **
** size. All other directions than the one specified here will have a 16-bit  **
** workgroup size.                                                            */
`define GCREG_TW_CONFIG_SELECT_HIGH_COUNT_MSB                                 29
`define GCREG_TW_CONFIG_SELECT_HIGH_COUNT_LSB                                 28
`define GCREG_TW_CONFIG_SELECT_HIGH_COUNT_SIZE                                 2
/* Thread walker will use 32/16/16 bits for X/Y/Z size. */
`define   GCREG_TW_CONFIG_SELECT_HIGH_COUNT_X                               2'h0
/* Thread walker will use 16/32/16 bits for X/Y/Z size. */
`define   GCREG_TW_CONFIG_SELECT_HIGH_COUNT_Y                               2'h1
/* Thread walker will use 16/16/32 bits for X/Y/Z size. */
`define   GCREG_TW_CONFIG_SELECT_HIGH_COUNT_Z                               2'h2

/* Hardware native debug switch. */
`define GCREG_TW_CONFIG_NATIVE_DEBUG_MSB                                      30
`define GCREG_TW_CONFIG_NATIVE_DEBUG_LSB                                      30
`define GCREG_TW_CONFIG_NATIVE_DEBUG_SIZE                                      1
`define   GCREG_TW_CONFIG_NATIVE_DEBUG_DISABLE                              1'h0
`define   GCREG_TW_CONFIG_NATIVE_DEBUG_ENABLE                               1'h1

/* When we have a synchronous trigger, the hardware will not be allowed  to   **
** execute any load/store/atomic instruction until after all previous         **
** compute shader tasks have completed.  When we have an asynchronous trigger **
** , the hardware is allowed to execute subsequent shader programs            **
** simultaneously,  as they are not supposed to have any dependencies on each **
** other.                                                                     */
`define GCREG_TW_CONFIG_TRIGGER_MODE_MSB                                      31
`define GCREG_TW_CONFIG_TRIGGER_MODE_LSB                                      31
`define GCREG_TW_CONFIG_TRIGGER_MODE_SIZE                                      1
`define   GCREG_TW_CONFIG_TRIGGER_MODE_SYNC                                 1'h0
`define   GCREG_TW_CONFIG_TRIGGER_MODE_ASYNC                                1'h1

/* Register gcregTWInfoX **
** ~~~~~~~~~~~~~~~~~~~~~ */
`define gcregTWInfoXRegAddrs                                            16'h0241
`define GCREG_TW_INFO_X_MSB                                                   15
`define GCREG_TW_INFO_X_LSB                                                    0
`define GCREG_TW_INFO_X_BLK                                                    0
