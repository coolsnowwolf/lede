`define GCREG_VS_INSTRUCTION_PREFETCH_RELATIVE_END_ResetValue       32'h00000000

/* Wrap autoprefetch back to startpc (default). To completely disable         **
** autoprefetching, must disable wrapping and set prefetch relative end to 0. */
