/* Offset gcregTrigger
** ~~~~~~~~~~~~~~~~~~~ */

/* 0:NN, others are not used. */
`define GCREG_TRIGGER_DEVICE_ID_MSB                                            7
`define GCREG_TRIGGER_DEVICE_ID_LSB                                            0
`define GCREG_TRIGGER_DEVICE_ID_SIZE                                           8
`define   GCREG_TRIGGER_DEVICE_ID_NN                                       8'h00

/* All shader threads within the same work group must execute the same        **
** instruction with the same parameters. The first thread execution causes    **
** the EventID to be pushes into the inflight EventID tracking FIFO. The NN   **
** command FIFO is pushed ether by the first thread execution or by the last  **
** thread execution depend on the TriggerCondition field. 0:FirstThread,      **
** 1:LastThread.                                                              */
`define GCREG_TRIGGER_CONDITION_MSB                                           15
`define GCREG_TRIGGER_CONDITION_LSB                                            8
`define GCREG_TRIGGER_CONDITION_SIZE                                           8
`define   GCREG_TRIGGER_CONDITION_FIRST_THREAD                             8'h00
`define   GCREG_TRIGGER_CONDITION_LAST_THREAD                              8'h01

`define GCREG_TRIGGER_MEMORY_TYPE_MSB                                         16
`define GCREG_TRIGGER_MEMORY_TYPE_LSB                                         16
`define GCREG_TRIGGER_MEMORY_TYPE_SIZE                                         1
`define   GCREG_TRIGGER_MEMORY_TYPE_GLOBAL_MEMORY                           1'h0
`define   GCREG_TRIGGER_MEMORY_TYPE_WORKGROUP_LOCAL_MEMORY                  1'h1

/* Offset gcregAsyncCopyDescriptor
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Data format. */
`define GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_MSB                              3
`define GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_LSB                              0
`define GCREG_ASYNC_COPY_DESCRIPTOR_DATA_TYPE_SIZE                             4
/* uint8. */
