`define GCREG_HW_NATIVE_DEBUG_EVENT_WriteMask                       32'h0000000F
`define GCREG_HW_NATIVE_DEBUG_EVENT_ResetValue                      32'h00000000

/* Hardware native debug event type. 0: Release current stop if it exists,    **
** then wait for next stop. 1: Release the stop for current kernel and freely **
** run. 2: Next PC. 3: Restart draw. 4: Restart work group.                   */
`define GCREG_HW_NATIVE_DEBUG_EVENT_TYPE_MSB                                   3
`define GCREG_HW_NATIVE_DEBUG_EVENT_TYPE_LSB                                   0
`define GCREG_HW_NATIVE_DEBUG_EVENT_TYPE_SIZE                                  4
`define   GCREG_HW_NATIVE_DEBUG_EVENT_TYPE_WAIT_NEXT_STOP                   4'h0
`define   GCREG_HW_NATIVE_DEBUG_EVENT_TYPE_RELEASE_STOP                     4'h1
`define   GCREG_HW_NATIVE_DEBUG_EVENT_TYPE_NEXT_PC                          4'h2
`define   GCREG_HW_NATIVE_DEBUG_EVENT_TYPE_RESTART_DRAW                     4'h3
`define   GCREG_HW_NATIVE_DEBUG_EVENT_TYPE_RESTART_WG                       4'h4

/* Register gcregHWNativeDebugOpcode **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Hardware native debug opetration. */

`define gcregHWNativeDebugOpcodeRegAddrs                                16'h6A4D
`define GCREG_HW_NATIVE_DEBUG_OPCODE_MSB                                      15
`define GCREG_HW_NATIVE_DEBUG_OPCODE_LSB                                       0
`define GCREG_HW_NATIVE_DEBUG_OPCODE_BLK                                       0
`define GCREG_HW_NATIVE_DEBUG_OPCODE_Count                                     1
`define GCREG_HW_NATIVE_DEBUG_OPCODE_FieldMask                      32'hFFFFF01F
`define GCREG_HW_NATIVE_DEBUG_OPCODE_ReadMask                       32'hFFFFF01F
`define GCREG_HW_NATIVE_DEBUG_OPCODE_WriteMask                      32'hFFFFF01F
`define GCREG_HW_NATIVE_DEBUG_OPCODE_ResetValue                     32'h00000000

/* Hardware native debug opetration type. 0: Read temporary registers         **
** r[target]. 1: Read const registers c[target]. 2: Read control registers    **
** (PC, minPC, nxtPC, branchPC, endPC, instBypass). 3: Write temporary        **
** registers r[target]. 4: Write control registers r[target]. 5: Read global  **
** memory for 16 bytes each time. 6: Read local memory for 16 bytes each      **
** time. 7: Write global memory for 16 bytes each time. 8: Write local memory **
** for 16 bytes each time. 9: Read work attribute globalOffset {z[31:0],      **
** y[31:0], x[31:0]}. 10: Read work attribute groupCount {z[31:0], y[31:0],   **
** x[31:0]}. 11: Read work attribute {work_dim[1:0], buddle_size[5:0],        **
** swath(z_enable, z_size[3:0], y_enable, y_size[3:0], x_enable,              **
** x_size[3:0]), scale(z[7:0], y[7:0], x[7:0]), groupSize(z[9:0], y[9:0],     **
** x[9:0])}. 12: Jump PC, target should be the jumped PC. 13: Read            **
** instruction count.                                                         */
`define GCREG_HW_NATIVE_DEBUG_OPCODE_TYPE_MSB                                  4
