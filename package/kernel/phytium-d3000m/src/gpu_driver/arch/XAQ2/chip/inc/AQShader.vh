`define GCREG_SHADER_CONFIG_VS_PRECISION_MSB                                  28
`define GCREG_SHADER_CONFIG_VS_PRECISION_LSB                                  28
`define GCREG_SHADER_CONFIG_VS_PRECISION_SIZE                                  1
/* High precision (32-bit floating point). */
`define   GCREG_SHADER_CONFIG_VS_PRECISION_HIGH                             1'h0
/* Medium precision (16-bit floating point). */
`define   GCREG_SHADER_CONFIG_VS_PRECISION_MEDIUM                           1'h1

/* Precision control for Pixel Shader. */
`define GCREG_SHADER_CONFIG_PS_PRECISION_MSB                                  29
`define GCREG_SHADER_CONFIG_PS_PRECISION_LSB                                  29
`define GCREG_SHADER_CONFIG_PS_PRECISION_SIZE                                  1
/* High precision (32-bit floating point). */
`define   GCREG_SHADER_CONFIG_PS_PRECISION_HIGH                             1'h0
/* Medium precision (16-bit floating point).  Implies dual-16 mode. */
`define   GCREG_SHADER_CONFIG_PS_PRECISION_MEDIUM                           1'h1

/* Integer2Float treatment of NANs. */
`define GCREG_SHADER_CONFIG_CONVERT_NAN_MSB                                   30
`define GCREG_SHADER_CONFIG_CONVERT_NAN_LSB                                   30
`define GCREG_SHADER_CONFIG_CONVERT_NAN_SIZE                                   1
/* Flush NANs to zero on saturate or F2I (default). */
`define   GCREG_SHADER_CONFIG_CONVERT_NAN_ZERO                              1'h0
/* Alias NANs to INF for saturate and F2I.  Bug compatible mode with previous **
