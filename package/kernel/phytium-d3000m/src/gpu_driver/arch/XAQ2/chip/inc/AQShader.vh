`define GCREG_SH_CACHE_CONTROL_INVALIDATE_GS_SIZE                              1

/* Register gcregVSInstruction **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Address of the shader program. The program buffer needs to be 256-byte     **
** aligned in both starting address and size. But it is possible to point all **
** the shaders to the same address and use the gcregVSProgram and             **
** gcregPSProgram states to program the proper starting instruction.          */

`define gcregVSInstructionRegAddrs                                      16'h021B
`define GCREG_VS_INSTRUCTION_MSB                                              15
`define GCREG_VS_INSTRUCTION_LSB                                               0
`define GCREG_VS_INSTRUCTION_BLK                                               0
`define GCREG_VS_INSTRUCTION_Count                                             1
`define GCREG_VS_INSTRUCTION_FieldMask                              32'hFFFFFFFF
`define GCREG_VS_INSTRUCTION_ReadMask                               32'hFFFFFF00
`define GCREG_VS_INSTRUCTION_WriteMask                              32'hFFFFFF00
`define GCREG_VS_INSTRUCTION_ResetValue                             32'h00000000

/* 256-byte aligned address. */
`define GCREG_VS_INSTRUCTION_ADDRESS_MSB                                      31
`define GCREG_VS_INSTRUCTION_ADDRESS_LSB                                       0
`define GCREG_VS_INSTRUCTION_ADDRESS_SIZE                                     32

/* Register gcregVSAttribute **
** ~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Specifications for the VS attribute memory. The maximum size for each      **
** vertex is 128 components, which is 512 bytes.                              */

`define gcregVSAttributeRegAddrs                                        16'h021C
`define GCREG_VS_ATTRIBUTE_MSB                                                15
`define GCREG_VS_ATTRIBUTE_LSB                                                 0
`define GCREG_VS_ATTRIBUTE_BLK                                                 0
`define GCREG_VS_ATTRIBUTE_Count                                               1
`define GCREG_VS_ATTRIBUTE_FieldMask                                32'h0007FF3F
`define GCREG_VS_ATTRIBUTE_ReadMask                                 32'h0007FF3F
`define GCREG_VS_ATTRIBUTE_WriteMask                                32'h0007FF3F
`define GCREG_VS_ATTRIBUTE_ResetValue                               32'h00000000

/* Size per vertex, specified in 16-byte quantities. The maximum size is 512  **
** bytes, or a value of 32 16-byte quantities.                                */
`define GCREG_VS_ATTRIBUTE_VERTEX_SIZE_MSB                                     5
`define GCREG_VS_ATTRIBUTE_VERTEX_SIZE_LSB                                     0
`define GCREG_VS_ATTRIBUTE_VERTEX_SIZE_SIZE                                    6

/* Size per group, specified in 64-byte quantities. The maximum size is       **
** 16,384 bytes for an 8-shader core configuration, or a value of 1024        **
** 16-byte quantities.                                                        */
`define GCREG_VS_ATTRIBUTE_GROUP_SIZE_MSB                                     18
`define GCREG_VS_ATTRIBUTE_GROUP_SIZE_LSB                                      8
`define GCREG_VS_ATTRIBUTE_GROUP_SIZE_SIZE                                    11

