`define GCREG_TFB_DESCRIPTOR_BUFFER_INDEX_MSB                                  1
`define GCREG_TFB_DESCRIPTOR_BUFFER_INDEX_LSB                                  0
`define GCREG_TFB_DESCRIPTOR_BUFFER_INDEX_SIZE                                 2

/* When enabled, this descriptor defines a skip of the specified number of    **
** 32-bit components. Nothing gets written to the buffer.                     */
`define GCREG_TFB_DESCRIPTOR_SKIP_MSB                                          4
`define GCREG_TFB_DESCRIPTOR_SKIP_LSB                                          4
`define GCREG_TFB_DESCRIPTOR_SKIP_SIZE                                         1

/* Attribute index for the data of this descriptor. */
`define GCREG_TFB_DESCRIPTOR_ATTRIBUTE_INDEX_MSB                              12
`define GCREG_TFB_DESCRIPTOR_ATTRIBUTE_INDEX_LSB                               8
`define GCREG_TFB_DESCRIPTOR_ATTRIBUTE_INDEX_SIZE                              5

/* Starting component for the data of this descriptor. */
`define GCREG_TFB_DESCRIPTOR_COMPONENT_START_MSB                              17
`define GCREG_TFB_DESCRIPTOR_COMPONENT_START_LSB                              16
`define GCREG_TFB_DESCRIPTOR_COMPONENT_START_SIZE                              2
`define   GCREG_TFB_DESCRIPTOR_COMPONENT_START_X                            2'h0
`define   GCREG_TFB_DESCRIPTOR_COMPONENT_START_Y                            2'h1
`define   GCREG_TFB_DESCRIPTOR_COMPONENT_START_Z                            2'h2
`define   GCREG_TFB_DESCRIPTOR_COMPONENT_START_W                            2'h3

/* Number of components to skip or write for this descriptor. */
`define GCREG_TFB_DESCRIPTOR_COMPONENT_COUNT_MSB                              21
`define GCREG_TFB_DESCRIPTOR_COMPONENT_COUNT_LSB                              20
`define GCREG_TFB_DESCRIPTOR_COMPONENT_COUNT_SIZE                              2
/* Skip or write one 32-bit component. */
`define   GCREG_TFB_DESCRIPTOR_COMPONENT_COUNT_ONE                          2'h1
/* Skip or write two 32-bit components. */
`define   GCREG_TFB_DESCRIPTOR_COMPONENT_COUNT_TWO                          2'h2
/* Skip or write three 32-bit components. */
`define   GCREG_TFB_DESCRIPTOR_COMPONENT_COUNT_THREE                        2'h3
/* Skip or write four 32-bit components. */
`define   GCREG_TFB_DESCRIPTOR_COMPONENT_COUNT_FOUR                         2'h0

/* Register gcregTFBInvalidate **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Invalidates the USC. */

`define gcregTFBInvalidateRegAddrs                                      16'h7003
`define GCREG_TFB_INVALIDATE_MSB                                              15
`define GCREG_TFB_INVALIDATE_LSB                                               0
