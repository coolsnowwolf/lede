`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_HIGH_ReadMask         32'hFFFFFFFF
`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_HIGH_WriteMask        32'hFFFFFFFF
`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_HIGH_ResetValue       32'h00000000

`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_HIGH_ADDRESS_MSB                31
`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_HIGH_ADDRESS_LSB                 0
`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_HIGH_ADDRESS_SIZE               32

/* Register gcregTFBBuffersBindingMask **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* A bit mask to indicate whether a buffer is bound to a specific binding     **
** point. If there is no buffer bound to a specific binding point i,          **
** gcregTFBBufferAddress[i] and gcregTFBBufferFilledSizeMemAddr[i] is invalid **
** memory address, so can't write data to it.                                 */

`define gcregTFBBuffersBindingMaskRegAddrs                              16'h7008
`define GCREG_TFB_BUFFERS_BINDING_MASK_MSB                                    15
`define GCREG_TFB_BUFFERS_BINDING_MASK_LSB                                     0
