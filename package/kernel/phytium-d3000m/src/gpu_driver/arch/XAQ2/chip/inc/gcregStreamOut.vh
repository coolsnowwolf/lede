`define GCREG_TFB_BUFFERS_BINDING_MASK_Count                                   1
`define GCREG_TFB_BUFFERS_BINDING_MASK_FieldMask                    32'h0000FFFF
`define GCREG_TFB_BUFFERS_BINDING_MASK_ReadMask                     32'h0000FFFF
`define GCREG_TFB_BUFFERS_BINDING_MASK_WriteMask                    32'h0000FFFF
`define GCREG_TFB_BUFFERS_BINDING_MASK_ResetValue                   32'h00000000

`define GCREG_TFB_BUFFERS_BINDING_MASK_MASK_MSB                               15
