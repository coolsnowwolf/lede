`define GCREG_TFB_INVALIDATE_FieldMask                              32'h00000001
`define GCREG_TFB_INVALIDATE_ReadMask                               32'h00000001
`define GCREG_TFB_INVALIDATE_WriteMask                              32'h00000001
`define GCREG_TFB_INVALIDATE_ResetValue                             32'h00000000

/* Trigger invalidation. */
`define GCREG_TFB_INVALIDATE_INVALIDATE_MSB                                    0
`define GCREG_TFB_INVALIDATE_INVALIDATE_LSB                                    0
