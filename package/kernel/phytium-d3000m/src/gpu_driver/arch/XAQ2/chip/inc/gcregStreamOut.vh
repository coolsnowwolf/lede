/* Register gcregSOControl **
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* Control register for Stream Out block. */

`define gcregSOControlRegAddrs                                          16'h5100
`define GCREG_SO_CONTROL_MSB                                                  15
`define GCREG_SO_CONTROL_LSB                                                   0
