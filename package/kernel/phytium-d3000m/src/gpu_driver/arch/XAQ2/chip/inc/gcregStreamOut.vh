`define   GCREG_TFB_INVALIDATE_INVALIDATE_TRUE                              1'h1

/* Register gcregTFBQueryCommand **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Command state for Transform Feedback queries. */

`define gcregTFBQueryCommandRegAddrs                                    16'h7004
`define GCREG_TFB_QUERY_COMMAND_MSB                                           15
`define GCREG_TFB_QUERY_COMMAND_LSB                                            0
`define GCREG_TFB_QUERY_COMMAND_BLK                                            0
`define GCREG_TFB_QUERY_COMMAND_Count                                          1
`define GCREG_TFB_QUERY_COMMAND_FieldMask                           32'h00000FF7
`define GCREG_TFB_QUERY_COMMAND_ReadMask                            32'h00000FF7
`define GCREG_TFB_QUERY_COMMAND_WriteMask                           32'h00000FF7
`define GCREG_TFB_QUERY_COMMAND_ResetValue                          32'h00000000

/* Transform feedback query command. */
`define GCREG_TFB_QUERY_COMMAND_COMMAND_MSB                                    2
`define GCREG_TFB_QUERY_COMMAND_COMMAND_LSB                                    0
`define GCREG_TFB_QUERY_COMMAND_COMMAND_SIZE                                   3
/* Do nothing. */
`define   GCREG_TFB_QUERY_COMMAND_COMMAND_IDLE                              3'h0
/* Reset the value to 0 and start counting for the selected query. */
`define   GCREG_TFB_QUERY_COMMAND_COMMAND_ACTIVE                            3'h1
/* Pause counting and write the value to the header for the selected query */
`define   GCREG_TFB_QUERY_COMMAND_COMMAND_PAUSE                             3'h2
/* Resume counting for the selected query */
`define   GCREG_TFB_QUERY_COMMAND_COMMAND_RESUME                            3'h3
/* Resume counting after reading the header from the memory for the selected  **
** query                                                                      */
`define   GCREG_TFB_QUERY_COMMAND_COMMAND_RESUME_WITH_READ                  3'h4

/* Stream selection. */
`define GCREG_TFB_QUERY_COMMAND_STREAM_MSB                                     7
`define GCREG_TFB_QUERY_COMMAND_STREAM_LSB                                     4
`define GCREG_TFB_QUERY_COMMAND_STREAM_SIZE                                    4

/* Query selection. */
`define GCREG_TFB_QUERY_COMMAND_QUERY_MSB                                     11
`define GCREG_TFB_QUERY_COMMAND_QUERY_LSB                                      8
`define GCREG_TFB_QUERY_COMMAND_QUERY_SIZE                                     4
/* Count of the primitives written. */
`define   GCREG_TFB_QUERY_COMMAND_QUERY_PRIMITIVES_WRITTEN                  4'h0
/* Count of primitives generated. */
`define   GCREG_TFB_QUERY_COMMAND_QUERY_PRIMITIVES_GENERATED                4'h1

/* Register gcregTFBQueryHeader **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Address of the header that will be filled in by the transform feedback for **
