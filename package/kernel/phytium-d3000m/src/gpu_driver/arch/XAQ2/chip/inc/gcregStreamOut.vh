`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_LOW_ReadMask          32'hFFFFFFFF
`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_LOW_WriteMask         32'hFFFFFFFF
`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_LOW_ResetValue        32'h00000000

`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_LOW_ADDRESS_MSB                 31
`define GCREG_TFB_BUFFER_FILLED_SIZE_MEM_ADDR_LOW_ADDRESS_LSB                  0
