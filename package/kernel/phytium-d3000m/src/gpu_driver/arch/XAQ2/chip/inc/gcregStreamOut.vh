`define GCREG_SO_CONTROL_WriteMask                                  32'h007F3F17
`define GCREG_SO_CONTROL_ResetValue                                 32'h00000000

/* Stream Out mode. */
`define GCREG_SO_CONTROL_MODE_MSB                                              2
`define GCREG_SO_CONTROL_MODE_LSB                                              0
`define GCREG_SO_CONTROL_MODE_SIZE                                             3
/* Disabled. Bypass Stream Out. */
`define   GCREG_SO_CONTROL_MODE_DISABLED                                    3'h0
/* Write out an index stream. */
`define   GCREG_SO_CONTROL_MODE_INDEX_STREAM_OUT                            3'h1
/* Write out multiple GPU streams, each for one GPU. */
`define   GCREG_SO_CONTROL_MODE_MULTI_GPU_STREAM_OUT                        3'h2
/* Write out up to 16 bin streams. */
`define   GCREG_SO_CONTROL_MODE_BIN_OUT                                     3'h3
/* Write out an entire vertex stream. */
`define   GCREG_SO_CONTROL_MODE_TRANSFORM_FEEDBACK                          3'h4

/* Controls whether the vertex is dropped after Stream Out or not. */
`define GCREG_SO_CONTROL_WRITE_THROUGH_MSB                                     4
`define GCREG_SO_CONTROL_WRITE_THROUGH_LSB                                     4
`define GCREG_SO_CONTROL_WRITE_THROUGH_SIZE                                    1
/* Stream Out will process the vertex and then drop it. */
`define   GCREG_SO_CONTROL_WRITE_THROUGH_DISABLED                           1'h0
/* Stream Out will process the vertex and then send it down the pipe for      **
** further processing.                                                        */
`define   GCREG_SO_CONTROL_WRITE_THROUGH_ENABLED                            1'h1

/* Number of GPU streams to write minus one, or number of bin streams to      **
** write minus one, or number of Transform Feedback streams to write minus    **
** one.                                                                       */
`define GCREG_SO_CONTROL_COUNT_MSB                                            11
`define GCREG_SO_CONTROL_COUNT_LSB                                             8
`define GCREG_SO_CONTROL_COUNT_SIZE                                            4

/* Format of the index stream to write. */
`define GCREG_SO_CONTROL_FORMAT_MSB                                           13
`define GCREG_SO_CONTROL_FORMAT_LSB                                           12
`define GCREG_SO_CONTROL_FORMAT_SIZE                                           2
/* 8-bit indices. */
`define   GCREG_SO_CONTROL_FORMAT_INDEX8                                    2'h0
/* 16-bit indices. */
`define   GCREG_SO_CONTROL_FORMAT_INDEX16                                   2'h1
/* 32-bit indices. */
`define   GCREG_SO_CONTROL_FORMAT_INDEX32                                   2'h2

/* Multi GPU mode. */
`define GCREG_SO_CONTROL_MULTI_GPU_MODE_MSB                                   18
`define GCREG_SO_CONTROL_MULTI_GPU_MODE_LSB                                   16
`define GCREG_SO_CONTROL_MULTI_GPU_MODE_SIZE                                   3
/* Windowed. Each GPU writes to its designed 64x64 or 128x64 aligned window. */
`define   GCREG_SO_CONTROL_MULTI_GPU_MODE_WINDOWED                          3'h0
/* 64x64 interleaved. */
`define   GCREG_SO_CONTROL_MULTI_GPU_MODE_INTERLEAVED64X64                  3'h1
/* 128x64 interleaved. */
`define   GCREG_SO_CONTROL_MULTI_GPU_MODE_INTERLEAVED128X64                 3'h2
/* 128x128 interleaved. */
`define   GCREG_SO_CONTROL_MULTI_GPU_MODE_INTERLEAVED128X128                3'h3
/* 16x16 interleaved. */
`define   GCREG_SO_CONTROL_MULTI_GPU_MODE_INTERLEAVED16X16                  3'h4
/* 32x32 interleaved. */
`define   GCREG_SO_CONTROL_MULTI_GPU_MODE_INTERLEAVED32X32                  3'h5

/* endian control of stream out buffer body */
`define GCREG_SO_CONTROL_BODY_ENDIAN_CONTROL_MSB                              20
`define GCREG_SO_CONTROL_BODY_ENDIAN_CONTROL_LSB                              19
`define GCREG_SO_CONTROL_BODY_ENDIAN_CONTROL_SIZE                              2
`define   GCREG_SO_CONTROL_BODY_ENDIAN_CONTROL_NO_SWAP                      2'h0
