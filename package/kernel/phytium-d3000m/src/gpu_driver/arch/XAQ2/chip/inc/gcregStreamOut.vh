`define GCREG_TFB_QUERY_HEADER_MSB                                            15
`define GCREG_TFB_QUERY_HEADER_LSB                                             0
`define GCREG_TFB_QUERY_HEADER_BLK                                             0
`define GCREG_TFB_QUERY_HEADER_Count                                           1
`define GCREG_TFB_QUERY_HEADER_FieldMask                            32'hFFFFFFFF
`define GCREG_TFB_QUERY_HEADER_ReadMask                             32'hFFFFFFFF
`define GCREG_TFB_QUERY_HEADER_WriteMask                            32'hFFFFFFFF
`define GCREG_TFB_QUERY_HEADER_ResetValue                           32'h00000000

`define GCREG_TFB_QUERY_HEADER_ADDRESS_MSB                                    31
`define GCREG_TFB_QUERY_HEADER_ADDRESS_LSB                                     0
`define GCREG_TFB_QUERY_HEADER_ADDRESS_SIZE                                   32

/* Register gcregTFBBufferAddressHi (16 in total) **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Bits[63:32] of gcregTFBBufferAddress, upper 32 bits of base address for    **
** each possible buffers. Currently we only have 4 buffer, but reserve up to  **
** 16 buffers.                                                                */

`define gcregTFBBufferAddressHiRegAddrs                                  12'h705
`define GCREG_TFB_BUFFER_ADDRESS_HI_MSB                                       15
`define GCREG_TFB_BUFFER_ADDRESS_HI_LSB                                        4
