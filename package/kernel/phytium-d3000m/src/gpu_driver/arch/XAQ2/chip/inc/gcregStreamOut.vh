`define GCREG_TFB_QUERY_HEADER_HI_Count                                        1
`define GCREG_TFB_QUERY_HEADER_HI_FieldMask                         32'h0000FFFF
`define GCREG_TFB_QUERY_HEADER_HI_ReadMask                          32'h0000FFFF
`define GCREG_TFB_QUERY_HEADER_HI_WriteMask                         32'h0000FFFF
`define GCREG_TFB_QUERY_HEADER_HI_ResetValue                        32'h00000000

/* Supports virtual addresses up to 48-bits. */
`define GCREG_TFB_QUERY_HEADER_HI_ADDRESS_MSB                                 15
`define GCREG_TFB_QUERY_HEADER_HI_ADDRESS_LSB                                  0
`define GCREG_TFB_QUERY_HEADER_HI_ADDRESS_SIZE                                16

/* Register gcregTFBBufferFilledSizeMemAddrLow (16 in total) **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Address of the memory where each TFB buffer's filled size is stored. It    **
