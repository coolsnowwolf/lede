`define GCREG_TFB_BUFFER_ADDRESS_HI_WriteMask                       32'h0000FFFF
`define GCREG_TFB_BUFFER_ADDRESS_HI_ResetValue                      32'h00000000

/* Supports virtual addresses up to 48-bits. */
`define GCREG_TFB_BUFFER_ADDRESS_HI_ADDRESS_MSB                               15
`define GCREG_TFB_BUFFER_ADDRESS_HI_ADDRESS_LSB                                0
`define GCREG_TFB_BUFFER_ADDRESS_HI_ADDRESS_SIZE                              16

/* Register gcregTFBHeaderHi **
** ~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Bits[63:32] of gcregTFBHeader, upper 32 bits of address of the header that **
** will be filled in by the transform feedback when it is done. format as     **
** DrawIndirect.                                                              */

`define gcregTFBHeaderHiRegAddrs                                        16'h7006
`define GCREG_TFB_HEADER_HI_MSB                                               15
`define GCREG_TFB_HEADER_HI_LSB                                                0
`define GCREG_TFB_HEADER_HI_BLK                                                0
`define GCREG_TFB_HEADER_HI_Count                                              1
`define GCREG_TFB_HEADER_HI_FieldMask                               32'h0000FFFF
`define GCREG_TFB_HEADER_HI_ReadMask                                32'h0000FFFF
`define GCREG_TFB_HEADER_HI_WriteMask                               32'h0000FFFF
`define GCREG_TFB_HEADER_HI_ResetValue                              32'h00000000

/* Supports virtual addresses up to 48-bits. */
`define GCREG_TFB_HEADER_HI_ADDRESS_MSB                                       15
`define GCREG_TFB_HEADER_HI_ADDRESS_LSB                                        0
`define GCREG_TFB_HEADER_HI_ADDRESS_SIZE                                      16

/* Register gcregTFBQueryHeaderHi **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Bits[63:32] of gcregTFBHeader, upper 32 bits of address of the header that **
** will be filled in by the transform feedback for the query that is selected **
** by the gcregTFBQueryCommand state load.                                    */

`define gcregTFBQueryHeaderHiRegAddrs                                   16'h7007
