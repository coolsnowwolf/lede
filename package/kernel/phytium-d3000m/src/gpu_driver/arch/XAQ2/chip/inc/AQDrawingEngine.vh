`define   AQDE_SRC_CONFIG_FORMAT_A1R5G5B5                                   4'h3
`define   AQDE_SRC_CONFIG_FORMAT_R5G6B5                                     4'h4
`define   AQDE_SRC_CONFIG_FORMAT_X8R8G8B8                                   4'h5
`define   AQDE_SRC_CONFIG_FORMAT_A8R8G8B8                                   4'h6
