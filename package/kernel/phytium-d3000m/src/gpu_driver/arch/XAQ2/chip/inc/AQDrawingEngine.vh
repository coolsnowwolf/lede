** obsolete for chips with 2DPE20 feature defined. For those chips use        **
** SourceFormat field.                                                        */
`define AQDE_SRC_CONFIG_FORMAT_MSB                                             3
`define AQDE_SRC_CONFIG_FORMAT_LSB                                             0
`define AQDE_SRC_CONFIG_FORMAT_SIZE                                            4
`define   AQDE_SRC_CONFIG_FORMAT_X4R4G4B4                                   4'h0
`define   AQDE_SRC_CONFIG_FORMAT_A4R4G4B4                                   4'h1
