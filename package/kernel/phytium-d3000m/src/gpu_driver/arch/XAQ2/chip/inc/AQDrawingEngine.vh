`define AQDE_CLEAR_PIXEL_VALUE32_ALPHA_SIZE                                    8

`define AQDE_CLEAR_PIXEL_VALUE32_RED_MSB                                      23
`define AQDE_CLEAR_PIXEL_VALUE32_RED_LSB                                      16
`define AQDE_CLEAR_PIXEL_VALUE32_RED_SIZE                                      8

`define AQDE_CLEAR_PIXEL_VALUE32_GREEN_MSB                                    15
`define AQDE_CLEAR_PIXEL_VALUE32_GREEN_LSB                                     8
