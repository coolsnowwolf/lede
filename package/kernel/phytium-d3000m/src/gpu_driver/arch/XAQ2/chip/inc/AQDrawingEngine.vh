`define AQDE_SRC_COLOR_BG_ALPHA_MSB                                           31
`define AQDE_SRC_COLOR_BG_ALPHA_LSB                                           24
`define AQDE_SRC_COLOR_BG_ALPHA_SIZE                                           8

`define AQDE_SRC_COLOR_BG_RED_MSB                                             23
`define AQDE_SRC_COLOR_BG_RED_LSB                                             16
`define AQDE_SRC_COLOR_BG_RED_SIZE                                             8

