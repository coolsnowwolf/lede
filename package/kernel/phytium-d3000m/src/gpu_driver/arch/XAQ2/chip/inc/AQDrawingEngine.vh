`define AQDE_SRC_CONFIG_MONO_TRANSPARENCY_MSB                                 15
`define AQDE_SRC_CONFIG_MONO_TRANSPARENCY_LSB                                 15
`define AQDE_SRC_CONFIG_MONO_TRANSPARENCY_SIZE                                 1
