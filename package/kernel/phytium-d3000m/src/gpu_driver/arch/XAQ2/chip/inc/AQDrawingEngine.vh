`define AQDE_SRC_COLOR_FG_BLUE_MSB                                             7
`define AQDE_SRC_COLOR_FG_BLUE_LSB                                             0
`define AQDE_SRC_COLOR_FG_BLUE_SIZE                                            8

/* Register AQDEStretchFactorLow **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQDEStretchFactorLowRegAddrs                                    16'h0488
`define AQDE_STRETCH_FACTOR_LOW_MSB                                           15
`define AQDE_STRETCH_FACTOR_LOW_LSB                                            0
`define AQDE_STRETCH_FACTOR_LOW_BLK                                            0
`define AQDE_STRETCH_FACTOR_LOW_Count                                          1
`define AQDE_STRETCH_FACTOR_LOW_FieldMask                           32'h7FFFFFFF
`define AQDE_STRETCH_FACTOR_LOW_ReadMask                            32'h7FFFFFFF
`define AQDE_STRETCH_FACTOR_LOW_WriteMask                           32'h7FFFFFFF
`define AQDE_STRETCH_FACTOR_LOW_ResetValue                          32'h00000000

/* Horizontal stretch factor in 15.16 fixed point format. The value is        **
** calculated using the following formula: factor = ((srcWidth - 1) << 16) /  **
** (dstWidth - 1). Stretch blit uses only the integer part of the value,      **
** while Filter blit uses all 31 bits.                                        */
`define AQDE_STRETCH_FACTOR_LOW_X_MSB                                         30
`define AQDE_STRETCH_FACTOR_LOW_X_LSB                                          0
`define AQDE_STRETCH_FACTOR_LOW_X_SIZE                                        31

/* Register AQDEStretchFactorHigh **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQDEStretchFactorHighRegAddrs                                   16'h0489
`define AQDE_STRETCH_FACTOR_HIGH_MSB                                          15
`define AQDE_STRETCH_FACTOR_HIGH_LSB                                           0
`define AQDE_STRETCH_FACTOR_LOW_HIGH_BLK                                       0
`define AQDE_STRETCH_FACTOR_HIGH_Count                                         1
`define AQDE_STRETCH_FACTOR_HIGH_FieldMask                          32'h7FFFFFFF
`define AQDE_STRETCH_FACTOR_HIGH_ReadMask                           32'h7FFFFFFF
`define AQDE_STRETCH_FACTOR_HIGH_WriteMask                          32'h7FFFFFFF
`define AQDE_STRETCH_FACTOR_HIGH_ResetValue                         32'h00000000

/* Vertical stretch factor in 15.16 fixed point format. The value is          **
** calculated using the following formula: factor = ((srcHeight - 1) << 16) / **
** (dstHeight - 1). Stretch blit uses only the integer part of the value,     **
** while Filter blit uses all 31 bits.                                        */
`define AQDE_STRETCH_FACTOR_HIGH_Y_MSB                                        30
`define AQDE_STRETCH_FACTOR_HIGH_Y_LSB                                         0
`define AQDE_STRETCH_FACTOR_HIGH_Y_SIZE                                       31

/* Register AQDEDestAddress **
** ~~~~~~~~~~~~~~~~~~~~~~~~ */

/* 32-bit aligned base address of the destination surface. */

`define AQDEDestAddressRegAddrs                                         16'h048A
`define AQDE_DEST_ADDRESS_MSB                                                 15
`define AQDE_DEST_ADDRESS_LSB                                                  0
`define AQDE_DEST_ADDRESS_BLK                                                  0
`define AQDE_DEST_ADDRESS_Count                                                1
`define AQDE_DEST_ADDRESS_FieldMask                                 32'hFFFFFFFF
`define AQDE_DEST_ADDRESS_ReadMask                                  32'hFFFFFFFC
`define AQDE_DEST_ADDRESS_WriteMask                                 32'hFFFFFFFC
`define AQDE_DEST_ADDRESS_ResetValue                                32'h00000000

`define AQDE_DEST_ADDRESS_TYPE_MSB                                            31
`define AQDE_DEST_ADDRESS_TYPE_LSB                                            31
`define AQDE_DEST_ADDRESS_TYPE_SIZE                                            1
`define   AQDE_DEST_ADDRESS_TYPE_SYSTEM                                     1'h0
`define   AQDE_DEST_ADDRESS_TYPE_VIRTUAL_SYSTEM                             1'h1

`define AQDE_DEST_ADDRESS_ADDRESS_MSB                                         30
`define AQDE_DEST_ADDRESS_ADDRESS_LSB                                          0
`define AQDE_DEST_ADDRESS_ADDRESS_SIZE                                        31

/* Register AQDEDestStride **
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* Stride of the destination surface in bytes. To calculate the stride        **
** multiply the surface width in pixels (8-pixel aligned) by the number of    **
** bytes per pixel.                                                           */

`define AQDEDestStrideRegAddrs                                          16'h048B
`define AQDE_DEST_STRIDE_MSB                                                  15
`define AQDE_DEST_STRIDE_LSB                                                   0
`define AQDE_DEST_STRIDE_BLK                                                   0
`define AQDE_DEST_STRIDE_Count                                                 1
`define AQDE_DEST_STRIDE_FieldMask                                  32'h0003FFFF
`define AQDE_DEST_STRIDE_ReadMask                                   32'h0003FFFC
`define AQDE_DEST_STRIDE_WriteMask                                  32'h0003FFFC
`define AQDE_DEST_STRIDE_ResetValue                                 32'h00000000

`define AQDE_DEST_STRIDE_STRIDE_MSB                                           17
`define AQDE_DEST_STRIDE_STRIDE_LSB                                            0
`define AQDE_DEST_STRIDE_STRIDE_SIZE                                          18

