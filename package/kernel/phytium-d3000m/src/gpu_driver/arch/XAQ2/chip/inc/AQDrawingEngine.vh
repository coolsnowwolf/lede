`define   AQDE_PATTERN_CONFIG_SWIZZLE_ARGB                                  2'h0
`define   AQDE_PATTERN_CONFIG_SWIZZLE_RGBA                                  2'h1
`define   AQDE_PATTERN_CONFIG_SWIZZLE_ABGR                                  2'h2
`define   AQDE_PATTERN_CONFIG_SWIZZLE_BGRA                                  2'h3

/* Defines what should be initialized. If DEFAULT or INIT_CONFIG are set,     **
** only pattern configuration will be modified. If INIT_PATTERN is set, the   **
** pattern cache will be reloaded using the current configuration. If         **
** INIT_ALL is set, first the configuration will be updated, then the pattern **
** cache will be reloaded based on the updated configuration.                 */
`define AQDE_PATTERN_CONFIG_INIT_TRIGGER_MSB                                   7
`define AQDE_PATTERN_CONFIG_INIT_TRIGGER_LSB                                   6
`define AQDE_PATTERN_CONFIG_INIT_TRIGGER_SIZE                                  2
`define   AQDE_PATTERN_CONFIG_INIT_TRIGGER_DEFAULT                          2'h0
`define   AQDE_PATTERN_CONFIG_INIT_TRIGGER_INIT_CONFIG                      2'h1
`define   AQDE_PATTERN_CONFIG_INIT_TRIGGER_INIT_PATTERN                     2'h2
`define   AQDE_PATTERN_CONFIG_INIT_TRIGGER_INIT_ALL                         2'h3

/* For chips with 2DPE20 feature defined this field is obsolete. For older    **
** chips where 2DPE20 feature is not defined this field determines the format **
** of AQDEPatternFgColor and AQDEPatternBgColor registers. If set, the values **
** must be set in A8R8G8B8 format, otherwise the values must be preconverted  **
** to the final format.                                                       */
`define AQDE_PATTERN_CONFIG_COLOR_CONVERT_MSB                                  5
`define AQDE_PATTERN_CONFIG_COLOR_CONVERT_LSB                                  5
`define AQDE_PATTERN_CONFIG_COLOR_CONVERT_SIZE                                 1
`define   AQDE_PATTERN_CONFIG_COLOR_CONVERT_OFF                             1'h0
`define   AQDE_PATTERN_CONFIG_COLOR_CONVERT_ON                              1'h1

/* If set to SOLID_COLOR, the pattern color is defined by the                 **
** AQDEPatternFgColor register, the value of which could used straight or     **
** converted to destination format (see COLOR_CONVERT field of this           **
** register). If set to PATTERN and the pattern format is monochrome, the     **
** pattern colors are determined by the AQDEPatternFgColor and                **
** AQDEPatternBgColor register pair based on the pattern values from          **
** AQDEPatternLow and AQDEPatternHigh registers. If set to PATTERN and the    **
** pattern format is not monochrome, the pattern is loaded from memory        **
** starting from the address specified in AQDEPatternAddress register.        */
`define AQDE_PATTERN_CONFIG_TYPE_MSB                                           4
`define AQDE_PATTERN_CONFIG_TYPE_LSB                                           4
`define AQDE_PATTERN_CONFIG_TYPE_SIZE                                          1
`define   AQDE_PATTERN_CONFIG_TYPE_SOLID_COLOR                              1'h0
`define   AQDE_PATTERN_CONFIG_TYPE_PATTERN                                  1'h1

/* Defines the pixel format of the pattern and is used for PATTERN patterns   **
** (see TYPE field of this register).  NOTE: the field is obsolete for chips  **
** with 2DPE20 feature defined. For those chips use PatternFormat field.      */
`define AQDE_PATTERN_CONFIG_FORMAT_MSB                                         3
`define AQDE_PATTERN_CONFIG_FORMAT_LSB                                         0
`define AQDE_PATTERN_CONFIG_FORMAT_SIZE                                        4
`define   AQDE_PATTERN_CONFIG_FORMAT_X4R4G4B4                               4'h0
`define   AQDE_PATTERN_CONFIG_FORMAT_A4R4G4B4                               4'h1
`define   AQDE_PATTERN_CONFIG_FORMAT_X1R5G5B5                               4'h2
`define   AQDE_PATTERN_CONFIG_FORMAT_A1R5G5B5                               4'h3
`define   AQDE_PATTERN_CONFIG_FORMAT_R5G6B5                                 4'h4
`define   AQDE_PATTERN_CONFIG_FORMAT_X8R8G8B8                               4'h5
`define   AQDE_PATTERN_CONFIG_FORMAT_A8R8G8B8                               4'h6
`define   AQDE_PATTERN_CONFIG_FORMAT_YUY2                                   4'h7
`define   AQDE_PATTERN_CONFIG_FORMAT_UYVY                                   4'h8
`define   AQDE_PATTERN_CONFIG_FORMAT_INDEX8                                 4'h9
`define   AQDE_PATTERN_CONFIG_FORMAT_MONOCHROME                             4'hA
`define   AQDE_PATTERN_CONFIG_FORMAT_AYUV                                   4'hB
`define   AQDE_PATTERN_CONFIG_FORMAT_RGB888_PLANAR                          4'hC
`define   AQDE_PATTERN_CONFIG_FORMAT_RGB888_PACKED                          4'hD
`define   AQDE_PATTERN_CONFIG_FORMAT_EXTENSION                              4'hE
`define   AQDE_PATTERN_CONFIG_FORMAT_YV12                                   4'hF

/* Register AQDEPatternLow **
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* This register defines the pattern value for monochrome patterns. Color     **
** values from the AQDEPatternFgColor and AQDEPatternBgColor register pair    **
** are used in conjunction with the value of this register to determine the   **
** final color. The pattern is 8x8 pixels and is defined row by row.          */

`define AQDEPatternLowRegAddrs                                          16'h0490
`define AQDE_PATTERN_LOW_MSB                                                  15
`define AQDE_PATTERN_LOW_LSB                                                   0
`define AQDE_PATTERN_LOW_BLK                                                   0
`define AQDE_PATTERN_LOW_Count                                                 1
`define AQDE_PATTERN_LOW_FieldMask                                  32'hFFFFFFFF
`define AQDE_PATTERN_LOW_ReadMask                                   32'hFFFFFFFF
`define AQDE_PATTERN_LOW_WriteMask                                  32'hFFFFFFFF
`define AQDE_PATTERN_LOW_ResetValue                                 32'h00000000

`define AQDE_PATTERN_LOW_ROW0_MSB                                              7
`define AQDE_PATTERN_LOW_ROW0_LSB                                              0
`define AQDE_PATTERN_LOW_ROW0_SIZE                                             8

`define AQDE_PATTERN_LOW_ROW1_MSB                                             15
`define AQDE_PATTERN_LOW_ROW1_LSB                                              8
`define AQDE_PATTERN_LOW_ROW1_SIZE                                             8

`define AQDE_PATTERN_LOW_ROW2_MSB                                             23
`define AQDE_PATTERN_LOW_ROW2_LSB                                             16
`define AQDE_PATTERN_LOW_ROW2_SIZE                                             8

`define AQDE_PATTERN_LOW_ROW3_MSB                                             31
`define AQDE_PATTERN_LOW_ROW3_LSB                                             24
`define AQDE_PATTERN_LOW_ROW3_SIZE                                             8

/* Register AQDEPatternHigh **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQDEPatternHighRegAddrs                                         16'h0491
`define AQDE_PATTERN_HIGH_MSB                                                 15
`define AQDE_PATTERN_HIGH_LSB                                                  0
`define AQDE_PATTERN_LOW_HIGH_BLK                                              0
`define AQDE_PATTERN_HIGH_Count                                                1
`define AQDE_PATTERN_HIGH_FieldMask                                 32'hFFFFFFFF
`define AQDE_PATTERN_HIGH_ReadMask                                  32'hFFFFFFFF
`define AQDE_PATTERN_HIGH_WriteMask                                 32'hFFFFFFFF
`define AQDE_PATTERN_HIGH_ResetValue                                32'h00000000

`define AQDE_PATTERN_HIGH_ROW4_MSB                                             7
`define AQDE_PATTERN_HIGH_ROW4_LSB                                             0
`define AQDE_PATTERN_HIGH_ROW4_SIZE                                            8

`define AQDE_PATTERN_HIGH_ROW5_MSB                                            15
`define AQDE_PATTERN_HIGH_ROW5_LSB                                             8
`define AQDE_PATTERN_HIGH_ROW5_SIZE                                            8

`define AQDE_PATTERN_HIGH_ROW6_MSB                                            23
`define AQDE_PATTERN_HIGH_ROW6_LSB                                            16
`define AQDE_PATTERN_HIGH_ROW6_SIZE                                            8

`define AQDE_PATTERN_HIGH_ROW7_MSB                                            31
`define AQDE_PATTERN_HIGH_ROW7_LSB                                            24
`define AQDE_PATTERN_HIGH_ROW7_SIZE                                            8

/* Register AQDEPatternMaskLow **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Pattern mask is used only when the transparency is defined by pattern.     **
** Pattern mask is defined in rows, one bit per pixel. Each mask bit is used  **
** to select the ROP code to use for this particular pixel. If mask bit is 0, **
** the pixel is called transparent and background ROP is used, if the bit is  **
** 1, the pixel is called opaque and foreground ROP is used on it.            */

`define AQDEPatternMaskLowRegAddrs                                      16'h0492
`define AQDE_PATTERN_MASK_LOW_MSB                                             15
`define AQDE_PATTERN_MASK_LOW_LSB                                              0
`define AQDE_PATTERN_MASK_LOW_BLK                                              0
`define AQDE_PATTERN_MASK_LOW_Count                                            1
`define AQDE_PATTERN_MASK_LOW_FieldMask                             32'hFFFFFFFF
`define AQDE_PATTERN_MASK_LOW_ReadMask                              32'hFFFFFFFF
`define AQDE_PATTERN_MASK_LOW_WriteMask                             32'hFFFFFFFF
`define AQDE_PATTERN_MASK_LOW_ResetValue                            32'hFFFFFFFF

`define AQDE_PATTERN_MASK_LOW_ROW0_MSB                                         7
`define AQDE_PATTERN_MASK_LOW_ROW0_LSB                                         0
`define AQDE_PATTERN_MASK_LOW_ROW0_SIZE                                        8

`define AQDE_PATTERN_MASK_LOW_ROW1_MSB                                        15
`define AQDE_PATTERN_MASK_LOW_ROW1_LSB                                         8
`define AQDE_PATTERN_MASK_LOW_ROW1_SIZE                                        8

`define AQDE_PATTERN_MASK_LOW_ROW2_MSB                                        23
`define AQDE_PATTERN_MASK_LOW_ROW2_LSB                                        16
`define AQDE_PATTERN_MASK_LOW_ROW2_SIZE                                        8

`define AQDE_PATTERN_MASK_LOW_ROW3_MSB                                        31
`define AQDE_PATTERN_MASK_LOW_ROW3_LSB                                        24
`define AQDE_PATTERN_MASK_LOW_ROW3_SIZE                                        8

/* Register AQDEPatternMaskHigh **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */
`define AQDEPatternMaskHighRegAddrs                                     16'h0493
`define AQDE_PATTERN_MASK_HIGH_MSB                                            15
`define AQDE_PATTERN_MASK_HIGH_LSB                                             0
`define AQDE_PATTERN_MASK_LOW_HIGH_BLK                                         0
`define AQDE_PATTERN_MASK_HIGH_Count                                           1
`define AQDE_PATTERN_MASK_HIGH_FieldMask                            32'hFFFFFFFF
`define AQDE_PATTERN_MASK_HIGH_ReadMask                             32'hFFFFFFFF
`define AQDE_PATTERN_MASK_HIGH_WriteMask                            32'hFFFFFFFF
`define AQDE_PATTERN_MASK_HIGH_ResetValue                           32'hFFFFFFFF

`define AQDE_PATTERN_MASK_HIGH_ROW4_MSB                                        7
`define AQDE_PATTERN_MASK_HIGH_ROW4_LSB                                        0
`define AQDE_PATTERN_MASK_HIGH_ROW4_SIZE                                       8

`define AQDE_PATTERN_MASK_HIGH_ROW5_MSB                                       15
`define AQDE_PATTERN_MASK_HIGH_ROW5_LSB                                        8
`define AQDE_PATTERN_MASK_HIGH_ROW5_SIZE                                       8

`define AQDE_PATTERN_MASK_HIGH_ROW6_MSB                                       23
`define AQDE_PATTERN_MASK_HIGH_ROW6_LSB                                       16
`define AQDE_PATTERN_MASK_HIGH_ROW6_SIZE                                       8

`define AQDE_PATTERN_MASK_HIGH_ROW7_MSB                                       31
`define AQDE_PATTERN_MASK_HIGH_ROW7_LSB                                       24
`define AQDE_PATTERN_MASK_HIGH_ROW7_SIZE                                       8

/* Register AQDEPatternBgColor **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Defines the background color for monochrome patterns. For chips with       **
** 2DPE20 feature defined the color must be set in A8R8G8B8 format, otherwise **
** the format depends on the setting of ColorConvert field of                 **
** AQDEPatternConfig register.                                                */

`define AQDEPatternBgColorRegAddrs                                      16'h0494
`define AQDE_PATTERN_BG_COLOR_MSB                                             15
`define AQDE_PATTERN_BG_COLOR_LSB                                              0
`define AQDE_PATTERN_BG_COLOR_BLK                                              0
`define AQDE_PATTERN_BG_COLOR_Count                                            1
`define AQDE_PATTERN_BG_COLOR_FieldMask                             32'hFFFFFFFF
`define AQDE_PATTERN_BG_COLOR_ReadMask                              32'hFFFFFFFF
`define AQDE_PATTERN_BG_COLOR_WriteMask                             32'hFFFFFFFF
`define AQDE_PATTERN_BG_COLOR_ResetValue                            32'h00000000

`define AQDE_PATTERN_BG_COLOR_ALPHA_MSB                                       31
`define AQDE_PATTERN_BG_COLOR_ALPHA_LSB                                       24
`define AQDE_PATTERN_BG_COLOR_ALPHA_SIZE                                       8

`define AQDE_PATTERN_BG_COLOR_RED_MSB                                         23
`define AQDE_PATTERN_BG_COLOR_RED_LSB                                         16
`define AQDE_PATTERN_BG_COLOR_RED_SIZE                                         8

`define AQDE_PATTERN_BG_COLOR_GREEN_MSB                                       15
`define AQDE_PATTERN_BG_COLOR_GREEN_LSB                                        8
`define AQDE_PATTERN_BG_COLOR_GREEN_SIZE                                       8

`define AQDE_PATTERN_BG_COLOR_BLUE_MSB                                         7
`define AQDE_PATTERN_BG_COLOR_BLUE_LSB                                         0
`define AQDE_PATTERN_BG_COLOR_BLUE_SIZE                                        8

/* Register AQDEPatternFgColor **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Defines the foreground color for monochrome patterns. For chips with       **
** 2DPE20 feature defined the color must be set in A8R8G8B8 format, otherwise **
** the format depends on the setting of ColorConvert field of                 **
** AQDEPatternConfig register.                                                */

`define AQDEPatternFgColorRegAddrs                                      16'h0495
`define AQDE_PATTERN_FG_COLOR_MSB                                             15
`define AQDE_PATTERN_FG_COLOR_LSB                                              0
`define AQDE_PATTERN_FG_COLOR_BLK                                              0
`define AQDE_PATTERN_FG_COLOR_Count                                            1
`define AQDE_PATTERN_FG_COLOR_FieldMask                             32'hFFFFFFFF
`define AQDE_PATTERN_FG_COLOR_ReadMask                              32'hFFFFFFFF
`define AQDE_PATTERN_FG_COLOR_WriteMask                             32'hFFFFFFFF
`define AQDE_PATTERN_FG_COLOR_ResetValue                            32'h00000000

`define AQDE_PATTERN_FG_COLOR_ALPHA_MSB                                       31
`define AQDE_PATTERN_FG_COLOR_ALPHA_LSB                                       24
`define AQDE_PATTERN_FG_COLOR_ALPHA_SIZE                                       8

`define AQDE_PATTERN_FG_COLOR_RED_MSB                                         23
`define AQDE_PATTERN_FG_COLOR_RED_LSB                                         16
`define AQDE_PATTERN_FG_COLOR_RED_SIZE                                         8

`define AQDE_PATTERN_FG_COLOR_GREEN_MSB                                       15
`define AQDE_PATTERN_FG_COLOR_GREEN_LSB                                        8
`define AQDE_PATTERN_FG_COLOR_GREEN_SIZE                                       8

`define AQDE_PATTERN_FG_COLOR_BLUE_MSB                                         7
`define AQDE_PATTERN_FG_COLOR_BLUE_LSB                                         0
`define AQDE_PATTERN_FG_COLOR_BLUE_SIZE                                        8

/* Register AQDEFilterBlit **
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* Filter blit configuration regisrter. This register MUST be programmed      **
** before AQDEFilterKernel.                                                   */

`define AQDEFilterBlitRegAddrs                                          16'h0496
`define AQDE_FILTER_BLIT_MSB                                                  15
`define AQDE_FILTER_BLIT_LSB                                                   0
`define AQDE_FILTER_BLIT_BLK                                                   0
`define AQDE_FILTER_BLIT_Count                                                 1
`define AQDE_FILTER_BLIT_FieldMask                                  32'h000000FF
`define AQDE_FILTER_BLIT_ReadMask                                   32'h000000FF
`define AQDE_FILTER_BLIT_WriteMask                                  32'h000000FF
`define AQDE_FILTER_BLIT_ResetValue                                 32'h00000000

/* If set, the horizontal blit will walk all the way to the left edge         **
** allowing to sample pixels to the left of the center which could be beyond  **
** the source edge. This assumes that there are enough valid pixels beyond    **
** the left edge to cover the size of the kernel. For example if the kernel   **
** size is 9, there should be at least 4 valid pixels beyond the edge. This   **
** mode is used for split frame rendering to prevent seams between the        **
** subframes.  NOTE: this field is now obsolete.                              */
`define AQDE_FILTER_BLIT_IGNORE_LEFT_EDGE_MSB                                  7
`define AQDE_FILTER_BLIT_IGNORE_LEFT_EDGE_LSB                                  7
`define AQDE_FILTER_BLIT_IGNORE_LEFT_EDGE_SIZE                                 1

/* The same as IGNORE_LEFT_EDGE field, but for the top edge in vertical blit. **
**  NOTE: this field is now obsolete.                                         */
`define AQDE_FILTER_BLIT_IGNORE_TOP_EDGE_MSB                                   6
`define AQDE_FILTER_BLIT_IGNORE_TOP_EDGE_LSB                                   6
`define AQDE_FILTER_BLIT_IGNORE_TOP_EDGE_SIZE                                  1

/* The same as IGNORE_LEFT_EDGE field, but for the right edge.  NOTE: this    **
** field is now obsolete.                                                     */
`define AQDE_FILTER_BLIT_IGNORE_RIGHT_EDGE_MSB                                 5
`define AQDE_FILTER_BLIT_IGNORE_RIGHT_EDGE_LSB                                 5
`define AQDE_FILTER_BLIT_IGNORE_RIGHT_EDGE_SIZE                                1

/* The same as IGNORE_LEFT_EDGE field, but for the bottom edge in vertical    **
** blit.  NOTE: this field is now obsolete.                                   */
`define AQDE_FILTER_BLIT_IGNORE_BOTTOM_EDGE_MSB                                4
`define AQDE_FILTER_BLIT_IGNORE_BOTTOM_EDGE_LSB                                4
`define AQDE_FILTER_BLIT_IGNORE_BOTTOM_EDGE_SIZE                               1

/* The size of the kernel; determines number of source samples to be taken to **
** determine each destination pixel. Valid values are 1, 3, 5, 7, 9.          */
`define AQDE_FILTER_BLIT_KERNEL_SIZE_MSB                                       3
`define AQDE_FILTER_BLIT_KERNEL_SIZE_LSB                                       0
`define AQDE_FILTER_BLIT_KERNEL_SIZE_SIZE                                      4

/* Register AQDEFilterKernel (128 in total) **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* Filter blit coefficient table. */

`define AQDEFilterKernelRegAddrs                                          9'h00C
`define AQDE_FILTER_KERNEL_MSB                                                15
`define AQDE_FILTER_KERNEL_LSB                                                 7
`define AQDE_FILTER_KERNEL_BLK                                                 7
`define AQDE_FILTER_KERNEL_Count                                             128
`define AQDE_FILTER_KERNEL_FieldMask                                32'hFFFFFFFF
`define AQDE_FILTER_KERNEL_ReadMask                                 32'hFFFFFFFF
`define AQDE_FILTER_KERNEL_WriteMask                                32'hFFFFFFFF
`define AQDE_FILTER_KERNEL_ResetValue                               32'h00000000

