/* 1 enables VIP 5 deep sleep.  This is set for DPP V500. EnVIP0~3 is set in  **
** bits 7:0 of gcregAHBXDeepSleep0.                                           */
`define GCREG_AHBX_DEEP_SLEEP0_APPENDIX_EN_VIP5_MSB                            3
`define GCREG_AHBX_DEEP_SLEEP0_APPENDIX_EN_VIP5_LSB                            2
