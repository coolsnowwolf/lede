`define GCREG_AHB_OVERLAP_CHECK_ReadMask                            32'h0000000F
`define GCREG_AHB_OVERLAP_CHECK_WriteMask                           32'h0000000F
`define GCREG_AHB_OVERLAP_CHECK_ResetValue                          32'h00000000

/* Set for DMA7 and DMA8. Check whether its configuration is repeated.  */
`define GCREG_AHB_OVERLAP_CHECK_DMA78_CONFIG_MSB                               0
`define GCREG_AHB_OVERLAP_CHECK_DMA78_CONFIG_LSB                               0
`define GCREG_AHB_OVERLAP_CHECK_DMA78_CONFIG_SIZE                              1

/* Set for DMA2, DMA3, and DMA4. Check whether its configuration is repeated. */
`define GCREG_AHB_OVERLAP_CHECK_DMA234_CONFIG_MSB                              1
`define GCREG_AHB_OVERLAP_CHECK_DMA234_CONFIG_LSB                              1
`define GCREG_AHB_OVERLAP_CHECK_DMA234_CONFIG_SIZE                             1

/* Next stripe's kernel overwrite previous stripe's DMA1 data.  */
`define GCREG_AHB_OVERLAP_CHECK_KERNEL_STAMPEDE_DMA_MSB                        2
`define GCREG_AHB_OVERLAP_CHECK_KERNEL_STAMPEDE_DMA_LSB                        2
`define GCREG_AHB_OVERLAP_CHECK_KERNEL_STAMPEDE_DMA_SIZE                       1

/* The system processes a maximum of two stripes at a time.  */
`define GCREG_AHB_OVERLAP_CHECK_FRAME_START_OVERFLOW_MSB                       3
`define GCREG_AHB_OVERLAP_CHECK_FRAME_START_OVERFLOW_LSB                       3
`define GCREG_AHB_OVERLAP_CHECK_FRAME_START_OVERFLOW_SIZE                      1

