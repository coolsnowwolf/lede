`define GCREG_TTDMA_WORD24_PSI_IN_EXTRACTOR_BORDER_CONSTANT_LSB               16
`define GCREG_TTDMA_WORD24_PSI_IN_EXTRACTOR_BORDER_CONSTANT_SIZE              16

