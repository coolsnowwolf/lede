`define GCREG_AHBXIOMMU_FieldMask                                   32'h00000001
`define GCREG_AHBXIOMMU_ReadMask                                    32'h00000001
`define GCREG_AHBXIOMMU_WriteMask                                   32'h00000001
`define GCREG_AHBXIOMMU_ResetValue                                  32'h00000000

/* Write 0 has no effect.  Write 1 to send an event pulse to MMU_IRQ logic.   **
** Write Only.                                                                */
`define GCREG_AHBXIOMMU_SW_EVENT_MSB                                           0
`define GCREG_AHBXIOMMU_SW_EVENT_LSB                                           0
`define GCREG_AHBXIOMMU_SW_EVENT_SIZE                                          1

/* Register gcregAHBXIOMMURawStatus **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB XIO-MMU Raw Status Register.  SWEvent/DMA7/DMA8 Raw Status. AHB only.  */

`define gcregAHBXIOMMURawStatusRegAddrs                                 16'h0CDB
`define GCREG_AHBXIOMMU_RAW_STATUS_MSB                                        15
`define GCREG_AHBXIOMMU_RAW_STATUS_LSB                                         0
`define GCREG_AHBXIOMMU_RAW_STATUS_BLK                                         0
`define GCREG_AHBXIOMMU_RAW_STATUS_Count                                       1
`define GCREG_AHBXIOMMU_RAW_STATUS_FieldMask                        32'h0000000F
`define GCREG_AHBXIOMMU_RAW_STATUS_ReadMask                         32'h0000000F
`define GCREG_AHBXIOMMU_RAW_STATUS_WriteMask                        32'h0000000F
`define GCREG_AHBXIOMMU_RAW_STATUS_ResetValue                       32'h00000000

/* SW Event raw status. Set when a SWEvent pulse occurs.  Write 1 to clear.   **
** All MMU raw status register bits should be put together into a single      **
** register address.                                                          */
`define GCREG_AHBXIOMMU_RAW_STATUS_SW_EVENT_MSB                                0
`define GCREG_AHBXIOMMU_RAW_STATUS_SW_EVENT_LSB                                0
`define GCREG_AHBXIOMMU_RAW_STATUS_SW_EVENT_SIZE                               1

/* DMA7 completion raw status.  Write 1 to clear.  */
`define GCREG_AHBXIOMMU_RAW_STATUS_DMA7_COMPL_MSB                              1
`define GCREG_AHBXIOMMU_RAW_STATUS_DMA7_COMPL_LSB                              1
`define GCREG_AHBXIOMMU_RAW_STATUS_DMA7_COMPL_SIZE                             1

/* DMA8 completion raw status.   Write 1 to clear.  */
`define GCREG_AHBXIOMMU_RAW_STATUS_DMA8_COMPL_MSB                              2
`define GCREG_AHBXIOMMU_RAW_STATUS_DMA8_COMPL_LSB                              2
`define GCREG_AHBXIOMMU_RAW_STATUS_DMA8_COMPL_SIZE                             1

/* DMA7 and DMA8 completion raw status.  Write 1 to clear */
`define GCREG_AHBXIOMMU_RAW_STATUS_ALL_DMA_COMPL_MSB                           3
`define GCREG_AHBXIOMMU_RAW_STATUS_ALL_DMA_COMPL_LSB                           3
`define GCREG_AHBXIOMMU_RAW_STATUS_ALL_DMA_COMPL_SIZE                          1

/* Register gcregAHBXIOMMUIntrStatus **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB XIO-MMU Interrupt Status Register.  SWEvent/DMA7/DMA8 interrupt        **
** status. AHB only.  Status is set when the companion interrupt_enable bit   **
** in  register gcregAHBXIOMMUIntrEn is set and the trigger event occurs.     */

`define gcregAHBXIOMMUIntrStatusRegAddrs                                16'h0CDC
`define GCREG_AHBXIOMMU_INTR_STATUS_MSB                                       15
`define GCREG_AHBXIOMMU_INTR_STATUS_LSB                                        0
