`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP0_MSB                                24
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP0_LSB                                24
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP0_SIZE                                1

/* Top Level AHB. Software sets 1 to reset all logic of VIP 1.  This field is **
** AHB only. It does not havw a related state load define. It is not          **
** shadowed.  Soft reset of VIP4~5 are set in bits 1:0 in register            **
** gcregAHBXTTDMiscAppendix.                                                  */
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP1_MSB                                25
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP1_LSB                                25
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP1_SIZE                                1

