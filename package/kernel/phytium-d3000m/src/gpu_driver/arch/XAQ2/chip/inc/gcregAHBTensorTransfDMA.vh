/* Software reset ACLK for VIP2.  This field is AHB only. It does not havw a  **
** related state load define. It is not shadowed.  Soft resets of ACLKVIP4~5  **
** are set in bits 3:2 in register gcregAHBXTTDMiscAppendix.                  */
`define GCREG_AHBXTTD_MISC_SOFT_RESET_ACLKVIP2_MSB                            30
`define GCREG_AHBXTTD_MISC_SOFT_RESET_ACLKVIP2_LSB                            30
`define GCREG_AHBXTTD_MISC_SOFT_RESET_ACLKVIP2_SIZE                            1

