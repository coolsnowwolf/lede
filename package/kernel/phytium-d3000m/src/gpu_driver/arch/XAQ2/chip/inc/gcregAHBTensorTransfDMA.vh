/* Register gcregAHBDenoisePostProcess **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB DenoisePostProcess Shadow Configuration Register.  */

`define gcregAHBDenoisePostProcessRegAddrs                              16'h0B6A
`define GCREG_AHB_DENOISE_POST_PROCESS_MSB                                    15
`define GCREG_AHB_DENOISE_POST_PROCESS_LSB                                     0
`define GCREG_AHB_DENOISE_POST_PROCESS_BLK                                     0
`define GCREG_AHB_DENOISE_POST_PROCESS_Count                                   1
`define GCREG_AHB_DENOISE_POST_PROCESS_FieldMask                    32'h000003FF
`define GCREG_AHB_DENOISE_POST_PROCESS_ReadMask                     32'h000003FF
`define GCREG_AHB_DENOISE_POST_PROCESS_WriteMask                    32'h000003FF
`define GCREG_AHB_DENOISE_POST_PROCESS_ResetValue                   32'h00000000

/* DenoisePostProcess Mask mode. 3 bits total:  DMA_SOURCE_MASK_BIT2, upper   **
** bit is bit 8 in this register.  0: Mask(3:0) = {4{DMA4(4)}} (V400          **
** compatible setting);  1: Mask(3:0) = DMA2(7:4);  2: Mask(3:0) = DMA4(7:4); **
**  3: Mask(3:0) = {4{DMA4(4)}}, NewMask = DMA4[5];.  4: Mask(3:0) =          **
** DMA4(7:4), NewMask = DMA4[8];  5~7  Unused.                                */
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_MSB                     1
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_LSB                     0
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_SIZE                    2

/* DenoisePostProcess Bypass Multiplication Logic level.  0: Bypass           **
** DenoisePostProcess Level V400;  1: Bypass DenoisePostProcess Level V500.   */
`define GCREG_AHB_DENOISE_POST_PROCESS_ONE_SUB_MASK_MSB                        2
`define GCREG_AHB_DENOISE_POST_PROCESS_ONE_SUB_MASK_LSB                        2
`define GCREG_AHB_DENOISE_POST_PROCESS_ONE_SUB_MASK_SIZE                       1

/* 1: Bypass the DenoisePostProcess module in V500.  Use gcregTTDMisc Bit[2]  **
** for DPP bypass in V400.  Out = PSI Out 2                                   */
`define GCREG_AHB_DENOISE_POST_PROCESS_BYPASS_V500_MSB                         3
`define GCREG_AHB_DENOISE_POST_PROCESS_BYPASS_V500_LSB                         3
`define GCREG_AHB_DENOISE_POST_PROCESS_BYPASS_V500_SIZE                        1

/* DMA2 format. 0: INT16; 1: UINT16.  */
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA2_FORMAT_MSB                         4
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA2_FORMAT_LSB                         4
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA2_FORMAT_SIZE                        1

/* DMA3 format. 0: INT16; 1: UINT16.  */
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA3_FORMAT_MSB                         5
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA3_FORMAT_LSB                         5
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA3_FORMAT_SIZE                        1

/* DMA4 format. 0: INT16; 1: UINT16.  */
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA4_FORMAT_MSB                         6
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA4_FORMAT_LSB                         6
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA4_FORMAT_SIZE                        1

/* DPP output format. 0: INT16; 1: UINT16.  */
`define GCREG_AHB_DENOISE_POST_PROCESS_OUT_FORMAT_MSB                          7
`define GCREG_AHB_DENOISE_POST_PROCESS_OUT_FORMAT_LSB                          7
`define GCREG_AHB_DENOISE_POST_PROCESS_OUT_FORMAT_SIZE                         1

/* DenoisePostProcess Mask mode upper bit 2.  Lower bits are in               **
** gcregAHBDenoisePostProcess[1:0].DMA_SOURCE_MASK  0: Mask(3:0) =            **
** {4{DMA4(4)}} (V400 compatible setting);  1: Mask(3:0) = DMA2(7:4);  2:     **
** Mask(3:0) = DMA4(7:4);  3: Mask(3:0) = {4{DMA4(4)}}, NewMask = DMA4[5];.   **
** 4: Mask(3:0) = DMA4(7:4), NewMask = DMA4[8];  5~7  Unused.                 */
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_BIT2_MSB                8
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_BIT2_LSB                8
`define GCREG_AHB_DENOISE_POST_PROCESS_DMA_SOURCE_MASK_BIT2_SIZE               1

/* Clip res mask output.  0: Don't clip;  1: Clip.  */
`define GCREG_AHB_DENOISE_POST_PROCESS_RES_MASK_CLIP_MSB                       9
`define GCREG_AHB_DENOISE_POST_PROCESS_RES_MASK_CLIP_LSB                       9
`define GCREG_AHB_DENOISE_POST_PROCESS_RES_MASK_CLIP_SIZE                      1

/* Register gcregAHBSWControlDualSBIInput **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB Dual SW Control Dual SBI Input 2 Configuration Register.  The          **
** companion register for SBI input 1 is gcregAHBSWControlVXSBI0.             */

`define gcregAHBSWControlDualSBIInputRegAddrs                           16'h0B6B
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_MSB                                15
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_LSB                                 0
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_BLK                                 0
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_Count                               1
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_FieldMask                32'h0000007F
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_ReadMask                 32'h0000007F
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_WriteMask                32'h0000007F
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_ResetValue               32'h00000000

/* This field is set for one input of Isp2NpuDisconnect.  For dual SBI input, **
** the other is in gcregAHBSWControlVXSBI0 bits 1:0  Disconnect ISP2NPU VSBI  **
** signals or not.                                                            */
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_MSB             1
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_LSB             0
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_SIZE            2
/*   ** Connect to ISP. ** */
`define   GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_ISP        2'h0
/*   ** Write 1 to disconnnect ISP2NPU SBI signals and connect to             **
** software-controlled registers.   This step is needed before using the      **
** SBI_rd field for software control. **                                      */
`define   GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_SOFT_CONTROL 2'h1
/*   ** Connect to pattern generator. ** */
`define   GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_ISP2_NPU_DISCONNECT_PATTERN_GEN 2'h2

/* Set 1 to bypass the OCM, PSI input will get data directly from producer    **
** without OCM.  This field is set for one input of OCMBypass of dual SBI     **
** input; another OCMBypass in gcregAHBTTDMisc bits 2.                        */
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_OCM_BYPASS_MSB                      2
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_OCM_BYPASS_LSB                      2
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_OCM_BYPASS_SIZE                     1

/* Start writing a frame or not. 1 indicates start of frame.  This field is   **
** set for one input of SbiWrFrameStart.  For dual SBI input, the other is in **
** gcregAHBSWControlVXSBI0 bit 2                                              */
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_SBI_WR_FRAME_START_MSB              3
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_SBI_WR_FRAME_START_LSB              3
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_SBI_WR_FRAME_START_SIZE             1

/* This field is set for one input of Npu2IspDisconnect.  For dual SBI input, **
** the other is Npu2IspDisconnect in gcregAHBSWControlVXSBI0 bits 4:3.        */
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_MSB             5
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_LSB             4
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_SIZE            2
/*   ** Connect to ISP. ** */
`define   GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_ISP        2'h0
/*   ** Disconnect NPU2ISP SBI signals or not. Value 1 means connect          **
** software-controlled regsiters. This step is needed before using the SBI_rd **
** field for software control. **                                             */
`define   GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_SOFT_CONTROL 2'h1
/*   **Connect to checksum generator. ** */
`define   GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_NPU2_ISP_DISCONNECT_CHECK_SUM_GEN 2'h2

/* Start reading a frame or not. 1 indicates start of frame.  This field is   **
** set for one input of SbiRdFrameStart.  For dual SBI input, the other is in **
** SbiRdFrameStart in gcregAHBSWControlVXSBI0 bit 5                           */
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_SBI_RD_FRAME_START_MSB              6
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_SBI_RD_FRAME_START_LSB              6
`define GCREG_AHBSW_CONTROL_DUAL_SBI_INPUT_SBI_RD_FRAME_START_SIZE             1

