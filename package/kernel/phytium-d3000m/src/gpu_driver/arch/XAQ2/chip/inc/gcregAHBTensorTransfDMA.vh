/* Register gcregAHBXTTDMisc **
** ~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB X-DMA (eXternal DMA) Miscellaneous Control Register.  For system level **
** DMA (X-DMA, eXternal to VIP).                                              */

`define gcregAHBXTTDMiscRegAddrs                                        16'h0B10
`define GCREG_AHBXTTD_MISC_MSB                                                15
`define GCREG_AHBXTTD_MISC_LSB                                                 0
`define GCREG_AHBXTTD_MISC_BLK                                                 0
`define GCREG_AHBXTTD_MISC_Count                                               1
`define GCREG_AHBXTTD_MISC_FieldMask                                32'hFFFFFFFF
`define GCREG_AHBXTTD_MISC_ReadMask                                 32'hFF9FFFFC
`define GCREG_AHBXTTD_MISC_WriteMask                                32'hFFFE01FF
`define GCREG_AHBXTTD_MISC_ResetValue                               32'hFF000040

/* Write 1 to indicate the X-DMA shadow registers are all prepared,  and      **
** should be taken as the new walking pattern at the next frame start.        */
`define GCREG_AHBXTTD_MISC_XSHADOW_REG_PREPARED_MSB                            0
`define GCREG_AHBXTTD_MISC_XSHADOW_REG_PREPARED_LSB                            0
`define GCREG_AHBXTTD_MISC_XSHADOW_REG_PREPARED_SIZE                           1

/* Write 1 to perform a system level X-DMA software frame start.  Walker with **
** Walking_start_control == 2 will be started by this write.                  */
`define GCREG_AHBXTTD_MISC_XSOFTWARE_FRAME_START_MSB                           1
`define GCREG_AHBXTTD_MISC_XSOFTWARE_FRAME_START_LSB                           1
`define GCREG_AHBXTTD_MISC_XSOFTWARE_FRAME_START_SIZE                          1

/* Each bit controls the clock gating of specific VIP clusters. 0 means all   **
** clusters are running.  This is for Top Level AHB only.  These bits set the **
** VIP0~3 clock gates. VIP4 and VIP5 are set with bits 5:4 in register        **
** gcregAHBXTTDMiscAppendix.                                                  */
`define GCREG_AHBXTTD_MISC_VIP_CLUSTER_CLOCK_GATE_MSB                          5
`define GCREG_AHBXTTD_MISC_VIP_CLUSTER_CLOCK_GATE_LSB                          2
`define GCREG_AHBXTTD_MISC_VIP_CLUSTER_CLOCK_GATE_SIZE                         4

/* Top Level AHB. Software sets 1 to reset all logic of the X-DMA and VIP     **
** modules.  This is a AHB only register. It does not have a related state    **
** load define. It is not shadowed.                                           */
`define GCREG_AHBXTTD_MISC_SOFT_RESET_MSB                                      6
`define GCREG_AHBXTTD_MISC_SOFT_RESET_LSB                                      6
`define GCREG_AHBXTTD_MISC_SOFT_RESET_SIZE                                     1

/* Set 1 to bypass the DenoisePostProcess module.  Out = PSI Out 2.  */
`define GCREG_AHBXTTD_MISC_DENOISE_POST_PROCESS_BYPASS_MSB                     7
`define GCREG_AHBXTTD_MISC_DENOISE_POST_PROCESS_BYPASS_LSB                     7
`define GCREG_AHBXTTD_MISC_DENOISE_POST_PROCESS_BYPASS_SIZE                    1

/* Set 1 to bypass the On-Chip Memory (OCM). PSI (Packet Stream Interface)    **
** input will get data directly from Producer without OCM.  This field is set **
** for one input of OCMBypass.  For dual SBI input, the other is in bit 2 in  **
** gcregAHBSWControlDualSBIInput.                                             */
`define GCREG_AHBXTTD_MISC_OCM_BYPASS_MSB                                      8
`define GCREG_AHBXTTD_MISC_OCM_BYPASS_LSB                                      8
`define GCREG_AHBXTTD_MISC_OCM_BYPASS_SIZE                                     1

/* Shows the busy status of system level DMA.  Bit 9 for DMA5, bit 10 fro     **
** DMA6,..., Bit 14 for DMA10.  Bit 15 for MATRIX, MATRIX is for access OCM   **
** logic.  Bit 16 for DMA11, DMA11 is for DPP V500                            */
`define GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_MSB                                16
`define GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_LSB                                 9
`define GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_SIZE                                8
`define   GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_DMA5                          8'h01
`define   GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_DMA6                          8'h02
`define   GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_DMA7                          8'h04
`define   GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_DMA8                          8'h08
`define   GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_DMA9                          8'h10
`define   GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_DMA10                         8'h20
`define   GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_MATRIX                        8'h40
`define   GCREG_AHBXTTD_MISC_XTENSOR_IO_BUSY_DMA11                         8'h80

/* Default Quality of Service (QOS)  Used by all AXI accesses except SBI2PSI, **
** PSI2SBI, Compress2DDR and DDR2Decompress.                                  */
`define GCREG_AHBXTTD_MISC_DEFAULT_QOS_MSB                                    20
`define GCREG_AHBXTTD_MISC_DEFAULT_QOS_LSB                                    17
`define GCREG_AHBXTTD_MISC_DEFAULT_QOS_SIZE                                    4

/* Write 1 indicate the X-ISP walking pattern registers are prepared and      **
** should be taken as the new walking pattern next frame.                     */
`define GCREG_AHBXTTD_MISC_XISP_SHADOW_REG_PREPARED_MSB                       21
`define GCREG_AHBXTTD_MISC_XISP_SHADOW_REG_PREPARED_LSB                       21
`define GCREG_AHBXTTD_MISC_XISP_SHADOW_REG_PREPARED_SIZE                       1

/* Write 1 to perform a X-ISP software frame start.  */
`define GCREG_AHBXTTD_MISC_XISP_SOFT_WARE_FRAME_START_MSB                     22
`define GCREG_AHBXTTD_MISC_XISP_SOFT_WARE_FRAME_START_LSB                     22
`define GCREG_AHBXTTD_MISC_XISP_SOFT_WARE_FRAME_START_SIZE                     1

/* Write 1 to put X-DMA in job cancellation mode.  Job Cancellation is        **
** achieved by writing 1 followed by writing 0.                               */
`define GCREG_AHBXTTD_MISC_XJOB_CANCEL_MSB                                    23
`define GCREG_AHBXTTD_MISC_XJOB_CANCEL_LSB                                    23
`define GCREG_AHBXTTD_MISC_XJOB_CANCEL_SIZE                                    1

