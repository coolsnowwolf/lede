/* Register gcregAHBXTTDMiscAppendix **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB X-DMA (eXternal DMA) Miscellaneous Control Extension Register.  For    **
** system level DMA (X-DMA, eXternal to VIP).  This register is set for Core4 **
** and Core5 related registers (SoftReset and SoftResetACLK}.  Related        **
** register is gcregAHBXTTDMisc.                                              */

`define gcregAHBXTTDMiscAppendixRegAddrs                                16'h0B76
`define GCREG_AHBXTTD_MISC_APPENDIX_MSB                                       15
`define GCREG_AHBXTTD_MISC_APPENDIX_LSB                                        0
`define GCREG_AHBXTTD_MISC_APPENDIX_BLK                                        0
`define GCREG_AHBXTTD_MISC_APPENDIX_Count                                      1
`define GCREG_AHBXTTD_MISC_APPENDIX_FieldMask                       32'h000003FF
`define GCREG_AHBXTTD_MISC_APPENDIX_ReadMask                        32'h000003FF
`define GCREG_AHBXTTD_MISC_APPENDIX_WriteMask                       32'h000003FF
`define GCREG_AHBXTTD_MISC_APPENDIX_ResetValue                      32'h0000014F

/* For Top Level, set 1 for software to reset all logic of VIP4.  This field  **
** is AHB only. It does not have a related state load define. It is not       **
** shadowed.                                                                  */
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_VIP4_MSB                        0
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_VIP4_LSB                        0
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_VIP4_SIZE                       1

/* For Top Level, set 1 for software to reset all logic of VIP5.  This field  **
** is AHB only. It does not have a related state load define. It is not       **
** shadowed.                                                                  */
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_VIP5_MSB                        1
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_VIP5_LSB                        1
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_VIP5_SIZE                       1

/* Software reset of ACLK for VIP4.  This field is AHB only. It does not have **
** a related state load define. It is not shadowed.                           */
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKVIP4_MSB                    2
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKVIP4_LSB                    2
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKVIP4_SIZE                   1

/* Software reset of ACLK for VIP5.  This field is AHB only. It does not have **
** a related state load define. It is not shadowed.                           */
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKVIP5_MSB                    3
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKVIP5_LSB                    3
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKVIP5_SIZE                   1

/* Each bit controls the clock gating of specific VIP clusters. 0 means all   **
** clusters are running.  This field is Top Level AHB only.  It sets clock    **
** gates for VIP4 and VIP5. VIP0~3 are set bits 5:2 of register               **
** gcregAHBXTTDMisc.                                                          */
`define GCREG_AHBXTTD_MISC_APPENDIX_VIP_CLUSTER_CLOCK_GATE_MSB                 5
`define GCREG_AHBXTTD_MISC_APPENDIX_VIP_CLUSTER_CLOCK_GATE_LSB                 4
`define GCREG_AHBXTTD_MISC_APPENDIX_VIP_CLUSTER_CLOCK_GATE_SIZE                2

/* Software reset of ACLK for XIO DMA.  This field is AHB only. It does not   **
** have a related state load define. It is not shadowed.                      */
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKXIODMA_MSB                  6
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKXIODMA_LSB                  6
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLKXIODMA_SIZE                 1

/* Software sets clock gate for VIP Semaphore module.  */
`define GCREG_AHBXTTD_MISC_APPENDIX_VIP_SEMAPHORE_CLOCK_GATE_MSB               7
`define GCREG_AHBXTTD_MISC_APPENDIX_VIP_SEMAPHORE_CLOCK_GATE_LSB               7
`define GCREG_AHBXTTD_MISC_APPENDIX_VIP_SEMAPHORE_CLOCK_GATE_SIZE              1

/* Software reset of ACLK for VIP Semaphore module.  */
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLK_SEMAPHORE_MSB              8
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLK_SEMAPHORE_LSB              8
`define GCREG_AHBXTTD_MISC_APPENDIX_SOFT_RESET_ACLK_SEMAPHORE_SIZE             1

/* Software set clock gate for XIO DMA.  */
`define GCREG_AHBXTTD_MISC_APPENDIX_XIODMA_CLOCK_GATE_MSB                      9
`define GCREG_AHBXTTD_MISC_APPENDIX_XIODMA_CLOCK_GATE_LSB                      9
`define GCREG_AHBXTTD_MISC_APPENDIX_XIODMA_CLOCK_GATE_SIZE                     1

