** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB SBIO ISP-VIP Signal Software Control Register 0.  */

`define gcregAHBSWControlVXSBI0RegAddrs                                 16'h0B1D
`define GCREG_AHBSW_CONTROL_VXSBI0_MSB                                        15
`define GCREG_AHBSW_CONTROL_VXSBI0_LSB                                         0
`define GCREG_AHBSW_CONTROL_VXSBI0_BLK                                         0
`define GCREG_AHBSW_CONTROL_VXSBI0_Count                                       1
`define GCREG_AHBSW_CONTROL_VXSBI0_FieldMask                        32'h0000003F
`define GCREG_AHBSW_CONTROL_VXSBI0_ReadMask                         32'h0000003F
`define GCREG_AHBSW_CONTROL_VXSBI0_WriteMask                        32'h0000003F
`define GCREG_AHBSW_CONTROL_VXSBI0_ResetValue                       32'h00000000

/* This field is set for one input of Isp2NpuDisconnect.  For dual SBI input, **
** the other is in gcregAHBSWControlDualSBIInput bits 1:0  Disconnect ISP2NPU **
** VSBI signals or not.                                                       */
`define GCREG_AHBSW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_MSB                     1
`define GCREG_AHBSW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_LSB                     0
`define GCREG_AHBSW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_SIZE                    2
/*   ** Connect to ISP. ** */
`define   GCREG_AHBSW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_ISP                2'h0
/*   ** Write 1 to disconnnect ISP2NPU SBI signals and connect to             **
** software-controlled registers.   This step is needed before using the      **
** SBI_rd field for software control. **                                      */
`define   GCREG_AHBSW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_SOFT_CONTROL       2'h1
/*   ** Connect to pattern generator. ** */
`define   GCREG_AHBSW_CONTROL_VXSBI0_ISP2_NPU_DISCONNECT_PATTERN_GEN        2'h2

/* Start writing a frame or not. Value 1 indicates start of frame.  This      **
** field is set for one input of SbiWrFrameStart.  For dual SBI input, the    **
** other is in gcregAHBSWControlDualSBIInput bit 3.                           */
`define GCREG_AHBSW_CONTROL_VXSBI0_SBI_WR_FRAME_START_MSB                      2
`define GCREG_AHBSW_CONTROL_VXSBI0_SBI_WR_FRAME_START_LSB                      2
`define GCREG_AHBSW_CONTROL_VXSBI0_SBI_WR_FRAME_START_SIZE                     1

/* This field is set for one input of Npu2IspDisconnect.  For dual SBI input, **
** the other is in Npu2IspDisconnect in gcregAHBSWControlDualSBIInput bits    **
** 5:4.                                                                       */
`define GCREG_AHBSW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_MSB                     4
`define GCREG_AHBSW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_LSB                     3
`define GCREG_AHBSW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_SIZE                    2
/*   ** Connect to ISP. ** */
`define   GCREG_AHBSW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_ISP                2'h0
/*   ** Disconnect NPU2ISP SBI signals or not. Value 1 means connect          **
** software-controlled regsiters. This step is needed before using the SBI_rd **
** field for software control. **                                             */
`define   GCREG_AHBSW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_SOFT_CONTROL       2'h1
/*   **Connect to checksum generator. ** */
`define   GCREG_AHBSW_CONTROL_VXSBI0_NPU2_ISP_DISCONNECT_CHECK_SUM_GEN      2'h2

/* Start reading a frame or not. Value 1 indicates start of frame.  This      **
** field is set for one input of SbiRdFrameStart.  For dual SBI input, the    **
** other is in SbiRdFrameStart in gcregAHBSWControlDualSBIInput bit 6.        */
`define GCREG_AHBSW_CONTROL_VXSBI0_SBI_RD_FRAME_START_MSB                      5
`define GCREG_AHBSW_CONTROL_VXSBI0_SBI_RD_FRAME_START_LSB                      5
`define GCREG_AHBSW_CONTROL_VXSBI0_SBI_RD_FRAME_START_SIZE                     1

