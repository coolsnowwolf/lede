`define   GCREG_TTDMA_WORD25_PSI_IN_RD_COMMIT_OUT_ID_PSI_OUT1               3'h2
`define   GCREG_TTDMA_WORD25_PSI_IN_RD_COMMIT_OUT_ID_PSI_OUT2               3'h3
`define   GCREG_TTDMA_WORD25_PSI_IN_RD_COMMIT_OUT_ID_PSI_OUT3               3'h4
`define   GCREG_TTDMA_WORD25_PSI_IN_RD_COMMIT_OUT_ID_PSI_OUT4               3'h5
