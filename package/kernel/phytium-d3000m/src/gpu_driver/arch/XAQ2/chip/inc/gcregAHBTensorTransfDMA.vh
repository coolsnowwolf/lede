`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP2_MSB                                26
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP2_LSB                                26
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP2_SIZE                                1

/* Top Level AHB. Software sets 1 to reset all logic of VIP 3.  This field is **
