`define GCREG_AHBXIOMMU_INTR_STATUS_WriteMask                       32'h0000000F
`define GCREG_AHBXIOMMU_INTR_STATUS_ResetValue                      32'h00000000

/* SW Event pulse interrupt status.  Auto-cleared after reading when the read **
** value is 1.                                                                */
`define GCREG_AHBXIOMMU_INTR_STATUS_SW_EVENT_MSB                               0
`define GCREG_AHBXIOMMU_INTR_STATUS_SW_EVENT_LSB                               0
`define GCREG_AHBXIOMMU_INTR_STATUS_SW_EVENT_SIZE                              1

/* DMA7 completion interrupt status.  Auto-cleared after reading when the     **
** read value is 1.                                                           */
`define GCREG_AHBXIOMMU_INTR_STATUS_DMA7_COMPL_MSB                             1
`define GCREG_AHBXIOMMU_INTR_STATUS_DMA7_COMPL_LSB                             1
`define GCREG_AHBXIOMMU_INTR_STATUS_DMA7_COMPL_SIZE                            1

/* interrupt status.  Automatically cleared after reading when the read value **
** is 1.                                                                      */
`define GCREG_AHBXIOMMU_INTR_STATUS_DMA8_COMPL_MSB                             2
`define GCREG_AHBXIOMMU_INTR_STATUS_DMA8_COMPL_LSB                             2
`define GCREG_AHBXIOMMU_INTR_STATUS_DMA8_COMPL_SIZE                            1

/* DMA7 and DMA8 completion interrupt status.  Write 1 to clear.  */
`define GCREG_AHBXIOMMU_INTR_STATUS_ALL_DMA_COMPL_MSB                          3
`define GCREG_AHBXIOMMU_INTR_STATUS_ALL_DMA_COMPL_LSB                          3
`define GCREG_AHBXIOMMU_INTR_STATUS_ALL_DMA_COMPL_SIZE                         1

