`define GCREG_AHB_PATTERNS_WriteMask                                32'h0000003F
`define GCREG_AHB_PATTERNS_ResetValue                               32'h00000000

/* When enabled, Red comparison occurs at frame completion. */
`define GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_RED_MSB                            0
`define GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_RED_LSB                            0
`define GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_RED_SIZE                           1
