`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP3_MSB                                27
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP3_LSB                                27
`define GCREG_AHBXTTD_MISC_SOFT_RESET_VIP3_SIZE                                1

