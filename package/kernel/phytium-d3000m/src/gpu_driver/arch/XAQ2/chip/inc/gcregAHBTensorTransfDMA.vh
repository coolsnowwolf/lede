`define   GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP4_ENTERRING             2'h1
`define   GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP4_IN_SLEEP              2'h2
`define   GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP4_WAKING_UP             2'h3

/* Deep sleep status for VIP5.  For DPP V500. EnVIP0~3 is set in bits 7:0 of  **
** gcregAHBXDeepSleep0.                                                       */
`define GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP5_MSB                        7
`define GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP5_LSB                        6
`define GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP5_SIZE                       2
`define   GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP5_NONE_SLEEP            2'h0
`define   GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP5_ENTERRING             2'h1
`define   GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP5_IN_SLEEP              2'h2
