`define GCREG_TTDMA_WORD21_GCREG_MEM_TENSOR_CIRC_BUF_ADDR_BIT33_TO32_MSB      18
`define GCREG_TTDMA_WORD21_GCREG_MEM_TENSOR_CIRC_BUF_ADDR_BIT33_TO32_LSB      17
`define GCREG_TTDMA_WORD21_GCREG_MEM_TENSOR_CIRC_BUF_ADDR_BIT33_TO32_SIZE      2

