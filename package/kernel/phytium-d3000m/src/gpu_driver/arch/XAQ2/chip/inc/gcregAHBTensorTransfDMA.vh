`define GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_BLUE_LSB                           2
`define GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_BLUE_SIZE                          1
`define   GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_BLUE_DISABLE                  1'h0
`define   GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_BLUE_ENABLE                   1'h1

/* Mismatch in Red checksum comparison. Write 1 to clear.  */
