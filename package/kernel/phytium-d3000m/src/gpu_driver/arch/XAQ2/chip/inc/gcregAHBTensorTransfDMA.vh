`define GCREG_TTDMA_WORD21_MEM_TENSOR_BASE_ADDR_BIT28_TO16_LSB                19
`define GCREG_TTDMA_WORD21_MEM_TENSOR_BASE_ADDR_BIT28_TO16_SIZE               13

