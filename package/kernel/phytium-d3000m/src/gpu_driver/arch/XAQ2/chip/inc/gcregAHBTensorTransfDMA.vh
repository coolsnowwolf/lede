`define GCREG_TTDMA_WORD25_PSI_IN_EXTRACTOR_RIGHT_PAD_MSB                     12
`define GCREG_TTDMA_WORD25_PSI_IN_EXTRACTOR_RIGHT_PAD_LSB                      7
`define GCREG_TTDMA_WORD25_PSI_IN_EXTRACTOR_RIGHT_PAD_SIZE                     6

