`define GCREG_AHBXDMA_RAW_STATUS_SBIOUT_CUREQ_TO_CUREQ_TIMEOUT_LSB             4
`define GCREG_AHBXDMA_RAW_STATUS_SBIOUT_CUREQ_TO_CUREQ_TIMEOUT_SIZE            1

/* SBI input Producer Request to Producer Acknowledgemet timeout raw status.  **
