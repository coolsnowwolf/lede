`define   GCREG_AHBX_DEEP_SLEEP0_APPENDIX_EN_VIP5_VBLANK                    2'h2

/* Deep sleep status for VIP4.  For DPP V500. StatusVIP0~3 is set in bits     **
** 16:9 of gcregAHBXDeepSleep0.                                               */
`define GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP4_MSB                        5
`define GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP4_LSB                        4
`define GCREG_AHBX_DEEP_SLEEP0_APPENDIX_STATUS_VIP4_SIZE                       2
