`define GCREG_TTDMA_WORD21_FREE_RUN_CONTROL_MSB                               16
`define GCREG_TTDMA_WORD21_FREE_RUN_CONTROL_LSB                               16
`define GCREG_TTDMA_WORD21_FREE_RUN_CONTROL_SIZE                               1

/* MemTensorCircBufAddr:circular buffer address in byte, bits[33:32], bit     **
