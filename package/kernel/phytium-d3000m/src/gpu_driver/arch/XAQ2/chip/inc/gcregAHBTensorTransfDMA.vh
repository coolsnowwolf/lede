`define GCREG_TTDMA_WORD21_MEMORY_ACCESS_MSB                                  10
`define GCREG_TTDMA_WORD21_MEMORY_ACCESS_LSB                                   9
`define GCREG_TTDMA_WORD21_MEMORY_ACCESS_SIZE                                  2
`define   GCREG_TTDMA_WORD21_MEMORY_ACCESS_ENABLE                           2'h0
/* Memory Access is disabled */
`define   GCREG_TTDMA_WORD21_MEMORY_ACCESS_DISABLE_AND_SYNC                 2'h1
`define   GCREG_TTDMA_WORD21_MEMORY_ACCESS_DISABLE_AND_ZERO                 2'h2

