`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA10_MSB                     5
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA10_LSB                     5
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA10_SIZE                    1

/* Read 0 indicates DMA11 prepared shadow register is cleared by hardware,    **
