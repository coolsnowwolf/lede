** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB X-DMA Raw Status Register.  For eXternal-DMA. For sub-system, use VIP0 **
** register space.                                                            */

`define gcregAHBXDMARawStatusRegAddrs                                   16'h0B51
`define GCREG_AHBXDMA_RAW_STATUS_MSB                                          15
`define GCREG_AHBXDMA_RAW_STATUS_LSB                                           0
`define GCREG_AHBXDMA_RAW_STATUS_BLK                                           0
`define GCREG_AHBXDMA_RAW_STATUS_Count                                         1
`define GCREG_AHBXDMA_RAW_STATUS_FieldMask                          32'h3FFFFFFF
`define GCREG_AHBXDMA_RAW_STATUS_ReadMask                           32'h3FFFFFFF
`define GCREG_AHBXDMA_RAW_STATUS_WriteMask                          32'h3FFFFFFF
`define GCREG_AHBXDMA_RAW_STATUS_ResetValue                         32'h00000000

/* Compressor Frame Completion Raw Status.  This AHB only register is not     **
** shadowed.  Status is set by HW when the frame is completed. Write 1 to     **
** clear.                                                                     */
`define GCREG_AHBXDMA_RAW_STATUS_COMP_FRAME_COMPL_MSB                          0
`define GCREG_AHBXDMA_RAW_STATUS_COMP_FRAME_COMPL_LSB                          0
`define GCREG_AHBXDMA_RAW_STATUS_COMP_FRAME_COMPL_SIZE                         1

/* DeCompressor Frame Completion raw status.  This AHB only register is not   **
** shadowed.  Status is set by HW when the frame is completed. Write 1 to     **
** clear.                                                                     */
`define GCREG_AHBXDMA_RAW_STATUS_DE_COMP_FRAME_COMPL_MSB                       1
`define GCREG_AHBXDMA_RAW_STATUS_DE_COMP_FRAME_COMPL_LSB                       1
`define GCREG_AHBXDMA_RAW_STATUS_DE_COMP_FRAME_COMPL_SIZE                      1

/* Sync Error Interrupt raw status.  Set by XIO_sync_error = 1 and            **
** gcregAHBXIODMAIntrEn SyncErrorInterEn = 1.  Write 1 to clear.              */
`define GCREG_AHBXDMA_RAW_STATUS_XIO_SYNC_ERROR_INTR_MSB                       2
`define GCREG_AHBXDMA_RAW_STATUS_XIO_SYNC_ERROR_INTR_LSB                       2
`define GCREG_AHBXDMA_RAW_STATUS_XIO_SYNC_ERROR_INTR_SIZE                      1

/* SBI input Producer Update Request to ProductUpdate Request Timeout raw     **
** status.  1 indicates a timeout has happened. Write 1 to clear.  This field **
** is set for one input of SBI time out.  For dual SBI input, the other SBI   **
** timeout in is bit 28 in this register.                                     */
`define GCREG_AHBXDMA_RAW_STATUS_SBIIN_PUREQ_TO_PUREQ_TIMEOUT_MSB              3
`define GCREG_AHBXDMA_RAW_STATUS_SBIIN_PUREQ_TO_PUREQ_TIMEOUT_LSB              3
`define GCREG_AHBXDMA_RAW_STATUS_SBIIN_PUREQ_TO_PUREQ_TIMEOUT_SIZE             1

/* SBI output Customer Update Request to Customer Update Request timeout raw  **
