`define   GCREG_TTDMA_WORD25_PSI_IN_RD_COMMIT_OUT_ID_PSI_OUT6               3'h7

/* 0: uses BorderConstant 1: uses nearest edge */
`define GCREG_TTDMA_WORD25_PSI_IN_EXTRACTOR_BORDER_STYLE_MSB                  19
`define GCREG_TTDMA_WORD25_PSI_IN_EXTRACTOR_BORDER_STYLE_LSB                  19
`define GCREG_TTDMA_WORD25_PSI_IN_EXTRACTOR_BORDER_STYLE_SIZE                  1
`define   GCREG_TTDMA_WORD25_PSI_IN_EXTRACTOR_BORDER_STYLE_BORDER_CONST     1'h0
`define   GCREG_TTDMA_WORD25_PSI_IN_EXTRACTOR_BORDER_STYLE_NEAREST_EDGE     1'h1

/* Must be larger than 0. The number of SubtensorRd/SubtensorRdCommit signal  **
** to form one MemTensor (Frame).  This is needed for hardware to identify    **
** the last SubtensorRd of a frame. bits[11:0] in word 25, bits[15:12] in     **
** word 27.                                                                   */
`define GCREG_TTDMA_WORD25_RD_SUBTENSOR_COUNT_BIT11_TO0_MSB                   31
`define GCREG_TTDMA_WORD25_RD_SUBTENSOR_COUNT_BIT11_TO0_LSB                   20
`define GCREG_TTDMA_WORD25_RD_SUBTENSOR_COUNT_BIT11_TO0_SIZE                  12

/* Offset gcregTTDMAWord26
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* Number of valid cycle in each filling period. */
`define GCREG_TTDMA_WORD26_PSI_OUT_FILLER_LENGTH_MSB                          15
`define GCREG_TTDMA_WORD26_PSI_OUT_FILLER_LENGTH_LSB                           0
`define GCREG_TTDMA_WORD26_PSI_OUT_FILLER_LENGTH_SIZE                         16

/* Starting valid cycle within each filling period, (count starts at 0). */
`define GCREG_TTDMA_WORD26_PSI_OUT_FILLER_START_MSB                           31
`define GCREG_TTDMA_WORD26_PSI_OUT_FILLER_START_LSB                           16
`define GCREG_TTDMA_WORD26_PSI_OUT_FILLER_START_SIZE                          16

/* Offset gcregTTDMAWord27
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* Ending valid cycle within each filling period, (count starts at 0). */
`define GCREG_TTDMA_WORD27_PSI_OUT_FILLER_END_MSB                             15
`define GCREG_TTDMA_WORD27_PSI_OUT_FILLER_END_LSB                              0
`define GCREG_TTDMA_WORD27_PSI_OUT_FILLER_END_SIZE                            16

/* FLEXA-PSI output DATA type.  */
`define GCREG_TTDMA_WORD27_PSI_OUT_DATA_TYPE_MSB                              16
`define GCREG_TTDMA_WORD27_PSI_OUT_DATA_TYPE_LSB                              16
`define GCREG_TTDMA_WORD27_PSI_OUT_DATA_TYPE_SIZE                              1
`define   GCREG_TTDMA_WORD27_PSI_OUT_DATA_TYPE_EIGHT_BITS                   1'h0
`define   GCREG_TTDMA_WORD27_PSI_OUT_DATA_TYPE_SIXTEEN_BITS                 1'h1

/* Number of transpose channels, 0 means disable transpose. Bit3 is in Word28 **
** bits[1].                                                                   */
`define GCREG_TTDMA_WORD27_PSI_OUT_TRANSPOSE_CH_MINUS_ONE_MSB                 19
`define GCREG_TTDMA_WORD27_PSI_OUT_TRANSPOSE_CH_MINUS_ONE_LSB                 17
`define GCREG_TTDMA_WORD27_PSI_OUT_TRANSPOSE_CH_MINUS_ONE_SIZE                 3

/* 1 to ignore the PIS input, PIS output = PSI Fill. */
`define GCREG_TTDMA_WORD27_PSI_OUT_FILLER_IGN_INPUT_MSB                       20
`define GCREG_TTDMA_WORD27_PSI_OUT_FILLER_IGN_INPUT_LSB                       20
`define GCREG_TTDMA_WORD27_PSI_OUT_FILLER_IGN_INPUT_SIZE                       1

/* Starting Memory Address, bits[31:29],  bits[15:0] in word 22, bits[28:16]  **
** in word 21.                                                                */
`define GCREG_TTDMA_WORD27_MEM_TENSOR_BASE_ADDR_BIT31_TO29_MSB                23
`define GCREG_TTDMA_WORD27_MEM_TENSOR_BASE_ADDR_BIT31_TO29_LSB                21
`define GCREG_TTDMA_WORD27_MEM_TENSOR_BASE_ADDR_BIT31_TO29_SIZE                3

/* Must be larger than 0. The number of SubtensorRd/SubtensorRdCommit signal  **
** to form one MemTensor (Frame).  This is needed for hardware to identify    **
** the last SubtensorRd of a frame. bits[11:0] in word 25, bits[15:12] in     **
** word 27.                                                                   */
`define GCREG_TTDMA_WORD27_RD_SUBTENSOR_COUNT_BIT15_TO12_MSB                  27
`define GCREG_TTDMA_WORD27_RD_SUBTENSOR_COUNT_BIT15_TO12_LSB                  24
`define GCREG_TTDMA_WORD27_RD_SUBTENSOR_COUNT_BIT15_TO12_SIZE                  4

/* Amount of padding cycle on the left. Bit7 to bit8 of                       **
** PSIInExtractorLeftPad.  Bit0 to bit5 is in word25, PSIInExtractorLeftPad.  */
`define GCREG_TTDMA_WORD27_PSI_IN_EXTRACTOR_LEFT_PAD_BIT6TO7_MSB              29
`define GCREG_TTDMA_WORD27_PSI_IN_EXTRACTOR_LEFT_PAD_BIT6TO7_LSB              28
`define GCREG_TTDMA_WORD27_PSI_IN_EXTRACTOR_LEFT_PAD_BIT6TO7_SIZE              2

/* Amount of padding cycle on the left. Bit7 to bit8 of                       **
** PSIInExtractorLeftPad.  Bit0 to bit5 is in word25, PSIInExtractorRightPad. */
`define GCREG_TTDMA_WORD27_PSI_IN_EXTRACTOR_RIGHT_PAD_BIT6TO7_MSB             31
`define GCREG_TTDMA_WORD27_PSI_IN_EXTRACTOR_RIGHT_PAD_BIT6TO7_LSB             30
`define GCREG_TTDMA_WORD27_PSI_IN_EXTRACTOR_RIGHT_PAD_BIT6TO7_SIZE             2

/* Offset gcregTTDMAWord28
** ~~~~~~~~~~~~~~~~~~~~~~~ */

/* Number of transpose channels, 0 means disable transpose. Bit2:0 is in      **
** Word25 bits[15:13].                                                        */
`define GCREG_TTDMA_WORD28_PSI_IN_TRANSPOSE_CH_MINUS_ONE_BIT3_MSB              0
`define GCREG_TTDMA_WORD28_PSI_IN_TRANSPOSE_CH_MINUS_ONE_BIT3_LSB              0
`define GCREG_TTDMA_WORD28_PSI_IN_TRANSPOSE_CH_MINUS_ONE_BIT3_SIZE             1

/* Number of transpose channels, 0 means disable transpose. Bit2:0 is in      **
** Word27 bits[19:17].                                                        */
`define GCREG_TTDMA_WORD28_PSI_OUT_TRANSPOSE_CH_MINUS_ONE_BIT3_MSB             1
`define GCREG_TTDMA_WORD28_PSI_OUT_TRANSPOSE_CH_MINUS_ONE_BIT3_LSB             1
`define GCREG_TTDMA_WORD28_PSI_OUT_TRANSPOSE_CH_MINUS_ONE_BIT3_SIZE            1

/* Determin T3DSYNC was generated by DMA or ISP. */
`define GCREG_TTDMA_WORD28_T3D_SYNC_PRODUCER_MSB                               2
`define GCREG_TTDMA_WORD28_T3D_SYNC_PRODUCER_LSB                               2
`define GCREG_TTDMA_WORD28_T3D_SYNC_PRODUCER_SIZE                              1
`define   GCREG_TTDMA_WORD28_T3D_SYNC_PRODUCER_DMA                          1'h0
`define   GCREG_TTDMA_WORD28_T3D_SYNC_PRODUCER_ISP                          1'h1

/* Determine how many blanking cycles need wait. */
`define GCREG_TTDMA_WORD28_HBLANKING_CYCLE_MSB                                12
`define GCREG_TTDMA_WORD28_HBLANKING_CYCLE_LSB                                 3
`define GCREG_TTDMA_WORD28_HBLANKING_CYCLE_SIZE                               10

/* PPC = InDmaPpcMinusOne + 1. */
`define GCREG_TTDMA_WORD28_DMA_PPC_MINUS_ONE_MSB                              15
`define GCREG_TTDMA_WORD28_DMA_PPC_MINUS_ONE_LSB                              13
`define GCREG_TTDMA_WORD28_DMA_PPC_MINUS_ONE_SIZE                              3

