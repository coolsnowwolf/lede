`define GCREG_AHB_CU_REQ_CNT_COUNT_LSB                                         0
`define GCREG_AHB_CU_REQ_CNT_COUNT_SIZE                                       32

/* Register gcregAHBOverlapCheck **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB Command Overlap Check Register.  Check whether cmd is repeated. */

`define gcregAHBOverlapCheckRegAddrs                                    16'h0D06
`define GCREG_AHB_OVERLAP_CHECK_MSB                                           15
`define GCREG_AHB_OVERLAP_CHECK_LSB                                            0
`define GCREG_AHB_OVERLAP_CHECK_BLK                                            0
`define GCREG_AHB_OVERLAP_CHECK_Count                                          1
