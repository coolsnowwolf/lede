`define   GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_RED_ENABLE                    1'h1

/* When enabled, Green comparison occurs at frame completion. */
`define GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_GREEN_MSB                          1
`define GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_GREEN_LSB                          1
`define GCREG_AHB_PATTERNS_COMPARE_CHECKSUM_GREEN_SIZE                         1
