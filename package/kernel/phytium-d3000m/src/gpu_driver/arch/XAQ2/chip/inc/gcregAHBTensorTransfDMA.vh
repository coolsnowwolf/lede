/* Register gcregAHBXTTDMisc2 **
** ~~~~~~~~~~~~~~~~~~~~~~~~~~ */

/* AHB Tensor Transfer DMA Miscellaneous Configuration Register 2.  For       **
** system level configuration, eXternal to VIP.  Now for X-DMA shadow         **
** register preparation.                                                      */

`define gcregAHBXTTDMisc2RegAddrs                                       16'h0B68
`define GCREG_AHBXTTD_MISC2_MSB                                               15
`define GCREG_AHBXTTD_MISC2_LSB                                                0
`define GCREG_AHBXTTD_MISC2_BLK                                                0
`define GCREG_AHBXTTD_MISC2_Count                                              1
`define GCREG_AHBXTTD_MISC2_FieldMask                               32'h0000007F
`define GCREG_AHBXTTD_MISC2_ReadMask                                32'h00000000
`define GCREG_AHBXTTD_MISC2_WriteMask                               32'h0000007F
`define GCREG_AHBXTTD_MISC2_ResetValue                              32'h00000000

/* Read 0 indicates DMA5 prepared shadow register is cleared by hardware,     **
** and should be taken as the new walking pattern at the next frame start.    */
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA5_MSB                      0
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA5_LSB                      0
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA5_SIZE                     1

/* Read 0 indicates DMA6's prepared shadow register is cleared by hardware,   **
** and should be taken as the new walking pattern at the next frame start.    */
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA6_MSB                      1
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA6_LSB                      1
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA6_SIZE                     1

/* Read 0 indicates DMA7's prepared shadow register is cleared by hardware,   **
** and should be taken as the new walking pattern at the next frame start.    */
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA7_MSB                      2
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA7_LSB                      2
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA7_SIZE                     1

/* Read 0 indicates DMA8's prepared shadow register is cleared by hardware,   **
** and should be taken as the new walking pattern at the next frame start.    */
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA8_MSB                      3
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA8_LSB                      3
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA8_SIZE                     1

/* Read 0 indicates DMA9 prepared shadow register is cleared by hardware,     **
** and should be taken as the new walking pattern at the next frame start.    */
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA9_MSB                      4
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA9_LSB                      4
`define GCREG_AHBXTTD_MISC2_XSHADOW_REG_PREPARED_DMA9_SIZE                     1

/* Read 0 indicates DMA10 prepared shadow register is cleared by hardware,    **
