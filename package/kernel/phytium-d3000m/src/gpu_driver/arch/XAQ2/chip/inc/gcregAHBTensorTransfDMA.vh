** the first SBI input timeout register.  For dual SBI input, the other is in **
** gcregAHBSbiInPureqToPureqTimeoutDualSBIInput in this module.               */

`define gcregAHBSbiInPureqToPureqTimeoutRegAddrs                        16'h0B14
`define GCREG_AHB_SBI_IN_PUREQ_TO_PUREQ_TIMEOUT_MSB                           15
