`define GCREG_AHB_PATTERNS_MISMATCH_CHECKSUM_GREEN_LSB                         4
`define GCREG_AHB_PATTERNS_MISMATCH_CHECKSUM_GREEN_SIZE                        1

/* Indicate mismatch in checksum comparison, Write 1 to clear.  */
