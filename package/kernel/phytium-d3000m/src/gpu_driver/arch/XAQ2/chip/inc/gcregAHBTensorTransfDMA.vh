`define GCREG_TTDMA_WORD21_FRAME_START_SELECT_LSB                             13
`define GCREG_TTDMA_WORD21_FRAME_START_SELECT_SIZE                             1
`define   GCREG_TTDMA_WORD21_FRAME_START_SELECT_HARDWARE                    1'h0
`define   GCREG_TTDMA_WORD21_FRAME_START_SELECT_SOFT_WARE                   1'h1

/* How to handle frame start which happens before current frame is finished.  **
** 0 postpone the frame start until current frame finished. H1 ignore frame   **
** start until current frame finished.                                        */
`define GCREG_TTDMA_WORD21_IMPROPER_FRAME_START_MSB                           14
`define GCREG_TTDMA_WORD21_IMPROPER_FRAME_START_LSB                           14
`define GCREG_TTDMA_WORD21_IMPROPER_FRAME_START_SIZE                           1

