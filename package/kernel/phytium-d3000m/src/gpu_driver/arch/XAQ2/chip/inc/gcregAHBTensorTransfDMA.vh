** dual SBI input, the other SBI timeout in is bit 27 of this register.       */
`define GCREG_AHBXDMA_RAW_STATUS_SBIIN_PRREQ_TO_PRACK_TIMEOUT_MSB              5
`define GCREG_AHBXDMA_RAW_STATUS_SBIIN_PRREQ_TO_PRACK_TIMEOUT_LSB              5
`define GCREG_AHBXDMA_RAW_STATUS_SBIIN_PRREQ_TO_PRACK_TIMEOUT_SIZE             1

