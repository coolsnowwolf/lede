`define   GCREG_DEC400_READ_EX_CONFIG_TILE_Y_ENABLE                         1'h1

/* mode 1-9 only valid for DEC_IPU mode 10-13 only valid for DEC_VPU mode     **
** 14-19 only valid for DEC_XYZ Stream mode enumerates the possible streams   **
** sent by clients. In addition to the basic format configured for            **
** compression, streams have additional characteristics, such as reading or   **
** writing walking pattern, which distinguish one type from another. TGL -    **
** Available for T2D                                                          */
`define GCREG_DEC400_READ_EX_CONFIG_STREAM_MODE_MSB                           24
`define GCREG_DEC400_READ_EX_CONFIG_STREAM_MODE_LSB                           20
`define GCREG_DEC400_READ_EX_CONFIG_STREAM_MODE_SIZE                           5
`define   GCREG_DEC400_READ_EX_CONFIG_STREAM_MODE_DEFAULT                  5'h00
`define   GCREG_DEC400_READ_EX_CONFIG_STREAM_MODE_ISA_STREAM0              5'h01
`define   GCREG_DEC400_READ_EX_CONFIG_STREAM_MODE_ISA_STREAM1              5'h02
