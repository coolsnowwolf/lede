`define   GCREG_DEC400_READ_EX_CONFIG_STREAM_MODE_GDC_STREAM_V             5'h09
`define   GCREG_DEC400_READ_EX_CONFIG_STREAM_MODE_VPU_SRC_Y                5'h0A
