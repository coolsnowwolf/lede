/* Define two read miss policies for the TSC.  POLICY0: Normal Fill;          **
** POLICY1: Speculative Concurrent Fill.                                      */
`define GCREG_DEC400_CONTROL_EX_READ_MISS_POLICY_MSB                          29
`define GCREG_DEC400_CONTROL_EX_READ_MISS_POLICY_LSB                          29
`define GCREG_DEC400_CONTROL_EX_READ_MISS_POLICY_SIZE                          1
/* * Normal Fill. If TSC miss, read TSC data, then send data request * */
`define   GCREG_DEC400_CONTROL_EX_READ_MISS_POLICY_POLICY0                  1'h0
/* * Speculative Concurrent Fill. If TSC miss, send all tile data requests    **
** and send TSC data request. Not currently supported. *                      */
`define   GCREG_DEC400_CONTROL_EX_READ_MISS_POLICY_POLICY1                  1'h1

/* The memory layout is TileYf TGL - If this bit is 1, TileY must also be 1.  */
`define GCREG_DEC400_CONTROL_EX_TILE_YF_MSB                                   30
`define GCREG_DEC400_CONTROL_EX_TILE_YF_LSB                                   30
`define GCREG_DEC400_CONTROL_EX_TILE_YF_SIZE                                   1
