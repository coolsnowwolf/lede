`define GCREG_DEC400_READ_EX_CONFIG_CBSR_WIDTH_LSB                             3
`define GCREG_DEC400_READ_EX_CONFIG_CBSR_WIDTH_SIZE                           13

/* Bit depth for Y/UV/Bayer format.  The values 3/4 are not valid for all     **
** variants.                                                                  */
