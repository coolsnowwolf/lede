-	enum nl80211_band band;
-	int freq;
-
-	if (!dev || !tlv)
-		return;
-
-	len = le16_to_cpu(tlv->len);
-	if (len < sizeof(*tlv) + sizeof(*evt)) {
-		dev_warn(dev->mt76.dev,
-			 "nan: short dw event tlv len=%u\n", len);
