-		"nan: ulw_update wdev=%p owner_nlportid=%u sched_id=%u seq=%u dur=%u\n",
-		wdev, wdev->owner_nlportid,
-		evt->sched_id, evt->seq_id, le32_to_cpu(evt->duration));
