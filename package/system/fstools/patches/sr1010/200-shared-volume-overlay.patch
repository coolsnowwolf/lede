 /**
+ * fs_shared_volume - the volume that other firmware shares, or NULL
+ *
+ * Enabled per device by shipping /etc/fstools-shared-overlay, whose content
+ * is the name of that volume (empty: rootfs_data). The overlay then lives in
+ * a sub-directory of it and the volume root is never touched.
+ */
+const char *fs_shared_volume(void)
+{
+	static char name[32];
+	static bool done;
+	FILE *fp;
+
+	if (!done) {
+		done = true;
+		fp = fopen("/etc/fstools-shared-overlay", "r");
+		if (fp) {
+			if (!fgets(name, sizeof(name), fp))
+				name[0] = '\0';
+			name[strcspn(name, "\r\n")] = '\0';
+			if (!name[0])
+				snprintf(name, sizeof(name), "rootfs_data");
+			fclose(fp);
+		}
+	}
+
+	return name[0] ? name : NULL;
+}
+
+bool fs_shared_overlay(void)
+{
+	return fs_shared_volume() != NULL;
+}
+
+/**
+ * fs_overlay_dir - directory under @mp holding the overlay state and trees
+ */
+const char *fs_overlay_dir(const char *mp, char *buf, size_t len)
+{
+	if (!fs_shared_overlay()) {
+		snprintf(buf, len, "%s", mp);
+		return buf;
+	}
+
+	snprintf(buf, len, "%s/.lede", mp);
+	mkdir(buf, 0755);
+	return buf;
+}
