+/*
+ * Identify the running root filesystem by the head of its squashfs
+ * superblock, which holds the build time. Fails when there is no such volume.
+ */
+static int read_rom_id(unsigned char *id)
+{
+	char line[128], blk[32];
+	ssize_t n;
+	FILE *fp;
+	int idx, fd;
+
+	fp = fopen("/proc/mtd", "r");
+	if (!fp)
+		return -1;
+
+	blk[0] = '\0';
+	while (fgets(line, sizeof(line), fp)) {
+		if (sscanf(line, "mtd%d:", &idx) == 1 && strstr(line, "\"rootfs\"")) {
+			snprintf(blk, sizeof(blk), "/dev/mtdblock%d", idx);
+			break;
+		}
+	}
+	fclose(fp);
+	if (!blk[0])
+		return -1;
+
+	fd = open(blk, O_RDONLY);
+	if (fd < 0)
+		return -1;
+
+	n = read(fd, id, ROM_ID_LEN);
+	close(fd);
+
+	return n == ROM_ID_LEN ? 0 : -1;
+}
+
+static int load_rom_id(const char *dir, unsigned char *id)
+{
+	char path[96];
+	ssize_t n = -1;
+	int fd;
+
+	snprintf(path, sizeof(path), "%s/.rom_id", dir);
+	fd = open(path, O_RDONLY);
+	if (fd >= 0) {
+		n = read(fd, id, ROM_ID_LEN);
+		close(fd);
+	}
+
+	return n == ROM_ID_LEN ? 0 : -1;
+}
+
+/*
+ * The overlay may have been written for a different root filesystem, for
+ * example after the firmware was replaced by another system sharing the volume.
+ * Its files would shadow the new root filesystem, so keep only the settings.
+ * Returns false when that failed and the id must not be recorded.
+ */
+static bool shared_rom_check(const char *dir, const unsigned char *cur)
+{
+	unsigned char old[ROM_ID_LEN];
+	char path[96], cmd[160];
+	struct stat st;
+
+	if (load_rom_id(dir, old) || !memcmp(old, cur, ROM_ID_LEN))
+		return true;
+
+	/* A settings backup from sysupgrade is already waiting to be restored. */
+	snprintf(path, sizeof(path), "%s/sysupgrade.tgz", dir);
+	if (!stat(path, &st))
+		return true;
+
+	ULOG_INFO("root filesystem changed, keeping only the settings\n");
+	snprintf(cmd, sizeof(cmd), "/usr/libexec/zte-overlay-rescue %s", dir);
+	if (system(cmd)) {
+		ULOG_ERR("could not reset the overlay, stale files may remain\n");
+		return false;
+	}
+
+	return true;
+}
+
+static void shared_rom_record(const char *dir, const unsigned char *cur)
+{
+	unsigned char old[ROM_ID_LEN];
+	char path[96];
+	int fd;
+
+	if (!load_rom_id(dir, old) && !memcmp(old, cur, ROM_ID_LEN))
+		return;
+
+	snprintf(path, sizeof(path), "%s/.rom_id", dir);
+	fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	if (fd < 0) {
+		ULOG_ERR("cannot record the root filesystem id: %m\n");
+		return;
+	}
+
+	if (write(fd, cur, ROM_ID_LEN) != ROM_ID_LEN)
+		ULOG_ERR("cannot record the root filesystem id: %m\n");
+	close(fd);
+}
