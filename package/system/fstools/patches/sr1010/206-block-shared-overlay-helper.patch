Subject: fstools: keep shared-overlay lookup local to block

Avoid an unresolved reference without linking libfstools, whose mount API
conflicts with block. Preserve the shared-overlay opt-in and read-only lookup.

--- a/block.c
+++ b/block.c
@@ -44,6 +44,21 @@
 #include <libubox/vlist.h>
 #include <libubus.h>
 
+/* Keep this lookup local: block and libfstools have incompatible symbols,
+ * so linking all of libfstools into block is not safe. No volume is changed. */
+static const char *block_overlay_path(const char *mp, char *buf, size_t len)
+{
+	FILE *fp = fopen("/etc/fstools-shared-overlay", "r");
+
+	if (fp) {
+		fclose(fp);
+		snprintf(buf, len, mp[0] ? "%s/.lede" : "%s", mp);
+	} else {
+		snprintf(buf, len, "%s", mp);
+	}
+	return buf;
+}
+
 #include "probe.h"
 
 #define AUTOFS_MOUNT_PATH       "/tmp/run/blockd/"
@@ -442,16 +453,19 @@
 	struct uci_context *ctx = uci_alloc_context();
 	struct uci_package *pkg = NULL;
 	struct uci_element *e;
-	char path[64];
+	char path[96], base[48];
 
 	vlist_init(&mounts, avl_strcmp, mounts_update);
 
 	if (cfg) {
-		snprintf(path, sizeof(path), "%s/upper/etc/config/fstab", cfg);
+		/* the overlay of a shared volume lives in a sub-directory of it */
+		block_overlay_path(cfg, base, sizeof(base));
+
+		snprintf(path, sizeof(path), "%s/upper/etc/config/fstab", base);
 		pkg = config_try_load(ctx, path);
 
 		if (!pkg) {
-			snprintf(path, sizeof(path), "%s/etc/config/fstab", cfg);
+			snprintf(path, sizeof(path), "%s/etc/config/fstab", base);
 			pkg = config_try_load(ctx, path);
 		}
 	}
