From: Claude <noreply@anthropic.com>
Subject: libfstools: keep the stock overlay mount label on a shared volume

The mount source of the overlay is only a name, but LuCI looks for
"overlayfs:/overlay / " in /proc/mounts to decide whether the system has a
resettable overlay (reset button, keep-settings option on the flash page).
The shared volume support moved rw_root to /overlay/.lede before the label was
built, which turned it into "overlayfs:/overlay/.lede". Build the label from
the path the caller passed instead; the upper and work dirs are unchanged.

--- a/libfstools/mount.c
+++ b/libfstools/mount.c
@@ -177,6 +177,7 @@
 	 * lowerdir=/,upperdir=/overlay/.lede/upper,workdir=/overlay/.lede/work */
 	char overlay[64], mount_options[128], upperdir[64], workdir[64], upgrade[64], upgrade_dest[64];
 	char rwsub[64];
+	const char *label_root = rw_root;
 	struct stat st;
 
 	if (find_filesystem("overlay")) {
@@ -187,7 +188,10 @@
 	if (!strcmp(rw_root, "/overlay"))
 		rw_root = (char *)fs_overlay_dir(rw_root, rwsub, sizeof(rwsub));
 
-	snprintf(overlay, sizeof(overlay), "overlayfs:%s", rw_root);
+	/* The mount source is only a label. Keep the stock one when the upper dir
+	 * moves into a subdirectory of a shared volume: LuCI offers its reset button
+	 * and the keep-settings option only if /proc/mounts has "overlayfs:/overlay / ". */
+	snprintf(overlay, sizeof(overlay), "overlayfs:%s", label_root);
 	snprintf(upperdir, sizeof(upperdir), "%s/upper", rw_root);
 	snprintf(workdir, sizeof(workdir), "%s/work", rw_root);
 	snprintf(upgrade, sizeof(upgrade), "%s/sysupgrade.tgz", rw_root);
