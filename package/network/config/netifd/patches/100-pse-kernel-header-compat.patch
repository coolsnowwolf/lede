diff --git a/CMakeLists.txt b/CMakeLists.txt
index d624961..b1f2507 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -62,11 +62,18 @@ IF("${CMAKE_SYSTEM_NAME}" MATCHES "Linux" AND NOT DUMMY_MODE)
 	SET(LIBS ${LIBS} ${LIBNL_LIBS})
 	include(CheckCSourceCompiles)
 	check_c_source_compiles("
+#include <linux/ethtool_netlink.h>
+	int main(void) { return ETHTOOL_A_C33_PSE_ADMIN_STATE; }
+	" HAVE_ETHTOOL_PSE)
+	IF(HAVE_ETHTOOL_PSE)
+		ADD_DEFINITIONS(-DHAVE_ETHTOOL_PSE)
+		check_c_source_compiles("
 #include <linux/ethtool_netlink.h>
 int main(void) { return ETHTOOL_A_PSE_PRIO; }
 " HAVE_ETHTOOL_A_PSE_PRIO)
-	IF(HAVE_ETHTOOL_A_PSE_PRIO)
-		ADD_DEFINITIONS(-DHAVE_ETHTOOL_A_PSE_PRIO)
+		IF(HAVE_ETHTOOL_A_PSE_PRIO)
+			ADD_DEFINITIONS(-DHAVE_ETHTOOL_A_PSE_PRIO)
+		ENDIF()
 	ENDIF()
 ELSE()
 	ADD_DEFINITIONS(-DDUMMY_MODE=1)
diff --git a/system-linux.c b/system-linux.c
index a7419a9..c0f2cae 100644
--- a/system-linux.c
+++ b/system-linux.c
@@ -2233,6 +2233,7 @@ system_set_ethtool_eee_settings(struct device *dev, struct device_settings *s)
  * PSE (Power Sourcing Equipment) genetlink functions
  * Uses ethtool netlink interface to get/set PoE port configuration
  */
+#ifdef HAVE_ETHTOOL_PSE
 struct pse_reply_data {
 	bool valid;
 	/* IEEE 802.3 Clause 33 (standard PoE) */
@@ -2502,6 +2503,7 @@ static int system_pse_set(struct device *dev, struct device_settings *s)
 
 	return 0;
 }
+#endif
 
 static void
 system_set_ethtool_settings(struct device *dev, struct device_settings *s)
@@ -2523,8 +2525,10 @@ system_set_ethtool_settings(struct device *dev, struct device_settings *s)
 		system_set_ethtool_eee_settings(dev, s);
 
 	/* Apply PSE (PoE) settings if configured */
+#ifdef HAVE_ETHTOOL_PSE
 	if (s->flags & (DEV_OPT_PSE | DEV_OPT_PSE_PODL | DEV_OPT_PSE_POWER_LIMIT | DEV_OPT_PSE_PRIORITY))
 		system_pse_set(dev, s);
+#endif
 
 	/* Avoid a rmw ioctl call if nothing needs to be changed. */
 	if (!(s->flags & (DEV_OPT_AUTONEG | DEV_OPT_SPEED | DEV_OPT_DUPLEX | DEV_OPT_PAUSE | DEV_OPT_ASYM_PAUSE)))
@@ -3604,6 +3608,7 @@ system_if_dump_info(struct device *dev, struct blob_buf *b)
 	system_add_devtype(b, dev->ifname);
 
 	/* Add PSE (PoE) status if available */
+#ifdef HAVE_ETHTOOL_PSE
 	{
 		struct pse_reply_data pse_data;
 		if (system_pse_get(dev, &pse_data) == 0) {
@@ -3706,6 +3711,7 @@ system_if_dump_info(struct device *dev, struct blob_buf *b)
 			blobmsg_close_table(b, pse_tbl);
 		}
 	}
+#endif
 
 	return 0;
 }
