From: cnjn
Subject: [PATCH] fw4: resolve macvlan devices to their lower device

A macvlan (e.g. one PPPoE session of a multi-dial setup) is offloaded
through its lower device, as vlan and bridge devices already are.
netifd reports a macvlan with devtype ethernet, so use its type.

---
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -430,9 +430,14 @@
 	let devs = [];
 
 	if (dir) {
-		switch (devstatus[devname]?.devtype) {
+		/* netifd reports a macvlan as an ethernet device. */
+		let devtype = (devstatus[devname]?.type == 'macvlan')
+			? 'macvlan' : devstatus[devname]?.devtype;
+
+		switch (devtype) {
 		case 'vlan':
 		case 'bridge':
+		case 'macvlan':
 			let e;
 
 			while ((e = dir.read()) != null)
