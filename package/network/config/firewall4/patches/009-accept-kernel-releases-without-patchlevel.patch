From: lean <chenlin@fnnas.com>
Subject: [PATCH] firewall4: accept kernel releases without a patchlevel

Stable point-zero kernels report versions such as 7.3, rather than
7.3.0. Treat an omitted patchlevel as zero so feature checks do not
reject valid WAN zones with mtu_fix enabled.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -551,9 +551,9 @@
 		    v = 0;
 
 		if (fd) {
-		    let m = match(fd.read("line"), /^Linux version ([0-9]+)\.([0-9]+)\.([0-9]+)/);
+		    let m = match(fd.read("line"), /^Linux version ([0-9]+)\.([0-9]+)(\.([0-9]+))?/);
 
-		    v = m ? (+m[1] << 24) | (+m[2] << 16) | (+m[3] << 8) : 0;
+		    v = m ? (+m[1] << 24) | (+m[2] << 16) | (+(m[4] || 0) << 8) : 0;
 		    fd.close();
 		}
 
