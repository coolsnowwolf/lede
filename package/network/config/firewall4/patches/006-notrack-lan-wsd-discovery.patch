From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] firewall4: bypass conntrack for LAN WSD discovery

Bypass connection tracking for LAN UDP port 3702 to the IPv4 and IPv6
WSD multicast addresses.
Install a one-time migration while preserving existing user rules.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/root/etc/uci-defaults/96-wsd-notrack
+++ b/root/etc/uci-defaults/96-wsd-notrack
@@ -0,0 +1,36 @@
+#!/bin/sh
+
+# WSD discovery needs no connection tracking or address translation.
+. /lib/functions.sh
+
+find_lan_zone() {
+	local name
+	config_get name "$1" name
+	[ "$name" = "lan" ] && lan_zone=1
+}
+
+lan_zone=0
+config_load firewall
+config_foreach find_lan_zone zone
+[ "$lan_zone" = 1 ] || exit 0
+
+add_wsd_rule() {
+	local section="$1" family="$2" address="$3"
+
+	# Preserve an existing rule, including an explicitly disabled one.
+	uci -q get "firewall.$section" >/dev/null && return 0
+	uci batch <<EOT
+set firewall.$section=rule
+set firewall.$section.name='WSD $family multicast discovery'
+set firewall.$section.src='lan'
+set firewall.$section.family='$family'
+set firewall.$section.proto='udp'
+set firewall.$section.dest_ip='$address'
+set firewall.$section.dest_port='3702'
+set firewall.$section.target='NOTRACK'
+EOT
+}
+
+add_wsd_rule wsd_ipv4_notrack ipv4 239.255.255.250
+add_wsd_rule wsd_ipv6_notrack ipv6 ff02::c
+uci commit firewall
