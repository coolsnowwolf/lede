From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] firewall4: bypass conntrack for LAN SSDP discovery

Bypass connection tracking for LAN IPv4 SSDP multicast discovery.
Install a one-time UCI migration so preserved configurations receive
the rule as well, without replacing an existing user rule.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/root/etc/uci-defaults/95-upnp-ssdp-notrack
+++ b/root/etc/uci-defaults/95-upnp-ssdp-notrack
@@ -0,0 +1,30 @@
+#!/bin/sh
+
+# Discovery traffic needs no connection tracking or address translation.
+. /lib/functions.sh
+
+find_lan_zone() {
+	local name
+	config_get name "$1" name
+	[ "$name" = "lan" ] && lan_zone=1
+}
+
+lan_zone=0
+config_load firewall
+config_foreach find_lan_zone zone
+[ "$lan_zone" = 1 ] || exit 0
+
+# Preserve an existing rule, including an explicitly disabled one.
+uci -q get firewall.upnp_ssdp_notrack >/dev/null && exit 0
+
+uci batch <<'EOF'
+set firewall.upnp_ssdp_notrack=rule
+set firewall.upnp_ssdp_notrack.name='UPnP SSDP multicast discovery'
+set firewall.upnp_ssdp_notrack.src='lan'
+set firewall.upnp_ssdp_notrack.family='ipv4'
+set firewall.upnp_ssdp_notrack.proto='udp'
+set firewall.upnp_ssdp_notrack.dest_ip='239.255.255.250'
+set firewall.upnp_ssdp_notrack.dest_port='1900'
+set firewall.upnp_ssdp_notrack.target='NOTRACK'
+EOF
+uci commit firewall
