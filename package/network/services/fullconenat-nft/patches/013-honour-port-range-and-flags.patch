From: milkman-wang <109866905+milkman-wang@users.noreply.github.com>
Subject: [PATCH] nft_fullcone: honour the port range and the flags

nft_fullcone_init() never read NFTA_FULLCONE_FLAGS or the proto range
registers, so rules such as "fullcone to :1024-2047" or "fullcone random"
worked like a plain "fullcone": the external port was chosen from
1024-65535 whatever the range said. The attribute numbers also differ
from the ones the libnftnl and nftables fullcone patches send
(FLAGS = 1, REG_PROTO_MIN = 2, REG_PROTO_MAX = 3), so reading them as
numbered here would mix them up.

Number the attributes like userspace does, and parse them in
nft_fullcone_init() the way nft_masq does.

The range from the rule then reaches code that so far only saw
1024-65535:

- find_appropriate_port{,6}() kept the range size and the loop counter
  in 16 bits, so ":0-65535" gave a size of 0: a division by zero with
  random or fully-random, port 0 without. Use 32 bits, and swap a
  reversed range like nf_nat_l4proto_unique_tuple() does.

- nf_nat_handle_postrouting() reused an active UDP mapping whatever its
  external port, so after a range change, or with different ranges for
  different destinations, a new flow could get a port outside the
  rule's range. The lookups by internal source now take the port range.
  One socket can then have a mapping per range on the same external
  address, so nf_nat_fullcone_handle_dying_tuples() also matches the
  external port of a dying conntrack, to release the mapping it
  belongs to.

Signed-off-by: milkman-wang <109866905+milkman-wang@users.noreply.github.com>

--- a/src/nf_nat_fullcone.h
+++ b/src/nf_nat_fullcone.h
@@ -45,15 +45,17 @@ static inline void nf_ct_netns_put(struc
 /**
  * enum nft_fullcone_attributes - nf_tables fullcone expression netlink attributes
  *
+ * @NFTA_FULLCONE_FLAGS: NAT flags (see NF_NAT_RANGE_* in linux/netfilter/nf_nat.h) (NLA_U32)
  * @NFTA_FULLCONE_REG_PROTO_MIN: source register of proto range start (NLA_U32: nft_registers)
  * @NFTA_FULLCONE_REG_PROTO_MAX: source register of proto range end (NLA_U32: nft_registers)
- * @NFTA_FULLCONE_FLAGS: NAT flags (see NF_NAT_RANGE_* in linux/netfilter/nf_nat.h) (NLA_U32)
+ *
+ * The order matches the fullcone patches for libnftnl and nftables.
  */
 enum nft_fullcone_attributes {
 	NFTA_FULLCONE_UNSPEC,
+	NFTA_FULLCONE_FLAGS,
 	NFTA_FULLCONE_REG_PROTO_MIN,
 	NFTA_FULLCONE_REG_PROTO_MAX,
-	NFTA_FULLCONE_FLAGS,
 	__NFTA_FULLCONE_MAX
 };
 #define NFTA_FULLCONE_MAX		(__NFTA_FULLCONE_MAX - 1)
--- a/src/nft_ext_fullcone.c
+++ b/src/nft_ext_fullcone.c
@@ -141,10 +141,61 @@ static int nft_fullcone_validate(const s
 	return nft_chain_validate_hooks(ctx->chain, (1 << NF_INET_PRE_ROUTING) | (1 << NF_INET_POST_ROUTING));
 }
 
+/* nft_parse_register_load() came with Linux 5.12 and was backported to
+ * 5.4.244 and 5.10.127. It takes a struct nft_ctx since 6.12, 6.6.120
+ * and 6.1.184. Older kernels parse and validate in two steps. */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)) || \
+    ((LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 120)) && \
+     (LINUX_VERSION_CODE <  KERNEL_VERSION(6, 7, 0))) || \
+    ((LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 184)) && \
+     (LINUX_VERSION_CODE <  KERNEL_VERSION(6, 2, 0)))
+#define nft_fullcone_parse_reg(ctx, attr, reg, len) \
+	nft_parse_register_load(ctx, attr, reg, len)
+#elif (LINUX_VERSION_CODE >= KERNEL_VERSION(5, 12, 0)) || \
+    ((LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 127)) && \
+     (LINUX_VERSION_CODE <  KERNEL_VERSION(5, 11, 0))) || \
+    ((LINUX_VERSION_CODE >= KERNEL_VERSION(5, 4, 244)) && \
+     (LINUX_VERSION_CODE <  KERNEL_VERSION(5, 5, 0)))
+#define nft_fullcone_parse_reg(ctx, attr, reg, len) \
+	nft_parse_register_load(attr, reg, len)
+#else
+static int nft_fullcone_parse_reg(const struct nft_ctx *ctx, const struct nlattr *attr,
+				  u8 *reg, u32 len)
+{
+	*reg = nft_parse_register(attr);
+	return nft_validate_register_load(*reg, len);
+}
+#endif
+
 static int nft_fullcone_init(const struct nft_ctx *ctx, const struct nft_expr *expr, const struct nlattr *const tb[])
 {
 	int err;
 	int register_ct_notifier_ret = 0;
+	struct nft_fullcone *priv = nft_expr_priv(expr);
+	u32 plen = sizeof(((struct nf_nat_range *)NULL)->min_proto.all);
+
+	if (tb[NFTA_FULLCONE_FLAGS]) {
+		priv->flags = ntohl(nla_get_be32(tb[NFTA_FULLCONE_FLAGS]));
+		if (priv->flags & ~NF_NAT_RANGE_MASK)
+			return -EINVAL;
+	}
+
+	if (tb[NFTA_FULLCONE_REG_PROTO_MIN]) {
+		err = nft_fullcone_parse_reg(ctx, tb[NFTA_FULLCONE_REG_PROTO_MIN],
+					     &priv->sreg_proto_min, plen);
+		if (err < 0)
+			return err;
+
+		if (tb[NFTA_FULLCONE_REG_PROTO_MAX]) {
+			err = nft_fullcone_parse_reg(ctx, tb[NFTA_FULLCONE_REG_PROTO_MAX],
+						     &priv->sreg_proto_max, plen);
+			if (err < 0)
+				return err;
+		} else {
+			priv->sreg_proto_max = priv->sreg_proto_min;
+		}
+		priv->flags |= NF_NAT_RANGE_PROTO_SPECIFIED;
+	}
 
 	err = nf_ct_netns_get(ctx->net, ctx->family);
 
