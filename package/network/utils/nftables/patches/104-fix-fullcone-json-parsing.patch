From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] nftables: fix fullcone and redirect JSON parsing

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/src/parser_json.c
+++ b/src/parser_json.c
@@ -2282,12 +2282,13 @@
 		[NFT_NAT_SNAT]	= "snat",
 		[NFT_NAT_DNAT]	= "dnat",
 		[NFT_NAT_MASQ]	= "masquerade",
+		[NFT_NAT_FULLCONE] = "fullcone",
 		[NFT_NAT_REDIR]	= "redirect",
 	};
 	size_t i;
 
 	for (i = 0; i < array_size(nat_etypes); i++) {
-		if (!strcmp(type, nat_etypes[i]))
+		if (nat_etypes[i] && !strcmp(type, nat_etypes[i]))
 			return i;
 	}
 	return -1;
@@ -2900,6 +2901,7 @@
 		{ "snat", json_parse_nat_stmt },
 		{ "dnat", json_parse_nat_stmt },
 		{ "masquerade", json_parse_nat_stmt },
+		{ "fullcone", json_parse_nat_stmt },
 		{ "redirect", json_parse_nat_stmt },
 		{ "reject", json_parse_reject_stmt },
 		{ "set", json_parse_set_stmt },
