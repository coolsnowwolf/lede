From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: iptables: avoid legacy restore text relocations on LoongArch

Keep the restore callback tables writable so LoongArch does not emit
unsupported read-only data relocations for the legacy binary.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/iptables/iptables-restore.c
+++ b/iptables/iptables-restore.c
@@ -361,7 +361,7 @@
 
 
 #if defined ENABLE_IPV4
-static const struct iptables_restore_cb ipt_restore_cb = {
+static struct iptables_restore_cb ipt_restore_cb = {
 	.ops		= &iptc_ops,
 	.for_each_chain	= for_each_chain4,
 	.flush_entries	= flush_entries4,
@@ -395,7 +395,7 @@
 #endif
 
 #if defined ENABLE_IPV6
-static const struct iptables_restore_cb ip6t_restore_cb = {
+static struct iptables_restore_cb ip6t_restore_cb = {
 	.ops		= &ip6tc_ops,
 	.for_each_chain	= for_each_chain6,
 	.flush_entries	= flush_entries6,
