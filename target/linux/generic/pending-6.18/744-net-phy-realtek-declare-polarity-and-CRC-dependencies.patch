From: lean <chenlin@fnnas.com>
Subject: [PATCH] net: phy: realtek: declare polarity and CRC dependencies

Include the helpers used by the RTL826x firmware and Wake-on-LAN paths
and select their providers for built-in and modular driver builds.

Signed-off-by: lean <chenlin@fnnas.com>
---

--- a/drivers/net/phy/realtek/Kconfig
+++ b/drivers/net/phy/realtek/Kconfig
@@ -1,6 +1,8 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config REALTEK_PHY
 	tristate "Realtek PHYs"
+	select CRC32
+	select PHY_COMMON_PROPS
 	help
 	  Currently supports RTL821x/RTL822x and fast ethernet PHYs
 
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -8,6 +8,8 @@
  * Copyright (c) 2004 Freescale Semiconductor, Inc.
  */
 #include <linux/bitops.h>
+#include <linux/crc32.h>
+#include <linux/phy/phy-common-props.h>
 #include <linux/ethtool_netlink.h>
 #include <linux/of.h>
 #include <linux/phy.h>
