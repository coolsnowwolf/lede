From: lean <chenlin@fnnas.com>
Subject: [PATCH] block: fitblk: initialize device pointer before probing

Registering the platform device can immediately probe an already available
root disk. Assign the global device pointer before adding it so the probe
can safely create sysfs links and child devices.

Signed-off-by: lean <chenlin@fnnas.com>
---
--- a/drivers/block/fitblk.c
+++ b/drivers/block/fitblk.c
@@ -637,6 +637,8 @@
 
 static int __init fitblk_init(void)
 {
+	int ret;
+
 	/* detect U-Boot firmware */
 	ubootver = of_get_property(of_chosen, "u-boot,version", NULL);
 	if (!ubootver)
@@ -651,9 +653,16 @@
 		return -ENODEV;
 
 	refcount_set(&num_devs, 1);
-	pdev = platform_device_register_simple("fitblk", -1, NULL, 0);
-	if (IS_ERR(pdev))
-		return PTR_ERR(pdev);
+	pdev = platform_device_alloc("fitblk", PLATFORM_DEVID_NONE);
+	if (!pdev)
+		return -ENOMEM;
+
+	/* platform_device_add() can probe immediately when the disk exists. */
+	ret = platform_device_add(pdev);
+	if (ret) {
+		platform_device_put(pdev);
+		return ret;
+	}
 
 	return 0;
 }
