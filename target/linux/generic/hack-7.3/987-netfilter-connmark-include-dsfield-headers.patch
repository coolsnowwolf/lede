From: lean <chenlin@fnnas.com>
Subject: [PATCH] netfilter: include DSCP helpers for connmark

Include the headers used by set-dscpmark explicitly after the Linux 7.3
netfilter header cleanup.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/net/netfilter/xt_connmark.c
+++ b/net/netfilter/xt_connmark.c
@@ -9,6 +9,9 @@
  */
 
 #include <linux/module.h>
+#include <linux/ip.h>
+#include <linux/ipv6.h>
+#include <net/dsfield.h>
 #include <linux/skbuff.h>
 #include <net/netfilter/nf_conntrack.h>
 #include <net/netfilter/nf_conntrack_ecache.h>
