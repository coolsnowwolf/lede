From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] 991-revert-init_dummy_netdev

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -3521,6 +3521,7 @@
 
 int netdev_refcnt_read(const struct net_device *dev);
 void free_netdev(struct net_device *dev);
+void init_dummy_netdev(struct net_device *dev);
 
 struct net_device *netdev_get_xmit_slave(struct net_device *dev,
 					 struct sk_buff *skb,
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -11659,8 +11659,13 @@
  * The setup steps dummy netdevs need which normal netdevs get by going
  * through register_netdevice().
  */
-static void init_dummy_netdev(struct net_device *dev)
+void init_dummy_netdev(struct net_device *dev)
 {
+	memset(dev, 0, sizeof(struct net_device));
+	INIT_LIST_HEAD(&dev->napi_list);
+	mutex_init(&dev->lock);
+	dev_net_set(dev, &init_net);
+
 	/* make sure we BUG if trying to hit standard
 	 * register/unregister code path
 	 */
@@ -11675,6 +11680,7 @@
 	 * its refcount.
 	 */
 }
+EXPORT_SYMBOL_GPL(init_dummy_netdev);
 
 /**
  *	register_netdev	- register a network device
