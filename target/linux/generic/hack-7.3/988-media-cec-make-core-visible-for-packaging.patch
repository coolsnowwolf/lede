From: lean <chenlin@fnnas.com>
Subject: [PATCH] media: cec: make CEC core selectable for packaging

Retain the QWRT 6.18 CEC core package configuration on Linux 7.3.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/drivers/media/cec/Kconfig
+++ b/drivers/media/cec/Kconfig
@@ -1,6 +1,9 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config CEC_CORE
-	tristate
+	tristate "HDMI CEC core support"
+	help
+	  Enable the core HDMI CEC framework shared by DRM display helpers
+	  and dedicated CEC drivers. The module is called cec.
 
 config CEC_NOTIFIER
 	bool
