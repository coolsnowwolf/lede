Keep the legacy embedded dummy-netdev API without resetting allocated devices.
alloc_netdev_mqs() initializes address lists before invoking its setup callback.
The legacy memset must never run as that callback.

--- a/include/linux/netdevice.h
+++ b/include/linux/netdevice.h
@@ -3400,6 +3400,7 @@
 }
 
 int netdev_refcnt_read(const struct net_device *dev);
 void free_netdev(struct net_device *dev);
+void init_dummy_netdev(struct net_device *dev);
 
 struct net_device *netdev_get_xmit_slave(struct net_device *dev,
--- a/net/core/dev.c
+++ b/net/core/dev.c
@@ -11485,7 +11485,7 @@
  * The setup steps dummy netdevs need which normal netdevs get by going
  * through register_netdevice().
  */
-static void init_dummy_netdev(struct net_device *dev)
+static void setup_dummy_netdev(struct net_device *dev)
 {
 	/* make sure we BUG if trying to hit standard
 	 * register/unregister code path
@@ -11500,6 +11500,17 @@
 	 * its refcount.
 	 */
 }
+
+/* Legacy callers own storage; allocator callbacks must preserve core state. */
+void init_dummy_netdev(struct net_device *dev)
+{
+	memset(dev, 0, sizeof(struct net_device));
+	INIT_LIST_HEAD(&dev->napi_list);
+	mutex_init(&dev->lock);
+	dev_net_set(dev, &init_net);
+	setup_dummy_netdev(dev);
+}
+EXPORT_SYMBOL_GPL(init_dummy_netdev);
 
 /**
  *	register_netdev	- register a network device
@@ -12217,7 +12228,7 @@
 struct net_device *alloc_netdev_dummy(int sizeof_priv)
 {
 	return alloc_netdev(sizeof_priv, "dummy#", NET_NAME_UNKNOWN,
-			    init_dummy_netdev);
+			    setup_dummy_netdev);
 }
 EXPORT_SYMBOL_GPL(alloc_netdev_dummy);
 
