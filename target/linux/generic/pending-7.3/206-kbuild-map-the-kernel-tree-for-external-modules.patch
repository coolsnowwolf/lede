From 7fbe3426fe286332745cbb7464147af6199268a8 Mon Sep 17 00:00:00 2001
From: Paul Spooren <mail@aparcar.org>
Date: Fri, 25 Sep 2026 09:53:18 +0200
Subject: [PATCH] kbuild: map the kernel tree out of __FILE__ for external
 modules

Since external modules are built in their own directory, srctree holds
the absolute path of the kernel tree and srcroot the one of the module.
Only srcroot is mapped with -fmacro-prefix-map, so every __FILE__ taken
from a kernel header, e.g. by WARN_ON() in an inline function, keeps the
absolute path of the kernel tree:

  -/builder/shared-workdir/build/build_dir/.../linux-6.18.52/include/linux/ucopysize.h
  +/tmp/rebuilderd-openwrt.Xebb8P/src/build_dir/.../linux-6.18.52/include/linux/ucopysize.h

Before, make -C $(KERNEL_DIR) M=... left srctree at ".", so the kernel
headers were included by a relative path.

Map the kernel tree as well when building external modules. Add the map
before the one of srcroot, since GCC uses the last matching map, so a
module directory inside the kernel tree is still mapped relative to the
module.

---
 Makefile | 5 +++++
 1 file changed, 5 insertions(+)

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/Makefile
+++ b/Makefile
@@ -1198,6 +1198,11 @@
 export CFLAGS_GCOV
 
 # change __FILE__ to the relative path to the source directory
+ifdef KBUILD_EXTMOD
+# External modules include the kernel headers by their absolute path. Map
+# them first, so that the map of the module directory below takes precedence.
+KBUILD_CPPFLAGS += $(call cc-option,-fmacro-prefix-map=$(abs_srctree)/=)
+endif
 ifdef building_out_of_srctree
 KBUILD_CPPFLAGS += -fmacro-prefix-map=$(srcroot)/=
 ifeq ($(call rustc-option-yn, --remap-path-scope=macro),y)
