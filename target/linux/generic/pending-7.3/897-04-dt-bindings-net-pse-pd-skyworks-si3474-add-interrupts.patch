From 3b57fcfd2ba85f59786904da3ea8a8416dfa2d2e Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Sun, 4 Oct 2026 08:27:35 +0100
Subject: [PATCH 2/3] dt-bindings: net: pse-pd: skyworks,si3474: add interrupts

The Si3474 has a single open-drain INTb output that signals events
from either of its two quads. Describe it so a board can wire it to
a GPIO and let the driver react to over-current faults and power
state changes.

Assisted-by: LLM
---
 .../devicetree/bindings/net/pse-pd/skyworks,si3474.yaml      | 5 +++++
 1 file changed, 5 insertions(+)

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/Documentation/devicetree/bindings/net/pse-pd/skyworks,si3474.yaml
+++ b/Documentation/devicetree/bindings/net/pse-pd/skyworks,si3474.yaml
@@ -25,6 +25,11 @@
       - const: main
       - const: secondary
 
+  interrupts:
+    maxItems: 1
+    description: INTb output, asserted low by an unserved event in either
+      quad.
+
   channels:
     description: The Si3474 is a single-chip PoE PSE controller managing
       8 physical power delivery channels. Internally, it's structured
