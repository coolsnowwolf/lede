From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] netfilter: isolate ctnetlink chain notifiers per namespace

A notifier_block contains its chain links and cannot be registered on
multiple namespace chains. Allocate one block per namespace to avoid
unlinking later listeners when another namespace is created.

Return NOTIFY_DONE from the chain callback so netlink delivery failures
do not prevent fullcone and offload listeners receiving conntrack events.
Keep the single-listener callback unchanged when chain events are off.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/net/netfilter/nf_conntrack_netlink.c
+++ b/net/netfilter/nf_conntrack_netlink.c
@@ -34,6 +34,7 @@
 #include <linux/netfilter.h>
 #include <net/netlink.h>
 #include <net/sock.h>
+#include <net/netns/generic.h>
 #include <net/netfilter/nf_conntrack.h>
 #include <net/netfilter/nf_conntrack_core.h>
 #include <net/netfilter/nf_conntrack_expect.h>
@@ -705,7 +706,7 @@
 
 static int
 #ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
-ctnetlink_conntrack_event(struct notifier_block *this, unsigned long events, void *ptr)
+__ctnetlink_conntrack_event(struct notifier_block *this, unsigned long events, void *ptr)
 #else
 ctnetlink_conntrack_event(unsigned int events, struct nf_ct_event *item)
 #endif
@@ -3775,9 +3776,27 @@
 
 #ifdef CONFIG_NF_CONNTRACK_EVENTS
 #ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
-static struct notifier_block ctnl_notifier = {
-	.notifier_call = ctnetlink_conntrack_event,
+/* Each namespace needs its own links in the conntrack notifier chain. */
+struct ctnetlink_net {
+	struct notifier_block ct_notifier;
 };
+
+static unsigned int ctnetlink_net_id __read_mostly;
+
+static int ctnetlink_conntrack_event(struct notifier_block *this,
+				   unsigned long events, void *ptr)
+{
+	/* Netlink send failures must not stop delivery to other listeners. */
+	__ctnetlink_conntrack_event(this, events, ptr);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block *ctnl_notifier_of(struct net *net)
+{
+	struct ctnetlink_net *cn = net_generic(net, ctnetlink_net_id);
+
+	return &cn->ct_notifier;
+}
 #else
 static struct nf_ct_event_notifier ctnl_notifier = {
 	.fcn = ctnetlink_conntrack_event,
@@ -3844,7 +3863,12 @@
 #ifdef CONFIG_NF_CONNTRACK_EVENTS
 	int ret;
 
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	ctnl_notifier_of(net)->notifier_call = ctnetlink_conntrack_event;
+	ret = nf_conntrack_register_notifier(net, ctnl_notifier_of(net));
+#else
 	ret = nf_conntrack_register_notifier(net, &ctnl_notifier);
+#endif
 	if (ret < 0) {
 		pr_err("ctnetlink_init: cannot register notifier.\n");
 		goto err_out;
@@ -3860,7 +3884,11 @@
 
 #ifdef CONFIG_NF_CONNTRACK_EVENTS
 err_unreg_notifier:
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	nf_conntrack_unregister_notifier(net, ctnl_notifier_of(net));
+#else
 	nf_conntrack_unregister_notifier(net, &ctnl_notifier);
+#endif
 err_out:
 	return ret;
 #endif
@@ -3870,8 +3898,12 @@
 {
 #ifdef CONFIG_NF_CONNTRACK_EVENTS
 	nf_ct_expect_unregister_notifier(net, &ctnl_notifier_exp);
+#ifdef CONFIG_NF_CONNTRACK_CHAIN_EVENTS
+	nf_conntrack_unregister_notifier(net, ctnl_notifier_of(net));
+#else
 	nf_conntrack_unregister_notifier(net, &ctnl_notifier);
 #endif
+#endif
 }
 
 static void __net_exit ctnetlink_net_exit_batch(struct list_head *net_exit_list)
@@ -3886,6 +3918,10 @@
 }
 
 static struct pernet_operations ctnetlink_net_ops = {
+#if defined(CONFIG_NF_CONNTRACK_EVENTS) && defined(CONFIG_NF_CONNTRACK_CHAIN_EVENTS)
+	.id		= &ctnetlink_net_id,
+	.size		= sizeof(struct ctnetlink_net),
+#endif
 	.init		= ctnetlink_net_init,
 	.exit_batch	= ctnetlink_net_exit_batch,
 };
