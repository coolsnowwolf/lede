Subject: [PATCH] net: zte: add the flowtable rule translator

--- /dev/null
+++ b/drivers/net/ethernet/zte/zx279133-client-limits.h
@@ -0,0 +1,285 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Explicit per-MAC policy, not a connection table. Called with supplier
+ * begin/end and translator lock held; no packet hook, worker or timer.
+ */
+struct zx279133_client_config {
+	u8 mac[ETH_ALEN];
+	u64 upload;
+	u64 download;
+	u32 burst_bytes;
+	bool used;
+};
+
+static bool zx279133_clients_active(struct zx279133_flow_offload *o)
+{
+	unsigned int i;
+
+	if (o->mac_global_owned)
+		return true;
+	for (i = 0; i < ZX279133_CLIENT_LIMITS; i++)
+		if (o->clients[i].pinned)
+			return true;
+	return false;
+}
+
+static int zx279133_client_release(struct zx279133_flow_offload *o,
+				   struct zx279133_client_limit *c, u8 slot)
+{
+	int ret, dir;
+
+	/* Disable both MAC selectors before releasing a shared binding. On any
+	 * failure retain Host + meters and module pin for a later explicit retry.
+	 */
+	if (c->host) {
+		ret = zte_nppt_host_limit(o->np, c->host, slot, false, false);
+		if (ret)
+			return ret;
+		c->programmed = false;
+	}
+	for (dir = 0; dir < 2; dir++) {
+		if (!c->meters[dir])
+			continue;
+		ret = zte_nppt_meter_put(o->np, c->meters[dir]);
+		if (ret)
+			return ret;
+		c->meters[dir] = NULL;
+		c->cbs_raw[dir] = 0;
+	}
+	if (c->host) {
+		ret = zte_nppt_host_put(o->np, c->host);
+		/* host_put consumes the reference even if its final row delete
+		 * fails; the NPU Host manager quarantines that zero-user row.
+		 */
+		c->host = NULL;
+		if (ret)
+			return ret;
+	}
+	if (c->pinned) {
+		c->pinned = false;
+		module_put(THIS_MODULE);
+	}
+	return 0;
+}
+
+static int zx279133_clients_global_restore(struct zx279133_flow_offload *o)
+{
+	unsigned int i;
+	int ret;
+
+	if (!o->mac_global_owned)
+		return 0;
+	for (i = 0; i < ZX279133_CLIENT_LIMITS; i++)
+		if (o->clients[i].pinned)
+			return 0;
+	ret = zte_nppt_mac_global_set(o->np, o->mac_global_saved);
+	if (!ret) {
+		o->mac_global_owned = false;
+		module_put(THIS_MODULE);
+	}
+	return ret;
+}
+
+static int zx279133_client_apply(struct zx279133_flow_offload *o,
+				 struct zx279133_client_limit *c, u8 slot)
+{
+	struct zte_nppt_plcr_timing timing;
+	struct zte_nppt_plcr_profile profile;
+	u64 rate[2] = { c->upload, c->download };
+	int ret, dir;
+
+	if (c->programmed)
+		return 0;
+	if (c->pinned)
+		return -EIO; /* failed cleanup must be retried before reprogramming */
+	if (!READ_ONCE(experimental_mac_limits))
+		return -EOPNOTSUPP;
+	ret = zte_nppt_native_plcr_timing_get(o->np, &timing);
+	if (ret)
+		return ret;
+	if (timing.time_count != 62500 || timing.packet_length != 8000 ||
+	    timing.packet_offset != 24 || timing.loose_length != 16000)
+		return -ESTALE;
+	c->host = zte_nppt_host_lookup_get(o->np, c->mac);
+	if (IS_ERR(c->host)) {
+		ret = PTR_ERR(c->host);
+		c->host = NULL;
+		return ret;
+	}
+	__module_get(THIS_MODULE);
+	c->pinned = true;
+	for (dir = 0; dir < 2; dir++) {
+		if (!rate[dir])
+			continue;
+		ret = zx279133_mac_police_tokens(rate[dir], c->burst_bytes,
+						 police_unit_bps,
+						 police_burst_unit, &profile);
+		if (ret)
+			goto rollback;
+		ret = zte_nppt_meter_mac_get(o->np, &profile, slot, dir, &c->meters[dir]);
+		if (ret)
+			goto rollback;
+		c->cbs_raw[dir] = profile.cbs;
+	}
+	if (!o->mac_global_owned) {
+		ret = zte_nppt_mac_global_get(o->np, &o->mac_global_saved);
+		if (ret)
+			goto rollback;
+		__module_get(THIS_MODULE);
+		o->mac_global_owned = true;
+		ret = zte_nppt_mac_global_set(o->np, true);
+		if (ret)
+			goto rollback;
+	}
+	ret = zte_nppt_host_limit(o->np, c->host, slot, !!rate[0], !!rate[1]);
+	if (ret)
+		goto rollback;
+	c->programmed = true;
+	return 0;
+rollback:
+	zx279133_client_release(o, c, slot);
+	zx279133_clients_global_restore(o);
+	return ret;
+}
+
+static void zx279133_clients_sync(struct zx279133_flow_offload *o)
+{
+	unsigned int i;
+
+	for (i = 0; i < ZX279133_CLIENT_LIMITS; i++)
+		if (o->clients[i].used && !o->clients[i].programmed)
+			o->clients[i].error = zx279133_client_apply(o, &o->clients[i], i);
+}
+
+static int zx279133_clients_clear(struct zx279133_flow_offload *o, bool hardware)
+{
+	unsigned int i;
+	int ret, error = 0;
+
+	if (!hardware && zx279133_clients_active(o))
+		return -EBUSY;
+	for (i = 0; i < ZX279133_CLIENT_LIMITS; i++) {
+		ret = zx279133_client_release(o, &o->clients[i], i);
+		if (ret)
+			error = ret;
+		if (o->clients[i].used)
+			o->clients[i].error = ret ? ret : -ENETDOWN;
+	}
+	ret = zx279133_clients_global_restore(o);
+	return error ? error : ret;
+}
+
+static int zx279133_client_set(struct zx279133_flow_offload *o,
+			       const u8 *mac, u64 upload, u64 download,
+			       u32 burst_bytes)
+{
+	struct zx279133_client_limit *c = NULL;
+	struct zx279133_client_config previous = {};
+	struct zte_nppt_plcr_profile profile;
+	unsigned int i, slot = ZX279133_CLIENT_LIMITS;
+	int ret, apply_ret, cleanup_ret;
+
+	if (!is_valid_ether_addr(mac))
+		return -EINVAL;
+	/* Zero remains the automatic policy, including across retries/rollback. */
+	if (burst_bytes && (burst_bytes < ZX279133_CLIENT_CBS_MIN ||
+			    burst_bytes > ZX279133_CLIENT_CBS_MAX))
+		return -ERANGE;
+	/* Validate before removing an existing policy. 0 disables that direction. */
+	if (upload && zx279133_mac_police_tokens(upload, burst_bytes,
+						 police_unit_bps, police_burst_unit,
+						 &profile))
+		return -ERANGE;
+	if (download && zx279133_mac_police_tokens(download, burst_bytes,
+						   police_unit_bps, police_burst_unit,
+						   &profile))
+		return -ERANGE;
+	/* Do not tear down a working limit before discovering that the explicit
+	 * experimental gate has been closed. Disabling a policy remains allowed.
+	 */
+	if ((upload || download) && !READ_ONCE(experimental_mac_limits))
+		return -EOPNOTSUPP;
+	for (i = 0; i < ZX279133_CLIENT_LIMITS; i++) {
+		if (!o->clients[i].used) {
+			if (slot == ZX279133_CLIENT_LIMITS)
+				slot = i;
+			continue;
+		}
+		if (ether_addr_equal(o->clients[i].mac, mac)) {
+			c = &o->clients[i];
+			slot = i;
+			break;
+		}
+	}
+	if (!c && !upload && !download)
+		return zx279133_clients_global_restore(o);
+	if (slot == ZX279133_CLIENT_LIMITS)
+		return -ENOSPC;
+	c = &o->clients[slot];
+	previous.used = c->used;
+	if (previous.used) {
+		ether_addr_copy(previous.mac, c->mac);
+		previous.upload = c->upload;
+		previous.download = c->download;
+		previous.burst_bytes = c->burst_bytes;
+	}
+	ret = zx279133_client_release(o, c, slot);
+	if (ret) {
+		c->error = ret;
+		return ret;
+	}
+	if (!upload && !download) {
+		zte_nppt_host_watch(o->np, slot, NULL);
+		memset(c, 0, sizeof(*c));
+		return zx279133_clients_global_restore(o);
+	}
+	ether_addr_copy(c->mac, mac);
+	c->used = true;
+	zte_nppt_host_watch(o->np, slot, mac);
+	c->upload = upload;
+	c->download = download;
+	c->burst_bytes = burst_bytes;
+	c->error = zx279133_client_apply(o, c, slot);
+	/* Desired policy survives startup without an active Host. A subsequent
+	 * flow installation retries once, without polling or a userspace sampler.
+	 */
+	if (c->error == -ENOENT || c->error == -EAGAIN) {
+		c->error = 0;
+		return 0;
+	}
+	if (!c->error)
+		return 0;
+
+	/* OEM-style MAC limiting changes the PLCR bindings and table9 action in
+	 * separate hardware operations. Try to restore the prior policy if a new
+	 * request fails. If cleanup fails, retain ownership of every uncertain
+	 * resource instead of replacing pointers that may still be live in NP.
+	 */
+	apply_ret = c->error;
+	if (c->pinned)
+		return apply_ret;
+	cleanup_ret = zx279133_client_release(o, c, slot);
+	if (cleanup_ret) {
+		c->error = cleanup_ret;
+		return cleanup_ret;
+	}
+	if (previous.used) {
+		ether_addr_copy(c->mac, previous.mac);
+		c->used = true;
+		c->upload = previous.upload;
+		c->download = previous.download;
+		c->burst_bytes = previous.burst_bytes;
+		zte_nppt_host_watch(o->np, slot, previous.mac);
+		c->error = zx279133_client_apply(o, c, slot);
+		if (c->error == -ENOENT || c->error == -EAGAIN)
+			c->error = 0;
+		if (c->error)
+			return c->error;
+	} else {
+		zte_nppt_host_watch(o->np, slot, NULL);
+		memset(c, 0, sizeof(*c));
+		cleanup_ret = zx279133_clients_global_restore(o);
+		if (cleanup_ret)
+			return cleanup_ret;
+	}
+	return apply_ret;
+}
--- /dev/null
+++ b/drivers/net/ethernet/zte/zx279133-offload.c
@@ -0,0 +1,2231 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ZTE ZX279133 NPPT IPv4/IPv6 flow-table offload. */
+
+#include <linux/bitmap.h>
+#include <linux/hashtable.h>
+#include <linux/jhash.h>
+#include <linux/capability.h>
+#include <linux/debugfs.h>
+#include <linux/etherdevice.h>
+#include <linux/ip.h>
+#include <linux/if_vlan.h>
+#include <linux/if_pppox.h>
+#include <linux/ipv6.h>
+#include <linux/jiffies.h>
+#include <linux/rhashtable.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/tcp.h>
+#include <linux/udp.h>
+#include <linux/uaccess.h>
+#include <linux/unaligned.h>
+#include <linux/xarray.h>
+
+#include <net/flow_offload.h>
+#include <net/pkt_cls.h>
+
+#include <linux/kref.h>
+#include <linux/module.h>
+#include <linux/hex.h>
+#include <linux/zte_nppt_offload.h>
+#include <linux/zte_nppt_native.h>
+#include "zx279133-policy.h"
+
+/* Admission and the NPU cold-load key layout are enabled together by the
+ * platform package. Capability detection remains mandatory for every rule.
+ */
+static bool vlan_offload;
+module_param(vlan_offload, bool, 0644);
+MODULE_PARM_DESC(vlan_offload, "Admit single-tag LAN/WAN IPv4 rules when the NPU VID keys are active");
+module_param_named(experimental_vlan, vlan_offload, bool, 0644);
+MODULE_PARM_DESC(experimental_vlan, "Compatibility alias for vlan_offload");
+
+static bool zx279133_vlan_enabled(struct zte_nppt *np)
+{
+	struct zte_nppt_info info;
+
+	zte_nppt_get_info(np, &info);
+	return READ_ONCE(vlan_offload) &&
+		(info.capabilities & ZTE_NPPT_CAP_LAN_VID_KEY);
+}
+
+static bool zx279133_wan_vlan_enabled(struct zte_nppt *np)
+{
+	struct zte_nppt_info info;
+
+	zte_nppt_get_info(np, &info);
+	return READ_ONCE(vlan_offload) &&
+		(info.capabilities & ZTE_NPPT_CAP_WAN_VID_KEY);
+}
+
+/* Raw token calibration remains opt-in until its units and semantics have
+ * been established. VLAN admission does not enable policers or shapers.
+ */
+static bool experimental_police;
+module_param(experimental_police, bool, 0644);
+MODULE_PARM_DESC(experimental_police, "Allow new experimental byte police rules; delete rules before disabling");
+/* CPU133 board calibration: 344064000 / 62500 * 8 = 44040.192.
+ * Round the quantum up so CIR rounding never raises the requested wire rate.
+ * Verified with 300/600/1200/1400-byte UDP and a separate CIR454 holdout.
+ */
+static unsigned int police_unit_bps = 44041;
+module_param(police_unit_bps, uint, 0444);
+MODULE_PARM_DESC(police_unit_bps, "Wire bits/s per CIR token; CPU133 calibration at time_count=62500");
+static unsigned int police_burst_unit = 1;
+module_param(police_burst_unit, uint, 0444);
+MODULE_PARM_DESC(police_burst_unit, "Experimental bytes per CBS token (hypothesis)");
+
+#define ZX279133_FAST_KEY_SIZE		16
+#define ZX279133_FAST_DATA_SIZE		32
+#define ZX279133_FAST_IKEY_SIZE		16
+#define ZX279133_FAST_IKEY_DEPTH	ZTE_NPPT_FAST_IKEY_DEPTH
+#define ZX279133_ZCAM_ENTRY_SIZE	64
+/* np.ko core_sdt_init() gives SDT14 256 ZCAM entries before DDR overflow. */
+#define ZX279133_FAST_FULL_ZCAM_LIMIT	256
+#define ZX279133_DDR_BUCKET_SHIFT	6
+#define ZX279133_DDR_BUCKET_SIZE		BIT(ZX279133_DDR_BUCKET_SHIFT)
+#define ZX279133_DDR_BUCKETS		(ZTE_NPPT_DDR_BYTES >> \
+					 ZX279133_DDR_BUCKET_SHIFT)
+#define ZX279133_HASH_CRC32_POLY		0x04c11db7
+
+#define ZX279133_FAST_MULTI_SELECTOR	0x01
+#define ZX279133_FAST_MULTI_FOOTER	0xc1
+#define ZX279133_FAST_FULL_SELECTOR	0x00
+#define ZX279133_FAST_FULL_FOOTER	0xe0
+
+#include "zx279133-offload-debug-types.h"
+
+struct zx279133_flow_tuple {
+	__be32 src_addr;
+	__be32 dst_addr;
+	__be16 src_port;
+	__be16 dst_port;
+};
+
+struct zx279133_flow_data {
+	struct ethhdr eth;
+	struct zx279133_flow_tuple tuple;
+	struct in6_addr src_v6;
+	struct in6_addr dst_v6;
+	struct zx279133_vlan_plan vlan;
+	struct zte_nppt_plcr_profile police;
+	u32 police_index;
+	bool police_set;
+	u8 meter_bucket;
+	u16 vlan_tci;
+	u8 traffic_class;
+	bool vlan_push;
+	bool traffic_class_set;
+};
+
+/* Parsed rule identity; compare fields, never structure padding. */
+struct zx279133_flow_spec {
+	struct zx279133_flow_data data;
+	struct zx279133_flow_tuple xlate;
+	enum zx279133_flow_port ingress;
+	enum zx279133_flow_port egress;
+	u16 gemport;
+	u16 pppoe_sid;
+	u8 ip_proto;
+	bool ipv6;
+};
+
+struct zx279133_stat_group;
+
+struct zx279133_flow_entry {
+	struct zx279133_stat_group *stat_group;
+#ifdef CONFIG_DEBUG_FS
+	unsigned long debug_cookie;
+	u64 debug_generation;
+#endif
+	struct zx279133_flow_spec spec;
+	struct zte_nppt_meter *meter;
+	struct zte_nppt_vlan *vlan_in;
+	struct zte_nppt_vlan *vlan_out;
+	/* Reset may retire hardware before flowtable asks for its final delta. */
+	struct flow_stats final_stats;
+	bool retired;
+	struct rhash_head key_node;
+	u8 key[ZX279133_FAST_KEY_SIZE];
+	/* An upstream entry is indexed by the key its reply will have. */
+	struct rhash_head reply_node;
+	u8 reply_key[ZX279133_FAST_KEY_SIZE];
+	u8 zblock;
+	u8 zcell;
+	u8 zaddr;
+	u32 ddr_bucket;
+	u32 age;
+	u16 ikey;
+	u16 stat;
+	u8 wanid;
+	struct zte_nppt_host *host;
+	/* The flowtable the entry came from. */
+	const struct flow_block *fblock;
+	bool flowtable;
+	u64 packets;
+	u64 bytes;
+	unsigned long lastused;
+	bool module_pinned;
+	bool stale;
+	bool has_stat;
+	bool has_age;
+	bool snat;
+	bool pppoe;
+	bool wan_vlan;
+	/* From a LAN port, out by the WAN path; else from the WAN port. */
+	bool upstream;
+	/* Out of a LAN port, a second WAN, rather than the WAN port. */
+	bool lan_routed;
+	/*
+	 * Kept out of the hardware, holding nothing there: only remembers,
+	 * by its reply key, that the other half of the flow comes in PPPoE.
+	 */
+	bool refused;
+	bool reply_indexed;
+	bool full;
+	bool in_ddr;
+};
+
+#define ZX279133_CLIENT_LIMITS 32
+#define ZX279133_CLIENT_CBS_DEFAULT 0 /* automatic, per-direction OEM rate formula */
+#define ZX279133_CLIENT_CBS_MIN 16384
+#define ZX279133_CLIENT_CBS_MAX ZX279133_MAC_CBS_MAX_RAW
+struct zx279133_client_limit {
+	u8 mac[ETH_ALEN];
+	u64 upload;
+	u64 download;
+	u32 burst_bytes;
+	u32 cbs_raw[2];
+	struct zte_nppt_host *host;
+	struct zte_nppt_meter *meters[2];
+	int error;
+	bool used;
+	bool pinned;
+	bool programmed;
+};
+
+struct zx279133_flow_offload {
+#ifdef CONFIG_DEBUG_FS
+	struct zx279133_diag diag;
+#endif
+	struct zte_nppt *np;
+	struct device *dev;
+	struct kref ref;
+	struct dentry *debugfs;
+	bool detached;
+	/* Serializes software flow state and SE indirect accesses. */
+	struct mutex lock;
+	struct xarray flows;
+	struct rhashtable key_flows;
+	struct rhashtable reply_flows;
+	struct list_head block_cb_list;
+	unsigned long *ddr_used;
+	DECLARE_BITMAP(ikey_used, ZX279133_FAST_IKEY_DEPTH);
+	DECLARE_BITMAP(age_used, ZX279133_FAST_AGE_DEPTH);
+	DECLARE_BITMAP(stat_used, ZX279133_FAST_STAT_DEPTH);
+	DECLARE_HASHTABLE(stat_groups, 8);
+	u32 stat_group_count;
+	u32 ddr_entries;
+	u16 fast_full_zcam_used;
+	struct zx279133_client_limit clients[ZX279133_CLIENT_LIMITS];
+	bool mac_global_owned;
+	bool mac_global_saved;
+
+};
+
+static bool experimental_mac_limits;
+module_param(experimental_mac_limits, bool, 0644);
+MODULE_PARM_DESC(experimental_mac_limits, "Allow explicit experimental shared MAC policers");
+
+static void zx279133_clients_sync(struct zx279133_flow_offload *o);
+static int zx279133_clients_clear(struct zx279133_flow_offload *o, bool hardware);
+static bool zx279133_clients_active(struct zx279133_flow_offload *o);
+
+static const struct rhashtable_params zx279133_flow_key_ht_params = {
+	.head_offset = offsetof(struct zx279133_flow_entry, key_node),
+	.key_offset = offsetof(struct zx279133_flow_entry, key),
+	.key_len = ZX279133_FAST_KEY_SIZE,
+	.automatic_shrinking = true,
+};
+
+static const struct rhashtable_params zx279133_flow_reply_ht_params = {
+	.head_offset = offsetof(struct zx279133_flow_entry, reply_node),
+	.key_offset = offsetof(struct zx279133_flow_entry, reply_key),
+	.key_len = ZX279133_FAST_KEY_SIZE,
+	.automatic_shrinking = true,
+};
+
+struct zx279133_flow_block {
+	struct zx279133_flow_offload *offload;
+	struct net_device *ndev;
+	/* The flowtable's block; it is shared by all its devices. */
+	struct flow_block *fblock;
+	bool flowtable;
+};
+
+static int zx279133_fast_index_alloc(unsigned long *used,
+				      unsigned int depth, u16 *index)
+{
+	unsigned long bit;
+
+	bit = find_first_zero_bit(used, depth);
+	if (bit == depth)
+		return -ENOSPC;
+	__set_bit(bit, used);
+	*index = bit;
+
+	return 0;
+}
+
+static int
+zx279133_fast_age_alloc(struct zx279133_flow_offload *offload, u32 *index)
+{
+	unsigned long bit;
+
+	bit = find_first_zero_bit(offload->age_used, ZX279133_FAST_AGE_DEPTH);
+	if (bit == ZX279133_FAST_AGE_DEPTH)
+		return -ENOSPC;
+	__set_bit(bit, offload->age_used);
+	*index = bit;
+
+	return 0;
+}
+
+static u32 zx279133_crc32(u32 poly, const u8 *data, size_t len)
+{
+	u32 crc = 0;
+	int bit;
+
+	while (len--) {
+		crc ^= (u32)data[len] << 24;
+		for (bit = 0; bit < 8; bit++)
+			crc = crc & BIT(31) ? (crc << 1) ^ poly : crc << 1;
+	}
+
+	return crc;
+}
+
+static int zx279133_ddr_alloc(struct zx279133_flow_offload *offload,
+			      struct zx279133_flow_entry *entry, u8 selector)
+{
+	u8 hash_input[49] = {};
+	u32 crc;
+
+	hash_input[0] = selector;
+	memcpy(hash_input + 1, entry->key, ZX279133_FAST_KEY_SIZE);
+	crc = zx279133_crc32(ZX279133_HASH_CRC32_POLY, hash_input, sizeof(hash_input));
+	entry->ddr_bucket = crc & (ZX279133_DDR_BUCKETS - 1);
+	if (test_and_set_bit(entry->ddr_bucket, offload->ddr_used))
+		return -ENOSPC;
+	entry->in_ddr = true;
+	if (!offload->ddr_entries)
+		dev_info(offload->dev,
+			 "SDT14 fast-flow overflow entered DDR bulk 0 at bucket %u\n",
+			 entry->ddr_bucket);
+	offload->ddr_entries++;
+
+	return 0;
+}
+
+static int zx279133_flow_slot_alloc(struct zx279133_flow_offload *offload,
+				    struct zx279133_flow_entry *entry,
+				    u8 selector)
+{
+	int ret;
+
+	if (!entry->full ||
+	    offload->fast_full_zcam_used < ZX279133_FAST_FULL_ZCAM_LIMIT) {
+		ret = zte_nppt_zcam_alloc(offload->np, entry->key, selector,
+					  &entry->zblock, &entry->zcell,
+					  &entry->zaddr);
+		if (!ret) {
+			if (entry->full)
+				offload->fast_full_zcam_used++;
+			return 0;
+		}
+		if (!entry->full)
+			return ret;
+	}
+
+	ret = zx279133_ddr_alloc(offload, entry, selector);
+	if (ret != -ENOSPC)
+		return ret;
+
+	/* The external table has one 512-bit slot per CRC32 result.  Resolve a
+	 * collision through the ZCAM's 4 blocks x 5 CRC16 candidates.
+	 */
+	ret = zte_nppt_zcam_alloc(offload->np, entry->key, selector,
+				  &entry->zblock, &entry->zcell, &entry->zaddr);
+	if (!ret)
+		offload->fast_full_zcam_used++;
+
+	return ret;
+}
+
+static void zx279133_flow_slot_release(struct zx279133_flow_offload *offload,
+				       const struct zx279133_flow_entry *entry)
+{
+	if (entry->in_ddr) {
+		__clear_bit(entry->ddr_bucket, offload->ddr_used);
+		offload->ddr_entries--;
+		return;
+	}
+
+	zte_nppt_zcam_release(offload->np, entry->zblock, entry->zcell, entry->zaddr);
+	if (entry->full)
+		offload->fast_full_zcam_used--;
+}
+
+/*
+ * As np.ko's fast_table_write(): a multi entry, whose response starts in the
+ * IKEY table, while the ZCAM and the 4096 IKEYs have room, else a full SDT14
+ * entry, which can overflow into the DDR bulk. The LAN entry program adds a
+ * PPPoE header from either.
+ */
+static int zx279133_flow_storage_alloc(struct zx279133_flow_offload *offload,
+				       struct zx279133_flow_entry *entry)
+{
+	int ret;
+
+	if (!entry->full) {
+		ret = zx279133_flow_slot_alloc(offload, entry,
+					       ZX279133_FAST_MULTI_SELECTOR);
+		if (!ret) {
+			ret = zx279133_fast_index_alloc(offload->ikey_used,
+							ZX279133_FAST_IKEY_DEPTH,
+							&entry->ikey);
+			if (!ret)
+				return 0;
+			zx279133_flow_slot_release(offload, entry);
+		}
+		if (ret != -ENOSPC)
+			return ret;
+		entry->full = true;
+	}
+
+	return zx279133_flow_slot_alloc(offload, entry,
+					ZX279133_FAST_FULL_SELECTOR);
+}
+
+static int zx279133_flow_table_write(struct zx279133_flow_offload *offload,
+				     const struct zx279133_flow_entry *entry,
+				     const u32 *table, unsigned int words)
+{
+	if (entry->in_ddr) {
+		return zte_nppt_ddr_write(offload->np, entry->ddr_bucket, table);
+	}
+
+	return zte_nppt_zcam_write(offload->np, entry->zblock, entry->zcell,
+				    entry->zaddr, table, words);
+}
+
+static void zx279133_put_ipv4(u8 *dst, __be32 addr)
+{
+	put_unaligned(be32_to_cpu(addr), (u32 *)dst);
+}
+
+static void zx279133_fast_key_build(u8 *key,
+				    const struct zx279133_flow_tuple *tuple,
+				    u8 ip_proto)
+{
+	memset(key, 0, ZX279133_FAST_KEY_SIZE);
+	put_unaligned(ntohs(tuple->dst_port), (u16 *)(key + 3));
+	put_unaligned(ntohs(tuple->src_port), (u16 *)(key + 5));
+	zx279133_put_ipv4(key + 7, tuple->dst_addr);
+	zx279133_put_ipv4(key + 11, tuple->src_addr);
+	key[15] = ip_proto;
+}
+
+static u16 zx279133_vlan_egress_vid(const struct zx279133_flow_data *data)
+{
+	if (data->vlan.edit == ZX_VLAN_POP)
+		return 0;
+	if (data->vlan.edit == ZX_VLAN_PUSH || data->vlan.edit == ZX_VLAN_REPLACE)
+		return data->vlan.tci & VLAN_VID_MASK;
+	return data->vlan.tagged ? data->vlan.vid : 0;
+}
+
+static void zx279133_fast_key_vid(u8 *key, u16 vid)
+{
+	/* R16: query tail 00:VIDhi:VIDlo is Linux key VIDlo:VIDhi:00. */
+	put_unaligned_le16(vid, key);
+}
+
+#define ZX279133_IPV6_CRC_POLY		0x04c11db7
+
+static u32 zx279133_ipv6_crc32(u32 crc, const u8 *data, size_t len)
+{
+	int bit;
+
+	while (len--) {
+		crc ^= (u32)*data++ << 24;
+		for (bit = 0; bit < 8; bit++)
+			crc = crc & BIT(31) ?
+				(crc << 1) ^ ZX279133_IPV6_CRC_POLY : crc << 1;
+	}
+
+	return crc;
+}
+
+static void zx279133_fast_key_build_v6(u8 *key,
+				       const struct zx279133_flow_data *data,
+				       u8 ip_proto)
+{
+	u32 crc;
+
+	memset(key, 0, ZX279133_FAST_KEY_SIZE);
+	put_unaligned(ntohs(data->tuple.dst_port), (u16 *)(key + 3));
+	put_unaligned(ntohs(data->tuple.src_port), (u16 *)(key + 5));
+
+	/* SPA full-tuple mode covers destination then source for DIP32 and
+	 * source then destination for SIP32, using big-endian CRC-32.
+	 */
+	crc = zx279133_ipv6_crc32(0, data->dst_v6.s6_addr, sizeof(data->dst_v6));
+	crc = zx279133_ipv6_crc32(crc, data->src_v6.s6_addr, sizeof(data->src_v6));
+	put_unaligned(crc, (u32 *)(key + 7));
+	crc = zx279133_ipv6_crc32(0, data->src_v6.s6_addr, sizeof(data->src_v6));
+	crc = zx279133_ipv6_crc32(crc, data->dst_v6.s6_addr, sizeof(data->dst_v6));
+	put_unaligned(crc, (u32 *)(key + 11));
+	key[15] = ip_proto;
+}
+
+/*
+ * The key the reply of an upstream flow is looked up with: the translated
+ * tuple with source and destination exchanged.
+ */
+static void zx279133_fast_reply_key_build(u8 *key,
+					  const struct zx279133_flow_data *data,
+					  const struct zx279133_flow_tuple *xlate,
+					  u8 ip_proto, bool ipv6, u16 vid)
+{
+	struct zx279133_flow_data reply = {};
+
+	reply.tuple.src_addr = xlate->dst_addr;
+	reply.tuple.dst_addr = xlate->src_addr;
+	reply.tuple.src_port = xlate->dst_port;
+	reply.tuple.dst_port = xlate->src_port;
+	if (ipv6) {
+		reply.src_v6 = data->dst_v6;
+		reply.dst_v6 = data->src_v6;
+		zx279133_fast_key_build_v6(key, &reply, ip_proto);
+	} else {
+		zx279133_fast_key_build(key, &reply.tuple, ip_proto);
+		zx279133_fast_key_vid(key, vid);
+	}
+}
+
+/* The two callbacks describe opposite wire domains, not necessarily the
+ * same VID. Match ingress(A) to egress(B) and egress(A) to ingress(B).
+ */
+static bool zx279133_flow_vlan_peer_matches(const struct zx279133_flow_data *data,
+					   const struct zx279133_flow_data *peer,
+					   bool wan_vid_key)
+{
+	return zx279133_vlan_egress_vid(data) ==
+			(peer->vlan.tagged ? peer->vlan.vid : 0) &&
+		(!wan_vid_key || zx279133_vlan_egress_vid(peer) ==
+			(data->vlan.tagged ? data->vlan.vid : 0));
+}
+
+static void zx279133_fast_response_build(u8 *fast,
+					 const struct zx279133_flow_data *data,
+					 const struct zx279133_flow_tuple *xlate,
+					 enum zx279133_flow_port ingress,
+					 enum zx279133_flow_port egress,
+					 u16 gemport, u16 ikey, u16 stat,
+					 bool has_stat, bool pppoe, u8 wanid)
+{
+	int i;
+
+	/* The response stores MAC addresses and IPv4 values least-significant
+	 * byte first, exactly as np.ko's fast_hashinfo_set() emits them.
+	 */
+	memset(fast, 0, ZX279133_FAST_DATA_SIZE);
+	if (pppoe)
+		put_unaligned(4, (u32 *)(fast + 16));
+	put_unaligned(stat, (u16 *)(fast + 2));
+	for (i = 0; i < ETH_ALEN; i++)
+		fast[8 + i] = data->eth.h_dest[ETH_ALEN - 1 - i];
+
+	put_unaligned(gemport, (u16 *)(fast + 20));
+	/* Bits 4:0 select the WANID entry that supplies the source MAC. */
+	fast[23] = wanid;
+	put_unaligned(ikey, (u16 *)(fast + 26));
+	if (has_stat)
+		fast[29] |= BIT(4);
+	fast[30] = BIT(5) | BIT(4) | BIT(3);
+	if (ingress == ZX279133_FLOW_PORT_LAN) {
+		/*
+		 * The LAN entry program has already removed the RTL8372N
+		 * transport tag. In the default response only a PPPoE push changes
+		 * its length (eight bytes, stored halved); a requested user VLAN
+		 * push is applied below.
+		 * wan_mode (bit 1) sends it out the WAN path, where the push
+		 * takes the session from the WANID entry and the frame leaves
+		 * by the port at byte 20, a LAN port too. Without it the egress
+		 * port is cleared and the frame is lost, whichever port it is
+		 * for.
+		 */
+		put_unaligned(pppoe ? 4 : 0, (u32 *)(fast + 16));
+		fast[29] |= BIT(1);
+	}
+	/*
+	 * np.ko fast_hashinfo_set(): action 1 at byte 30 [7:6] inserts an
+	 * 802.1Q tag and byte 24 holds its TCI. Keep the OEM software response's
+	 * abs(delta)/2 field too; its low bits are not part of the packed entry.
+	 */
+	zx279133_vlan_response(fast, &data->vlan);
+	if (data->police_set)
+		zx279133_meter_response(fast, data->meter_bucket);
+
+	/* The OEM response has an eight-bit replacement, not a DSCP mask. */
+	if (data->traffic_class_set) {
+		fast[22] = data->traffic_class;
+		fast[29] |= BIT(6);
+	}
+
+	if (xlate->src_addr != data->tuple.src_addr)
+		fast[29] |= BIT(7);
+	if (xlate->dst_addr != data->tuple.dst_addr) {
+		zx279133_put_ipv4(fast + 4, xlate->dst_addr);
+		fast[30] |= BIT(0);
+	}
+	/*
+	 * The port on the WAN side is always written, as np.ko does. Between
+	 * two LAN ports either side may be translated, when one of them is a
+	 * second WAN.
+	 */
+	if (ingress == ZX279133_FLOW_PORT_LAN ||
+	    xlate->src_port != data->tuple.src_port) {
+		put_unaligned(ntohs(xlate->src_port), (u16 *)fast);
+		fast[30] |= BIT(1);
+	}
+	if (ingress == ZX279133_FLOW_PORT_WAN ||
+	    xlate->dst_port != data->tuple.dst_port) {
+		put_unaligned(ntohs(xlate->dst_port), (u16 *)(fast + 14));
+		fast[30] |= BIT(2);
+	}
+}
+
+static void zx279133_fast_multi_table_build(u32 *table, const u8 *fast,
+					    const u8 *key, u32 age)
+{
+	u8 packed[18] = {};
+	u8 *bytes = (u8 *)table;
+	u32 tail;
+	int i;
+
+	/* fast_table_write() packs response bytes 17..31 around the age index. */
+	for (i = 0; i < 14; i++) {
+		packed[i] |= (fast[17 + i] & 0x3) << 6;
+		packed[i + 1] |= fast[17 + i] >> 2;
+	}
+	tail = (u32)age << 8 | (fast[31] & 0x3) << 6 |
+	       (u32)(fast[31] & ~0x3) << 24;
+	packed[14] |= tail;
+	packed[15] = tail >> 8;
+	packed[16] = tail >> 16;
+	packed[17] = tail >> 24;
+
+	memset(table, 0, ZX279133_ZCAM_ENTRY_SIZE / 2);
+	memcpy(bytes, packed + 3, 15);
+	memcpy(bytes + 15, key, ZX279133_FAST_KEY_SIZE);
+	bytes[31] = ZX279133_FAST_MULTI_FOOTER;
+}
+
+static void zx279133_fast_full_table_build(u32 *table, const u8 *fast,
+					   const u8 *key, u32 age)
+{
+	u32 response[ZX279133_FAST_DATA_SIZE / sizeof(u32)];
+	u8 packed[ZX279133_FAST_DATA_SIZE + 3] = {};
+	u8 *bytes = (u8 *)table;
+	u8 *response_bytes = (u8 *)response;
+	unsigned int i;
+	u32 tail;
+
+	/* fast_table_write() applies this conversion and the 18-bit age prefix
+	 * before its age-enabled SDT14 fallback.
+	 */
+	memcpy(response, fast, sizeof(response));
+	swap(response[0], response[4]);
+	response_bytes[26] = 0;
+	response_bytes[27] &= 0xe0;
+	for (i = 0; i < ZX279133_FAST_DATA_SIZE - 1; i++) {
+		packed[i] |= (response_bytes[i] & 0x3) << 6;
+		packed[i + 1] |= response_bytes[i] >> 2;
+	}
+	tail = (age & GENMASK(17, 0)) << 13 |
+	       (response_bytes[31] & GENMASK(6, 0)) << 6;
+	for (i = 0; i < sizeof(tail); i++)
+		packed[31 + i] += tail >> (8 * i);
+	memset(table, 0, ZX279133_ZCAM_ENTRY_SIZE);
+	memcpy(bytes + 15, packed + 3, ZX279133_FAST_DATA_SIZE);
+	memcpy(bytes + 47, key, ZX279133_FAST_KEY_SIZE);
+	bytes[63] = ZX279133_FAST_FULL_FOOTER;
+}
+
+static void zx279133_flow_mangle_eth(const struct flow_action_entry *act,
+				     struct ethhdr *eth)
+{
+	u8 *dest = (u8 *)eth + act->mangle.offset;
+	const u8 *src = (const u8 *)&act->mangle.val;
+
+	if (act->mangle.offset > 8)
+		return;
+	if (act->mangle.mask == 0xffff) {
+		src += 2;
+		dest += 2;
+	}
+	memcpy(dest, src, act->mangle.mask ? 2 : 4);
+}
+
+static int zx279133_flow_mangle_ports(const struct flow_action_entry *act,
+				      struct zx279133_flow_tuple *tuple)
+{
+	u32 val = ntohl(act->mangle.val);
+
+	switch (act->mangle.offset) {
+	case 0:
+		if (act->mangle.mask == ~htonl(0xffff))
+			tuple->dst_port = cpu_to_be16(val);
+		else
+			tuple->src_port = cpu_to_be16(val >> 16);
+		break;
+	case 2:
+		tuple->dst_port = cpu_to_be16(val);
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	return 0;
+}
+
+static int zx279133_flow_mangle_ipv4(const struct flow_action_entry *act,
+				     struct zx279133_flow_tuple *tuple)
+{
+	__be32 *addr;
+
+	switch (act->mangle.offset) {
+	case offsetof(struct iphdr, saddr):
+		addr = &tuple->src_addr;
+		break;
+	case offsetof(struct iphdr, daddr):
+		addr = &tuple->dst_addr;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	memcpy(addr, &act->mangle.val, sizeof(*addr));
+
+	return 0;
+}
+
+static int
+zx279133_flow_mangle_class(const struct flow_action_entry *act,
+			   struct zx279133_flow_data *data, bool ipv6,
+			   struct netlink_ext_ack *extack)
+{
+	u32 field = ipv6 ? 0x0ff00000 : 0x00ff0000;
+	u32 val = ntohl(act->mangle.val);
+
+	/* Do not silently clear ECN for a DSCP-only pedit. */
+	if (act->mangle.mask != ~htonl(field) || (val & ~field)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "NPPT requires a full eight-bit ToS/traffic-class rewrite");
+		return -EOPNOTSUPP;
+	}
+	data->traffic_class = val >> (ipv6 ? 20 : 16);
+	data->traffic_class_set = true;
+	return 0;
+}
+
+static int zx279133_flow_vlan_push(const struct flow_action_entry *act,
+				   struct zx279133_flow_data *data,
+				   struct netlink_ext_ack *extack)
+{
+	if (data->vlan_push || act->vlan.proto != htons(ETH_P_8021Q) ||
+	    act->vlan.vid >= VLAN_VID_MASK || act->vlan.prio > 7) {
+		NL_SET_ERR_MSG_MOD(extack, "NPPT supports one 802.1Q egress tag");
+		return -EOPNOTSUPP;
+	}
+	data->vlan_push = true;
+	data->vlan_tci = act->vlan.vid | (act->vlan.prio << VLAN_PRIO_SHIFT);
+	if (zx279133_vlan_edit(&data->vlan, ZX_VLAN_PUSH, data->vlan_tci,
+			       be16_to_cpu(act->vlan.proto)))
+		return -EOPNOTSUPP;
+	return 0;
+}
+
+static int
+zx279133_flow_parse(struct zx279133_flow_offload *offload,
+		    struct net_device *bind_dev, struct flow_cls_offload *f,
+		    struct zx279133_flow_data *data,
+		    struct zx279133_flow_tuple *xlate,
+		    enum zx279133_flow_port *ingress,
+		    enum zx279133_flow_port *egress, u16 *gemport,
+		    u8 *ip_proto, u16 *pppoe_sid, bool *ipv6)
+{
+	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+	struct flow_match_ipv4_addrs addrs;
+	struct flow_match_ipv6_addrs addrs6;
+	struct flow_match_control control;
+	struct flow_match_basic basic;
+	struct flow_match_ports ports;
+	struct flow_match_meta meta;
+	struct flow_match_tcp tcp;
+	struct flow_action_entry *act;
+	struct net_device *idev;
+	struct net_device *odev = NULL;
+	bool vlan_inner_ipv4 = false;
+	u16 igemport;
+	int i, ret;
+	const u64 supported_keys = BIT_ULL(FLOW_DISSECTOR_KEY_CONTROL) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_BASIC) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_IPV4_ADDRS) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_IPV6_ADDRS) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_PORTS) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_TCP) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_META) |
+		BIT_ULL(FLOW_DISSECTOR_KEY_VLAN);
+
+	/* Normalize exact VID policy first; do not equate SDT0 with a VID key. */
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN)) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT stacked VLAN classification is unsupported");
+		return -EOPNOTSUPP;
+	}
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN)) {
+		struct flow_match_vlan vlan;
+
+		flow_rule_match_vlan(rule, &vlan);
+		ret = zx279133_vlan_match(&data->vlan, true, vlan.key->vlan_id,
+					  vlan.mask->vlan_id);
+		if (ret)
+			return ret;
+		if (!zx279133_vlan_enabled(offload->np) || !data->vlan.vid ||
+		    vlan.mask->vlan_priority || vlan.mask->vlan_dei ||
+		    vlan.mask->vlan_tpid != htons(0xffff) ||
+		    vlan.key->vlan_tpid != htons(ETH_P_8021Q) ||
+		    (vlan.mask->vlan_eth_type &&
+		     (vlan.mask->vlan_eth_type != htons(0xffff) ||
+		      vlan.key->vlan_eth_type != htons(ETH_P_IP)))) {
+			NL_SET_ERR_MSG_MOD(f->common.extack,
+				"NPPT VLAN offload requires active VID keys, exact nonzero VID, IPv4 and no PCP/DEI match");
+			return -EOPNOTSUPP;
+		}
+		vlan_inner_ipv4 = vlan.mask->vlan_eth_type == htons(0xffff) &&
+				  vlan.key->vlan_eth_type == htons(ETH_P_IP);
+	}
+	if (rule->match.dissector->used_keys & ~supported_keys) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "unsupported NPPT match key");
+		return -EOPNOTSUPP;
+	}
+	if (f->common.chain_index) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT supports only chain zero");
+		return -EOPNOTSUPP;
+	}
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_TCP)) {
+		flow_rule_match_tcp(rule, &tcp);
+		/* The fast path excludes FIN/RST; it cannot classify TCP flags. */
+		if (tcp.key->flags ||
+		    tcp.mask->flags != cpu_to_be16(be32_to_cpu(TCP_FLAG_RST |
+							    TCP_FLAG_FIN) >> 16)) {
+			NL_SET_ERR_MSG_MOD(f->common.extack, "unsupported NPPT TCP flag match");
+			return -EOPNOTSUPP;
+		}
+	}
+
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC) ||
+	    (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS) &&
+	     !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV6_ADDRS)) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS)) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "incomplete IP/transport match");
+		return -EOPNOTSUPP;
+	}
+
+	idev = bind_dev;
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META)) {
+		flow_rule_match_meta(rule, &meta);
+		rcu_read_lock();
+		idev = dev_get_by_index_rcu(dev_net(bind_dev),
+					    meta.key->ingress_ifindex);
+		*ingress = zte_nppt_dev_port(offload->np, idev,
+						  &igemport);
+		rcu_read_unlock();
+	} else {
+		*ingress = zte_nppt_dev_port(offload->np, idev,
+						  &igemport);
+	}
+	if (*ingress == ZX279133_FLOW_PORT_NONE) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "unsupported ingress device");
+		return -EOPNOTSUPP;
+	}
+
+	flow_rule_match_control(rule, &control);
+	if (flow_rule_has_control_flags(control.mask->flags, f->common.extack))
+		return -EOPNOTSUPP;
+	switch (control.key->addr_type) {
+	case FLOW_DISSECTOR_KEY_IPV4_ADDRS:
+		*ipv6 = false;
+		break;
+	case FLOW_DISSECTOR_KEY_IPV6_ADDRS:
+		*ipv6 = true;
+		break;
+	default:
+		NL_SET_ERR_MSG_MOD(f->common.extack, "unsupported address family");
+		return -EOPNOTSUPP;
+	}
+
+	flow_rule_match_basic(rule, &basic);
+	if ((basic.key->n_proto != htons(*ipv6 ? ETH_P_IPV6 : ETH_P_IP) &&
+	     !(data->vlan.tagged && vlan_inner_ipv4 && !*ipv6 &&
+	       basic.key->n_proto == htons(ETH_P_8021Q))) ||
+	    basic.mask->n_proto != htons(0xffff) ||
+	    basic.mask->ip_proto != 0xff ||
+	    (basic.key->ip_proto != IPPROTO_TCP &&
+	     basic.key->ip_proto != IPPROTO_UDP)) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "only exact IPv4/IPv6 TCP/UDP");
+		return -EOPNOTSUPP;
+	}
+	*ip_proto = basic.key->ip_proto;
+
+	if (*ipv6) {
+		flow_rule_match_ipv6_addrs(rule, &addrs6);
+		if (memchr_inv(&addrs6.mask->src, 0xff,
+			       sizeof(addrs6.mask->src)) ||
+		    memchr_inv(&addrs6.mask->dst, 0xff,
+			       sizeof(addrs6.mask->dst))) {
+			NL_SET_ERR_MSG_MOD(f->common.extack, "IPv6 address masks must be exact");
+			return -EOPNOTSUPP;
+		}
+		data->src_v6 = addrs6.key->src;
+		data->dst_v6 = addrs6.key->dst;
+	} else {
+		flow_rule_match_ipv4_addrs(rule, &addrs);
+		if (addrs.mask->src != htonl(~0U) ||
+		    addrs.mask->dst != htonl(~0U)) {
+			NL_SET_ERR_MSG_MOD(f->common.extack, "IPv4 address masks must be exact");
+			return -EOPNOTSUPP;
+		}
+		data->tuple.src_addr = addrs.key->src;
+		data->tuple.dst_addr = addrs.key->dst;
+	}
+
+	flow_rule_match_ports(rule, &ports);
+	if (ports.mask->src != htons(0xffff) ||
+	    ports.mask->dst != htons(0xffff)) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "transport port masks must be exact");
+		return -EOPNOTSUPP;
+	}
+	data->tuple.src_port = ports.key->src;
+	data->tuple.dst_port = ports.key->dst;
+	*xlate = data->tuple;
+
+	flow_action_for_each(i, act, &rule->action) {
+		switch (act->id) {
+		case FLOW_ACTION_MANGLE:
+			if (act->mangle.htype == FLOW_ACT_MANGLE_HDR_TYPE_ETH)
+				zx279133_flow_mangle_eth(act, &data->eth);
+			break;
+		case FLOW_ACTION_REDIRECT:
+			odev = act->dev;
+			break;
+		case FLOW_ACTION_CSUM:
+			break;
+		case FLOW_ACTION_PPPOE_PUSH:
+			if (*pppoe_sid || !act->pppoe.sid) {
+				NL_SET_ERR_MSG_MOD(f->common.extack, "invalid PPPoE push action");
+				return -EOPNOTSUPP;
+			}
+			*pppoe_sid = act->pppoe.sid;
+			break;
+		case FLOW_ACTION_VLAN_PUSH:
+			ret = zx279133_flow_vlan_push(act, data, f->common.extack);
+			if (ret)
+				return ret;
+			break;
+		case FLOW_ACTION_VLAN_POP:
+			if (!zx279133_vlan_enabled(offload->np))
+				return -EOPNOTSUPP;
+			ret = zx279133_vlan_edit(&data->vlan, ZX_VLAN_POP, 0, 0);
+			if (ret)
+				return ret;
+			break;
+		case FLOW_ACTION_VLAN_MANGLE:
+			if (!zx279133_vlan_enabled(offload->np) ||
+			    act->vlan.vid >= VLAN_VID_MASK || act->vlan.prio > 7)
+				return -EOPNOTSUPP;
+			ret = zx279133_vlan_edit(&data->vlan, ZX_VLAN_REPLACE,
+				act->vlan.vid | (act->vlan.prio << VLAN_PRIO_SHIFT),
+				be16_to_cpu(act->vlan.proto));
+			if (ret)
+				return ret;
+			data->vlan_push = true;
+			data->vlan_tci = data->vlan.tci;
+			break;
+		case FLOW_ACTION_POLICE:
+			if (!READ_ONCE(experimental_police)) {
+				NL_SET_ERR_MSG_MOD(f->common.extack,
+						   "NPPT police requires experimental_police and calibrated token units");
+				return -EOPNOTSUPP;
+			}
+			if (data->police_set || act->police.rate_pkt_ps ||
+			    act->police.peakrate_bytes_ps || act->police.avrate ||
+			    act->police.overhead ||
+			    (act->police.mtu && act->police.mtu < U16_MAX) ||
+			    act->police.burst_pkt ||
+			    act->police.exceed.act_id != FLOW_ACTION_DROP ||
+			    act->police.notexceed.act_id != FLOW_ACTION_PIPE) {
+				NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT experimental police supports byte rate drop/pipe only");
+				return -EOPNOTSUPP;
+			}
+			ret = zx279133_police_tokens(act->police.rate_bytes_ps,
+						     act->police.burst, police_unit_bps,
+						     police_burst_unit,
+						     &data->police);
+			if (ret) {
+				NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT police rate/burst cannot be represented");
+				return ret;
+			}
+			data->police_index = act->hw_index;
+			data->police_set = true;
+			break;
+		case FLOW_ACTION_PRIORITY:
+			NL_SET_ERR_MSG_MOD(f->common.extack,
+					   "NPPT egress queue mapping is not implemented");
+			return -EOPNOTSUPP;
+		default:
+			NL_SET_ERR_MSG_MOD(f->common.extack, "unsupported flow action");
+			return -EOPNOTSUPP;
+		}
+	}
+
+	if (!odev || !is_valid_ether_addr(data->eth.h_source) ||
+	    !is_valid_ether_addr(data->eth.h_dest)) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "missing redirect or Ethernet rewrite");
+		return -EOPNOTSUPP;
+	}
+	/*
+	 * Besides LAN <-> WAN, a flow may be routed between two LAN ports,
+	 * as when one of them serves as a second WAN.
+	 */
+	*egress = zte_nppt_dev_port(offload->np, odev, gemport);
+	if (*egress == ZX279133_FLOW_PORT_NONE || !*gemport ||
+	    (*ingress == ZX279133_FLOW_PORT_WAN &&
+	     *egress == ZX279133_FLOW_PORT_WAN)) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "unsupported egress or WAN-to-WAN path");
+		return -EOPNOTSUPP;
+	}
+	if (*pppoe_sid && *ingress != ZX279133_FLOW_PORT_LAN) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "PPPoE push requires LAN ingress");
+		return -EOPNOTSUPP;
+	}
+	if (data->vlan.tagged &&
+	    (*ipv6 || *pppoe_sid || *ingress == *egress ||
+	     (*ingress == ZX279133_FLOW_PORT_WAN &&
+	      !zx279133_wan_vlan_enabled(offload->np)))) {
+		NL_SET_ERR_MSG_MOD(f->common.extack,
+			"NPPT VLAN ingress requires IPv4 LAN/WAN routing and the direction's VID key");
+		return -EOPNOTSUPP;
+	}
+	if (data->vlan_push &&
+	    (!zte_nppt_is_wan(offload->np, odev) ||
+	     *ingress != ZX279133_FLOW_PORT_LAN || *pppoe_sid) &&
+	    !(zx279133_vlan_enabled(offload->np) && !*ipv6 && !*pppoe_sid &&
+	      *ingress == ZX279133_FLOW_PORT_WAN && *egress == ZX279133_FLOW_PORT_LAN &&
+	      (data->vlan_tci & VLAN_VID_MASK))) {
+		NL_SET_ERR_MSG_MOD(f->common.extack,
+				   "NPPT VLAN push requires plain LAN-to-physical-WAN routing");
+		return -EOPNOTSUPP;
+	}
+
+	flow_action_for_each(i, act, &rule->action) {
+		if (act->id != FLOW_ACTION_MANGLE)
+			continue;
+		switch (act->mangle.htype) {
+		case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
+			ret = 0;
+			break;
+		case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
+			if (*ipv6)
+				ret = -EOPNOTSUPP;
+			else if (!act->mangle.offset)
+				ret = zx279133_flow_mangle_class(act, data, false,
+								 f->common.extack);
+			else
+				ret = zx279133_flow_mangle_ipv4(act, xlate);
+			break;
+		case FLOW_ACT_MANGLE_HDR_TYPE_IP6:
+			if (*ipv6 && act->mangle.offset >= 8 &&
+			    act->mangle.offset <= 36 &&
+			    !(act->mangle.offset & 3)) {
+				NL_SET_ERR_MSG_MOD(f->common.extack,
+					"NPPT NAT66 address rewrite needs an extended response backend");
+				return -EOPNOTSUPP;
+			}
+			ret = *ipv6 && !act->mangle.offset ?
+				zx279133_flow_mangle_class(act, data, true,
+							   f->common.extack) :
+				-EOPNOTSUPP;
+			break;
+		case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+		case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+			ret = zx279133_flow_mangle_ports(act, xlate);
+			break;
+		default:
+			ret = -EOPNOTSUPP;
+		}
+		if (ret) {
+			NL_SET_ERR_MSG_WEAK_MOD(f->common.extack, "unsupported header rewrite");
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int zx279133_flow_peer_validate(const struct zx279133_flow_entry *peer,
+				       const struct flow_block *fblock,
+				       bool flowtable,
+				       struct netlink_ext_ack *extack)
+{
+	if (!peer || peer->retired) {
+		NL_SET_ERR_MSG_MOD(extack, "waiting for upstream NPPT peer");
+		return -EAGAIN;
+	}
+	if (peer->stale) {
+		NL_SET_ERR_MSG_MOD(extack, "upstream NPPT peer awaits failed-delete recovery");
+		return -EIO;
+	}
+	/* TC's two ingress qdiscs have different blocks. Preserve that supported
+	 * manual rule path, but never borrow a peer from another flowtable or
+	 * across the TC/flowtable boundary.
+	 */
+	if (peer->refused || peer->flowtable != flowtable ||
+	    (flowtable && peer->fblock != fblock)) {
+		NL_SET_ERR_MSG_MOD(extack, "NPPT peer is refused or belongs to another flow block");
+		return -EOPNOTSUPP;
+	}
+	return 0;
+}
+
+static bool zx279133_flow_key_exists(struct zx279133_flow_offload *offload,
+				     const u8 *key)
+{
+	return rhashtable_lookup_fast(&offload->key_flows, key,
+				      zx279133_flow_key_ht_params);
+}
+
+static bool zx279133_flow_spec_equal(const struct zx279133_flow_spec *a,
+				     const struct zx279133_flow_spec *b)
+{
+	return !memcmp(&a->data.eth, &b->data.eth, sizeof(a->data.eth)) &&
+	       !memcmp(&a->data.tuple, &b->data.tuple, sizeof(a->data.tuple)) &&
+	       !memcmp(&a->data.src_v6, &b->data.src_v6, sizeof(a->data.src_v6)) &&
+	       !memcmp(&a->data.dst_v6, &b->data.dst_v6, sizeof(a->data.dst_v6)) &&
+	       a->data.police_set == b->data.police_set &&
+	       a->data.police_index == b->data.police_index &&
+	       a->data.police.cir == b->data.police.cir &&
+	       a->data.police.cbs == b->data.police.cbs &&
+	       a->data.vlan.vid == b->data.vlan.vid &&
+	       a->data.vlan.tagged == b->data.vlan.tagged &&
+	       a->data.vlan.edit == b->data.vlan.edit &&
+	       a->data.vlan.tci == b->data.vlan.tci &&
+	       a->data.vlan_tci == b->data.vlan_tci &&
+	       a->data.vlan_push == b->data.vlan_push &&
+	       a->data.traffic_class == b->data.traffic_class &&
+	       a->data.traffic_class_set == b->data.traffic_class_set &&
+	       !memcmp(&a->xlate, &b->xlate, sizeof(a->xlate)) &&
+	       a->ingress == b->ingress && a->egress == b->egress &&
+	       a->gemport == b->gemport && a->pppoe_sid == b->pppoe_sid &&
+	       a->ip_proto == b->ip_proto && a->ipv6 == b->ipv6;
+}
+
+/*
+ * A flow counter adds up the frame on the WAN side, from the MAC header
+ * through the FCS, with the PPPoE header of a session: IP + 18, or IP + 26,
+ * measured in both directions. nf_flow_table, like conntrack and the devices
+ * it passes the counts on to, counts the IP packet.
+ */
+static u64 zx279133_flow_ip_bytes(const struct zx279133_flow_entry *entry,
+				  u64 packets, u64 bytes)
+{
+	u64 frame = ETH_HLEN + ETH_FCS_LEN;
+
+	if (entry->pppoe)
+		frame += PPPOE_SES_HLEN;
+	if (entry->wan_vlan)
+		frame += VLAN_HLEN;
+	frame *= packets;
+
+	return bytes > frame ? bytes - frame : 0;
+}
+
+#include "zx279133-shared-stats.h"
+
+/* Baselines advance only after a successful read; also used after invalidation. */
+static int zx279133_flow_counter_collect(struct zx279133_flow_offload *offload,
+					 struct zx279133_flow_entry *entry,
+					 struct flow_stats *stats, bool final)
+{
+	u64 packets = entry->packets, bytes = entry->bytes;
+	int ret;
+
+	if (entry->stat_group)
+		return zx279133_stat_group_collect(offload, entry, stats, final);
+	if (entry->has_stat) {
+		ret = zte_nppt_stats_read(offload->np, entry->stat, &packets, &bytes);
+		if (ret)
+			return ret;
+	}
+	/* A reset must not turn a smaller counter into an unsigned huge delta. */
+	if (packets < entry->packets || bytes < entry->bytes)
+		return -EIO;
+	if (packets != entry->packets || bytes != entry->bytes)
+		entry->lastused = jiffies;
+	flow_stats_update(stats,
+			  zx279133_flow_ip_bytes(entry, packets - entry->packets,
+						 bytes - entry->bytes),
+			  packets - entry->packets, 0, entry->lastused,
+			  FLOW_ACTION_HW_STATS_DELAYED);
+	entry->packets = packets;
+	entry->bytes = bytes;
+	return 0;
+}
+
+static int zx279133_flow_entry_remove(struct zx279133_flow_offload *offload,
+				      struct zx279133_flow_entry *entry,
+				      unsigned long cookie,
+				      struct flow_stats *stats, bool retire);
+
+static int zx279133_flow_entry_hw_clear(struct zx279133_flow_offload *offload,
+					const struct zx279133_flow_entry *entry);
+
+#include "zx279133-client-limits.h"
+
+static int zx279133_flow_replace(struct zx279133_flow_offload *offload,
+				 struct zx279133_flow_block *block,
+				 struct flow_cls_offload *f)
+{
+	struct net_device *bind_dev = block->ndev;
+	struct zx279133_wanid_profile profile = {};
+	struct zx279133_flow_tuple xlate;
+	struct zx279133_flow_data data = {};
+	struct zx279133_flow_entry *entry, *peer;
+	enum zx279133_flow_port ingress, egress;
+	u8 fast[ZX279133_FAST_DATA_SIZE];
+	u32 ikey[ZX279133_FAST_IKEY_SIZE / sizeof(u32)];
+	u32 table[ZX279133_ZCAM_ENTRY_SIZE / sizeof(u32)];
+	bool ipv6, pppoe, full, snat;
+	unsigned int table_words;
+	u16 gemport, pppoe_sid = 0;
+	u8 ip_proto;
+	int ret;
+
+	ret = zte_nppt_flow_ready(offload->np);
+	if (ret) {
+		NL_SET_ERR_MSG_MOD(f->common.extack,
+				   "NPPT topology synchronization pending or failed");
+		return ret;
+	}
+	ret = zx279133_flow_parse(offload, bind_dev, f, &data, &xlate,
+				  &ingress, &egress, &gemport, &ip_proto,
+				  &pppoe_sid, &ipv6);
+	if (ret) {
+		int remove_ret = 0;
+
+		/* An unsupported update must not leave its previous action active. */
+		mutex_lock(&offload->lock);
+		peer = xa_load(&offload->flows, f->cookie);
+		if (peer)
+			remove_ret = zx279133_flow_entry_remove(offload, peer,
+								f->cookie, &f->stats, false);
+		mutex_unlock(&offload->lock);
+		if (remove_ret) {
+			NL_SET_ERR_MSG_MOD(f->common.extack,
+					   "NPPT previous rule could not be removed");
+			return remove_ret;
+		}
+		return ret;
+	}
+
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "cannot allocate NPPT flow state");
+		return -ENOMEM;
+	}
+	if (ipv6)
+		zx279133_fast_key_build_v6(entry->key, &data, ip_proto);
+	else
+		zx279133_fast_key_build(entry->key, &data.tuple, ip_proto);
+	if (data.vlan.tagged)
+		zx279133_fast_key_vid(entry->key, data.vlan.vid);
+	snat = !ipv6 && xlate.src_addr != data.tuple.src_addr;
+	entry->spec = (struct zx279133_flow_spec) {
+		.data = data, .xlate = xlate, .ingress = ingress, .egress = egress,
+		.gemport = gemport, .pppoe_sid = pppoe_sid,
+		.ip_proto = ip_proto, .ipv6 = ipv6,
+	};
+#ifdef CONFIG_DEBUG_FS
+	{
+		struct zte_nppt_info info;
+
+		zte_nppt_get_info(offload->np, &info);
+		entry->debug_cookie = f->cookie;
+		entry->debug_generation = info.generation;
+	}
+#endif
+	entry->snat = snat;
+	entry->fblock = block->fblock;
+	entry->flowtable = block->flowtable;
+	entry->upstream = ingress == ZX279133_FLOW_PORT_LAN;
+	entry->lan_routed = ingress == ZX279133_FLOW_PORT_LAN &&
+			    egress == ZX279133_FLOW_PORT_LAN;
+	if (entry->upstream)
+		zx279133_fast_reply_key_build(entry->reply_key, &data, &xlate,
+					      ip_proto, ipv6,
+			zx279133_wan_vlan_enabled(offload->np) ?
+			zx279133_vlan_egress_vid(&data) : 0);
+
+	mutex_lock(&offload->lock);
+	peer = xa_load(&offload->flows, f->cookie);
+	if (peer) {
+		if (!peer->retired && peer->stale) {
+			NL_SET_ERR_MSG_MOD(f->common.extack,
+					   "NPPT rule awaits failed-delete recovery");
+			ret = -EIO;
+			goto out_free;
+		}
+		if (!peer->retired && peer->fblock == block->fblock &&
+		    zx279133_flow_spec_equal(&peer->spec, &entry->spec)) {
+			if (peer->refused)
+				NL_SET_ERR_MSG_MOD(f->common.extack,
+						   "PPPoE LAN route is unsupported");
+			ret = peer->refused ? -EOPNOTSUPP : 0;
+			goto out_free;
+		}
+		/*
+		 * Break before make: a changed rule is never acknowledged as the
+		 * previous action. On install failure Linux keeps the SW path.
+		 */
+		ret = zx279133_flow_entry_remove(offload, peer, f->cookie, &f->stats, false);
+		if (ret) {
+			NL_SET_ERR_MSG_MOD(f->common.extack,
+					   "NPPT changed rule awaits failed-delete recovery");
+			goto out_free;
+		}
+	}
+	/*
+	 * The hardware adds a PPPoE header only on the way out of the WAN
+	 * port: an entry for a session on a LAN port, a second WAN, is never
+	 * hit. Refuse it, but remember the flow, so that its other half,
+	 * which comes in PPPoE, is refused too.
+	 */
+	if (entry->lan_routed && pppoe_sid) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "PPPoE LAN route is unsupported");
+		entry->refused = true;
+		entry->pppoe = true;
+		ret = xa_err(xa_store(&offload->flows, f->cookie, entry,
+				      GFP_KERNEL));
+		if (ret) {
+			NL_SET_ERR_MSG_MOD(f->common.extack, "cannot remember refused PPPoE peer");
+			goto out_free;
+		}
+		entry->reply_indexed =
+			!rhashtable_lookup_insert_fast(&offload->reply_flows,
+						       &entry->reply_node,
+						       zx279133_flow_reply_ht_params);
+		entry = NULL;
+		ret = -EOPNOTSUPP;
+		goto out_free;
+	}
+	if (zx279133_flow_key_exists(offload, entry->key)) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT tuple owned by another flow");
+		ret = -EEXIST;
+		goto out_free;
+	}
+	if (entry->upstream && (data.vlan.tagged || data.vlan_push) &&
+	    rhashtable_lookup_fast(&offload->reply_flows, entry->reply_key,
+				  zx279133_flow_reply_ht_params)) {
+		NL_SET_ERR_MSG_MOD(f->common.extack,
+			"NPPT VLAN flow has an ambiguous reverse tuple");
+		ret = -EEXIST;
+		goto out_free;
+	}
+	if (entry->upstream) {
+		pppoe = pppoe_sid;
+		/*
+		 * The LAN entry program does not take a PPPoE header off
+		 * either: the frames of a PPPoE session on a LAN port miss the
+		 * flow table and reach the CPU. Their rule does not say it, but
+		 * the refused rule of the other half does.
+		 */
+		peer = entry->lan_routed && !pppoe ?
+			rhashtable_lookup_fast(&offload->reply_flows,
+					       entry->key,
+					       zx279133_flow_reply_ht_params) :
+			NULL;
+		if (peer && peer->pppoe) {
+			NL_SET_ERR_MSG_MOD(f->common.extack, "peer PPPoE LAN route is unsupported");
+			ret = -EOPNOTSUPP;
+			goto out_free;
+		}
+	} else {
+		/*
+		 * A downstream rule does not say whether its packets arrive
+		 * in PPPoE; the upstream rule of the same connection does,
+		 * by pushing it. Take the answer from that rule, and wait
+		 * while it is not in hardware yet: nf_flow_table offers this
+		 * rule again once its packets take the software path, by
+		 * then after the upstream half. Guessing instead breaks a
+		 * connection opened from the WAN, whose downstream half
+		 * comes first: the hardware matches PPPoE frames by the inner
+		 * tuple and would pass them to the LAN still encapsulated.
+		 */
+		peer = rhashtable_lookup_fast(&offload->reply_flows, entry->key,
+					      zx279133_flow_reply_ht_params);
+		ret = zx279133_flow_peer_validate(peer, block->fblock, block->flowtable,
+						  f->common.extack);
+		if (ret)
+			goto out_free;
+		if ((data.vlan.tagged || data.vlan_push ||
+		     peer->spec.data.vlan.tagged || peer->spec.data.vlan_push) &&
+		    !zx279133_flow_vlan_peer_matches(&data, &peer->spec.data,
+					 zx279133_wan_vlan_enabled(offload->np))) {
+			NL_SET_ERR_MSG_MOD(f->common.extack,
+				"NPPT VLAN reverse action does not match upstream VID");
+			ret = -EOPNOTSUPP;
+			goto out_free;
+		}
+		pppoe = peer->pppoe;
+	}
+	/* PPPoE pop stays out of the finite IKEY table in a full entry. */
+	entry->pppoe = pppoe;
+	/* Counters observe the WAN wire domain in both directions, including
+	 * a downstream POP/REPLACE whose egress no longer carries that tag.
+	 */
+	entry->wan_vlan = ingress == ZX279133_FLOW_PORT_WAN ?
+		data.vlan.tagged : egress == ZX279133_FLOW_PORT_WAN &&
+		zx279133_vlan_egress_vid(&data);
+	entry->full = pppoe && !entry->upstream;
+	entry->has_age = true;
+	if (data.vlan.tagged) {
+		entry->vlan_in = zte_nppt_vlan_get(offload->np, data.vlan.vid);
+		if (IS_ERR(entry->vlan_in)) {
+			ret = PTR_ERR(entry->vlan_in);
+			entry->vlan_in = NULL;
+			goto out_free;
+		}
+	}
+	if (zx279133_vlan_enabled(offload->np) &&
+	    zx279133_vlan_egress_vid(&data) &&
+	    (!data.vlan.tagged || zx279133_vlan_egress_vid(&data) != data.vlan.vid)) {
+		entry->vlan_out = zte_nppt_vlan_get(offload->np,
+						 zx279133_vlan_egress_vid(&data));
+		if (IS_ERR(entry->vlan_out)) {
+			ret = PTR_ERR(entry->vlan_out);
+			entry->vlan_out = NULL;
+			goto out_free;
+		}
+	}
+	ret = zx279133_flow_storage_alloc(offload, entry);
+	if (ret) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "cannot allocate NPPT flow/IKEY storage");
+		goto out_free;
+	}
+	full = entry->full;
+	ret = zx279133_fast_age_alloc(offload, &entry->age);
+	if (ret) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT aging table is full");
+		goto out_release_storage;
+	}
+	if (f->stats_scope.owner && f->stats_scope.get &&
+	    f->stats_scope.put && f->stats_scope.account) {
+		ret = zx279133_stat_group_get(offload, entry, &f->stats_scope);
+		if (ret) {
+			NL_SET_ERR_MSG_MOD(f->common.extack,
+				"NPPT endpoint accounting groups exhausted or unreadable");
+			goto out_release_age;
+		}
+	} else {
+		/* Non-flowtable callers retain upstream optional per-rule counters. */
+		ret = zx279133_fast_index_alloc(offload->stat_used,
+						ZX279133_FAST_STAT_DEPTH, &entry->stat);
+		if (!ret) {
+			entry->has_stat = true;
+			ret = zte_nppt_stats_read(offload->np, entry->stat,
+						 &entry->packets, &entry->bytes);
+			if (ret)
+				goto out_release_stat;
+		} else if (ret != -ENOSPC) {
+			goto out_release_age;
+		}
+	}
+	ether_addr_copy(profile.mac, data.eth.h_source);
+	if (snat)
+		profile.sip = be32_to_cpu(xlate.src_addr);
+	if (pppoe && entry->upstream) {
+		profile.pppoe = ZX279133_WANID_PPPOE_PUSH;
+		profile.sid = pppoe_sid;
+	} else if (pppoe) {
+		profile.pppoe = ZX279133_WANID_PPPOE_POP;
+	}
+	ret = zte_nppt_wanid_get(offload->np, !entry->upstream, &profile,
+				 &entry->wanid);
+	if (ret) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "cannot allocate NPPT WAN profile");
+		goto out_release_stat;
+	}
+	if (data.police_set) {
+		struct zte_nppt_plcr_timing timing;
+
+		ret = zte_nppt_native_plcr_timing_get(offload->np, &timing);
+		if (ret)
+			goto out_put_wanid;
+		if (timing.time_count != 62500 || timing.packet_length != 8000 ||
+		    timing.packet_offset != 24 || timing.loose_length != 16000) {
+			NL_SET_ERR_MSG_MOD(f->common.extack,
+					   "NPPT policer timing requires recalibration");
+			ret = -EOPNOTSUPP;
+			goto out_put_wanid;
+		}
+		ret = zte_nppt_meter_get(offload->np, &data.police, dev_net(block->ndev),
+					 data.police_index, &entry->meter);
+		if (ret) {
+			NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT policer allocation/programming failed");
+			goto out_put_wanid;
+		}
+		data.meter_bucket = zte_nppt_meter_bucket(entry->meter);
+		entry->spec.data.meter_bucket = data.meter_bucket;
+	}
+	zx279133_fast_response_build(fast, &data, &xlate, ingress, egress,
+				     gemport, entry->ikey, entry->stat,
+				     entry->has_stat, pppoe, entry->wanid);
+	if (full) {
+		zx279133_fast_full_table_build(table, fast, entry->key,
+					       entry->age);
+	} else {
+		memcpy(ikey, fast, sizeof(ikey));
+		zx279133_fast_multi_table_build(table, fast, entry->key, entry->age);
+		ret = zte_nppt_ikey_write(offload->np, entry->ikey, ikey);
+		if (ret) {
+			NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT IKEY programming failed");
+			goto out_put_wanid;
+		}
+	}
+	ret = xa_err(xa_store(&offload->flows, f->cookie, entry, GFP_KERNEL));
+	if (ret) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "cannot index NPPT flow cookie");
+		goto out_clear_ikey;
+	}
+	ret = rhashtable_insert_fast(&offload->key_flows, &entry->key_node,
+				     zx279133_flow_key_ht_params);
+	if (ret) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "cannot index NPPT flow tuple");
+		xa_erase(&offload->flows, f->cookie);
+		goto out_clear_ikey;
+	}
+	if (egress == ZX279133_FLOW_PORT_LAN) {
+		entry->host = zte_nppt_host_get(offload->np, data.eth.h_dest, gemport);
+		if (IS_ERR(entry->host)) {
+			ret = PTR_ERR(entry->host);
+			entry->host = NULL;
+			NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT Host prerequisite unavailable");
+			rhashtable_remove_fast(&offload->key_flows, &entry->key_node,
+					       zx279133_flow_key_ht_params);
+			xa_erase(&offload->flows, f->cookie);
+			goto out_clear_ikey;
+		}
+	}
+	table_words = full ? ARRAY_SIZE(table) : ARRAY_SIZE(ikey) * 2;
+	ret = zx279133_flow_table_write(offload, entry, table, table_words);
+	if (ret) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT rule programming failed");
+		if (zx279133_flow_entry_hw_clear(offload, entry)) {
+			/* Keep cookie, storage and meter pinned until invalidation succeeds. */
+			entry->stale = true;
+			__module_get(THIS_MODULE);
+			entry->module_pinned = true;
+			mutex_unlock(&offload->lock);
+			return ret;
+		}
+		rhashtable_remove_fast(&offload->key_flows, &entry->key_node,
+				       zx279133_flow_key_ht_params);
+		xa_erase(&offload->flows, f->cookie);
+		goto out_clear_ikey;
+	}
+	/* An unindexed entry only keeps its reply in software. */
+	if (entry->upstream) {
+		ret = rhashtable_lookup_insert_fast(&offload->reply_flows,
+						  &entry->reply_node,
+						  zx279133_flow_reply_ht_params);
+		entry->reply_indexed = !ret;
+		if (ret && data.vlan.tagged) {
+			if (zx279133_flow_entry_hw_clear(offload, entry)) {
+				entry->stale = true;
+				__module_get(THIS_MODULE);
+				entry->module_pinned = true;
+				mutex_unlock(&offload->lock);
+				return ret;
+			}
+			rhashtable_remove_fast(&offload->key_flows, &entry->key_node,
+					       zx279133_flow_key_ht_params);
+			xa_erase(&offload->flows, f->cookie);
+			goto out_clear_ikey;
+		}
+	}
+	__module_get(THIS_MODULE);
+	entry->module_pinned = true;
+	zx279133_clients_sync(offload);
+	mutex_unlock(&offload->lock);
+	return 0;
+
+out_clear_ikey:
+	if (entry->host && zte_nppt_host_put(offload->np, entry->host))
+		dev_warn(offload->dev, "Host cleanup retained a hardware resource\n");
+	if (!full) {
+		memset(ikey, 0, sizeof(ikey));
+		zte_nppt_ikey_write(offload->np, entry->ikey, ikey);
+	}
+out_put_wanid:
+	if (entry->meter) {
+		if (zte_nppt_meter_put(offload->np, entry->meter))
+			zte_nppt_meter_abandon(offload->np, entry->meter);
+		entry->meter = NULL;
+	}
+	zte_nppt_wanid_put(offload->np, entry->wanid, snat);
+out_release_stat:
+	zx279133_stat_put(offload, entry);
+out_release_age:
+	__clear_bit(entry->age, offload->age_used);
+out_release_storage:
+	if (!full)
+		__clear_bit(entry->ikey, offload->ikey_used);
+	zx279133_flow_slot_release(offload, entry);
+out_free:
+	if (entry->vlan_out && zte_nppt_vlan_put(offload->np, entry->vlan_out))
+		zte_nppt_vlan_abandon(offload->np, entry->vlan_out);
+	if (entry->vlan_in && zte_nppt_vlan_put(offload->np, entry->vlan_in))
+		zte_nppt_vlan_abandon(offload->np, entry->vlan_in);
+	mutex_unlock(&offload->lock);
+	kfree(entry);
+	return ret;
+}
+
+static int
+zx279133_flow_entry_hw_clear(struct zx279133_flow_offload *offload,
+			     const struct zx279133_flow_entry *entry)
+{
+	u32 ikey[ZX279133_FAST_IKEY_SIZE / sizeof(u32)] = {};
+	u32 table[ZX279133_ZCAM_ENTRY_SIZE / sizeof(u32)] = {};
+	int ret;
+
+	if (entry->in_ddr) {
+		ret = zte_nppt_ddr_clear(offload->np, entry->ddr_bucket);
+	} else {
+		ret = zte_nppt_zcam_write(offload->np, entry->zblock, entry->zcell,
+					  entry->zaddr, table,
+					  entry->full ? ARRAY_SIZE(table) :
+							 ARRAY_SIZE(ikey) * 2);
+	}
+	if (ret)
+		return ret;
+	if (!entry->full) {
+		ret = zte_nppt_ikey_write(offload->np, entry->ikey, ikey);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static void zx279133_flow_entry_unindex(struct zx279133_flow_offload *offload,
+					struct zx279133_flow_entry *entry)
+{
+	if (entry->reply_indexed)
+		rhashtable_remove_fast(&offload->reply_flows,
+				       &entry->reply_node,
+				       zx279133_flow_reply_ht_params);
+}
+
+/* Take one entry out of the hardware and the driver; offload->lock held. */
+static int zx279133_flow_entry_remove(struct zx279133_flow_offload *offload,
+				      struct zx279133_flow_entry *entry,
+				      unsigned long cookie,
+				      struct flow_stats *stats, bool retire)
+{
+	int ret;
+
+	if (entry->retired) {
+		if (stats)
+			zx279133_stat_merge(stats, &entry->final_stats);
+		xa_erase(&offload->flows, cookie);
+		if (entry->module_pinned)
+			module_put(THIS_MODULE);
+		kfree(entry);
+		return 0;
+	}
+	if (entry->refused) {
+		zx279133_flow_entry_unindex(offload, entry);
+		xa_erase(&offload->flows, cookie);
+		kfree(entry);
+		return 0;
+	}
+	ret = zx279133_flow_entry_hw_clear(offload, entry);
+	if (ret) {
+		entry->stale = true;
+		return ret;
+	}
+	/* Invalidate before the final read, retaining its index until settled. */
+	if (stats || retire || entry->stat_group) {
+		ret = zx279133_flow_counter_collect(offload, entry,
+						    &entry->final_stats, true);
+		if (ret) {
+			entry->stale = true;
+			return ret;
+		}
+	}
+	if (entry->vlan_out) {
+		ret = zte_nppt_vlan_put(offload->np, entry->vlan_out);
+		if (ret) {
+			entry->stale = true;
+			return ret;
+		}
+		entry->vlan_out = NULL;
+	}
+	if (entry->vlan_in) {
+		ret = zte_nppt_vlan_put(offload->np, entry->vlan_in);
+		if (ret) {
+			entry->stale = true;
+			return ret;
+		}
+		entry->vlan_in = NULL;
+	}
+	if (entry->meter) {
+		ret = zte_nppt_meter_put(offload->np, entry->meter);
+		if (ret) {
+			entry->stale = true;
+			return ret;
+		}
+		entry->meter = NULL;
+	}
+	rhashtable_remove_fast(&offload->key_flows, &entry->key_node,
+			       zx279133_flow_key_ht_params);
+	zx279133_flow_entry_unindex(offload, entry);
+	if (!retire)
+		xa_erase(&offload->flows, cookie);
+	zx279133_flow_slot_release(offload, entry);
+	if (!entry->full)
+		__clear_bit(entry->ikey, offload->ikey_used);
+	__clear_bit(entry->age, offload->age_used);
+	zx279133_stat_put(offload, entry);
+	if (stats) {
+		zx279133_stat_merge(stats, &entry->final_stats);
+		memset(&entry->final_stats, 0, sizeof(entry->final_stats));
+	}
+	zte_nppt_wanid_put(offload->np, entry->wanid, entry->snat);
+	if (zte_nppt_host_put(offload->np, entry->host))
+		dev_warn(offload->dev, "Host deletion failed; npu retained the slot\n");
+	if (retire) {
+		/* Only cookie, identity and the final delta survive; no HW resources. */
+		entry->host = NULL;
+		entry->reply_indexed = false;
+		entry->has_stat = false;
+		entry->has_age = false;
+		entry->retired = true;
+		entry->stale = false;
+		return 0;
+	}
+	if (entry->module_pinned)
+		module_put(THIS_MODULE);
+	kfree(entry);
+
+	return 0;
+}
+
+static int zx279133_flow_destroy(struct zx279133_flow_offload *offload,
+				 struct flow_cls_offload *f)
+{
+	struct zx279133_flow_entry *entry;
+	int ret;
+
+	mutex_lock(&offload->lock);
+	entry = xa_load(&offload->flows, f->cookie);
+	ret = entry ? zx279133_flow_entry_remove(offload, entry, f->cookie,
+						 &f->stats, false) : -ENOENT;
+	mutex_unlock(&offload->lock);
+	return ret;
+}
+
+/*
+ * Defensive cleanup at the last block unbind. Flowtable normally drains its
+ * rules while callbacks are still bound; keep this for other block users and
+ * quarantined rules whose earlier DESTROY failed.
+ */
+static void zx279133_flow_entries_clear_block(struct zx279133_flow_offload *offload,
+					      const struct flow_block *fblock)
+{
+	struct zx279133_flow_entry *entry;
+	unsigned long index;
+
+	mutex_lock(&offload->lock);
+	xa_for_each(&offload->flows, index, entry)
+		if (entry->fblock == fblock &&
+		    zx279133_flow_entry_remove(offload, entry, index, NULL, false))
+			dev_warn(offload->dev,
+				 "failed to clear hardware flow %lu\n", index);
+	mutex_unlock(&offload->lock);
+}
+
+static int zx279133_flow_stats(struct zx279133_flow_offload *offload,
+			       struct flow_cls_offload *f)
+{
+	struct zx279133_flow_entry *entry;
+	bool used;
+	int ret;
+
+	mutex_lock(&offload->lock);
+	entry = xa_load(&offload->flows, f->cookie);
+	if (entry && entry->retired) {
+		ret = zx279133_flow_entry_remove(offload, entry, f->cookie,
+						 &f->stats, false);
+		if (!ret)
+			ret = -ENOENT;
+		goto out_unlock;
+	}
+	if (!entry || entry->refused) {
+		NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT rule no longer present");
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+	if (entry->stale) {
+		NL_SET_ERR_MSG_MOD(f->common.extack,
+				   "NPPT rule state is uncertain after delete failure");
+		ret = -EIO;
+		goto out_unlock;
+	}
+	if (entry->has_age) {
+		ret = zte_nppt_age_read_clear(offload->np, entry->age, &used);
+		if (ret) {
+			NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT age read failed");
+			goto out_unlock;
+		}
+		if (used)
+			entry->lastused = jiffies;
+	}
+	ret = zx279133_flow_counter_collect(offload, entry, &f->stats, false);
+	if (ret)
+		NL_SET_ERR_MSG_MOD(f->common.extack, "NPPT counter read/reset failed");
+
+out_unlock:
+	mutex_unlock(&offload->lock);
+	return ret;
+}
+
+static void zx279133_diag_record(struct zx279133_flow_offload *offload,
+				 struct flow_cls_offload *f, int ret);
+
+static int zx279133_flow_command(struct zx279133_flow_offload *offload,
+				  struct zx279133_flow_block *block,
+				  struct flow_cls_offload *f)
+{
+#ifdef CONFIG_DEBUG_FS
+	struct netlink_ext_ack local_ack;
+#endif
+	struct netlink_ext_ack *original_ack = f->common.extack;
+	int ret;
+
+	/* Preserve a rejection reason even for callers that supplied no extack. */
+#ifdef CONFIG_DEBUG_FS
+	if (!original_ack && f->command != FLOW_CLS_STATS &&
+	    READ_ONCE(offload->diag.remaining) &&
+	    time_before(jiffies, READ_ONCE(offload->diag.expires))) {
+		memset(&local_ack, 0, sizeof(local_ack));
+		f->common.extack = &local_ack;
+	}
+#endif
+	switch (f->command) {
+	case FLOW_CLS_REPLACE:
+		ret = zx279133_flow_replace(offload, block, f);
+		break;
+	case FLOW_CLS_DESTROY:
+		ret = zx279133_flow_destroy(offload, f);
+		break;
+	case FLOW_CLS_STATS:
+		ret = zx279133_flow_stats(offload, f);
+		break;
+	case FLOW_CLS_STATS_AGGREGATE:
+		ret = zx279133_stat_groups_collect(offload, f->stats_scope.domain);
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+	}
+	/* cls_api replays -EAGAIN synchronously under RTNL. A missing peer
+	 * can only appear in a later request, so never ask TC to busy-loop.
+	 * Flowtable has its own asynchronous retry and keeps that contract.
+	 */
+	if (ret == -EAGAIN && !block->flowtable)
+		ret = -EBUSY;
+	if (f->command != FLOW_CLS_STATS_AGGREGATE)
+		zx279133_diag_record(offload, f, ret);
+	f->common.extack = original_ack;
+	return ret;
+}
+
+static int zx279133_flow_block_cb(enum tc_setup_type type, void *type_data,
+				  void *cb_priv)
+{
+	struct zx279133_flow_block *block = cb_priv;
+	struct flow_cls_offload *f = type_data;
+	int ret;
+
+	if (type != TC_SETUP_CLSFLOWER)
+		return -EOPNOTSUPP;
+	if (f->command == FLOW_CLS_STATS_AGGREGATE) {
+		if (!block->flowtable)
+			return -EOPNOTSUPP;
+		f->aggregate_stats_supported = true;
+	}
+	ret = zte_nppt_begin(block->offload->np);
+	if (ret)
+		return ret == -EAGAIN && !block->flowtable ? -EBUSY : ret;
+	ret = block->offload->detached ? -ENODEV :
+		zx279133_flow_command(block->offload, block, f);
+	zte_nppt_end(block->offload->np);
+	return ret;
+}
+
+static void zx279133_offload_release(struct kref *ref)
+{
+	struct zx279133_flow_offload *offload =
+		container_of(ref, struct zx279133_flow_offload, ref);
+
+#ifdef CONFIG_DEBUG_FS
+	kfree(offload->diag.events);
+#endif
+	rhashtable_destroy(&offload->reply_flows);
+	rhashtable_destroy(&offload->key_flows);
+	xa_destroy(&offload->flows);
+	bitmap_free(offload->ddr_used);
+	zte_nppt_put(offload->np);
+	kfree(offload);
+}
+
+static void zx279133_flow_block_release(void *cb_priv)
+{
+	struct zx279133_flow_block *block = cb_priv;
+
+	kref_put(&block->offload->ref, zx279133_offload_release);
+	kfree(block);
+	module_put(THIS_MODULE);
+}
+
+static int
+zx279133_flow_entries_clear(struct zx279133_flow_offload *offload,
+			    bool clear_hardware, bool retire)
+{
+	struct zx279133_flow_entry *entry;
+	unsigned long index;
+	int ret;
+
+	mutex_lock(&offload->lock);
+	xa_for_each(&offload->flows, index, entry) {
+		if (retire && entry->retired)
+			continue;
+		if (!clear_hardware && !entry->refused && !entry->retired)
+			continue;
+		if (zx279133_flow_entry_remove(offload, entry, index, NULL, retire))
+			dev_warn(offload->dev,
+				 "quarantined hardware flow %lu after delete failure\n", index);
+	}
+	ret = zx279133_clients_clear(offload, clear_hardware);
+	xa_for_each(&offload->flows, index, entry)
+		if (!retire || (!entry->retired && !entry->refused)) {
+			ret = -EIO;
+			break;
+		}
+	mutex_unlock(&offload->lock);
+	return ret;
+}
+
+/* Whether a device of this flowtable is still bound to the driver. */
+static bool zx279133_flow_block_bound(struct zx279133_flow_offload *offload,
+				      const struct flow_block *fblock)
+{
+	struct flow_block_cb *block_cb;
+
+	list_for_each_entry(block_cb, &offload->block_cb_list, driver_list) {
+		struct zx279133_flow_block *block = block_cb->cb_priv;
+
+		if (block->fblock == fblock)
+			return true;
+	}
+	return false;
+}
+
+static int zx279133_flow_setup_block(struct zx279133_flow_offload *offload,
+				     struct net_device *ndev,
+				     struct flow_block_offload *f,
+				     bool flowtable)
+{
+	struct zx279133_flow_block *block;
+	struct flow_block_cb *block_cb;
+	flow_setup_cb_t *cb = zx279133_flow_block_cb;
+
+	if (!tc_can_offload(ndev) ||
+	    f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return -EOPNOTSUPP;
+	f->driver_block_list = &offload->block_cb_list;
+
+	switch (f->command) {
+	case FLOW_BLOCK_BIND:
+		block_cb = flow_block_cb_lookup(f->block, cb, ndev);
+		if (block_cb) {
+			flow_block_cb_incref(block_cb);
+			return 0;
+		}
+		block = kzalloc(sizeof(*block), GFP_KERNEL);
+		if (!block)
+			return -ENOMEM;
+		block->offload = offload;
+		block->ndev = ndev;
+		block->fblock = f->block;
+		block->flowtable = flowtable;
+		block_cb = flow_block_cb_alloc(cb, ndev, block,
+					       zx279133_flow_block_release);
+		if (IS_ERR(block_cb)) {
+			kfree(block);
+			return PTR_ERR(block_cb);
+		}
+		if (!try_module_get(THIS_MODULE)) {
+			/* No release callback ownership has been transferred yet. */
+			block_cb->release = NULL;
+			flow_block_cb_free(block_cb);
+			kfree(block);
+			return -ENODEV;
+		}
+		kref_get(&offload->ref);
+		flow_block_cb_incref(block_cb);
+		flow_block_cb_add(block_cb, f);
+		list_add_tail(&block_cb->driver_list, &offload->block_cb_list);
+		return 0;
+	case FLOW_BLOCK_UNBIND:
+		block_cb = flow_block_cb_lookup(f->block, cb, ndev);
+		if (!block_cb)
+			return -ENOENT;
+		if (!flow_block_cb_decref(block_cb)) {
+			flow_block_cb_remove(block_cb, f);
+			list_del(&block_cb->driver_list);
+			if (!zx279133_flow_block_bound(offload, f->block))
+				zx279133_flow_entries_clear_block(offload,
+								  f->block);
+		}
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+#ifdef CONFIG_DEBUG_FS
+/* One line per hardware flow, with the SDT29 counters read live. */
+static int zx279133_flows_show(struct seq_file *s, void *unused)
+{
+	struct zx279133_flow_offload *offload = s->private;
+	struct zx279133_flow_entry *entry;
+	unsigned long index;
+	u64 packets, bytes;
+	int ret;
+
+	ret = zte_nppt_try_begin(offload->np);
+	if (ret)
+		return ret;
+	mutex_lock(&offload->lock);
+	xa_for_each(&offload->flows, index, entry) {
+		if (entry->retired) {
+			seq_printf(s, "%16phN retired packets %llu ip_bytes %llu\n",
+				   entry->key, entry->final_stats.pkts,
+				   entry->final_stats.bytes);
+			continue;
+		}
+		if (entry->refused) {
+			seq_printf(s, "%16phN lan refused pppoe\n", entry->key);
+			continue;
+		}
+		seq_printf(s, "%16phN %s %s wanid %u pppoe %d snat %d age %u wan_vlan %d",
+			   entry->key, entry->lan_routed ? "lan" :
+			   entry->upstream ? "up" : "down",
+			   entry->full ? "full" : "multi", entry->wanid,
+			   entry->pppoe, entry->snat, entry->age, entry->wan_vlan);
+		if (entry->in_ddr)
+			seq_printf(s, " ddr %u", entry->ddr_bucket);
+		else
+			seq_printf(s, " zcam %u/%u/%u", entry->zblock,
+				   entry->zcell, entry->zaddr);
+		if (entry->has_stat &&
+		    !zte_nppt_stats_read(offload->np, entry->stat,
+					      &packets, &bytes))
+			seq_printf(s, " stat %u packets %llu bytes %llu",
+				   entry->stat, packets, bytes);
+		seq_putc(s, '\n');
+	}
+	zte_nppt_hosts_show(offload->np, s);
+	mutex_unlock(&offload->lock);
+	zte_nppt_end(offload->np);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(zx279133_flows);
+
+static int zx279133_flows_debugfs_init(struct zx279133_flow_offload *offload)
+{
+	char name[80];
+
+	snprintf(name, sizeof(name), "zx279133-flows-%s", dev_name(offload->dev));
+	offload->debugfs = debugfs_create_file(name, 0400, NULL, offload,
+					      &zx279133_flows_fops);
+	return 0;
+}
+#else
+static int zx279133_flows_debugfs_init(struct zx279133_flow_offload *offload)
+{
+	return 0;
+}
+#endif
+
+#include "zx279133-offload-debug.h"
+
+static void *zx279133_offload_attach(struct zte_nppt *np, struct device *dev)
+{
+	struct zx279133_flow_offload *offload;
+	struct zte_nppt_info info;
+	int ret;
+
+	zte_nppt_get_info(np, &info);
+	if (info.api_version != ZTE_NPPT_API_VERSION ||
+	    info.ikey_depth != ZX279133_FAST_IKEY_DEPTH ||
+	    info.stat_depth != ZX279133_FAST_STAT_DEPTH ||
+	    info.age_depth != ZX279133_FAST_AGE_DEPTH ||
+	    info.ddr_bytes != ZTE_NPPT_DDR_BYTES)
+		return ERR_PTR(-EPROTONOSUPPORT);
+	offload = kzalloc(sizeof(*offload), GFP_KERNEL);
+	if (!offload)
+		return ERR_PTR(-ENOMEM);
+	offload->np = np;
+	offload->dev = dev;
+	kref_init(&offload->ref);
+	offload->ddr_used = bitmap_zalloc(ZX279133_DDR_BUCKETS, GFP_KERNEL);
+	if (!offload->ddr_used) {
+		ret = -ENOMEM;
+		goto free;
+	}
+	mutex_init(&offload->lock);
+	xa_init(&offload->flows);
+	hash_init(offload->stat_groups);
+	ret = rhashtable_init(&offload->key_flows, &zx279133_flow_key_ht_params);
+	if (ret)
+		goto bitmap;
+	ret = rhashtable_init(&offload->reply_flows, &zx279133_flow_reply_ht_params);
+	if (ret)
+		goto keys;
+	INIT_LIST_HEAD(&offload->block_cb_list);
+	zte_nppt_get(np);
+	zx279133_flows_debugfs_init(offload);
+	zx279133_diag_init(offload);
+	return offload;
+keys:
+	rhashtable_destroy(&offload->key_flows);
+bitmap:
+	bitmap_free(offload->ddr_used);
+free:
+	kfree(offload);
+	return ERR_PTR(ret);
+}
+
+static bool zx279133_offload_active(void *priv)
+{
+	struct zx279133_flow_offload *offload = priv;
+	struct zx279133_flow_entry *entry;
+	unsigned long index;
+	bool active = false;
+
+	mutex_lock(&offload->lock);
+	active = zx279133_clients_active(offload);
+	xa_for_each(&offload->flows, index, entry)
+		if (!entry->retired && !entry->refused) {
+			active = true;
+			break;
+		}
+	mutex_unlock(&offload->lock);
+	return active;
+}
+
+static int zx279133_offload_reset(void *priv)
+{
+	return zx279133_flow_entries_clear(priv, true, true);
+}
+
+static int zx279133_offload_detach(void *priv)
+{
+	struct zx279133_flow_offload *offload = priv;
+	struct zte_nppt_info info;
+	unsigned int i;
+
+	offload->detached = true;
+	/* The supplier holds datapath_lock. No new hardware callbacks can start. */
+	zte_nppt_get_info(offload->np, &info);
+	zx279133_flow_entries_clear(offload, info.ready, false);
+	debugfs_remove(offload->debugfs);
+	zx279133_diag_remove(offload);
+	if (!xa_empty(&offload->flows) || zx279133_clients_active(offload)) {
+		/* Preserve uncertain hardware allocations and the module references. */
+		dev_err(offload->dev, "uncleared flows quarantined; offload unload blocked\n");
+		return -EIO;
+	}
+	for (i = 0; i < ZX279133_CLIENT_LIMITS; i++)
+		zte_nppt_host_watch(offload->np, i, NULL);
+	kref_put(&offload->ref, zx279133_offload_release);
+	return 0;
+}
+
+static int zx279133_offload_setup_tc(void *priv, struct net_device *dev,
+				    enum tc_setup_type type, void *data)
+{
+	if (type != TC_SETUP_FT && type != TC_SETUP_BLOCK)
+		return -EOPNOTSUPP;
+	return zx279133_flow_setup_block(priv, dev, data, type == TC_SETUP_FT);
+}
+
+static void zx279133_offload_resync(void *priv)
+{
+	struct zx279133_flow_offload *offload = priv;
+
+	mutex_lock(&offload->lock);
+	if (!offload->detached)
+		zx279133_clients_sync(offload);
+	mutex_unlock(&offload->lock);
+}
+
+static const struct zte_nppt_client_ops zx279133_offload_ops = {
+	.attach = zx279133_offload_attach,
+	.detach = zx279133_offload_detach,
+	.setup_tc = zx279133_offload_setup_tc,
+	.active = zx279133_offload_active,
+	.reset = zx279133_offload_reset,
+	.resync = zx279133_offload_resync,
+};
+
+static int __init zx279133_fnoffload_init(void)
+{
+	return zte_nppt_register_client(&zx279133_offload_ops);
+}
+
+static void __exit zx279133_fnoffload_exit(void)
+{
+	zte_nppt_unregister_client(&zx279133_offload_ops);
+}
+
+module_init(zx279133_fnoffload_init);
+module_exit(zx279133_fnoffload_exit);
+MODULE_DESCRIPTION("ZTE ZX279133 flowtable hardware rule translator");
+MODULE_LICENSE("GPL");
