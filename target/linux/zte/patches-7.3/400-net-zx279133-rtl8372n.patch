+static void zx279133_rtl8372n_get_stats64(struct dsa_switch *ds, int port,
+					   struct rtnl_link_stats64 *stats)
+{
+	struct zx279133_rtl8372n *priv = ds->priv;
+	unsigned long flags;
+
+	if (port < 0 || port > RTL8372N_CPU_PORT)
+		return;
+
+	spin_lock_irqsave(&priv->stats_lock, flags);
+	*stats = priv->stats[port];
+	if (!priv->stats_stopping &&
+	    (!(priv->stats_armed & BIT(port)) ||
+	     time_after_eq(jiffies, priv->stats_next_poll[port]))) {
+		priv->stats_armed |= BIT(port);
+		priv->stats_next_poll[port] = jiffies + RTL8372N_STATS_INTERVAL;
+		priv->stats_pending |= BIT(port);
+		/* Queue under the lock, so teardown cannot cancel before enqueue. */
+		schedule_work(&priv->stats_work);
+	}
+	spin_unlock_irqrestore(&priv->stats_lock, flags);
+}
