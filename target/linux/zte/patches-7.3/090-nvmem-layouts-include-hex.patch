Subject: [PATCH] nvmem: layouts: include hex declarations on Linux 7.3

The generic MAC-base helpers use mac_pton() and hex_to_bin(). Linux 7.3
declares both in linux/hex.h; do not depend on transitive includes.

--- a/drivers/nvmem/layouts.c
+++ b/drivers/nvmem/layouts.c
@@ -10,6 +10,7 @@
 #include <linux/device.h>
 #include <linux/dma-mapping.h>
 #include <linux/etherdevice.h>
+#include <linux/hex.h>
 #include <linux/if_ether.h>
 #include <linux/nvmem-consumer.h>
 #include <linux/nvmem-provider.h>
