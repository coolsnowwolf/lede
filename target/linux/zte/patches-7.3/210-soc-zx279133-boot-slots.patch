Subject: [PATCH] soc: zte: add boot information and firmware slot rootfs

Decode vendor boot information and locate the selected slot rootfs.

--- a/drivers/soc/Kconfig
+++ b/drivers/soc/Kconfig
@@ -31,5 +31,6 @@
 source "drivers/soc/versatile/Kconfig"
 source "drivers/soc/vt8500/Kconfig"
 source "drivers/soc/xilinx/Kconfig"
+source "drivers/soc/zte/Kconfig"
 
 endmenu
--- a/drivers/soc/Makefile
+++ b/drivers/soc/Makefile
@@ -37,3 +37,4 @@
 obj-y				+= versatile/
 obj-y				+= vt8500/
 obj-y				+= xilinx/
+obj-y				+= zte/
--- /dev/null
+++ b/drivers/soc/zte/Kconfig
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config ZTE_ZX279133_BOOTINFO
+	bool "ZTE ZX279133 boot information"
+	depends on ARM64 && OF
+	help
+	  Decode the SR1010 boot information supplied by the vendor bootloader
+	  in /chosen/versioninfo. Expose the selected firmware slot and its
+	  flash offsets without changing the MTD partition layout.
+
+config ZTE_ZX279133_ROOTFS
+	bool "ZTE ZX279133 firmware slot root filesystem"
+	depends on ZTE_ZX279133_BOOTINFO && MTD
+	help
+	  Register a read-only MTD device named "rootfs" covering the root
+	  filesystem payload of the SR1010 firmware slot selected by the vendor
+	  bootloader. Bad erase blocks skipped by the vendor flasher are skipped
+	  here as well, so a block filesystem such as squashfs can be mounted
+	  through mtdblock. The device only exists when the bootloader reports
+	  a selected slot with a non-empty rootfs.
+
--- /dev/null
+++ b/drivers/soc/zte/Makefile
@@ -0,0 +1,4 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+obj-$(CONFIG_ZTE_ZX279133_BOOTINFO) += zx279133-bootinfo.o
+obj-$(CONFIG_ZTE_ZX279133_ROOTFS) += zx279133-rootfs.o
--- /dev/null
+++ b/drivers/soc/zte/zx279133-bootinfo.c
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SR1010 U-Boot passes a little-endian structure, not DT cells. */
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/kobject.h>
+#include <linux/of.h>
+#include <linux/printk.h>
+#include <linux/soc/zte/zx279133-bootinfo.h>
+#include <linux/sysfs.h>
+#include <linux/unaligned.h>
+
+#define ZX279133_BOOTINFO_SIZE	1400
+#define ZX279133_SLOT_COUNT	0x38
+#define ZX279133_BOOT_SLOT	0x3c
+#define ZX279133_ROOTFS_SLOT	0x134
+#define ZX279133_SLOT_RECORD	0x13c
+#define ZX279133_SLOT_STRIDE	0x21c
+#define ZX279133_FW_HEADER	0x1c
+
+static int zx279133_bootinfo_decode(const void *data, size_t len,
+				    struct zx279133_bootinfo *info)
+{
+	struct zx279133_bootinfo decoded;
+	const u8 *blob = data, *record, *header;
+	u32 count;
+
+	if (len != ZX279133_BOOTINFO_SIZE)
+		return -EINVAL;
+
+	if (get_unaligned_le32(blob) != 0xcccccccc ||
+	    get_unaligned_le32(blob + 4) != 0x55555555 ||
+	    get_unaligned_le32(blob + 8) != 0xaaaaaaaa ||
+	    get_unaligned_le32(blob + 12) != 0x11111111)
+		return -EINVAL;
+
+	count = get_unaligned_le32(blob + ZX279133_SLOT_COUNT);
+	/* cspboot initializes this structure before any firmware is selected. */
+	if (!count)
+		return -ENODATA;
+	decoded.slot = get_unaligned_le32(blob + ZX279133_BOOT_SLOT);
+	if (count > 2 || decoded.slot >= count ||
+	    decoded.slot != get_unaligned_le32(blob + ZX279133_ROOTFS_SLOT))
+		return -EINVAL;
+
+	record = blob + ZX279133_SLOT_RECORD +
+		 decoded.slot * ZX279133_SLOT_STRIDE;
+	header = record + ZX279133_FW_HEADER;
+	/* The bootloader marks a slot invalid after a failed load. */
+	if (get_unaligned_le32(record) ||
+	    get_unaligned_le32(header + 0xf4) != 0x33333333 ||
+	    get_unaligned_le32(header + 0xf8) != 0x66666666 ||
+	    get_unaligned_le32(header + 0xfc) != 0x99999999 ||
+	    get_unaligned_le32(header + 0x100) != 0xcccccccc)
+		return -EINVAL;
+
+	decoded.header_offset = get_unaligned_le32(record + 8);
+	decoded.slot_offset = get_unaligned_le32(record + 0x10);
+	decoded.kernel_offset = get_unaligned_le32(record + 0x14);
+	decoded.rootfs_offset = get_unaligned_le32(record + 0x18);
+	/* This is the declared payload size, not the physical span to the header. */
+	decoded.rootfs_size = get_unaligned_le32(header + 0x40);
+	if (decoded.slot_offset >= decoded.kernel_offset ||
+	    decoded.kernel_offset >= decoded.header_offset)
+		return -EINVAL;
+
+	/* A RAM-root image may have no flash rootfs. */
+	if (decoded.rootfs_size &&
+	    (decoded.rootfs_offset <= decoded.kernel_offset ||
+	     decoded.rootfs_offset >= decoded.header_offset ||
+	     decoded.rootfs_size > decoded.header_offset - decoded.rootfs_offset))
+		return -EINVAL;
+
+	*info = decoded;
+	return 0;
+}
+
+/**
+ * zx279133_get_bootinfo - decode the vendor's selected SR1010 firmware slot
+ * @info: decoded information, unchanged on error
+ *
+ * Return: 0 on success, -ENOENT when versioninfo is absent, -ENODATA before
+ * firmware selection, -EINVAL for an unsupported or malformed record, or
+ * -ENODEV on other machines. Call after the device tree has been unflattened.
+ * No flash is read or modified. The record describes bootloader state, not
+ * proof that the currently running kernel was loaded from flash.
+ */
+int zx279133_get_bootinfo(struct zx279133_bootinfo *info)
+{
+	const void *data;
+	int len;
+
+	if (!of_machine_is_compatible("zte,zx279133-sr1010"))
+		return -ENODEV;
+
+	data = of_get_property(of_chosen, "versioninfo", &len);
+	if (!data)
+		return -ENOENT;
+
+	return zx279133_bootinfo_decode(data, len, info);
+}
+EXPORT_SYMBOL_GPL(zx279133_get_bootinfo);
+
+static struct zx279133_bootinfo bootinfo;
+
+#define ZX279133_BOOTINFO_ATTR(_name, _format) \
+static ssize_t _name##_show(struct kobject *kobj, \
+			   struct kobj_attribute *attr, char *buf) \
+{ \
+	return sysfs_emit(buf, _format "\n", bootinfo._name); \
+} \
+static struct kobj_attribute _name##_attr = __ATTR_RO(_name)
+
+ZX279133_BOOTINFO_ATTR(slot, "%u");
+ZX279133_BOOTINFO_ATTR(slot_offset, "0x%08x");
+ZX279133_BOOTINFO_ATTR(kernel_offset, "0x%08x");
+ZX279133_BOOTINFO_ATTR(rootfs_offset, "0x%08x");
+ZX279133_BOOTINFO_ATTR(rootfs_size, "0x%08x");
+ZX279133_BOOTINFO_ATTR(header_offset, "0x%08x");
+
+static struct attribute *zx279133_bootinfo_attrs[] = {
+	&slot_attr.attr,
+	&slot_offset_attr.attr,
+	&kernel_offset_attr.attr,
+	&rootfs_offset_attr.attr,
+	&rootfs_size_attr.attr,
+	&header_offset_attr.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(zx279133_bootinfo);
+
+static int __init zx279133_bootinfo_init(void)
+{
+	struct kobject *kobj;
+	int ret;
+
+	ret = zx279133_get_bootinfo(&bootinfo);
+	if (ret == -ENODEV || ret == -ENOENT)
+		return 0;
+	if (ret == -ENODATA) {
+		pr_info("zx279133: bootloader has not selected a flash firmware\n");
+		return 0;
+	}
+	if (ret) {
+		pr_warn("zx279133: ignoring invalid /chosen/versioninfo\n");
+		return ret;
+	}
+
+	pr_info("zx279133: firmware slot %u at %#x, kernel %#x, rootfs %#x+%#x, header %#x\n",
+		bootinfo.slot, bootinfo.slot_offset, bootinfo.kernel_offset,
+		bootinfo.rootfs_offset, bootinfo.rootfs_size, bootinfo.header_offset);
+	kobj = kobject_create_and_add("zx279133", firmware_kobj);
+	if (!kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_groups(kobj, zx279133_bootinfo_groups);
+	if (ret)
+		kobject_put(kobj);
+	return ret;
+}
+subsys_initcall(zx279133_bootinfo_init);
--- /dev/null
+++ b/drivers/soc/zte/zx279133-rootfs.c
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Read-only view of the root filesystem stored in the SR1010 firmware slot
+ * that the vendor bootloader selected.
+ *
+ * The vendor flasher and U-Boot place the rootfs payload in good erase blocks
+ * only, skipping bad ones. Expose those blocks as a contiguous MTD device named
+ * "rootfs" so that a block filesystem such as squashfs can be mounted from it.
+ *
+ * The device is registered after the fixed partitions, so it takes the next
+ * free MTD index (7 on this board). MTD calls its notifiers with mtd_table_mutex
+ * held, and registering a device takes that mutex again, so nothing is ever
+ * registered from a notifier: the notifier only schedules work.
+ */
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/math.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/soc/zte/zx279133-bootinfo.h>
+#include <linux/workqueue.h>
+
+#define ZX279133_MAX_MTD	64
+
+struct zx279133_rootfs {
+	struct mtd_info mtd;
+	struct mtd_info *slot;
+	unsigned int nr_blocks;
+	u64 *block_ofs;		/* good-block offsets inside the slot partition */
+};
+
+static struct zx279133_bootinfo bootinfo;
+static struct zx279133_rootfs *rootfs;
+static DEFINE_MUTEX(rootfs_lock);
+static bool rootfs_ready;	/* set once the fixed partitions are registered */
+
+static int zx279133_rootfs_read(struct mtd_info *mtd, loff_t from, size_t len,
+				size_t *retlen, u_char *buf)
+{
+	struct zx279133_rootfs *rfs = mtd->priv;
+	u32 erasesize = mtd->erasesize;
+	int ret = 0;
+
+	while (len) {
+		unsigned int blk = div_u64(from, erasesize);
+		u32 ofs = from - (u64)blk * erasesize;
+		size_t chunk = min_t(size_t, len, erasesize - ofs);
+		size_t done = 0;
+		int err;
+
+		err = mtd_read(rfs->slot, rfs->block_ofs[blk] + ofs, chunk,
+			       &done, buf);
+		*retlen += done;
+		if (err == -EUCLEAN)
+			err = 0;
+		if (err)
+			ret = err;
+		if (err && !mtd_is_eccerr(err))
+			return err;
+		if (done != chunk)
+			return -EIO;
+
+		from += chunk;
+		buf += chunk;
+		len -= chunk;
+	}
+
+	return ret;
+}
+
+static int zx279133_rootfs_block_isbad(struct mtd_info *mtd, loff_t ofs)
+{
+	return 0;
+}
+
+static bool zx279133_is_selected_slot(struct mtd_info *mtd)
+{
+	u64 start = mtd_get_master_ofs(mtd, 0);
+
+	return mtd_is_partition(mtd) && start == bootinfo.slot_offset &&
+	       bootinfo.header_offset <= start + mtd->size;
+}
+
+static struct zx279133_rootfs *zx279133_rootfs_create(struct mtd_info *slot)
+{
+	u32 erasesize = slot->erasesize;
+	u64 ofs = bootinfo.rootfs_offset - bootinfo.slot_offset;
+	u64 end = bootinfo.header_offset - bootinfo.slot_offset;
+	struct zx279133_rootfs *rfs;
+	unsigned int i;
+
+	if (!erasesize || ofs % erasesize)
+		return ERR_PTR(-EINVAL);
+
+	rfs = kzalloc(sizeof(*rfs), GFP_KERNEL);
+	if (!rfs)
+		return ERR_PTR(-ENOMEM);
+
+	rfs->nr_blocks = DIV_ROUND_UP(bootinfo.rootfs_size, erasesize);
+	rfs->block_ofs = kcalloc(rfs->nr_blocks, sizeof(*rfs->block_ofs),
+				 GFP_KERNEL);
+	if (!rfs->block_ofs) {
+		kfree(rfs);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	for (i = 0; i < rfs->nr_blocks; ofs += erasesize) {
+		int bad;
+
+		if (ofs + erasesize > end)
+			goto err_range;
+
+		bad = mtd_block_isbad(slot, ofs);
+		if (bad < 0)
+			goto err_range;
+		if (bad) {
+			pr_info("zx279133-rootfs: skipping bad block at %#llx\n",
+				mtd_get_master_ofs(slot, ofs));
+			continue;
+		}
+		rfs->block_ofs[i++] = ofs;
+	}
+
+	rfs->slot = slot;
+	rfs->mtd.name = "rootfs";
+	rfs->mtd.type = MTD_ROM;
+	/* Read-only and nothing to erase: without this MTD refuses the device. */
+	rfs->mtd.flags = MTD_NO_ERASE;
+	rfs->mtd.size = (u64)rfs->nr_blocks * erasesize;
+	rfs->mtd.erasesize = erasesize;
+	rfs->mtd.writesize = slot->writesize;
+	rfs->mtd.writebufsize = slot->writesize;
+	rfs->mtd.priv = rfs;
+	rfs->mtd._read = zx279133_rootfs_read;
+	rfs->mtd._block_isbad = zx279133_rootfs_block_isbad;
+	return rfs;
+
+err_range:
+	pr_err("zx279133-rootfs: rootfs does not fit before the header at %#x\n",
+	       bootinfo.header_offset);
+	kfree(rfs->block_ofs);
+	kfree(rfs);
+	return ERR_PTR(-ENOSPC);
+}
+
+/* Find the selected slot and register the rootfs device. Not called from MTD. */
+static void zx279133_rootfs_setup(void)
+{
+	struct zx279133_rootfs *rfs;
+	struct mtd_info *slot = NULL;
+	int i, ret;
+
+	mutex_lock(&rootfs_lock);
+	if (rootfs)
+		goto out;
+
+	for (i = 0; i < ZX279133_MAX_MTD && !slot; i++) {
+		struct mtd_info *mtd = get_mtd_device(NULL, i);
+
+		if (IS_ERR(mtd))
+			continue;
+		if (zx279133_is_selected_slot(mtd))
+			slot = mtd;
+		else
+			put_mtd_device(mtd);
+	}
+	if (!slot)
+		goto out;
+
+	rfs = zx279133_rootfs_create(slot);
+	if (IS_ERR(rfs)) {
+		put_mtd_device(slot);
+		goto out;
+	}
+
+	ret = mtd_device_register(&rfs->mtd, NULL, 0);
+	if (ret) {
+		pr_err("zx279133-rootfs: registration failed: %d\n", ret);
+		put_mtd_device(slot);
+		kfree(rfs->block_ofs);
+		kfree(rfs);
+		goto out;
+	}
+
+	rootfs = rfs;
+	pr_info("zx279133-rootfs: mtd%d: slot %u rootfs at %#x, %u blocks\n",
+		rfs->mtd.index, bootinfo.slot, bootinfo.rootfs_offset,
+		rfs->nr_blocks);
+out:
+	mutex_unlock(&rootfs_lock);
+}
+
+static void zx279133_rootfs_work(struct work_struct *work)
+{
+	zx279133_rootfs_setup();
+}
+
+static DECLARE_WORK(zx279133_rootfs_work_item, zx279133_rootfs_work);
+
+/*
+ * Runs with mtd_table_mutex held. Only a slot that shows up after the fixed
+ * partitions were registered (a late SPI-NAND probe) needs this path.
+ */
+static void zx279133_rootfs_notify_add(struct mtd_info *mtd)
+{
+	if (READ_ONCE(rootfs_ready) && !READ_ONCE(rootfs) &&
+	    zx279133_is_selected_slot(mtd))
+		schedule_work(&zx279133_rootfs_work_item);
+}
+
+static void zx279133_rootfs_notify_remove(struct mtd_info *mtd)
+{
+}
+
+static struct mtd_notifier zx279133_rootfs_notifier = {
+	.add = zx279133_rootfs_notify_add,
+	.remove = zx279133_rootfs_notify_remove,
+};
+
+static int __init zx279133_rootfs_init(void)
+{
+	if (zx279133_get_bootinfo(&bootinfo) || !bootinfo.rootfs_size)
+		return 0;
+
+	register_mtd_user(&zx279133_rootfs_notifier);
+	return 0;
+}
+device_initcall(zx279133_rootfs_init);
+
+/* By now the SPI-NAND driver has registered its fixed partitions. */
+static int __init zx279133_rootfs_late(void)
+{
+	if (!bootinfo.rootfs_size)
+		return 0;
+
+	WRITE_ONCE(rootfs_ready, true);
+	zx279133_rootfs_setup();
+	return 0;
+}
+late_initcall(zx279133_rootfs_late);
--- /dev/null
+++ b/include/linux/soc/zte/zx279133-bootinfo.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_ZTE_ZX279133_BOOTINFO_H
+#define __LINUX_SOC_ZTE_ZX279133_BOOTINFO_H
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+/* Byte offsets in the whole flash; slot is zero-based. */
+struct zx279133_bootinfo {
+	u32 slot;
+	u32 slot_offset;
+	u32 kernel_offset;
+	u32 rootfs_offset;
+	u32 rootfs_size;
+	u32 header_offset;
+};
+
+#if IS_ENABLED(CONFIG_ZTE_ZX279133_BOOTINFO)
+int zx279133_get_bootinfo(struct zx279133_bootinfo *info);
+#else
+static inline int zx279133_get_bootinfo(struct zx279133_bootinfo *info)
+{
+	return -ENODEV;
+}
+#endif
+
+#endif
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-firmware-zx279133
@@ -0,0 +1,33 @@
+What:		/sys/firmware/zx279133/slot
+Date:		September 2026
+Contact:	Linux ARM Kernel Mailing List <linux-arm-kernel@lists.infradead.org>
+Description:
+		Read-only, zero-based firmware slot reported by SR1010 U-Boot.
+		The directory exists only when /chosen/versioninfo contains a
+		supported, valid boot information record. Absence is normal for
+		RAM boots without vendor boot information or after cspboot alone,
+		before firmware selection. A manual RAM boot may retain bootloader
+		state; this attribute does not establish the running image's origin.
+
+What:		/sys/firmware/zx279133/slot_offset
+What:		/sys/firmware/zx279133/kernel_offset
+What:		/sys/firmware/zx279133/rootfs_offset
+What:		/sys/firmware/zx279133/header_offset
+Date:		September 2026
+Contact:	Linux ARM Kernel Mailing List <linux-arm-kernel@lists.infradead.org>
+Description:
+		Read-only hexadecimal byte offsets from the start of the whole
+		flash for the selected slot, kernel, rootfs and firmware header.
+		Values are decoded from the bootloader's little-endian structure;
+		they are not MTD device numbers. rootfs_offset has no filesystem
+		meaning when rootfs_size is zero. Reading these files neither
+		accesses flash nor changes the partition layout.
+
+What:		/sys/firmware/zx279133/rootfs_size
+Date:		September 2026
+Contact:	Linux ARM Kernel Mailing List <linux-arm-kernel@lists.infradead.org>
+Description:
+		Read-only hexadecimal rootfs payload size in bytes, as declared
+		by the selected firmware header. This is not necessarily the
+		physical span between rootfs_offset and header_offset, which may
+		include skipped bad blocks or padding. Zero means no flash rootfs.
