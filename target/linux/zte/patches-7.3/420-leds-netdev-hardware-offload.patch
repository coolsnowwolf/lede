Subject: [PATCH] leds: netdev: retain hardware-offloaded link triggers

Carry the netdev trigger handling used by the board hardware LEDs.

--- a/drivers/leds/trigger/ledtrig-netdev.c
+++ b/drivers/leds/trigger/ledtrig-netdev.c
@@ -624,9 +624,14 @@
 	    && evt != NETDEV_CHANGENAME)
 		return NOTIFY_DONE;
 
+	/*
+	 * device_name is looked up in init_net, so only follow a new or
+	 * renamed device there: a container's "eth0" must not take the LED.
+	 */
 	if (!(dev == trigger_data->net_dev ||
-	      (evt == NETDEV_CHANGENAME && !strcmp(dev->name, trigger_data->device_name)) ||
-	      (evt == NETDEV_REGISTER && !strcmp(dev->name, trigger_data->device_name))))
+	      (net_eq(dev_net(dev), &init_net) &&
+	       (evt == NETDEV_CHANGENAME || evt == NETDEV_REGISTER) &&
+	       !strcmp(dev->name, trigger_data->device_name))))
 		return NOTIFY_DONE;
 
 	cancel_delayed_work_sync(&trigger_data->work);
