+	value = readl(eth->base + ZX279133_ROUTE_CTRL);
+	writel(enabled ? value & ~ZX279133_ROUTE_XMAC1 :
+			 value | ZX279133_ROUTE_XMAC1,
+	       eth->base + ZX279133_ROUTE_CTRL);
