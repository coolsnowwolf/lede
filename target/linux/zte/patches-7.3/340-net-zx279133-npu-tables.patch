+/* np.ko 0x7b5b8: PPS word 0x248b8 + 0x10 * field + 2 * ME.
+ * fpga_read_reg(..., 1) selects PPS and scales word addresses by four.
+ * No selector, counter-enable/clear, clock, interrupt or ME control writes.
+ */
+static u64 zx279133_ppu_stats_pair(struct zx279133_eth *eth, u32 offset)
+{
+	u32 low = readl(eth->pps_base + offset);
+	u32 high = readl(eth->pps_base + offset + 4);
+
+	/* Preserve the OEM low-then-high order; do not assume a latch protocol. */
+	return (u64)high << 32 | low;
+}
+
+int zx279133_ppu_me_stats_read(struct zx279133_eth *eth,
+			       struct zte_nppt_me_stats *stats)
+{
+	unsigned int me;
+
+	lockdep_assert_held(&eth->datapath_lock);
+	if (!eth->hardware_prepared || !eth->ppu_mcode_prepared)
+		return -ENETDOWN;
+	if (!stats)
+		return -EINVAL;
+	/* OEM cluster descriptor 27: RO, PPS word 0x24006, mask 0xff. */
+	stats->not_idle = readl(eth->pps_base + 0x90018) & 0xff;
+	for (me = 0; me < ZTE_NPPT_PPU_MES; me++) {
+		struct zte_nppt_me_counters *c = &stats->me[me];
+		u32 offset = 0x922e0 + me * 8;
+
+		c->in_valid = zx279133_ppu_stats_pair(eth, offset);
+		c->in_sop = zx279133_ppu_stats_pair(eth, offset + 0x40);
+		c->in_eop = zx279133_ppu_stats_pair(eth, offset + 0x80);
+		c->out_valid = zx279133_ppu_stats_pair(eth, offset + 0xc0);
+		c->out_sop = zx279133_ppu_stats_pair(eth, offset + 0x100);
+		c->out_eop = zx279133_ppu_stats_pair(eth, offset + 0x140);
+	}
+	return 0;
+}
+
+int zx279133_ppu_me_diagnostics_read(struct zx279133_eth *eth,
+				     struct zte_nppt_me_diagnostics *diagnostics)
+{
+	unsigned int me;
+	int ret;
+
+	lockdep_assert_held(&eth->datapath_lock);
+	if (!eth->hardware_prepared || !eth->ppu_mcode_prepared)
+		return -ENETDOWN;
+	if (!diagnostics)
+		return -EINVAL;
+	ret = zx279133_ppu_me_stats_read(eth, &diagnostics->stats);
+	if (ret)
+		return ret;
+	/* OEM cluster descriptors 45..47; global descriptors 35..39.
+	 * Read whole words, preserving reserved bits for diagnostics only.
+	 */
+	diagnostics->active_cnt_en_raw = readl(eth->pps_base + 0x90448);
+	diagnostics->grant_cnt_en_raw = readl(eth->pps_base + 0x9044c);
+	diagnostics->bank_miss_cnt_en_raw = readl(eth->pps_base + 0x90450);
+	diagnostics->stat_clock_raw = readl(eth->pps_base + 0x18);
+	/* np.ko ppu_clutser_stats and ppu_me_stats, CPU133 branch. */
+	diagnostics->thread_active_raw = zx279133_ppu_stats_pair(eth, 0x92720);
+	diagnostics->cluster_grant_raw = zx279133_ppu_stats_pair(eth, 0x92768);
+	for (me = 0; me < ZTE_NPPT_PPU_MES; me++) {
+		diagnostics->state[me].ready =
+			zx279133_ppu_stats_pair(eth, 0x92728 + me * 8);
+		diagnostics->state[me].grant =
+			zx279133_ppu_stats_pair(eth, 0x92770 + me * 8);
+	}
+	return 0;
