+static const u32 zx279133_lan_proto_table[ZX279133_PRO_BLOCKS_PER_PORT]
+					     [ZX279133_SMMU0_WORDS] = {
+	{ 0x40024002, 0x14144002, 0x58181818, 0x58185818 },
+	{ 0x58185818, 0x58185818, 0x58185818, 0x58185818 },
+	{ 0x58185818, 0x58185818, 0x58185818, 0x58185818 },
