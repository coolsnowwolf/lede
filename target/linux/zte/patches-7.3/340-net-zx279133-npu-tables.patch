+#ifndef _ZX279133_METER_H
+#define _ZX279133_METER_H
+#include <linux/zte_nppt_native.h>
+struct zx279133_eth;
+struct zx279133_meter_pool;
+int zx279133_meter_get(struct zx279133_meter_pool **pool,
+		       struct zx279133_eth *eth,
+		       const struct zte_nppt_plcr_profile *profile,
+		       const void *scope, u32 action_index,
+		       struct zte_nppt_meter **out);
+int zx279133_meter_put(struct zx279133_meter_pool *pool,
+		       struct zx279133_eth *eth, struct zte_nppt_meter *meter);
+void zx279133_meter_abandon(struct zx279133_meter_pool *pool,
+			    struct zte_nppt_meter *meter);
+int zx279133_meter_drain(struct zx279133_meter_pool *pool,
+			 struct zx279133_eth *eth);
+bool zx279133_meter_active(struct zx279133_meter_pool *pool);
+void zx279133_meter_destroy(struct zx279133_meter_pool *pool);
+bool zx279133_meter_profile_busy(struct zx279133_meter_pool *pool, u8 id);
+bool zx279133_meter_binding_busy(struct zx279133_meter_pool *pool, u16 id);
+void zx279133_meter_inventory_changed(struct zx279133_meter_pool *pool);
+int zx279133_meter_mac_get(struct zx279133_meter_pool **pool,
+			   struct zx279133_eth *eth,
+			   const struct zte_nppt_plcr_profile *profile,
+			   u8 slot, bool download, struct zte_nppt_meter **out);
+#endif
--- /dev/null
+++ b/drivers/net/ethernet/zte/zx279133-native.c
@@ -0,0 +1,741 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* CPU133 NP primitives reconstructed from OEM np.ko. No init-time caller.
+ * Source locations and limitations: docs/NP-NATIVE-API-R1.md in the project.
+ */
+#include <linux/bitfield.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+
+#include "zx279133.h"
+#include "zx279133-native.h"
+
+#define PLCR_PROFILE_BASE	0x40000
+#define PLCR_MODE		0x280016
+#define PLCR_BASE		0x280017
+#define PLCR_CONFIGURED_BASE	40960
+#define SSCH_GATE		0x00b8
+#define SSCH_GATE_BIT		BIT(6)
+#define SSCH_COMMAND		0x2c014
+#define SSCH_DONE		0x2c018
+#define SSCH_DATA		0x2c01c
+#define SSCH_COMMAND_MASK	0xffc0007f
+#define SSCH_MODE0		0x2c02c
+#define SSCH_MODE1		0x2c030
+#define SSCH_QUEUE_ENABLE0	0x2c060
+#define SSCH_QUEUE_ENABLE1	0x2c064
+
+/* OEM red_ind_{read,write}: command precedes data; the last data word is
+ * written first. Caller holds np_ind_lock, including snapshot/rollback.
+ * Unlike the OEM wrapper, a timeout is not overwritten by gate restoration.
+ */
+static int zx279133_red_transfer(struct zx279133_eth *eth, u8 ram, u16 queue,
+				 u32 words[4], bool write)
+{
+	u32 gate, val;
+	int i, ret;
+
+	gate = readl(eth->base + ZX279133_RED_AUTO_GATE_REG);
+	if (gate & ZX279133_RED_AUTO_GATE_BIT)
+		writel(gate & ~ZX279133_RED_AUTO_GATE_BIT,
+		       eth->base + ZX279133_RED_AUTO_GATE_REG);
+	ret = readl_poll_timeout_atomic(eth->base + ZX279133_RED_IND_DONE, val,
+					val & ZX279133_RED_IND_DONE_BIT, 1, 1000);
+	if (ret)
+		goto restore_gate;
+	writel(FIELD_PREP(ZX279133_RED_IND_RAM_ID_MASK, ram) | queue |
+	       (write ? 0 : BIT(27)), eth->base + ZX279133_RED_IND_CMD);
+	if (write) {
+		for (i = 3; i >= 0; i--)
+			writel(words[i], eth->base + ZX279133_RED_IND_DATA + 4 * i);
+	}
+	ret = readl_poll_timeout_atomic(eth->base + ZX279133_RED_IND_DONE, val,
+					val & ZX279133_RED_IND_DONE_BIT, 1, 1000);
+	if (!ret && !write)
+		for (i = 3; i >= 0; i--)
+			words[i] = readl(eth->base + ZX279133_RED_IND_DATA + 4 * i);
+restore_gate:
+	if (gate & ZX279133_RED_AUTO_GATE_BIT) {
+		val = readl(eth->base + ZX279133_RED_AUTO_GATE_REG);
+		writel(val | ZX279133_RED_AUTO_GATE_BIT,
+		       eth->base + ZX279133_RED_AUTO_GATE_REG);
+	}
+	return ret;
+}
+
+static int zx279133_red_pack(const struct zte_nppt_red_buffer *c, u32 w[4])
+{
+	if (!c || c->max_space > 0xffff || c->yellow_p0 > 0xff ||
+	    c->yellow_p1 > 0xff || c->green_p0 > 0xff || c->green_p1 > 0xff ||
+	    c->yellow_th0 > 0xffff || c->yellow_th1 > 0xffff ||
+	    c->green_th0 > 0xffff || c->green_th1 > 0xffff)
+		return -EINVAL;
+	w[0] = c->max_space | c->yellow_p0 << 16 | c->yellow_p1 << 24;
+	w[1] = c->green_p0 | c->green_p1 << 8 | c->yellow_th0 << 16;
+	w[2] = c->yellow_th1 | c->green_th0 << 16;
+	w[3] = c->green_th1;
+	return 0;
+}
+
+static void zx279133_red_unpack(const u32 w[4], struct zte_nppt_red_buffer *c)
+{
+	*c = (struct zte_nppt_red_buffer) {
+		.max_space = w[0] & 0xffff,
+		.yellow_p0 = (w[0] >> 16) & 0xff,
+		.yellow_p1 = w[0] >> 24,
+		.green_p0 = w[1] & 0xff,
+		.green_p1 = (w[1] >> 8) & 0xff,
+		.yellow_th0 = w[1] >> 16,
+		.yellow_th1 = w[2] & 0xffff,
+		.green_th0 = w[2] >> 16,
+		.green_th1 = w[3] & 0xffff,
+	};
+}
+
+int zx279133_native_red_buffer_get(struct zx279133_eth *eth, u16 queue,
+				   struct zte_nppt_red_buffer *config)
+{
+	u32 words[4];
+	int ret;
+
+	if (!config || queue >= ZTE_NPPT_RED_QUEUES)
+		return -EINVAL;
+	mutex_lock(&eth->np_ind_lock);
+	ret = zx279133_red_transfer(eth, 4, queue, words, false);
+	mutex_unlock(&eth->np_ind_lock);
+	if (!ret)
+		zx279133_red_unpack(words, config);
+	return ret;
+}
+
+int zx279133_native_red_buffer_set(struct zx279133_eth *eth, u16 queue,
+				   const struct zte_nppt_red_buffer *config)
+{
+	u32 before[4], after[4], words[4];
+	int ret, restore;
+
+	if (queue >= ZTE_NPPT_RED_QUEUES)
+		return -EINVAL;
+	ret = zx279133_red_pack(config, words);
+	if (ret)
+		return ret;
+	mutex_lock(&eth->np_ind_lock);
+	ret = zx279133_red_transfer(eth, 4, queue, before, false);
+	if (ret)
+		goto out;
+	/* Only low 16 bits of the fourth word are defined by the OEM API. */
+	words[3] |= before[3] & GENMASK(31, 16);
+	if (!memcmp(before, words, sizeof(words)))
+		goto out;
+	ret = zx279133_red_transfer(eth, 4, queue, words, true);
+	if (!ret)
+		ret = zx279133_red_transfer(eth, 4, queue, after, false);
+	if (!ret && memcmp(words, after, sizeof(words)))
+		ret = -EIO;
+	if (ret) {
+		restore = zx279133_red_transfer(eth, 4, queue, before, true);
+		if (!restore)
+			restore = zx279133_red_transfer(eth, 4, queue, after, false);
+		if (restore || memcmp(before, after, sizeof(before)))
+			ret = -EUCLEAN;
+	}
+out:
+	mutex_unlock(&eth->np_ind_lock);
+	return ret;
+}
+
+int zx279133_native_red_usage_full_get(struct zx279133_eth *eth, u16 queue,
+				       struct zte_nppt_red_usage_full *usage)
+{
+	struct zte_nppt_red_usage_full sample;
+	u32 words[4];
+	int ret;
+
+	if (!usage || queue >= ZTE_NPPT_RED_QUEUES)
+		return -EINVAL;
+	mutex_lock(&eth->np_ind_lock);
+	ret = zx279133_red_transfer(eth, 3, queue, words, false);
+	if (ret)
+		goto out;
+	sample.shared.input_raw = FIELD_GET(GENMASK(27, 14), words[0]);
+	sample.input_self_raw = words[0] & GENMASK(13, 0);
+	ret = zx279133_red_transfer(eth, 1, queue, words, false);
+	if (ret)
+		goto out;
+	sample.shared.output_raw = FIELD_GET(GENMASK(27, 12), words[0]);
+	sample.output_self_raw = words[0] & GENMASK(11, 0);
+	ret = zx279133_red_transfer(eth, 5, queue, words, false);
+	if (!ret) {
+		sample.shared.buffer_raw = words[0] & 0xffff;
+		*usage = sample;
+	}
+out:
+	mutex_unlock(&eth->np_ind_lock);
+	return ret;
+}
+
+int zx279133_native_red_usage_get(struct zx279133_eth *eth, u16 queue,
+				  struct zte_nppt_red_usage *usage)
+{
+	struct zte_nppt_red_usage_full sample;
+	int ret;
+
+	if (!usage)
+		return -EINVAL;
+	ret = zx279133_native_red_usage_full_get(eth, queue, &sample);
+	if (!ret)
+		*usage = sample.shared;
+	return ret;
+}
+
+static int zx279133_plcr_pack(const struct zte_nppt_plcr_profile *p, u32 *w)
+{
+	if (!p || p->cir > GENMASK(17, 0) || p->eir > GENMASK(17, 0) ||
+	    p->cbs > GENMASK(26, 0) || p->ebs > GENMASK(26, 0) ||
+	    p->cd_mode != 2 || p->cf_flag > 1 || p->cm_flag > 1 ||
+	    p->pkt_sign > 1)
+		return -EINVAL;
+	w[0] = p->cir | p->cbs << 18;
+	w[1] = (p->cbs >> 14) | p->eir << 13 | p->ebs << 31;
+	w[2] = (p->ebs >> 1) | (u32)p->cd_mode << 26 |
+		(u32)p->cf_flag << 28 | (u32)p->cm_flag << 29 |
+		(u32)p->pkt_sign << 30;
+	return 0;
+}
+
+static void zx279133_plcr_unpack(const u32 *w, struct zte_nppt_plcr_profile *p)
+{
+	*p = (struct zte_nppt_plcr_profile) {
+		.cir = w[0] & GENMASK(17, 0),
+		.cbs = (w[0] >> 18) | (w[1] & GENMASK(12, 0)) << 14,
+		.eir = (w[1] >> 13) & GENMASK(17, 0),
+		.ebs = (w[1] >> 31) | (w[2] & GENMASK(25, 0)) << 1,
+		.cd_mode = (w[2] >> 26) & 3,
+		.cf_flag = (w[2] >> 28) & 1,
+		.cm_flag = (w[2] >> 29) & 1,
+		.pkt_sign = (w[2] >> 30) & 1,
+	};
+}
+
+int zx279133_native_plcr_profile_get(struct zx279133_eth *eth, u8 id,
+				     struct zte_nppt_plcr_profile *profile)
+{
+	u32 words[3];
+	unsigned int i;
+	int ret;
+
+	if (!profile || id >= ZTE_NPPT_PLCR_PROFILES)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(words); i++) {
+		ret = zx279133_native_plcr_io(eth, PLCR_PROFILE_BASE + id * 4 + i,
+					      &words[i], false);
+		if (ret)
+			return ret;
+	}
+	zx279133_plcr_unpack(words, profile);
+	return 0;
+}
+
+int zx279133_native_plcr_profile_set(struct zx279133_eth *eth, u8 id,
+				     const struct zte_nppt_plcr_profile *profile)
+{
+	u32 words[3];
+	unsigned int i;
+	int ret;
+
+	if (id >= ZTE_NPPT_PLCR_PROFILES)
+		return -EINVAL;
+	ret = zx279133_plcr_pack(profile, words);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(words); i++) {
+		ret = zx279133_native_plcr_io(eth, PLCR_PROFILE_BASE + id * 4 + i,
+					      &words[i], true);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int zx279133_plcr_binding_io(struct zx279133_eth *eth, u16 id,
+				    u32 *words, bool write)
+{
+	u32 base, mode;
+	int ret;
+
+	if (id >= ZTE_NPPT_PLCR_FLOWS)
+		return -EINVAL;
+	if (id < 128)
+		return zx279133_native_plcr_io(eth, id * 4 + 3, &words[3], write);
+	/* OEM se_plcr_init builds a mode-3 128-bit descriptor at this pool end.
+	 * Read the live configuration before using the driver's reserved region.
+	 */
+	ret = zx279133_native_plcr_io(eth, PLCR_MODE, &mode, false);
+	if (ret)
+		return ret;
+	ret = zx279133_native_plcr_io(eth, PLCR_BASE, &base, false);
+	if (ret)
+		return ret;
+	if (mode != 3 || base != PLCR_CONFIGURED_BASE)
+		return -ESTALE;
+	return zx279133_native_eram_io(eth, base + id, words, write);
+}
+
+int zx279133_native_plcr_binding_get(struct zx279133_eth *eth, u16 id,
+				     struct zte_nppt_plcr_binding *binding)
+{
+	u32 words[4] = {};
+	int ret;
+
+	if (!binding)
+		return -EINVAL;
+	ret = zx279133_plcr_binding_io(eth, id, words, false);
+	if (ret)
+		return ret;
+	*binding = (struct zte_nppt_plcr_binding) {
+		.profile = (words[3] >> 15) & 0x7f,
+		.enabled = !!(words[3] & BIT(22)),
+	};
+	return 0;
+}
+
+int zx279133_native_plcr_binding_set(struct zx279133_eth *eth, u16 id,
+				     const struct zte_nppt_plcr_binding *binding)
+{
+	u32 words[4] = {};
+
+	if (!binding || binding->profile >= ZTE_NPPT_PLCR_PROFILES)
+		return -EINVAL;
+	words[3] = (u32)binding->profile << 15 | (u32)binding->enabled << 22;
+	return zx279133_plcr_binding_io(eth, id, words, true);
+}
+
+int zx279133_native_plcr_timing_get(struct zx279133_eth *eth,
+				    struct zte_nppt_plcr_timing *timing)
+{
+	static const u32 addresses[] = { 0x280018, 0x300010, 0x30000e, 0x28001f };
+	u32 value[ARRAY_SIZE(addresses)];
+	unsigned int i;
+	int ret;
+
+	if (!timing)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		ret = zx279133_native_plcr_io(eth, addresses[i], &value[i], false);
+		if (ret)
+			return ret;
+	}
+	*timing = (struct zte_nppt_plcr_timing) {
+		.time_count = value[0], .packet_length = value[1],
+		.packet_offset = value[2], .loose_length = value[3],
+	};
+	return 0;
+}
+
+/* np.ko ssch_ind_{read,write}: command -> wait -> data, also for writes.
+ * Do not substitute the data-before-command protocol used by other windows.
+ * np_ind_lock protects the shared scheduler gate and the entire transaction.
+ */
+static int zx279133_ssch_ind(struct zx279133_eth *eth, u8 ram, u8 index,
+			     u32 *value, bool write)
+{
+	u32 gate = readl(eth->base + SSCH_GATE);
+	u32 command, status;
+	int ret;
+
+	if (gate & SSCH_GATE_BIT)
+		writel(gate & ~SSCH_GATE_BIT, eth->base + SSCH_GATE);
+	ret = readl_poll_timeout_atomic(eth->base + SSCH_DONE, status,
+					status & BIT(0), 1, 1000);
+	if (ret)
+		goto restore;
+	command = (u32)ram << 22 | index | (write ? 0 : BIT(27));
+	command |= readl(eth->base + SSCH_COMMAND) & ~SSCH_COMMAND_MASK;
+	writel(command, eth->base + SSCH_COMMAND);
+	ret = readl_poll_timeout_atomic(eth->base + SSCH_DONE, status,
+					status & BIT(0), 1, 1000);
+	if (ret)
+		goto restore;
+	if (write)
+		writel(*value, eth->base + SSCH_DATA);
+	else
+		*value = readl(eth->base + SSCH_DATA);
+restore:
+	gate = (readl(eth->base + SSCH_GATE) & ~SSCH_GATE_BIT) |
+		(gate & SSCH_GATE_BIT);
+	writel(gate, eth->base + SSCH_GATE);
+	return ret;
+}
+
+int zx279133_native_ssch_global_get(struct zx279133_eth *eth,
+				    struct zte_nppt_ssch_global *config)
+{
+	u32 value;
+
+	if (!config)
+		return -EINVAL;
+	mutex_lock(&eth->np_ind_lock);
+	value = readl(eth->base + ZX279133_SSCH_CFG);
+	*config = (struct zte_nppt_ssch_global) {
+		.shaping = !!(value & BIT(0)), .dwrr = !!(value & BIT(1)),
+		.fill_time = readl(eth->base + ZX279133_SSCH_FILL_TIME) &
+			     ZX279133_SSCH_FILL_TIME_MASK,
+	};
+	mutex_unlock(&eth->np_ind_lock);
+	return 0;
+}
+
+int zx279133_native_ssch_global_set(struct zx279133_eth *eth,
+				    const struct zte_nppt_ssch_global *config)
+{
+	u32 value;
+
+	if (!config || config->fill_time > ZX279133_SSCH_FILL_TIME_MASK)
+		return -EINVAL;
+	mutex_lock(&eth->np_ind_lock);
+	value = readl(eth->base + ZX279133_SSCH_FILL_TIME);
+	writel((value & ~ZX279133_SSCH_FILL_TIME_MASK) | config->fill_time,
+	       eth->base + ZX279133_SSCH_FILL_TIME);
+	value = readl(eth->base + ZX279133_SSCH_CFG);
+	writel((value & ~GENMASK(1, 0)) | (u32)config->shaping |
+	       (u32)config->dwrr << 1, eth->base + ZX279133_SSCH_CFG);
+	mutex_unlock(&eth->np_ind_lock);
+	return 0;
+}
+
+static int zx279133_ssch_mode_io(struct zx279133_eth *eth, u8 port, u8 queue,
+				 u8 *mode_bit, bool write)
+{
+	u32 reg, value, bit;
+
+	if (!mode_bit || port > 7 || queue > 7 || (write && *mode_bit > 1))
+		return -EINVAL;
+	reg = port < 4 ? SSCH_MODE0 : SSCH_MODE1;
+	bit = BIT((port % 4) * 8 + queue);
+	/* ssch_regtable_init expands descriptor 18 to all 32 bits on CPU133. */
+	mutex_lock(&eth->np_ind_lock);
+	value = readl(eth->base + reg);
+	if (write)
+		writel((value & ~bit) | (*mode_bit ? bit : 0), eth->base + reg);
+	else
+		*mode_bit = !!(value & bit);
+	mutex_unlock(&eth->np_ind_lock);
+	return 0;
+}
+
+int zx279133_native_ssch_mode_get(struct zx279133_eth *eth, u8 port, u8 queue,
+				  u8 *mode_bit)
+{
+	return zx279133_ssch_mode_io(eth, port, queue, mode_bit, false);
+}
+
+int zx279133_native_ssch_mode_set(struct zx279133_eth *eth, u8 port, u8 queue,
+				  u8 mode_bit)
+{
+	return zx279133_ssch_mode_io(eth, port, queue, &mode_bit, true);
+}
+
+static int zx279133_ssch_weight_io(struct zx279133_eth *eth, u8 port, u8 queue,
+				   u32 *weight, bool write)
+{
+	int ret;
+
+	if (!weight || port > 7 || queue > 7 ||
+	    (write && *weight > GENMASK(17, 0)))
+		return -EINVAL;
+	mutex_lock(&eth->np_ind_lock);
+	ret = zx279133_ssch_ind(eth, 0, port * 8 + queue, weight, write);
+	mutex_unlock(&eth->np_ind_lock);
+	return ret;
+}
+
+int zx279133_native_ssch_weight_get(struct zx279133_eth *eth, u8 port, u8 queue,
+				    u32 *weight)
+{
+	return zx279133_ssch_weight_io(eth, port, queue, weight, false);
+}
+
+int zx279133_native_ssch_weight_set(struct zx279133_eth *eth, u8 port, u8 queue,
+				    u32 weight)
+{
+	return zx279133_ssch_weight_io(eth, port, queue, &weight, true);
+}
+
+static int zx279133_ssch_shaper_io(struct zx279133_eth *eth, u8 port, u8 queue,
+				   struct zte_nppt_ssch_shaper *shaper,
+				   bool per_queue, bool write, bool exact)
+{
+	struct zte_nppt_ssch_shaper result;
+	u8 index = per_queue ? port * 8 + queue : port;
+	u8 fill_ram = per_queue ? 3 : 1;
+	u32 reg, bit, value, fill, cap;
+	int ret;
+
+	if (!shaper || port > 7 || queue > 7 ||
+	    (write && !exact && (shaper->fill > GENMASK(28, 0) ||
+		       shaper->cap > GENMASK(20, 0))))
+		return -EINVAL;
+	reg = per_queue ? (index < 32 ? SSCH_QUEUE_ENABLE0 : SSCH_QUEUE_ENABLE1) :
+			 ZX279133_SSCH_CFG;
+	bit = per_queue ? BIT(index % 32) : BIT(port + 2);
+	mutex_lock(&eth->np_ind_lock);
+	value = readl(eth->base + reg);
+	if (write) {
+		/* OEM queue/port setters quiesce this shaper before replacement. */
+		writel(value & ~bit, eth->base + reg);
+		fill = shaper->fill;
+		cap = shaper->cap;
+	} else {
+		result.enabled = !!(value & bit);
+	}
+	ret = zx279133_ssch_ind(eth, fill_ram, index, &fill, write);
+	if (ret)
+		goto out;
+	ret = zx279133_ssch_ind(eth, fill_ram + 1, index, &cap, write);
+	if (ret)
+		goto out;
+	if (write) {
+		value = readl(eth->base + reg) & ~bit;
+		writel(value | (shaper->enabled ? bit : 0), eth->base + reg);
+	} else {
+		result.fill = fill;
+		result.cap = cap;
+		*shaper = result;
+	}
+out:
+	mutex_unlock(&eth->np_ind_lock);
+	return ret;
+}
+
+int zx279133_native_ssch_queue_get(struct zx279133_eth *eth, u8 port, u8 queue,
+				   struct zte_nppt_ssch_shaper *shaper)
+{
+	return zx279133_ssch_shaper_io(eth, port, queue, shaper, true, false, false);
+}
+
+int zx279133_native_ssch_queue_set(struct zx279133_eth *eth, u8 port, u8 queue,
+				   const struct zte_nppt_ssch_shaper *shaper)
+{
+	struct zte_nppt_ssch_shaper config;
+
+	if (!shaper)
+		return -EINVAL;
+	config = *shaper;
+	return zx279133_ssch_shaper_io(eth, port, queue, &config, true, true, false);
+}
+
+int zx279133_native_ssch_port_get(struct zx279133_eth *eth, u8 port,
+				  struct zte_nppt_ssch_shaper *shaper)
+{
+	return zx279133_ssch_shaper_io(eth, port, 0, shaper, false, false, false);
+}
+
+int zx279133_native_ssch_port_set(struct zx279133_eth *eth, u8 port,
+				  const struct zte_nppt_ssch_shaper *shaper)
+{
+	struct zte_nppt_ssch_shaper config;
+
+	if (!shaper)
+		return -EINVAL;
+	config = *shaper;
+	return zx279133_ssch_shaper_io(eth, port, 0, &config, false, true, false);
+}
+
+/* Manager-only exact snapshots: never exposed as an arbitrary RAM writer. */
+int zx279133_native_ssch_exact_set(struct zx279133_eth *eth, u8 port, u8 queue,
+				   const struct zte_nppt_ssch_shaper *shaper)
+{
+	struct zte_nppt_ssch_shaper copy = *shaper;
+
+	return zx279133_ssch_shaper_io(eth, port,
+				     queue == ZTE_NPPT_SHAPER_PORT ? 0 : queue,
+				     &copy, queue != ZTE_NPPT_SHAPER_PORT, true, true);
+}
+
+void zx279133_native_ssch_disable(struct zx279133_eth *eth, u8 port, u8 queue)
+{
+	u32 index = port * 8 + queue;
+	u32 reg, bit;
+
+	if (queue == ZTE_NPPT_SHAPER_PORT) {
+		reg = ZX279133_SSCH_CFG;
+		bit = BIT(port + 2);
+	} else {
+		reg = index < 32 ? SSCH_QUEUE_ENABLE0 : SSCH_QUEUE_ENABLE1;
+		bit = BIT(index % 32);
+	}
+	mutex_lock(&eth->np_ind_lock);
+	writel(readl(eth->base + reg) & ~bit, eth->base + reg);
+	/* Flush the disable before the caller shuts down the working clock. */
+	readl(eth->base + reg);
+	mutex_unlock(&eth->np_ind_lock);
+}
