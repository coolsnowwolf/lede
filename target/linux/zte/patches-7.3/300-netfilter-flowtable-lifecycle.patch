 static void nf_flow_offload_work_gc(struct work_struct *work)
 {
-	struct nf_flowtable *flow_table;
-
-	flow_table = container_of(work, struct nf_flowtable, gc_work.work);
-	nf_flow_table_gc_run(flow_table);
-	queue_delayed_work(system_power_efficient_wq, &flow_table->gc_work, HZ);
+	struct nf_flowtable *table = container_of(work, struct nf_flowtable, gc_work.work);
+#ifdef CONFIG_NF_FLOW_TABLE_SUMMARY
+	u64 now = ktime_to_ms(ktime_get_boottime());
+	bool due = !table->stats_polled_ms || now - table->stats_polled_ms >= 3000;
+
+	/* Only shared hardware/interface counters use the existing GC cadence.
+	 * HW/SW connection totals are updated on lifecycle changes, not sampled.
+	 */
+	if (due)
+		table->stats_aggregate = nf_flow_offload_stats_aggregate(table);
+	nf_flow_table_iterate(table, nf_flow_offload_gc_step,
+			      due && !table->stats_aggregate ? table : NULL);
+	if (due) {
+		table->stats_polled_ms = now;
+		if (!table->stats_aggregate)
+			nf_flow_offload_stats_flush();
+	}
+#else
+	nf_flow_table_gc_run(table);
+#endif
+	queue_delayed_work(system_power_efficient_wq, &table->gc_work, HZ);
 }
 
