+		iowrite16be(i, eth->bmu_mem + 2 * i);
+	for (i = 0; i < ZX279133_BMU_JUMBO_COUNT; i++)
+		iowrite16be(i, eth->bmu_mem + ZX279133_BMU_JUMBO_BPPE_OFFSET +
+			    2 * i);
