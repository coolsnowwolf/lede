Subject: [PATCH] arm64: dts: add the ZX279133 SR1010 board

--- a/Documentation/devicetree/bindings/arm/zte.yaml
+++ b/Documentation/devicetree/bindings/arm/zte.yaml
@@ -11,7 +11,7 @@
 
 description: |
   ARM platforms using SoCs designed by ZTE. Currently this supports devices
-  based on the zx297520v3 SoC which is found in LTE routers.
+  based on zx297520v3 and zx279133 SoCs.
 
 properties:
   $nodename:
@@ -19,6 +19,9 @@
   compatible:
     oneOf:
       - items:
+          - const: zte,zx279133-sr1010
+          - const: zte,zx279133
+      - items:
           - enum:
               - dlink,dwr932m
           - const: zte,zx297520v3
--- a/arch/arm64/boot/dts/Makefile
+++ b/arch/arm64/boot/dts/Makefile
@@ -40,3 +40,4 @@
 subdir-y += ti
 subdir-y += toshiba
 subdir-y += xilinx
+subdir-y += zte
--- /dev/null
+++ b/arch/arm64/boot/dts/zte/Makefile
@@ -0,0 +1,2 @@
+# SPDX-License-Identifier: GPL-2.0
+dtb-y += zx279133-sr1010.dtb
--- /dev/null
+++ b/arch/arm64/boot/dts/zte/zx279133-sr1010.dts
@@ -0,0 +1,303 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
+#include "zx279133.dtsi"
+
+/ {
+	model = "ZTE ZXSLC SR1010";
+	compatible = "zte,zx279133-sr1010", "zte,zx279133";
+
+	aliases {
+		serial0 = &uart0;
+		watchdog0 = &watchdog0;
+		watchdog1 = &watchdog1;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x20000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		se_hash_reserved: buffer@9e100000 {
+			reg = <0x0 0x9e100000 0x0 0x1000000>;
+			no-map;
+		};
+
+		idm_reserved: buffer@9d700000 {
+			reg = <0x0 0x9d700000 0x0 0xa00000>;
+			no-map;
+		};
+
+		bmu_reserved: buffer@9f100000 {
+			reg = <0x0 0x9f100000 0x0 0x0f00000>;
+			no-map;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		label = "SR1010 reset button";
+
+		button-reset {
+			debounce-interval = <50>;
+			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-white {
+			color = <LED_COLOR_ID_WHITE>;
+			default-state = "keep";
+			function = LED_FUNCTION_STATUS;
+			gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
+			label = "sr1010:white";
+			retain-state-shutdown;
+		};
+
+		led-red {
+			color = <LED_COLOR_ID_RED>;
+			default-state = "keep";
+			function = LED_FUNCTION_STATUS;
+			gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;
+			label = "sr1010:red";
+			retain-state-shutdown;
+		};
+
+		led-wan {
+			default-state = "off";
+			function = LED_FUNCTION_WAN;
+			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
+			label = "sr1010:wan";
+			linux,default-trigger = "netdev";
+		};
+
+		led-lan1 {
+			default-state = "off";
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <1>;
+			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
+			label = "sr1010:lan1";
+			linux,default-trigger = "netdev";
+		};
+
+		led-lan2 {
+			default-state = "off";
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <2>;
+			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
+			label = "sr1010:lan2";
+			linux,default-trigger = "netdev";
+		};
+
+		led-lan3 {
+			default-state = "off";
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <3>;
+			gpios = <&gpio4 4 GPIO_ACTIVE_LOW>;
+			label = "sr1010:lan3";
+			linux,default-trigger = "netdev";
+		};
+
+		led-lan4 {
+			default-state = "off";
+			function = LED_FUNCTION_LAN;
+			function-enumerator = <4>;
+			gpios = <&gpio4 5 GPIO_ACTIVE_LOW>;
+			label = "sr1010:lan4";
+			linux,default-trigger = "netdev";
+		};
+	};
+
+	thermal-zones {
+		soc-thermal {
+			thermal-sensors = <&pvt>;
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&usb3 {
+	status = "okay";
+};
+
+&pvt {
+	status = "okay";
+};
+
+&pon_serdes {
+	status = "okay";
+};
+
+&uni_serdes {
+	status = "okay";
+};
+
+&nppt {
+	nvmem-cells = <&factory_mac>;
+	nvmem-cell-names = "mac-address";
+	memory-region = <&bmu_reserved>, <&se_hash_reserved>, <&idm_reserved>;
+	memory-region-names = "bmu", "se-hash", "idm";
+	phy-handle = <&zx279051>;
+	status = "okay";
+
+	lan_cpu: ethernet-lan-cpu {
+		compatible = "zte,zx279133-lan-conduit";
+		/*
+		 * No address of its own: the conduit, the switch ports and the
+		 * bridge keep the WAN address, as the factory firmware does
+		 * (br0, eth0..4 and nbif0 share one MAC there). The hardware writes
+		 * a single source MAC into routed frames, the CPU/WAN MAC of its
+		 * WANID table, and the flow offload refuses a WAN-to-LAN flow
+		 * whose source MAC is another one, so a separate LAN address left
+		 * every download on the software path. factory_lan_mac (tag 0x0101)
+		 * stays available below for a board that wants one.
+		 */
+	};
+
+	switch {
+		compatible = "zte,zx279133-rtl8372n";
+		zte,mdio-handle = <&rtl8372n_smi>;
+		reset-gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/* Chassis LAN1..LAN4 correspond to switch ports 4..7. */
+			port@4 {
+				reg = <4>;
+				label = "lan1";
+				phy-mode = "internal";
+			};
+
+			port@5 {
+				reg = <5>;
+				label = "lan2";
+				phy-mode = "internal";
+			};
+
+			port@6 {
+				reg = <6>;
+				label = "lan3";
+				phy-mode = "internal";
+			};
+
+			port@7 {
+				reg = <7>;
+				label = "lan4";
+				phy-mode = "internal";
+			};
+
+			port@8 {
+				reg = <8>;
+				ethernet = <&lan_cpu>;
+				phy-mode = "10gbase-r";
+
+				fixed-link {
+					speed = <10000>;
+					full-duplex;
+				};
+			};
+		};
+	};
+};
+
+&mdio0 {
+	status = "okay";
+
+	rtl8372n_smi: switch-controller@1d {
+		compatible = "realtek,rtl8372n";
+		reg = <0x1d>;
+	};
+};
+
+&mdio1 {
+	status = "okay";
+
+	zx279051: ethernet-phy@1 {
+		compatible = "ethernet-phy-id0000.84b9";
+		reg = <1>;
+		max-speed = <2500>;
+		reset-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <100000>;
+		reset-deassert-us = <100000>;
+	};
+};
+
+&xpcs0 {
+	status = "okay";
+};
+
+&xpcs1 {
+	status = "okay";
+};
+
+&watchdog1 {
+	status = "okay";
+};
+
+&spifc {
+	/*
+	 * 25 MHz was the bring-up value. 50 MHz is the first step up from it; the
+	 * reads have to be checked against the contents read at 25 MHz.
+	 */
+	spi-max-frequency = <50000000>;
+	status = "okay";
+
+	flash@0 {
+		partitions-only;
+		spi-max-frequency = <50000000>;
+		/* Read with four data lines (6Bh); the commands and addresses stay on one. */
+		spi-rx-bus-width = <4>;
+
+		partitions {
+			partition@100000 {
+				nvmem-layout {
+					compatible = "zte,sr1010-tags";
+
+					factory_mac: mac-address {
+					};
+
+					factory_lan_mac: mac-address-lan {
+					};
+				};
+			};
+
+			partition@200000 {
+				/delete-property/ read-only;
+			};
+
+			partition@600000 {
+				/delete-property/ read-only;
+			};
+
+			partition@2f00000 {
+				/delete-property/ read-only;
+			};
+
+			partition@5800000 {
+				/delete-property/ read-only;
+			};
+		};
+	};
+};
--- /dev/null
+++ b/arch/arm64/boot/dts/zte/zx279133.dtsi
@@ -0,0 +1,591 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+
+#include <dt-bindings/clock/zte,zx279133-lsp.h>
+#include <dt-bindings/clock/zte,zx279133-topcrm.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/reset/zte,zx279133-lsp.h>
+#include <dt-bindings/reset/zte,zx279133-topcrm.h>
+
+/ {
+	compatible = "zte,zx279133";
+	#address-cells = <2>;
+	#size-cells = <2>;
+	interrupt-parent = <&gic>;
+
+	osc25m: oscillator-25m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <25000000>;
+	};
+
+	/* Firmware leaves these PLL roots fixed during the mainline handoff. */
+	pll_lsp: clock-pll-lsp-2000m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <2000000000>;
+		clock-output-names = "pll_lsp_2000m";
+	};
+
+	pll_1376m: clock-pll-1376m256 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <1376256000>;
+		clock-output-names = "pll_1376m_clk";
+	};
+
+	pll_fpp: clock-pll-fpp-2500m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <2500000000>;
+		clock-output-names = "pll_fpp_2500m_clk";
+	};
+
+	/* Factory CPU PLL programming and CPU supply are provided by TOPCRM/PWM. */
+	cpu_opp_table: opp-table-cpu {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		/* Factory's 400 MHz mux-only path has no verified voltage OPP. */
+		opp-500000000 {
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <842000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-688128000 {
+			/* Factory's nominal 688 MHz, from 1376.256 MHz / 2. */
+			opp-hz = /bits/ 64 <688128000>;
+			opp-microvolt = <850000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-900000000 {
+			opp-hz = /bits/ 64 <900000000>;
+			opp-microvolt = <858000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1000000000 {
+			opp-hz = /bits/ 64 <1000000000>;
+			opp-microvolt = <858000>;
+			clock-latency-ns = <300000>;
+		};
+
+		opp-1100000000 {
+			opp-hz = /bits/ 64 <1100000000>;
+			opp-microvolt = <865000>;
+			clock-latency-ns = <310000>;
+		};
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <873000>;
+			clock-latency-ns = <290000>;
+		};
+
+		opp-1300000000 {
+			opp-hz = /bits/ 64 <1300000000>;
+			opp-microvolt = <873000>;
+			clock-latency-ns = <290000>;
+		};
+
+		/* 2.8 GHz CPU PLL output divided by two for the A53 clock. */
+		opp-1400000000 {
+			opp-hz = /bits/ 64 <1400000000>;
+			opp-microvolt = <881000>;
+		};
+	};
+
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		cpu@0 {
+			compatible = "arm,cortex-a53";
+			device_type = "cpu";
+			reg = <0x0 0x0>;
+			clocks = <&topcrm ZX279133_TOPCRM_CLK_A53_MCLK>;
+			cpu-supply = <&cpu_regulator>;
+			operating-points-v2 = <&cpu_opp_table>;
+			enable-method = "psci";
+		};
+
+		cpu@1 {
+			compatible = "arm,cortex-a53";
+			device_type = "cpu";
+			reg = <0x0 0x1>;
+			clocks = <&topcrm ZX279133_TOPCRM_CLK_A53_MCLK>;
+			cpu-supply = <&cpu_regulator>;
+			operating-points-v2 = <&cpu_opp_table>;
+			enable-method = "psci";
+		};
+	};
+
+	psci {
+		compatible = "arm,psci-0.2";
+		method = "smc";
+	};
+
+	gic: interrupt-controller@500000 {
+		compatible = "arm,gic-v3";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		#interrupt-cells = <3>;
+		interrupt-controller;
+		reg = <0x0 0x00500000 0x0 0x10000>,
+		      <0x0 0x00540000 0x0 0x80000>;
+		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(2) |
+				 IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(2) |
+				 IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(2) |
+				 IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(2) |
+				 IRQ_TYPE_LEVEL_LOW)>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		topcrm: clock-controller@10e10000 {
+			compatible = "zte,zx279133-topcrm", "syscon";
+			reg = <0x0 0x10e10000 0x0 0x60>,
+			      <0x0 0x10e10080 0x0 0x10>;
+			reg-names = "topcrm", "cpu-pll";
+			clocks = <&osc25m>, <&pll_lsp>, <&pll_1376m>, <&pll_fpp>;
+			clock-names = "osc25m", "pll-lsp", "pll-1376m",
+				      "pll-fpp";
+			#clock-cells = <1>;
+		};
+
+		idm_cci: syscon@10e00078 {
+			compatible = "zte,zx279133-idm-cci", "syscon";
+			reg = <0x0 0x10e00078 0x0 0x8>;
+		};
+
+		top_reset: reset-controller@10e10060 {
+			compatible = "zte,zx296718-reset";
+			reg = <0x0 0x10e10060 0x0 0x4>;
+			#reset-cells = <1>;
+		};
+
+		local_reset: reset-controller@10e10070 {
+			compatible = "zte,zx296718-reset";
+			reg = <0x0 0x10e10070 0x0 0x8>;
+			#reset-cells = <1>;
+		};
+
+		topcrm_wdt: syscon@10e10208 {
+			compatible = "zte,zx279133-wdt-reset", "syscon";
+			reg = <0x0 0x10e10208 0x0 0x4>;
+		};
+
+		lsp0_clk: clock-controller@10d00000 {
+			compatible = "zte,zx279133-lsp-clk", "syscon";
+			reg = <0x0 0x10d00000 0x0 0x100>;
+			clocks = <&topcrm ZX279133_TOPCRM_CLK_LSP0_PCLK>,
+				 <&topcrm ZX279133_TOPCRM_CLK_LSP0_25M>,
+				 <&topcrm ZX279133_TOPCRM_CLK_LSP0_100M>,
+				 <&topcrm ZX279133_TOPCRM_CLK_SPIFC_WCLK>;
+			clock-names = "pclk", "wclk25", "wclk100", "spifc_wclk";
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		uart0: serial@10d0d000 {
+			compatible = "zte,zx279133-uart", "arm,pl011",
+				     "arm,primecell";
+			arm,primecell-periphid = <0x001feffe>;
+			reg = <0x0 0x10d0d000 0x0 0x1000>;
+			interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&lsp0_clk ZX279133_LSP_CLK_UART0_WCLK>,
+				 <&lsp0_clk ZX279133_LSP_CLK_UART0_PCLK>;
+			clock-names = "uartclk", "apb_pclk";
+			resets = <&lsp0_clk ZX279133_LSP_RESET_UART0>;
+			assigned-clocks = <&lsp0_clk ZX279133_LSP_CLK_UART0_WCLK>;
+			assigned-clock-parents =
+				<&topcrm ZX279133_TOPCRM_CLK_LSP0_25M>;
+			assigned-clock-rates = <25000000>;
+			status = "disabled";
+		};
+
+		pvt: temperature-sensor@10e70000 {
+			compatible = "zte,zx279133-pvt";
+			reg = <0x0 0x10e70000 0x0 0x10000>;
+			clocks = <&topcrm ZX279133_TOPCRM_CLK_PVT_PCLK>,
+				 <&topcrm ZX279133_TOPCRM_CLK_TEMPSENSOR_WCLK>;
+			clock-names = "pclk", "wclk";
+			nvmem-cells = <&pvt_ttrim>;
+			nvmem-cell-names = "ttrim";
+			#thermal-sensor-cells = <0>;
+			status = "disabled";
+		};
+
+		pinctrl: pinctrl@10e20000 {
+			compatible = "zte,zx279133-pinctrl";
+			reg = <0x0 0x10e20000 0x0 0x1000>;
+
+			spifc_pins: spifc-pins {
+				function = "spifc";
+				pins = "p3-9", "p3-10", "p3-11", "p3-12",
+				       "p4-0", "p4-1";
+			};
+
+			pwm_pins: pwm-pins {
+				function = "pwm";
+				pins = "p0-8", "p0-9", "p0-13";
+			};
+		};
+
+		gpio0: gpio@10d10000 {
+			compatible = "zte,zx279133-gpio";
+			reg = <0x0 0x10d10000 0x0 0x40>;
+			interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 14 1>, <&pinctrl 1 0 14>,
+				      <&pinctrl 15 15 1>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio1: gpio@10d10040 {
+			compatible = "zte,zx279133-gpio";
+			reg = <0x0 0x10d10040 0x0 0x40>;
+			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 16 9>, <&pinctrl 9 66 4>,
+				      <&pinctrl 13 25 3>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio2: gpio@10d10080 {
+			compatible = "zte,zx279133-gpio";
+			reg = <0x0 0x10d10080 0x0 0x40>;
+			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 28 16>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio3: gpio@10d100c0 {
+			compatible = "zte,zx279133-gpio";
+			reg = <0x0 0x10d100c0 0x0 0x40>;
+			interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 44 16>;
+			ngpios = <16>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		gpio4: gpio@10d10100 {
+			compatible = "zte,zx279133-gpio";
+			reg = <0x0 0x10d10100 0x0 0x40>;
+			interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
+			gpio-controller;
+			#gpio-cells = <2>;
+			gpio-ranges = <&pinctrl 0 60 6>;
+			ngpios = <6>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		spifc: spi@10d0f000 {
+			compatible = "zte,zx279133-sfc";
+			reg = <0x0 0x10d0f000 0x0 0x1000>;
+			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&lsp0_clk ZX279133_LSP_CLK_SPIFC_PCLK>,
+				 <&lsp0_clk ZX279133_LSP_CLK_SPIFC_WCLK>;
+			clock-names = "pclk", "wclk";
