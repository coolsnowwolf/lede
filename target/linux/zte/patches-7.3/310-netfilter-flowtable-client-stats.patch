Subject: [PATCH] netfilter: flowtable: add aggregate client statistics

Provide optional in-kernel client counters and their proc interface.
Use the lifecycle and accounting interfaces from the preceding patch.

--- a/net/netfilter/Kconfig
+++ b/net/netfilter/Kconfig
@@ -725,6 +725,16 @@
 
 	  To compile it as a module, choose M here.
 
+config NF_FLOW_TABLE_CLIENT_STATS
+	bool "Per-client software and hardware flow offload statistics"
+	depends on NF_FLOW_TABLE && PROC_FS
+	select NF_FLOW_TABLE_PROCFS
+	help
+	  Export one per-MAC statistics snapshot at /proc/net/nf_flowtable_clients.
+	  Software fast-path IP bytes and hardware driver statistics are merged
+	  in the kernel. Sampling is on demand, at most once every three seconds.
+	  No user-space sampler or per-packet MAC lookup is required.
+
 config NF_FLOW_TABLE_PROCFS
 	bool "Supply flow table statistics in procfs"
 	depends on NF_FLOW_TABLE
--- a/net/netfilter/Makefile
+++ b/net/netfilter/Makefile
@@ -245,3 +245,5 @@
 ifdef CONFIG_GCOV_PROFILE_NETFILTER
 GCOV_PROFILE := y
 endif
+
+nf_flow_table-$(CONFIG_NF_FLOW_TABLE_CLIENT_STATS) += nf_flow_table_clients.o
--- /dev/null
+++ b/net/netfilter/nf_flow_table_clients.c
@@ -0,0 +1,644 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Per-client accounting shared by software and hardware flow offload. */
+#include <linux/refcount.h>
+#include <linux/etherdevice.h>
+#include <linux/hashtable.h>
+#include <linux/hex.h>
+#include <linux/jhash.h>
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/seq_file.h>
+#include <linux/fs.h>
+#include <linux/proc_fs.h>
+#include <linux/string.h>
+#include <net/neighbour.h>
+#include <net/netfilter/nf_conntrack.h>
+#include <net/netfilter/nf_flow_table.h>
+
+#define NF_FLOW_CLIENT_LIMIT 1024
+#define NF_FLOW_ENDPOINT_LIMIT 4096
+
+struct nf_flow_client {
+	struct list_head list;
+	u8 mac[ETH_ALEN];
+	struct hlist_node hash;
+	struct nf_flow_client *parent;
+	union nf_inet_addr address;
+	u32 ifindex;
+	u8 family;
+	/* [software/hardware][upload/download], IP bytes in both paths. */
+	atomic64_t bytes[2][2];
+	atomic_t connections;
+	atomic_t hw_connections;
+	atomic_t hw_partial_connections;
+	/* Candidate reservations and installed HW flows; table->lock held. */
+	u32 hw_limit;
+	u32 hw_slots;
+	u64 previous[2];
+	u64 total[2];
+	u64 rate[2];
+	u32 sampled_connections;
+	u32 sampled_hw_connections;
+	u32 sampled_hw_partial_connections;
+};
+
+struct nf_flow_clients {
+	refcount_t refs;
+	struct net *net;
+	bool dead;
+	spinlock_t lock;
+	struct list_head records;
+	u32 count;
+	u32 endpoint_count;
+	DECLARE_HASHTABLE(endpoints, 8);
+	DECLARE_HASHTABLE(macs, 8);
+	u32 errors;
+	atomic_t stats_errors;
+	/* One per logical flow, independent of endpoint/MAC multiplicity. */
+	atomic_t connections;
+	atomic_t hw_connections;
+	u32 sampled_connections;
+	u32 sampled_hw_connections;
+};
+
+static struct nf_flow_client *
+nf_flow_client_get(struct nf_flow_clients *table, const u8 *mac)
+{
+	struct nf_flow_client *client;
+	u32 hash = jhash(mac, ETH_ALEN, 0);
+
+	/* Flow insertion only; packet accounting uses the existing flow refs. */
+	hash_for_each_possible(table->macs, client, hash, hash)
+		if (ether_addr_equal(client->mac, mac))
+			return client;
+	if (table->count >= NF_FLOW_CLIENT_LIMIT)
+		return NULL;
+	client = kzalloc(sizeof(*client), GFP_ATOMIC);
+	if (!client)
+		return NULL;
+	ether_addr_copy(client->mac, mac);
+	hash_add(table->macs, &client->hash, hash);
+	list_add_tail_rcu(&client->list, &table->records);
+	table->count++;
+	return client;
+}
+
+/* Only flow insertion performs this lookup; packet accounting keeps its refs. */
+static struct nf_flow_client *
+nf_flow_endpoint_get(struct nf_flow_clients *table, struct nf_flow_client *parent,
+		     struct flow_offload *flow, int dir)
+{
+	const struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+	const union nf_inet_addr *source = &flow->ct->tuplehash[!dir].tuple.src.u3;
+	union nf_inet_addr address = {};
+	struct net_device *dev, *master;
+	struct nf_flow_client *client;
+	u32 ifindex, hash;
+
+	dev = tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT ?
+		dev_get_by_index_rcu(nf_ct_net(flow->ct), tuple->out.ifidx) :
+		tuple->dst_cache->dev;
+	if (!dev)
+		return NULL;
+	master = netdev_master_upper_dev_get_rcu(dev);
+	ifindex = master && netif_is_bridge_master(master) ? master->ifindex : dev->ifindex;
+	if (tuple->l3proto == NFPROTO_IPV4)
+		address.ip = source->ip;
+	else if (tuple->l3proto == NFPROTO_IPV6)
+		address = *source;
+	else
+		return NULL;
+	hash = jhash2(address.all, ARRAY_SIZE(address.all), ifindex ^ tuple->l3proto) ^
+		jhash(parent->mac, ETH_ALEN, 0);
+	hash_for_each_possible(table->endpoints, client, hash, hash) {
+		if (client->parent == parent && client->ifindex == ifindex &&
+		    client->family == tuple->l3proto &&
+		    !memcmp(&client->address, &address, sizeof(address)))
+			return client;
+	}
+	if (table->endpoint_count >= NF_FLOW_ENDPOINT_LIMIT)
+		return NULL;
+	client = kzalloc(sizeof(*client), GFP_ATOMIC);
+	if (!client)
+		return NULL;
+	client->parent = parent;
+	client->address = address;
+	client->family = tuple->l3proto;
+	client->ifindex = ifindex;
+	ether_addr_copy(client->mac, parent->mac);
+	hash_add(table->endpoints, &client->hash, hash);
+	list_add_tail_rcu(&client->list, &table->records);
+	table->endpoint_count++;
+	return client;
+}
+
+static struct nf_flow_client *
+nf_flow_client_ref(struct flow_offload *flow, int level, int dir)
+{
+	return level ? flow->client_ip[dir] : flow->client[dir];
+}
+
+/* One slot per logical connection, even when both directions/endpoints match.
+ * Reservations prevent concurrent ADD workers from oversubscribing a limit.
+ * Existing slots survive policy changes and client deactivation until actual
+ * hardware removal (or final flow free) has completed.
+ */
+static int nf_flow_clients_reserve_locked(struct flow_offload *flow)
+{
+	struct nf_flow_client *c;
+	int d;
+
+	if (flow->client_hw_slot)
+		return 0;
+	for (d = 0; d < FLOW_OFFLOAD_DIR_MAX; d++) {
+		c = flow->client[d];
+		if (!c || (d && c == flow->client[0]))
+			continue;
+		if (c->hw_limit && c->hw_slots >= c->hw_limit)
+			return -EDQUOT;
+	}
+	for (d = 0; d < FLOW_OFFLOAD_DIR_MAX; d++) {
+		c = flow->client[d];
+		if (c && (!d || c != flow->client[0]))
+			c->hw_slots++;
+	}
+	flow->client_hw_slot = true;
+	return 0;
+}
+
+static void nf_flow_clients_slot_put_locked(struct flow_offload *flow)
+{
+	struct nf_flow_client *c;
+	int d;
+
+	if (!flow->client_hw_slot)
+		return;
+	for (d = 0; d < FLOW_OFFLOAD_DIR_MAX; d++) {
+		c = flow->client[d];
+		if (c && (!d || c != flow->client[0])) {
+			if (WARN_ON_ONCE(!c->hw_slots))
+				continue;
+			c->hw_slots--;
+		}
+	}
+	flow->client_hw_slot = false;
+}
+
+/* A failed/uncertain MMIO delete must not create a reusable quota slot. */
+static bool nf_flow_clients_slot_safe(struct flow_offload *flow)
+{
+	int d, error;
+
+	for (d = 0; d < FLOW_OFFLOAD_DIR_MAX; d++) {
+		if (flow->hw[d].state == NF_FLOW_HW_QUARANTINED)
+			return false;
+		error = flow->hw[d].error;
+		if (error && error != -EAGAIN && error != -ENOSPC &&
+		    error != -ENOMEM && error != -EOPNOTSUPP && error != -EEXIST &&
+		    error != -ENETDOWN && error != -ENOENT && error != -EDQUOT)
+			return false;
+	}
+	return true;
+}
+
+int nf_flow_clients_reserve(struct flow_offload *flow)
+{
+	struct nf_flow_clients *table = nf_ct_net(flow->ct)->ft.clients;
+	int ret;
+
+	if (READ_ONCE(flow->client_hw_slot))
+		return 0;
+	spin_lock_bh(&table->lock);
+	spin_lock_bh(&flow->hw_lock);
+	ret = flow->client_active ? nf_flow_clients_reserve_locked(flow) : -ENOENT;
+	spin_unlock_bh(&flow->hw_lock);
+	spin_unlock_bh(&table->lock);
+	return ret;
+}
+
+static bool nf_flow_client_mac(struct flow_offload *flow, int dir, u8 *mac)
+{
+	const struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+	struct net *net = nf_ct_net(flow->ct);
+	struct net_device *dev;
+	struct neighbour *neigh;
+	bool found = false;
+
+	if (tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT) {
+		dev = dev_get_by_index_rcu(net, tuple->out.ifidx);
+		if (!dev || (!netif_is_bridge_port(dev) &&
+			     !netif_is_bridge_master(dev)))
+			return false;
+		ether_addr_copy(mac, tuple->out.h_dest);
+		return is_valid_ether_addr(mac);
+	}
+	if (tuple->xmit_type != FLOW_OFFLOAD_XMIT_NEIGH ||
+	    !netif_is_bridge_master(tuple->dst_cache->dev))
+		return false;
+	/* The opposite conntrack source is the destination after NAT. */
+	neigh = dst_neigh_lookup(tuple->dst_cache,
+			&flow->ct->tuplehash[!dir].tuple.src.u3);
+	if (!neigh)
+		return false;
+	if (READ_ONCE(neigh->nud_state) & NUD_VALID) {
+		neigh_ha_snapshot(mac, neigh, neigh->dev);
+		found = is_valid_ether_addr(mac);
+	}
+	neigh_release(neigh);
+	return found;
+}
+
+int nf_flow_clients_bind(struct nf_flowtable *flowtable, struct flow_offload *flow)
+{
+	struct nf_flow_clients *table = nf_ct_net(flow->ct)->ft.clients;
+	u8 mac[ETH_ALEN];
+	int dir, level, ret = 0;
+
+	rcu_read_lock();
+	spin_lock_bh(&table->lock);
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		if (!nf_flow_client_mac(flow, dir, mac))
+			continue;
+		flow->client[dir] = nf_flow_client_get(table, mac);
+		if (!flow->client[dir]) {
+			table->errors++;
+			continue;
+		}
+		flow->client_ip[dir] = nf_flow_endpoint_get(table, flow->client[dir], flow, dir);
+		if (!flow->client_ip[dir])
+			table->errors++;
+	}
+	spin_lock_bh(&flow->hw_lock);
+	if (!test_bit(NF_FLOW_TEARDOWN, &flow->flags) &&
+	    !test_bit(NF_FLOW_CLOSING, &flow->flags)) {
+		if (nf_flowtable_hw_offload(flowtable)) {
+			ret = nf_flow_clients_reserve_locked(flow);
+			if (ret)
+				goto unlock;
+		}
+		flow->client_active = true;
+		atomic_inc(&table->connections);
+		for (level = 0; level < 2; level++)
+			for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+				struct nf_flow_client *client = nf_flow_client_ref(flow, level, dir);
+
+				if (client && (!dir || client != nf_flow_client_ref(flow, level, 0)))
+					atomic_inc(&client->connections);
+			}
+	}
+unlock:
+	spin_unlock_bh(&flow->hw_lock);
+	spin_unlock_bh(&table->lock);
+	rcu_read_unlock();
+	return ret;
+}
+
+static void nf_flow_clients_hw_locked(struct flow_offload *flow, u8 hw_mask)
+{
+	struct nf_flow_client *client;
+	u8 full_mask = test_bit(NF_FLOW_HW_BIDIRECTIONAL, &flow->flags) ? 3 : 1;
+	u8 old_mask = flow->client_hw_mask;
+	bool old_partial = old_mask && old_mask != full_mask;
+	bool partial = hw_mask && hw_mask != full_mask;
+	int dir, level;
+
+	if (!flow->client_active || hw_mask == old_mask)
+		return;
+	flow->client_hw_mask = hw_mask;
+	atomic_add(!!hw_mask - !!old_mask,
+		   &nf_ct_net(flow->ct)->ft.clients->hw_connections);
+	for (level = 0; level < 2; level++)
+		for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+			client = nf_flow_client_ref(flow, level, dir);
+			if (!client || (dir && client == nf_flow_client_ref(flow, level, 0)))
+				continue;
+			atomic_add(!!hw_mask - !!old_mask, &client->hw_connections);
+			atomic_add((int)partial - (int)old_partial,
+				   &client->hw_partial_connections);
+		}
+}
+
+void nf_flow_clients_hw(struct flow_offload *flow, u8 hw_mask)
+{
+	struct nf_flow_clients *table = nf_ct_net(flow->ct)->ft.clients;
+
+	/* Stable periodic STATS samples need no new shared-table lock. */
+	if (hw_mask && READ_ONCE(flow->client_hw_mask) == hw_mask)
+		return;
+	if (!hw_mask && !READ_ONCE(flow->client_hw_slot) &&
+	    !READ_ONCE(flow->client_hw_mask))
+		return;
+	spin_lock_bh(&table->lock);
+	spin_lock_bh(&flow->hw_lock);
+	nf_flow_clients_hw_locked(flow, hw_mask);
+	if (!hw_mask && nf_flow_clients_slot_safe(flow))
+		nf_flow_clients_slot_put_locked(flow);
+	spin_unlock_bh(&flow->hw_lock);
+	spin_unlock_bh(&table->lock);
+}
+
+void nf_flow_clients_deactivate(struct flow_offload *flow)
+{
+	int dir, level;
+
+	spin_lock_bh(&flow->hw_lock);
+	if (!flow->client_active)
+		goto out;
+	nf_flow_clients_hw_locked(flow, 0);
+	flow->client_active = false;
+	atomic_dec(&nf_ct_net(flow->ct)->ft.clients->connections);
+	for (level = 0; level < 2; level++)
+		for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+			struct nf_flow_client *client = nf_flow_client_ref(flow, level, dir);
+
+			if (client && (!dir || client != nf_flow_client_ref(flow, level, 0)))
+				atomic_dec(&client->connections);
+		}
+out:
+	spin_unlock_bh(&flow->hw_lock);
+}
+
+void nf_flow_clients_release(struct flow_offload *flow)
+{
+	struct nf_flow_clients *table = nf_ct_net(flow->ct)->ft.clients;
+
+	/* Final free follows hardware-work completion; also unwinds failed ADD. */
+	nf_flow_clients_deactivate(flow);
+	if (!flow->client_hw_slot)
+		return;
+	spin_lock_bh(&table->lock);
+	spin_lock_bh(&flow->hw_lock);
+	if (nf_flow_clients_slot_safe(flow))
+		nf_flow_clients_slot_put_locked(flow);
+	spin_unlock_bh(&flow->hw_lock);
+	spin_unlock_bh(&table->lock);
+}
+
+void nf_flow_clients_account(struct flow_offload *flow, int dir,
+			     u64 bytes, bool hardware)
+{
+	struct nf_flow_client *dst = flow->client_ip[dir] ?: flow->client[dir];
+	struct nf_flow_client *src = flow->client_ip[!dir] ?: flow->client[!dir];
+
+	/* Same two atomic additions as before; lookup happens only at bind time. */
+	if (dst)
+		atomic64_add(bytes, &dst->bytes[hardware][1]);
+	if (src)
+		atomic64_add(bytes, &src->bytes[hardware][0]);
+}
+
+/* Scope endpoints are stable until netns exit. Supplier leases pin the netns
+ * and module; a final counter can therefore settle even after flow teardown.
+ */
+void nf_flow_clients_account_scope(const void *source, const void *dest, u64 bytes)
+{
+	struct nf_flow_client *src = (struct nf_flow_client *)source;
+	struct nf_flow_client *dst = (struct nf_flow_client *)dest;
+
+	if (dst)
+		atomic64_add(bytes, &dst->bytes[1][1]);
+	if (src)
+		atomic64_add(bytes, &src->bytes[1][0]);
+}
+
+void nf_flow_clients_sample(struct net *net, u64 elapsed_ms)
+{
+	struct nf_flow_clients *table = net->ft.clients;
+	struct nf_flow_client *client;
+	u64 total;
+	int dir;
+
+	rcu_read_lock();
+	list_for_each_entry_rcu(client, &table->records, list)
+		if (!client->parent)
+			for (dir = 0; dir < 2; dir++)
+				client->total[dir] = atomic64_read(&client->bytes[0][dir]) +
+					atomic64_read(&client->bytes[1][dir]);
+	list_for_each_entry_rcu(client, &table->records, list) {
+		if (!client->parent)
+			continue;
+		for (dir = 0; dir < 2; dir++) {
+			total = atomic64_read(&client->bytes[0][dir]) +
+				atomic64_read(&client->bytes[1][dir]);
+			client->rate[dir] = elapsed_ms ?
+				mul_u64_u64_div_u64(total - client->previous[dir],
+						1000, elapsed_ms) : 0;
+			client->previous[dir] = total;
+			client->total[dir] = total;
+			client->parent->total[dir] += total;
+		}
+	}
+	list_for_each_entry_rcu(client, &table->records, list) {
+		if (!client->parent)
+			for (dir = 0; dir < 2; dir++) {
+				total = client->total[dir];
+				client->rate[dir] = elapsed_ms ?
+					mul_u64_u64_div_u64(total - client->previous[dir], 1000, elapsed_ms) : 0;
+				client->previous[dir] = total;
+			}
+		client->sampled_connections = max(0, atomic_read(&client->connections));
+		client->sampled_hw_connections = clamp(atomic_read(&client->hw_connections),
+						     0, (int)client->sampled_connections);
+		client->sampled_hw_partial_connections =
+			clamp(atomic_read(&client->hw_partial_connections),
+			      0, (int)client->sampled_hw_connections);
+	}
+	table->sampled_connections = max(0, atomic_read(&table->connections));
+	table->sampled_hw_connections = clamp(atomic_read(&table->hw_connections),
+					    0, (int)table->sampled_connections);
+	rcu_read_unlock();
+}
+
+void nf_flow_clients_summary(struct seq_file *seq, struct net *net)
+{
+	const struct nf_flow_clients *table = net->ft.clients;
+	u32 total = table->sampled_connections;
+	u32 hw = table->sampled_hw_connections;
+
+	/* Caller holds clients_sample_lock: O(1), no flow/client walk or MMIO. */
+	seq_printf(seq, "connections=%u hw=%u sw=%u\n", total, hw, total - hw);
+}
+
+void nf_flow_clients_show(struct seq_file *seq, struct net *net)
+{
+	struct nf_flow_clients *table = net->ft.clients;
+	struct nf_flow_client *client;
+
+	rcu_read_lock();
+	list_for_each_entry_rcu(client, &table->records, list) {
+		if (client->parent) {
+			seq_printf(seq, "client_ifindex=%u ", client->ifindex);
+			if (client->family == NFPROTO_IPV4)
+				seq_printf(seq, "client_ip=%pI4 ", &client->address.ip);
+			else
+				seq_printf(seq, "client_ip=%pI6c ", &client->address.in6);
+		}
+		seq_printf(seq, "client_mac=%pM upload_bytes_per_sec=%llu "
+			   "download_bytes_per_sec=%llu total_upload_bytes=%llu "
+			   "total_download_bytes=%llu connections=%u hw_connections=%u "
+			   "sw_connections=%u hw_full_connections=%u "
+			   "hw_partial_connections=%u record=%s\n", client->mac, client->rate[0],
+			   client->rate[1], client->total[0], client->total[1],
+			   client->sampled_connections, client->sampled_hw_connections,
+			   client->sampled_connections - client->sampled_hw_connections,
+			   client->sampled_hw_connections -
+			   client->sampled_hw_partial_connections,
+			   client->sampled_hw_partial_connections, client->parent ? "ip" : "mac");
+	}
+	rcu_read_unlock();
+}
+
+int nf_flow_clients_init_net(struct net *net)
+{
+	struct nf_flow_clients *table = kzalloc(sizeof(*table), GFP_KERNEL);
+
+	if (!table)
+		return -ENOMEM;
+	spin_lock_init(&table->lock);
+	INIT_LIST_HEAD(&table->records);
+	hash_init(table->endpoints);
+	refcount_set(&table->refs, 1);
+	table->net = net;
+	hash_init(table->macs);
+	net->ft.clients = table;
+	return 0;
+}
+
+u32 nf_flow_clients_errors(struct net *net)
+{
+	return READ_ONCE(net->ft.clients->errors) +
+		atomic_xchg(&net->ft.clients->stats_errors, 0);
+}
+
+void nf_flow_clients_batch_error(struct net *net)
+{
+	atomic_inc(&net->ft.clients->stats_errors);
+}
+
+void nf_flow_clients_stats_error(struct flow_offload *flow)
+{
+	nf_flow_clients_batch_error(nf_ct_net(flow->ct));
+}
+
+void *nf_flow_clients_scope_owner(struct net *net)
+{
+	return net->ft.clients;
+}
+
+void nf_flow_clients_scope_get(const void *owner)
+{
+	struct nf_flow_clients *table = (struct nf_flow_clients *)owner;
+
+	refcount_inc(&table->refs);
+}
+
+/* Called with RCU held. A private accounting-table reference deliberately
+ * does not pin the namespace: doing so would prevent its flowtable cleanup.
+ */
+struct net *nf_flow_clients_scope_net(const void *owner)
+{
+	const struct nf_flow_clients *table = owner;
+
+	return READ_ONCE(table->dead) ? NULL : table->net;
+}
+
+void nf_flow_clients_scope_put(const void *owner)
+{
+	struct nf_flow_clients *table = (struct nf_flow_clients *)owner;
+	struct nf_flow_client *client, *tmp;
+
+	if (!refcount_dec_and_test(&table->refs))
+		return;
+	list_for_each_entry_safe(client, tmp, &table->records, list) {
+		list_del(&client->list);
+		kfree(client);
+	}
+	kfree(table);
+}
+
+void nf_flow_clients_free_net(struct net *net)
+{
+	struct nf_flow_clients *table = net->ft.clients;
+
+	WRITE_ONCE(table->dead, true);
+	/* Drain fast-path users and any scope reader using the weak net pointer. */
+	synchronize_rcu();
+	nf_flow_clients_scope_put(table);
+}
+
+
+/* Policy writes never alter live counts or walk the connection table. */
+int nf_flow_clients_limits_write(struct file *file, char *buf, size_t count)
+{
+	struct seq_file *seq = file->private_data;
+	struct nf_flow_clients *table = seq_file_single_net(seq)->ft.clients;
+	struct { u8 mac[ETH_ALEN]; u32 limit; struct nf_flow_client *client; } rows[32];
+	struct nf_flow_client *c;
+	char *cursor = buf, *line, mac[18], number[11], extra;
+	unsigned int limit, n = 0, i;
+	bool replace;
+	int ret = 0;
+
+	if (!count || count > 4096)
+		return -EINVAL;
+	replace = !strncmp(buf, "replace\n", 8);
+	if (replace)
+		cursor += 8;
+	else if (!strncmp(buf, "set ", 4))
+		cursor += 4;
+	else
+		return -EINVAL;
+	while ((line = strsep(&cursor, "\n"))) {
+		if (!*line)
+			continue;
+		if (n == ARRAY_SIZE(rows) || (!replace && n) ||
+		    sscanf(line, "%17s %10s %c", mac, number, &extra) != 2 ||
+		    kstrtou32(number, 10, &limit) ||
+		    strlen(mac) != 17 || !mac_pton(mac, rows[n].mac) ||
+		    !is_valid_ether_addr(rows[n].mac) || limit > 65535)
+			return -EINVAL;
+		for (i = 0; i < n; i++)
+			if (ether_addr_equal(rows[i].mac, rows[n].mac))
+				return -EINVAL;
+		rows[n++].limit = limit;
+	}
+	if (!replace && !n)
+		return -EINVAL;
+	spin_lock_bh(&table->lock);
+	/* Allocate all required MAC records before changing any existing policy. */
+	for (i = 0; i < n; i++) {
+		rows[i].client = nf_flow_client_get(table, rows[i].mac);
+		if (!rows[i].client) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+	if (replace)
+		list_for_each_entry(c, &table->records, list)
+			if (!c->parent)
+				WRITE_ONCE(c->hw_limit, 0);
+	for (i = 0; i < n; i++)
+		WRITE_ONCE(rows[i].client->hw_limit, rows[i].limit);
+out:
+	spin_unlock_bh(&table->lock);
+	return ret;
+}
+
+int nf_flow_clients_limits_show(struct seq_file *seq, void *v)
+{
+	struct nf_flow_clients *table = seq_file_single_net(seq)->ft.clients;
+	struct nf_flow_client *c;
+	int bucket;
+
+	seq_puts(seq, "version=2 source=flowtable quota=npu-connections\n");
+	rcu_read_lock();
+	hash_for_each_rcu(table->macs, bucket, c, hash) {
+		if (!READ_ONCE(c->hw_limit))
+			continue;
+		seq_printf(seq, "client_mac=%pM limit=%u slots=%u hw_connections=%d\n",
+			   c->mac, READ_ONCE(c->hw_limit), READ_ONCE(c->hw_slots),
+			   atomic_read(&c->hw_connections));
+	}
+	rcu_read_unlock();
+	return 0;
+}
