+static void zx279133_nppt_endpoint_cleanup(void *data)
+{
+	struct zte_nppt *np = data;
+	struct zx279133_eth *eth = np->eth;
+	int ret;
+
+	/* Remove before access/datapath locks; open fds hold their own NP ref. */
+	debugfs_remove_recursive(np->native_debugfs);
+	/* Stop event producers before taking locks needed by the event worker. */
+	zx279133_hosts_quiesce(np->hosts);
+	mutex_lock(&zte_nppt_devices_lock);
+	list_del(&np->list);
+	mutex_lock(&np->access);
+	mutex_lock(&eth->datapath_lock);
+	ret = zte_nppt_detach(np);
+	np->eth = NULL;
+	eth->flow_offload = NULL;
+	mutex_unlock(&eth->datapath_lock);
+	mutex_unlock(&np->access);
+	if (ret)
+		list_add_tail(&np->list, &zte_nppt_quarantined);
+	mutex_unlock(&zte_nppt_devices_lock);
+	if (!ret)
+		zte_nppt_put(np);
+}
+
+int zx279133_flow_offload_init(struct zx279133_eth *eth)
+{
+	struct zte_nppt *np;
+	struct zte_nppt *quarantined;
+	int ret = 0;
+
+	np = kzalloc(sizeof(*np), GFP_KERNEL);
+	if (!np)
+		return -ENOMEM;
+	kref_init(&np->ref);
+	INIT_LIST_HEAD(&np->vlans);
+	mutex_init(&np->access);
+	init_rwsem(&np->driver_lock);
+	np->eth = eth;
+	np->dev = get_device(eth->dev);
+	eth->flow_offload = np;
+	np->hosts = zx279133_hosts_create(np, eth->dev);
+	if (IS_ERR(np->hosts)) {
+		ret = PTR_ERR(np->hosts);
+		np->hosts = NULL;
+		goto fail;
+	}
+	ret = zx279133_hosts_start(np->hosts);
+	if (ret)
+		goto fail;
+	mutex_lock(&zte_nppt_devices_lock);
+	list_for_each_entry(quarantined, &zte_nppt_quarantined, list) {
+		if (dev_fwnode(quarantined->dev) == dev_fwnode(eth->dev)) {
+			dev_err(eth->dev, "NP requires hardware recovery after failed invalidation\n");
+			ret = -EBUSY;
+			goto out_unlock;
+		}
+	}
+	if (zte_nppt_client) {
+		mutex_lock(&eth->datapath_lock);
+		ret = zte_nppt_attach(np, zte_nppt_client);
+		mutex_unlock(&eth->datapath_lock);
+		if (ret) {
+			dev_warn(eth->dev, "optional flow client attach failed: %d\n", ret);
+			ret = 0;
+		}
+	}
+	if (!ret)
+		list_add_tail(&np->list, &zte_nppt_devices);
+out_unlock:
+	mutex_unlock(&zte_nppt_devices_lock);
+	if (ret) {
+		zx279133_hosts_quiesce(np->hosts);
+		goto fail;
+	}
+	/* Registered before devm_register_netdev: netdevs unbind first. */
+	ret = devm_add_action_or_reset(eth->dev,
+				       zx279133_nppt_endpoint_cleanup, np);
+	if (ret)
+		return ret;
+	np->native_debugfs = zx279133_native_debug_create(np, dev_name(eth->dev));
+	return devm_device_add_group(eth->dev, &zx279133_wan_ports_group);
+fail:
+	eth->flow_offload = NULL;
+	zte_nppt_put(np);
+	return ret;
+}
