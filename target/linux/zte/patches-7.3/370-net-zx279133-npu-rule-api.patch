+int zte_nppt_frame_limits_get(struct zte_nppt *np,
+			    struct zte_nppt_frame_limits *limits)
+{
+	/* SPA memory indices from the existing CPU/LAN/WAN initialization,
+	 * not Linux port numbers or downstream action/gemport identifiers.
+	 */
+	static const u8 memories[ZTE_NPPT_FRAME_SPA_ROWS] = {
+		0, 5, 6, 10, 12, 14, 15,
+	};
+	struct zx279133_eth *eth = np->eth;
+	unsigned int i;
+	int ret = zte_nppt_native_ready(np);
+
+	if (ret)
+		return ret;
+	if (!limits)
+		return -EINVAL;
+	memset(limits, 0, sizeof(*limits));
+	limits->generation = np->generation;
+	for (i = 0; i < ARRAY_SIZE(memories); i++) {
+		limits->spa[i].mem = memories[i];
+		limits->spa[i].rc = -ECANCELED;
+	}
+	/* These are configuration registers, not read-clear MMC counters. */
+	limits->xmac_rx[0] = readl(eth->base + ZX279133_XMAC0_BASE +
+				  ZX279133_XMAC_RX_CTRL);
+	limits->xmac_frame[0] = readl(eth->base + ZX279133_XMAC0_BASE +
+				     ZX279133_XMAC_FRAME_CFG);
+	limits->xmac_rx[1] = readl(eth->base + ZX279133_XMAC1_BASE +
+				  ZX279133_XMAC_RX_CTRL);
+	limits->xmac_frame[1] = readl(eth->base + ZX279133_XMAC1_BASE +
+				     ZX279133_XMAC_FRAME_CFG);
+	limits->sdet_up = readl(eth->base + ZX279133_SDET_FRAME_CFG);
+	limits->sdet_down = readl(eth->base + ZX279133_SDET_DOWN_FRAME_CFG);
+	limits->global_rc = zx279133_native_sdt128_io(eth, 1, 0,
+						     limits->global_raw, false);
+	/* Stop on the first indirect timeout, retaining the partial snapshot. */
+	if (limits->global_rc) {
+		memset(limits->global_raw, 0, sizeof(limits->global_raw));
+		return 0;
+	}
+	for (i = 0; i < ARRAY_SIZE(memories); i++) {
+		struct zte_nppt_frame_spa *row = &limits->spa[i];
+
+		row->rc = zx279133_native_spa_io(eth, row->mem, 10,
+						 &row->raw, false);
+		if (row->rc) {
+			row->raw = 0;
+			break;
+		}
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_frame_limits_get);
