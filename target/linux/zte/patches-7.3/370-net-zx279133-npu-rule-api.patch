+
+/* Cached metadata only; this read performs no register/table accesses. */
+static ssize_t offload_info_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct zx279133_eth *eth = zx279133_wan_ports_eth(dev);
+	struct zte_nppt_info info;
+	struct zte_nppt *np;
+
+	if (!eth || !eth->flow_offload)
+		return -ENODEV;
+	np = eth->flow_offload;
+	mutex_lock(&np->access);
+	mutex_lock(&eth->datapath_lock);
+	zte_nppt_get_info(np, &info);
+	mutex_unlock(&eth->datapath_lock);
+	mutex_unlock(&np->access);
+	return sysfs_emit(buf,
+			  "api=%u ready=%u generation=%llu capabilities=%#llx ikey_depth=%u stat_depth=%u age_depth=%u ddr_bytes=%u ppu_version_valid=%u ppu_version=%#x.%#x hardware_revision_valid=%u write_completion_verified=%u\n",
+			  info.api_version, info.ready, info.generation, info.capabilities,
+			  info.ikey_depth, info.stat_depth, info.age_depth, info.ddr_bytes,
+			  info.ppu_version_valid, info.ppu_version_major,
+			  info.ppu_version_minor, info.hardware_revision_valid,
+			  info.write_completion_verified);
+}
+static DEVICE_ATTR_RO(offload_info);
+
+/*
+ * wan_ports: the LAN ports switched to WAN-type, by name. Writing
+ * "<port> 1" switches one, "<port> 0" switches it back; userspace does it
+ * for the ports its firewall puts in a WAN zone.
+ */
+static ssize_t wan_ports_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct zx279133_eth *eth = zx279133_wan_ports_eth(dev);
+	unsigned long wan_vports;
+	struct net_device *ndev;
+	int n = 0;
+	u16 vid;
+
+	if (!eth)
+		return -ENODEV;
+	wan_vports = READ_ONCE(eth->lan_wan_vports);
+	rcu_read_lock();
+	for_each_netdev_rcu(&init_net, ndev)
+		if (!zx279133_flow_lan_vid(eth, ndev, &vid) &&
+		    wan_vports & BIT(vid - ZX279133_LAN_TRANSPORT_VID_MIN))
+			n += sysfs_emit_at(buf, n, "%s ", ndev->name);
+	rcu_read_unlock();
+	n += sysfs_emit_at(buf, n, "\n");
+
+	return n;
+}
+
+static ssize_t wan_ports_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct zx279133_eth *eth = zx279133_wan_ports_eth(dev);
+	struct net_device *ndev;
+	char name[IFNAMSIZ];
+	unsigned int wan;
+	int ret;
+	u16 vid;
+
+	if (!eth)
+		return -ENODEV;
+	if (sscanf(buf, "%15s %u", name, &wan) != 2 || wan > 1)
+		return -EINVAL;
+	ndev = dev_get_by_name(&init_net, name);
+	if (!ndev)
+		return -ENODEV;
+	ret = zx279133_flow_lan_vid(eth, ndev, &vid);
+	/* A bridged port is a LAN port. */
+	if (!ret && wan && netif_is_bridge_port(ndev))
+		ret = -EBUSY;
+	dev_put(ndev);
+	if (ret)
+		return ret == -EBUSY ? ret : -EINVAL;
+	ret = zx279133_lan_vport_wan_set(eth, vid, wan);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(wan_ports);
+
+static struct attribute *zx279133_wan_ports_attrs[] = {
+	&dev_attr_wan_ports.attr,
+	&dev_attr_offload_info.attr,
+	NULL
+};
+
+static const struct attribute_group zx279133_wan_ports_group = {
+	.attrs = zx279133_wan_ports_attrs,
+};
