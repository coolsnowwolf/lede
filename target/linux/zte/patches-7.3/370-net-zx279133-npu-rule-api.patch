Subject: [PATCH] net: zte: add the NP hardware rule API

--- /dev/null
+++ b/drivers/net/ethernet/zte/zx279133-offload-api.c
@@ -0,0 +1,1807 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* NPPT supplier, optional client registration and hardware access boundary. */
+#include <linux/iopoll.h>
+#include <linux/bitmap.h>
+#include <linux/if_vlan.h>
+#include <linux/overflow.h>
+#include <linux/if_bridge.h>
+#include <linux/debugfs.h>
+#include <linux/kref.h>
+#include <linux/ktime.h>
+#include <linux/rwsem.h>
+#include <linux/zte_nppt_offload.h>
+#include <net/dsa.h>
+#include <net/dsa_zx279133_rtl8372n.h>
+#include "zx279133.h"
+#include "zx279133-host.h"
+#include "zx279133-native.h"
+#include "zx279133-meter.h"
+#include "zx279133-native-debug.h"
+
+#define ZX279133_SE_ALG_WR_DONE 0x50000
+#define ZX279133_SE_ALG_WR_CMD  0x50004
+#define ZX279133_SE_ALG_WR_DATA 0x50008
+#define ZX279133_SE_HASH_AGCLK BIT(2)
+#define ZX279133_DDR_BUCKET_SHIFT 6
+#define ZX279133_DDR_BUCKET_SIZE BIT(ZX279133_DDR_BUCKET_SHIFT)
+
+struct zte_nppt_vlan {
+	struct list_head node;
+	u16 vid;
+	u32 users;
+	bool poisoned;
+	struct zte_nppt_vlan_row original;
+	struct zte_nppt_vlan_row programmed;
+};
+
+struct zte_nppt {
+	struct kref ref;
+	struct list_head list;
+	/* Serializes external transactions against supplier destruction. */
+	struct mutex access;
+	struct rw_semaphore driver_lock;
+	struct zx279133_eth *eth;
+	struct device *dev;
+	const struct zte_nppt_client_ops *ops;
+	void *client;
+	struct zx279133_host_manager *hosts;
+	struct zx279133_meter_pool *meters;
+	struct dentry *native_debugfs;
+	struct list_head vlans;
+	/* Configuration admission survives flow retirement and hardware reset. */
+	DECLARE_BITMAP(configured_vlans, VLAN_N_VID);
+	DECLARE_BITMAP(lan_vlans, VLAN_N_VID);
+	DECLARE_BITMAP(wan_vlans, VLAN_N_VID);
+	struct zte_nppt_vlan_row *vlan_originals;
+	bool vlan_config_uncertain;
+	u32 vlan_rows, vlan_users, vlan_uncertain;
+	u64 generation;
+	struct zte_nppt_me_diagnostics me_stats;
+	bool me_stats_valid;
+};
+
+static DEFINE_MUTEX(zte_nppt_devices_lock);
+static LIST_HEAD(zte_nppt_devices);
+/* Failed hardware invalidation survives supplier unbind/reprobe. */
+static LIST_HEAD(zte_nppt_quarantined);
+static const struct zte_nppt_client_ops *zte_nppt_client;
+
+static void zte_nppt_release(struct kref *ref)
+{
+	struct zte_nppt *np = container_of(ref, struct zte_nppt, ref);
+
+	WARN_ON(!list_empty(&np->vlans));
+	kfree(np->vlan_originals);
+	if (np->hosts)
+		zx279133_hosts_destroy(np->hosts);
+	zx279133_meter_destroy(np->meters);
+	put_device(np->dev);
+	kfree(np);
+}
+
+void zte_nppt_get(struct zte_nppt *np)
+{
+	kref_get(&np->ref);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_get);
+
+void zte_nppt_put(struct zte_nppt *np)
+{
+	kref_put(&np->ref, zte_nppt_release);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_put);
+
+int zte_nppt_begin(struct zte_nppt *np)
+{
+	mutex_lock(&np->access);
+	if (!np->eth) {
+		mutex_unlock(&np->access);
+		return -ENODEV;
+	}
+	mutex_lock(&np->eth->datapath_lock);
+	if (!np->eth->hardware_prepared) {
+		mutex_unlock(&np->eth->datapath_lock);
+		mutex_unlock(&np->access);
+		return -ENETDOWN;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_begin);
+
+/* Debugfs removal can run under datapath_lock: never wait on it in show(). */
+int zte_nppt_try_begin(struct zte_nppt *np)
+{
+	if (!mutex_trylock(&np->access))
+		return -EAGAIN;
+	if (!np->eth) {
+		mutex_unlock(&np->access);
+		return -ENODEV;
+	}
+	if (!mutex_trylock(&np->eth->datapath_lock)) {
+		mutex_unlock(&np->access);
+		return -EAGAIN;
+	}
+	if (!np->eth->hardware_prepared) {
+		mutex_unlock(&np->eth->datapath_lock);
+		mutex_unlock(&np->access);
+		return -ENETDOWN;
+	}
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_try_begin);
+
+void zte_nppt_end(struct zte_nppt *np)
+{
+	mutex_unlock(&np->eth->datapath_lock);
+	mutex_unlock(&np->access);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_end);
+
+void zte_nppt_get_info(struct zte_nppt *np, struct zte_nppt_info *info)
+{
+	*info = (struct zte_nppt_info) {
+		.api_version = ZTE_NPPT_API_VERSION,
+		.ikey_depth = ZTE_NPPT_FAST_IKEY_DEPTH,
+		.capabilities = ZTE_NPPT_CAP_ZCAM | ZTE_NPPT_CAP_DDR |
+				ZTE_NPPT_CAP_HOST_VID0 | ZTE_NPPT_CAP_WANID |
+				ZTE_NPPT_CAP_STATS | ZTE_NPPT_CAP_AGE |
+				ZTE_NPPT_CAP_PPU_MCODE |
+				(np->eth && READ_ONCE(np->eth->vid_key_active) ?
+				 ZTE_NPPT_CAP_LAN_VID_KEY |
+				 ZTE_NPPT_CAP_WAN_VID_KEY : 0),
+		.ppu_version_major = np->eth ? np->eth->ppu_version_major : 0,
+		.ppu_version_minor = np->eth ? np->eth->ppu_version_minor : 0,
+		.ppu_version_valid = np->eth && np->eth->ppu_mcode_prepared &&
+				     np->eth->ppu_version_valid,
+		.stat_depth = ZX279133_FAST_STAT_DEPTH,
+		.age_depth = ZX279133_FAST_AGE_DEPTH,
+		.ddr_bytes = ZTE_NPPT_DDR_BYTES,
+		.generation = np->generation,
+		.ready = np->eth && np->eth->hardware_prepared,
+	};
+}
+EXPORT_SYMBOL_GPL(zte_nppt_get_info);
+
+/* Registry lock held. Callers serialize the supplier datapath, too. */
+static int zte_nppt_attach(struct zte_nppt *np,
+			   const struct zte_nppt_client_ops *ops)
+{
+	void *client;
+
+	down_write(&np->driver_lock);
+	client = ops->attach(np, np->dev);
+	if (!client)
+		client = ERR_PTR(-EINVAL);
+	if (!IS_ERR(client)) {
+		np->client = client;
+		np->ops = ops;
+	}
+	up_write(&np->driver_lock);
+	return PTR_ERR_OR_ZERO(client);
+}
+
+static int zte_nppt_detach(struct zte_nppt *np)
+{
+	int ret = 0;
+	int host_ret;
+
+	down_write(&np->driver_lock);
+	if (np->ops)
+		ret = np->ops->detach(np->client);
+	if (!ret && !list_empty(&np->vlans))
+		ret = -EBUSY;
+	host_ret = zx279133_hosts_reap(np->hosts, np->eth->hardware_prepared);
+	if (!ret)
+		ret = host_ret;
+	if (!ret)
+		ret = !np->eth->hardware_prepared && zx279133_meter_active(np->meters) ?
+			-EBUSY : zx279133_meter_drain(np->meters, np->eth);
+	np->ops = NULL;
+	np->client = NULL;
+	up_write(&np->driver_lock);
+	return ret;
+}
+
+int zte_nppt_register_client(const struct zte_nppt_client_ops *ops)
+{
+	struct zte_nppt *np;
+	int ret = 0;
+
+	if (!ops || !ops->attach || !ops->detach || !ops->setup_tc ||
+	    !ops->reset || !ops->active)
+		return -EINVAL;
+	mutex_lock(&zte_nppt_devices_lock);
+	if (zte_nppt_client) {
+		ret = -EBUSY;
+		goto out;
+	}
+	list_for_each_entry(np, &zte_nppt_devices, list) {
+		mutex_lock(&np->eth->datapath_lock);
+		ret = zte_nppt_attach(np, ops);
+		mutex_unlock(&np->eth->datapath_lock);
+		if (ret)
+			dev_warn(np->dev, "optional flow client attach failed: %d\n", ret);
+	}
+	zte_nppt_client = ops;
+	/* No failed module init after publishing callbacks to another device. */
+	ret = 0;
+out:
+	mutex_unlock(&zte_nppt_devices_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_register_client);
+
+void zte_nppt_unregister_client(const struct zte_nppt_client_ops *ops)
+{
+	struct zte_nppt *np;
+
+	mutex_lock(&zte_nppt_devices_lock);
+	if (zte_nppt_client == ops) {
+		zte_nppt_client = NULL;
+		list_for_each_entry(np, &zte_nppt_devices, list) {
+			mutex_lock(&np->eth->datapath_lock);
+			zte_nppt_detach(np);
+			mutex_unlock(&np->eth->datapath_lock);
+		}
+	}
+	mutex_unlock(&zte_nppt_devices_lock);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_unregister_client);
+
+int zx279133_flow_offload_setup_tc(struct zx279133_eth *eth,
+				   struct net_device *ndev,
+				   enum tc_setup_type type, void *data)
+{
+	struct zte_nppt *np = eth->flow_offload;
+	int ret = -EOPNOTSUPP;
+
+	if (type != TC_SETUP_FT && type != TC_SETUP_BLOCK)
+		return -EOPNOTSUPP;
+	mutex_lock(&eth->datapath_lock);
+	down_read(&np->driver_lock);
+	if (np->ops)
+		ret = np->ops->setup_tc(np->client, ndev, type, data);
+	up_read(&np->driver_lock);
+	mutex_unlock(&eth->datapath_lock);
+	return ret;
+}
+
+/* All hardware events are called with the supplier datapath lock held. */
+bool zx279133_flow_offload_active(struct zx279133_eth *eth)
+{
+	struct zte_nppt *np = eth->flow_offload;
+	bool active = false;
+
+	if (!np)
+		return false;
+	down_read(&np->driver_lock);
+	if (np->ops)
+		active = np->ops->active(np->client);
+	active |= zx279133_hosts_active(np->hosts);
+	up_read(&np->driver_lock);
+	return active;
+}
+
+int zx279133_flow_offload_reset(struct zx279133_eth *eth)
+{
+	struct zte_nppt *np = eth->flow_offload;
+	int ret = 0;
+	int host_ret;
+
+	if (!np)
+		return 0;
+	down_read(&np->driver_lock);
+	if (np->ops) {
+		/* Quarantined entries cannot be touched with supplier clocks off. */
+		if (!eth->hardware_prepared && np->ops->active(np->client))
+			ret = -EBUSY;
+		else
+			ret = np->ops->reset(np->client);
+	}
+	host_ret = zx279133_hosts_reap(np->hosts, eth->hardware_prepared);
+	if (!ret)
+		ret = host_ret;
+	if (!ret)
+		ret = !eth->hardware_prepared && zx279133_meter_active(np->meters) ?
+			-EBUSY : zx279133_meter_drain(np->meters, eth);
+	zx279133_hosts_reset_result(np->hosts, ret);
+	np->generation++;
+	up_read(&np->driver_lock);
+	return ret;
+}
+
+int zx279133_nppt_topology_reset(struct zte_nppt *np)
+{
+	struct zx279133_eth *eth;
+	int ret;
+
+	mutex_lock(&np->access);
+	eth = np->eth;
+	if (!eth) {
+		mutex_unlock(&np->access);
+		return -ENODEV;
+	}
+	mutex_lock(&eth->datapath_lock);
+	ret = zx279133_flow_offload_reset(eth);
+	/* Topology events may recreate MAC policy Hosts only after invalidation,
+	 * reaping and resource drain completed. Never from hardware shutdown.
+	 */
+	if (!ret && eth->hardware_prepared) {
+		down_read(&np->driver_lock);
+		if (np->ops && np->ops->resync)
+			np->ops->resync(np->client);
+		up_read(&np->driver_lock);
+	}
+	mutex_unlock(&eth->datapath_lock);
+	mutex_unlock(&np->access);
+	return ret;
+}
+
+int zte_nppt_flow_ready(struct zte_nppt *np)
+{
+	return zx279133_hosts_ready(np->hosts);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_flow_ready);
+
+int zte_nppt_zcam_alloc(struct zte_nppt *np, const u8 *key, u8 selector,
+			u8 *block, u8 *cell, u8 *addr)
+{
+	return zx279133_hosts_zcam_alloc(np->hosts, key, selector, block, cell, addr);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_zcam_alloc);
+
+void zte_nppt_zcam_release(struct zte_nppt *np, u8 block, u8 cell, u8 addr)
+{
+	zx279133_hosts_zcam_release(np->hosts, block, cell, addr);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_zcam_release);
+
+struct zte_nppt_host *zte_nppt_host_get(struct zte_nppt *np, const u8 *mac, u16 port)
+{
+	return zx279133_host_get(np->hosts, mac, port);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_host_get);
+
+int zte_nppt_host_put(struct zte_nppt *np, struct zte_nppt_host *host)
+{
+	return zx279133_host_put(np->hosts, host);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_host_put);
+
+void zte_nppt_hosts_show(struct zte_nppt *np, struct seq_file *s)
+{
+	zx279133_hosts_show(np->hosts, s);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_hosts_show);
+
+void zx279133_flow_offload_flush(struct zx279133_eth *eth)
+{
+	/* Invalidate rules while clocks are still on, before releasing resources. */
+	if (zx279133_flow_offload_reset(eth))
+		dev_warn(eth->dev, "flow invalidation incomplete before hardware shutdown\n");
+}
+
+static int zx279133_flow_lan_vid(struct zx279133_eth *eth,
+				 struct net_device *dev, u16 *vid)
+{
+#if IS_REACHABLE(CONFIG_NET_DSA)
+	struct dsa_port *dp = dsa_port_from_netdev(dev);
+
+	if (IS_ERR(dp) || dsa_port_to_conduit(dp) != eth->lan_ndev ||
+	    dp->index < ZX279133_RTL8372N_USER_PORT_MIN ||
+	    dp->index > ZX279133_RTL8372N_USER_PORT_MAX)
+		return -EOPNOTSUPP;
+
+	*vid = ZX279133_RTL8372N_TRANSPORT_VID_BASE + dp->index;
+	return 0;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+
+/*
+ * Where a device is in the data path, and the port its frames leave by: the
+ * WAN port, or the transport VID of a LAN port. A LAN port switched to
+ * WAN-type, a second WAN, counts as WAN; 0 when a LAN device is not one port.
+ */
+static enum zx279133_flow_port
+zx279133_flow_dev_port(struct zx279133_eth *eth, struct net_device *dev,
+		       u16 *gemport)
+{
+	unsigned long wan_vports = READ_ONCE(eth->lan_wan_vports);
+	u16 vid = 0;
+
+	if (!dev)
+		return ZX279133_FLOW_PORT_NONE;
+	if (dev == eth->ndev) {
+		*gemport = zx279133_tx_port;
+		return ZX279133_FLOW_PORT_WAN;
+	}
+	if (!eth->lan_ndev ||
+	    (dev != eth->lan_ndev &&
+	     dev_get_iflink(dev) != eth->lan_ndev->ifindex))
+		return ZX279133_FLOW_PORT_NONE;
+	if (zx279133_flow_lan_vid(eth, dev, &vid))
+		vid = 0;
+	*gemport = vid;
+	if (vid && wan_vports & BIT(vid - ZX279133_LAN_TRANSPORT_VID_MIN))
+		return ZX279133_FLOW_PORT_WAN;
+	return ZX279133_FLOW_PORT_LAN;
+}
+
+
+enum zx279133_flow_port zte_nppt_dev_port(struct zte_nppt *np,
+					struct net_device *dev, u16 *port)
+{
+	return zx279133_flow_dev_port(np->eth, dev, port);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_dev_port);
+
+bool zte_nppt_is_wan(struct zte_nppt *np, struct net_device *dev)
+{
+	return dev == np->eth->ndev;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_is_wan);
+
+int zte_nppt_zcam_write(struct zte_nppt *np,
+			       u8 zblock, u8 zcell, u8 zaddr,
+			       const u32 *table, unsigned int words)
+{
+	struct zx279133_eth *eth = np->eth;
+	u32 agclk, cmd, status;
+	int i, ret;
+
+	if (zblock >= 4 || zcell >= 5 || !words || words > 16 || words % 4)
+		return -EINVAL;
+
+	agclk = readl(eth->pps_base + ZX279133_PPU_AGCLK_CFG);
+	if (agclk & ZX279133_SE_HASH_AGCLK)
+		writel(agclk & ~ZX279133_SE_HASH_AGCLK,
+		       eth->pps_base + ZX279133_PPU_AGCLK_CFG);
+
+	ret = readl_poll_timeout_atomic(eth->pps_base + ZX279133_SE_ALG_WR_DONE,
+					status, status & BIT(0), 1, 1000);
+	if (ret)
+		goto out_restore_clock;
+
+	for (i = 0; i < words; i++)
+		writel(table[i], eth->pps_base + ZX279133_SE_ALG_WR_DATA + 4 * i);
+
+	cmd = zaddr | (zblock >> 1) << 12 | (zblock & 1) << 11 |
+		zcell << 8 | ((BIT(words / 4) - 1) & 0xf) << 16;
+	writel(cmd, eth->pps_base + ZX279133_SE_ALG_WR_CMD);
+
+out_restore_clock:
+	if (agclk & ZX279133_SE_HASH_AGCLK)
+		writel(agclk, eth->pps_base + ZX279133_PPU_AGCLK_CFG);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_zcam_write);
+
+int zte_nppt_ddr_write(struct zte_nppt *np, u32 bucket, const u32 *table)
+{
+	u8 ddr_table[ZX279133_DDR_BUCKET_SIZE];
+	u8 __iomem *dst;
+	const u8 *src = (const u8 *)table;
+	unsigned int i;
+
+	if (bucket >= ZTE_NPPT_DDR_BYTES / ZX279133_DDR_BUCKET_SIZE)
+		return -EINVAL;
+	dst = np->eth->se_hash_mem + (bucket << ZX279133_DDR_BUCKET_SHIFT);
+	for (i = 0; i < ARRAY_SIZE(ddr_table); i++)
+		ddr_table[i] = src[ARRAY_SIZE(ddr_table) - 1 - i];
+	ddr_table[0] &= ~BIT(7);
+	memcpy_toio(dst, ddr_table, sizeof(ddr_table));
+	/* Publish the complete body before making the table valid. */
+	wmb();
+	writeb(ddr_table[0] | BIT(7), dst);
+	/* Complete the valid-bit write before reporting the rule in hardware. */
+	wmb();
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_ddr_write);
+
+#ifdef CONFIG_DEBUG_FS
+int zte_nppt_debug_ddr_read(struct zte_nppt *np, u32 bucket, u32 *table)
+{
+	u8 raw[ZX279133_DDR_BUCKET_SIZE];
+	u8 *dst = (u8 *)table;
+	unsigned int i;
+
+	if (!table || bucket >= ZTE_NPPT_DDR_BYTES / ZX279133_DDR_BUCKET_SIZE)
+		return -EINVAL;
+	lockdep_assert_held(&np->eth->datapath_lock);
+	memcpy_fromio(raw, np->eth->se_hash_mem + (bucket << ZX279133_DDR_BUCKET_SHIFT),
+		      sizeof(raw));
+	for (i = 0; i < ARRAY_SIZE(raw); i++)
+		dst[i] = raw[ARRAY_SIZE(raw) - 1 - i];
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_debug_ddr_read);
+#endif
+
+int zte_nppt_ddr_clear(struct zte_nppt *np, u32 bucket)
+{
+	u8 __iomem *dst;
+
+	if (bucket >= ZTE_NPPT_DDR_BYTES / ZX279133_DDR_BUCKET_SIZE)
+		return -EINVAL;
+	dst = np->eth->se_hash_mem + (bucket << ZX279133_DDR_BUCKET_SHIFT);
+	writeb(0, dst);
+	/* Invalidate the table before clearing data that SE may still read. */
+	wmb();
+	memset_io(dst + 1, 0, ZX279133_DDR_BUCKET_SIZE - 1);
+	/* Complete the clear before returning the bucket to the allocator. */
+	wmb();
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_ddr_clear);
+
