+void zte_nppt_vlan_status(struct zte_nppt *np, u32 *rows, u32 *users,
+			  u32 *uncertain)
+{
+	/* Cached diagnostics, not an atomic cross-counter snapshot. */
+	*rows = READ_ONCE(np->vlan_rows);
+	*users = READ_ONCE(np->vlan_users);
+	*uncertain = READ_ONCE(np->vlan_uncertain);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_vlan_status);
+
+/* A configured VLAN must admit the first packet before any flow exists. */
+static const struct zte_nppt_vlan_row zx279133_vlan_board = {
+	.words = { 4290772992U, 65535, 4294967295U, 12291 },
+};
+
+static int zx279133_vlan_write_checked(struct zx279133_eth *eth, u16 vid,
+				       const struct zte_nppt_vlan_row *row)
+{
+	struct zte_nppt_vlan_row check;
+	int ret;
+
+	ret = zx279133_native_vlan_set(eth, vid, row);
+	if (ret)
+		return ret;
+	ret = zx279133_native_vlan_get(eth, vid, &check);
+	if (ret)
+		return ret;
+	return memcmp(&check, row, sizeof(check)) ? -EIO : 0;
+}
+
+static int zx279133_vlan_board_check(struct zx279133_eth *eth)
+{
+	struct zte_nppt_vlan_row row;
+	int ret;
+
+	ret = zx279133_native_vlan_get(eth, 0, &row);
+	if (ret)
+		return ret;
+	return memcmp(&row, &zx279133_vlan_board, sizeof(row)) ? -ESTALE : 0;
+}
+
+int zx279133_vlan_config_replay(struct zx279133_eth *eth)
+{
+	struct zte_nppt *np = eth->flow_offload;
+	struct zte_nppt_vlan_row row;
+	unsigned long vid;
+	int ret;
+
+	lockdep_assert_held(&eth->datapath_lock);
+	if (!np)
+		return 0;
+	if (np->vlan_config_uncertain)
+		return -EUCLEAN;
+	if (bitmap_empty(np->configured_vlans, VLAN_N_VID))
+		return 0;
+	ret = zx279133_vlan_board_check(eth);
+	if (ret)
+		return ret;
+	for_each_set_bit(vid, np->configured_vlans, VLAN_N_VID) {
+		ret = zx279133_native_vlan_get(eth, vid, &row);
+		if (ret)
+			return ret;
+		/* NP prepare cleared SDT0. Do not adopt another owner's row. */
+		if (memchr_inv(&row, 0, sizeof(row)) &&
+		    memcmp(&row, &zx279133_vlan_board, sizeof(row)))
+			return -EBUSY;
+		ret = zx279133_vlan_write_checked(eth, vid, &zx279133_vlan_board);
+		if (ret)
+			return ret;
+		/* An identical owned row can remain after a failed prepare. */
+		if (!memcmp(&row, &zx279133_vlan_board, sizeof(row)))
+			continue;
+		np->vlan_originals[vid] = row;
+	}
+	return 0;
+}
+
+static int zx279133_vlan_config_apply(struct zte_nppt *np,
+				      const unsigned long *vids)
+{
+	struct vlan_change {
+		u16 vid;
+		struct zte_nppt_vlan_row before, after;
+	} *changes;
+	DECLARE_BITMAP(changed, VLAN_N_VID);
+	struct zx279133_eth *eth = np->eth;
+	unsigned int count, n = 0, attempted = 0;
+	unsigned long vid;
+	int ret = 0;
+
+	if (np->vlan_config_uncertain)
+		return -EUCLEAN;
+	if (test_bit(0, vids) || test_bit(4095, vids))
+		return -EINVAL;
+	for (vid = ZX279133_LAN_TRANSPORT_VID_MIN;
+	     vid <= ZX279133_LAN_TRANSPORT_VID_MAX; vid++)
+		if (test_bit(vid, vids))
+			return -EBUSY;
+	bitmap_xor(changed, vids, np->configured_vlans, VLAN_N_VID);
+	count = bitmap_weight(changed, VLAN_N_VID);
+	if (!count)
+		return 0;
+	if (!np->vlan_originals) {
+		np->vlan_originals = kcalloc(VLAN_N_VID,
+					     sizeof(*np->vlan_originals), GFP_KERNEL);
+		if (!np->vlan_originals)
+			return -ENOMEM;
+	}
+	if (!eth->hardware_prepared) {
+		bitmap_copy(np->configured_vlans, vids, VLAN_N_VID);
+		return 0;
+	}
+	ret = zx279133_vlan_board_check(eth);
+	if (ret)
+		return ret;
+	changes = kvcalloc(count, sizeof(*changes), GFP_KERNEL);
+	if (!changes)
+		return -ENOMEM;
+	/* Configuration changes retire flows through their existing owner.
+	 * The admission bitmap itself is independent of those flow leases.
+	 */
+	ret = zx279133_flow_offload_reset(eth);
+	if (ret)
+		goto out;
+	if (!list_empty(&np->vlans)) {
+		ret = -EBUSY;
+		goto resync;
+	}
+	for_each_set_bit(vid, changed, VLAN_N_VID) {
+		struct vlan_change *c = &changes[n++];
+
+		c->vid = vid;
+		ret = zx279133_native_vlan_get(eth, vid, &c->before);
+		if (ret)
+			goto resync;
+		if (test_bit(vid, np->configured_vlans)) {
+			if (memcmp(&c->before, &zx279133_vlan_board, sizeof(c->before))) {
+				ret = -ESTALE;
+				goto resync;
+			}
+			c->after = np->vlan_originals[vid];
+		} else {
+			if (memchr_inv(&c->before, 0, sizeof(c->before))) {
+				ret = -EBUSY;
+				goto resync;
+			}
+			c->after = zx279133_vlan_board;
+		}
+	}
+	for (attempted = 0; attempted < count;) {
+		struct vlan_change *c = &changes[attempted++];
+
+		ret = zx279133_vlan_write_checked(eth, c->vid, &c->after);
+		if (ret)
+			goto restore;
+	}
+	for (n = 0; n < count; n++)
+		if (test_bit(changes[n].vid, vids))
+			np->vlan_originals[changes[n].vid] = changes[n].before;
+	bitmap_copy(np->configured_vlans, vids, VLAN_N_VID);
+	goto resync;
+restore:
+	/* Include the failed write, which may have partially reached hardware. */
+	while (attempted) {
+		struct vlan_change *c = &changes[--attempted];
+
+		if (zx279133_vlan_write_checked(eth, c->vid, &c->before))
+			np->vlan_config_uncertain = true;
+	}
+	if (np->vlan_config_uncertain)
+		ret = -EUCLEAN;
+resync:
+	/* Recreate existing MAC QoS only after the flow invalidation above. */
+	down_read(&np->driver_lock);
+	if (np->ops && np->ops->resync)
+		np->ops->resync(np->client);
+	up_read(&np->driver_lock);
+out:
+	kvfree(changes);
+	return ret;
+}
+
+int zx279133_vlan_config_sync(struct zx279133_eth *eth,
+			      const unsigned long *vids)
+{
+	struct zte_nppt *np = eth->flow_offload;
+	DECLARE_BITMAP(merged, VLAN_N_VID);
+	int ret;
+
+	if (!np)
+		return -ENODEV;
+	/* LAN callers must release the switch MDIO lock before this boundary. */
+	mutex_lock(&np->access);
+	mutex_lock(&eth->datapath_lock);
+	bitmap_or(merged, vids, np->wan_vlans, VLAN_N_VID);
+	ret = zx279133_vlan_config_apply(np, merged);
+	if (!ret)
+		bitmap_copy(np->lan_vlans, vids, VLAN_N_VID);
+	mutex_unlock(&eth->datapath_lock);
+	mutex_unlock(&np->access);
+	return ret;
+}
+
+/* eth0's VLAN filter callbacks are configuration transactions, not packet
+ * sampling. Keep WAN and DSA ownership separate: removing either side must
+ * not remove a shared SDT0 row still required by the other side.
+ */
+int zx279133_wan_vlan_update(struct zx279133_eth *eth, __be16 proto,
+			    u16 vid, bool add)
+{
+	struct zte_nppt *np = eth->flow_offload;
+	DECLARE_BITMAP(wan, VLAN_N_VID);
+	DECLARE_BITMAP(merged, VLAN_N_VID);
+	int ret;
+
+	if (proto != htons(ETH_P_8021Q) || vid >= VLAN_VID_MASK)
+		return -EOPNOTSUPP;
+	/* The networking core adds VID0 for priority-tag reception. */
+	if (!vid)
+		return 0;
+	if (!np)
+		return -ENODEV;
+	mutex_lock(&np->access);
+	mutex_lock(&eth->datapath_lock);
+	bitmap_copy(wan, np->wan_vlans, VLAN_N_VID);
+	if (add)
+		__set_bit(vid, wan);
+	else
+		__clear_bit(vid, wan);
+	bitmap_or(merged, wan, np->lan_vlans, VLAN_N_VID);
+	ret = zx279133_vlan_config_apply(np, merged);
+	if (!ret)
+		bitmap_copy(np->wan_vlans, wan, VLAN_N_VID);
+	mutex_unlock(&eth->datapath_lock);
+	mutex_unlock(&np->access);
+	return ret;
+}
+
+/* SDT0 leases are supplier-owned. No FFE table or background worker. */
+static struct zte_nppt_vlan *zte_nppt_vlan_find(struct zte_nppt *np, u16 vid)
+{
+	struct zte_nppt_vlan *v;
+
+	list_for_each_entry(v, &np->vlans, node)
+		if (v->vid == vid)
+			return v;
+	return NULL;
+}
+
+struct zte_nppt_vlan *zte_nppt_vlan_get(struct zte_nppt *np, u16 vid)
+{
+	/* Board VID0 words observed and packet-tested in R12/R16. */
+	static const struct zte_nppt_vlan_row board = {
+		.words = { 4290772992U, 65535, 4294967295U, 12291 },
+	};
+	struct zte_nppt_vlan_row base, check;
+	struct zte_nppt_vlan *v;
+	int ret = zte_nppt_native_ready(np);
+
+	if (ret)
+		return ERR_PTR(ret);
+	if (!np->eth->vid_key_active || !vid || vid >= 4095)
+		return ERR_PTR(-EOPNOTSUPP);
+	if (np->vlan_config_uncertain)
+		return ERR_PTR(-EUCLEAN);
+	v = zte_nppt_vlan_find(np, vid);
+	if (v) {
+		if (v->poisoned || v->users == U32_MAX)
+			return ERR_PTR(-EBUSY);
+		v->users++;
+		np->vlan_users++;
+		return v;
+	}
+	v = kzalloc(sizeof(*v), GFP_KERNEL);
+	if (!v)
+		return ERR_PTR(-ENOMEM);
+	v->vid = vid;
+	ret = zx279133_native_vlan_get(np->eth, 0, &base);
+	if (ret)
+		goto fail;
+	if (memcmp(&base, &board, sizeof(base))) {
+		ret = -ESTALE;
+		goto fail;
+	}
+	ret = zx279133_native_vlan_get(np->eth, vid, &v->original);
+	if (ret)
+		goto fail;
+	/* A configured CPU admission row is owned by this same supplier. */
+	if (test_bit(vid, np->configured_vlans)) {
+		if (memcmp(&v->original, &base, sizeof(base))) {
+			ret = -ESTALE;
+			goto fail;
+		}
+		v->original = np->vlan_originals[vid];
+		v->programmed = base;
+		goto acquired;
+	}
+	/* Do not adopt or overwrite a row configured by another consumer. */
+	if (memchr_inv(&v->original, 0, sizeof(v->original))) {
+		ret = -EBUSY;
+		goto fail;
+	}
+	v->programmed = base;
+	ret = zx279133_native_vlan_set(np->eth, vid, &v->programmed);
+	if (!ret) {
+		ret = zx279133_native_vlan_get(np->eth, vid, &check);
+		if (!ret && memcmp(&check, &v->programmed, sizeof(check)))
+			ret = -EIO;
+	}
+	if (ret) {
+		/* A failed write may be partial; quarantine a failed compensation. */
+		if (zx279133_native_vlan_set(np->eth, vid, &v->original) ||
+		    zx279133_native_vlan_get(np->eth, vid, &check) ||
+		    memcmp(&check, &v->original, sizeof(check))) {
+			v->poisoned = true;
+			np->vlan_rows++;
+			np->vlan_uncertain++;
+			list_add_tail(&v->node, &np->vlans);
+			return ERR_PTR(-EIO);
+		}
+		goto fail;
+	}
+acquired:
+	v->users = 1;
+	np->vlan_rows++;
+	np->vlan_users++;
+	list_add_tail(&v->node, &np->vlans);
+	return v;
+fail:
+	kfree(v);
+	return ERR_PTR(ret);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_vlan_get);
+
+int zte_nppt_vlan_put(struct zte_nppt *np, struct zte_nppt_vlan *v)
+{
+	struct zte_nppt_vlan_row check;
+	int ret;
+
+	if (!v)
+		return 0;
+	if (zte_nppt_vlan_find(np, v->vid) != v)
+		return -EINVAL;
+	if (!v->users)
+		return -EIO;
+	if (v->users > 1) {
+		v->users--;
+		np->vlan_users--;
+		return 0;
+	}
+	/* Removing the last flow must not remove the first-packet admission. */
+	if (test_bit(v->vid, np->configured_vlans))
+		goto released;
+	ret = zte_nppt_native_ready(np);
+	if (ret)
+		goto uncertain;
+	ret = zx279133_native_vlan_get(np->eth, v->vid, &check);
+	if (ret)
+		goto uncertain;
+	/* Preserve unknown external changes; never blindly zero a changed row. */
+	if (memcmp(&check, &v->programmed, sizeof(check)) &&
+	    memcmp(&check, &v->original, sizeof(check))) {
+		ret = -ESTALE;
+		goto uncertain;
+	}
+	ret = zx279133_native_vlan_set(np->eth, v->vid, &v->original);
+	if (ret)
+		goto uncertain;
+	ret = zx279133_native_vlan_get(np->eth, v->vid, &check);
+	if (ret || memcmp(&check, &v->original, sizeof(check))) {
+		ret = ret ?: -EIO;
+		goto uncertain;
+	}
+released:
+	if (v->poisoned)
+		np->vlan_uncertain--;
+	list_del(&v->node);
+	np->vlan_rows--;
+	np->vlan_users--;
+	kfree(v);
+	return 0;
+uncertain:
+	/* Do not lend a row again after a failed/partial last-user restore. */
+	if (!v->poisoned) {
+		v->poisoned = true;
+		np->vlan_uncertain++;
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_vlan_put);
+
+void zte_nppt_vlan_abandon(struct zte_nppt *np, struct zte_nppt_vlan *v)
+{
+	/* Failed install cleanup has no flow cookie; supplier retains ownership. */
+	if (v && zte_nppt_vlan_find(np, v->vid) == v) {
+		np->vlan_users -= v->users;
+		if (!v->poisoned)
+			np->vlan_uncertain++;
+		v->users = 0;
+		v->poisoned = true;
+	}
+}
+EXPORT_SYMBOL_GPL(zte_nppt_vlan_abandon);
+
+int zte_nppt_native_vlan_get(struct zte_nppt *np,
+			     u16 vid, struct zte_nppt_vlan_row *row)
+{
+	int ret = zte_nppt_native_ready(np);
+
+	if (ret)
+		return ret;
+	return zx279133_native_vlan_get(np->eth, vid, row);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_native_vlan_get);
+
+int zte_nppt_native_vlan_set(struct zte_nppt *np,
+			     u16 vid, const struct zte_nppt_vlan_row *row)
+{
+	int ret = zte_nppt_native_ready(np);
+
+	if (ret)
+		return ret;
+	if (vid >= VLAN_N_VID)
+		return -EINVAL;
+	if (zte_nppt_vlan_find(np, vid) || test_bit(vid, np->configured_vlans))
+		return -EBUSY;
+	return zx279133_native_vlan_set(np->eth, vid, row);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_native_vlan_set);
