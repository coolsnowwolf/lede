+/* The fixed ME context window is calibrated by the author's PPU tracer.
+ * Running firmware can change these words while we read: retain both PC and
+ * stop observations, and never label a running observation coherent.
+ */
+int zte_nppt_ppu_context_get(struct zte_nppt *np, u8 me,
+			    struct zte_nppt_ppu_context *context)
+{
+	struct zx279133_eth *eth;
+	unsigned int i;
+	int ret = zte_nppt_native_ready(np);
+
+	if (ret)
+		return ret;
+	if (!context || me >= 8)
+		return -EINVAL;
+	eth = np->eth;
+	mutex_lock(&eth->np_ind_lock);
+	context->firmware_crc = READ_ONCE(eth->ppu_firmware_crc32);
+	context->key_rc = -ENODATA;
+	context->interrupt_mask = readl(eth->pps_base + 0x90008);
+	context->stopped_before = readl(eth->pps_base + 0x90004) & 0xff;
+	context->pc_before = readl(eth->pps_base + 0x90100 + me * 4) & 0xffff;
+	for (i = 0; i < ARRAY_SIZE(context->words); i++)
+		context->words[i] = readl(eth->pps_base + 0x94400 + me * 0x400 + i * 4);
+	context->pc_after = readl(eth->pps_base + 0x90100 + me * 4) & 0xffff;
+	context->stopped_after = readl(eth->pps_base + 0x90004) & 0xff;
+	mutex_unlock(&eth->np_ind_lock);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_ppu_context_get);
