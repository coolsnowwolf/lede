+int zte_nppt_ppu_me_diagnostics_get(struct zte_nppt *np,
+				    struct zte_nppt_me_diagnostics *diagnostics)
+{
+	struct zte_nppt_me_diagnostics sample = {};
+	u64 now;
+	int ret = zte_nppt_native_ready(np);
+
+	if (ret)
+		return ret;
+	if (!diagnostics)
+		return -EINVAL;
+	if (!np->eth->ppu_mcode_prepared)
+		return -ENETDOWN;
+	now = ktime_get_ns();
+	/* access + datapath_lock serialize cache users and supplier reset/remove. */
+	if (np->me_stats_valid && np->me_stats.stats.generation == np->generation &&
+	    now - np->me_stats.stats.sampled_ns < ZTE_NPPT_ME_STATS_INTERVAL_NS) {
+		*diagnostics = np->me_stats;
+		return 0;
+	}
+	ret = zx279133_ppu_me_diagnostics_read(np->eth, &sample);
+	if (ret)
+		return ret;
+	sample.stats.generation = np->generation;
+	sample.stats.sampled_ns = ktime_get_ns();
+	np->me_stats = sample;
+	np->me_stats_valid = true;
+	*diagnostics = sample;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_ppu_me_diagnostics_get);
