+/* No registration/init callback uses these experimental policy operations. */
+static int zte_nppt_native_ready(struct zte_nppt *np)
+{
+	struct zx279133_eth *eth = np->eth;
+
+	if (!eth)
+		return -ENODEV;
+	lockdep_assert_held(&eth->datapath_lock);
+	return eth->hardware_prepared ? 0 : -ENETDOWN;
+}
