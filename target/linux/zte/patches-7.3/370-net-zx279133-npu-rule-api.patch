+}
+EXPORT_SYMBOL_GPL(zte_nppt_meter_mac_get);
+
+int zte_nppt_mac_global_get(struct zte_nppt *np, bool *enabled)
+{
+	u32 w[4];
+	int ret = zx279133_native_sdt128_io(np->eth, 1, 0, w, false);
+
+	if (!ret)
+		*enabled = !!(w[3] & BIT(26));
+	return ret;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_mac_global_get);
+
+int zte_nppt_mac_global_set(struct zte_nppt *np, bool enabled)
+{
+	u32 w[4], actual[4];
+	int ret = zx279133_native_sdt128_io(np->eth, 1, 0, w, false);
+
+	if (ret)
+		return ret;
+	w[3] = (w[3] & ~BIT(26)) | (enabled ? BIT(26) : 0);
+	ret = zx279133_native_sdt128_io(np->eth, 1, 0, w, true);
+	if (!ret)
+		ret = zx279133_native_sdt128_io(np->eth, 1, 0, actual, false);
+	if (!ret && memcmp(w, actual, sizeof(w)))
+		ret = -EIO;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_mac_global_set);
+
+struct zte_nppt_host *zte_nppt_host_lookup_get(struct zte_nppt *np, const u8 *mac)
+{
+	struct zte_nppt_host *host = zx279133_host_lookup_get(np->hosts, mac);
+	struct net_device *bridge, *port;
+	u16 logical = 0, candidate;
+
+	if (!IS_ERR(host) || PTR_ERR(host) != -ENOENT || !np->eth->lan_ndev)
+		return host;
+	/* A MAC policy must also exist for clients whose connections never
+	 * qualify for a fast flow. Resolve the authoritative VID0 bridge FDB,
+	 * restricted to this supplier's live LAN ports; never guess a port.
+	 */
+	rcu_read_lock();
+	for_each_netdev_rcu(dev_net(np->eth->lan_ndev), bridge) {
+		if (!netif_is_bridge_master(bridge))
+			continue;
+		port = br_fdb_find_port(bridge, mac, 0);
+		if (!port || !netif_running(port) || !netif_carrier_ok(port))
+			continue;
+		if (zte_nppt_dev_port(np, port, &candidate) != ZX279133_FLOW_PORT_LAN ||
+		    candidate < 59 || candidate > 62)
+			continue;
+		if (logical && logical != candidate) {
+			logical = 0;
+			break;
+		}
+		logical = candidate;
+	}
+	rcu_read_unlock();
+	return logical ? zx279133_host_get(np->hosts, mac, logical) : host;
+}
+EXPORT_SYMBOL_GPL(zte_nppt_host_lookup_get);
+
+int zte_nppt_host_limit(struct zte_nppt *np, struct zte_nppt_host *host,
+			u8 slot, bool upload, bool download)
+{
+	return zx279133_host_limit(np->hosts, host, slot, upload, download);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_host_limit);
+
+void zte_nppt_host_watch(struct zte_nppt *np, u8 slot, const u8 *mac)
+{
+	zx279133_host_watch(np->hosts, slot, mac);
+}
+EXPORT_SYMBOL_GPL(zte_nppt_host_watch);
