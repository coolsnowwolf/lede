Subject: [PATCH] jffs2: support the shared SR1010 Plugin volume

Retain the JFFS2 handling needed to mount the existing shared volume.

--- a/fs/jffs2/erase.c
+++ b/fs/jffs2/erase.c
@@ -173,7 +173,7 @@
 {
 	/* For NAND, if the failure did not occur at the device level for a
 	   specific physical page, don't bother updating the bad block table. */
-	if (jffs2_cleanmarker_oob(c) && (bad_offset != (uint32_t)MTD_FAIL_ADDR_UNKNOWN)) {
+	if (jffs2_nand(c) && (bad_offset != (uint32_t)MTD_FAIL_ADDR_UNKNOWN)) {
 		/* We had a device-level failure to erase.  Let's see if we've
 		   failed too many times. */
 		if (!jffs2_write_nand_badblock(c, jeb, bad_offset)) {
--- a/fs/jffs2/fs.c
+++ b/fs/jffs2/fs.c
@@ -688,7 +688,7 @@
 static int jffs2_flash_setup(struct jffs2_sb_info *c) {
 	int ret = 0;
 
-	if (jffs2_cleanmarker_oob(c)) {
+	if (jffs2_nand(c)) {
 		/* NAND flash... do setup accordingly */
 		ret = jffs2_nand_flash_setup(c);
 		if (ret)
@@ -721,7 +721,7 @@
 
 void jffs2_flash_cleanup(struct jffs2_sb_info *c) {
 
-	if (jffs2_cleanmarker_oob(c)) {
+	if (jffs2_nand(c)) {
 		jffs2_nand_flash_cleanup(c);
 	}
 
--- a/fs/jffs2/os-linux.h
+++ b/fs/jffs2/os-linux.h
@@ -73,6 +73,7 @@
 #endif
 
 #define jffs2_is_writebuffered(c) (0)
+#define jffs2_nand(c) (0)
 #define jffs2_cleanmarker_oob(c) (0)
 #define jffs2_write_nand_cleanmarker(c,jeb) (-EIO)
 
@@ -108,7 +109,15 @@
 #define jffs2_can_mark_obsolete(c) (c->mtd->flags & (MTD_BIT_WRITEABLE))
 #endif
 
-#define jffs2_cleanmarker_oob(c) (c->mtd->type == MTD_NANDFLASH)
+#define jffs2_nand(c) (c->mtd->type == MTD_NANDFLASH)
+
+/*
+ * NAND keeps the clean marker in the OOB, programmed apart from the data of
+ * the first page. A page that can be programmed only once cannot take it
+ * there: it gets a clean marker in the data area instead (see
+ * jffs2_nand_flash_setup()).
+ */
+#define jffs2_cleanmarker_oob(c) (jffs2_nand(c) && !(c)->mtd->program_once)
 
 #define jffs2_wbuf_dirty(c) (!!(c)->wbuf_len)
 
--- a/fs/jffs2/scan.c
+++ b/fs/jffs2/scan.c
@@ -113,7 +113,7 @@
 	if (!flashbuf) {
 		/* For NAND it's quicker to read a whole eraseblock at a time,
 		   apparently */
-		if (jffs2_cleanmarker_oob(c))
+		if (jffs2_nand(c))
 			try_size = c->sector_size;
 		else
 			try_size = PAGE_SIZE;
@@ -470,11 +470,11 @@
 	jffs2_dbg(1, "%s(): Scanning block at 0x%x\n", __func__, ofs);
 
 #ifdef CONFIG_JFFS2_FS_WRITEBUFFER
+	if (jffs2_nand(c) && mtd_block_isbad(c->mtd, jeb->offset))
+		return BLK_STATE_BADBLOCK;
+
 	if (jffs2_cleanmarker_oob(c)) {
 		int ret;
-
-		if (mtd_block_isbad(c->mtd, jeb->offset))
-			return BLK_STATE_BADBLOCK;
 
 		ret = jffs2_check_nand_cleanmarker(c, jeb);
 		jffs2_dbg(2, "jffs_check_nand_cleanmarker returned %d\n", ret);
@@ -669,6 +669,19 @@
 
 		if (buf_ofs + buf_len < ofs + sizeof(*node)) {
 			buf_len = min_t(uint32_t, buf_size, jeb->offset + c->sector_size - ofs);
+			/*
+			 * A clean marker as long as a page ends beyond what was read
+			 * first. When nothing but the marker has been found, read after
+			 * it only as much as is read at the start of any block, and let
+			 * the check below decide whether the block is empty, instead of
+			 * reading all of the block.
+			 */
+			if (c->cleanmarker_size && buf_ofs == jeb->offset &&
+			    ofs == jeb->offset + PAD(c->cleanmarker_size) &&
+			    jeb->used_size == PAD(c->cleanmarker_size) &&
+			    !jeb->dirty_size && !ref_next(jeb->first_node))
+				buf_len = min_t(uint32_t, buf_len,
+						EMPTY_SCAN_SIZE(c->sector_size));
 			jffs2_dbg(1, "Fewer than %zd bytes (node header) left to end of buf. Reading 0x%x at 0x%08x\n",
 				  sizeof(struct jffs2_unknown_node),
 				  buf_len, ofs);
@@ -709,7 +722,9 @@
 
 			/* If we're only checking the beginning of a block with a cleanmarker,
 			   bail now */
-			if (buf_ofs == jeb->offset && jeb->used_size == PAD(c->cleanmarker_size) &&
+			if ((buf_ofs == jeb->offset ||
+			     buf_ofs == jeb->offset + PAD(c->cleanmarker_size)) &&
+			    jeb->used_size == PAD(c->cleanmarker_size) &&
 			    c->cleanmarker_size && !jeb->dirty_size && !ref_next(jeb->first_node)) {
 				jffs2_dbg(1, "%d bytes at start of block seems clean... assuming all clean\n",
 					  EMPTY_SCAN_SIZE(c->sector_size));
--- a/fs/jffs2/wbuf.c
+++ b/fs/jffs2/wbuf.c
@@ -1186,8 +1186,20 @@
 	if (!c->mtd->oobsize)
 		return 0;
 
-	/* Cleanmarker is out-of-band, so inline size zero */
-	c->cleanmarker_size = 0;
+	if (c->mtd->program_once) {
+		/*
+		 * The OOB cannot be programmed apart from the data, so the clean
+		 * marker is a node in the data area. It takes the whole first
+		 * page: the first node of the block then starts on the next
+		 * page, and no page is programmed twice.
+		 */
+		c->cleanmarker_size = c->mtd->writesize;
+		pr_info("NAND pages can be programmed once: clean markers are in the data, %u bytes\n",
+			c->cleanmarker_size);
+	} else {
+		/* Cleanmarker is out-of-band, so inline size zero */
+		c->cleanmarker_size = 0;
+	}
 
 	if (c->mtd->oobavail == 0) {
 		pr_err("inconsistent device description\n");
