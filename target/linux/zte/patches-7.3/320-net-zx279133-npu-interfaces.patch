+static inline struct zx279133_netdev_stats *
+zx279133_netdev_stats(struct zx279133_eth *eth, struct net_device *ndev)
+{
+	if (ndev == eth->ndev)
+		return &eth->stats;
+
+	return &((struct zx279133_lan_netdev_priv *)netdev_priv(ndev))->stats;
+}
