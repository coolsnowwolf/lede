+#include <linux/atomic.h>
+
+struct zx279133_netdev_stats {
+	atomic64_t rx_errors;
+	atomic64_t tx_errors;
+	atomic64_t rx_dropped;
+	atomic64_t tx_dropped;
+	atomic64_t rx_length_errors;
+};
