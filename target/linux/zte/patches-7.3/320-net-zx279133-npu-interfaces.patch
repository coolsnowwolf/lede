+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_ZTE_NPPT_NATIVE_H
+#define _LINUX_ZTE_NPPT_NATIVE_H
+
+#include <linux/types.h>
+
+struct zte_nppt;
+
+/* Experimental CPU133 hardware primitives, separate from flow capabilities.
+ * All instance calls require zte_nppt_begin()/end() or a supplier callback.
+ * The exclusive flow client coordinates these shared policy resources. These
+ * calls do not allocate profiles, install flows, or translate Linux units.
+ * No call is made by probe/open merely because these symbols are present.
+ */
+#define ZTE_NPPT_NATIVE_API_VERSION 1
+#define ZTE_NPPT_PLCR_PROFILES 128
+#define ZTE_NPPT_PLCR_FLOWS 4096
+
+/* OEM ppu_get_all_mes_mf_stats(): raw MF events, not client-flow totals or
+ * ME busy/idle cycles. SOP/EOP delimit packets; VALID counts transfer events.
+ * Split low/high reads follow the OEM order and are not an atomic snapshot.
+ * Queries share a 3-second, on-demand cache. There is no polling worker.
+ */
+#define ZTE_NPPT_PPU_MES 8
+#define ZTE_NPPT_ME_STATS_INTERVAL_NS (3ULL * 1000000000)
+struct zte_nppt_me_counters {
+	u64 in_valid;
+	u64 in_sop;
+	u64 in_eop;
+	u64 out_valid;
+	u64 out_sop;
+	u64 out_eop;
+};
+
+struct zte_nppt_me_stats {
+	u64 generation;
+	u64 sampled_ns;
+	u32 not_idle;
+	struct zte_nppt_me_counters me[ZTE_NPPT_PPU_MES];
+};
+
+int zte_nppt_ppu_me_stats_get(struct zte_nppt *np,
+			      struct zte_nppt_me_stats *stats);
+
+/* Additive diagnostics; keep the original stats type/API layout unchanged.
+ * ready/grant are raw OEM low/high pairs, not established cycle counters.
+ * Control words report current configuration; no enable/clock write occurs.
+ */
+struct zte_nppt_me_state_raw {
+	u64 ready;
+	u64 grant;
+};
+
+struct zte_nppt_me_diagnostics {
+	struct zte_nppt_me_stats stats;
+	u64 thread_active_raw;
+	u64 cluster_grant_raw;
+	u32 active_cnt_en_raw;
+	u32 grant_cnt_en_raw;
+	u32 bank_miss_cnt_en_raw;
+	u32 stat_clock_raw;
+	struct zte_nppt_me_state_raw state[ZTE_NPPT_PPU_MES];
+};
+
+int zte_nppt_ppu_me_diagnostics_get(struct zte_nppt *np,
+				    struct zte_nppt_me_diagnostics *diagnostics);
+
+/* On-demand configuration observation; not counters or a packet capture.
+ * Indirect reads use the supplier's serialized read transactions, including
+ * save/restore of auto-gating. No table data, frame limit or ME control writes.
+ * Component errors are explicit; unattempted rows carry -ECANCELED.
+ */
+#define ZTE_NPPT_FRAME_SPA_ROWS 7
+struct zte_nppt_frame_spa {
+	u32 mem;
+	u32 raw;
+	s32 rc;
+};
+
+struct zte_nppt_frame_limits {
+	u64 generation;
+	u32 global_raw[4];
+	s32 global_rc;
+	u32 xmac_rx[2];
+	u32 xmac_frame[2];
+	u32 sdet_up;
+	u32 sdet_down;
+	struct zte_nppt_frame_spa spa[ZTE_NPPT_FRAME_SPA_ROWS];
+};
+
+int zte_nppt_frame_limits_get(struct zte_nppt *np,
+			    struct zte_nppt_frame_limits *limits);
+
+/* Passive running-context observation, not an atomic packet snapshot.
+ * No instruction/gate/ME control register is written by this API.
+ */
+#define ZTE_NPPT_PPU_CONTEXT_WORDS 129
+struct zte_nppt_ppu_context {
+	u32 firmware_crc;
+	u32 stage;
+	u32 interrupt_mask;
+	u32 stopped_final;
+	u32 key_bank;
+	u32 key[17];
+	int key_rc;
+	bool captured;
+	bool restore_verified;
+	bool resume_verified;
+	bool mask_restored;
+	u32 pc_before;
+	u32 pc_after;
+	u32 stopped_before;
+	u32 stopped_after;
+	u32 words[ZTE_NPPT_PPU_CONTEXT_WORDS];
+};
+
+int zte_nppt_ppu_context_get(struct zte_nppt *np, u8 me,
+			    struct zte_nppt_ppu_context *context);
+
+/* Explicit debug operation: briefly traps a fixed entry/query site, restores
+ * the instruction and resumes all contexts trapped by this request.
+ */
+int zte_nppt_ppu_capture(struct zte_nppt *np, u16 pc, u8 *me,
+			 struct zte_nppt_ppu_context *context);
+/* Bounded PC139 VID extraction experiment; restores both SRAM blocks. */
+int zte_nppt_ppu_vid_probe(struct zte_nppt *np, u8 *me,
+			   struct zte_nppt_ppu_context *context);
+
+struct zte_nppt_plcr_profile {
+	u32 cir;
+	u32 eir;
+	u32 cbs;
+	u32 ebs;
+	u8 cd_mode;
+	u8 cf_flag;
+	u8 cm_flag;
+	u8 pkt_sign;
+};
+
+struct zte_nppt_plcr_binding {
+	u8 profile;
+	bool enabled;
+};
+
+struct zte_nppt_plcr_timing {
+	u32 time_count;
+	u32 packet_length;
+	u32 packet_offset;
+	u32 loose_length;
+};
+
+struct zte_nppt_ssch_global {
+	u32 fill_time;
+	bool shaping;
+	bool dwrr;
+};
+
+/* Native token fields; neither fill nor cap is specified in bytes/second. */
+struct zte_nppt_ssch_shaper {
+	u32 fill;
+	u32 cap;
+	bool enabled;
+};
+
+/* RED buffer RAM indices, not SSCH queues, Linux TX queues or port numbers.
+ * The OEM getter/initialization use 0..400. Its setter accepts 401 as well;
+ * that inconsistent extra index is deliberately not exposed here.
+ * All fields are raw: space units and probability encoding are uncalibrated.
+ * This is congestion/drop hardware, not a CAKE/FQ-CoDel offload contract.
+ */
+#define ZTE_NPPT_RED_QUEUES 401
+struct zte_nppt_red_buffer {
+	u32 max_space;
+	u32 yellow_p0;
+	u32 yellow_p1;
+	u32 green_p0;
+	u32 green_p1;
+	u32 yellow_th0;
+	u32 yellow_th1;
+	u32 green_th0;
+	u32 green_th1;
+};
+
+/* Independent hardware occupancy reads; not atomic, bytes or packet totals. */
+struct zte_nppt_red_usage {
+	u32 input_raw;
+	u32 output_raw;
+	u32 buffer_raw;
+};
+
+/* R1 input/output fields are the shared portions, not whole-queue totals.
+ * Keep that ABI; the full getter adds the independently returned self areas.
+ */
+struct zte_nppt_red_usage_full {
+	struct zte_nppt_red_usage shared;
+	u32 input_self_raw;
+	u32 output_self_raw;
+};
+
+int zte_nppt_native_red_buffer_get(struct zte_nppt *np, u16 queue,
+				   struct zte_nppt_red_buffer *config);
+/* Snapshot + write + readback under one indirect lock. Restore original raw
+ * words on a write/readback failure; -EUCLEAN means restoration is unverified.
+ * No automatic enable or queue/port mapping is implied by this operation.
+ */
+int zte_nppt_native_red_buffer_set(struct zte_nppt *np, u16 queue,
+				   const struct zte_nppt_red_buffer *config);
+int zte_nppt_native_red_usage_get(struct zte_nppt *np, u16 queue,
+				  struct zte_nppt_red_usage *usage);
+int zte_nppt_native_red_usage_full_get(struct zte_nppt *np, u16 queue,
+				       struct zte_nppt_red_usage_full *usage);
+
+/* Managed Ethernet SSCH shaping. Rate uses the OEM kbps contract and the
+ * current NPPT working clock, not the SDK's software default of 500 MHz.
+ * cap_raw=0 selects OEM tm_getFillcap(); its physical unit remains unverified.
+ * Port scope includes all accelerated/software traffic on that NP output.
+ * This API does not implement CAKE/FQ-CoDel or classify flows into queues.
+ * Explicit experimental_sqm opt-in is required; default probe does no writes.
+ */
+#define ZTE_NPPT_SHAPER_PORT 8
+#define ZTE_NPPT_SHAPER_CONTROL_OWNER 1ULL
+struct zte_nppt_shaper_request {
+	u32 rate_kbps;
+	u32 cap_raw;
+};
+
+struct zte_nppt_shaper_status {
+	u64 owner;
+	u64 clock_hz;
+	u32 rate_kbps;
+	u32 nominal_kbps;
+	u32 fill_time;
+	struct zte_nppt_ssch_shaper hardware;
+	u8 port;
+	u8 queue;
+	bool configured;
+	bool applied;
+	bool uncertain;
+};
+
+struct net_device;
+/* dev must be the NP WAN netdev or the shared LAN conduit, not a VLAN,
+ * PPP, macvlan or DSA user netdev. A physical output is one ownership domain;
+ * the same owner may configure its port and any of its eight child queues.
+ * begin/end (or supplier callback) must be held, as with native APIs.
+ */
+int zte_nppt_shaper_set(struct zte_nppt *np, struct net_device *dev, u8 queue,
+			u64 owner, const struct zte_nppt_shaper_request *request);
+int zte_nppt_shaper_clear(struct zte_nppt *np, struct net_device *dev, u8 queue,
+			  u64 owner);
+int zte_nppt_shaper_status(struct zte_nppt *np, struct net_device *dev, u8 queue,
+			   struct zte_nppt_shaper_status *status);
+
+struct zte_nppt_vlan_row {
+	u32 words[4];
+};
+
+/* Raw token fields, after the OEM rate conversion, without its silent clamps.
+ * The captured OEM setter accepts cd_mode == 2 only; other modes are rejected.
+ * Profile writes affect all flows bound to that profile. On a failed multiword
+ * write, callers must read back; failure does not imply an unchanged profile.
+ */
+int zte_nppt_native_plcr_profile_get(struct zte_nppt *np, u8 id,
+				     struct zte_nppt_plcr_profile *profile);
+int zte_nppt_native_plcr_profile_set(struct zte_nppt *np, u8 id,
+				     const struct zte_nppt_plcr_profile *profile);
+int zte_nppt_native_plcr_binding_get(struct zte_nppt *np, u16 id,
+				     struct zte_nppt_plcr_binding *binding);
+/* Like the OEM setter, ERAM-backed writes reset the row's token state. */
+int zte_nppt_native_plcr_binding_set(struct zte_nppt *np, u16 id,
+				     const struct zte_nppt_plcr_binding *binding);
+int zte_nppt_native_plcr_timing_get(struct zte_nppt *np,
+				    struct zte_nppt_plcr_timing *timing);
+
+/* Ports/queues are NP SSCH indices, not Linux ifindices or DSA port numbers.
+ * mode_bit is the unmodified OEM field (0/1); weight is the native 18-bit word.
+ * Shaper replacement disables the target before programming fill/cap. An error
+ * can leave it disabled/partly updated; use getters before deciding recovery.
+ */
+int zte_nppt_native_ssch_global_get(struct zte_nppt *np,
+				    struct zte_nppt_ssch_global *config);
+int zte_nppt_native_ssch_global_set(struct zte_nppt *np,
+				    const struct zte_nppt_ssch_global *config);
+int zte_nppt_native_ssch_mode_get(struct zte_nppt *np, u8 port, u8 queue,
+				  u8 *mode_bit);
+int zte_nppt_native_ssch_mode_set(struct zte_nppt *np, u8 port, u8 queue,
+				  u8 mode_bit);
+int zte_nppt_native_ssch_weight_get(struct zte_nppt *np, u8 port, u8 queue,
+				    u32 *weight);
+int zte_nppt_native_ssch_weight_set(struct zte_nppt *np, u8 port, u8 queue,
+				    u32 weight);
+int zte_nppt_native_ssch_queue_get(struct zte_nppt *np, u8 port, u8 queue,
+				   struct zte_nppt_ssch_shaper *shaper);
+int zte_nppt_native_ssch_queue_set(struct zte_nppt *np, u8 port, u8 queue,
+				   const struct zte_nppt_ssch_shaper *shaper);
+int zte_nppt_native_ssch_port_get(struct zte_nppt *np, u8 port,
+				  struct zte_nppt_ssch_shaper *shaper);
+int zte_nppt_native_ssch_port_set(struct zte_nppt *np, u8 port,
+				  const struct zte_nppt_ssch_shaper *shaper);
+
+/* SDT0 control only: this does not add VID to the fast-flow match key. */
+int zte_nppt_native_vlan_get(struct zte_nppt *np, u16 vid,
+			     struct zte_nppt_vlan_row *row);
+int zte_nppt_native_vlan_set(struct zte_nppt *np, u16 vid,
+			     const struct zte_nppt_vlan_row *row);
+int zte_nppt_native_vlan_mode_get(struct zte_nppt *np, u16 vid, u8 port,
+				  u8 *mode);
+int zte_nppt_native_vlan_mode_set(struct zte_nppt *np, u16 vid, u8 port,
+				  u8 mode);
+/* SPA memory indices are deliberately not guessed from Linux port numbers. */
+int zte_nppt_native_pvid_get(struct zte_nppt *np, u8 mem, u16 *vid, u8 *prio);
+int zte_nppt_native_pvid_set(struct zte_nppt *np, u8 mem, u16 vid, u8 prio);
+/* NP port index; includes OEM companion-row updates for ports 0 and 5. */
+int zte_nppt_native_invlan_get(struct zte_nppt *np, u8 port, bool *enabled);
+int zte_nppt_native_invlan_set(struct zte_nppt *np, u8 port, bool enabled);
+
+/* Managed experimental fast-flow policers. NPU owns global resources;
+ * fnoffload owns each lease until the referencing rule is invalidated.
+ * All calls require begin/end. A failed put retains the lease for retry.
+ * Profile contents are native tokens; this API claims no Linux rate units.
+ */
+struct zte_nppt_meter;
+int zte_nppt_meter_get(struct zte_nppt *np,
+		       const struct zte_nppt_plcr_profile *profile,
+		       const void *scope, u32 action_index,
+		       struct zte_nppt_meter **meter);
+int zte_nppt_meter_put(struct zte_nppt *np, struct zte_nppt_meter *meter);
+/* Failed installation with no live HW rule: transfer cleanup back to NPU. */
+void zte_nppt_meter_abandon(struct zte_nppt *np, struct zte_nppt_meter *meter);
+u8 zte_nppt_meter_bucket(const struct zte_nppt_meter *meter);
+int zte_nppt_meter_mac_get(struct zte_nppt *np,
+			   const struct zte_nppt_plcr_profile *profile,
+			   u8 slot, bool download, struct zte_nppt_meter **out);
+int zte_nppt_mac_global_get(struct zte_nppt *np, bool *enabled);
+int zte_nppt_mac_global_set(struct zte_nppt *np, bool enabled);
+#endif
