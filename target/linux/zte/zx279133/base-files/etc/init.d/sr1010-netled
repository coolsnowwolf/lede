#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'zte,zx279133-sr1010' ] || return 0
	[ -d /sys/class/leds/sr1010:white ] && [ -d /sys/class/leds/sr1010:red ] || return 0
	[ "$(uci -q get sr1010-netled.main.enabled)" = 0 ] && return 0
	procd_open_instance
	procd_set_param command /usr/sbin/sr1010-netled
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sr1010-netled
}
