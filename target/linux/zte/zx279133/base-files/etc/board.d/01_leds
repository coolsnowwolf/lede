#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
zte,zx279133-sr1010)
	# The socket lights are SoC GPIOs. They follow the link of their port only:
	# for the LAN ports, counting traffic means reading the switch statistics
	# over MDIO at every blink.
	ucidef_set_led_netdev "wan" "WAN" "sr1010:wan" "eth0" "link"
	ucidef_set_led_netdev "lan1" "LAN1" "sr1010:lan1" "lan1" "link"
	ucidef_set_led_netdev "lan2" "LAN2" "sr1010:lan2" "lan2" "link"
	ucidef_set_led_netdev "lan3" "LAN3" "sr1010:lan3" "lan3" "link"
	ucidef_set_led_netdev "lan4" "LAN4" "sr1010:lan4" "lan4" "link"
	;;
esac

board_config_flush

exit 0
