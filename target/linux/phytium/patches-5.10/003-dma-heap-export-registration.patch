From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] dma-buf: export heap registration for external heap drivers

Allow the Phytium NPU heap module to register with the Linux 5.10
DMA-BUF heap framework.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/drivers/dma-buf/dma-heap.c
+++ b/drivers/dma-buf/dma-heap.c
@@ -11,6 +11,7 @@
 #include <linux/device.h>
 #include <linux/dma-buf.h>
 #include <linux/err.h>
+#include <linux/export.h>
 #include <linux/xarray.h>
 #include <linux/list.h>
 #include <linux/slab.h>
@@ -277,6 +278,8 @@
 	return err_ret;
 }
 
+EXPORT_SYMBOL_GPL(dma_heap_add);
+
 static char *dma_heap_devnode(struct device *dev, umode_t *mode)
 {
 	return kasprintf(GFP_KERNEL, "dma_heap/%s", dev_name(dev));
