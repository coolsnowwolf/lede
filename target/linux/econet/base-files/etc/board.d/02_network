. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/econet.sh

econet_setup_interfaces()
{
	local board="$1"

	case "$board" in
	dasan,h660gm-a-airtel|\
	dasan,h660gm-a-generic|\
	econet,en7528-generic|\
	jiofiber,jcow407|\
	jiofiber,jcow414)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		;;
	*)
		# The remaining boards have no DSA switch driver yet.
		ucidef_set_interface_lan "eth0"
		;;
	esac
}

econet_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	chinamobile,gs3101)
		wan_mac="$(get_mac_gs3101)"
		[ -n "$wan_mac" ] && lan_mac="$(macaddr_add $wan_mac 1)"
		;;
	huawei,hg2821t-u)
		local conffile="/tmp/configuration_a/factory.conf"
		lan_mac=$(get_mac_ascii "$conffile" brmac)
		wan_mac=$(get_mac_ascii "$conffile" internetmac)
		label_mac=$wan_mac
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	[ -n "$label_mac" ] && ucidef_set_label_macaddr "$label_mac"
}

board_config_update
board=$(board_name)
econet_setup_interfaces $board
econet_setup_macs $board
board_config_flush

exit 0
