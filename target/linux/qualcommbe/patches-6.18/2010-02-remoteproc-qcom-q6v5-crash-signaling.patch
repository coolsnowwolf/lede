From: ViKing <viking.yfy@qq.com>
Date: Tue, 27 Oct 2026 12:46:53 +0800
Subject: [PATCH] remoteproc: qcom: distinguish Q6 crash wakeups from acknowledgements

Read crash reasons from the correct SMEM host and propagate boot/shutdown acknowledgement state through all Q6 consumers.

Split from:
  2010-02-remoteproc-qcom-secure-wcss-startup-signaling.patch

Merged from:
  2010-02-remoteproc-qcom-q6v5-read-crash-reason-from-remote-smem.patch
  2010-04-remoteproc-qcom-q6v5-distinguish-crash-completions.patch

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/remoteproc/qcom_q6v5.c
+++ b/drivers/remoteproc/qcom_q6v5.c
@@ -61,6 +61,8 @@ int qcom_q6v5_prepare(struct qcom_q6v5 *
 	reinit_completion(&q6v5->start_done);
 	reinit_completion(&q6v5->stop_done);
 
+	WRITE_ONCE(q6v5->start_ack, false);
+	WRITE_ONCE(q6v5->stop_ack, false);
 	q6v5->running = true;
 	q6v5->handover_issued = false;
 
@@ -96,17 +98,23 @@ static irqreturn_t q6v5_wdog_interrupt(i
 
 	/* Sometimes the stop triggers a watchdog rather than a stop-ack */
 	if (!q6v5->running) {
+		WRITE_ONCE(q6v5->stop_ack, true);
 		complete(&q6v5->stop_done);
 		return IRQ_HANDLED;
 	}
 
-	msg = qcom_smem_get(QCOM_SMEM_HOST_ANY, q6v5->crash_reason, &len);
+	msg = qcom_smem_get(q6v5->crash_reason_smem_host,
+			    q6v5->crash_reason, &len);
 	if (!IS_ERR(msg) && len > 0 && msg[0])
 		dev_err(q6v5->dev, "watchdog received: %s\n", msg);
 	else
 		dev_err(q6v5->dev, "watchdog without message\n");
 
 	q6v5->running = false;
+
+	/* Wake boot/shutdown so recovery does not wait for a timeout. */
+	complete_all(&q6v5->start_done);
+	complete_all(&q6v5->stop_done);
 	rproc_report_crash(q6v5->rproc, RPROC_WATCHDOG);
 
 	return IRQ_HANDLED;
@@ -121,13 +129,18 @@ static irqreturn_t q6v5_fatal_interrupt(
 	if (!q6v5->running)
 		return IRQ_HANDLED;
 
-	msg = qcom_smem_get(QCOM_SMEM_HOST_ANY, q6v5->crash_reason, &len);
+	msg = qcom_smem_get(q6v5->crash_reason_smem_host,
+			    q6v5->crash_reason, &len);
 	if (!IS_ERR(msg) && len > 0 && msg[0])
 		dev_err(q6v5->dev, "fatal error received: %s\n", msg);
 	else
 		dev_err(q6v5->dev, "fatal error without message\n");
 
 	q6v5->running = false;
+
+	/* Wake boot/shutdown so recovery does not wait for a timeout. */
+	complete_all(&q6v5->start_done);
+	complete_all(&q6v5->stop_done);
 	rproc_report_crash(q6v5->rproc, RPROC_FATAL_ERROR);
 
 	return IRQ_HANDLED;
@@ -137,6 +150,7 @@ static irqreturn_t q6v5_ready_interrupt(
 {
 	struct qcom_q6v5 *q6v5 = data;
 
+	WRITE_ONCE(q6v5->start_ack, true);
 	complete(&q6v5->start_done);
 
 	return IRQ_HANDLED;
@@ -149,14 +163,19 @@ static irqreturn_t q6v5_ready_interrupt(
  *
  * qcom_q6v5_unprepare() should not be called when this function fails.
  *
- * Return: 0 on success, -ETIMEDOUT on timeout
+ * Return: 0 on success, -ETIMEDOUT on timeout or when a crash woke the
+ * waiter without a ready ACK
  */
 int qcom_q6v5_wait_for_start(struct qcom_q6v5 *q6v5, int timeout)
 {
 	int ret;
 
 	ret = wait_for_completion_timeout(&q6v5->start_done, timeout);
-	return !ret ? -ETIMEDOUT : 0;
+	if (!ret)
+		return -ETIMEDOUT;
+
+	return READ_ONCE(q6v5->start_ack) && READ_ONCE(q6v5->running) ?
+		0 : -ETIMEDOUT;
 }
 EXPORT_SYMBOL_GPL(qcom_q6v5_wait_for_start);
 
@@ -183,6 +202,7 @@ static irqreturn_t q6v5_stop_interrupt(i
 {
 	struct qcom_q6v5 *q6v5 = data;
 
+	WRITE_ONCE(q6v5->stop_ack, true);
 	complete(&q6v5->stop_done);
 
 	return IRQ_HANDLED;
@@ -199,6 +219,7 @@ int qcom_q6v5_request_stop(struct qcom_q
 {
 	int ret;
 
+	WRITE_ONCE(q6v5->stop_ack, false);
 	q6v5->running = false;
 
 	/* Don't perform SMP2P dance if remote isn't running */
@@ -212,7 +233,10 @@ int qcom_q6v5_request_stop(struct qcom_q
 
 	qcom_smem_state_update_bits(q6v5->state, BIT(q6v5->stop_bit), 0);
 
-	return ret == 0 ? -ETIMEDOUT : 0;
+	if (!ret)
+		return -ETIMEDOUT;
+
+	return READ_ONCE(q6v5->stop_ack) ? 0 : -ETIMEDOUT;
 }
 EXPORT_SYMBOL_GPL(qcom_q6v5_request_stop);
 
@@ -239,6 +263,7 @@ EXPORT_SYMBOL_GPL(qcom_q6v5_panic);
  * @q6v5:	handle to be initialized
  * @pdev:	platform_device reference for acquiring resources
  * @rproc:	associated remoteproc instance
+ * @crash_reason_smem_host: SMEM host containing the crash reason
  * @crash_reason: SMEM id for crash reason string, or 0 if none
  * @load_state: load state resource string
  * @handover:	function to be called when proxy resources should be released
@@ -246,13 +271,15 @@ EXPORT_SYMBOL_GPL(qcom_q6v5_panic);
  * Return: 0 on success, negative errno on failure
  */
 int qcom_q6v5_init(struct qcom_q6v5 *q6v5, struct platform_device *pdev,
-		   struct rproc *rproc, int crash_reason, const char *load_state,
+		   struct rproc *rproc, unsigned int crash_reason_smem_host,
+		   int crash_reason, const char *load_state,
 		   void (*handover)(struct qcom_q6v5 *q6v5))
 {
 	int ret;
 
 	q6v5->rproc = rproc;
 	q6v5->dev = &pdev->dev;
+	q6v5->crash_reason_smem_host = crash_reason_smem_host;
 	q6v5->crash_reason = crash_reason;
 	q6v5->handover = handover;
 
--- a/drivers/remoteproc/qcom_q6v5.h
+++ b/drivers/remoteproc/qcom_q6v5.h
@@ -34,6 +34,9 @@ struct qcom_q6v5 {
 	struct completion start_done;
 	struct completion stop_done;
 
+	bool start_ack;
+	bool stop_ack;
+	unsigned int crash_reason_smem_host;
 	int crash_reason;
 
 	bool running;
@@ -43,7 +46,8 @@ struct qcom_q6v5 {
 };
 
 int qcom_q6v5_init(struct qcom_q6v5 *q6v5, struct platform_device *pdev,
-		   struct rproc *rproc, int crash_reason, const char *load_state,
+		   struct rproc *rproc, unsigned int crash_reason_smem_host,
+		   int crash_reason, const char *load_state,
 		   void (*handover)(struct qcom_q6v5 *q6v5));
 void qcom_q6v5_deinit(struct qcom_q6v5 *q6v5);
 
--- a/drivers/remoteproc/qcom_q6v5_adsp.c
+++ b/drivers/remoteproc/qcom_q6v5_adsp.c
@@ -717,7 +717,8 @@ static int adsp_probe(struct platform_de
 	if (ret)
 		goto disable_pm;
 
-	ret = qcom_q6v5_init(&adsp->q6v5, pdev, rproc, desc->crash_reason_smem,
+	ret = qcom_q6v5_init(&adsp->q6v5, pdev, rproc, QCOM_SMEM_HOST_ANY,
+			     desc->crash_reason_smem,
 			     desc->load_state, qcom_adsp_pil_handover);
 	if (ret)
 		goto disable_pm;
--- a/drivers/remoteproc/qcom_q6v5_mss.c
+++ b/drivers/remoteproc/qcom_q6v5_mss.c
@@ -26,6 +26,7 @@
 #include <linux/remoteproc.h>
 #include <linux/reset.h>
 #include <linux/soc/qcom/mdt_loader.h>
+#include <linux/soc/qcom/smem.h>
 #include <linux/iopoll.h>
 #include <linux/slab.h>
 
@@ -2164,7 +2165,8 @@ static int q6v5_probe(struct platform_de
 	qproc->need_mem_protection = desc->need_mem_protection;
 	qproc->has_mba_logs = desc->has_mba_logs;
 
-	ret = qcom_q6v5_init(&qproc->q6v5, pdev, rproc, MPSS_CRASH_REASON_SMEM, "modem",
+	ret = qcom_q6v5_init(&qproc->q6v5, pdev, rproc, QCOM_SMEM_HOST_ANY,
+			     MPSS_CRASH_REASON_SMEM, "modem",
 			     qcom_msa_handover);
 	if (ret)
 		goto detach_proxy_pds;
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -763,7 +763,8 @@ static int qcom_pas_probe(struct platfor
 		goto unassign_mem;
 	pas->proxy_pd_count = ret;
 
-	ret = qcom_q6v5_init(&pas->q6v5, pdev, rproc, desc->crash_reason_smem,
+	ret = qcom_q6v5_init(&pas->q6v5, pdev, rproc, QCOM_SMEM_HOST_ANY,
+			     desc->crash_reason_smem,
 			     desc->load_state, qcom_pas_handover);
 	if (ret)
 		goto detach_proxy_pds;
--- a/drivers/remoteproc/qcom_q6v5_wcss.c
+++ b/drivers/remoteproc/qcom_q6v5_wcss.c
@@ -18,6 +18,7 @@
 #include <linux/regulator/consumer.h>
 #include <linux/reset.h>
 #include <linux/soc/qcom/mdt_loader.h>
+#include <linux/soc/qcom/smem.h>
 #include "qcom_common.h"
 #include "qcom_pil_info.h"
 #include "qcom_q6v5.h"
@@ -1015,7 +1016,8 @@ static int q6v5_wcss_probe(struct platfo
 	if (ret)
 		return ret;
 
-	ret = qcom_q6v5_init(&wcss->q6v5, pdev, rproc, desc->crash_reason_smem, NULL, NULL);
+	ret = qcom_q6v5_init(&wcss->q6v5, pdev, rproc, QCOM_SMEM_HOST_ANY,
+			     desc->crash_reason_smem, NULL, NULL);
 	if (ret)
 		return ret;
 
--- a/drivers/remoteproc/qcom_q6v5_wcss_sec.c
+++ b/drivers/remoteproc/qcom_q6v5_wcss_sec.c
@@ -15,6 +15,7 @@
 #include "qcom_pil_info.h"
 
 #define WCSS_CRASH_REASON		421
+#define WCSS_SMEM_HOST			1
 
 #define WCSS_PAS_ID			0x6
 #define MPD_WCSS_PAS_ID			0xd
@@ -75,15 +76,18 @@ static int wcss_sec_stop(struct rproc *r
 {
 	struct wcss_sec *wcss = rproc->priv;
 	struct device *dev = wcss->dev;
-	int ret;
+	int ret, shutdown_ret;
 
 	ret = qcom_q6v5_request_stop(&wcss->q6, NULL);
 	if (ret == -ETIMEDOUT)
 		dev_err(dev, "timed out on wait\n");
 
-	ret = qcom_scm_pas_shutdown(wcss->desc->pasid);
-	if (ret)
-		dev_err(dev, "Failed to shutdown %d\n", ret);
+	shutdown_ret = qcom_scm_pas_shutdown(wcss->desc->pasid);
+	if (shutdown_ret) {
+		dev_err(dev, "Failed to shutdown %d\n", shutdown_ret);
+		if (!ret)
+			ret = shutdown_ret;
+	}
 
 	qcom_q6v5_unprepare(&wcss->q6);
 
@@ -270,7 +274,9 @@ static int wcss_sec_probe(struct platfor
 		return dev_err_probe(&pdev->dev, PTR_ERR(int_clk),
 				     "Failed to get interconnect clock\n");
 
+	/* WCSS writes its crash reason to the remote SMEM region. */
 	ret = qcom_q6v5_init(&wcss->q6, pdev, rproc,
+			     WCSS_SMEM_HOST,
 			     WCSS_CRASH_REASON, NULL, NULL);
 	if (ret)
 		return ret;
