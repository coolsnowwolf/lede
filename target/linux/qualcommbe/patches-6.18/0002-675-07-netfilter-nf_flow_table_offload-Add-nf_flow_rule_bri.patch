From 28c819759cd9634cb5002da39138831cacd9b987 Mon Sep 17 00:00:00 2001
From: Eric Woudstra <ericwouds@gmail.com>
Date: Wed, 1 Jul 2026 03:19:27 +0300
Subject: [PATCH 07/14] netfilter: nf_flow_table_offload: Add
 nf_flow_rule_bridge()

Add nf_flow_rule_bridge().

It only calls the common rule and adds the redirect.

Based on commit bb7f64bc456d from ericwoud/bpir-nftflow-nf-next-20260707.


[viking.yfy@qq.com: propagate redirect setup failures instead of accepting
 a bridge rule without its redirect action]

Signed-off-by: Eric Woudstra <ericwouds@gmail.com>
Signed-off-by: Bohdan Chubuk <chbgdn@gmail.com>
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -349,6 +349,9 @@ void nf_flow_table_offload_flush_cleanup
 int nf_flow_table_offload_setup(struct nf_flowtable *flowtable,
 				struct net_device *dev,
 				enum flow_block_command cmd);
+int nf_flow_rule_bridge(struct net *net, struct flow_offload *flow,
+			enum flow_offload_tuple_dir dir,
+			struct nf_flow_rule *flow_rule);
 int nf_flow_rule_route_ipv4(struct net *net, struct flow_offload *flow,
 			    enum flow_offload_tuple_dir dir,
 			    struct nf_flow_rule *flow_rule);
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -792,6 +792,17 @@ int nf_flow_rule_route_ipv6(struct net *
 }
 EXPORT_SYMBOL_GPL(nf_flow_rule_route_ipv6);
 
+int nf_flow_rule_bridge(struct net *net, struct flow_offload *flow,
+			enum flow_offload_tuple_dir dir,
+			struct nf_flow_rule *flow_rule)
+{
+	if (nf_flow_rule_route_common(net, flow, dir, flow_rule) < 0)
+		return -1;
+
+	return flow_offload_redirect(net, flow, dir, flow_rule);
+}
+EXPORT_SYMBOL_GPL(nf_flow_rule_bridge);
+
 static struct nf_flow_rule *
 nf_flow_offload_rule_alloc(struct net *net,
 			   const struct flow_offload_work *offload,
