From: Kenneth Kasilag <kenneth@kasilag.me>
Date: Wed, 28 Oct 2026 13:34:14 +0800
Subject: [PATCH] net: ethernet: qualcomm: implement IPIP6 and DS-Lite tunnel rows

Encode the vendor IPIP6 decapsulation key and encapsulation template,
configure global key generation, and expose a verified decapsulation enable
operation. Keeping enable separate lets the object transaction publish
lookup only after every dependent row has verified.

Resolve fixed ip6tnl endpoints through the IPv6 underlay and publish a
refcounted tunnel object shared by both flow directions. Underlay ports
share their single tunnel-L3 binding, while each endpoint pair owns its
decap row, encap template and dedicated tunnel VP.

Merged from:
  0514-05-net-ethernet-qualcomm-ppe-build-ipip6-tunnel-rows.patch
  0514-06-net-ethernet-qualcomm-ppe-offload-ds-lite-flows.patch

Based on work by:
  Kenneth Kasilag <kenneth@kasilag.me>

Signed-off-by: Kenneth Kasilag <kenneth@kasilag.me>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -30,7 +30,9 @@
 #include <linux/seq_file.h>
 #include <net/flow_offload.h>
 #include <net/ip6_tunnel.h>
+#include <net/ip6_route.h>
 #include <net/ipv6.h>
+#include <net/neighbour.h>
 #include <net/tcp.h>
 
 #include "edma_port.h"
@@ -39,6 +41,7 @@
 #include "ppe_flow.h"
 #include "ppe_flowtable.h"
 #include "ppe_regs.h"
+#include "ppe_tunnel.h"
 
 /**
  * struct ppe_ft_ref - Common head of a refcounted hardware-entry table.
@@ -167,11 +170,38 @@ struct ppe_ft_flow {
 	int pub_ip;
 	int pppoe;
 	int vlan;
+	int tunnel;
 	u8 eport;
 	u32 packets;
 	u64 bytes;
 };
 
+#define PPE_FT_TUNNELS	PPE_TUNNEL_ENTRIES
+
+struct ppe_ft_tunnel {
+	struct ppe_ft_ref ref;
+	bool poisoned;
+	struct net_device *dev;
+	struct in6_addr local;
+	struct in6_addr remote;
+	u8 local_mac[ETH_ALEN];
+	u8 remote_mac[ETH_ALEN];
+	u8 underlay_port;
+	u8 hop_limit;
+	u16 mtu;
+	int encap_id;
+	int decap_index;
+	int vp;
+};
+
+struct ppe_ft_tunnel_underlay {
+	unsigned int refcnt;
+	bool poisoned;
+	int l3_if;
+};
+
+static_assert(offsetof(struct ppe_ft_tunnel, ref) == 0);
+
 #define PPE_FT_HOST_HASH_BITS	8
 
 /* Refcounted hardware host entry. Its hardware-selected index is
@@ -220,6 +250,8 @@ struct ppe_flowtable {
 	struct ppe_ft_pub_ip pub_ips[PPE_PUB_IP_TBL_ENTRIES];
 	struct ppe_ft_pppoe pppoe[PPE_FT_PPPOE_SESSIONS];
 	struct ppe_ft_vlan vlans[PPE_L3_VLAN_UPLINKS];
+	struct ppe_ft_tunnel tunnels[PPE_FT_TUNNELS];
+	struct ppe_ft_tunnel_underlay tunnel_underlays[PPE_PORT_ID_COUNT];
 	struct notifier_block ppp_nb;
 	struct list_head block_cb_list;
 };
@@ -981,21 +1013,300 @@ static bool ppe_ft_rule_is_tunnel(const
 	return is_tunnel;
 }
 
-/* Tunneled flows stay on the software path for now. The SoC carries a
- * tunnel engine that could take them: the tunnel lookup block (which
- * already hosts the PPPoE session table) terminates encapsulations
- * into tunnel L3 interfaces, and the tunnel fields of the egress L3
- * interfaces generate them. A fixed IPIP6 implementation must derive
- * its endpoints from the redirect netdevice and program a shared
- * tunnel-port lifecycle before publishing either direction.
- */
-static int ppe_ft_tunnel_replace(struct ppe_flowtable *ft,
-				 struct flow_cls_offload *f)
+static int ppe_ft_tunnel_underlay_get(struct ppe_flowtable *ft, int port)
 {
-	if (!ft->ppe_dev->variant->has_tunnel_engine)
-		return -EOPNOTSUPP;
+	struct ppe_ft_tunnel_underlay *underlay;
+	int ret;
+
+	if (port < 0 || port >= ft->ppe_dev->num_ports)
+		return -EINVAL;
+	underlay = &ft->tunnel_underlays[port];
+	if (underlay->refcnt) {
+		if (underlay->poisoned)
+			return -EIO;
+		underlay->refcnt++;
+		return underlay->l3_if;
+	}
+	underlay->refcnt = 1;
+
+	underlay->l3_if = ppe_tunnel_l3_if_alloc(ft->ppe_dev);
+	if (underlay->l3_if < 0) {
+		ret = underlay->l3_if;
+		goto err_ref;
+	}
+	ret = ppe_tunnel_l3_if_set(ft->ppe_dev, underlay->l3_if,
+				   PPE_TUNNEL_L3_IPIP6_VALUE);
+	if (ret)
+		goto err_id;
+	ret = ppe_tunnel_port_l3_if_set(ft->ppe_dev, port, true,
+					underlay->l3_if);
+	if (ret)
+		goto err_row;
+
+	return underlay->l3_if;
+
+err_row:
+	if (ppe_tunnel_l3_if_set(ft->ppe_dev, underlay->l3_if, 0)) {
+		underlay->poisoned = true;
+		WARN_ONCE(1, "quarantining a partial tunnel underlay\n");
+		return ret;
+	}
+err_id:
+	ppe_tunnel_l3_if_free(ft->ppe_dev, underlay->l3_if);
+err_ref:
+	memset(underlay, 0, sizeof(*underlay));
+	return ret;
+}
+
+static void ppe_ft_tunnel_underlay_put(struct ppe_flowtable *ft, int port)
+{
+	struct ppe_ft_tunnel_underlay *underlay;
+	int ret, err;
+
+	if (WARN_ON_ONCE(port < 0 || port >= ft->ppe_dev->num_ports))
+		return;
+	underlay = &ft->tunnel_underlays[port];
+	if (WARN_ON_ONCE(!underlay->refcnt) || --underlay->refcnt)
+		return;
 
-	return -EOPNOTSUPP;	/* TODO: program the tunnel engine */
+	ret = ppe_tunnel_port_l3_if_set(ft->ppe_dev, port, false, 0);
+	err = ppe_tunnel_l3_if_set(ft->ppe_dev, underlay->l3_if, 0);
+	if (ret || err) {
+		underlay->poisoned = true;
+		underlay->refcnt = 1;
+		WARN_ONCE(1, "quarantining an undeletable tunnel underlay\n");
+		return;
+	}
+	ppe_tunnel_l3_if_free(ft->ppe_dev, underlay->l3_if);
+	memset(underlay, 0, sizeof(*underlay));
+}
+
+static int ppe_ft_tunnel_resolve(struct ppe_flowtable *ft,
+				 const struct net_device *tdev,
+				 const struct in6_addr *local,
+				 const struct in6_addr *remote,
+				 struct ppe_ft_tunnel *tunnel)
+{
+	const struct ip6_tnl *ip6tnl = netdev_priv(tdev);
+	struct flowi6 fl6 = {
+		.flowi6_oif = ip6tnl->parms.link,
+		.saddr = *local,
+		.daddr = *remote,
+	};
+	struct neighbour *neigh;
+	struct dst_entry *dst;
+	struct edma_port_priv *priv;
+	int ret = 0;
+
+	dst = ip6_route_output(dev_net(tdev), NULL, &fl6);
+	if (dst->error) {
+		ret = dst->error;
+		goto out_dst;
+	}
+	if (!edma_port_dev_check(dst->dev)) {
+		ret = -EOPNOTSUPP;
+		goto out_dst;
+	}
+
+	neigh = dst_neigh_lookup(dst, remote);
+	if (!neigh) {
+		ret = -EHOSTUNREACH;
+		goto out_dst;
+	}
+	read_lock_bh(&neigh->lock);
+	if (!(neigh->nud_state & NUD_VALID) ||
+	    !is_valid_ether_addr(neigh->ha)) {
+		ret = -EHOSTUNREACH;
+	} else {
+		ether_addr_copy(tunnel->remote_mac, neigh->ha);
+	}
+	read_unlock_bh(&neigh->lock);
+	neigh_release(neigh);
+	if (ret)
+		goto out_dst;
+
+	priv = netdev_priv(dst->dev);
+	tunnel->underlay_port = priv->ppe_port->port_id;
+	ether_addr_copy(tunnel->local_mac, dst->dev->dev_addr);
+out_dst:
+	dst_release(dst);
+	return ret;
+}
+
+static bool ppe_ft_tunnel_match(const struct ppe_ft_tunnel *tunnel,
+				const struct net_device *dev,
+				const struct in6_addr *local,
+				const struct in6_addr *remote)
+{
+	return tunnel->ref.refcnt && !tunnel->poisoned &&
+	       tunnel->dev == dev &&
+	       ipv6_addr_equal(&tunnel->local, local) &&
+	       ipv6_addr_equal(&tunnel->remote, remote);
+}
+
+static void ppe_ft_tunnel_put(struct ppe_flowtable *ft, int index);
+
+static int ppe_ft_tunnel_get(struct ppe_flowtable *ft, struct net_device *dev,
+			     const struct in6_addr *local,
+			     const struct in6_addr *remote)
+{
+	struct ppe_tunnel_decap_entry decap, readback;
+	struct ppe_tunnel_encap_entry encap;
+	const struct ip6_tnl *ip6tnl = netdev_priv(dev);
+	struct ppe_tunnel_ipip6 ipip6;
+	struct ppe_ft_tunnel *tunnel;
+	int i, ret, err, cleanup_ret = 0, l3_if;
+
+	for (i = 0; i < PPE_FT_TUNNELS; i++) {
+		if (!ppe_ft_tunnel_match(&ft->tunnels[i], dev, local, remote))
+			continue;
+		ft->tunnels[i].ref.refcnt++;
+		return i;
+	}
+	for (i = 0; i < PPE_FT_TUNNELS; i++)
+		if (!ft->tunnels[i].ref.refcnt)
+			break;
+	if (i == PPE_FT_TUNNELS)
+		return -ENOSPC;
+
+	tunnel = &ft->tunnels[i];
+	memset(tunnel, 0, sizeof(*tunnel));
+	tunnel->ref.refcnt = 1;
+	tunnel->dev = dev;
+	tunnel->local = *local;
+	tunnel->remote = *remote;
+	tunnel->hop_limit = ip6tnl->parms.hop_limit ?: 64;
+	tunnel->mtu = dev->mtu;
+	tunnel->encap_id = -1;
+	tunnel->decap_index = -1;
+	tunnel->vp = -1;
+
+	ret = ppe_ft_tunnel_resolve(ft, dev, local, remote, tunnel);
+	if (ret)
+		goto err_clear;
+	l3_if = ppe_ft_tunnel_underlay_get(ft, tunnel->underlay_port);
+	if (l3_if < 0) {
+		ret = l3_if;
+		goto err_clear;
+	}
+	tunnel->encap_id = ppe_tunnel_id_alloc(ft->ppe_dev);
+	if (tunnel->encap_id < 0) {
+		ret = tunnel->encap_id;
+		goto err_underlay;
+	}
+	tunnel->vp = ppe_tunnel_vp_alloc(ft->ppe_dev);
+	if (tunnel->vp < 0) {
+		ret = tunnel->vp;
+		goto err_encap_id;
+	}
+
+	ipip6.local = *local;
+	ipip6.remote = *remote;
+	ether_addr_copy(ipip6.local_mac, tunnel->local_mac);
+	ether_addr_copy(ipip6.remote_mac, tunnel->remote_mac);
+	ipip6.hop_limit = tunnel->hop_limit;
+	ipip6.vp = tunnel->vp;
+	ipip6.l3_if = l3_if;
+	ppe_tunnel_ipip6_decap_build(&decap, &ipip6);
+	ppe_tunnel_ipip6_encap_build(&encap, &ipip6);
+
+	ret = ppe_tunnel_decap_add(ft->ppe_dev, &decap,
+				   &tunnel->decap_index, &readback);
+	if (ret)
+		goto err_decap;
+	if (memcmp(&decap, &readback, sizeof(decap))) {
+		ret = -EIO;
+		goto err_decap;
+	}
+	ret = ppe_tunnel_encap_set(ft->ppe_dev, tunnel->encap_id, &encap);
+	if (ret)
+		goto err_decap;
+	ret = ppe_tunnel_vp_bind(ft->ppe_dev, tunnel->vp,
+				 tunnel->encap_id);
+	if (ret)
+		goto err_encap;
+	ret = ppe_tunnel_decap_enable(ft->ppe_dev, tunnel->decap_index, true);
+	if (ret)
+		goto err_bind;
+	ret = ppe_tunnel_port_set(ft->ppe_dev, tunnel->vp,
+				  tunnel->underlay_port, tunnel->mtu, true);
+	if (ret)
+		goto err_enable;
+
+	dev_hold(dev);
+	return i;
+
+err_enable:
+	cleanup_ret = ppe_tunnel_decap_enable(ft->ppe_dev,
+					      tunnel->decap_index, false);
+err_bind:
+	err = ppe_tunnel_vp_unbind(ft->ppe_dev, tunnel->vp);
+	if (!cleanup_ret)
+		cleanup_ret = err;
+err_encap:
+	err = ppe_tunnel_encap_clear(ft->ppe_dev, tunnel->encap_id);
+	if (!cleanup_ret)
+		cleanup_ret = err;
+err_decap:
+	if (tunnel->decap_index >= 0) {
+		err = ppe_tunnel_decap_del(ft->ppe_dev, tunnel->decap_index);
+		if (!cleanup_ret)
+			cleanup_ret = err;
+	}
+	if (cleanup_ret) {
+		tunnel->poisoned = true;
+		dev_hold(dev);
+		WARN_ONCE(1, "quarantining a partial PPE tunnel\n");
+		return ret;
+	}
+	ppe_tunnel_vp_free(ft->ppe_dev, tunnel->vp);
+err_encap_id:
+	ppe_tunnel_id_free(ft->ppe_dev, tunnel->encap_id);
+err_underlay:
+	ppe_ft_tunnel_underlay_put(ft, tunnel->underlay_port);
+err_clear:
+	memset(tunnel, 0, sizeof(*tunnel));
+	return ret;
+}
+
+static void ppe_ft_tunnel_put(struct ppe_flowtable *ft, int index)
+{
+	struct ppe_ft_tunnel *tunnel;
+	int ret, err;
+
+	if (WARN_ON_ONCE(index >= PPE_FT_TUNNELS))
+		return;
+	if (!ppe_ft_ref_put(ft->tunnels, sizeof(*ft->tunnels), index))
+		return;
+	tunnel = &ft->tunnels[index];
+
+	ret = ppe_tunnel_port_set(ft->ppe_dev, tunnel->vp,
+				  tunnel->underlay_port, tunnel->mtu, false);
+	err = ppe_tunnel_decap_enable(ft->ppe_dev,
+				      tunnel->decap_index, false);
+	if (!ret)
+		ret = err;
+	err = ppe_tunnel_vp_unbind(ft->ppe_dev, tunnel->vp);
+	if (!ret)
+		ret = err;
+	err = ppe_tunnel_encap_clear(ft->ppe_dev, tunnel->encap_id);
+	if (!ret)
+		ret = err;
+	err = ppe_tunnel_decap_del(ft->ppe_dev, tunnel->decap_index);
+	if (!ret)
+		ret = err;
+	if (ret) {
+		tunnel->poisoned = true;
+		tunnel->ref.refcnt = 1;
+		WARN_ONCE(1, "quarantining an undeletable PPE tunnel\n");
+		return;
+	}
+
+	ppe_tunnel_vp_free(ft->ppe_dev, tunnel->vp);
+	ppe_tunnel_id_free(ft->ppe_dev, tunnel->encap_id);
+	ppe_ft_tunnel_underlay_put(ft, tunnel->underlay_port);
+	dev_put(tunnel->dev);
+	memset(tunnel, 0, sizeof(*tunnel));
 }
 
