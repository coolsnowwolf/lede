 /**
+ * ppe_pppoe_session_set - Program a PPPoE session table entry
+ * @ppe_dev: PPE device
+ * @index: PPPoE session table index
+ * @enable: Whether to install or clear the entry
+ * @sid: PPPoE session ID
+ * @peer: PPPoE peer/server MAC address
+ * @l3_if: L3 interface assigned to the terminated packets
+ *
+ * Match the session on every PPE ingress port by SID and peer MAC, as
+ * the vendor interface-lifecycle transaction does. Both unicast and
+ * multicast session traffic resolves to the PPPoE L3 interface.
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_pppoe_session_set(struct ppe_device *ppe_dev, int index,
+			  bool enable, u16 sid, const u8 *peer, int l3_if)
+{
+	u32 ext2_mask = PPE_PPPOE_SESSION_EXT2_L3_IF_VALID |
+			PPE_PPPOE_SESSION_EXT2_L3_IF;
+	u32 base_reg, ext_reg, ext1_reg, ext2_reg;
+	u32 val, ext, ext1, ext2;
+	int ret = 0, err;
+
+	if (index >= ppe_dev->variant->num_pppoe_sessions)
+		return -EINVAL;
+
+	base_reg = PPE_PPPOE_SESSION_ADDR + PPE_PPPOE_SESSION_INC * index;
+	ext_reg = PPE_PPPOE_SESSION_EXT_ADDR +
+		  PPE_PPPOE_SESSION_EXT_INC * index;
+	ext1_reg = PPE_PPPOE_SESSION_EXT1_ADDR +
+		   PPE_PPPOE_SESSION_EXT1_INC * index;
+	ext2_reg = PPE_PPPOE_SESSION_EXT2_ADDR +
+		   PPE_PPPOE_SESSION_EXT2_INC * index;
+
+	if (!enable) {
+		/* Invalidate first; attempt every clear and return the first error. */
+		ret = regmap_write(ppe_dev->regmap, ext_reg, 0);
+		err = regmap_update_bits(ppe_dev->regmap, ext2_reg,
+					 ext2_mask, 0);
+		if (!ret)
+			ret = err;
+		err = regmap_write(ppe_dev->regmap, ext1_reg, 0);
+		if (!ret)
+			ret = err;
+		err = regmap_write(ppe_dev->regmap, base_reg, 0);
+		if (!ret)
+			ret = err;
+		return ret;
+	}
+
+	val = FIELD_PREP(PPE_PPPOE_SESSION_SESSION_ID, sid) |
+	      FIELD_PREP(PPE_PPPOE_SESSION_PORT_BITMAP,
+			 FIELD_MAX(PPE_PPPOE_SESSION_PORT_BITMAP));
+	ext = PPE_PPPOE_SESSION_EXT_MC_VALID |
+	      PPE_PPPOE_SESSION_EXT_UC_VALID |
+	      PPE_PPPOE_SESSION_EXT_SMAC_VALID |
+	      FIELD_PREP(PPE_PPPOE_SESSION_EXT_SMAC_HI,
+			 peer[4] << 8 | peer[5]);
+	ext1 = peer[0] << 24 | peer[1] << 16 | peer[2] << 8 | peer[3];
+	ext2 = PPE_PPPOE_SESSION_EXT2_L3_IF_VALID |
+	       FIELD_PREP(PPE_PPPOE_SESSION_EXT2_L3_IF, l3_if);
+
+	ret = regmap_write(ppe_dev->regmap, base_reg, val);
+	if (ret)
+		goto rollback;
+	ret = regmap_write(ppe_dev->regmap, ext1_reg, ext1);
+	if (ret)
+		goto rollback;
+	ret = regmap_update_bits(ppe_dev->regmap, ext2_reg, ext2_mask, ext2);
+	if (ret)
+		goto rollback;
+	ret = regmap_write(ppe_dev->regmap, ext_reg, ext);
+	if (!ret)
+		return 0;
+
+rollback:
+	/* Best effort: leave the row invalid and preserve tunnel EXT2 fields. */
+	regmap_write(ppe_dev->regmap, ext_reg, 0);
+	regmap_update_bits(ppe_dev->regmap, ext2_reg, ext2_mask, 0);
+	regmap_write(ppe_dev->regmap, ext1_reg, 0);
+	regmap_write(ppe_dev->regmap, base_reg, 0);
+	return ret;
+}
+
+/**
  * ppe_port_l3_if_set - Bind a PPE port to an L3 interface
  * @ppe_dev: PPE device
  * @port: PPE port to configure
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
@@ -70,11 +70,13 @@ int ppe_flow_hw_init(struct ppe_device *
 int ppe_my_mac_set(struct ppe_device *ppe_dev, int index, const u8 *addr,
 		   bool valid);
 int ppe_l3_if_set(struct ppe_device *ppe_dev, int index, const u8 *addr,
-		  int mtu);
+		  int mtu, int pppoe_sid);
 int ppe_l3_if_my_mac_set(struct ppe_device *ppe_dev, int index,
 			 int my_mac, bool enable);
 int ppe_l3_if_clear(struct ppe_device *ppe_dev, int index);
 int ppe_port_l3_if_set(struct ppe_device *ppe_dev, int port, int l3_if);
+int ppe_pppoe_session_set(struct ppe_device *ppe_dev, int index,
+			  bool enable, u16 sid, const u8 *peer, int l3_if);
 int ppe_pub_ip_set(struct ppe_device *ppe_dev, int index, __be32 addr);
 int ppe_nexthop_set(struct ppe_device *ppe_dev, int index,
 		    const struct ppe_flow_nexthop *nh);
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -6,7 +6,8 @@
  * The PPE port net devices accept flow block bindings through
  * ndo_setup_tc(TC_SETUP_FT). Offloaded rules translate to a next hop
  * entry (egress port, MAC rewrites, VLAN, NAT addresses) and a flow
- * entry (the 5-tuple and the translated L4 port). The router MAC
+ * entry (the 5-tuple and the translated L4 port), plus a PPPoE
+ * session for flows leaving through a PPPoE WAN. The router MAC
  * table is maintained from the source MAC rewrite of the rules: the
  * egress source MAC of one direction is the MAC the reverse direction
  * ingresses on. Flows the hardware cannot express fall back to the
@@ -17,12 +18,15 @@
 #include <linux/debugfs.h>
 #include <linux/etherdevice.h>
 #include <linux/hashtable.h>
+#include <linux/if_arp.h>
 #include <linux/if_vlan.h>
 #include <linux/ip.h>
 #include <linux/netdevice.h>
+#include <linux/ppp_channel.h>
 #include <linux/rcupdate.h>
 #include <linux/regmap.h>
 #include <linux/rhashtable.h>
+#include <linux/rtnetlink.h>
 #include <linux/seq_file.h>
 #include <net/flow_offload.h>
 #include <net/ipv6.h>
@@ -78,6 +82,38 @@ struct ppe_ft_pub_ip {
 static_assert(offsetof(struct ppe_ft_pub_ip, ref) == 0);
 
 /**
+ * struct ppe_ft_pppoe - A refcounted PPPoE session.
+ * @ref: Reference count of the session.
+ * @sid: PPPoE session ID.
+ * @peer: PPPoE peer/server MAC address.
+ * @local: Local/router MAC owned by the session L3 interface.
+ * @mtu: MTU of the PPP netdevice.
+ * @port: Physical PPE port below the session.
+ * @ppp_dev: Connected PPP netdevice, NULL after disconnect.
+ * @connected: The PPP lifecycle reference and hardware row are active.
+ * @poisoned: Hardware cleanup failed and the slot must not be reused.
+ *
+ * A session owns the PPPoE session table entry and the L3 interface
+ * of its slot index (past the per-port L3 interfaces). The lifecycle
+ * notifier publishes it before flows and retains it until disconnect.
+ */
+struct ppe_ft_pppoe {
+	struct ppe_ft_ref ref;
+	u16 sid;
+	u8 peer[ETH_ALEN];
+	u8 local[ETH_ALEN];
+	u16 mtu;
+	u8 port;
+	struct net_device *ppp_dev;
+	bool connected;
+	bool poisoned;
+};
+
+static_assert(offsetof(struct ppe_ft_pppoe, ref) == 0);
+
+#define PPE_FT_PPPOE_SESSIONS	8
+
+/**
  * struct ppe_ft_flow - An offloaded flow.
  * @node: Hash table node, keyed by the flow cookie.
  * @cookie: Flow cookie of the rule.
@@ -86,6 +122,7 @@ static_assert(offsetof(struct ppe_ft_pub
  * @nexthop: Next hop index of the flow.
  * @my_mac: Router MAC slot held by the flow, negative when none.
  * @pub_ip: Public IP slot held by the flow, negative when none.
+ * @pppoe: PPPoE session slot held by the flow, negative when none.
  * @eport: Egress PPE port of the flow.
  * @packets: Hit packet count at the last stats read.
  * @bytes: Hit byte count at the last stats read.
@@ -100,6 +137,7 @@ struct ppe_ft_flow {
 	u16 nexthop;
 	int my_mac;
 	int pub_ip;
+	int pppoe;
 	u8 eport;
 	u32 packets;
 	u64 bytes;
@@ -129,6 +167,8 @@ struct ppe_ft_host {
  * @nexthop_used: Allocation bitmap of the next hop entries.
  * @my_macs: Refcounted router MAC slots.
  * @pub_ips: Refcounted public IP slots.
+ * @pppoe: Refcounted PPPoE session slots.
+ * @ppp_nb: PPP channel lifecycle notifier.
  * @block_cb_list: Flow block callbacks bound to the PPE ports.
  * @hosts: Refcount of the flows sharing a source host entry.
  */
@@ -148,6 +188,8 @@ struct ppe_flowtable {
 	DECLARE_BITMAP(nexthop_used, PPE_NEXTHOP_TBL_ENTRIES);
 	struct ppe_ft_my_mac my_macs[PPE_MY_MAC_TBL_ENTRIES];
 	struct ppe_ft_pub_ip pub_ips[PPE_PUB_IP_TBL_ENTRIES];
+	struct ppe_ft_pppoe pppoe[PPE_FT_PPPOE_SESSIONS];
+	struct notifier_block ppp_nb;
 	struct list_head block_cb_list;
 };
 
@@ -171,6 +213,7 @@ struct ppe_ft_data {
 	__be32 dip;
 	__be16 sport;
 	__be16 dport;
+	int pppoe_sid;
 };
 
 static int ppe_ft_mangle_eth(const struct flow_action_entry *act, void *eth)
@@ -402,6 +445,284 @@ static void ppe_ft_pub_ip_put(struct ppe
 	ppe_ft_ref_put(ft->pub_ips, sizeof(*ft->pub_ips), index);
 }
 
+/* The reserved L3 interfaces are allocated in regions past the
+ * per-port ones, each region based at the end of the one before it;
+ * ppe_flowtable_setup() checks the layout fits the interface tables.
+ * A PPPoE session slot owns one interface of the first region.
+ */
+static int ppe_ft_pppoe_l3_if(struct ppe_flowtable *ft, int index)
+{
+	return ft->ppe_dev->num_ports + index;
+}
+
+/* Get a refcounted PPPoE session slot of (session ID, peer MAC),
+ * programming its session table entry on first use. Must be called
+ * with the flowtable lock held.
+ */
+struct ppe_ft_pppoe_path {
+	u16 sid;
+	u8 peer[ETH_ALEN];
+	u8 local[ETH_ALEN];
+	int mtu;
+	int port;
+};
+
+static int ppe_ft_pppoe_path(struct net_device *ppp_dev,
+			     struct ppe_ft_pppoe_path *topo)
+{
+	struct net_device_path_ctx ctx = {
+		.dev = ppp_dev,
+	};
+	struct net_device_path_stack stack = {};
+	bool have_pppoe = false;
+	int i, ret;
+
+	topo->port = -1;
+	topo->mtu = ppp_dev->mtu;
+	rcu_read_lock();
+	ret = dev_fill_forward_path(&ctx, &stack);
+	if (ret)
+		goto out_unlock;
+
+	for (i = 0; i < stack.num_paths; i++) {
+		const struct net_device_path *path = &stack.path[i];
+
+		switch (path->type) {
+		case DEV_PATH_PPPOE:
+			if (have_pppoe || path->encap.proto != htons(ETH_P_PPP_SES)) {
+				ret = -EOPNOTSUPP;
+				goto out_unlock;
+			}
+			have_pppoe = true;
+			topo->sid = path->encap.id;
+			ether_addr_copy(topo->peer, path->encap.h_dest);
+			break;
+		case DEV_PATH_ETHERNET: {
+			struct edma_port_priv *port_priv;
+
+			if (topo->port >= 0 || !edma_port_dev_check(path->dev)) {
+				ret = -EOPNOTSUPP;
+				goto out_unlock;
+			}
+			port_priv = netdev_priv(path->dev);
+			topo->port = port_priv->ppe_port->port_id;
+			ether_addr_copy(topo->local, path->dev->dev_addr);
+			break;
+		}
+		default:
+			ret = -EOPNOTSUPP;
+			goto out_unlock;
+		}
+	}
+
+	if (!have_pppoe || topo->port < 0 ||
+	    !is_valid_ether_addr(topo->peer) ||
+	    !is_valid_ether_addr(topo->local))
+		ret = -EINVAL;
+
+out_unlock:
+	rcu_read_unlock();
+	return ret;
+}
+
+static bool ppe_ft_pppoe_match(const void *entry, const void *key)
+{
+	const struct ppe_ft_pppoe *session = entry, *want = key;
+
+	return session->sid == want->sid &&
+	       ether_addr_equal(session->peer, want->peer);
+}
+
+static int ppe_ft_pppoe_get(struct ppe_flowtable *ft, u16 sid,
+			    const u8 *peer, const u8 *local, int port)
+{
+	int i;
+
+	for (i = 0; i < PPE_FT_PPPOE_SESSIONS; i++) {
+		struct ppe_ft_pppoe *session = &ft->pppoe[i];
+
+		if (!session->ref.refcnt || session->sid != sid ||
+		    !ether_addr_equal(session->peer, peer))
+			continue;
+		if (session->poisoned)
+			return -EIO;
+		if (!session->connected)
+			return -ENOTCONN;
+		if (session->port != port ||
+		    !ether_addr_equal(session->local, local))
+			return -EEXIST;
+
+		session->ref.refcnt++;
+		return i;
+	}
+
+	return -ENOENT;
+}
+
+static void ppe_ft_pppoe_put(struct ppe_flowtable *ft, int index)
+{
+	if (!ppe_ft_ref_put(ft->pppoe, sizeof(*ft->pppoe), index))
+		return;
+
+	if (WARN_ON_ONCE(ft->pppoe[index].connected))
+		ppe_pppoe_session_set(ft->ppe_dev, index, false, 0, NULL, 0);
+	memset(&ft->pppoe[index], 0, sizeof(ft->pppoe[index]));
+}
+
+static int ppe_ft_pppoe_connect(struct ppe_flowtable *ft,
+				struct net_device *ppp_dev)
+{
+	struct ppe_ft_pppoe_path topo = {};
+	struct ppe_ft_pppoe want = {};
+	struct ppe_ft_pppoe *session;
+	bool is_new;
+	int i, ret, cleanup_ret;
+
+	ret = ppe_ft_pppoe_path(ppp_dev, &topo);
+	if (ret)
+		return ret;
+
+	want.sid = topo.sid;
+	want.mtu = topo.mtu;
+	want.port = topo.port;
+	want.ppp_dev = ppp_dev;
+	want.connected = true;
+	ether_addr_copy(want.peer, topo.peer);
+	ether_addr_copy(want.local, topo.local);
+
+	mutex_lock(&ft->lock);
+	i = ppe_ft_ref_get(ft->pppoe, sizeof(*ft->pppoe),
+			   PPE_FT_PPPOE_SESSIONS, ppe_ft_pppoe_match,
+			   &want, &is_new);
+	if (i < 0) {
+		ret = i;
+		goto out_unlock;
+	}
+
+	if (!is_new) {
+		session = &ft->pppoe[i];
+		if (session->poisoned) {
+			ret = -EIO;
+			goto out_ref;
+		}
+		if (session->port != topo.port || session->mtu != topo.mtu ||
+		    !ether_addr_equal(session->local, topo.local)) {
+			ret = -EEXIST;
+			goto out_ref;
+		}
+		if (session->connected) {
+			ret = session->ppp_dev == ppp_dev ? 0 : -EEXIST;
+			goto out_ref;
+		}
+	} else {
+		session = &ft->pppoe[i];
+	}
+
+	ret = ppe_l3_if_set(ft->ppe_dev, ppe_ft_pppoe_l3_if(ft, i),
+			    topo.local, topo.mtu, topo.sid);
+	if (ret)
+		goto out_ref;
+
+	ret = ppe_pppoe_session_set(ft->ppe_dev, i, true, topo.sid,
+				    topo.peer, ppe_ft_pppoe_l3_if(ft, i));
+	if (ret) {
+		cleanup_ret = ppe_pppoe_session_set(ft->ppe_dev, i, false,
+						    0, NULL, 0);
+		if (cleanup_ret) {
+			if (is_new) {
+				want.ref.refcnt = 1;
+				want.ppp_dev = NULL;
+				want.connected = false;
+				want.poisoned = true;
+				*session = want;
+			} else {
+				session->ppp_dev = NULL;
+				session->connected = false;
+				session->poisoned = true;
+			}
