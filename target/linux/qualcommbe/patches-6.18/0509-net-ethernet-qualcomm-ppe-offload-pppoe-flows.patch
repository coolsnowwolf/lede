+				i, cleanup_ret);
+			goto out_unlock;
+		}
+		goto out_ref;
+	}
+
+	if (is_new) {
+		want.ref.refcnt = 1;
+		*session = want;
+	} else {
+		session->ppp_dev = ppp_dev;
+		session->connected = true;
+	}
+	mutex_unlock(&ft->lock);
+	return 0;
+
+out_ref:
+	if (!is_new)
+		ppe_ft_ref_put(ft->pppoe, sizeof(*ft->pppoe), i);
+out_unlock:
+	mutex_unlock(&ft->lock);
+	return ret;
+}
+
+static int ppe_ft_pppoe_disconnect(struct ppe_flowtable *ft,
+				   struct net_device *ppp_dev)
+{
+	int i, ret = -ENOENT;
+
+	mutex_lock(&ft->lock);
+	for (i = 0; i < PPE_FT_PPPOE_SESSIONS; i++) {
+		struct ppe_ft_pppoe *session = &ft->pppoe[i];
+
+		if (!session->connected || session->ppp_dev != ppp_dev)
+			continue;
+		ret = ppe_pppoe_session_set(ft->ppe_dev, i, false, 0, NULL, 0);
+		session->connected = false;
+		session->ppp_dev = NULL;
+		if (ret) {
+			session->poisoned = true;
+			dev_err(ft->ppe_dev->dev,
+				"quarantining PPPoE session %d: %d\n", i, ret);
+		} else {
+			ppe_ft_pppoe_put(ft, i);
+		}
+		break;
+	}
+	mutex_unlock(&ft->lock);
+
+	return ret;
+}
+
+static int ppe_ft_ppp_event(struct notifier_block *nb,
+			    unsigned long event, void *ptr)
+{
+	struct ppe_flowtable *ft = container_of(nb, struct ppe_flowtable,
+						 ppp_nb);
+	struct net_device *ppp_dev = ptr;
+	int ret;
+
+	switch (event) {
+	case PPP_CHANNEL_CONNECT:
+		ret = ppe_ft_pppoe_connect(ft, ppp_dev);
+		break;
+	case PPP_CHANNEL_DISCONNECT:
+		ret = ppe_ft_pppoe_disconnect(ft, ppp_dev);
+		if (ret == -ENOENT)
+			return NOTIFY_DONE;
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	if (ret)
+		netdev_warn(ppp_dev,
+			    "PPE PPPoE lifecycle event %lu failed: %d\n",
+			    event, ret);
+
+	return NOTIFY_DONE;
+}
