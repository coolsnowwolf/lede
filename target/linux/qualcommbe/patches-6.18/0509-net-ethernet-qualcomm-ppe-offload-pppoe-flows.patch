 	if (ret)
 		return ret;
@@ -382,6 +391,11 @@ int ppe_l3_if_set(struct ppe_device *ppe
 	eg[1] = FIELD_PREP(PPE_EG_L3_IF_W1_MAC_ADDR_HI,
