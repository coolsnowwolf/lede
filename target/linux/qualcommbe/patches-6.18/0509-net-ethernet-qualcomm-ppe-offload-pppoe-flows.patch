@@ -374,6 +380,9 @@ int ppe_l3_if_set(struct ppe_device *ppe
 	in[2] |= FIELD_PREP(PPE_IN_L3_IF_W2_UDP_CSM0_CMD,
 			    PPE_IN_L3_IF_UDP_CSM0_MAPT_RECALCULATE);
 
+	if (pppoe_sid >= 0)
+		in[1] |= PPE_IN_L3_IF_W1_PPPOE_EN;
