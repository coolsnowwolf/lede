From: ViKing <viking.yfy@qq.com>
Date: Tue, 27 Oct 2026 09:40:00 +0800
Subject: [PATCH] net: mdio: ipq4019: initialize and unwind package clocks and resets

Consolidate consecutive changes within this functional responsibility.
Retain the final implementation and its error handling directly.

Merged from:
  0375-01-net-mdio-ipq4019-program-divider-after-clock-setup.patch
  0375-02-net-mdio-ipq4019-qca8386-clock-fixup.patch
  0375-03-net-mdio-ipq4019-reset-qca8386-before-preinit.patch
  0375-04-net-mdio-ipq4019-prepare-ipq5332-uniphy-clocks.patch
  0375-05-net-mdio-ipq4019-order-and-unwind-clock-initialization.patch

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/mdio/mdio-ipq4019.c
+++ b/drivers/net/mdio/mdio-ipq4019.c
@@ -2,7 +2,9 @@
 /* Copyright (c) 2015, The Linux Foundation. All rights reserved. */
 /* Copyright (c) 2020 Sartura Ltd. */
 
+#include <linux/bitmap.h>
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
@@ -45,16 +47,55 @@
 
 /* MDIO clock source frequency is fixed to 100M */
 #define IPQ_MDIO_CLK_RATE	100000000
+#define IPQ_UNIPHY_AHB_CLK_RATE	100000000
+#define IPQ_UNIPHY_SYS_CLK_RATE	24000000
 
 #define IPQ_PHY_SET_DELAY_US	100000
 
+#define IPQ_HIGH_ADDR_PREFIX		0x18
+#define IPQ_LOW_ADDR_PREFIX		0x10
+
+#define EPHY_CFG			0xC90F018
+#define GEPHY0_TX_CBCR			0xC800058
+#define SRDS0_SYS_CBCR			0xC8001A8
+#define SRDS1_SYS_CBCR			0xC8001AC
+#define EPHY0_SYS_CBCR			0xC8001B0
+#define EPHY1_SYS_CBCR			0xC8001B4
+#define EPHY2_SYS_CBCR			0xC8001B8
+#define EPHY3_SYS_CBCR			0xC8001BC
+#define GCC_GEPHY_MISC			0xC800304
+
 struct ipq4019_mdio_data {
 	void __iomem	*membase;
 	void __iomem *eth_ldo_rdy;
 	struct clk *mdio_clk;
 	unsigned int mdc_rate;
+	bool mdc_rate_logged;
+	bool uniphy_clks_enabled;
+	bool mdio_clk_enabled;
+	bool preinit_logged;
+	struct clk *uniphy_clk[4];
+	struct gpio_descs *reset_gpios;
+	int (*preinit)(struct mii_bus *bus);
+};
+
+static const char * const ipq5332_uniphy_clk_names[] = {
+	"uniphy0_ahb_clk", "uniphy0_sys_clk",
+	"uniphy1_ahb_clk", "uniphy1_sys_clk",
 };
 
+static int ipq_mii_preinit(struct mii_bus *bus);
+
+static unsigned long
+ipq4019_mdio_get_clk_rate(struct ipq4019_mdio_data *priv)
+{
+	unsigned long rate;
+
+	rate = priv->mdio_clk ? clk_get_rate(priv->mdio_clk) : 0;
+
+	return rate ?: IPQ_MDIO_CLK_RATE;
+}
+
 static int ipq4019_mdio_wait_busy(struct mii_bus *bus)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
@@ -221,10 +262,7 @@ static int ipq4019_mdio_set_div(struct i
 	int div;
 	u32 val;
 
-	/* If we don't have a clock for AHB use the fixed value */
-	ahb_rate = IPQ_MDIO_CLK_RATE;
-	if (priv->mdio_clk)
-		ahb_rate = clk_get_rate(priv->mdio_clk);
+	ahb_rate = ipq4019_mdio_get_clk_rate(priv);
 
 	/* MDC rate is ahb_rate/(MDIO_MODE_DIV + 1)
 	 * While supported, internal documentation doesn't
@@ -247,12 +285,253 @@ static int ipq4019_mdio_set_div(struct i
 	return -EINVAL;
 }
 
+static inline void qca8386_split_addr(u32 regaddr, u16 *r1, u16 *r2,
+				      u16 *page, u16 *switch_phy_id)
+{
+	*r1 = regaddr & 0x1c;
+	regaddr >>= 5;
+	*r2 = regaddr & 0x7;
+	regaddr >>= 3;
+	*page = regaddr & 0xffff;
+	regaddr >>= 16;
+	*switch_phy_id = regaddr & 0xff;
+}
+
+static int qca8386_read(struct mii_bus *bus, u32 reg, u32 *value)
+{
+	u16 r1, r2, page, switch_phy_id;
+	int lo, hi, ret;
+
+	qca8386_split_addr(reg, &r1, &r2, &page, &switch_phy_id);
+	ret = bus->write(bus, IPQ_HIGH_ADDR_PREFIX | (switch_phy_id >> 5),
+			 switch_phy_id & 0x1f, page);
+	if (ret)
+		return ret;
+	lo = bus->read(bus, IPQ_LOW_ADDR_PREFIX | r2, r1);
+	if (lo < 0)
+		return lo;
+	hi = bus->read(bus, IPQ_LOW_ADDR_PREFIX | r2, r1 | BIT(1));
+	if (hi < 0)
+		return hi;
+	*value = (u32)hi << 16 | (u16)lo;
+	return 0;
+}
+
+static int qca8386_write(struct mii_bus *bus, u32 reg, u32 val)
+{
+	u16 r1, r2, page, switch_phy_id;
+	int ret;
+
+	qca8386_split_addr(reg, &r1, &r2, &page, &switch_phy_id);
+	ret = bus->write(bus, IPQ_HIGH_ADDR_PREFIX | (switch_phy_id >> 5),
+			 switch_phy_id & 0x1f, page);
+	if (ret)
+		return ret;
+	ret = bus->write(bus, IPQ_LOW_ADDR_PREFIX | r2, r1, lower_16_bits(val));
+	if (ret)
+		return ret;
+	return bus->write(bus, IPQ_LOW_ADDR_PREFIX | r2, r1 | BIT(1),
+			  upper_16_bits(val));
+}
+
+static int qca8386_clock_update(struct mii_bus *bus, u32 reg,
+				  u32 clear, u32 set)
+{
+	u32 val;
+	int ret;
+
+	ret = qca8386_read(bus, reg, &val);
+	if (ret)
+		return ret;
+	return qca8386_write(bus, reg, (val & ~clear) | set);
+}
+
+static int qca8386_clk_reset(struct mii_bus *bus, u32 reg)
+{
+	u32 val;
+	int ret;
+
+	ret = qca8386_read(bus, reg, &val);
+	if (ret)
+		return ret;
+	val |= BIT(2);
+	ret = qca8386_write(bus, reg, val);
+	if (ret)
+		return ret;
+	usleep_range(20000, 21000);
+	return qca8386_write(bus, reg, val & ~BIT(2));
+}
+
+static int qca8386_clock_init(struct mii_bus *bus)
+{
+	static const u32 sys_clocks[] = {
+		SRDS0_SYS_CBCR, SRDS1_SYS_CBCR,
+		EPHY0_SYS_CBCR, EPHY1_SYS_CBCR, EPHY2_SYS_CBCR, EPHY3_SYS_CBCR,
+	};
+	const char *phase = "serdes-enable";
+	u32 reg = 0;
+	int i, ret;
+
+	for (i = 0; i < 2; i++) {
+		reg = sys_clocks[i];
+		ret = qca8386_clock_update(bus, reg, 0, BIT(0));
+		if (ret)
+			goto failed;
+	}
+	phase = "serdes-reset";
+	for (i = 0; i < 2; i++) {
+		reg = sys_clocks[i];
+		ret = qca8386_clk_reset(bus, reg);
+		if (ret)
+			goto failed;
+	}
+	phase = "gephy-disable";
+	for (i = 0; i < 8; i++) {
+		reg = GEPHY0_TX_CBCR + i * 0x20;
+		ret = qca8386_clock_update(bus, reg, BIT(0), 0);
+		if (ret)
+			goto failed;
+	}
+	phase = "ephy-enable";
+	for (i = 2; i < ARRAY_SIZE(sys_clocks); i++) {
+		reg = sys_clocks[i];
+		ret = qca8386_clock_update(bus, reg, 0, BIT(0));
+		if (ret)
+			goto failed;
+	}
+	phase = "ephy-reset";
+	for (i = 2; i < ARRAY_SIZE(sys_clocks); i++) {
+		reg = sys_clocks[i];
+		ret = qca8386_clk_reset(bus, reg);
+		if (ret)
+			goto failed;
+	}
+	phase = "gephy-config";
+	reg = GCC_GEPHY_MISC;
+	ret = qca8386_clock_update(bus, reg, GENMASK(4, 0), 0);
+	if (ret)
+		goto failed;
+	phase = "ephy-config";
+	reg = EPHY_CFG;
+	ret = qca8386_clock_update(bus, reg, GENMASK(21, 20), 0);
+	if (ret)
+		goto failed;
+	usleep_range(10000, 11000);
+	return 0;
+
+failed:
+	dev_err(bus->parent, "QCA8386 clock setup failed: phase=%s reg=0x%08x ret=%d\n",
+		phase, reg, ret);
+	return ret;
+}
+
+static int ipq_mii_preinit(struct mii_bus *bus)
+{
+	return qca8386_clock_init(bus);
+}
+
+static int ipq_mdio_reset_devices(struct mii_bus *bus)
+{
+	struct ipq4019_mdio_data *priv = bus->priv;
+	unsigned long *values;
+
+	if (!priv->reset_gpios)
+		return 0;
+
+	values = bitmap_zalloc(priv->reset_gpios->ndescs, GFP_KERNEL);
+	if (!values)
+		return -ENOMEM;
+
+	bitmap_fill(values, priv->reset_gpios->ndescs);
+	gpiod_set_array_value_cansleep(priv->reset_gpios->ndescs,
+					priv->reset_gpios->desc,
+					priv->reset_gpios->info, values);
+	msleep(100);
+
+	bitmap_zero(values, priv->reset_gpios->ndescs);
+	gpiod_set_array_value_cansleep(priv->reset_gpios->ndescs,
+					priv->reset_gpios->desc,
+					priv->reset_gpios->info, values);
+	bitmap_free(values);
+	msleep(100);
+
+	return 0;
+}
+
+static int ipq_mdio_prepare_uniphy(struct mii_bus *bus)
+{
+	struct ipq4019_mdio_data *priv = bus->priv;
+	struct device *dev = bus->parent;
+	unsigned long rate;
+	int i, ret;
+
+	if (!of_property_read_bool(dev->of_node, "mdio_clk_fixup") ||
+	    priv->uniphy_clks_enabled)
+		return 0;
+
+	for (i = 0; i < ARRAY_SIZE(priv->uniphy_clk); i++) {
+		if (!priv->uniphy_clk[i])
+			continue;
+
+		rate = (i & 1) ? IPQ_UNIPHY_SYS_CLK_RATE :
+			IPQ_UNIPHY_AHB_CLK_RATE;
+		ret = clk_set_rate(priv->uniphy_clk[i], rate);
+		if (ret) {
+			dev_err_probe(dev, ret,
+				      "failed to set %s to %luHz\n",
+				      ipq5332_uniphy_clk_names[i], rate);
+			goto unwind;
+		}
+
+		ret = clk_prepare_enable(priv->uniphy_clk[i]);
+		if (ret) {
+			dev_err_probe(dev, ret,
+				      "failed to enable %s\n",
+				      ipq5332_uniphy_clk_names[i]);
+			goto unwind;
+		}
+	}
+
+	priv->uniphy_clks_enabled = true;
+	dev_info(dev, "IPQ5332 UNIPHY clocks prepared before MDIO reset\n");
+
+	return 0;
+
+unwind:
+	while (i--)
+		clk_disable_unprepare(priv->uniphy_clk[i]);
+	return ret;
+}
+
+static void ipq_mdio_disable_clocks(void *data)
+{
+	struct ipq4019_mdio_data *priv = data;
+	int i;
+
+	if (priv->mdio_clk_enabled) {
+		clk_disable_unprepare(priv->mdio_clk);
+		priv->mdio_clk_enabled = false;
+	}
+	if (priv->uniphy_clks_enabled) {
+		for (i = ARRAY_SIZE(priv->uniphy_clk); i-- > 0;)
+			clk_disable_unprepare(priv->uniphy_clk[i]);
+		priv->uniphy_clks_enabled = false;
+	}
+}
+
 static int ipq_mdio_reset(struct mii_bus *bus)
 {
 	struct ipq4019_mdio_data *priv = bus->priv;
+	unsigned long ahb_rate;
+	unsigned long reported_rate;
+	unsigned int div;
 	u32 val;
 	int ret;
 
+	ret = ipq_mdio_prepare_uniphy(bus);
+	if (ret)
+		return ret;
+
 	/* To indicate CMN_PLL that ethernet_ldo has been ready if platform resource 1
 	 * is specified in the device tree.
 	 */
@@ -263,19 +542,61 @@ static int ipq_mdio_reset(struct mii_bus
 		fsleep(IPQ_PHY_SET_DELAY_US);
 	}
 
-	/* Configure MDIO clock source frequency if clock is specified in the device tree */
-	ret = clk_set_rate(priv->mdio_clk, IPQ_MDIO_CLK_RATE);
+	ret = ipq_mdio_reset_devices(bus);
 	if (ret)
-		return ret;
+		goto err_clocks;
+
+	mdelay(10);
 
-	ret = clk_prepare_enable(priv->mdio_clk);
+	/* Configure MDIO only after the external switch reset is released. */
+	ret = clk_set_rate(priv->mdio_clk, IPQ_MDIO_CLK_RATE);
 	if (ret)
-		return ret;
+		goto err_clocks;
 
-	mdelay(10);
+	if (!priv->mdio_clk_enabled) {
+		ret = clk_prepare_enable(priv->mdio_clk);
+		if (ret)
+			goto err_clocks;
+		priv->mdio_clk_enabled = true;
+	}
 
-	/* Restore MDC rate */
-	return ipq4019_mdio_set_div(priv);
+	ret = ipq4019_mdio_set_div(priv);
+	reported_rate = priv->mdio_clk ? clk_get_rate(priv->mdio_clk) : 0;
+	ahb_rate = ipq4019_mdio_get_clk_rate(priv);
+	val = readl(priv->membase + MDIO_MODE_REG);
+	div = FIELD_GET(MDIO_MODE_DIV_MASK, val) + 1;
+	if (ret) {
+		dev_err(bus->parent,
+			"MDC setup failed: requested=%uHz reported-source=%luHz source=%luHz current-divider=%u effective=%luHz mode=0x%08x error=%d\n",
+			priv->mdc_rate, reported_rate, ahb_rate, div,
+			DIV_ROUND_UP(ahb_rate, div), val, ret);
+		goto err_clocks;
+	}
+
+	if (priv->preinit) {
+		ret = priv->preinit(bus);
+		if (ret)
+			goto err_clocks;
+	}
+
+	if (priv->preinit && !priv->preinit_logged) {
+		dev_info(bus->parent, "MDIO QCA8386 preinit completed before child scan\n");
+		priv->preinit_logged = true;
+	}
+
+	if (!priv->mdc_rate_logged) {
+		dev_info(bus->parent,
+			 "MDC configured: requested=%uHz reported-source=%luHz source=%luHz divider=%u effective=%luHz mode=0x%08x\n",
+			 priv->mdc_rate, reported_rate, ahb_rate, div,
+			 DIV_ROUND_UP(ahb_rate, div), val);
+		priv->mdc_rate_logged = true;
+	}
+
+	return 0;
+
+err_clocks:
+	ipq_mdio_disable_clocks(priv);
+	return ret;
 }
 
 static void ipq4019_mdio_select_mdc_rate(struct platform_device *pdev,
@@ -290,10 +611,7 @@ static void ipq4019_mdio_select_mdc_rate
 				  &priv->mdc_rate))
 		return;
 
-	/* If we don't have a clock for AHB use the fixed value */
-	ahb_rate = IPQ_MDIO_CLK_RATE;
-	if (priv->mdio_clk)
-		ahb_rate = clk_get_rate(priv->mdio_clk);
+	ahb_rate = ipq4019_mdio_get_clk_rate(priv);
 
 	/* Check what is the current div set */
 	val = readl(priv->membase + MDIO_MODE_REG);
@@ -344,11 +662,23 @@ static int ipq4019_mdio_probe(struct pla
 	if (IS_ERR(priv->mdio_clk))
 		return PTR_ERR(priv->mdio_clk);
 
-	ipq4019_mdio_select_mdc_rate(pdev, priv);
-	ret = ipq4019_mdio_set_div(priv);
-	if (ret)
-		return ret;
+	for (ret = 0; ret < ARRAY_SIZE(priv->uniphy_clk); ret++) {
+		priv->uniphy_clk[ret] = devm_clk_get_optional(&pdev->dev,
+								ipq5332_uniphy_clk_names[ret]);
+		if (IS_ERR(priv->uniphy_clk[ret]))
+			return dev_err_probe(&pdev->dev,
+					     PTR_ERR(priv->uniphy_clk[ret]),
+				      "failed to get %s\n",
+				      ipq5332_uniphy_clk_names[ret]);
+	}
 
+	priv->reset_gpios = devm_gpiod_get_array_optional(&pdev->dev,
+							 "phy-reset", GPIOD_OUT_LOW);
+	if (IS_ERR(priv->reset_gpios))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->reset_gpios),
+				      "failed to get phy-reset-gpios\n");
+
+	ipq4019_mdio_select_mdc_rate(pdev, priv);
 	/* The platform resource is provided on the chipset IPQ5018 */
 	/* This resource is optional */
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
@@ -366,6 +696,12 @@ static int ipq4019_mdio_probe(struct pla
 	bus->reset = ipq_mdio_reset;
 	bus->parent = &pdev->dev;
 	snprintf(bus->id, MII_BUS_ID_SIZE, "%s%d", pdev->name, pdev->id);
+	if (of_property_read_bool(pdev->dev.of_node, "mdio_clk_fixup"))
+		priv->preinit = ipq_mii_preinit;
+
+	ret = devm_add_action_or_reset(&pdev->dev, ipq_mdio_disable_clocks, priv);
+	if (ret)
+		return ret;
 
 	ret = of_mdiobus_register(bus, pdev->dev.of_node);
 	if (ret) {
