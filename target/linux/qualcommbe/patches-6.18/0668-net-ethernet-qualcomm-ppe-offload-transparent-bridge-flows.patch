+/* Flowtable rules carry the egress Ethernet header. A routed source MAC
+ * belongs to a local device; a bridge preserves its peer's source MAC.
+ * Limit direct bridge-port forwarding to one untagged bridge domain.
+ * Tagged/DSA paths need their own VLAN editor and source-domain encoding.
+ */
+static bool ppe_ft_bridge_path(struct net_device *odev, int ingress_ifindex)
+{
+	struct net_device *idev, *master;
+	bool valid = false;
+
+	rcu_read_lock();
+	idev = dev_get_by_index_rcu(dev_net(odev), ingress_ifindex);
+	if (!idev || idev == odev || dsa_user_dev_check(idev) ||
+	    dsa_user_dev_check(odev))
+		goto out;
+	master = netdev_master_upper_dev_get_rcu(idev);
+	valid = master && netif_is_bridge_master(master) &&
+		netdev_master_upper_dev_get_rcu(odev) == master &&
+		!br_vlan_enabled(master) &&
+		br_port_get_stp_state(idev) == BR_STATE_FORWARDING &&
+		br_port_get_stp_state(odev) == BR_STATE_FORWARDING &&
+		!(br_port_flag_is_set(idev, BR_ISOLATED) &&
+		  br_port_flag_is_set(odev, BR_ISOLATED));
+out:
+	rcu_read_unlock();
+	return valid;
+}
