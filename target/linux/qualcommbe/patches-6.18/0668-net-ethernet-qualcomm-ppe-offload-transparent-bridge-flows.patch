+/* Withdraw native bridge entries before a changed topology can reuse the
+ * ports. Restart the walk after every deletion, as for VP invalidation.
+ * Routed/NAT entries keep their independent lifetime.
+ */
+static void ppe_ft_bridge_invalidate(struct ppe_flowtable *ft)
+{
+	struct rhashtable_iter iter;
+	struct ppe_ft_flow *flow;
+	bool found;
+
+	mutex_lock(&ft->lock);
+	do {
+		found = false;
+		rhashtable_walk_enter(&ft->flows, &iter);
+		rhashtable_walk_start(&iter);
+		while ((flow = rhashtable_walk_next(&iter))) {
+			if (IS_ERR(flow)) {
+				if (PTR_ERR(flow) == -EAGAIN)
+					continue;
+				break;
+			}
+			if (flow->entry.fwd_type != PPE_FLOW_FWD_TYPE_BRIDGE)
+				continue;
+			found = true;
+			break;
+		}
+		rhashtable_walk_stop(&iter);
+		rhashtable_walk_exit(&iter);
+		if (found) {
+			if (ppe_ft_flow_hw_del(ft, flow)) {
+				ppe_ft_flow_forget(ft, flow);
+			} else {
+				rhashtable_remove_fast(&ft->flows, &flow->node,
+						       ppe_ft_params);
+				ppe_ft_flow_count_dec(ft, flow);
+				ppe_ft_flow_quarantine(ft, flow);
+			}
+		}
+	} while (found);
+	mutex_unlock(&ft->lock);
+}
