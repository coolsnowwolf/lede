@@ -1502,6 +1502,7 @@ int ppe_port_mac_init(struct ppe_device
 		ppe_ports->port[i].np = port_node;
 		ppe_ports->port[i].interface = phy_mode;
 		ppe_ports->port[i].mac_type = PPE_MAC_TYPE_GMAC;
