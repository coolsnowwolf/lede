 		ret = ppe_port_clock_init(&ppe_ports->port[i]);
 		if (ret) {
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_port.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_port.h
@@ -7,6 +7,7 @@
 #define __PPE_PORT_H__
 
 #include <linux/compiler.h>
+#include <linux/mutex.h>
 #include <linux/phy.h>
 #include <linux/phylink.h>
 
@@ -42,6 +43,47 @@ enum ppe_mac_type {
 	PPE_MAC_TYPE_XGMAC,
 };
 
+#define PPE_TBF_QUEUE_CFG_WORDS	4
+#define PPE_TBF_SHAPER_CFG_WORDS	2
+
+/**
+ * struct ppe_port_tbf - State owned by a port's offloaded root TBF
+ * @active: The hardware shaper and queue limit are active
+ * @handle: Handle of the qdisc that owns the hardware state
+ * @rate: Configured byte rate
+ * @burst: Configured burst in bytes
+ * @requested_limit: Queue limit requested by the qdisc, in bytes
+ * @applied_buffers: Queue limit programmed in 256-byte buffers
+ * @queue: Default unicast queue controlled by this TBF
+ * @saved_cfg: Queue admission-control entry restored on destroy
+ * @saved_shaper: Port shaper entry restored on destroy
+ * @rollback_failures: Failed attempts to restore hardware state
+ * @callback_calls: TBF callbacks received through ndo_setup_tc
+ * @replace_calls: TBF replace callbacks received
+ * @destroy_calls: TBF destroy callbacks received
+ * @stats_calls: TBF statistics callbacks received
+ * @last_command: Most recent enum tc_tbf_command value
+ * @last_result: Return value from the most recent callback
+ */
+struct ppe_port_tbf {
