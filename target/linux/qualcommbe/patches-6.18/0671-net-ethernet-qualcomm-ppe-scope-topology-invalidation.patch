-				rhashtable_remove_fast(&ft->flows, &flow->node,
-						       ppe_ft_params);
-				ppe_ft_flow_count_dec(ft, flow);
-				ppe_ft_flow_quarantine(ft, flow);
-			}
-		}
-	} while (found);
+	ft->topology_seq++;
+	for (i = 0; i < ft->ppe_dev->variant->num_flow_entries; i++) {
