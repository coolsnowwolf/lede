+/* These references describe topology, not hardware table ownership. */
+static void ppe_ft_path_put(struct ppe_ft_flow *flow)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(flow->path_dev); i++) {
+		if (!flow->path_dev[i])
+			continue;
+		dev_put(flow->path_dev[i]);
+		flow->path_dev[i] = NULL;
+	}
+}
