-/* Withdraw native bridge entries before a changed topology can reuse the
- * ports. Restart the walk after every deletion, as for VP invalidation.
- * Routed/NAT entries keep their independent lifetime.
+/* Match retained path devices and accounting uppers before withdrawing
+ * flows across a topology change. The bounded owner walk covers bridge,
+ * routed and NAT entries without disturbing unrelated device paths.
  */
-static void ppe_ft_bridge_invalidate(struct ppe_flowtable *ft)
+static bool ppe_ft_path_uses(const struct ppe_ft_flow *flow,
+			     const struct net_device *dev)
+{
+	int i;
+
+	if (flow->path_dev[0] == dev || flow->path_dev[1] == dev)
+		return true;
+	for (i = 0; i < flow->rx_account.count; i++)
+		if (flow->rx_account.upper[i] == dev)
+			return true;
+	for (i = 0; i < flow->tx_account.count; i++)
+		if (flow->tx_account.upper[i] == dev)
+			return true;
+	return false;
+}
