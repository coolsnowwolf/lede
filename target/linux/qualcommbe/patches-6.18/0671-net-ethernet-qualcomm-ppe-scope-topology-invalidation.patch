-/* Invalidate every flow which references a virtual port after its MAC,
- * MTU or bridge topology changes. Reuse the ordinary destroy transaction so
- * hardware rows and all dependent PPE references are released together.
+static void ppe_ft_invalidate_locked(struct ppe_flowtable *ft,
+				     struct ppe_ft_flow *flow)
+{
+	lockdep_assert_held(&ft->lock);
+	if (ppe_ft_flow_hw_del(ft, flow)) {
+		ppe_ft_flow_forget(ft, flow);
+	} else {
+		rhashtable_remove_fast(&ft->flows, &flow->node, ppe_ft_params);
+		ppe_ft_flow_count_dec(ft, flow);
+		ppe_ft_flow_quarantine(ft, flow);
+	}
+	ft->topology_invalidated++;
+}
+
+/* The owner array is stable under ft->lock. A bounded indexed walk avoids
+ * restarting a mutable hash walk after every deletion. Quarantine entries
+ * keep their hardware leases but are never retired a second time here.
  */
 void ppe_flowtable_vp_invalidate(struct ppe_device *ppe_dev, int vp)
 {
 	struct ppe_flowtable *ft = ppe_dev->flowtable;
-	struct rhashtable_iter iter;
 	struct ppe_ft_flow *flow;
-	unsigned long cookie;
-	bool found;
+	int i;
 
 	if (!ft || vp < 0)
 		return;
-
-	/* Restart after each removal: mutating a rhashtable during a walk can
-	 * otherwise skip the entry following the deleted node.
-	 */
-	do {
-		found = false;
-		rhashtable_walk_enter(&ft->flows, &iter);
-		rhashtable_walk_start(&iter);
-		while ((flow = rhashtable_walk_next(&iter))) {
-			if (IS_ERR(flow)) {
-				if (PTR_ERR(flow) == -EAGAIN)
-					continue;
-				break;
-			}
-			if (flow->vp != vp && flow->ivp != vp)
-				continue;
-			cookie = flow->cookie;
-			found = true;
-			break;
-		}
-		rhashtable_walk_stop(&iter);
-		rhashtable_walk_exit(&iter);
-
-		if (found) {
-			struct flow_cls_offload f = {
-				.cookie = cookie,
-			};
-
-			ppe_ft_flow_destroy(ft, &f);
-		}
-	} while (found);
+	mutex_lock(&ft->lock);
+	ft->topology_seq++;
+	for (i = 0; i < ppe_dev->variant->num_flow_entries; i++) {
+		flow = ft->flow_owners[i];
+		if (!flow || !list_empty(&flow->zombie_node) ||
+		    (flow->vp != vp && flow->ivp != vp))
+			continue;
+		ppe_ft_invalidate_locked(ft, flow);
+	}
+	mutex_unlock(&ft->lock);
 }
 
