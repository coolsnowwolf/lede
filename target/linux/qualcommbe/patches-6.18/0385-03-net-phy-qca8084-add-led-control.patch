From: ViKing <viking.yfy@qq.com>
Date: Tue, 27 Oct 2026 09:40:00 +0800
Subject: [PATCH] net: phy: qca808x: add QCA8084 LED control

Normalize the series position without changing the implementation.

Based on work by:
  OpenWrt community <openwrt-devel@lists.openwrt.org>

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/phy/qcom/qca808x.c
+++ b/drivers/net/phy/qcom/qca808x.c
@@ -160,6 +160,9 @@
 #define QCA8084_MEM_ACC_0			0xc90f048
 #define QCA8084_MEM_ACC_0_SWITCH			0x000c0c0c
 
+#define QCA8084_GPIO_CONFIG(pin)			(0x0c400000 + (pin) * 0x1000)
+#define QCA8084_GPIO_FUNCTION_MASK		GENMASK(5, 2)
+
 MODULE_DESCRIPTION("Qualcomm Atheros QCA808X PHY driver");
 MODULE_AUTHOR("Matus Ujhelyi, Luo Jie");
 MODULE_LICENSE("GPL");
@@ -180,6 +183,7 @@ enum {
 struct qca808x_priv {
 	int led_polarity_mode;
 	int channel_id;
+	u8 phy_index;
 	struct qcom_phy_hw_stats hw_stats;
 	struct clk *mac_tx_clk;
 	struct clk *mac_rx_clk;
@@ -189,6 +193,7 @@ struct qca808x_priv {
 
 struct qca808x_shared_priv {
 	int package_mode;
+	int phy_addr[4];
 	struct clk *clk[PACKAGE_CLK_MAX];
 	struct mdio_device *mdiodev[2];	/* PCS and XPCS mdio device */
 };
@@ -724,17 +729,6 @@ static int qca808x_led_hw_control_set(st
 			      offload_trigger);
 }
 
-static bool qca808x_led_hw_control_status(struct phy_device *phydev, u8 index)
-{
-	u16 reg;
-
-	if (index > 2)
-		return false;
-
-	reg = QCA808X_MMD7_LED_FORCE_CTRL(index);
-	return qca808x_led_reg_hw_control_status(phydev, reg);
-}
-
 static int qca808x_led_hw_control_get(struct phy_device *phydev, u8 index,
 				      unsigned long *rules)
 {
@@ -744,13 +738,20 @@ static int qca808x_led_hw_control_get(st
 	if (index > 2)
 		return -EINVAL;
 
-	/* Check if we have hw control enabled */
-	if (qca808x_led_hw_control_status(phydev, index))
+	/* Forced brightness or blinking is not hardware trigger control. */
+	reg = QCA808X_MMD7_LED_FORCE_CTRL(index);
+	val = phy_read_mmd(phydev, MDIO_MMD_AN, reg);
+	if (val < 0)
+		return val;
+	if (val & QCA808X_LED_FORCE_EN)
 		return -EINVAL;
 
 	reg = QCA808X_MMD7_LED_CTRL(index);
 
 	val = phy_read_mmd(phydev, MDIO_MMD_AN, reg);
+	if (val < 0)
+		return val;
+
 	if (val & QCA808X_LED_TX_BLINK)
 		set_bit(TRIGGER_NETDEV_TX, rules);
 	if (val & QCA808X_LED_RX_BLINK)
@@ -825,6 +826,8 @@ static int qca808x_led_polarity_set(stru
 
 	for_each_set_bit(mode, &modes, __PHY_LED_MODES_NUM) {
 		switch (mode) {
+		case PHY_LED_ACTIVE_HIGH:
+			break;
 		case PHY_LED_ACTIVE_LOW:
 			active_low = true;
 			break;
@@ -852,6 +855,73 @@ static int qca808x_led_polarity_set(stru
 			      active_low ? 0 : QCA808X_LED_ACTIVE_HIGH);
 }
 
+/* QCA8084 shares the QCA8081 LED registers, but the outputs also need
+ * to be selected in the package TLMM. Use the physical PHY index rather
+ * than the MDIO address, which can be remapped independently per port.
+ */
+static int qca8084_led_pinmux_set(struct phy_device *phydev, u8 index)
+{
+	struct qca808x_priv *priv = phydev->priv;
+	static const u8 first_pin[] = { 2, 16, 6 };
+	u32 function = 1, pin;
+	int ret;
+
+	if (index >= ARRAY_SIZE(first_pin))
+		return -EINVAL;
+
+	pin = first_pin[index] + priv->phy_index;
+	if (index == 2)
+		function = priv->phy_index == 0 || priv->phy_index == 3 ? 3 : 2;
+
+	/* Default to active high, as on QCA8081, unless DT requests low. */
+	ret = phy_modify_mmd(phydev, MDIO_MMD_AN,
+			     QCA808X_MMD7_LED_POLARITY_CTRL,
+			     QCA808X_LED_ACTIVE_HIGH,
+			     priv->led_polarity_mode == 1 ? 0 : QCA808X_LED_ACTIVE_HIGH);
+	if (ret)
+		return ret;
+
+	return qca8084_mii_modify(phydev, QCA8084_GPIO_CONFIG(pin),
+				 QCA8084_GPIO_FUNCTION_MASK,
+				 FIELD_PREP(QCA8084_GPIO_FUNCTION_MASK, function));
+}
+
+static int qca8084_led_brightness_set(struct phy_device *phydev, u8 index,
+				      enum led_brightness value)
+{
+	int ret;
+
+	ret = qca808x_led_brightness_set(phydev, index, value);
+	if (ret)
+		return ret;
+
+	return qca8084_led_pinmux_set(phydev, index);
+}
+
+static int qca8084_led_blink_set(struct phy_device *phydev, u8 index,
+				 unsigned long *delay_on, unsigned long *delay_off)
+{
+	int ret;
+
+	ret = qca808x_led_blink_set(phydev, index, delay_on, delay_off);
+	if (ret)
+		return ret;
+
+	return qca8084_led_pinmux_set(phydev, index);
+}
+
+static int qca8084_led_hw_control_set(struct phy_device *phydev, u8 index,
+				      unsigned long rules)
+{
+	int ret;
+
+	ret = qca808x_led_hw_control_set(phydev, index, rules);
+	if (ret)
+		return ret;
+
+	return qca8084_led_pinmux_set(phydev, index);
+}
+
 static int qca808x_update_stats(struct phy_device *phydev)
 {
 	struct qca808x_priv *priv = phydev->priv;
@@ -1190,6 +1260,7 @@ static int qca8084_phy_package_probe_onc
 		return ret;
 
 	shared_priv = phy_package_get_priv(phydev);
+	memcpy(shared_priv->phy_addr, addr, sizeof(shared_priv->phy_addr));
 	for (i = 0; i < ARRAY_SIZE(qca8084_package_clk_name); i++) {
 		clk = of_clk_get_by_name(np, qca8084_package_clk_name[i]);
 		if (IS_ERR(clk)) {
@@ -1257,7 +1328,7 @@ static int qca8084_probe(struct phy_devi
 	struct device *dev = &phydev->mdio.dev;
 	struct reset_control *rstc;
 	struct clk *clk;
-	int ret;
+	int i, ret;
 
 	ret = devm_of_phy_package_join(dev, phydev, sizeof(*shared_priv));
 	if (ret)
@@ -1273,6 +1344,13 @@ static int qca8084_probe(struct phy_devi
 	if (ret)
 		return ret;
 	priv = phydev->priv;
+	shared_priv = phy_package_get_priv(phydev);
+	for (i = 0; i < ARRAY_SIZE(shared_priv->phy_addr); i++)
+		if (shared_priv->phy_addr[i] == phydev->mdio.addr)
+			break;
+	if (i == ARRAY_SIZE(shared_priv->phy_addr))
+		return -EINVAL;
+	priv->phy_index = i;
 
 	/* Enable clock of PHY device, so that the PHY register
 	 * can be accessed to get PHY features.
@@ -1371,6 +1449,12 @@ static struct phy_driver qca808x_driver[
 	.link_change_notify	= qca8084_link_change_notify,
 	.probe			= qca8084_probe,
 	.remove			= qca8084_remove,
+	.led_brightness_set	= qca8084_led_brightness_set,
+	.led_blink_set		= qca8084_led_blink_set,
+	.led_hw_is_supported	= qca808x_led_hw_is_supported,
+	.led_hw_control_set	= qca8084_led_hw_control_set,
+	.led_hw_control_get	= qca808x_led_hw_control_get,
+	.led_polarity_set	= qca808x_led_polarity_set,
 }, };
 
 module_phy_driver(qca808x_driver);
