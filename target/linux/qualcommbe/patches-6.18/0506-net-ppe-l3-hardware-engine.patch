--- /dev/null
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -0,0 +1,508 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (c) 2026 Kenneth Kasilag <kenneth@kasilag.me> */
+
+/* Low level accessors of the PPE L3 flow engine.
+ *
+ * The flow engine forwards IPv4 5-tuple flows in hardware, optionally
+ * applying NAT: packets addressed to a router MAC of the MY_MAC table
+ * take the L3 route path, and a hit in the hardware flow table forwards
+ * the packet through its next hop entry, which rewrites the MACs, the
+ * VLAN and the translated addresses. Flow misses take the ordinary
+ * path to the CPU. One IP address of a flow is stored inline, the
+ * other lives in a separately allocated host-table entry whose returned
+ * index is referenced by the flow entry.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/etherdevice.h>
+#include <linux/errno.h>
+#include <linux/regmap.h>
+
+#include "ppe.h"
+#include "ppe_config.h"
+#include "ppe_flow.h"
+#include "ppe_regs.h"
+
+/* Issue an operation and return the hardware-selected table index. */
+static int ppe_flow_op_issue(struct ppe_device *ppe_dev, u32 op_type,
+			     bool by_index, int index)
+{
+	u32 val, cmd_id;
+	int ret;
+
+	cmd_id = ppe_dev->flow_cmd_id;
+	ppe_dev->flow_cmd_id = (cmd_id + 1) % 16;
+	val = FIELD_PREP(PPE_FLOW_OP_CMD_ID, cmd_id) |
+	      FIELD_PREP(PPE_FLOW_OP_TYPE, op_type) |
+	      FIELD_PREP(PPE_FLOW_OP_HASH_BLOCK_BITMAP, 0x3);
+	if (by_index)
+		val |= PPE_FLOW_OP_MODE |
+		       FIELD_PREP(PPE_FLOW_OP_ENTRY_INDEX, index);
+
+	ret = regmap_write(ppe_dev->regmap, PPE_FLOW_TBL_OP_ADDR, val);
+	if (ret)
+		return ret;
+	/* Poll for completion without sleeping first. The engine normally
+	 * finishes within a few microseconds, and keeping the flow_lock owner
+	 * on the CPU lets other installers optimistically spin on the mutex
+	 * instead of blocking in uninterruptible sleep, which would otherwise
+	 * inflate the load average during a burst of new connections. Only a
+	 * slow or stuck engine falls back to the sleeping poll below.
+	 */
+	ret = regmap_read_poll_timeout(ppe_dev->regmap,
+				       PPE_FLOW_TBL_OP_RSLT_ADDR, val,
+		FIELD_GET(PPE_FLOW_OP_RSLT_CMD_ID, val) == cmd_id &&
+		FIELD_GET(PPE_FLOW_OP_RSLT_VALID_CNT, val), 0, 50);
+	if (ret == -ETIMEDOUT)
+		ret = regmap_read_poll_timeout(ppe_dev->regmap,
+					       PPE_FLOW_TBL_OP_RSLT_ADDR, val,
+			FIELD_GET(PPE_FLOW_OP_RSLT_CMD_ID, val) == cmd_id &&
+			FIELD_GET(PPE_FLOW_OP_RSLT_VALID_CNT, val), 10, 10000);
+	if (ret)
+		return ret;
+	if (val & PPE_FLOW_OP_RSLT_FAIL)
+		return -ENOENT;
+	return FIELD_GET(PPE_FLOW_OP_RSLT_ENTRY_INDEX, val);
+}
+
+static int ppe_host_op_issue(struct ppe_device *ppe_dev, u32 op_type,
+			     bool by_index, int index)
+{
+	u32 val, cmd_id;
+	int ret;
+
+	cmd_id = ppe_dev->flow_cmd_id;
+	ppe_dev->flow_cmd_id = (cmd_id + 1) % 16;
+	val = FIELD_PREP(PPE_HOST_OP_CMD_ID, cmd_id) |
+	      FIELD_PREP(PPE_HOST_OP_TYPE, op_type) |
+	      FIELD_PREP(PPE_HOST_OP_HASH_BLOCK_BITMAP, 0x3);
+	if (by_index)
+		val |= PPE_HOST_OP_MODE |
+		       FIELD_PREP(PPE_HOST_OP_ENTRY_INDEX, index);
+
+	ret = regmap_write(ppe_dev->regmap, PPE_HOST_TBL_OP_ADDR, val);
+	if (ret)
+		return ret;
+	/* Fast non-sleeping poll first, sleeping fallback for a stuck engine;
+	 * see ppe_flow_op_issue() for the load-average rationale.
+	 */
+	ret = regmap_read_poll_timeout(ppe_dev->regmap,
+				       PPE_HOST_TBL_OP_RSLT_ADDR, val,
+		FIELD_GET(PPE_HOST_OP_RSLT_CMD_ID, val) == cmd_id &&
+		FIELD_GET(PPE_HOST_OP_RSLT_VALID_CNT, val), 0, 50);
+	if (ret == -ETIMEDOUT)
+		ret = regmap_read_poll_timeout(ppe_dev->regmap,
+					       PPE_HOST_TBL_OP_RSLT_ADDR, val,
+			FIELD_GET(PPE_HOST_OP_RSLT_CMD_ID, val) == cmd_id &&
+			FIELD_GET(PPE_HOST_OP_RSLT_VALID_CNT, val), 10, 10000);
+	if (ret)
+		return ret;
+	if (val & PPE_HOST_OP_RSLT_FAIL)
+		return -ENOENT;
+	return FIELD_GET(PPE_HOST_OP_RSLT_ENTRY_INDEX, val);
+}
+
+static void ppe_host_entry_pack(const struct ppe_flow_entry *flow, u32 *host)
+{
+	host[0] = PPE_HOST_W0_VALID;
+	host[1] = be32_to_cpu(flow->sip);
+}
+
+static void ppe_flow_entry_pack(const struct ppe_flow_entry *flow, u32 *val)
+{
+	u16 dport = be16_to_cpu(flow->dport);
+
+	/* Match QWRT: index the source host, keep the destination inline,
+	 * add disabled, then enable after every dependency exists.
+	 */
+	val[0] = 0;
+	val[0] |= FIELD_PREP(PPE_FLOW_W0_HOST_INDEX, flow->host_index);
+	val[0] |= FIELD_PREP(PPE_FLOW_W0_PROTOCOL_TYPE, flow->proto);
+	val[0] |= FIELD_PREP(PPE_FLOW_W0_AGE, 3);
+	val[0] |= FIELD_PREP(PPE_FLOW_W0_FWD_TYPE, flow->fwd_type);
+	val[1] = FIELD_PREP(PPE_FLOW_W1_NEXT_HOP, flow->nexthop);
+	val[1] |= FIELD_PREP(PPE_FLOW_W1_L4_PORT,
+			     be16_to_cpu(flow->nat_port));
+	val[3] = FIELD_PREP(PPE_FLOW_W3_L4_SPORT,
+			    be16_to_cpu(flow->sport));
+	val[3] |= FIELD_PREP(PPE_FLOW_W3_L4_DPORT_LO,
+			     dport & GENMASK(3, 0));
+	val[4] = FIELD_PREP(PPE_FLOW_W4_L4_DPORT_HI, dport >> 4);
+	val[2] = FIELD_PREP(PPE_FLOW_W2_IP_ADDR_LO,
+			    be32_to_cpu(flow->dip) & GENMASK(19, 0));
+	val[3] |= FIELD_PREP(PPE_FLOW_W3_IP_ADDR_HI,
+			     be32_to_cpu(flow->dip) >> 20);
+}
+
+int ppe_host_entry_add(struct ppe_device *ppe_dev,
+		       const struct ppe_flow_entry *flow)
+{
+	u32 host[PPE_HOST_TBL_OP_DATA_WORDS] = {};
+	int ret;
+
+	ppe_host_entry_pack(flow, host);
+	mutex_lock(&ppe_dev->flow_lock);
+	ret = regmap_bulk_write(ppe_dev->regmap, PPE_HOST_TBL_OP_DATA_ADDR,
+				host, ARRAY_SIZE(host));
+	if (!ret)
+		ret = ppe_host_op_issue(ppe_dev, PPE_FDB_OP_TYPE_ADD, false, 0);
+	mutex_unlock(&ppe_dev->flow_lock);
+	return ret;
+}
+
+int ppe_host_entry_del(struct ppe_device *ppe_dev, int index)
+{
+	int ret;
+
+	mutex_lock(&ppe_dev->flow_lock);
+	ret = ppe_host_op_issue(ppe_dev, PPE_FDB_OP_TYPE_DEL, true, index);
+	mutex_unlock(&ppe_dev->flow_lock);
+	return ret < 0 ? ret : 0;
+}
+
+int ppe_flow_entry_add(struct ppe_device *ppe_dev,
+		       const struct ppe_flow_entry *flow)
+{
+	u32 val[PPE_FLOW_TBL_OP_DATA_WORDS] = {};
+	int ret;
+
+	ppe_flow_entry_pack(flow, val);
+	mutex_lock(&ppe_dev->flow_lock);
+	ret = regmap_bulk_write(ppe_dev->regmap, PPE_FLOW_TBL_OP_DATA_ADDR,
+				val, ARRAY_SIZE(val));
+	if (!ret)
+		ret = ppe_flow_op_issue(ppe_dev, PPE_FDB_OP_TYPE_ADD, false, 0);
+	mutex_unlock(&ppe_dev->flow_lock);
+	return ret;
+}
+
+int ppe_flow_entry_enable(struct ppe_device *ppe_dev, int index, bool enable)
+{
+	u32 reg = PPE_FLOW_TBL_ADDR + PPE_FLOW_TBL_INC * index;
+	u32 valid = enable ? PPE_FLOW_W0_VALID : 0;
+	u32 val[PPE_FLOW_TBL_WORDS];
+	int ret;
+
+	mutex_lock(&ppe_dev->flow_lock);
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (!ret) {
+		val[0] &= ~PPE_FLOW_W0_VALID;
+		val[0] |= valid;
+		ret = regmap_bulk_write(ppe_dev->regmap, reg, val,
+					ARRAY_SIZE(val));
+	}
+	if (!ret) {
+		ret = regmap_read(ppe_dev->regmap, reg, &val[0]);
+		if (!ret && (val[0] & PPE_FLOW_W0_VALID) != valid)
+			ret = -EIO;
+	}
+	mutex_unlock(&ppe_dev->flow_lock);
+	return ret;
+}
+
+int ppe_flow_entry_del(struct ppe_device *ppe_dev, int index)
+{
+	int ret;
+
+	mutex_lock(&ppe_dev->flow_lock);
+	ret = ppe_flow_op_issue(ppe_dev, PPE_FDB_OP_TYPE_DEL, true, index);
+	mutex_unlock(&ppe_dev->flow_lock);
+	return ret < 0 ? ret : 0;
+}
+
+/**
+ * ppe_flow_stats_get - Read the hit counters of a flow
+ * @ppe_dev: PPE device
+ * @index: Flow table index
+ * @packets: Returned hit packet count
+ * @bytes: Returned hit byte count
+ *
+ * The counters are free running and wrap, the caller tracks deltas.
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_flow_stats_get(struct ppe_device *ppe_dev, int index, u32 *packets,
+		       u64 *bytes)
+{
+	u32 reg = PPE_FLOW_CNT_TBL_ADDR + PPE_FLOW_CNT_TBL_INC * index;
+	u32 val[3];
+	int ret;
+
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		return ret;
+
+	*packets = val[0];
+	*bytes = (u64)FIELD_GET(PPE_FLOW_CNT_W2_BYTE_CNT_HI, val[2]) << 32 |
+		 val[1];
+
+	return 0;
+}
+
+/**
+ * ppe_my_mac_set - Program a router MAC address
+ * @ppe_dev: PPE device
+ * @index: Router MAC table index
+ * @addr: MAC address
+ * @valid: Validity of the entry
+ *
+ * Packets with a matching destination MAC address take the L3 route
+ * path, including the flow table lookup.
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_my_mac_set(struct ppe_device *ppe_dev, int index, const u8 *addr,
+		   bool valid)
+{
+	u32 reg = PPE_MY_MAC_TBL_ADDR + PPE_MY_MAC_TBL_INC * index;
+	u32 my_mac_mask;
+	u32 val[2] = {};
+	int i, ret;
+
+	if (index < 0 || index >= PPE_MY_MAC_TBL_ENTRIES)
+		return -EINVAL;
+
+	my_mac_mask = FIELD_PREP(PPE_IN_L3_IF_W1_MAC_BITMAP, BIT(index));
+	if (valid) {
+		val[0] = (u32)addr[2] << 24 | addr[3] << 16 |
+			 addr[4] << 8 | addr[5];
+		val[1] = FIELD_PREP(PPE_MY_MAC_W1_MAC_ADDR_HI,
+				    addr[0] << 8 | addr[1]);
+		val[1] |= PPE_MY_MAC_W1_VALID;
+	} else {
+		/* A recycled MY_MAC slot must not remain selected by an L3
+		 * interface which used its previous address.
+		 */
+		for (i = 0; i < PPE_IN_L3_IF_TBL_ENTRIES; i++) {
+			reg = PPE_IN_L3_IF_TBL_ADDR +
+			      PPE_IN_L3_IF_TBL_INC * i + sizeof(u32);
+			ret = regmap_update_bits(ppe_dev->regmap, reg,
+						 my_mac_mask, 0);
+			if (ret)
+				return ret;
+		}
+
+		reg = PPE_MY_MAC_TBL_ADDR + PPE_MY_MAC_TBL_INC * index;
+	}
+
+	return regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+}
+
+/**
+ * ppe_l3_if_set - Configure an L3 interface
+ * @ppe_dev: PPE device
+ * @index: L3 interface index
+ * @addr: MAC address of the interface, the source MAC of routed packets
+ * leaving through it
+ * @mtu: MTU of the interface
+ *
+ * Configure the ingress side (routing enable, MTU) and the egress side
+ * (source MAC rewrite) of an L3 interface.
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_l3_if_set(struct ppe_device *ppe_dev, int index, const u8 *addr,
+		  int mtu)
+{
+	u32 in[3] = {}, eg[3] = {};
+	u32 reg;
+	int ret;
+
+	reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index;
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, in, ARRAY_SIZE(in));
+	if (ret)
+		return ret;
+
+	in[0] &= ~(PPE_IN_L3_IF_W0_MRU | PPE_IN_L3_IF_W0_MTU |
+		   PPE_IN_L3_IF_W0_TTL_DEC_BYPASS |
+		   PPE_IN_L3_IF_W0_IPV4_UC_ROUTE_EN |
+		   PPE_IN_L3_IF_W0_IPV6_UC_ROUTE_EN |
+		   PPE_IN_L3_IF_W0_ICMP_TRIGGER_EN);
+	in[0] |= FIELD_PREP(PPE_IN_L3_IF_W0_MRU, mtu);
+	in[0] |= FIELD_PREP(PPE_IN_L3_IF_W0_MTU, mtu);
+	in[0] |= PPE_IN_L3_IF_W0_IPV4_UC_ROUTE_EN;
+	in[0] |= PPE_IN_L3_IF_W0_IPV6_UC_ROUTE_EN;
+	in[1] &= ~(PPE_IN_L3_IF_W1_TTL_EXCEED_CMD |
+		   PPE_IN_L3_IF_W1_TTL_EXCEED_DEACCEL |
+		   PPE_IN_L3_IF_W1_DMAC_CHECK_DIS |
+		   PPE_IN_L3_IF_W1_MRU_IPV6);
+	in[1] |= FIELD_PREP(PPE_IN_L3_IF_W1_TTL_EXCEED_CMD,
+			    PPE_ACTION_REDIRECT_TO_CPU);
+	in[1] |= PPE_IN_L3_IF_W1_TTL_EXCEED_DEACCEL;
+	in[1] |= FIELD_PREP(PPE_IN_L3_IF_W1_MRU_IPV6, mtu);
+	in[2] &= ~(PPE_IN_L3_IF_W2_MTU_IPV6 |
+		   PPE_IN_L3_IF_W2_UDP_CSM0_CMD);
+	in[2] |= FIELD_PREP(PPE_IN_L3_IF_W2_MTU_IPV6, mtu);
+	in[2] |= FIELD_PREP(PPE_IN_L3_IF_W2_UDP_CSM0_CMD,
+			    PPE_IN_L3_IF_UDP_CSM0_MAPT_RECALCULATE);
+
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, in, ARRAY_SIZE(in));
+	if (ret)
+		return ret;
+
+	eg[0] = (u32)addr[2] << 24 | addr[3] << 16 | addr[4] << 8 | addr[5];
+	eg[1] = FIELD_PREP(PPE_EG_L3_IF_W1_MAC_ADDR_HI,
+			   addr[0] << 8 | addr[1]);
+
+	reg = PPE_EG_L3_IF_TBL_ADDR + PPE_EG_L3_IF_TBL_INC * index;
+
+	return regmap_bulk_write(ppe_dev->regmap, reg, eg, ARRAY_SIZE(eg));
+}
+
+int ppe_l3_if_my_mac_set(struct ppe_device *ppe_dev, int index, int my_mac,
+			 bool enable)
+{
+	u32 reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index +
+		  sizeof(u32);
+	u32 mask;
+
+	if (my_mac < 0 || my_mac >= PPE_MY_MAC_TBL_ENTRIES)
+		return -EINVAL;
+
+	mask = FIELD_PREP(PPE_IN_L3_IF_W1_MAC_BITMAP, BIT(my_mac));
+	return regmap_update_bits(ppe_dev->regmap, reg, mask,
+				  enable ? mask : 0);
+}
+
+int ppe_l3_if_clear(struct ppe_device *ppe_dev, int index)
+{
+	u32 val[3] = {};
+	u32 reg;
+	int ret;
+
+	reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index;
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		return ret;
+
+	reg = PPE_EG_L3_IF_TBL_ADDR + PPE_EG_L3_IF_TBL_INC * index;
+	return regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+}
+
+/**
+ * ppe_port_l3_if_set - Bind a PPE port to an L3 interface
+ * @ppe_dev: PPE device
+ * @port: PPE port to configure
+ * @l3_if: L3 interface index, negative to unbind
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_port_l3_if_set(struct ppe_device *ppe_dev, int port, int l3_if)
+{
+	u32 reg = PPE_L3_VP_PORT_TBL_ADDR + PPE_L3_VP_PORT_TBL_INC * port;
+	u32 mask = PPE_L3_VP_PORT_W0_L3_IF_VALID |
+		   PPE_L3_VP_PORT_W0_L3_IF_INDEX;
+	u32 val = 0;
+
+	if (l3_if >= 0)
+		val = PPE_L3_VP_PORT_W0_L3_IF_VALID |
+		      FIELD_PREP(PPE_L3_VP_PORT_W0_L3_IF_INDEX, l3_if);
+
+	return regmap_update_bits(ppe_dev->regmap, reg, mask, val);
+}
+
+/**
+ * ppe_pub_ip_set - Program a public NAT source address
+ * @ppe_dev: PPE device
+ * @index: Public IP table index
+ * @addr: IPv4 address, the translated source of SNAT flows
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_pub_ip_set(struct ppe_device *ppe_dev, int index, __be32 addr)
+{
+	u32 reg = PPE_PUB_IP_TBL_ADDR + PPE_PUB_IP_TBL_INC * index;
+
+	return regmap_write(ppe_dev->regmap, reg, be32_to_cpu(addr));
+}
+
+/**
+ * ppe_nexthop_set - Program a next hop entry
+ * @ppe_dev: PPE device
+ * @index: Next hop table index
+ * @nh: Next hop configuration
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_nexthop_set(struct ppe_device *ppe_dev, int index,
+		    const struct ppe_flow_nexthop *nh)
+{
+	u32 reg = PPE_NEXTHOP_TBL_ADDR + PPE_NEXTHOP_TBL_INC * index;
+	u32 val[4] = {};
+
+	val[0] = PPE_NEXTHOP_W0_TYPE;
+	val[0] |= FIELD_PREP(PPE_NEXTHOP_W0_PORT, nh->port);
+	val[0] |= FIELD_PREP(PPE_NEXTHOP_W0_POST_L3_IF, nh->l3_if);
+	if (nh->vid >= 0) {
+		val[0] |= PPE_NEXTHOP_W0_CTAG_FMT;
+		val[1] = FIELD_PREP(PPE_NEXTHOP_W1_CVID, nh->vid);
+	}
+	val[1] |= FIELD_PREP(PPE_NEXTHOP_W1_PUB_IP_INDEX, nh->pub_ip_index);
+	val[1] |= FIELD_PREP(PPE_NEXTHOP_W1_MAC_ADDR_LO,
+			     nh->mac[4] << 8 | nh->mac[5]);
+	val[2] = (u32)nh->mac[0] << 24 | nh->mac[1] << 16 |
+		 nh->mac[2] << 8 | nh->mac[3];
+	val[3] = be32_to_cpu(nh->dnat_ip);
+
+	return regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+}
+
+/**
+ * ppe_flow_hw_init - Initialize the PPE L3 flow engine
+ * @ppe_dev: PPE device
+ *
+ * Keep the flow lookup enabled but disable the hardware flow aging:
+ * the flow table users manage the lifetime of their entries.
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_flow_hw_init(struct ppe_device *ppe_dev)
+{
+	u32 mask, val;
+	int ret;
+
+	mutex_init(&ppe_dev->flow_lock);
+
+	/* The result register resets to command id 0, so start the rolling
+	 * id at 1: otherwise the first operation's completion poll matches
+	 * the reset value before the hardware has run.
+	 */
+	ppe_dev->flow_cmd_id = 1;
+
+	mask = PPE_L3_ROUTE_CTRL_IP_MRU_FAIL |
+	       PPE_L3_ROUTE_CTRL_IP_MRU_DEACCEL |
+	       PPE_L3_ROUTE_CTRL_IP_MTU_FAIL |
+	       PPE_L3_ROUTE_CTRL_IP_MTU_DEACCEL |
+	       PPE_L3_ROUTE_CTRL_IP_MTU_DF_FAIL;
+	val = FIELD_PREP(PPE_L3_ROUTE_CTRL_IP_MRU_FAIL,
+			 PPE_ACTION_REDIRECT_TO_CPU) |
+	      PPE_L3_ROUTE_CTRL_IP_MRU_DEACCEL |
+	      FIELD_PREP(PPE_L3_ROUTE_CTRL_IP_MTU_FAIL,
+			 PPE_ACTION_REDIRECT_TO_CPU) |
+	      PPE_L3_ROUTE_CTRL_IP_MTU_DEACCEL |
+	      FIELD_PREP(PPE_L3_ROUTE_CTRL_IP_MTU_DF_FAIL,
+			 PPE_ACTION_REDIRECT_TO_CPU);
+	ret = regmap_update_bits(ppe_dev->regmap, PPE_L3_ROUTE_CTRL_ADDR,
+				 mask, val);
+	if (ret)
+		return ret;
+
+	mask = PPE_L3_ROUTE_CTRL_EXT_ROUTE_MISMATCH |
+	       PPE_L3_ROUTE_CTRL_EXT_HOST_HASH_MODE_0 |
+	       PPE_L3_ROUTE_CTRL_EXT_HOST_HASH_MODE_1;
+	val = FIELD_PREP(PPE_L3_ROUTE_CTRL_EXT_ROUTE_MISMATCH,
+			 PPE_ACTION_REDIRECT_TO_CPU);
+	ret = regmap_update_bits(ppe_dev->regmap, PPE_L3_ROUTE_CTRL_EXT_ADDR,
+				 mask, val);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(ppe_dev->regmap, PPE_FLOW_CTRL0_ADDR,
+				 PPE_FLOW_CTRL0_FLOW_EN |
+				 PPE_FLOW_CTRL0_AGE_TIMER,
+				 PPE_FLOW_CTRL0_FLOW_EN);
+	if (ret)
+		return ret;
+
+	return 0;
+}
