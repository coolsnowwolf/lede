+int ppe_port_clear_mac_address(struct ppe_port *ppe_port)
+{
+	struct ppe_device *ppe_dev = ppe_port->ppe_dev;
+	u32 port_cfg[4];
+	u32 reg;
+	int ret;
+
+	reg = PPE_L3_VP_PORT_TBL_ADDR +
+	      PPE_L3_VP_PORT_TBL_INC * ppe_port->port_id;
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, port_cfg,
