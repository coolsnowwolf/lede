+			if (unlikely(rxdesc_ring->vp_punt_src >= 0))
+				rxdesc_ring->vp_punt_src = -1;
+			src_info = EDMA_RXDESC_SRC_INFO_GET(rxdesc_pri);
+			src_vp = edma_rx_info_vp(src_info);
+			if (unlikely(src_vp >= 0)) {
+				if (likely(!EDMA_RXDESC_MORE_BIT_GET(rxdesc_pri))) {
+					edma_rx_vp_punt_single(rxdesc_ring,
+							       rxdesc_pri, skb,
