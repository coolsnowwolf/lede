 #define PPE_L2_VP_PORT_TBL_INC			0x10
 #define PPE_L2_VP_PORT_W0_INVALID_VSI_FWD_EN	BIT(0)
 #define PPE_L2_VP_PORT_W0_DST_INFO		GENMASK(9, 2)
+#define PPE_L2_VP_PORT_W0_PHYSICAL_PORT		GENMASK(12, 10)
 #define PPE_L2_VP_PORT_W1_STATE_CHECK_EN	BIT(28)
 #define PPE_L2_VP_PORT_W1_VP_TYPE		BIT(29)
 #define PPE_L2_VP_PORT_W1_CONTEXT_ACTIVE	BIT(30)
@@ -777,6 +778,56 @@
 #define PPE_PPPOE_SESSION_EXT2_L3_IF		GENMASK(15, 8)
 #define PPE_PPPOE_SESSION_EXT2_L3_IF_VALID	BIT(16)
 
+/* APPE tunnel lookup commands. Add/delete use one shared 14-word operand;
+ * get has a separate command, operand and result block. The backing table is
+ * not the insertion interface.
+ */
+#define PPE_TUNNEL_TBL_OP_ADDR			0x300000
+#define PPE_TUNNEL_TBL_OP_DATA_ADDR		0x300004
+#define PPE_TUNNEL_TBL_RD_OP_ADDR		0x300054
+#define PPE_TUNNEL_TBL_RD_OP_DATA_ADDR		0x300058
+#define PPE_TUNNEL_TBL_RD_RESULT_ADDR		0x3000a0
+#define PPE_TUNNEL_OP_TYPE			GENMASK(2, 0)
+#define PPE_TUNNEL_OP_HASH_BLOCK_BITMAP		GENMASK(4, 3)
+#define PPE_TUNNEL_OP_MODE			BIT(5)
+#define PPE_TUNNEL_OP_ENTRY_INDEX		GENMASK(12, 6)
+#define PPE_TUNNEL_OP_RESULT			BIT(13)
+#define PPE_TUNNEL_OP_BUSY			BIT(14)
+#define PPE_TUNNEL_OP_POLLS			64
+#define PPE_TUNNEL_ENTRIES			128
+
+/* Tunnel decap hit counters are in the ingress-policer block despite the
+ * TL name. Clear them only after an indexed delete succeeds.
+ */
+#define PPE_TUNNEL_COUNTER_ADDR			0x154000
+#define PPE_TUNNEL_COUNTER_INC			0x10
+#define PPE_TUNNEL_COUNTER_WORDS		3
+
+/* Egress tunnel template and its dedicated virtual-port binding. */
+#define PPE_TUNNEL_ENCAP_HEADER_ADDR		0x054000
+#define PPE_TUNNEL_ENCAP_HEADER_INC		0x80
+#define PPE_TUNNEL_ENCAP_CTRL_ADDR		0x05a000
+#define PPE_TUNNEL_ENCAP_CTRL_INC		0x10
+#define PPE_TUNNEL_EG_VP_ADDR			0x025000
+#define PPE_TUNNEL_EG_VP_ENTRIES		256
+#define PPE_TUNNEL_EG_VP_INC			0x10
+#define PPE_TUNNEL_EG_VP_WORDS			2
+#define PPE_TUNNEL_EG_VP_W1_VALID		BIT(11)
+#define PPE_TUNNEL_EG_VP_W1_ID			GENMASK(18, 12)
+
+/* Per-underlay termination configuration and decap key generation. */
+#define PPE_TUNNEL_PORT_INTF_ADDR		0x302000
+#define PPE_TUNNEL_PORT_INTF_ENTRIES		256
+#define PPE_TUNNEL_PORT_INTF_INC		0x10
+#define PPE_TUNNEL_PORT_INTF_W0_L3_VALID	BIT(24)
+#define PPE_TUNNEL_PORT_INTF_W0_L3_INDEX	GENMASK(31, 25)
+#define PPE_TUNNEL_L3_IF_ADDR			0x303000
+#define PPE_TUNNEL_L3_IF_ENTRIES		128
+#define PPE_TUNNEL_L3_IF_INC			0x10
+#define PPE_TUNNEL_KEY_ADDR			0x303800
+#define PPE_TUNNEL_KEY_ENTRIES			16
+#define PPE_TUNNEL_KEY_INC			0x10
+
 /* Per-VSI L3 interface binding: routed packets classified into the VSI
  * take this ingress L3 interface instead of the one bound to their
  * ingress port.
--- /dev/null
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_tunnel.c
@@ -0,0 +1,637 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Copyright (c) 2026 Kenneth Kasilag <kenneth@kasilag.me> */
+
+/* Low-level APPE tunnel transactions. The command operand and result blocks
+ * are shared hardware resources, so every operation is serialized by the
+ * device tunnel lock. Higher layers own IDs and compose these primitives into
+ * a refcounted tunnel-port transaction before publishing any flow.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/if_ether.h>
+#include <linux/kernel.h>
+#include <linux/regmap.h>
+
+#include "ppe.h"
+#include "ppe_config.h"
+#include "ppe_regs.h"
+#include "ppe_tunnel.h"
+
+enum ppe_tunnel_op {
+	PPE_TUNNEL_OP_ADD,
+	PPE_TUNNEL_OP_DEL,
+	PPE_TUNNEL_OP_GET,
+};
+
+static int ppe_tunnel_check(struct ppe_device *ppe_dev)
+{
+	if (!ppe_dev->variant->has_tunnel_engine)
+		return -EOPNOTSUPP;
+
+	return 0;
+}
+
+static int ppe_tunnel_op_wait(struct ppe_device *ppe_dev, u32 reg, u32 *value)
+{
+	int i, ret;
+	u32 val;
+
+	for (i = 0; i < PPE_TUNNEL_OP_POLLS; i++) {
+		ret = regmap_read(ppe_dev->regmap, reg, &val);
+		if (ret)
+			return ret;
+		if (!(val & PPE_TUNNEL_OP_BUSY)) {
+			*value = val;
+			return 0;
+		}
+		cpu_relax();
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int ppe_tunnel_op_issue(struct ppe_device *ppe_dev, u32 reg,
+			       enum ppe_tunnel_op op, bool by_index,
+			       int *index)
+{
+	u32 val;
+	int ret;
+
+	val = FIELD_PREP(PPE_TUNNEL_OP_TYPE, op) |
+	      FIELD_PREP(PPE_TUNNEL_OP_HASH_BLOCK_BITMAP, 3) |
+	      PPE_TUNNEL_OP_BUSY;
+	if (by_index)
+		val |= PPE_TUNNEL_OP_MODE |
+		       FIELD_PREP(PPE_TUNNEL_OP_ENTRY_INDEX, *index);
+
+	ret = regmap_write(ppe_dev->regmap, reg, val);
+	if (ret)
+		return ret;
+	ret = ppe_tunnel_op_wait(ppe_dev, reg, &val);
+	if (ret)
+		return ret;
+	if (val & PPE_TUNNEL_OP_RESULT)
+		return op == PPE_TUNNEL_OP_ADD ? -ENOSPC : -ENOENT;
+
+	*index = FIELD_GET(PPE_TUNNEL_OP_ENTRY_INDEX, val);
+	return 0;
+}
+
+static int ppe_tunnel_decap_get_locked(struct ppe_device *ppe_dev, int index,
+				       struct ppe_tunnel_decap_entry *entry)
+{
+	int ret;
+
+	ret = ppe_tunnel_op_issue(ppe_dev, PPE_TUNNEL_TBL_RD_OP_ADDR,
+				  PPE_TUNNEL_OP_GET, true, &index);
+	if (ret)
+		return ret;
+
+	return regmap_bulk_read(ppe_dev->regmap,
+				PPE_TUNNEL_TBL_RD_RESULT_ADDR, entry->word,
+				ARRAY_SIZE(entry->word));
+}
+
+int ppe_tunnel_decap_add(struct ppe_device *ppe_dev,
+			 const struct ppe_tunnel_decap_entry *entry,
+			 int *index, struct ppe_tunnel_decap_entry *readback)
+{
+	struct ppe_tunnel_decap_entry verify;
+	int ret, hw_index = 0;
+
+	if (!entry || !index)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+
+	*index = -1;
+	if (!readback)
+		readback = &verify;
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = regmap_bulk_write(ppe_dev->regmap, PPE_TUNNEL_TBL_OP_DATA_ADDR,
+				entry->word, ARRAY_SIZE(entry->word));
+	if (!ret)
+		ret = ppe_tunnel_op_issue(ppe_dev, PPE_TUNNEL_TBL_OP_ADDR,
+					  PPE_TUNNEL_OP_ADD, false, &hw_index);
+	if (!ret) {
+		/* Publish the returned index before readback. If readback fails,
+		 * the caller can still remove or quarantine the live row.
+		 */
+		*index = hw_index;
+		ret = ppe_tunnel_decap_get_locked(ppe_dev, hw_index, readback);
+	}
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+int ppe_tunnel_decap_get(struct ppe_device *ppe_dev, int index,
+			 struct ppe_tunnel_decap_entry *entry)
+{
+	int ret;
+
+	if (!entry || index < 0 || index >= PPE_TUNNEL_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = ppe_tunnel_decap_get_locked(ppe_dev, index, entry);
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+int ppe_tunnel_decap_del(struct ppe_device *ppe_dev, int index)
+{
+	u32 counter[PPE_TUNNEL_COUNTER_WORDS] = {};
+	int ret;
+
+	if (index < 0 || index >= PPE_TUNNEL_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = ppe_tunnel_op_issue(ppe_dev, PPE_TUNNEL_TBL_OP_ADDR,
+				  PPE_TUNNEL_OP_DEL, true, &index);
+	if (!ret)
+		ret = regmap_bulk_write(ppe_dev->regmap,
+					PPE_TUNNEL_COUNTER_ADDR +
+					index * PPE_TUNNEL_COUNTER_INC,
+					counter, ARRAY_SIZE(counter));
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+static int ppe_tunnel_encap_restore(struct ppe_device *ppe_dev, int tunnel_id,
+				    const u32 *control, const u32 *header)
+{
+	u32 disabled[PPE_TUNNEL_ENCAP_CTRL_WORDS] = {};
+	u32 ctrl_reg = PPE_TUNNEL_ENCAP_CTRL_ADDR +
+		       tunnel_id * PPE_TUNNEL_ENCAP_CTRL_INC;
+	u32 hdr_reg = PPE_TUNNEL_ENCAP_HEADER_ADDR +
+		      tunnel_id * PPE_TUNNEL_ENCAP_HEADER_INC;
+	int ret, err;
+
+	ret = regmap_bulk_write(ppe_dev->regmap, ctrl_reg, disabled,
+				ARRAY_SIZE(disabled));
+	err = regmap_bulk_write(ppe_dev->regmap, hdr_reg, header,
+				PPE_TUNNEL_ENCAP_HEADER_WORDS);
+	if (!ret)
+		ret = err;
+	err = regmap_bulk_write(ppe_dev->regmap, ctrl_reg, control,
+				PPE_TUNNEL_ENCAP_CTRL_WORDS);
+	if (!ret)
+		ret = err;
+
+	return ret;
+}
+
+int ppe_tunnel_encap_set(struct ppe_device *ppe_dev, int tunnel_id,
+			 const struct ppe_tunnel_encap_entry *entry)
+{
+	struct ppe_tunnel_encap_entry old, verify;
+	u32 ctrl_reg, hdr_reg;
+	int ret, restore_ret;
+
+	if (!entry || tunnel_id < 0 || tunnel_id >= PPE_TUNNEL_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+
+	ctrl_reg = PPE_TUNNEL_ENCAP_CTRL_ADDR +
+		   tunnel_id * PPE_TUNNEL_ENCAP_CTRL_INC;
+	hdr_reg = PPE_TUNNEL_ENCAP_HEADER_ADDR +
+		  tunnel_id * PPE_TUNNEL_ENCAP_HEADER_INC;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = regmap_bulk_read(ppe_dev->regmap, ctrl_reg, old.control,
+			       ARRAY_SIZE(old.control));
+	if (ret)
+		goto out;
+	ret = regmap_bulk_read(ppe_dev->regmap, hdr_reg, old.header,
+			       ARRAY_SIZE(old.header));
+	if (ret)
+		goto out;
+
+	/* Match the vendor order. The VP is not bound until both rows verify. */
+	ret = regmap_bulk_write(ppe_dev->regmap, ctrl_reg, entry->control,
+				ARRAY_SIZE(entry->control));
+	if (ret)
+		goto restore;
+	ret = regmap_bulk_write(ppe_dev->regmap, hdr_reg, entry->header,
+				ARRAY_SIZE(entry->header));
+	if (ret)
+		goto restore;
+	ret = regmap_bulk_read(ppe_dev->regmap, ctrl_reg, verify.control,
+			       ARRAY_SIZE(verify.control));
+	if (ret)
+		goto restore;
+	ret = regmap_bulk_read(ppe_dev->regmap, hdr_reg, verify.header,
+			       ARRAY_SIZE(verify.header));
+	if (ret)
+		goto restore;
+	if (memcmp(&verify, entry, sizeof(verify))) {
+		ret = -EIO;
+		goto restore;
+	}
+	goto out;
+
+restore:
+	restore_ret = ppe_tunnel_encap_restore(ppe_dev, tunnel_id,
+					       old.control, old.header);
+	if (restore_ret)
+		dev_err(ppe_dev->dev,
+			"failed to restore tunnel encap %d: %d\n",
+			tunnel_id, restore_ret);
+out:
+	mutex_unlock(&ppe_dev->tunnel_lock);
+	return ret;
+}
+
+int ppe_tunnel_encap_clear(struct ppe_device *ppe_dev, int tunnel_id)
+{
+	struct ppe_tunnel_encap_entry entry = {};
+
+	return ppe_tunnel_encap_set(ppe_dev, tunnel_id, &entry);
+}
+
+static int ppe_tunnel_vp_bind_locked(struct ppe_device *ppe_dev, int vp,
+				     bool valid, int tunnel_id)
+{
+	u32 reg = PPE_TUNNEL_EG_VP_ADDR + vp * PPE_TUNNEL_EG_VP_INC;
+	u32 old[PPE_TUNNEL_EG_VP_WORDS], val[PPE_TUNNEL_EG_VP_WORDS];
+	u32 verify[PPE_TUNNEL_EG_VP_WORDS];
+	int ret;
+
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, old, ARRAY_SIZE(old));
+	if (ret)
+		return ret;
+	memcpy(val, old, sizeof(val));
+	FIELD_MODIFY(PPE_TUNNEL_EG_VP_W1_VALID, &val[1], valid);
+	FIELD_MODIFY(PPE_TUNNEL_EG_VP_W1_ID, &val[1], tunnel_id);
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		return ret;
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, verify,
+			       ARRAY_SIZE(verify));
+	if (!ret && !memcmp(verify, val, sizeof(verify)))
+		return 0;
+	if (!ret)
+		ret = -EIO;
+	if (regmap_bulk_write(ppe_dev->regmap, reg, old, ARRAY_SIZE(old)))
+		dev_err(ppe_dev->dev, "failed to restore tunnel VP %d\n", vp);
+
+	return ret;
+}
+
+int ppe_tunnel_vp_bind(struct ppe_device *ppe_dev, int vp, int tunnel_id)
+{
+	int ret;
+
+	if (vp < 0 || vp >= PPE_TUNNEL_EG_VP_ENTRIES || tunnel_id < 0 ||
+	    tunnel_id >= PPE_TUNNEL_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = ppe_tunnel_vp_bind_locked(ppe_dev, vp, true, tunnel_id);
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+int ppe_tunnel_vp_unbind(struct ppe_device *ppe_dev, int vp)
+{
+	int ret;
+
+	if (vp < 0 || vp >= PPE_TUNNEL_EG_VP_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = ppe_tunnel_vp_bind_locked(ppe_dev, vp, false, 0);
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+/* Write @count words at @reg, read them back to prove the write took
+ * effect, and restore @old on any failure. The caller holds tunnel_lock
+ * and reports @what/@id in the restore-failure message.
+ */
+static int ppe_tunnel_write_verify(struct ppe_device *ppe_dev, u32 reg,
+				   const u32 *old, const u32 *val, int count,
+				   const char *what, int id)
+{
+	u32 verify[PPE_TUNNEL_KEY_WORDS];
+	int ret;
+
+	if (WARN_ON_ONCE(count > ARRAY_SIZE(verify)))
+		return -EINVAL;
+
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, count);
+	if (!ret)
+		ret = regmap_bulk_read(ppe_dev->regmap, reg, verify, count);
+	if (!ret && memcmp(verify, val, count * sizeof(*val)))
+		ret = -EIO;
+	if (ret && regmap_bulk_write(ppe_dev->regmap, reg, old, count))
+		dev_err(ppe_dev->dev, "failed to restore %s %d\n", what, id);
+
+	return ret;
+}
+
+int ppe_tunnel_port_l3_if_set(struct ppe_device *ppe_dev, int port,
+			      bool valid, int l3_if)
+{
+	u32 reg, old[3], val[3];
+	int ret;
+
+	if (port < 0 || port >= PPE_TUNNEL_PORT_INTF_ENTRIES ||
+	    l3_if < 0 || l3_if >= PPE_TUNNEL_L3_IF_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+	reg = PPE_TUNNEL_PORT_INTF_ADDR +
+	      port * PPE_TUNNEL_PORT_INTF_INC;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, old, ARRAY_SIZE(old));
+	if (ret)
+		goto out;
+	memcpy(val, old, sizeof(val));
+	FIELD_MODIFY(PPE_TUNNEL_PORT_INTF_W0_L3_VALID, &val[0], valid);
+	FIELD_MODIFY(PPE_TUNNEL_PORT_INTF_W0_L3_INDEX, &val[0], l3_if);
+	ret = ppe_tunnel_write_verify(ppe_dev, reg, old, val, ARRAY_SIZE(val),
+				      "tunnel port interface", port);
+out:
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+int ppe_tunnel_l3_if_set(struct ppe_device *ppe_dev, int index, u32 value)
+{
+	u32 reg, old;
+	int ret;
+
+	if (index < 0 || index >= PPE_TUNNEL_L3_IF_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+	reg = PPE_TUNNEL_L3_IF_ADDR + index * PPE_TUNNEL_L3_IF_INC;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = regmap_read(ppe_dev->regmap, reg, &old);
+	if (ret)
+		goto out;
+	ret = ppe_tunnel_write_verify(ppe_dev, reg, &old, &value, 1,
+				      "tunnel L3 interface", index);
+out:
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+int ppe_tunnel_key_set(struct ppe_device *ppe_dev, int type,
+		       const u32 key[PPE_TUNNEL_KEY_WORDS])
+{
+	u32 old[PPE_TUNNEL_KEY_WORDS];
+	u32 reg;
+	int ret;
+
+	if (!key || type < 0 || type >= PPE_TUNNEL_KEY_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+	reg = PPE_TUNNEL_KEY_ADDR + type * PPE_TUNNEL_KEY_INC;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, old, ARRAY_SIZE(old));
+	if (ret)
+		goto out;
+	ret = ppe_tunnel_write_verify(ppe_dev, reg, old, key, ARRAY_SIZE(old),
+				      "tunnel key", type);
+out:
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+/* One match-or-allocate bitmap allocator backs the tunnel encap-ID,
+ * tunnel-L3-interface and dedicated-VP spaces; @base offsets the
+ * returned and freed identifiers into the caller's number space.
+ */
+static int ppe_tunnel_bitmap_alloc(struct ppe_device *ppe_dev,
+				   unsigned long *map, int count, int base)
+{
+	unsigned int id;
+
+	if (ppe_tunnel_check(ppe_dev))
+		return -EOPNOTSUPP;
+
+	mutex_lock(&ppe_dev->tunnel_state_lock);
+	id = find_first_zero_bit(map, count);
+	if (id < count)
+		__set_bit(id, map);
+	mutex_unlock(&ppe_dev->tunnel_state_lock);
+
+	return id < count ? base + id : -ENOSPC;
+}
+
+static void ppe_tunnel_bitmap_free(struct ppe_device *ppe_dev,
+				   unsigned long *map, int count, int base,
+				   int id)
+{
+	bool allocated;
+
+	id -= base;
+	if (WARN_ON_ONCE(id < 0 || id >= count))
+		return;
+
+	mutex_lock(&ppe_dev->tunnel_state_lock);
+	allocated = test_and_clear_bit(id, map);
+	mutex_unlock(&ppe_dev->tunnel_state_lock);
+	WARN_ON_ONCE(!allocated);
+}
+
+int ppe_tunnel_id_alloc(struct ppe_device *ppe_dev)
+{
+	return ppe_tunnel_bitmap_alloc(ppe_dev, ppe_dev->tunnel_id_map,
+				       PPE_TUNNEL_ID_COUNT, 0);
+}
+
+void ppe_tunnel_id_free(struct ppe_device *ppe_dev, int tunnel_id)
+{
+	ppe_tunnel_bitmap_free(ppe_dev, ppe_dev->tunnel_id_map,
+			       PPE_TUNNEL_ID_COUNT, 0, tunnel_id);
+}
+
+int ppe_tunnel_l3_if_alloc(struct ppe_device *ppe_dev)
+{
+	return ppe_tunnel_bitmap_alloc(ppe_dev, ppe_dev->tunnel_l3_if_map,
+				       PPE_TUNNEL_L3_IF_COUNT, 0);
+}
+
+void ppe_tunnel_l3_if_free(struct ppe_device *ppe_dev, int l3_if)
+{
+	ppe_tunnel_bitmap_free(ppe_dev, ppe_dev->tunnel_l3_if_map,
+			       PPE_TUNNEL_L3_IF_COUNT, 0, l3_if);
+}
+
+int ppe_tunnel_vp_alloc(struct ppe_device *ppe_dev)
+{
+	return ppe_tunnel_bitmap_alloc(ppe_dev, ppe_dev->tunnel_vp_map,
+				       PPE_TUNNEL_VP_COUNT,
+				       PPE_TUNNEL_VP_BASE);
+}
+
+void ppe_tunnel_vp_free(struct ppe_device *ppe_dev, int vp)
+{
+	ppe_tunnel_bitmap_free(ppe_dev, ppe_dev->tunnel_vp_map,
+			       PPE_TUNNEL_VP_COUNT, PPE_TUNNEL_VP_BASE, vp);
+}
+
+/* Configure the dedicated tunnel VP exactly as the vendor transaction does:
+ * give it the tunnel MTU, copy the underlay port's unicast queue, map it to
+ * that physical port, then expose an active tunnel context. On teardown the
+ * context is hidden first. The reserved VP range has no other owner, so its
+ * inactive state is the all-zero table state.
+ */
+int ppe_tunnel_port_set(struct ppe_device *ppe_dev, int vp,
+			int physical_port, int mtu, bool active)
+{
+	u32 l2_old[4], l2_new[4] = {};
+	u32 l2_verify[4], mtu_verify[3], queue_verify;
+	u32 mtu_old[3], mtu_new[3] = {};
+	u32 queue_old, queue_new = 0;
+	u32 l2_reg, mtu_reg, queue_reg;
+	int q_start, q_end, ret, err;
+
+	if (vp < PPE_TUNNEL_VP_BASE ||
+	    vp >= PPE_TUNNEL_VP_BASE + PPE_TUNNEL_VP_COUNT ||
+	    physical_port < 0 || physical_port >= ppe_dev->num_ports ||
+	    mtu < 0 || mtu + ETH_HLEN > FIELD_MAX(PPE_MRU_MTU_CTRL_W0_MTU))
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+
+	l2_reg = PPE_L2_VP_PORT_TBL_ADDR + PPE_L2_VP_PORT_TBL_INC * vp;
+	mtu_reg = PPE_MRU_MTU_CTRL_TBL_ADDR + PPE_MRU_MTU_CTRL_TBL_INC * vp;
+	queue_reg = PPE_UCAST_QUEUE_MAP_TBL_ADDR +
+		    PPE_UCAST_QUEUE_MAP_TBL_INC * vp;
+
+	mutex_lock(&ppe_dev->tunnel_state_lock);
+	ret = regmap_bulk_read(ppe_dev->regmap, l2_reg, l2_old,
+			       ARRAY_SIZE(l2_old));
+	if (ret)
+		goto out;
+	ret = regmap_bulk_read(ppe_dev->regmap, mtu_reg, mtu_old,
+			       ARRAY_SIZE(mtu_old));
+	if (ret)
+		goto out;
+	ret = regmap_read(ppe_dev->regmap, queue_reg, &queue_old);
+	if (ret)
+		goto out;
+
+	if (active) {
+		ret = ppe_port_resource_get(ppe_dev, physical_port,
+					    PPE_RES_UCAST, &q_start, &q_end);
+		if (ret)
+			goto out;
+		if (q_start > q_end) {
+			ret = -EINVAL;
+			goto out;
+		}
+		PPE_MRU_MTU_CTRL_SET_MRU(mtu_new, mtu + ETH_HLEN);
+		PPE_MRU_MTU_CTRL_SET_MTU(mtu_new, mtu + ETH_HLEN);
+		PPE_MRU_MTU_CTRL_SET_RX_CNT_EN(mtu_new, true);
+		PPE_MRU_MTU_CTRL_SET_TX_CNT_EN(mtu_new, true);
+		queue_new = FIELD_PREP(PPE_UCAST_QUEUE_MAP_TBL_PROFILE_ID,
+				       physical_port) |
+			    FIELD_PREP(PPE_UCAST_QUEUE_MAP_TBL_QUEUE_ID,
+				       q_start);
+		l2_new[0] = FIELD_PREP(PPE_L2_VP_PORT_W0_PHYSICAL_PORT,
+				       physical_port);
+		l2_new[1] = PPE_L2_VP_PORT_W1_STATE_CHECK_EN |
+			      PPE_L2_VP_PORT_W1_CONTEXT_ACTIVE;
+	}
+
+	/* On activation expose L2 state last; on teardown hide it first. */
+	if (!active) {
+		ret = regmap_bulk_write(ppe_dev->regmap, l2_reg, l2_new,
+					ARRAY_SIZE(l2_new));
+		if (ret)
+			goto restore;
+	}
+	ret = regmap_bulk_write(ppe_dev->regmap, mtu_reg, mtu_new,
+				ARRAY_SIZE(mtu_new));
+	if (ret)
+		goto restore;
+	ret = regmap_write(ppe_dev->regmap, queue_reg, queue_new);
+	if (ret)
+		goto restore;
+	if (active) {
+		ret = regmap_bulk_write(ppe_dev->regmap, l2_reg, l2_new,
+					ARRAY_SIZE(l2_new));
+		if (ret)
+			goto restore;
+	}
+	ret = regmap_bulk_read(ppe_dev->regmap, l2_reg, l2_verify,
+			       ARRAY_SIZE(l2_verify));
+	if (ret)
+		goto restore;
+	ret = regmap_bulk_read(ppe_dev->regmap, mtu_reg, mtu_verify,
+			       ARRAY_SIZE(mtu_verify));
+	if (ret)
+		goto restore;
+	ret = regmap_read(ppe_dev->regmap, queue_reg, &queue_verify);
+	if (ret)
+		goto restore;
+	if (memcmp(l2_verify, l2_new, sizeof(l2_new)) ||
+	    memcmp(mtu_verify, mtu_new, sizeof(mtu_new)) ||
+	    queue_verify != queue_new) {
+		ret = -EIO;
+		goto restore;
+	}
+	goto out;
+
+restore:
+	err = regmap_bulk_write(ppe_dev->regmap, l2_reg, l2_old,
+				ARRAY_SIZE(l2_old));
+	err |= regmap_bulk_write(ppe_dev->regmap, mtu_reg, mtu_old,
+				 ARRAY_SIZE(mtu_old));
+	err |= regmap_write(ppe_dev->regmap, queue_reg, queue_old);
+	if (err)
+		dev_err(ppe_dev->dev, "failed to restore tunnel VP %d\n", vp);
+out:
+	mutex_unlock(&ppe_dev->tunnel_state_lock);
+	return ret;
+}
+
+int ppe_tunnel_hw_init(struct ppe_device *ppe_dev)
+{
+	mutex_init(&ppe_dev->tunnel_lock);
+	mutex_init(&ppe_dev->tunnel_state_lock);
+	bitmap_zero(ppe_dev->tunnel_id_map, PPE_TUNNEL_ID_COUNT);
+	bitmap_zero(ppe_dev->tunnel_l3_if_map, PPE_TUNNEL_L3_IF_COUNT);
+	bitmap_zero(ppe_dev->tunnel_vp_map, PPE_TUNNEL_VP_COUNT);
+
+	return 0;
+}
