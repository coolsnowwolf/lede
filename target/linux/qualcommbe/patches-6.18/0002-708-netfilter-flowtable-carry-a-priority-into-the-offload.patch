--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -187,6 +187,7 @@ struct flow_offload {
 	unsigned long				flags;
 	u16					type;
 	u32					timeout;
+	u32					priority;
 	struct rcu_head				rcu_head;
 };
 
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -419,6 +419,13 @@ static int nf_flow_offload_forward(struc
 		ip_decrease_ttl(iph);
 	skb_clear_tstamp(skb);
 
+	/* Match routed IPv4 priority without changing transparent bridging. */
+	if (flow->priority)
+		skb->priority = flow->priority;
+	else if ((!flow_table->type || flow_table->type->family != NFPROTO_BRIDGE) &&
+		 READ_ONCE(dev_net(skb->dev)->ipv4.sysctl_ip_fwd_update_priority))
+		skb->priority = rt_tos2priority(iph->tos);
+
 	if (flow_table->flags & NF_FLOWTABLE_COUNTER)
 		nf_ct_acct_update(flow->ct, tuplehash->tuple.dir, skb->len);
 
@@ -709,6 +716,9 @@ static int nf_flow_offload_ipv6_forward(
 		ip6h->hop_limit--;
 	skb_clear_tstamp(skb);
 
+	if (flow->priority)
+		skb->priority = flow->priority;
+
 	if (flow_table->flags & NF_FLOWTABLE_COUNTER)
 		nf_ct_acct_update(flow->ct, tuplehash->tuple.dir, skb->len);
 
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -694,6 +694,17 @@ nf_flow_rule_route_common(struct net *ne
 	    flow_offload_eth_dst(net, flow, dir, flow_rule) < 0)
 		return -1;
 
+	if (flow->priority) {
+		struct flow_action_entry *entry;
+
+		entry = flow_action_entry_next(flow_rule);
+		if (!entry)
+			return -1;
+
+		entry->id = FLOW_ACTION_PRIORITY;
+		entry->priority = flow->priority;
+	}
+
 	tuple = &flow->tuplehash[dir].tuple;
 
 	for (i = 0; i < tuple->encap_num; i++) {
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -47,6 +47,23 @@ static void flow_offload_ct_tcp(struct n
 	spin_unlock_bh(&ct->lock);
 }
 
+/* The priority a rule set before "flow add". IPv4 forwarding gives every
+ * packet one derived from its TOS unless ip_forward_update_priority is off:
+ * that one is not the flow's but each packet's, so the fast path derives it
+ * per packet again, and hardware classifies on the DSCP itself.
+ */
+static u32 nft_flow_offload_priority(const struct nft_pktinfo *pkt)
+{
+	const struct sk_buff *skb = pkt->skb;
+
+	if (nft_pf(pkt) == NFPROTO_IPV4 &&
+	    READ_ONCE(nft_net(pkt)->ipv4.sysctl_ip_fwd_update_priority) &&
+	    skb->priority == rt_tos2priority(ip_hdr(skb)->tos))
+		return 0;
+
+	return skb->priority;
+}
+
 static void nft_flow_offload_eval(const struct nft_expr *expr,
 				  struct nft_regs *regs,
 				  const struct nft_pktinfo *pkt)
@@ -127,6 +144,8 @@ static void nft_flow_offload_eval(const
 	if (tcph)
 		flow_offload_ct_tcp(ct);
 
+	flow->priority = nft_flow_offload_priority(pkt);
+
 	__set_bit(NF_FLOW_HW_BIDIRECTIONAL, &flow->flags);
 	ret = flow_offload_add(flowtable, flow);
 	if (ret < 0)
