From: ViKing <viking.yfy@qq.com>
Date: Mon, 12 Oct 2026 04:00:00 +0800
Subject: [PATCH] net: dsa: qca8k: initialize MHT idle ports

QSDK keeps link-down MHT ports at 1G/full to avoid a QM issue. Cover
never-up ports at PHY initialization and subsequent link-down events,
leaving user MACs gated until phylink link_up. Match MHT's paired TX
flow-control bits. Preserve other switch families and QXGMII packages.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -37,11 +37,6 @@ qca8k_split_addr(u32 regaddr, u16 *r1, u
 	*page = regaddr & 0x3ff;
 }
 
-static bool qca8k_is_qca8386(const struct qca8k_priv *priv)
-{
-	return priv->info && priv->info->id == QCA8K_ID_QCA8386;
-}
-
 static void
 qca8k_mht_split_addr(u32 regaddr, u16 *r1, u16 *r2, u16 *page,
 		     u16 *switch_phy_id)
@@ -502,6 +497,7 @@ exit:
 	return ret;
 }
 
+
 static int
 qca8k_write_mii(struct qca8k_priv *priv, uint32_t reg, uint32_t val)
 {
@@ -1610,8 +1606,11 @@ qca8k_phylink_mac_link_up(struct phylink
 		if (rx_pause || dsa_port_is_cpu(dp))
 			reg |= QCA8K_PORT_STATUS_RXFLOW;
 
-		if (tx_pause || dsa_port_is_cpu(dp))
+		if (tx_pause || dsa_port_is_cpu(dp)) {
 			reg |= QCA8K_PORT_STATUS_TXFLOW;
+			if (qca8k_is_qca8386(priv))
+				reg |= QCA8K_MHT_PORT_STATUS_TX_HALF_FLOW;
+		}
 	}
 
 	reg |= QCA8K_PORT_STATUS_TXMAC | QCA8K_PORT_STATUS_RXMAC;
@@ -2425,7 +2424,11 @@ qca8k_sw_probe(struct mdio_device *mdiod
 	mutex_init(&priv->reg_mutex);
 	dev_set_drvdata(&mdiodev->dev, priv);
 
-	return dsa_register_switch(priv->ds);
+	ret = dsa_register_switch(priv->ds);
+	if (ret)
+		return ret;
+
+	return 0;
 }
 
 static void
@@ -2437,6 +2440,7 @@ qca8k_sw_remove(struct mdio_device *mdio
 	if (!priv)
 		return;
 
+
 	for (i = 0; i < QCA8K_NUM_PORTS; i++)
 		qca8k_port_set_status(priv, i, 0);
 
@@ -2450,6 +2454,7 @@ static void qca8k_sw_shutdown(struct mdi
 	if (!priv)
 		return;
 
+
 	dsa_switch_shutdown(priv->ds);
 
 	dev_set_drvdata(&mdiodev->dev, NULL);
--- a/drivers/net/dsa/qca/qca8k-common.c
+++ b/drivers/net/dsa/qca/qca8k-common.c
@@ -634,6 +634,21 @@ void qca8k_port_set_status(struct qca8k_
 {
 	u32 mask = QCA8K_PORT_STATUS_TXMAC | QCA8K_PORT_STATUS_RXMAC;
 
+	/* MHT needs a 1G/full idle MAC to avoid its QM link-down issue.
+	 * MACs remain gated until phylink's link_up programs the live state.
+	 */
+	if (qca8k_is_qca8386(priv) && dsa_is_user_port(priv->ds, port) &&
+	    !enable) {
+		regmap_update_bits(priv->regmap, QCA8K_REG_PORT_STATUS(port),
+				   QCA8K_PORT_STATUS_SPEED | QCA8K_PORT_STATUS_DUPLEX |
+				   QCA8K_PORT_STATUS_TXMAC | QCA8K_PORT_STATUS_RXMAC |
+				   QCA8K_PORT_STATUS_TXFLOW | QCA8K_PORT_STATUS_RXFLOW |
+				   QCA8K_MHT_PORT_STATUS_TX_HALF_FLOW |
+				   QCA8K_PORT_STATUS_LINK_AUTO | QCA8K_PORT_STATUS_FLOW_AUTO,
+				   QCA8K_PORT_STATUS_SPEED_1000 | QCA8K_PORT_STATUS_DUPLEX);
+		return;
+	}
+
 	/* Port 0 and 6 have no internal PHY */
 	if (port > 0 && port < 6)
 		mask |= QCA8K_PORT_STATUS_LINK_AUTO;
@@ -929,7 +944,8 @@ int qca8k_port_enable(struct dsa_switch
 {
 	struct qca8k_priv *priv = ds->priv;
 
-	qca8k_port_set_status(priv, port, 1);
+	if (!qca8k_is_qca8386(priv) || !dsa_is_user_port(ds, port))
+		qca8k_port_set_status(priv, port, 1);
 	priv->port_enabled_map |= BIT(port);
 
 	if (dsa_is_user_port(ds, port))
--- a/drivers/net/dsa/qca/qca8k.h
+++ b/drivers/net/dsa/qca/qca8k.h
@@ -151,6 +151,7 @@
 #define   QCA8K_PORT_STATUS_TXFLOW			BIT(4)
 #define   QCA8K_PORT_STATUS_RXFLOW			BIT(5)
 #define   QCA8K_PORT_STATUS_DUPLEX			BIT(6)
+#define   QCA8K_MHT_PORT_STATUS_TX_HALF_FLOW		BIT(7)
 #define   QCA8K_PORT_STATUS_LINK_UP			BIT(8)
 #define   QCA8K_PORT_STATUS_LINK_AUTO			BIT(9)
 #define   QCA8K_PORT_STATUS_LINK_PAUSE			BIT(10)
@@ -496,6 +497,11 @@ struct qca8k_priv {
 	struct qca8k_led ports_led[QCA8K_LED_COUNT];
 };
 
+static inline bool qca8k_is_qca8386(const struct qca8k_priv *priv)
+{
+	return priv->info && priv->info->id == QCA8K_ID_QCA8386;
+}
+
 struct qca8k_mib_desc {
 	unsigned int size;
 	unsigned int offset;
--- a/drivers/net/phy/qcom/qca808x.c
+++ b/drivers/net/phy/qcom/qca808x.c
@@ -1066,6 +1066,25 @@ static int qca8084_phy_package_config_in
 	return qca8084_package_clock_init(shared_priv);
 }
 
+static int qca8084_mac_clock_set(struct phy_device *phydev, unsigned long rate)
+{
+	struct qca808x_priv *priv = phydev->priv;
+	struct clk *clks[] = {
+		priv->mac_tx_clk, priv->mac_rx_clk,
+		priv->gephy_tx_clk, priv->gephy_rx_clk,
+	};
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(clks); i++) {
+		if (!clks[i])
+			continue;
+		ret = clk_set_rate(clks[i], rate);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
 static int qca8084_config_init(struct phy_device *phydev)
 {
 	int ret;
@@ -1076,6 +1095,14 @@ static int qca8084_config_init(struct ph
 			return ret;
 	}
 
+	/* Never-up ports also need the QSDK 1G idle MAC clocks. */
+	if (!phydev->link && of_property_read_bool(phy_package_get_node(phydev),
+						   "qcom,pcs1-sgmii-plus")) {
+		ret = qca8084_mac_clock_set(phydev, 125000000);
+		if (ret)
+			return ret;
+	}
+
 	if (phydev->interface == PHY_INTERFACE_MODE_10G_QXGMII)
 		__set_bit(PHY_INTERFACE_MODE_10G_QXGMII,
 			  phydev->possible_interfaces);
@@ -1110,16 +1137,9 @@ static int qca8084_config_init(struct ph
 
 static void qca8084_link_change_notify(struct phy_device *phydev)
 {
-	struct qca808x_priv *priv = phydev->priv;
 	struct qca808x_shared_priv *shared_priv;
-	struct clk *mac_clks[] = {
-		priv->mac_tx_clk,
-		priv->mac_rx_clk,
-		priv->gephy_tx_clk,
-		priv->gephy_rx_clk,
-	};
 	unsigned long rate;
-	int i, ret;
+	int ret;
 
 	if (phydev->link) {
 		switch (phydev->speed) {
@@ -1142,19 +1162,19 @@ static void qca8084_link_change_notify(s
 			return;
 		}
 
-		for (i = 0; i < ARRAY_SIZE(mac_clks); i++) {
-			if (!mac_clks[i])
-				continue;
-
-			ret = clk_set_rate(mac_clks[i], rate);
-			if (ret) {
-				phydev_err(phydev,
-					   "Setting switch MAC clock to %lu failed: %pe\n",
-					   rate, ERR_PTR(ret));
-				return;
-			}
-		}
+	} else if (of_property_read_bool(phy_package_get_node(phydev),
+					 "qcom,pcs1-sgmii-plus")) {
+		rate = 125000000;
+	} else {
+		goto reset_fifo;
+	}
+	ret = qca8084_mac_clock_set(phydev, rate);
+	if (ret) {
+		phydev_err(phydev, "Setting switch MAC clock to %lu failed: %pe\n",
+			   rate, ERR_PTR(ret));
+		return;
 	}
+reset_fifo:
 
 	/* Assert the FIFO between PHY and MAC. */
 	ret = phy_modify(phydev, QCA8084_FIFO_CONTROL,
