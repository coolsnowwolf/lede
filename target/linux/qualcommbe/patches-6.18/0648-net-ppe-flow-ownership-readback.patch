-/* Delete a flow by the index returned by its add operation. */
+/* Flow-index ownership is protected by the flowtable lock. */
+static void ppe_ft_flow_owner_clear(struct ppe_flowtable *ft,
+				    struct ppe_ft_flow *flow)
+{
+	if (flow->index >= 0 &&
+	    flow->index < ft->ppe_dev->variant->num_flow_entries &&
+	    ft->flow_owners[flow->index] == flow)
+		ft->flow_owners[flow->index] = NULL;
+}
+
+static void ppe_ft_flow_deps_put(struct ppe_flowtable *ft,
+				 struct ppe_ft_flow *flow)
+{
+	ppe_ft_host_put(ft, &flow->entry);
+	ppe_ft_nexthop_put(ft, flow->nexthop);
+	ppe_ft_my_mac_put(ft, flow->my_mac);
+	ppe_ft_my_mac_put(ft, flow->ingress_my_mac);
+	ppe_ft_pppoe_put(ft, flow->pppoe);
+	ppe_ft_vlan_put(ft, flow->vlan);
+	ppe_ft_pub_ip_put(ft, flow->pub_ip);
+	ppe_ft_tunnel_put(ft, flow->tunnel);
+	ppe_vp_put(ft->ppe_dev, flow->vp);
+	ppe_vp_put(ft->ppe_dev, flow->ivp);
+	if (flow->egress_dev) {
+		dev_put(flow->egress_dev);
+		flow->egress_dev = NULL;
+	}
+}
+
+/* Forget an object whose hardware row is known to be empty or owned by a
+ * different flow. Do not issue a delete-by-index here: that is precisely the
+ * operation which could remove the replacement row.
+ */
+static void ppe_ft_flow_forget(struct ppe_flowtable *ft,
+			       struct ppe_ft_flow *flow)
+{
+	if (list_empty(&flow->zombie_node)) {
+		rhashtable_remove_fast(&ft->flows, &flow->node, ppe_ft_params);
+		ppe_ft_flow_count_dec(ft, flow);
+		ppe_vp_flow_del(ft->ppe_dev, flow->ivp, &flow->vp_flow);
+	} else {
+		list_del_init(&flow->zombie_node);
+	}
+
+	ppe_ft_flow_owner_clear(ft, flow);
+	ppe_ft_flow_deps_put(ft, flow);
+	kfree_rcu(flow, rcu);
+}
+
+/* Delete only while the hardware row still matches this software owner. */
 static bool ppe_ft_flow_hw_del(struct ppe_flowtable *ft,
 			       struct ppe_ft_flow *flow)
 {
-	int ret = ppe_flow_entry_del(ft->ppe_dev, flow->index);
+	int ret;
+
+	if (flow->index < 0 ||
+	    flow->index >= ft->ppe_dev->variant->num_flow_entries ||
+	    ft->flow_owners[flow->index] != flow) {
+		atomic_long_inc(&ft->flow_stale_destroys);
+		return true;
+	}
 
-	if (!ret || ret == -ENOENT)
+	ret = ppe_flow_entry_matches(ft->ppe_dev, flow->index, &flow->entry);
+	if (ret == -ENOENT || ret == -ESTALE) {
+		atomic_long_inc(&ft->flow_stale_destroys);
+		ppe_ft_flow_owner_clear(ft, flow);
 		return true;
+	}
+	if (ret) {
+		atomic_long_inc(&ft->flow_readback_failures);
+		WARN_ONCE(1, "leaking a PPE flow after readback failure\n");
+		return false;
+	}
+
+	ret = ppe_flow_entry_del(ft->ppe_dev, flow->index);
+	if (!ret || ret == -ENOENT) {
+		ppe_ft_flow_owner_clear(ft, flow);
+		return true;
+	}
+
 	WARN_ONCE(1, "leaking the resources of an undeletable PPE flow\n");
 	return false;
 }
