+	if (ret)
+		return ret;
+
+	memcpy(new, old, sizeof(new));
+	PPE_MRU_MTU_CTRL_SET_MRU(new, mtu + ETH_HLEN);
+	PPE_MRU_MTU_CTRL_SET_MTU(new, mtu + ETH_HLEN);
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, new, ARRAY_SIZE(new));
+	if (ret)
+		regmap_bulk_write(ppe_dev->regmap, reg, old, ARRAY_SIZE(old));
+
+	return ret;
+}
+
+static int ppe_vp_qca4b_info(struct ppe_device *ppe_dev,
+			     struct net_device *dev, struct dsa_port **dpp,
+			     int *physical_port)
+{
+	struct edma_port_priv *port_priv;
+	struct net_device *conduit;
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return -EOPNOTSUPP;
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR(dp))
+		return PTR_ERR(dp);
+	if (!dp->cpu_dp || !dp->cpu_dp->tag_ops ||
+	    dp->cpu_dp->tag_ops->proto != DSA_TAG_PROTO_QCA_4B)
+		return -EOPNOTSUPP;
+
+	conduit = dsa_port_to_conduit(dp);
+	if (!conduit || !edma_port_dev_check(conduit))
+		return -EOPNOTSUPP;
+
+	port_priv = netdev_priv(conduit);
+	if (!port_priv->ppe_port || port_priv->ppe_port->ppe_dev != ppe_dev)
+		return -ENODEV;
+	if (dp->index >= 128 || port_priv->ppe_port->port_id < 0 ||
+	    port_priv->ppe_port->port_id >= PPE_PORT_ID_COUNT)
+		return -ERANGE;
+
+	if (dpp)
+		*dpp = dp;
+	if (physical_port)
+		*physical_port = port_priv->ppe_port->port_id;
+
+	return 0;
+}
+
+static int ppe_vp_athtag_add(struct ppe_vp *vp, struct ppe_vp_slot *slot)
+{
+	struct ppe_device *ppe_dev = vp->ppe_dev;
+	u32 eg_gen_old, eg_gen_new, eg_vp_new[3];
+	u32 physical_old, physical_new;
+	u32 switch_old = 0, switch_new;
+	u32 value, verify[3];
+	u32 eg_vp_reg, physical_reg, switch_reg;
+	bool first_eg, first_rx;
+	int ret;
+
+	first_eg = !vp->athtag_users;
+	first_rx = !vp->athtag_rx_users[slot->physical_port];
+	eg_vp_reg = PPE_ATHTAG_EG_VP_TBL_ADDR +
+		    PPE_ATHTAG_EG_VP_TBL_INC * slot->vp;
+	physical_reg = PPE_ATHTAG_PRX_PORT_TO_VP_ADDR +
+		       PPE_ATHTAG_PRX_PORT_TO_VP_INC * slot->physical_port;
+	switch_reg = PPE_ATHTAG_PRX_PORT_TO_VP_ADDR +
+		     PPE_ATHTAG_PRX_PORT_TO_VP_INC * slot->switch_port;
+
+	ret = regmap_read(ppe_dev->regmap, PPE_ATHTAG_EG_GEN_CTRL_ADDR,
+			  &eg_gen_old);
+	if (ret)
+		return ret;
+	ret = regmap_read(ppe_dev->regmap, physical_reg, &physical_old);
+	if (ret)
+		return ret;
+	if (switch_reg != physical_reg) {
+		ret = regmap_read(ppe_dev->regmap, switch_reg, &switch_old);
+		if (ret)
+			return ret;
+	} else {
+		switch_old = physical_old;
+	}
+	ret = regmap_bulk_read(ppe_dev->regmap, eg_vp_reg,
+			       slot->athtag_orig_eg_vp,
+			       ARRAY_SIZE(slot->athtag_orig_eg_vp));
+	if (ret)
+		return ret;
+
+	if (first_eg)
+		vp->athtag_orig_eg_gen = eg_gen_old;
+	if (first_rx)
+		vp->athtag_orig_rx[slot->physical_port] = physical_old;
+	slot->athtag_orig_prx = switch_old;
+
+	eg_gen_new = (eg_gen_old & ~PPE_ATHTAG_EG_GEN_CTRL_TYPE) |
+		     FIELD_PREP(PPE_ATHTAG_EG_GEN_CTRL_TYPE,
+				PPE_ATHTAG_TYPE);
+	physical_new = (physical_old &
+			~(PPE_ATHTAG_PRX_PORT_TO_VP_TYPE |
+			  PPE_ATHTAG_PRX_PORT_TO_VP_ENABLE)) |
+		       FIELD_PREP(PPE_ATHTAG_PRX_PORT_TO_VP_TYPE,
+				  PPE_ATHTAG_TYPE) |
+		       PPE_ATHTAG_PRX_PORT_TO_VP_ENABLE;
+	switch_new = (switch_old & ~PPE_ATHTAG_PRX_PORT_TO_VP_PORT) |
+		     FIELD_PREP(PPE_ATHTAG_PRX_PORT_TO_VP_PORT, slot->vp);
+	if (switch_reg == physical_reg)
+		physical_new = (physical_new &
+				~PPE_ATHTAG_PRX_PORT_TO_VP_PORT) |
+			       FIELD_PREP(PPE_ATHTAG_PRX_PORT_TO_VP_PORT,
+					  slot->vp);
+
+	memcpy(eg_vp_new, slot->athtag_orig_eg_vp, sizeof(eg_vp_new));
+	eg_vp_new[1] &= ~(PPE_ATHTAG_EG_VP_ATH_VERSION |
+			    PPE_ATHTAG_EG_VP_ATH_DEFAULT |
+			    PPE_ATHTAG_EG_VP_ATH_BITMAP);
+	eg_vp_new[1] |= PPE_ATHTAG_EG_VP_ATH_INSERT |
+			 FIELD_PREP(PPE_ATHTAG_EG_VP_ATH_VERSION, 3) |
+			 FIELD_PREP(PPE_ATHTAG_EG_VP_ATH_DEFAULT, 0) |
+			 FIELD_PREP(PPE_ATHTAG_EG_VP_ATH_BITMAP,
+				    slot->switch_port & 0x3f);
+	eg_vp_new[2] &= ~(PPE_ATHTAG_EG_VP_ATH_BITMAP_HI |
+			    PPE_ATHTAG_EG_VP_ATH_DISABLE_BIT);
+	if (slot->switch_port & BIT(6))
+		eg_vp_new[2] |= PPE_ATHTAG_EG_VP_ATH_BITMAP_HI;
+	eg_vp_new[2] |= PPE_ATHTAG_EG_VP_ATH_FROM_CPU;
+
+	ret = regmap_write(ppe_dev->regmap, PPE_ATHTAG_EG_GEN_CTRL_ADDR,
+			   eg_gen_new);
+	if (ret)
+		goto rollback;
+	ret = regmap_write(ppe_dev->regmap, physical_reg, physical_new);
+	if (ret)
+		goto rollback;
+	if (switch_reg != physical_reg) {
+		ret = regmap_write(ppe_dev->regmap, switch_reg, switch_new);
+		if (ret)
+			goto rollback;
+	}
+	ret = regmap_bulk_write(ppe_dev->regmap, eg_vp_reg, eg_vp_new,
+				ARRAY_SIZE(eg_vp_new));
+	if (ret)
+		goto rollback;
+
+	ret = regmap_read(ppe_dev->regmap, PPE_ATHTAG_EG_GEN_CTRL_ADDR,
+			  &value);
+	if (ret || FIELD_GET(PPE_ATHTAG_EG_GEN_CTRL_TYPE, value) !=
+		   PPE_ATHTAG_TYPE) {
+		if (!ret)
+			ret = -EIO;
+		goto rollback;
+	}
+	ret = regmap_read(ppe_dev->regmap, physical_reg, &value);
+	if (ret || (value & (PPE_ATHTAG_PRX_PORT_TO_VP_TYPE |
+			     PPE_ATHTAG_PRX_PORT_TO_VP_ENABLE)) !=
+		  (physical_new & (PPE_ATHTAG_PRX_PORT_TO_VP_TYPE |
+				   PPE_ATHTAG_PRX_PORT_TO_VP_ENABLE))) {
+		if (!ret)
+			ret = -EIO;
+		goto rollback;
+	}
+	ret = regmap_read(ppe_dev->regmap, switch_reg, &value);
+	if (ret || FIELD_GET(PPE_ATHTAG_PRX_PORT_TO_VP_PORT, value) !=
+		   slot->vp) {
+		if (!ret)
+			ret = -EIO;
+		goto rollback;
+	}
+	ret = regmap_bulk_read(ppe_dev->regmap, eg_vp_reg, verify,
+			       ARRAY_SIZE(verify));
+	if (ret || memcmp(verify, eg_vp_new, sizeof(verify))) {
+		if (!ret)
+			ret = -EIO;
+		goto rollback;
+	}
+
+	vp->athtag_users++;
+	vp->athtag_rx_users[slot->physical_port]++;
+	slot->athtag_active = true;
+	return 0;
+
+rollback:
+	regmap_bulk_write(ppe_dev->regmap, eg_vp_reg,
+			  slot->athtag_orig_eg_vp,
+			  ARRAY_SIZE(slot->athtag_orig_eg_vp));
+	if (switch_reg != physical_reg)
+		regmap_write(ppe_dev->regmap, switch_reg, switch_old);
+	regmap_write(ppe_dev->regmap, physical_reg, physical_old);
+	regmap_write(ppe_dev->regmap, PPE_ATHTAG_EG_GEN_CTRL_ADDR,
+		     eg_gen_old);
+	return ret;
+}
+
+static int ppe_vp_athtag_del(struct ppe_vp *vp, struct ppe_vp_slot *slot)
+{
+	struct ppe_device *ppe_dev = vp->ppe_dev;
+	u32 physical_restore, physical_reg, switch_reg, eg_vp_reg;
+	int ret = 0, err;
+
+	if (!slot->athtag_active)
+		return 0;
+
+	eg_vp_reg = PPE_ATHTAG_EG_VP_TBL_ADDR +
+		    PPE_ATHTAG_EG_VP_TBL_INC * slot->vp;
+	physical_reg = PPE_ATHTAG_PRX_PORT_TO_VP_ADDR +
+		       PPE_ATHTAG_PRX_PORT_TO_VP_INC * slot->physical_port;
+	switch_reg = PPE_ATHTAG_PRX_PORT_TO_VP_ADDR +
+		     PPE_ATHTAG_PRX_PORT_TO_VP_INC * slot->switch_port;
+
+	err = regmap_bulk_write(ppe_dev->regmap, eg_vp_reg,
+				slot->athtag_orig_eg_vp,
+				ARRAY_SIZE(slot->athtag_orig_eg_vp));
+	if (!ret)
+		ret = err;
+
+	if (switch_reg != physical_reg) {
+		err = regmap_write(ppe_dev->regmap, switch_reg,
+				   slot->athtag_orig_prx);
+		if (!ret)
+			ret = err;
+	}
+
+	if (WARN_ON_ONCE(!vp->athtag_rx_users[slot->physical_port]))
+		goto restore_global;
+	vp->athtag_rx_users[slot->physical_port]--;
+	if (!vp->athtag_rx_users[slot->physical_port]) {
+		physical_restore = vp->athtag_orig_rx[slot->physical_port];
+	} else if (switch_reg == physical_reg) {
+		physical_restore =
+			(slot->athtag_orig_prx &
+			 ~(PPE_ATHTAG_PRX_PORT_TO_VP_TYPE |
+			   PPE_ATHTAG_PRX_PORT_TO_VP_ENABLE)) |
+			 FIELD_PREP(PPE_ATHTAG_PRX_PORT_TO_VP_TYPE,
+				    PPE_ATHTAG_TYPE) |
+			 PPE_ATHTAG_PRX_PORT_TO_VP_ENABLE;
+	} else {
+		physical_restore = 0;
+	}
+	if (!vp->athtag_rx_users[slot->physical_port] ||
+	    switch_reg == physical_reg) {
+		err = regmap_write(ppe_dev->regmap, physical_reg,
+				   physical_restore);
+		if (!ret)
+			ret = err;
+	}
+
+restore_global:
+	if (WARN_ON_ONCE(!vp->athtag_users))
+		goto out;
+	vp->athtag_users--;
+	if (!vp->athtag_users) {
+		err = regmap_write(ppe_dev->regmap,
+				   PPE_ATHTAG_EG_GEN_CTRL_ADDR,
+				   vp->athtag_orig_eg_gen);
+		if (!ret)
+			ret = err;
+	}
+out:
+	slot->athtag_active = false;
+	return ret;
 }
 
