@@ -912,6 +943,14 @@ static int ppe_athtag_show(struct seq_fi
 		ppe_athtag_dump_vp(seq, ppe_dev, vp, &tx_enabled);
 	for (vp = PPE_VP_PORT_BASE; vp < PPE_VP_PORT_BASE + 8; vp++)
