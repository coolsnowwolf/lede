+					  PPE_ATHTAG_EG_VP_TBL_INC * slot->vp,
+					  eg_vp, ARRAY_SIZE(eg_vp));
+		seq_printf(seq,
+			   "qca4b_slot=%d dev=%s vp=%d switch_port=%u physical_port=%u refs=%d carrier=%u mapping=%u poisoned=%u prx_ret=%d prx=%08x eg_ret=%d eg=%08x:%08x:%08x\n",
+			   i, dev ? dev->name : "<unregistered>", slot->vp,
+			   slot->switch_port, slot->physical_port, slot->refcnt,
+			   dev ? netif_carrier_ok(dev) : 0, slot->athtag_active,
+			   slot->poisoned, prx_ret, prx, eg_ret,
+			   eg_vp[2], eg_vp[1], eg_vp[0]);
+	}
+	mutex_unlock(&vp->lock);
+}
