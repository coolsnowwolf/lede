+	int ret;
+
+	ret = ppe_pkt_cnt_get(ppe_dev,
+			      PPE_PORT_RX_CNT_TBL_ADDR +
+			      PPE_PORT_RX_CNT_TBL_INC * vp,
+			      PPE_PKT_CNT_SIZE_5WORD, &rx, &rx_drop);
+	if (ret)
+		return ret;
+	ret = ppe_pkt_cnt_get(ppe_dev,
+			      PPE_VPORT_TX_COUNTER_TBL_ADDR +
+			      PPE_VPORT_TX_COUNTER_TBL_INC * vp,
+			      PPE_PKT_CNT_SIZE_3WORD, &tx, NULL);
+	if (ret)
+		return ret;
+	ret = ppe_pkt_cnt_get(ppe_dev,
+			      PPE_VPORT_TX_DROP_CNT_TBL_ADDR +
+			      PPE_VPORT_TX_DROP_CNT_TBL_INC * vp,
+			      PPE_PKT_CNT_SIZE_3WORD, &tx_drop, NULL);
+	if (ret)
+		return ret;
+
+	seq_printf(seq,
+		   "vp_stats[%d] rx_packets=%u rx_drop=%u tx_packets=%u tx_drop=%u\n",
+		   vp, rx, rx_drop, tx, tx_drop);
+	return 0;
+}
