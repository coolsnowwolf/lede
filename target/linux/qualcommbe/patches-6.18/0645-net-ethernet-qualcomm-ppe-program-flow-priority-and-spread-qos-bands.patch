 #define PPE_QUEUE_INTER_PRI_NUM			16
 #define PPE_QUEUE_HASH_NUM			256
 
+/* Four RSS buckets make up each user-port QoS band. */
+#define PPE_FLOW_SPREAD_QUEUES			4
