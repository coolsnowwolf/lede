+static int ppe_qos_bands_show(struct seq_file *seq, void *v)
+{
+	struct ppe_device *ppe_dev = seq->private;
+	struct ppe_scheduler_cfg scheduler;
+	u32 mru_mtu[3], reg, val;
+	int band, bucket, flow, flow_end, hw_port;
+	int port, pri, queue, queue_end, ret;
+
+	seq_puts(seq, "flow_qos_mapping=per-flow-index\n");
+
+	for (port = 1; port < ppe_dev->num_ports; port++) {
+		ret = ppe_port_resource_get(ppe_dev, port, PPE_RES_UCAST,
+					    &queue, &queue_end);
+		if (ret)
+			return ret;
+		ret = ppe_port_resource_get(ppe_dev, port, PPE_RES_FLOW_ID,
+					    &flow, &flow_end);
+		if (ret || flow + 1 > flow_end)
+			return ret ? ret : -EINVAL;
+
+		reg = PPE_MRU_MTU_CTRL_TBL_ADDR +
+		      PPE_MRU_MTU_CTRL_TBL_INC * port;
+		ret = regmap_bulk_read(ppe_dev->regmap, reg, mru_mtu,
+				       ARRAY_SIZE(mru_mtu));
+		if (ret)
+			return ret;
+		seq_printf(seq,
+			   "port %d queues %d-%d precedence flow:%lu preheader:%lu pre_acl:%lu post_acl:%lu dscp:%lu pcp:%lu pri",
+			   port, queue, queue_end,
+			   FIELD_GET(PPE_MRU_MTU_CTRL_W1_FLOW_PREC, mru_mtu[1]),
+			   FIELD_GET(PPE_MRU_MTU_CTRL_W1_PREHEADER_PREC,
+				     mru_mtu[1]),
+			   FIELD_GET(PPE_MRU_MTU_CTRL_W1_PRE_ACL_PREC,
+				     mru_mtu[1]),
+			   FIELD_GET(PPE_MRU_MTU_CTRL_W1_POST_ACL_PREC,
+				     mru_mtu[1]),
+			   FIELD_GET(PPE_MRU_MTU_CTRL_W1_DSCP_PREC, mru_mtu[1]),
+			   FIELD_GET(PPE_MRU_MTU_CTRL_W1_PCP_PREC, mru_mtu[1]));
+
+		for (pri = 0; pri < PPE_QUEUE_INTER_PRI_NUM; pri += 4) {
+			reg = PPE_UCAST_PRIORITY_MAP_TBL_ADDR +
+			      PPE_UCAST_PRIORITY_MAP_TBL_INC *
+			      (port * PPE_QUEUE_INTER_PRI_NUM + pri);
+			ret = regmap_read(ppe_dev->regmap, reg, &val);
+			if (ret)
+				return ret;
+			seq_printf(seq, " %d:%lu", pri,
+				   FIELD_GET(PPE_UCAST_PRIORITY_MAP_TBL_CLASS,
+					     val));
+		}
+
+		seq_puts(seq, " hash");
+		for (bucket = 0; bucket < 2 * PPE_FLOW_SPREAD_QUEUES;
+		     bucket++) {
+			reg = PPE_UCAST_HASH_MAP_TBL_ADDR +
+			      PPE_UCAST_HASH_MAP_TBL_INC *
+			      (port * PPE_QUEUE_HASH_NUM + bucket);
+			ret = regmap_read(ppe_dev->regmap, reg, &val);
+			if (ret)
+				return ret;
+			seq_printf(seq, " %d:%lu", bucket,
+				   FIELD_GET(PPE_UCAST_HASH_MAP_TBL_HASH, val));
+		}
+		seq_putc(seq, '\n');
+
+		for (bucket = 0; bucket < 2; bucket++) {
+			ret = ppe_queue_scheduler_get(ppe_dev, flow + bucket, true,
+						      &hw_port, &scheduler);
+			if (ret)
+				return ret;
+			seq_printf(seq,
+				   "  l1 flow %d port %d parent %d pri %d drr %d weight %d\n",
+				   flow + bucket, hw_port, scheduler.flow_id,
+				   scheduler.pri, scheduler.drr_node_id,
+				   scheduler.drr_node_wt);
+		}
+
+		for (band = 0; band < 3; band++) {
+			for (bucket = 0; bucket < PPE_FLOW_SPREAD_QUEUES;
+			     bucket++) {
+				pri = queue + band * PPE_FLOW_SPREAD_QUEUES +
+				      bucket;
+				ret = ppe_queue_scheduler_get(ppe_dev, pri, false,
+							      &hw_port,
+							      &scheduler);
+				if (ret)
+					return ret;
+				seq_printf(seq,
+					   "  band %d bucket %d queue %d port %d flow %d pri %d drr %d weight %d\n",
+					   band, bucket, pri, hw_port,
+					   scheduler.flow_id, scheduler.pri,
+					   scheduler.drr_node_id,
+					   scheduler.drr_node_wt);
+			}
+		}
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ppe_qos_bands);
