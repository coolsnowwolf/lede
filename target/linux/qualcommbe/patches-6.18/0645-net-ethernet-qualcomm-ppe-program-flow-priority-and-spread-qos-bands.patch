+static int ppe_flow_qos_init(struct ppe_device *ppe_dev)
+{
+	u32 mru_mtu[3], reg;
+	int i, ret;
+
+	/* APPE/MPPE keeps classifier precedence in words 1 and 2 of each
+	 * MRU/MTU port row. A flow rule is the most explicit classifier; keep
+	 * preheader, pre-ACL, DSCP and PCP as progressively weaker fallbacks.
+	 */
+	for (i = 0; i < ppe_dev->num_ports; i++) {
+		reg = PPE_MRU_MTU_CTRL_TBL_ADDR +
+		      PPE_MRU_MTU_CTRL_TBL_INC * i;
+		ret = regmap_bulk_read(ppe_dev->regmap, reg, mru_mtu,
+				       ARRAY_SIZE(mru_mtu));
+		if (ret)
+			return ret;
+
+		mru_mtu[1] &= ~(PPE_MRU_MTU_CTRL_W1_PCP_PREC_FORCE |
+				  PPE_MRU_MTU_CTRL_W1_DSCP_PREC_FORCE |
+				  PPE_MRU_MTU_CTRL_W1_PREHEADER_PREC |
+				  PPE_MRU_MTU_CTRL_W1_PCP_PREC |
+				  PPE_MRU_MTU_CTRL_W1_DSCP_PREC |
+				  PPE_MRU_MTU_CTRL_W1_FLOW_PREC |
+				  PPE_MRU_MTU_CTRL_W1_PRE_ACL_PREC |
+				  PPE_MRU_MTU_CTRL_W1_POST_ACL_PREC);
+		mru_mtu[1] |= FIELD_PREP(PPE_MRU_MTU_CTRL_W1_FLOW_PREC, 4) |
+				  FIELD_PREP(PPE_MRU_MTU_CTRL_W1_PREHEADER_PREC, 3) |
+				  FIELD_PREP(PPE_MRU_MTU_CTRL_W1_PRE_ACL_PREC, 2) |
+				  FIELD_PREP(PPE_MRU_MTU_CTRL_W1_DSCP_PREC, 1);
+
+		ret = regmap_bulk_write(ppe_dev->regmap, reg, mru_mtu,
+					ARRAY_SIZE(mru_mtu));
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
