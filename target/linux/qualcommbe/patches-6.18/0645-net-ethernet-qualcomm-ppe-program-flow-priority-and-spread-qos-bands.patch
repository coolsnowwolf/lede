+static void ppe_tbf_queues_rollback(struct ppe_port *port, int queue_base,
+				    const u32 (*cfg)[PPE_TBF_QUEUE_CFG_WORDS],
+				    int count)
+{
+	struct ppe_device *ppe_dev = port->ppe_dev;
+	int i, ret;
+
+	for (i = 0; i < count; i++) {
+		ret = ppe_tbf_queue_write(ppe_dev, queue_base + i, cfg[i]);
+		if (!ret)
+			continue;
+
+		port->tbf.rollback_failures++;
+		dev_err(ppe_dev->dev,
+			"port %d failed to roll back TBF queue %d: %d\n",
+			port->port_id, queue_base + i, ret);
