+/* Change only the destination queue; the port remains valid for installed
+ * routed flows while a Direct Switch client switches to/from CPU delivery.
+ */
+int ppe_vp_queue_set(struct ppe_device *ppe_dev, int port, int queue, int profile)
+{
+	struct ppe_queue_ucast_dest dest = { .dest_port = port };
+	struct ppe_vp *vp = ppe_dev->vp;
+	int i = port - PPE_VP_PORT_BASE, ret;
+
+	if (!vp || i < 0 || i >= PPE_VP_SLOTS)
+		return -EINVAL;
+	mutex_lock(&vp->lock);
+	if (vp->slots[i].poisoned) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	/* NETDEV_UNREGISTER already disabled an unpoisoned empty port. */
+	if (!rcu_access_pointer(vp->slots[i].dev)) {
+		ret = queue < 0 ? 0 : -ENODEV;
+		goto unlock;
+	}
+	if (queue < 0) {
+		int end;
+
+		ret = ppe_port_resource_get(ppe_dev, PPE_VP_CPU_PORT,
+					    PPE_RES_UCAST, &queue, &end);
+		if (ret)
+			goto unlock;
+		profile = EDMA_CPU_PORT_PROFILE_ID;
+	}
+	ret = ppe_queue_ucast_base_set(ppe_dev, dest, queue, profile);
+unlock:
+	mutex_unlock(&vp->lock);
+	return ret;
+}
