+++ b/include/linux/soc/qcom/ppe-ds.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_SOC_QCOM_PPE_DS_H
+#define _LINUX_SOC_QCOM_PPE_DS_H
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/types.h>
+
+struct qcom_ppe_ds;
+struct net_device;
+
+/* Buffer addresses must be mapped bidirectionally in the shared DMA domain.
+ * The WLAN owns buffers and cookies until both DMA engines have stopped.
+ */
+struct qcom_ppe_ds_buffer {
+	dma_addr_t addr;
+	u64 cookie;
+};
+
+/* Indices are descriptor indices, not WLAN SRNG word offsets. Callbacks run
+ * in atomic context and must not call back into this API or sleep.
+ */
+struct qcom_ppe_ds_ops {
+	int (*set_start_indices)(void *priv, u16 tcl_index, u16 reo_index);
+	u16 (*get_tcl_cons)(void *priv);
+	void (*set_tcl_prod)(void *priv, u16 index);
+	u16 (*get_reo_prod)(void *priv);
+	void (*set_reo_cons)(void *priv, u16 index);
+	unsigned int (*refill)(void *priv, struct qcom_ppe_ds_buffer *buffers,
+			       unsigned int count, unsigned int size);
+	void (*release)(void *priv, const u64 *cookies, unsigned int count);
+	void (*fault)(void *priv);
+};
+
+struct qcom_ppe_ds_config {
+	struct device *wlan_dev;
+	const struct qcom_ppe_ds_ops *ops;
+	void *priv;
+	dma_addr_t ppe2tcl;
+	dma_addr_t reo2ppe;
+	u16 ppe2tcl_count;
+	u16 reo2ppe_count;
+	u16 buffer_size;
+};
+
+/* Register/stop/unregister run in process context. Shared primary rings
+ * remain WLAN-owned. Registration never starts DMA. WLAN must disable peer
+ * routing before stop, and stop its own DMA before unregister/freeing rings.
+ * On a stop failure retain the handle, callbacks, rings and buffer mappings;
+ * a hardware reset is required before those resources can be reclaimed.
+ */
+struct qcom_ppe_ds *qcom_ppe_ds_register(const struct qcom_ppe_ds_config *cfg);
+/* Probe the supported transport in process context before allocating WLAN
+ * rings. Availability never starts DMA; register validates and pins it.
+ */
+bool qcom_ppe_ds_available(void);
+int qcom_ppe_ds_start(struct qcom_ppe_ds *ds);
+int qcom_ppe_ds_stop(struct qcom_ppe_ds *ds);
+int qcom_ppe_ds_unregister(struct qcom_ppe_ds *ds);
+void qcom_ppe_ds_sync(struct qcom_ppe_ds *ds);
+/* Notify after publishing returned WLAN TX buffers, outside client locks
+ * and transport callbacks. Only a stalled refill is scheduled; DMA and
+ * descriptor ownership remain unchanged. The registered handle stays live.
+ */
+void qcom_ppe_ds_refill_ready(struct qcom_ppe_ds *ds);
+u16 qcom_ppe_ds_queue(struct qcom_ppe_ds *ds);
+/* Hold a VP reference while WLAN has a matching transmit-table entry.
+ * Allocation initially delivers to the CPU. Route to DS only after the
+ * WLAN table is ready; restore CPU delivery before removing that table.
+ */
+int qcom_ppe_ds_vp_alloc(struct qcom_ppe_ds *ds, struct net_device *dev);
+int qcom_ppe_ds_vp_route(struct qcom_ppe_ds *ds, int vp, bool direct);
+int qcom_ppe_ds_vp_free(struct qcom_ppe_ds *ds, int vp);
+
+#endif
