+static struct sk_buff *edma_tx_map_unmap(struct device *dev,
+					 struct edma_tx_map *map)
+{
+	struct sk_buff *skb = map->skb;
+
+	switch (map->type) {
+	case EDMA_TX_MAP_SINGLE:
+		dma_unmap_single(dev, map->dma, map->len, DMA_TO_DEVICE);
+		break;
+	case EDMA_TX_MAP_PAGE:
+		dma_unmap_page(dev, map->dma, map->len, DMA_TO_DEVICE);
+		break;
+	case EDMA_TX_MAP_NONE:
+		break;
+	default:
+		WARN_ON_ONCE(map->type > EDMA_TX_MAP_PAGE);
+		break;
+	}
+
+	memset(map, 0, sizeof(*map));
+	return skb;
+}
+
+static bool edma_tx_map_valid(struct edma_txdesc_ring *ring,
+			      struct edma_tx_map *map)
+{
+	uintptr_t addr = (uintptr_t)map;
+	uintptr_t base = (uintptr_t)ring->maps;
+	uintptr_t end = base + sizeof(*map) * ring->count;
+
+	return addr >= base && addr < end &&
+	       !((addr - base) % sizeof(*map)) &&
+	       (map->type == EDMA_TX_MAP_SINGLE ||
+		map->type == EDMA_TX_MAP_PAGE);
+}
+
+void edma_tx_desc_ring_cleanup(struct edma_txdesc_ring *txdesc_ring)
+{
+	struct device *dev = edma_ctx->ppe_dev->dev;
+	u32 i;
+
+	if (!txdesc_ring->maps)
+		return;
+
+	for (i = 0; i < txdesc_ring->count; i++) {
+		struct sk_buff *skb;
+
+		skb = edma_tx_map_unmap(dev, &txdesc_ring->maps[i]);
+		dev_kfree_skb_any(skb);
+	}
+}
