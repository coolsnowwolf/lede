From: ViKing <viking.yfy@qq.com>
Date: Wed, 28 Oct 2026 13:34:14 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: honor the RPS core bitmap

Use the requested CPU mask, restricted to configured RX rings and
possible CPUs, instead of the constant default. Serialize updates,
parse into a temporary value and restore the old hardware map on a
partial programming failure. Keep the DS queue profile unchanged.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
@@ -9,6 +9,7 @@
 #include <linux/cpumask.h>
 #include <linux/dma-mapping.h>
 #include <linux/kernel.h>
+#include <linux/mutex.h>
 #include <linux/netdevice.h>
 #include <linux/printk.h>
 #include <linux/regmap.h>
@@ -1005,59 +1006,85 @@ void edma_cfg_rx_napi_add(void)
  *
  * Initialize and configure RPS hash map for queues
  */
-int edma_cfg_rx_rps_hash_map(void)
+static DEFINE_MUTEX(edma_rps_lock);
+
+static u32 edma_rps_valid_mask(void)
 {
-	cpumask_t edma_rps_cpumask = {{EDMA_RX_DEFAULT_BITMAP}};
-	int map_len = 0, idx = 0, ret = 0;
-	u32 q_off = EDMA_RX_QUEUE_START;
-	u32 q_map[EDMA_MAX_CORE] = {0};
-	u32 hash, cpu;
-
-	/* Map all possible hash values to queues used by the EDMA Rx
-	 * rings based on a bitmask, which represents the cores to be mapped.
-	 * These queues are expected to be mapped to different Rx rings
-	 * which are assigned to different cores using IRQ affinity configuration.
-	 */
-	for_each_cpu(cpu, &edma_rps_cpumask) {
-		q_map[map_len] = q_off + (cpu * EDMA_MAX_PRI_PER_CORE);
-		map_len++;
-	}
+	u32 mask = 0;
+	int cpu;
 
+	for_each_possible_cpu(cpu)
+		if (cpu < EDMA_MAX_CORE && cpu < edma_ctx->hw_info->rx->num_rings)
+			mask |= BIT(cpu);
+	return mask;
+}
+
+/* Only profile zero's 256 CPU hash entries are changed here. DS uses its
+ * own profile and queue range; never alter ring backpressure mappings.
+ */
+static int edma_rps_map(u32 bitmap)
+{
+	u32 q_map[EDMA_MAX_CORE];
+	int cpu, len = 0, hash, ret;
+
+	if (!bitmap || bitmap & ~edma_rps_valid_mask())
+		return -EINVAL;
+	for (cpu = 0; cpu < EDMA_MAX_CORE; cpu++)
+		if (bitmap & BIT(cpu))
+			q_map[len++] = EDMA_RX_QUEUE_START + cpu * EDMA_MAX_PRI_PER_CORE;
 	for (hash = 0; hash < PPE_QUEUE_HASH_NUM; hash++) {
 		ret = ppe_edma_queue_offset_config(edma_ctx->ppe_dev,
-						   PPE_QUEUE_OFFSET_BY_HASH, hash, q_map[idx]);
+						   PPE_QUEUE_OFFSET_BY_HASH,
+						   hash, q_map[hash % len]);
 		if (ret)
 			return ret;
-
-		pr_debug("profile_id: %u, hash: %u, q_off: %u\n",
-			 EDMA_CPU_PORT_PROFILE_ID, hash, q_map[idx]);
-		idx = (idx + 1) % map_len;
 	}
-
 	return 0;
 }
 
-/* Configure RPS hash mapping based on bitmap */
-int edma_cfg_rx_rps_bitmap(const struct ctl_table *table, int write,
-			   void *buffer, size_t *lenp, loff_t *ppos)
+int edma_cfg_rx_rps_hash_map(void)
 {
+	u32 bitmap;
 	int ret;
 
-	ret = proc_dointvec(table, write, buffer, lenp, ppos);
-
-	if (!write)
-		return ret;
+	mutex_lock(&edma_rps_lock);
+	bitmap = edma_cfg_rx_rps_bitmap_cores & edma_rps_valid_mask();
+	if (!bitmap)
+		bitmap = edma_rps_valid_mask();
+	ret = edma_rps_map(bitmap);
+	if (!ret)
+		edma_cfg_rx_rps_bitmap_cores = bitmap;
+	mutex_unlock(&edma_rps_lock);
+	return ret;
+}
 
-	if (!edma_cfg_rx_rps_bitmap_cores ||
-	    edma_cfg_rx_rps_bitmap_cores > EDMA_RX_DEFAULT_BITMAP) {
-		pr_warn("Incorrect CPU bitmap: %x. Setting it to default value: %d",
-			edma_cfg_rx_rps_bitmap_cores, EDMA_RX_DEFAULT_BITMAP);
-		edma_cfg_rx_rps_bitmap_cores = EDMA_RX_DEFAULT_BITMAP;
+int edma_cfg_rx_rps_bitmap(const struct ctl_table *table, int write,
+			   void *buffer, size_t *lenp, loff_t *ppos)
+{
+	int bitmap, old, ret;
+	const struct ctl_table tmp = {
+		.data = &bitmap,
+		.maxlen = table->maxlen,
+	};
+
+	mutex_lock(&edma_rps_lock);
+	old = edma_cfg_rx_rps_bitmap_cores;
+	bitmap = old;
+	ret = proc_dointvec(&tmp, write, buffer, lenp, ppos);
+	if (ret || !write)
+		goto unlock;
+	if (bitmap <= 0 || bitmap & ~edma_rps_valid_mask()) {
+		ret = -EINVAL;
+		goto unlock;
 	}
-
-	ret = edma_cfg_rx_rps_hash_map();
-
-	pr_info("EDMA RPS bitmap value: %d\n", edma_cfg_rx_rps_bitmap_cores);
-
+	ret = edma_rps_map(bitmap);
+	if (ret) {
+		if (edma_rps_map(old))
+			pr_err_ratelimited("EDMA RPS mapping rollback failed\n");
+		goto unlock;
+	}
+	edma_cfg_rx_rps_bitmap_cores = bitmap;
+unlock:
+	mutex_unlock(&edma_rps_lock);
 	return ret;
 }
