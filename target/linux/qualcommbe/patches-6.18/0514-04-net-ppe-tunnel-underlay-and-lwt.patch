+static bool ppe_ft_lwt_encap(const struct flow_action_entry *act,
+			     struct in6_addr *local,
+			     struct in6_addr *remote, u8 *hop_limit)
+{
+	const struct ip_tunnel_info *info = act->tunnel;
+
+	if (act->tunnel_type != LWTUNNEL_ENCAP_IP6 || !info ||
+	    (info->mode & (IP_TUNNEL_INFO_TX | IP_TUNNEL_INFO_IPV6 |
+			   IP_TUNNEL_INFO_BRIDGE)) !=
+	    (IP_TUNNEL_INFO_TX | IP_TUNNEL_INFO_IPV6) ||
+	    info->options_len || info->key.tun_id ||
+	    !ip_tunnel_flags_empty(info->key.tun_flags) ||
+	    info->key.tp_src || info->key.tp_dst ||
+	    ipv6_addr_any(&info->key.u.ipv6.src) ||
+	    ipv6_addr_any(&info->key.u.ipv6.dst))
+		return false;
+
+	*local = info->key.u.ipv6.src;
+	*remote = info->key.u.ipv6.dst;
+	*hop_limit = info->key.ttl ?: 64;
+
+	return true;
+}
+
+static bool ppe_ft_lwt_decap(const struct flow_rule *rule,
+			     const struct flow_action_entry *act,
+			     struct in6_addr *local,
+			     struct in6_addr *remote)
+{
+	struct flow_match_enc_keyid keyid;
+	struct flow_match_ipv6_addrs ipv6;
+	struct flow_match_control control;
+
+	if (act->tunnel_type != LWTUNNEL_ENCAP_IP6 ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_ENC_CONTROL) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_ENC_KEYID) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_ENC_IPV6_ADDRS))
+		return false;
+
+	flow_rule_match_enc_control(rule, &control);
+	flow_rule_match_enc_keyid(rule, &keyid);
+	flow_rule_match_enc_ipv6_addrs(rule, &ipv6);
+	if (control.key->addr_type != FLOW_DISSECTOR_KEY_IPV6_ADDRS ||
+	    control.mask->addr_type != 0xffff || control.mask->flags ||
+	    keyid.key->keyid || keyid.mask->keyid != cpu_to_be32(~0U) ||
+	    memchr_inv(&ipv6.mask->src, 0xff, sizeof(ipv6.mask->src)) ||
+	    memchr_inv(&ipv6.mask->dst, 0xff, sizeof(ipv6.mask->dst)) ||
+	    ipv6_addr_any(&ipv6.key->src) || ipv6_addr_any(&ipv6.key->dst))
+		return false;
+
+	/* nf_flow_rule_lwt_match() reverses the TX key for ingress match. */
+	*remote = ipv6.key->src;
+	*local = ipv6.key->dst;
+
+	return true;
+}
