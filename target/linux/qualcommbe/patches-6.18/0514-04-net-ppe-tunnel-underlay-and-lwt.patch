+
+int ppe_tunnel_pppoe_l3_if_set(struct ppe_device *ppe_dev, int session,
+			       bool valid, int l3_if)
+{
+	u32 reg, old, val;
+	int ret;
+
+	if (session < 0 ||
+	    session >= ppe_dev->variant->num_pppoe_sessions ||
+	    l3_if < 0 || l3_if >= PPE_TUNNEL_L3_IF_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+
+	reg = PPE_PPPOE_SESSION_EXT2_ADDR +
+	      session * PPE_PPPOE_SESSION_EXT2_INC;
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = regmap_read(ppe_dev->regmap, reg, &old);
+	if (ret)
+		goto out;
+	val = old;
+	FIELD_MODIFY(PPE_PPPOE_SESSION_EXT2_TL_L3_IF_VALID, &val, valid);
+	FIELD_MODIFY(PPE_PPPOE_SESSION_EXT2_TL_L3_IF, &val, l3_if);
+	ret = ppe_tunnel_write_verify(ppe_dev, reg, &old, &val, 1,
+				      "PPPoE session tunnel interface",
+				      session);
+out:
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
+	return ret;
+}
+
+int ppe_tunnel_port_pppoe_set(struct ppe_device *ppe_dev, int port,
+			      bool enable)
+{
+	u32 reg, old[3], val[3];
+	int ret;
+
+	if (port < 0 || port >= PPE_TUNNEL_PORT_INTF_ENTRIES)
+		return -EINVAL;
+	ret = ppe_tunnel_check(ppe_dev);
+	if (ret)
+		return ret;
+	reg = PPE_TUNNEL_PORT_INTF_ADDR +
+	      port * PPE_TUNNEL_PORT_INTF_INC;
+
+	mutex_lock(&ppe_dev->tunnel_lock);
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, old, ARRAY_SIZE(old));
+	if (ret)
+		goto out;
+	memcpy(val, old, sizeof(val));
+	FIELD_MODIFY(PPE_TUNNEL_PORT_INTF_W2_PPPOE_EN, &val[2], enable);
+	ret = ppe_tunnel_write_verify(ppe_dev, reg, old, val, ARRAY_SIZE(val),
+				      "tunnel PPPoE state of port", port);
+out:
+	mutex_unlock(&ppe_dev->tunnel_lock);
+
 	return ret;
 }
 
