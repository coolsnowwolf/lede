+static int ppe_ft_tunnel_pppoe_port_put(struct ppe_flowtable *ft, int port)
+{
+	struct ppe_ft_tunnel_pppoe_port *state;
+	int ret;
+
+	if (WARN_ON_ONCE(port < 0 || port >= ft->ppe_dev->num_ports))
+		return -EINVAL;
+	state = &ft->tunnel_pppoe_ports[port];
+	if (WARN_ON_ONCE(!state->refcnt))
+		return -EINVAL;
+	if (--state->refcnt)
+		return 0;
+
+	ret = ppe_tunnel_port_pppoe_set(ft->ppe_dev, port, false);
+	if (ret) {
+		state->poisoned = true;
+		state->refcnt = 1;
+		WARN_ONCE(1, "quarantining tunnel PPPoE state on a port\n");
+	}
+
+	return ret;
+}
