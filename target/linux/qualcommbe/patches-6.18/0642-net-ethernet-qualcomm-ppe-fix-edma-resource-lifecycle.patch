+/* Stop shared RX before any port netdev or per-port statistics are freed.
+ * Port teardown still owns TX NAPI, which ndo_stop disables exactly once.
+ */
+void edma_quiesce(void)
+{
+	struct regmap *regmap = edma_ctx->ppe_dev->regmap;
+	u32 i;
+
+	if (!edma_ctx->hw_configured)
+		return;
+
+	regmap_write(regmap, EDMA_BASE_OFFSET + EDMA_REG_PORT_CTRL_ADDR, 0);
+	for (i = 1; i <= edma_ctx->hw_info->max_ports; i++)
+		edma_cfg_tx_disable_interrupts(i);
+	edma_cfg_rx_disable_interrupts();
+	edma_disable_misc_interrupt();
+	edma_cfg_rx_rings_disable();
+	edma_cfg_rx_napi_disable();
+}
+
+static void edma_hw_destroy(void)
+{
+	if (!edma_ctx->hw_configured)
+		return;
+
+	edma_quiesce();
+	edma_cfg_rx_napi_delete();
+	edma_cfg_rx_rings_cleanup();
+	edma_cfg_tx_rings_cleanup();
+	free_netdev(edma_ctx->dummy_dev);
+	edma_ctx->dummy_dev = NULL;
+	kfree(edma_ctx->netdev_arr);
+	edma_ctx->netdev_arr = NULL;
+	edma_ctx->hw_configured = false;
+}
