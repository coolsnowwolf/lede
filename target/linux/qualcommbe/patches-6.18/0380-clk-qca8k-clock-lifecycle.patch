From: ViKing <viking.yfy@qq.com>
Date: Tue, 27 Oct 2026 09:40:00 +0800
Subject: [PATCH] clk: qcom: preserve QCA8K access clocks and parent ownership

Consolidate consecutive changes within this functional responsibility.
Retain the final implementation and its error handling directly.

Merged from:
  0380-01-clk-qcom-nsscc-qca8k-keep-qca8386-clocks-on.patch
  0380-02-clk-qcom-qca8k-use-sleepable-rcg-status.patch
  0380-03-clk-qcom-qca8k-preserve-mac-clock-parent.patch

Based on work by:
  OpenWrt community <openwrt-devel@lists.openwrt.org>

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/clk/qcom/clk-rcg.h
+++ b/drivers/clk/qcom/clk-rcg.h
@@ -189,9 +189,11 @@ struct clk_rcg2_gfx3d {
 	container_of(to_clk_rcg2(_hw), struct clk_rcg2_gfx3d, rcg)
 
 extern const struct clk_ops clk_rcg2_ops;
+extern const struct clk_ops clk_rcg2_prepare_ops;
 extern const struct clk_ops clk_rcg2_gp_ops;
 extern const struct clk_ops clk_rcg2_floor_ops;
 extern const struct clk_ops clk_rcg2_fm_ops;
+extern const struct clk_ops clk_rcg2_fm_prepare_ops;
 extern const struct clk_ops clk_rcg2_mux_closest_ops;
 extern const struct clk_ops clk_edp_pixel_ops;
 extern const struct clk_ops clk_byte_ops;
--- a/drivers/clk/qcom/clk-rcg2.c
+++ b/drivers/clk/qcom/clk-rcg2.c
@@ -290,13 +290,14 @@ __clk_rcg2_select_conf(struct clk_hw *hw
 	unsigned long rate_diff, best_rate_diff = ULONG_MAX;
 	const struct freq_conf *conf, *best_conf = NULL;
 	struct clk_rcg2 *rcg = to_clk_rcg2(hw);
+	bool no_reparent = clk_hw_get_flags(hw) & CLK_SET_RATE_NO_REPARENT;
 	const char *name = clk_hw_get_name(hw);
 	unsigned long parent_rate, rate;
 	struct clk_hw *p;
 	int index, i;
 
 	/* Exit early if only one config is defined */
-	if (f->num_confs == 1) {
+	if (f->num_confs == 1 && !no_reparent) {
 		best_conf = f->confs;
 		goto exit;
 	}
@@ -310,6 +311,8 @@ __clk_rcg2_select_conf(struct clk_hw *hw
 		p = clk_hw_get_parent_by_index(hw, index);
 		if (!p)
 			continue;
+		if (no_reparent && p != clk_hw_get_parent(hw))
+			continue;
 
 		parent_rate = clk_hw_get_rate(p);
 		rate = calc_rate(parent_rate, conf->n, conf->m, conf->n, conf->pre_div);
@@ -326,6 +329,9 @@ __clk_rcg2_select_conf(struct clk_hw *hw
 		}
 	}
 
+	if (!best_conf && no_reparent)
+		return ERR_PTR(-EINVAL);
+
 	/*
 	 * Very unlikely. Warn if we couldn't find a correct config
 	 * due to parent not found in every config.
@@ -811,6 +817,20 @@ const struct clk_ops clk_rcg2_ops = {
 };
 EXPORT_SYMBOL_GPL(clk_rcg2_ops);
 
+/* MDIO register accesses require the sleepable prepare context. */
+const struct clk_ops clk_rcg2_prepare_ops = {
+	.is_prepared = clk_rcg2_is_enabled,
+	.get_parent = clk_rcg2_get_parent,
+	.set_parent = clk_rcg2_set_parent,
+	.recalc_rate = clk_rcg2_recalc_rate,
+	.determine_rate = clk_rcg2_determine_rate,
+	.set_rate = clk_rcg2_set_rate,
+	.set_rate_and_parent = clk_rcg2_set_rate_and_parent,
+	.get_duty_cycle = clk_rcg2_get_duty_cycle,
+	.set_duty_cycle = clk_rcg2_set_duty_cycle,
+};
+EXPORT_SYMBOL_GPL(clk_rcg2_prepare_ops);
+
 const struct clk_ops clk_rcg2_gp_ops = {
 	.is_enabled = clk_rcg2_is_enabled,
 	.get_parent = clk_rcg2_get_parent,
@@ -849,6 +869,20 @@ const struct clk_ops clk_rcg2_fm_ops = {
 };
 EXPORT_SYMBOL_GPL(clk_rcg2_fm_ops);
 
+/* MDIO register accesses require the sleepable prepare context. */
+const struct clk_ops clk_rcg2_fm_prepare_ops = {
+	.is_prepared = clk_rcg2_is_enabled,
+	.get_parent = clk_rcg2_get_parent,
+	.set_parent = clk_rcg2_set_parent,
+	.recalc_rate = clk_rcg2_recalc_rate,
+	.determine_rate = clk_rcg2_fm_determine_rate,
+	.set_rate = clk_rcg2_fm_set_rate,
+	.set_rate_and_parent = clk_rcg2_fm_set_rate_and_parent,
+	.get_duty_cycle = clk_rcg2_get_duty_cycle,
+	.set_duty_cycle = clk_rcg2_set_duty_cycle,
+};
+EXPORT_SYMBOL_GPL(clk_rcg2_fm_prepare_ops);
+
 const struct clk_ops clk_rcg2_mux_closest_ops = {
 	.determine_rate = __clk_mux_determine_rate_closest,
 	.get_parent = clk_rcg2_get_parent,
