From: ViKing <viking.yfy@qq.com>
Date: Wed, 28 Oct 2026 13:34:14 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: use IPQ5332 MPPE config

IPQ5332 has the smaller MPPE hardware block, but the initial upstream PPE
support reuses IPQ9574 APPE buffer limits and arbitration tables. This can
address ports which do not exist on IPQ5332 and program limits larger than
the MPPE buffer pools.

Use the MPPE BM and QM limits, thresholds, flow-control policy, and
32-entry BM/10-entry QM arbitration tables from QSDK. Keep the IPQ9574
path unchanged.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_config.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_config.c
@@ -13,6 +13,7 @@
 #include <linux/device.h>
 #include <linux/limits.h>
 #include <linux/math64.h>
+#include <linux/of.h>
 #include <linux/regmap.h>
 
 #include "ppe.h"
@@ -32,6 +33,7 @@
  * @resume_offset: Resume offset from the threshold value.
  * @resume_ceil: Ceil to resume from the back pressure state.
  * @dynamic: Dynamic threshold used or not.
+ * @flow_control: Enable flow control for this BM port range.
  *
  * The is for configuring the threshold that impacts the port
  * flow control.
@@ -46,6 +48,7 @@ struct ppe_bm_port_config {
 	unsigned int resume_offset;
 	unsigned int resume_ceil;
 	bool dynamic;
+	bool flow_control;
 };
 
 /**
@@ -169,6 +172,110 @@ struct ppe_port_schedule_resource {
 	unsigned int l1node_end;
 };
 
+/* IPQ5332 contains the smaller MPPE block. Its buffer pool and arbitration
+ * tables differ from the APPE block in IPQ9574. These values match the MPPE
+ * hardware initialization in QSDK.
+ */
+static const int ipq5332_ppe_bm_group_config = 360;
+
+static const struct ppe_bm_port_config ipq5332_ppe_bm_port_config[] = {
+	{
+		.port_id_start	= 0,
+		.port_id_end	= 7,
+		.pre_alloc	= 12,
+		.in_fly_buf	= 40,
+		.ceil		= 30,
+		.weight		= 7,
+		.resume_offset	= 5,
+		.resume_ceil	= 20,
+		.dynamic	= true,
+		.flow_control	= true,
+	},
+	{
+		.port_id_start	= 8,
+		.port_id_end	= 9,
+		.pre_alloc	= 12,
+		.in_fly_buf	= 128,
+		.ceil		= 48,
+		.weight		= 7,
+		.resume_offset	= 5,
+		.resume_ceil	= 20,
+		.dynamic	= true,
+		.flow_control	= false,
+	},
+};
+
+static const int ipq5332_ppe_qm_group_config = 500;
+
+static const struct ppe_qm_queue_config ipq5332_ppe_qm_queue_config[] = {
+	{
+		.queue_start	= 0,
+		.queue_end	= 255,
+		.prealloc_buf	= 0,
+		.ceil		= 300,
+		.weight		= 7,
+		.resume_offset	= 18,
+		.dynamic	= true,
+	},
+	{
+		.queue_start	= 256,
+		.queue_end	= 299,
+		.prealloc_buf	= 0,
+		.ceil		= 50,
+		.weight		= 0,
+		.resume_offset	= 18,
+		.dynamic	= false,
+	},
+};
+
+static const struct ppe_scheduler_bm_config ipq5332_ppe_sch_bm_config[] = {
+	{true,  PPE_SCH_INGRESS, 2, false, 0},
+	{true,  PPE_SCH_EGRESS,  0, false, 0},
+	{true,  PPE_SCH_INGRESS, 1, false, 0},
+	{true,  PPE_SCH_EGRESS,  1, false, 0},
+	{true,  PPE_SCH_INGRESS, 2, false, 0},
+	{true,  PPE_SCH_EGRESS,  2, false, 0},
+	{true,  PPE_SCH_INGRESS, 0, false, 0},
+	{true,  PPE_SCH_EGRESS,  0, false, 0},
+	{true,  PPE_SCH_INGRESS, 2, false, 0},
+	{true,  PPE_SCH_EGRESS,  1, false, 0},
+	{true,  PPE_SCH_INGRESS, 1, false, 0},
+	{true,  PPE_SCH_EGRESS,  2, false, 0},
+	{true,  PPE_SCH_INGRESS, 0, false, 0},
+	{true,  PPE_SCH_EGRESS,  0, false, 0},
+	{true,  PPE_SCH_INGRESS, 1, false, 0},
+	{true,  PPE_SCH_EGRESS,  1, false, 0},
+	{true,  PPE_SCH_INGRESS, 2, false, 0},
+	{true,  PPE_SCH_EGRESS,  2, false, 0},
+	{true,  PPE_SCH_INGRESS, 1, false, 0},
+	{true,  PPE_SCH_EGRESS,  0, false, 0},
+	{true,  PPE_SCH_INGRESS, 2, false, 0},
+	{true,  PPE_SCH_EGRESS,  1, false, 0},
+	{true,  PPE_SCH_INGRESS, 0, false, 0},
+	{true,  PPE_SCH_EGRESS,  2, false, 0},
+	{true,  PPE_SCH_INGRESS, 2, false, 0},
+	{true,  PPE_SCH_EGRESS,  0, false, 0},
+	{true,  PPE_SCH_INGRESS, 1, false, 0},
+	{true,  PPE_SCH_EGRESS,  1, false, 0},
+	{true,  PPE_SCH_INGRESS, 0, false, 0},
+	{true,  PPE_SCH_EGRESS,  2, false, 0},
+	{true,  PPE_SCH_INGRESS, 1, false, 0},
+	{false, PPE_SCH_INGRESS, 0, false, 0},
+};
+
+static const struct ppe_scheduler_qm_config ipq5332_ppe_sch_qm_config[] = {
+	{0x0, 2, 0, false, 0},
+	{0x0, 1, 2, false, 0},
+	{0x0, 0, 1, false, 0},
+	{0x0, 0, 2, false, 0},
+	{0x0, 1, 0, false, 0},
+	{0x0, 2, 1, false, 0},
+	{0x0, 0, 2, false, 0},
+	{0x0, 0, 1, false, 0},
+	{0x0, 0, 2, false, 0},
+	{0x0, 0, 1, false, 0},
+};
+
 /* There are total 2048 buffers available in PPE, out of which some
  * buffers are reserved for some specific purposes per PPE port. The
  * rest of the pool of 1550 buffers are assigned to the general 'group0'
@@ -193,6 +300,7 @@ static const struct ppe_bm_port_config i
 		.resume_offset	= 8,
 		.resume_ceil	= 0,
 		.dynamic	= true,
+		.flow_control	= true,
 	},
 	{
 		/* Buffer configuration for the BM port ID 1-7 of EDMA. */
@@ -205,6 +313,7 @@ static const struct ppe_bm_port_config i
 		.resume_offset	= 36,
 		.resume_ceil	= 0,
 		.dynamic	= true,
+		.flow_control	= true,
 	},
 	{
 		/* Buffer configuration for the BM port ID 8-13 of PPE ports. */
@@ -217,6 +326,7 @@ static const struct ppe_bm_port_config i
 		.resume_offset	= 36,
 		.resume_ceil	= 0,
 		.dynamic	= true,
+		.flow_control	= true,
 	},
 	{
 		/* Buffer configuration for the BM port ID 14 of EIP. */
@@ -229,6 +339,7 @@ static const struct ppe_bm_port_config i
 		.resume_offset	= 36,
 		.resume_ceil	= 0,
 		.dynamic	= true,
+		.flow_control	= true,
 	},
 };
 
@@ -2298,8 +2409,11 @@ static int ppe_config_bm_threshold(struc
 	if (ret)
 		return ret;
 
-	/* Enable BM port flow control. */
+	/* Configure BM port flow control. */
 	reg = PPE_BM_PORT_FC_MODE_ADDR + PPE_BM_PORT_FC_MODE_INC * bm_port_id;
+	if (!port_cfg.flow_control)
+		return regmap_clear_bits(ppe_dev->regmap, reg,
+					 PPE_BM_PORT_FC_MODE_EN);
 
 	return regmap_set_bits(ppe_dev->regmap, reg, PPE_BM_PORT_FC_MODE_EN);
 }
@@ -2309,8 +2423,22 @@ static int ppe_config_bm(struct ppe_devi
 {
 	const struct ppe_bm_port_config *port_cfg;
 	unsigned int i, bm_port_id, port_cfg_cnt;
+	unsigned int group_config;
 	u32 reg, val;
 	int ret;
+	bool ipq5332;
+
+	ipq5332 = of_device_is_compatible(ppe_dev->dev->of_node,
+					  "qcom,ipq5332-ppe");
+	if (ipq5332) {
+		group_config = ipq5332_ppe_bm_group_config;
+		port_cfg = ipq5332_ppe_bm_port_config;
+		port_cfg_cnt = ARRAY_SIZE(ipq5332_ppe_bm_port_config);
+	} else {
+		group_config = ipq9574_ppe_bm_group_config;
+		port_cfg = ipq9574_ppe_bm_port_config;
+		port_cfg_cnt = ARRAY_SIZE(ipq9574_ppe_bm_port_config);
+	}
 
 	/* Configure the allocated buffer number only for group 0.
 	 * The buffer number of group 1-3 is already cleared to 0
@@ -2318,7 +2446,7 @@ static int ppe_config_bm(struct ppe_devi
 	 */
 	reg = PPE_BM_SHARED_GROUP_CFG_ADDR;
 	val = FIELD_PREP(PPE_BM_SHARED_GROUP_CFG_SHARED_LIMIT,
-			 ipq9574_ppe_bm_group_config);
+			 group_config);
 	ret = regmap_update_bits(ppe_dev->regmap, reg,
 				 PPE_BM_SHARED_GROUP_CFG_SHARED_LIMIT,
 				 val);
@@ -2326,8 +2454,6 @@ static int ppe_config_bm(struct ppe_devi
 		goto bm_config_fail;
 
 	/* Configure buffer thresholds for the BM ports. */
-	port_cfg = ipq9574_ppe_bm_port_config;
-	port_cfg_cnt = ARRAY_SIZE(ipq9574_ppe_bm_port_config);
 	for (i = 0; i < port_cfg_cnt; i++) {
 		for (bm_port_id = port_cfg[i].port_id_start;
 		     bm_port_id <= port_cfg[i].port_id_end; bm_port_id++) {
@@ -2352,9 +2478,23 @@ static int ppe_config_qm(struct ppe_devi
 {
 	const struct ppe_qm_queue_config *queue_cfg;
 	int ret, i, queue_id, queue_cfg_count;
+	unsigned int group_config;
 	u32 reg, multicast_queue_cfg[5];
 	u32 unicast_queue_cfg[4];
 	u32 group_cfg[3];
+	bool ipq5332;
+
+	ipq5332 = of_device_is_compatible(ppe_dev->dev->of_node,
+					  "qcom,ipq5332-ppe");
+	if (ipq5332) {
+		group_config = ipq5332_ppe_qm_group_config;
+		queue_cfg = ipq5332_ppe_qm_queue_config;
+		queue_cfg_count = ARRAY_SIZE(ipq5332_ppe_qm_queue_config);
+	} else {
+		group_config = ipq9574_ppe_qm_group_config;
+		queue_cfg = ipq9574_ppe_qm_queue_config;
+		queue_cfg_count = ARRAY_SIZE(ipq9574_ppe_qm_queue_config);
+	}
 
 	/* Assign the buffer number to the group 0 by default. */
 	reg = PPE_AC_GRP_CFG_TBL_ADDR;
@@ -2363,15 +2503,13 @@ static int ppe_config_qm(struct ppe_devi
 	if (ret)
 		goto qm_config_fail;
 
-	PPE_AC_GRP_SET_BUF_LIMIT(group_cfg, ipq9574_ppe_qm_group_config);
+	PPE_AC_GRP_SET_BUF_LIMIT(group_cfg, group_config);
 
 	ret = regmap_bulk_write(ppe_dev->regmap, reg,
 				group_cfg, ARRAY_SIZE(group_cfg));
 	if (ret)
 		goto qm_config_fail;
 
-	queue_cfg = ipq9574_ppe_qm_queue_config;
-	queue_cfg_count = ARRAY_SIZE(ipq9574_ppe_qm_queue_config);
 	for (i = 0; i < queue_cfg_count; i++) {
 		queue_id = queue_cfg[i].queue_start;
 
@@ -2510,9 +2648,17 @@ static int ppe_config_scheduler(struct p
 	const struct ppe_scheduler_bm_config *bm_cfg;
 	int ret, i, count;
 	u32 val, reg;
+	bool ipq5332;
 
-	count = ARRAY_SIZE(ipq9574_ppe_sch_bm_config);
-	bm_cfg = ipq9574_ppe_sch_bm_config;
+	ipq5332 = of_device_is_compatible(ppe_dev->dev->of_node,
+					  "qcom,ipq5332-ppe");
+	if (ipq5332) {
+		count = ARRAY_SIZE(ipq5332_ppe_sch_bm_config);
+		bm_cfg = ipq5332_ppe_sch_bm_config;
+	} else {
+		count = ARRAY_SIZE(ipq9574_ppe_sch_bm_config);
+		bm_cfg = ipq9574_ppe_sch_bm_config;
+	}
 
 	/* Configure the depth of BM scheduler entries. */
 	val = FIELD_PREP(PPE_BM_SCH_CTRL_SCH_DEPTH, count);
@@ -2542,8 +2688,13 @@ static int ppe_config_scheduler(struct p
 			goto sch_config_fail;
 	}
 
-	count = ARRAY_SIZE(ipq9574_ppe_sch_qm_config);
-	qm_cfg = ipq9574_ppe_sch_qm_config;
+	if (ipq5332) {
+		count = ARRAY_SIZE(ipq5332_ppe_sch_qm_config);
+		qm_cfg = ipq5332_ppe_sch_qm_config;
+	} else {
+		count = ARRAY_SIZE(ipq9574_ppe_sch_qm_config);
+		qm_cfg = ipq9574_ppe_sch_qm_config;
+	}
 
 	/* Configure the depth of QM scheduler entries. */
 	val = FIELD_PREP(PPE_PSCH_SCH_DEPTH_CFG_SCH_DEPTH, count);
@@ -2904,6 +3055,11 @@ int ppe_hw_config(struct ppe_device *ppe
 	 */
 	ppe_dev->fdb_cmd_id = 1;
 
+	if (of_device_is_compatible(ppe_dev->dev->of_node,
+				    "qcom,ipq5332-ppe"))
+		dev_info(ppe_dev->dev,
+			 "using IPQ5332 MPPE BM/QM scheduler profile\n");
+
 	ret = ppe_config_bm(ppe_dev);
 	if (ret)
 		return ret;
