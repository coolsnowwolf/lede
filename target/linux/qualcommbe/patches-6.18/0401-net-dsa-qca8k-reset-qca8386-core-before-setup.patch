--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -16,6 +16,7 @@
 #include <linux/of_mdio.h>
 #include <linux/of_platform.h>
 #include <linux/mdio.h>
+#include <linux/reset.h>
 #include <linux/phylink.h>
 #include <linux/gpio/consumer.h>
 #include <linux/etherdevice.h>
@@ -2165,6 +2166,56 @@
 			   mask);
 }
 
+static int qca8k_qca8386_reset(struct qca8k_priv *priv)
+{
+	struct reset_control *resets;
+	struct device_node *phy_np;
+	struct phy_device *phydev;
+	struct dsa_port *dp;
+	int ret;
+
+	resets = devm_reset_control_array_get_optional_exclusive(priv->dev);
+	if (IS_ERR(resets))
+		return dev_err_probe(priv->dev, PTR_ERR(resets),
+				     "failed to get switch resets\n");
+	if (!resets)
+		return 0;
+
+	/* The first integrated PHY initializes the shared SRAM timing, PCS1
+	 * and clocks. Resetting the core before that sequence leaves its QM
+	 * running while the package changes mode and clock sources.
+	 */
+	dsa_switch_for_each_user_port(dp, priv->ds) {
+		phy_np = of_parse_phandle(dp->dn, "phy-handle", 0);
+		if (!phy_np)
+			continue;
+
+		phydev = of_phy_find_device(phy_np);
+		of_node_put(phy_np);
+		if (!phydev)
+			return -EPROBE_DEFER;
+
+		mutex_lock(&phydev->lock);
+		ret = phydev->drv ? phy_init_hw(phydev) : -EPROBE_DEFER;
+		mutex_unlock(&phydev->lock);
+		put_device(&phydev->mdio.dev);
+		if (ret)
+			return dev_err_probe(priv->dev, ret,
+					     "failed to initialize switch PHY package\n");
+		break;
+	}
+
+	/* The ordered array pulses the core, then MAC0-5 TX/RX, before any
+	 * DSA header, forwarding or MIB configuration is written.
+	 */
+	ret = reset_control_reset(resets);
+	if (ret)
+		return dev_err_probe(priv->dev, ret,
+				     "failed to reset switch core\n");
+
+	return 0;
+}
+
 static int
 qca8k_setup(struct dsa_switch *ds)
 {
@@ -2179,6 +2230,12 @@
 		return cpu_port;
 	}
 
+	if (qca8k_is_qca8386(priv)) {
+		ret = qca8k_qca8386_reset(priv);
+		if (ret)
+			return ret;
+	}
+
 	/* Parse CPU port config to be later used in phy_link mac_config */
 	ret = qca8k_parse_port_config(priv);
 	if (ret)
