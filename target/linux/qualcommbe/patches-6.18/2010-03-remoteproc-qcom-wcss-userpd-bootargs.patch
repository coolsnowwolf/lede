From: JiaY-shi <shi05275@163.com>
Date: Wed, 28 Oct 2026 13:34:14 +0800
Subject: [PATCH] remoteproc: qcom: prepare UserPD boot metadata before loading WCSS

Keep validated ELF metadata, the MDT file-size API and shared-memory UserPD boot arguments in one firmware-startup unit.

Split from:
  2010-02-remoteproc-qcom-secure-wcss-startup-signaling.patch
Original-patch: 2010-03-remoteproc-qcom-wcss-refresh-userpd-bootargs.patch

Signed-off-by: JiaY-shi <shi05275@163.com>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/remoteproc/qcom_q6v5_wcss_sec.c
+++ b/drivers/remoteproc/qcom_q6v5_wcss_sec.c
@@ -3,12 +3,16 @@
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
 #include <linux/clk.h>
+#include <linux/elf.h>
+#include <linux/firmware.h>
 #include <linux/firmware/qcom/qcom_scm.h>
 #include <linux/io.h>
 #include <linux/mailbox_client.h>
 #include <linux/of_reserved_mem.h>
 #include <linux/platform_device.h>
+#include <linux/slab.h>
 #include <linux/soc/qcom/mdt_loader.h>
+#include <linux/soc/qcom/smem.h>
 
 #include "qcom_common.h"
 #include "qcom_q6v5.h"
@@ -17,6 +21,12 @@
 #define WCSS_CRASH_REASON		421
 #define WCSS_SMEM_HOST			1
 
+#define WCSS_BOOTARGS_SMEM_SIZE		4096
+#define WCSS_BOOTARGS_VERSION		2
+#define WCSS_USERPD_BOOTARGS_TYPE	2
+#define WCSS_USERPD_FIRST_PID		2
+#define WCSS_USERPD_MAX			16
+
 #define WCSS_PAS_ID			0x6
 #define MPD_WCSS_PAS_ID			0xd
 
@@ -40,6 +50,23 @@ struct wcss_data {
 	bool auto_boot;
 };
 
+struct wcss_bootargs_header {
+	__le16 version;
+	__le16 data_len;
+} __packed;
+
+struct wcss_bootargs_tlv {
+	u8 type;
+	u8 length;
+} __packed;
+
+struct wcss_userpd_bootargs {
+	struct wcss_bootargs_tlv header;
+	u8 pid;
+	__le32 boot_addr;
+	__le32 data_size;
+} __packed;
+
 static int wcss_sec_start(struct rproc *rproc)
 {
 	struct wcss_sec *wcss = rproc->priv;
@@ -110,12 +137,121 @@ static void *wcss_sec_da_to_va(struct rp
 	return wcss->mem_region + offset;
 }
 
+static int wcss_sec_prepare_userpd_bootargs(struct rproc *rproc)
+{
+	struct wcss_sec *wcss = rproc->priv;
+	struct wcss_bootargs_header *header;
+	struct wcss_userpd_bootargs *entry;
+	const struct elf32_hdr *ehdr;
+	const struct firmware *fw;
+	const char *fw_name;
+	ssize_t image_size;
+	size_t smem_size;
+	void *bootargs;
+	void *smem;
+	u32 smem_id;
+	int num_userpds;
+	int i;
+	int ret;
+
+	ret = of_property_read_u32(wcss->dev->of_node,
+				   "qcom,bootargs_smem", &smem_id);
+	if (ret)
+		return 0;
+
+	num_userpds = of_property_count_strings(wcss->dev->of_node,
+						 "upd-firmware-names");
+	if (num_userpds <= 0 || num_userpds > WCSS_USERPD_MAX)
+		return num_userpds < 0 ? num_userpds : -E2BIG;
+
+	bootargs = kzalloc(WCSS_BOOTARGS_SMEM_SIZE, GFP_KERNEL);
+	if (!bootargs)
+		return -ENOMEM;
+
+	header = bootargs;
+	header->version = cpu_to_le16(WCSS_BOOTARGS_VERSION);
+	header->data_len = cpu_to_le16(num_userpds * sizeof(*entry));
+	entry = bootargs + sizeof(*header);
+
+	for (i = 0; i < num_userpds; i++, entry++) {
+		ret = of_property_read_string_index(wcss->dev->of_node,
+						    "upd-firmware-names", i,
+						    &fw_name);
+		if (ret)
+			goto out_free;
+
+		ret = request_firmware(&fw, fw_name, wcss->dev);
+		if (ret)
+			goto out_free;
+
+		if (fw->size < sizeof(*ehdr)) {
+			ret = -EINVAL;
+			goto out_release;
+		}
+
+		ehdr = (const struct elf32_hdr *)fw->data;
+		if (memcmp(ehdr->e_ident, ELFMAG, SELFMAG) ||
+		    ehdr->e_ident[EI_CLASS] != ELFCLASS32) {
+			ret = -EINVAL;
+			goto out_release;
+		}
+
+		image_size = qcom_mdt_get_file_size(fw);
+		if (image_size <= 0 || image_size > U32_MAX) {
+			ret = image_size < 0 ? image_size : -EFBIG;
+			goto out_release;
+		}
+
+		entry->header.type = WCSS_USERPD_BOOTARGS_TYPE;
+		entry->header.length = sizeof(*entry) - sizeof(entry->header);
+		entry->pid = WCSS_USERPD_FIRST_PID + i;
+		entry->boot_addr = cpu_to_le32(ehdr->e_entry);
+		entry->data_size = cpu_to_le32(image_size);
+		dev_info(wcss->dev,
+			 "UserPD bootargs pid %u firmware %s addr 0x%x size 0x%x\n",
+			 entry->pid, fw_name, ehdr->e_entry, (u32)image_size);
+		release_firmware(fw);
+	}
+
+	ret = qcom_smem_alloc(WCSS_SMEM_HOST, smem_id,
+			      WCSS_BOOTARGS_SMEM_SIZE);
+	if (ret && ret != -EEXIST)
+		goto out_free;
+
+	smem = qcom_smem_get(WCSS_SMEM_HOST, smem_id, &smem_size);
+	if (IS_ERR(smem)) {
+		ret = PTR_ERR(smem);
+		goto out_free;
+	}
+	if (smem_size < WCSS_BOOTARGS_SMEM_SIZE) {
+		ret = -ENOSPC;
+		goto out_free;
+	}
+
+	memset_io(smem, 0, smem_size);
+	memcpy_toio(smem, bootargs, WCSS_BOOTARGS_SMEM_SIZE);
+	ret = 0;
+	goto out_free;
+
+out_release:
+	release_firmware(fw);
+out_free:
+	kfree(bootargs);
+	return ret;
+}
+
 static int wcss_sec_load(struct rproc *rproc, const struct firmware *fw)
 {
 	struct wcss_sec *wcss = rproc->priv;
 	struct device *dev = wcss->dev;
 	int ret;
 
+	ret = wcss_sec_prepare_userpd_bootargs(rproc);
+	if (ret) {
+		dev_err(dev, "failed to prepare UserPD bootargs: %d\n", ret);
+		return ret;
+	}
+
 	ret = qcom_mdt_load(dev, fw, rproc->firmware, wcss->desc->pasid, wcss->mem_region,
 			    wcss->mem_phys, wcss->mem_size, &wcss->mem_reloc);
 	if (ret)
--- a/drivers/soc/qcom/mdt_loader.c
+++ b/drivers/soc/qcom/mdt_loader.c
@@ -139,6 +139,45 @@ ssize_t qcom_mdt_get_size(const struct f
 EXPORT_SYMBOL_GPL(qcom_mdt_get_size);
 
 /**
+ * qcom_mdt_get_file_size() - acquire the file-backed MDT image span
+ * @fw: firmware object for the MDT header
+ *
+ * Return: file-backed firmware span, or a negative errno on failure.
+ */
+ssize_t qcom_mdt_get_file_size(const struct firmware *fw)
+{
+	const struct elf32_phdr *phdrs;
+	const struct elf32_phdr *phdr;
+	const struct elf32_hdr *ehdr;
+	phys_addr_t min_addr = PHYS_ADDR_MAX;
+	phys_addr_t max_addr = 0;
+	int i;
+
+	if (!mdt_header_valid(fw))
+		return -EINVAL;
+
+	ehdr = (const struct elf32_hdr *)fw->data;
+	phdrs = (const struct elf32_phdr *)(fw->data + ehdr->e_phoff);
+
+	for (i = 0; i < ehdr->e_phnum; i++) {
+		phdr = &phdrs[i];
+
+		if (!mdt_phdr_loadable(phdr))
+			continue;
+
+		if (phdr->p_paddr < min_addr)
+			min_addr = phdr->p_paddr;
+
+		if (phdr->p_filesz &&
+		    phdr->p_paddr + phdr->p_filesz > max_addr)
+			max_addr = phdr->p_paddr + phdr->p_filesz;
+	}
+
+	return min_addr < max_addr ? max_addr - min_addr : -EINVAL;
+}
+EXPORT_SYMBOL_GPL(qcom_mdt_get_file_size);
+
+/**
  * qcom_mdt_read_metadata() - read header and metadata from mdt or mbn
  * @fw:		firmware of mdt header or mbn
  * @data_len:	length of the read metadata blob
--- a/include/linux/soc/qcom/mdt_loader.h
+++ b/include/linux/soc/qcom/mdt_loader.h
@@ -15,6 +15,7 @@ struct qcom_scm_pas_metadata;
 #if IS_ENABLED(CONFIG_QCOM_MDT_LOADER)
 
 ssize_t qcom_mdt_get_size(const struct firmware *fw);
+ssize_t qcom_mdt_get_file_size(const struct firmware *fw);
 int qcom_mdt_pas_init(struct device *dev, const struct firmware *fw,
 		      const char *fw_name, int pas_id, phys_addr_t mem_phys,
 		      struct qcom_scm_pas_metadata *pas_metadata_ctx);
@@ -36,6 +37,11 @@ static inline ssize_t qcom_mdt_get_size(
 {
 	return -ENODEV;
 }
+
+static inline ssize_t qcom_mdt_get_file_size(const struct firmware *fw)
+{
+	return -ENODEV;
+}
 
 static inline int qcom_mdt_pas_init(struct device *dev, const struct firmware *fw,
 				    const char *fw_name, int pas_id, phys_addr_t mem_phys,
