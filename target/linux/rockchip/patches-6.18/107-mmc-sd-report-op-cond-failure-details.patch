From: lean <chenlin@fnnas.com>
Subject: [PATCH] mmc: sd: report operating condition negotiation failures

Log the requested OCR and the final ACMD41 response on initialization
failure. Include the clock and signal voltage to distinguish negotiation
failures from later UHS tuning or filesystem problems.

Signed-off-by: lean <chenlin@fnnas.com>
---
--- a/drivers/mmc/core/sd_ops.c
+++ b/drivers/mmc/core/sd_ops.c
@@ -189,8 +189,12 @@
 	err = __mmc_poll_for_busy(host, SD_APP_OP_COND_PERIOD_US,
 				  SD_APP_OP_COND_TIMEOUT_MS, &sd_app_op_cond_cb,
 				  &cb_data);
-	if (err)
+	if (err) {
+		pr_err("%s: ACMD41 failed (%d): arg=%08x resp=%08x clock=%u signal_voltage=%u\n",
+		       mmc_hostname(host), err, cmd.arg, cmd.resp[0],
+		       host->ios.clock, host->ios.signal_voltage);
 		return err;
+	}
 
 	if (rocr && !mmc_host_is_spi(host))
 		*rocr = cmd.resp[0];
