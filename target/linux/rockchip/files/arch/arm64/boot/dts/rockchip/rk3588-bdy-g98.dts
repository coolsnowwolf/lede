// SPDX-License-Identifier: (GPL-2.0+ OR MIT)

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "dt-bindings/usb/pd.h"
#include "rk3588.dtsi"
#include "rk3588-rk806-single.dtsi"

/ {
	model = "BDY G98";
	compatible = "bdy,bdy-g98", "rockchip,rk3588";

	aliases {
		mmc0 = &sdmmc;
		mmc1 = &sdio;
		mmc2 = &sdhci;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		cma {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0x1 0x00000000 0x3 0x00000000>;
			size = <0x0 0x20000000>;
			linux,cma-default;
		};
	};

	adc-keys {
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <&saradc 1>;
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x64>;
		status = "okay";

		recovery-key {
			label = "F12";
			linux,code = <0x58>;
			press-threshold-microvolt = <0x6d6>;
		};
	};

	vcc12v_dcin: vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
		regulator-name = "vcc12v_dcin";
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-name = "vcc5v0_sys";
		vin-supply = <&vcc12v_dcin>;
	};

	vcc_1v1_nldo_s3: regulator-vcc-1v1-nldo-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v1_nldo_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc3v3_nvme: vcc3v3-nvme {
		compatible = "regulator-fixed";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "vcc3v3_nvme";
		vin-supply = <&vcc12v_dcin>;
		enable-active-high;
		gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <7500>;
		pinctrl-names = "default";
		pinctrl-0 = <&nvme_power_en>;
	};

	vcc5v0_host_regulator: vcc5v0-host-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
	    pinctrl-names = "default";
	    pinctrl-0 = <&vcc5v0_host_en>;
		regulator-name = "vcc5v0_host";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_otg_regulator: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
	    pinctrl-0 = <&vcc5v0_otg_en>;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-name = "vcc5v0_otg";
		vin-supply = <&vcc5v0_sys>;
	};

	hdmi0-con {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi0_con_in: endpoint {
				remote-endpoint = <&hdmi0_out_con>;
			};
		};
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		hdd-led {
			default-state = "off";
			gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
		};

		net-led {
			default-state = "off";
			gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
		};

		work-led {
			gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m2_xfer>;
	status = "okay";

	vdd_cpu_big0_s0: vdd_cpu_big0_mem_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu_big0_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vdd_cpu_big1_s0: vdd_cpu_big1_mem_s0: regulator@43 {
		compatible = "rockchip,rk8603", "rockchip,rk8602";
		reg = <0x43>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu_big1_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};


&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m0_xfer>;
	status = "disabled";
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2m0_xfer>;
	status = "okay";

	vdd_npu_s0: vdd_npu_mem_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_npu_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-enable-ramp-delay = <500>;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m0_xfer>;
	status = "okay";
};

&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m3_xfer>;
	status = "okay";
};

&i2c6 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6m0_xfer>;
	status = "okay";

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-output-names = "hym8563";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB2 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
	};
};


&combphy0_ps {
	pinctrl-0 = <&sata0_pm_reset>;
	pinctrl-names = "default";
	status = "okay";
};

&combphy1_ps {
	status = "okay";
};

&combphy2_psu {
	status = "okay";
};

&pcie30phy {
	data-lanes = <1 1 2 2>;
	status = "okay";
};

&pcie2x1l0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2_0_rst>;
	supports-clkreq;
	reset-gpios = <&gpio4 RK_PB4 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_nvme>;
	status = "okay";

	pcie@0,0 {
		reg = <0x00200000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0x20 0x2f>;
		device_type = "pci";
		ranges;

		ethernet@0,0 {
			reg = <0x00210000 0 0 0 0>;
			label = "eth2";
			realtek,led-data = <0x200 0x2b 0x0 0x0>;
		};
	};
};

&pcie2x1l1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie2_1_rst>;
	supports-clkreq;
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_nvme>;
	status = "okay";

	pcie@0,0 {
		reg = <0x00300000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0x30 0x3f>;
		device_type = "pci";
		ranges;

		ethernet@0,0 {
			reg = <0x00310000 0 0 0 0>;
			label = "eth3";
			realtek,led-data = <0x200 0x2b 0x0 0x0>;
		};
	};
};

&pcie2x1l2 {
	status = "disabled";
};

&pcie3x2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie3x2_rst>;
	num-lanes = <2>;
	reset-gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_nvme>;
	status = "okay";
};

&pcie3x4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie3x4_rst>;
	num-lanes = <2>;
	reset-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_nvme>;
	status = "okay";
};


&pinctrl {
	hym8563 {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	pcie {
		pcie2_0_rst: pcie2-0-rst {
			rockchip,pins = <4 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		pcie2_1_rst: pcie2-1-rst {
			rockchip,pins = <4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		pcie3x2_rst: pcie3x2-rst {
			rockchip,pins = <3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		pcie3x4_rst: pcie3x4-rst {
			rockchip,pins = <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	nvme {
		nvme_power_en: nvme-power-en {
			rockchip,pins = <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		vcc5v0_host_en: vcc5v0-host-en {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		vcc5v0_otg_en: vcc5v0-otg-en {
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sata {
		sata0_pm_reset: sata0-pm-reset {
			rockchip,pins = <0 RK_PD5 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};
};


&sdhci {
	/delete-property/ supports-cqe;
	bus-width = <8>;
	no-sdio;
	no-sd;
	supports-emmc;
	non-removable;
	mmc-hs200-1_8v;
	status = "okay";
};

&sdmmc {
	status = "disabled";
};

&sdio {
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;
	status = "disabled";
};


&sata0 {
	status = "okay";
};


&gmac0 {
	clock_in_out = "output";
	phy-mode = "rgmii-rxid";
	tx_delay = <0x44>;
	pinctrl-0 = <&gmac0_miim &gmac0_tx_bus2 &gmac0_rx_bus2 &gmac0_rgmii_clk &gmac0_rgmii_bus>;
	pinctrl-names = "default";
	snps,reset-active-low;
	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
	snps,reset-gpio = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};

&gmac1 {
	clock_in_out = "output";
	phy-mode = "rgmii-rxid";
	tx_delay = <0x42>;
	pinctrl-0 = <&gmac1_miim &gmac1_tx_bus2 &gmac1_rx_bus2 &gmac1_rgmii_clk &gmac1_rgmii_bus>;
	pinctrl-names = "default";
	snps,reset-active-low;
	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
	snps,reset-gpio = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};


&uart7 {
	status = "disabled";
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	phy-supply = <&vcc5v0_otg_regulator>;
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	phy-supply = <&vcc5v0_host_regulator>;
	status = "okay";
};

&usbdp_phy0 {
	rockchip,dp-lane-mux = <2 3>;
	status = "okay";

	u3-port {
		#phy-cells = <0x00>;
		maximum-speed = "super-speed";
		status = "okay";
	};
};

&usbdp_phy1 {
	rockchip,dp-lane-mux = <2 3>;
	status = "okay";

	u3-port {
		#phy-cells = <0x00>;
		maximum-speed = "super-speed";
		status = "okay";
	};
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host{
	phy-supply = <&vcc5v0_host_regulator>;
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "host";
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host{
	phy-supply = <&vcc5v0_host_regulator>;
	status = "okay";
};

&usb_host1_xhci {
	dr_mode = "host";
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&hdptxphy0 {
	status = "okay";
};

&hdmi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim0_tx0_cec &hdmim0_tx0_hpd &hdmim0_tx0_scl &hdmim0_tx0_sda>;
	enable-gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_HIGH>;
	status = "okay";
	ports {
		hdmi0_out: port@1 {
			reg = <1>;
		};
	};
};

&hdmi0_out {
	hdmi0_out_con: endpoint {
		remote-endpoint = <&hdmi0_con_in>;
	};
};

&i2s5_8ch {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vop {
	status = "okay";
};


&saradc {
	vref-supply = <&avcc_1v8_s0>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

&dfi {
	status = "okay";
};

&mdio0 {
	status = "okay";

	yt9215_0: switch@1d {
		compatible = "motorcomm,yt9215";
		reg = <0x1d>;
		dsa,member = <1 0>;
		motorcomm,bdy-g98-led-profile;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			sw1phy1: phy@1 { reg = <1>; };
			sw1phy2: phy@2 { reg = <2>; };
			sw1phy3: phy@3 { reg = <3>; };
			sw1phy4: phy@4 { reg = <4>; };
		};

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@1 {
				reg = <0x01>;
				label = "lan5";
				phy-mode = "internal";
				phy-handle = <&sw1phy1>;
			};

			ethernet-port@2 {
				reg = <0x02>;
				label = "lan6";
				phy-mode = "internal";
				phy-handle = <&sw1phy2>;
			};

			ethernet-port@3 {
				reg = <0x03>;
				label = "lan7";
				phy-mode = "internal";
				phy-handle = <&sw1phy3>;
			};

			ethernet-port@4 {
				reg = <0x04>;
				label = "lan8";
				phy-mode = "internal";
				phy-handle = <&sw1phy4>;
			};

			ethernet-port@9 {
				reg = <0x09>;
				ethernet = <&gmac0>;
				phy-mode = "rgmii-txid";

				fixed-link {
					speed = <1000>;
					full-duplex;
					pause;
				};
			};
		};
	};
};

&mdio1 {
	status = "okay";

	yt9215_1: switch@1d {
		compatible = "motorcomm,yt9215";
		reg = <0x1d>;
		dsa,member = <0 0>;
		motorcomm,bdy-g98-led-profile;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			sw0phy1: phy@1 { reg = <1>; };
			sw0phy2: phy@2 { reg = <2>; };
			sw0phy3: phy@3 { reg = <3>; };
			sw0phy4: phy@4 { reg = <4>; };
		};

		ethernet-ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			ethernet-port@1 {
				reg = <0x01>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&sw0phy1>;
			};

			ethernet-port@2 {
				reg = <0x02>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&sw0phy2>;
			};

			ethernet-port@3 {
				reg = <0x03>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&sw0phy3>;
			};

			ethernet-port@4 {
				reg = <0x04>;
				label = "lan4";
				phy-mode = "internal";
				phy-handle = <&sw0phy4>;
			};

			ethernet-port@9 {
				reg = <0x09>;
				ethernet = <&gmac1>;
				phy-mode = "rgmii-txid";

				fixed-link {
					speed = <1000>;
					full-duplex;
					pause;
				};
			};
		};
  };
};
