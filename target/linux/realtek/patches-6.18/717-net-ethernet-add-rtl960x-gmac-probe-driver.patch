From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taiga Ogawa <zectaiga@gmail.com>
Date: Mon, 3 Aug 2026 14:05:34 +0000
Subject: [PATCH] net: ethernet: add RTL960X Ethernet driver

Add a platform driver for the GMAC in the Realtek RTL960X SoC family. It
implements a minimal single-RX-ring + single-TX-ring NAPI datapath for the
CPU-facing GMAC, reconstructed from the Realtek re8686/rtl86900 NIC driver
and the matching U-Boot poll-mode driver.

The GMAC is the DSA conduit of the on-chip switch, so it also translates
between the descriptor CPU tag and DSA_TAG_PROTO_RTL_OTTO: it decodes the
egress port from the TX trailer, attaches a METADATA_HW_PORT_MUX metadata
dst on RX, and relies on the DSA core to derive skb->offload_fwd_mark from
the ingress port's bridge membership. This metadata path does not preserve
the descriptor's per-frame trap reason.

Assisted-by: Codex:gpt-5.6-sol
Signed-off-by: Taiga Ogawa <zectaiga@gmail.com>

--- a/drivers/net/ethernet/realtek/Kconfig
+++ b/drivers/net/ethernet/realtek/Kconfig
@@ -146,4 +146,13 @@ config NET_RTL838X
 	help
 	  Say Y here if you want to use the Realtek rtl838x Gbps Ethernet MAC.
 
+config NET_RTL960X_GMAC
+	tristate "Realtek RTL960X Ethernet MAC support"
+	depends on RTL960X
+	depends on OF
+	select REGMAP_MMIO
+	help
+	  This driver supports the gigabit ethernet MACs in the
+	  Realtek RTL960X SoC family.
+
 endif # NET_VENDOR_REALTEK
--- a/drivers/net/ethernet/realtek/Makefile
+++ b/drivers/net/ethernet/realtek/Makefile
@@ -11,3 +11,4 @@ r8169-$(CONFIG_R8169_LEDS) += r8169_leds
 obj-$(CONFIG_R8169) += r8169.o
 obj-$(CONFIG_RTASE) += rtase/
 obj-$(CONFIG_NET_RTL838X) += rtl838x_eth.o
+obj-$(CONFIG_NET_RTL960X_GMAC) += rtl960x_gmac.o
