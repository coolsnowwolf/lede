From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: thermal: loongson2: add ACPI fallback support

Add ACPI fallback support for Loongson-2K3000 thermal sensors.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -508,7 +508,7 @@
 config LOONGSON2_THERMAL
 	tristate "Loongson-2 SoC series thermal driver"
 	depends on LOONGARCH || COMPILE_TEST
-	depends on OF
+	depends on OF || ACPI
 	help
 	  Support for Thermal driver found on Loongson-2 SoC series platforms.
 	  The thermal driver realizes get_temp and set_trips function, which
--- a/drivers/thermal/loongson2_thermal.c
+++ b/drivers/thermal/loongson2_thermal.c
@@ -5,8 +5,10 @@
  * Copyright (C) 2022-2023 Loongson Technology Corporation Limited
  */
 
+#include <linux/acpi.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
+#include <linux/ioport.h>
 #include <linux/minmax.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
@@ -15,6 +17,10 @@
 #include <linux/thermal.h>
 #include <linux/units.h>
 
+#ifdef CONFIG_LOONGARCH
+#include <asm/bootinfo.h>
+#endif
+
 #include "thermal_hwmon.h"
 
 #define LOONGSON2_MAX_SENSOR_SEL_NUM	3
@@ -36,6 +42,11 @@
  */
 #define LS2K2000_THSENS_OUT_FLAG	BIT(0)
 
+#define LS2K3000_THSENS_CTRL_BASE	0x1fe01460
+#define LS2K3000_THSENS_CTRL_SIZE	0x30
+#define LS2K3000_THSENS_OUT_BASE	0x1fe0019c
+#define LS2K3000_THSENS_OUT_SIZE	0x4
+
 struct loongson2_thermal_chip_data {
 	unsigned int thermal_sensor_sel;
 	unsigned int flags;
@@ -122,19 +133,65 @@
 	.set_trips = loongson2_thermal_set_trips,
 };
 
+static void loongson2_thermal_zone_unregister(void *tzd)
+{
+	thermal_zone_device_unregister(tzd);
+}
+
+static struct thermal_zone_device *
+loongson2_thermal_zone_register(struct device *dev,
+				struct loongson2_thermal_data *data,
+				const struct thermal_zone_device_ops *ops)
+{
+	struct thermal_zone_device *tzd;
+	int ret, i;
+
+	if (dev->of_node) {
+		for (i = 0; i <= LOONGSON2_MAX_SENSOR_SEL_NUM; i++) {
+			tzd = devm_thermal_of_zone_register(dev, i, data, ops);
+
+			if (!IS_ERR(tzd))
+				return tzd;
+
+			if (PTR_ERR(tzd) != -ENODEV)
+				continue;
+
+			return ERR_CAST(tzd);
+		}
+
+		return ERR_PTR(-ENODEV);
+	}
+
+	tzd = thermal_tripless_zone_device_register("loongson2_thermal",
+						    data, ops, NULL);
+	if (IS_ERR(tzd))
+		return tzd;
+
+	ret = devm_add_action_or_reset(dev, loongson2_thermal_zone_unregister,
+				       tzd);
+	if (ret)
+		return ERR_PTR(ret);
+
+	return tzd;
+}
+
 static int loongson2_thermal_probe(struct platform_device *pdev)
 {
 	const struct thermal_zone_device_ops *thermal_ops;
 	struct device *dev = &pdev->dev;
 	struct loongson2_thermal_data *data;
 	struct thermal_zone_device *tzd;
-	int ret, irq, i;
+	int ret, irq;
 
 	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
 	if (!data)
 		return -ENOMEM;
 
 	data->chip_data = device_get_match_data(dev);
+	if (!data->chip_data)
+		data->chip_data = dev_get_platdata(dev);
+	if (!data->chip_data)
+		return dev_err_probe(dev, -ENODEV, "missing chip data\n");
 
 	data->ctrl_reg = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(data->ctrl_reg))
@@ -151,31 +208,30 @@
 		thermal_ops = &loongson2_2k1000_of_thermal_ops;
 	}
 
-	irq = platform_get_irq(pdev, 0);
-	if (irq < 0)
+	irq = platform_get_irq_optional(pdev, 0);
+	if (irq < 0 && irq != -ENXIO)
 		return irq;
 
-	writeb(LOONGSON2_THSENS_INT_EN, data->ctrl_reg + LOONGSON2_THSENS_STATUS_REG);
+	if (irq >= 0)
+		writeb(LOONGSON2_THSENS_INT_EN,
+		       data->ctrl_reg + LOONGSON2_THSENS_STATUS_REG);
 
 	loongson2_thermal_set(data, 0, 0, false);
 
-	for (i = 0; i <= LOONGSON2_MAX_SENSOR_SEL_NUM; i++) {
-		tzd = devm_thermal_of_zone_register(dev, i, data, thermal_ops);
-
-		if (!IS_ERR(tzd))
-			break;
-
-		if (PTR_ERR(tzd) != -ENODEV)
-			continue;
-
-		return dev_err_probe(dev, PTR_ERR(tzd), "failed to register");
+	tzd = loongson2_thermal_zone_register(dev, data, thermal_ops);
+	if (IS_ERR(tzd))
+		return dev_err_probe(dev, PTR_ERR(tzd), "failed to register\n");
+
+	if (irq >= 0) {
+		ret = devm_request_threaded_irq(dev, irq, NULL,
+						loongson2_thermal_irq_thread,
+						IRQF_ONESHOT,
+						"loongson2_thermal", tzd);
+		if (ret < 0)
+			return dev_err_probe(dev, ret,
+					     "failed to request alarm irq\n");
 	}
 
-	ret = devm_request_threaded_irq(dev, irq, NULL, loongson2_thermal_irq_thread,
-					IRQF_ONESHOT, "loongson2_thermal", tzd);
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "failed to request alarm irq\n");
-
 	devm_thermal_add_hwmon_sysfs(dev, tzd);
 
 	return 0;
@@ -204,6 +260,53 @@
 };
 MODULE_DEVICE_TABLE(of, of_loongson2_thermal_match);
 
+#ifdef CONFIG_ACPI
+static struct platform_device *loongson2_thermal_acpi_pdev;
+
+static const struct resource loongson2_thermal_acpi_resources[] = {
+	DEFINE_RES_MEM(LS2K3000_THSENS_CTRL_BASE, LS2K3000_THSENS_CTRL_SIZE),
+	DEFINE_RES_MEM(LS2K3000_THSENS_OUT_BASE, LS2K3000_THSENS_OUT_SIZE),
+};
+
+static bool loongson2_thermal_acpi_fallback_needed(void)
+{
+#ifdef CONFIG_LOONGARCH
+	if (acpi_disabled || !loongson_sysconf.cpuname)
+		return false;
+
+	return !strcmp(loongson_sysconf.cpuname, "Loongson-2K3000");
+#else
+	return false;
+#endif
+}
+
+static void loongson2_thermal_acpi_register(void)
+{
+	if (!loongson2_thermal_acpi_fallback_needed())
+		return;
+
+	loongson2_thermal_acpi_pdev =
+		platform_device_register_resndata(NULL, "loongson2_thermal",
+			PLATFORM_DEVID_NONE, loongson2_thermal_acpi_resources,
+			ARRAY_SIZE(loongson2_thermal_acpi_resources),
+			&loongson2_thermal_ls2k2000_data,
+			sizeof(loongson2_thermal_ls2k2000_data));
+	if (IS_ERR(loongson2_thermal_acpi_pdev)) {
+		pr_warn("failed to register ACPI fallback device: %pe\n",
+			loongson2_thermal_acpi_pdev);
+		loongson2_thermal_acpi_pdev = NULL;
+	}
+}
+
+static void loongson2_thermal_acpi_unregister(void)
+{
+	platform_device_unregister(loongson2_thermal_acpi_pdev);
+}
+#else
+static inline void loongson2_thermal_acpi_register(void) { }
+static inline void loongson2_thermal_acpi_unregister(void) { }
+#endif
+
 static struct platform_driver loongson2_thermal_driver = {
 	.driver = {
 		.name		= "loongson2_thermal",
@@ -211,7 +314,27 @@
 	},
 	.probe	= loongson2_thermal_probe,
 };
-module_platform_driver(loongson2_thermal_driver);
+
+static int __init loongson2_thermal_init(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&loongson2_thermal_driver);
+	if (ret)
+		return ret;
+
+	loongson2_thermal_acpi_register();
+
+	return 0;
+}
+module_init(loongson2_thermal_init);
+
+static void __exit loongson2_thermal_exit(void)
+{
+	loongson2_thermal_acpi_unregister();
+	platform_driver_unregister(&loongson2_thermal_driver);
+}
+module_exit(loongson2_thermal_exit);
 
 MODULE_DESCRIPTION("Loongson2 thermal driver");
 MODULE_AUTHOR("Loongson Technology Corporation Limited");
