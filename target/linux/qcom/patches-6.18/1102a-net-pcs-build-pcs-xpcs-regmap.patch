From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] net: pcs: build XPCS regmap helper

The TC956x DWMAC driver uses devm_xpcs_regmap_register(). Include the
regmap helper in the PCS XPCS module to provide the symbol.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/drivers/net/pcs/Makefile
+++ b/drivers/net/pcs/Makefile
@@ -3,7 +3,7 @@
 
 obj-$(CONFIG_FWNODE_PCS)	+= pcs.o
 pcs_xpcs-$(CONFIG_PCS_XPCS)	:= pcs-xpcs.o pcs-xpcs-plat.o \
-				   pcs-xpcs-nxp.o pcs-xpcs-wx.o
+				   pcs-xpcs-nxp.o pcs-xpcs-regmap.o pcs-xpcs-wx.o
 
 obj-$(CONFIG_PCS_XPCS)		+= pcs_xpcs.o
 obj-$(CONFIG_PCS_LYNX)		+= pcs-lynx.o
