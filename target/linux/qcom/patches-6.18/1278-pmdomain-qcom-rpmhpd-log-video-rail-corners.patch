From: lean <chenlin@fnnas.com>
Subject: [PATCH] pmdomain: qcom: rpmhpd: log video rail corners

Log MX and MMCX performance requests and aggregated active/sleep corners.
This makes it possible to verify the actual RPMh votes immediately before
an abrupt PMIC reset during sustained video decoding.

Signed-off-by: lean <chenlin@fnnas.com>
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -832,6 +832,11 @@
 		*sleep = *active;
 }
 
+static bool rpmhpd_trace_video_rail(struct rpmhpd *pd)
+{
+	return !strcmp(pd->pd.name, "mx") || !strcmp(pd->pd.name, "mmcx");
+}
+
 /*
  * This function is used to aggregate the votes across the active only
  * resources and its peers. The aggregated votes are sent to RPMh as
@@ -865,6 +870,17 @@
 	}
 
 	active_corner = max(this_active_corner, peer_active_corner);
+	if (peer)
+		sleep_corner = max(this_sleep_corner, peer_sleep_corner);
+
+	if (rpmhpd_trace_video_rail(pd) &&
+	    (active_corner != pd->active_corner || !pd->state_synced))
+		dev_dbg(pd->dev,
+			 "%s aggregate request=%u active=%u sleep=%u previous=%u synced=%u enabled=%u peer_enabled=%u\n",
+			 pd->pd.name, corner, active_corner,
+			 peer ? sleep_corner : this_sleep_corner,
+			 pd->active_corner, pd->state_synced, pd->enabled,
+			 peer && peer->enabled);
 
 	ret = rpmhpd_send_corner(pd, RPMH_ACTIVE_ONLY_STATE, active_corner,
 				 active_corner > pd->active_corner);
@@ -881,8 +897,6 @@
 		if (ret)
 			return ret;
 
-		sleep_corner = max(this_sleep_corner, peer_sleep_corner);
-
 		return rpmhpd_send_corner(pd, RPMH_SLEEP_STATE, sleep_corner,
 					  false);
 	}
@@ -943,6 +957,12 @@
 	if (i == pd->level_count)
 		i--;
 
+	if (rpmhpd_trace_video_rail(pd) && i != pd->corner)
+		dev_dbg(pd->dev,
+			 "%s performance level=%u corner=%d hlvl=%u previous=%u enabled=%u synced=%u\n",
+			 pd->pd.name, level, i, pd->level[i], pd->corner,
+			 pd->enabled, pd->state_synced);
+
 	if (pd->enabled) {
 		/* Ensure that the domain isn't turn off */
 		if (i < pd->enable_corner)
