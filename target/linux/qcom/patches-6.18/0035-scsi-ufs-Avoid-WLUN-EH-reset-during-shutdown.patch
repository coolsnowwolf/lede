--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -7590,6 +7590,16 @@ static int ufshcd_eh_device_reset_handle
 	host = cmd->device->host;
 	hba = shost_priv(host);
 
+	/*
+	 * During shutdown, a timed out START STOP UNIT sent to the device W-LUN
+	 * can make the SCSI EH continue into LU reset. At this point the device
+	 * is already transitioning into power down and issuing UFS_LOGICAL_RESET
+	 * / link recovery may trigger controller-side failures instead of helping.
+	 */
+	if (cmd->device == hba->ufs_device_wlun &&
+	    (hba->shutting_down || hba->pm_op_in_progress))
+		return SUCCESS;
+
 	lun = ufshcd_scsi_to_upiu_lun(cmd->device->lun);
 	err = ufshcd_issue_tm_cmd(hba, lun, 0, UFS_LOGICAL_RESET, &resp);
 	if (err || resp != UPIU_TASK_MANAGEMENT_FUNC_COMPL) {
@@ -7808,6 +7818,7 @@ static int ufshcd_abort(struct scsi_cmnd
 		hba->force_reset = true;
 		ufshcd_schedule_eh_work(hba);
 		spin_unlock_irqrestore(host->host_lock, flags);
+		err = SUCCESS;
 		goto release;
 	}
 
