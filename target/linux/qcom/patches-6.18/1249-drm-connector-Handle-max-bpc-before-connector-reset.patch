From 6fb841ebd8f56968c663715ffbc7e08d41b9405a Mon Sep 17 00:00:00 2001
From: Xilin Wu <sophon@radxa.com>
Date: Thu, 14 May 2026 22:11:06 +0800
Subject: [PATCH 249/268] drm/connector: Handle max bpc before connector reset

drm_connector_attach_max_bpc_property() assumes that connector state
already exists and writes the default max value into it. That makes
callers crash if they attach max bpc before the first reset.

Store the maximum on the connector and update connector state only when
it exists. Seed new connector state from that value in the atomic helper
reset path, so the default survives later resets.

Signed-off-by: Xilin Wu <sophon@radxa.com>
---
 drivers/gpu/drm/drm_atomic_state_helper.c | 5 +++++
 drivers/gpu/drm/drm_connector.c           | 7 +++++--
 2 files changed, 10 insertions(+), 2 deletions(-)

--- a/drivers/gpu/drm/drm_atomic_state_helper.c
+++ b/drivers/gpu/drm/drm_atomic_state_helper.c
@@ -476,6 +476,11 @@ void drm_atomic_helper_connector_reset(s
 
 	kfree(connector->state);
 	__drm_atomic_helper_connector_reset(connector, conn_state);
+
+	if (connector->state && connector->max_bpc_property) {
+		connector->state->max_requested_bpc = connector->max_bpc;
+		connector->state->max_bpc = connector->max_bpc;
+	}
 }
 EXPORT_SYMBOL(drm_atomic_helper_connector_reset);
 
--- a/drivers/gpu/drm/drm_connector.c
+++ b/drivers/gpu/drm/drm_connector.c
@@ -2837,9 +2837,12 @@ int drm_connector_attach_max_bpc_propert
 		connector->max_bpc_property = prop;
 	}
 
+	connector->max_bpc = max;
 	drm_object_attach_property(&connector->base, prop, max);
-	connector->state->max_requested_bpc = max;
-	connector->state->max_bpc = max;
+	if (connector->state) {
+		connector->state->max_requested_bpc = max;
+		connector->state->max_bpc = max;
+	}
 
 	return 0;
 }
