#!/bin/sh

cat <<-EOF >/etc/opkg.conf
dest root /
dest ram /tmp
lists_dir ext /var/opkg-lists
option overlay_root /overlay
EOF

cat <<-EOF >/etc/opkg/distfeeds.conf
src/gz openwrt_base http://mirrors.pku.edu.cn/immortalwrt/releases/24.10.5/packages/aarch64_generic/base
src/gz openwrt_luci http://mirrors.pku.edu.cn/immortalwrt/releases/24.10.5/packages/aarch64_generic/luci
src/gz openwrt_packages http://mirrors.pku.edu.cn/immortalwrt/releases/24.10.5/packages/aarch64_generic/packages
src/gz openwrt_routing http://mirrors.pku.edu.cn/immortalwrt/releases/24.10.5/packages/aarch64_generic/routing
src/gz openwrt_telephony http://mirrors.pku.edu.cn/immortalwrt/releases/24.10.5/packages/aarch64_generic/telephony
EOF

exit 0
