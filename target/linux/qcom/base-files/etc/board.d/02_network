#!/bin/sh

. /lib/functions.sh
. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh

qcom_generate_macaddr_from_dmi_product_uuid()
{
	local uuid_path="/sys/class/dmi/id/product_uuid"
	local uuid_hash
	local mac_base

	[ -r "$uuid_path" ] || return

	uuid_hash=$(tr -d '-' < "$uuid_path" 2>/dev/null | sha256sum)
	mac_base=$(macaddr_canonicalize "$(echo "${uuid_hash}" | dd bs=1 count=12 2>/dev/null)")
	echo "$(macaddr_unsetbit_mc "$(macaddr_setbit_la "${mac_base}")")"
}

qcom_setup_interfaces()
{
	local board="$1"

	case "$board" in
	radxa,dragon-q8b)
		ucidef_set_interfaces_lan_wan "eth0" "eth1"
		;;
	esac
}

qcom_setup_macs()
{
	local board="$1"
	local lan_mac wan_mac

	case "$board" in
	radxa,dragon-q8b)
		lan_mac="$(qcom_generate_macaddr_from_dmi_product_uuid)"
		[ -n "$lan_mac" ] || return
		wan_mac="$(macaddr_add "$lan_mac" 1)"

		ucidef_set_interface_macaddr "lan" "$lan_mac"
		ucidef_set_interface_macaddr "wan" "$wan_mac"
		;;
	esac
}

board_config_update
board="$(board_name)"
qcom_setup_interfaces "$board"
qcom_setup_macs "$board"
board_config_flush

exit 0
