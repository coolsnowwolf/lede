From: pbs05 <27010143+pbs05@users.noreply.github.com>
Subject: [PATCH] pinctrl: airoha: split PON TX_DISABLE GPIO on AN7583

The Nokia XG-040G-MF routes its active-low board TX_DISABLE signal to
GPIO15 while using the primary AN7583 PON pin group.  Keep the existing
complete group and add a board-oriented group which sets the same PON mux
but leaves GPIO15 available to the optical frontend driver.

Signed-off-by: pbs05 <27010143+pbs05@users.noreply.github.com>

Signed-off-by: lean <chenlin@fnnas.com>
---
 drivers/pinctrl/airoha/pinctrl-an7583.c | 23 +++++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

--- a/drivers/pinctrl/airoha/pinctrl-an7583.c
+++ b/drivers/pinctrl/airoha/pinctrl-an7583.c
@@ -393,6 +393,13 @@
 };
 
 static const int pon_pins[] = { 15, 16, 17, 18, 19, 20 };
+/*
+ * GPIO15 carries the active-low TX_DISABLE signal on XG-040G-MF.
+ * The SCU PON mode applies to the complete group while the output level
+ * remains controlled by the GPIO data register. Excluding GPIO15 gives
+ * the optical frontend exclusive ownership of the signal.
+ */
+static const int pon_tx_disable_gpio_pins[] = { 15, 16, 18, 19, 20 };
 static const int pon_alt_pins[] = { 36, 37, 38, 39, 40 };
 static const int olt_pins[] = { 36, 37, 38, 39, 40 };
 static const int pon_tod_1pps_pins[] = { 32 };
@@ -484,6 +491,7 @@
 
 static const struct pingroup pinctrl_groups[] = {
 	PINCTRL_PIN_GROUP("pon", pon),
+	PINCTRL_PIN_GROUP("pon_tx_disable_gpio", pon_tx_disable_gpio),
 	PINCTRL_PIN_GROUP("pon_alt", pon_alt),
 	PINCTRL_PIN_GROUP("olt", olt),
 	PINCTRL_PIN_GROUP("pon_tod_1pps", pon_tod_1pps),
@@ -570,7 +578,9 @@
 	PINCTRL_PIN_GROUP("pcie_reset1", pcie_reset1),
 };
 
-static const char *const pon_groups[] = { "pon", "pon_alt" };
+static const char *const pon_groups[] = {
+	"pon", "pon_tx_disable_gpio", "pon_alt"
+};
 static const char *const olt_groups[] = { "olt" };
 static const char *const tod_1pps_groups[] = {
 	"pon_tod_1pps", "gsw_tod_1pps"
@@ -639,6 +649,15 @@
 		.regmap[0] = {
 			AIROHA_FUNC_MUX,
 			REG_GPIO_PON_MODE,
+			GPIO_PON_MODE_MASK | GPIO_PON_ALT_MODE_MASK,
+			GPIO_PON_MODE_MASK
+		},
+		.regmap_size = 1,
+	}, {
+		.name = "pon_tx_disable_gpio",
+		.regmap[0] = {
+			AIROHA_FUNC_MUX,
+			REG_GPIO_PON_MODE,
 			GPIO_PON_MODE_MASK | GPIO_PON_ALT_MODE_MASK,
 			GPIO_PON_MODE_MASK
 		},
