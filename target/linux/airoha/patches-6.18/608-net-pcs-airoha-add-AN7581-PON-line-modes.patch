+
+int an7583_pcs_pon_start_rx(struct airoha_pcs_priv *priv, int index,
+			    phy_interface_t interface)
+{
+	/* Configure the PMA under digital reset, then start the PLL and TX. */
+	an7583_pcs_dig_reset_hold(priv, index);
+	an7583_pcs_cfg_phy_type(priv, index, interface);
+	an7583_pcs_common_phya_txpll_on(priv, index);
+	an7583_pcs_common_phya_tx_on(priv, index);
+
+	/* FIRST_PLUG_IN calibrates RX, enters L2D and releases digital reset. */
+	an7583_pcs_first_plug_in(priv, index, interface);
+
+	return 0;
+}
+
+int an7583_pcs_pon_retrain_rx(struct airoha_pcs_priv *priv, int index,
+			      phy_interface_t interface)
+{
+	struct regmap *pcs_pma = priv->pcs_pma[index];
+
+	/* PLUG_IN reuses the initial calibration and restarts RX and TDC. */
+	an7583_pcs_dig_reset_hold(priv, index);
+	an7583_pcs_pon_l2d(priv, index);
+	an7583_pcs_pon_tdc_on(priv, index);
+	an7583_pcs_dig_reset_release(priv, index);
+	an7583_pcs_common_phya_rxrdy(priv, index);
+	an7583_pcs_common_phya_phy_status(priv, index);
+	regmap_clear_bits(pcs_pma, AIROHA_PCS_PMA_ADD_XPON_MODE_1,
+			  AIROHA_PCS_PMA_TX_BIST_GEN_EN |
+			  AIROHA_PCS_PMA_R2T_MODE);
+
+	return 0;
+}
+
+int an7583_pcs_pon_stop_rx(struct airoha_pcs_priv *priv, int index)
+{
+	/* PLUG_OUT stops TDC, resets FLL and returns CDR to reference lock. */
+	an7583_pcs_common_phya_tdc_off(priv, index);
+	an7583_pcs_pon_fll_reset(priv, index);
+	an7583_pcs_pon_l2r(priv, index);
+
+	return 0;
+}
 
