+enum an7581_pon_stage {
+	AN7581_PON_STAGE_IDLE,
+	AN7581_PON_STAGE_STATIC,
+	AN7581_PON_STAGE_PRCAL,
+	AN7581_PON_STAGE_OSCAL,
+	AN7581_PON_STAGE_PICAL,
+	AN7581_PON_STAGE_PDOS,
+	AN7581_PON_STAGE_FEOS,
+	AN7581_PON_STAGE_SDCAL,
+	AN7581_PON_STAGE_EO_SCAN,
+	AN7581_PON_STAGE_TDC,
+	AN7581_PON_STAGE_RX_READY,
+	AN7581_PON_STAGE_PLUG_OUT,
+	AN7581_PON_STAGE_FAILED,
+};
