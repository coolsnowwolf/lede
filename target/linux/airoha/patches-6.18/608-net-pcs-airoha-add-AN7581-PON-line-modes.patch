From a84acb2649330a336c7d39f5a4ddda0979053226 Mon Sep 17 00:00:00 2001
From: pbs05 <27010143+pbs05@users.noreply.github.com>
Date: Sat, 29 Aug 2026 12:00:00 +0800
Subject: [PATCH] net: pcs: airoha: add PON line modes and variant lifecycle

Add GPON, XG-PON, XGS-PON, 10G/1G and 10G/10G EPON line modes to the
Airoha PCS provider. Variant callbacks select the receiver calibration
sequence and register layout used by AN7581 and AN7583.

Signed-off-by: pbs05 <27010143+pbs05@users.noreply.github.com>
Signed-off-by: lean <chenlin@fnnas.com>
---

--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
+++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
@@ -5,9 +5,11 @@
  */
 
 #include <linux/device.h>
+#include <linux/delay.h>
 #include <linux/mfd/syscon.h>
 #include <linux/of.h>
 #include <linux/of_platform.h>
+#include <linux/pcs/pcs-airoha.h>
 #include <linux/pcs/pcs-provider.h>
 #include <linux/phy/phy.h>
 #include <linux/phylink.h>
