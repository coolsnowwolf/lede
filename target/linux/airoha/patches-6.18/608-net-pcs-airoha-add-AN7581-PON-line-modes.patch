+
+int an7583_pcs_pon_init(struct airoha_pcs_priv *priv)
+{
+	struct device *dev = priv->dev;
+	u32 value;
+	int ret;
+
+	ret = nvmem_cell_read_variable_le_u32(dev, "pon-impedance-valid",
+					      &value);
+	if (ret)
+		return ret;
+
+	if (!value)
+		return 0;
+
+	ret = nvmem_cell_read_variable_le_u32(dev, "pon-tx-term",
+					      &value);
+	if (ret)
+		return ret;
+	priv->pon_tx_term_sel = value;
+
+	ret = nvmem_cell_read_variable_le_u32(dev, "pon-rx-impedance",
+					      &value);
+	if (ret)
+		return ret;
+	priv->pon_rx_term_sel = value;
+	priv->pon_impedance_valid = true;
+
+	dev_dbg(dev, "PON impedance trims: TX=%u RX=%u\n",
+		priv->pon_tx_term_sel, priv->pon_rx_term_sel);
+
+	return 0;
+}
