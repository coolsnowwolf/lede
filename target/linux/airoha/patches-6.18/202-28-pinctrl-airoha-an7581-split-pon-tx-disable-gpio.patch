From: pbs05 <27010143+pbs05@users.noreply.github.com>
Subject: [PATCH] pinctrl: airoha: split PON TX_DISABLE GPIO on AN7581

The Nokia XG-040G board uses GPIO38 as an active-high board-level
TX_DISABLE signal. The global PON mode leaves its output level under the
GPIO data path. Add a pin group which omits GPIO38 so the optical frontend
can control that line through the GPIO descriptor API.

Signed-off-by: pbs05 <27010143+pbs05@users.noreply.github.com>

Signed-off-by: lean <chenlin@fnnas.com>
---
 drivers/pinctrl/airoha/pinctrl-an7581.c | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

--- a/drivers/pinctrl/airoha/pinctrl-an7581.c
+++ b/drivers/pinctrl/airoha/pinctrl-an7581.c
@@ -378,6 +378,14 @@ static struct pinctrl_pin_desc pinctrl_p
 };
 
 static const int pon_pins[] = { 49, 50, 51, 52, 53, 54 };
+/*
+ * GPIO38 carries the active-high TX_DISABLE signal on Nokia XG-040G.
+ * The PON mux applies to the complete group while the output level remains
+ * controlled by the GPIO data register. Excluding GPIO38 gives the
+ * optical frontend exclusive ownership without changing the remaining PON
+ * signals.
+ */
+static const int pon_tx_disable_gpio_pins[] = { 49, 50, 52, 53, 54 };
 static const int pon_tod_1pps_pins[] = { 46 };
 static const int gsw_tod_1pps_pins[] = { 46 };
 static const int sipo_pins[] = { 16, 17 };
@@ -467,6 +476,7 @@ static const int pcie_reset2_pins[] = {
 
 static const struct pingroup pinctrl_groups[] = {
 	PINCTRL_PIN_GROUP("pon", pon),
+	PINCTRL_PIN_GROUP("pon_tx_disable_gpio", pon_tx_disable_gpio),
 	PINCTRL_PIN_GROUP("pon_tod_1pps", pon_tod_1pps),
 	PINCTRL_PIN_GROUP("gsw_tod_1pps", gsw_tod_1pps),
 	PINCTRL_PIN_GROUP("sipo", sipo),
@@ -556,7 +566,9 @@ static const struct pingroup pinctrl_gro
 	PINCTRL_PIN_GROUP("pcie_reset2", pcie_reset2),
 };
 
-static const char *const pon_groups[] = { "pon" };
+static const char *const pon_groups[] = {
+	"pon", "pon_tx_disable_gpio"
+};
 static const char *const tod_1pps_groups[] = {
 	"pon_tod_1pps", "gsw_tod_1pps"
 };
@@ -632,6 +643,14 @@ static const struct airoha_pinctrl_func_
 		},
 		.regmap_size = 1,
 	},
+	{
+		.name = "pon_tx_disable_gpio",
+		.regmap[0] = {
+			AIROHA_FUNC_MUX, REG_GPIO_PON_MODE,
+			GPIO_PON_MODE_MASK, GPIO_PON_MODE_MASK
+		},
+		.regmap_size = 1,
+	},
 };
 
 static const struct airoha_pinctrl_func_group tod_1pps_func_group[] = {
