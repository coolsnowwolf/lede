+static void mtk_nfc_hw_reset_en7581(struct mtk_nfc *nfc)
+{
+	u32 val;
+	int ret;
+
+	/*
+	 * EN7581 resets the command, address, and data state machines together.
+	 * Wait for all three states after the FIFO reset.
+	 * NFI_STRDATA belongs to the alternate launch path.
+	 */
+	nfi_writel(nfc, CON_FIFO_FLUSH | CON_NFI_RST, NFI_CON);
+	ret = readl_poll_timeout(nfc->regs + NFI_STA, val,
+				 !(val & GENMASK(3, 0)), 10, MTK_RESET_TIMEOUT);
+	if (ret)
+		dev_warn(nfc->dev, "EN7581 NFI reset timeout: sta=0x%08x\n",
+			 val);
+
+	nfi_writel(nfc, CON_FIFO_FLUSH | CON_NFI_RST, NFI_CON);
+}
+
+static void mtk_nfc_hw_reset(struct mtk_nfc *nfc)
+{
+	nfc->caps->soc_ops->hw_reset(nfc);
