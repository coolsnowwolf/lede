+static void mtk_nfc_en7581_clear_config(struct mtk_nfc *nfc)
+{
+	u32 reg;
+
+	reg = nfi_readl(nfc, NFI_CNFG);
+	reg &= ~(CNFG_AHB | CNFG_READ_EN | CNFG_DMA_BURST_EN |
+		 CNFG_BYTE_RW | CNFG_HW_ECC_EN | CNFG_AUTO_FMT_EN |
+		 CNFG_OP_MASK);
+	nfi_writel(nfc, reg | CNFG_OP_IDLE, NFI_CNFG);
+}
+
+static int mtk_nfc_en7581_issue_command(struct mtk_nfc *nfc, u8 command)
+{
+	u32 mode = CNFG_OP_IDLE;
+	u32 reg, status;
+	int ret;
+
+	switch (command) {
+	case NAND_CMD_READ0:
+	case NAND_CMD_RNDOUT:
+		mode = CNFG_OP_READ;
+		break;
+	case NAND_CMD_SEQIN:
+	case NAND_CMD_SET_FEATURES:
+		mode = CNFG_OP_PRGM;
+		break;
+	case NAND_CMD_ERASE1:
+		mode = CNFG_OP_ERASE;
+		break;
+	case NAND_CMD_READID:
+	case NAND_CMD_STATUS:
+	case NAND_CMD_PARAM:
+	case NAND_CMD_GET_FEATURES:
+		mode = CNFG_OP_SINGLE_READ;
+		break;
+	default:
+		break;
+	}
+
+	/*
+	 * These bits define the data direction for each command.
+	 * Clear DMA, auto-format, and ECC state before a short operation.
+	 */
+	reg = nfi_readl(nfc, NFI_CNFG);
+	reg &= ~(CNFG_AHB | CNFG_READ_EN | CNFG_DMA_BURST_EN |
+		 CNFG_BYTE_RW | CNFG_HW_ECC_EN | CNFG_AUTO_FMT_EN |
+		 CNFG_OP_MASK);
+	if (mode == CNFG_OP_READ || mode == CNFG_OP_SINGLE_READ)
+		reg |= CNFG_READ_EN;
+	nfi_writel(nfc, reg | mode, NFI_CNFG);
+
+	nfi_writel(nfc, command, NFI_CMD);
+	ret = readl_poll_timeout_atomic(nfc->regs + NFI_STA, status,
+					!(status & STA_CMD), 10, MTK_TIMEOUT);
+	if (ret)
+		dev_err(nfc->dev,
+			"EN7581 command 0x%02x timeout: sta=0x%08x\n",
+			command, status);
+
+	return ret;
+}
+
+static int mtk_nfc_en7581_issue_address(struct nand_chip *chip, u8 command,
+					const u8 *addrs, unsigned int naddrs)
+{
+	struct mtk_nfc *nfc = nand_get_controller_data(chip);
+	struct mtd_info *mtd = nand_to_mtd(chip);
+	unsigned int col_nob, row_nob, i;
+	u32 col = 0, row = 0, status;
+	int ret;
+
+	if (!naddrs)
+		return 0;
+
+	if (command == NAND_CMD_ERASE1) {
+		col_nob = 0;
+	} else if (command == NAND_CMD_READID ||
+		   command == NAND_CMD_SET_FEATURES ||
+		   command == NAND_CMD_GET_FEATURES) {
+		col_nob = naddrs;
+	} else {
+		col_nob = min_t(unsigned int, naddrs,
+				mtd->writesize > 512 ? 2 : 1);
+	}
+	row_nob = naddrs - col_nob;
+
+	if (col_nob > 4 || row_nob > 4)
+		return -EOPNOTSUPP;
+
+	for (i = 0; i < col_nob; i++)
+		col |= addrs[i] << (8 * i);
+	for (i = 0; i < row_nob; i++)
+		row |= addrs[col_nob + i] << (8 * i);
+
+	/*
+	 * EN7581 latches column, row, and both cycle counts on the ADDRNOB write.
+	 * Program the complete address before that write.
+	 */
+	nfi_writel(nfc, col, NFI_COLADDR);
+	nfi_writel(nfc, row, NFI_ROWADDR);
+	nfi_writel(nfc, FIELD_PREP(ADDR_COL_NOB_MASK, col_nob) |
+			   FIELD_PREP(ADDR_ROW_NOB_MASK, row_nob),
+		   NFI_ADDRNOB);
+
+	ret = readl_poll_timeout_atomic(nfc->regs + NFI_STA, status,
+					!(status & (STA_CMD | STA_ADDR)),
+					10, MTK_TIMEOUT);
+	if (ret)
+		dev_err(nfc->dev,
+			"EN7581 address timeout: col=%u row=%u sta=0x%08x\n",
+			col_nob, row_nob, status);
+
+	return ret;
+}
+
+static int mtk_nfc_en7581_read_data(struct mtk_nfc *nfc, u8 *buf, size_t len)
+{
+	dma_addr_t addr;
+	u32 count, reg, status;
+	int ret;
+
+	if (!len || len > EN7581_SHORT_IO_BUF_SIZE)
+		return -EOPNOTSUPP;
+
+	memset(nfc->short_io_buf, 0xff, len);
+	addr = dma_map_single(nfc->dev, nfc->short_io_buf, len,
+			      DMA_FROM_DEVICE);
+	if (dma_mapping_error(nfc->dev, addr))
+		return -EIO;
+
+	/*
+	 * Short reads use the AHB data path.
+	 * Custom sector size and byte count bound the DMA transfer, while the
+	 * 4 KiB scratch buffer bounds the controller write range.
+	 */
+	reg = nfi_readl(nfc, NFI_CNFG);
+	reg &= ~CNFG_BYTE_RW;
+	reg |= CNFG_AHB | CNFG_READ_EN;
+	nfi_writel(nfc, reg, NFI_CNFG);
+	nfi_writel(nfc, FIELD_PREP(EN7581_SECCUS_SIZE_MASK, len) |
+			   EN7581_SECCUS_SIZE_EN,
+		   NFI_EN7581_SECCUS_SIZE);
+
+	reg = nfi_readl(nfc, NFI_EN7581_MISC_CTL2);
+	reg &= ~EN7581_RD_BYTE_NUM;
+	reg |= FIELD_PREP(EN7581_RD_BYTE_NUM, len);
+	nfi_writel(nfc, reg, NFI_EN7581_MISC_CTL2);
+
+	nfi_readl(nfc, NFI_INTR_STA);
+	/*
+	 * RD_CNT tracks completion of one parallel NFI transaction.
+	 * Clear it before DMA so the count belongs to the current short read
+	 * after AHB completion.
+	 */
+	nfi_writel(nfc, EN7581_CNT_CLR_RD, NFI_EN7581_CNT_CLR);
+	nfi_writel(nfc, lower_32_bits(addr), NFI_STRADDR);
+	nfi_writel(nfc, FIELD_PREP(CON_SEC_MASK, 1), NFI_CON);
+	nfi_writel(nfc, FIELD_PREP(CON_SEC_MASK, 1) | CON_BRD, NFI_CON);
+
+	ret = readl_poll_timeout_atomic(nfc->regs + NFI_INTR_STA, status,
+					status & INTR_AHB_DONE_EN,
+					10, MTK_TIMEOUT);
+	if (!ret)
+		ret = readl_poll_timeout_atomic(nfc->regs + NFI_EN7581_RD_CNT,
+						count, count == len,
+						1, MTK_TIMEOUT);
+	if (ret) {
+		count = nfi_readl(nfc, NFI_EN7581_RD_CNT);
+		dev_err(nfc->dev,
+			"EN7581 short read timeout: expected=%zu count=%u intr=0x%08x\n",
+			len, count, status);
+	}
+
+	dma_unmap_single(nfc->dev, addr, len, DMA_FROM_DEVICE);
+	nfi_writel(nfc, 0, NFI_CON);
+	nfi_writel(nfc, 0, NFI_EN7581_SECCUS_SIZE);
+	if (!ret)
+		memcpy(buf, nfc->short_io_buf, len);
+	mtk_nfc_en7581_clear_config(nfc);
+
+	return ret;
+}
+
+static int mtk_nfc_en7581_write_data(struct mtk_nfc *nfc, const u8 *buf,
+				     size_t len)
+{
+	u32 reg, status;
+	size_t done = 0;
+	unsigned int chunk, i;
+	int ret;
+
+	reg = nfi_readl(nfc, NFI_CNFG);
+	reg &= ~(CNFG_AHB | CNFG_DMA_BURST_EN | CNFG_READ_EN);
+	reg |= CNFG_BYTE_RW;
+	nfi_writel(nfc, reg, NFI_CNFG);
+
+	while (done < len) {
+		chunk = min_t(size_t, len - done, 7);
+		reg = FIELD_PREP(CON_NOB_MASK, chunk);
+		nfi_writel(nfc, reg, NFI_CON);
+
+		for (i = 0; i < chunk; i++) {
+			ret = readl_poll_timeout_atomic(nfc->regs + NFI_PIO_DIRDY,
+							status,
+							status & PIO_DI_RDY,
+							10, MTK_TIMEOUT);
+			if (ret)
+				return ret;
+			nfi_writeb(nfc, buf[done + i], NFI_DATAW);
+		}
+		done += chunk;
+	}
+
+	nfi_writel(nfc, 0, NFI_CON);
+	mtk_nfc_en7581_clear_config(nfc);
+
+	return 0;
+}
+
+static int mtk_nfc_exec_op_en7581(struct nand_chip *chip,
+				  const struct nand_operation *op,
+				  bool check_only)
+{
+	struct mtk_nfc *nfc = nand_get_controller_data(chip);
+	const struct nand_op_instr *instr;
+	u8 addrs[8], command = NAND_CMD_RESET;
+	unsigned int naddrs = 0, i, j;
+	u32 status;
+	int ret;
+
+	for (i = 0; i < op->ninstrs; i++) {
+		instr = &op->instrs[i];
+		if (instr->type == NAND_OP_ADDR_INSTR &&
+		    instr->ctx.addr.naddrs > ARRAY_SIZE(addrs))
+			return -EOPNOTSUPP;
+		if ((instr->type == NAND_OP_DATA_IN_INSTR ||
+		     instr->type == NAND_OP_DATA_OUT_INSTR) &&
+		    instr->ctx.data.len > EN7581_SHORT_IO_BUF_SIZE)
+			return -EOPNOTSUPP;
+	}
+	if (check_only)
+		return 0;
+
+	mtk_nfc_hw_reset(nfc);
+	mtk_nfc_select_target(chip, op->cs);
+
+	for (i = 0; i < op->ninstrs; i++) {
+		instr = &op->instrs[i];
+
+		if (naddrs && instr->type != NAND_OP_ADDR_INSTR) {
+			ret = mtk_nfc_en7581_issue_address(chip, command,
+							   addrs, naddrs);
+			if (ret)
+				return ret;
+			naddrs = 0;
+		}
+
+		switch (instr->type) {
+		case NAND_OP_CMD_INSTR:
+			command = instr->ctx.cmd.opcode;
+			ret = mtk_nfc_en7581_issue_command(nfc, command);
+			if (ret)
+				return ret;
+			break;
+		case NAND_OP_ADDR_INSTR:
+			for (j = 0; j < instr->ctx.addr.naddrs; j++)
+				addrs[naddrs++] = instr->ctx.addr.addrs[j];
+			break;
+		case NAND_OP_DATA_IN_INSTR:
+			ret = mtk_nfc_en7581_read_data(nfc,
+						       instr->ctx.data.buf.in,
+					instr->ctx.data.len);
+			if (ret)
+				return ret;
+			break;
+		case NAND_OP_DATA_OUT_INSTR:
+			ret = mtk_nfc_en7581_write_data(nfc,
+							instr->ctx.data.buf.out,
+					 instr->ctx.data.len);
+			if (ret)
