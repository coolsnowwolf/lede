From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] net: airoha: adapt to phylink available PCS array

The phylink backport used by this tree stores the available PCS pointers
directly in phylink_config instead of using fill_available_pcs(). Allocate
and populate the array while setting up each Airoha netdev.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
 drivers/net/ethernet/airoha/airoha_eth.c | 26 ++++++++++++++++----------
 1 file changed, 16 insertions(+), 10 deletions(-)

--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -3768,16 +3768,6 @@ static const struct phylink_mac_ops airo
 	.mac_link_down = airoha_mac_link_down,
 };
 
-static int airoha_fill_available_pcs(struct phylink_config *config,
-				     struct phylink_pcs **available_pcs,
-				     unsigned int num_possible_pcs)
-{
-	struct device *dev = config->dev;
-
-	return fwnode_phylink_pcs_parse(dev_fwnode(dev), available_pcs,
-					&num_possible_pcs);
-}
-
 static int airoha_setup_phylink(struct net_device *netdev)
 {
 	struct airoha_gdm_dev *dev = netdev_priv(netdev);
@@ -3786,6 +3776,7 @@ static int airoha_setup_phylink(struct n
 	struct phylink_config *config;
 	phy_interface_t phy_mode;
 	struct phylink *phylink;
+	unsigned int count;
 	int err;
 
 	err = of_get_phy_mode(np, &phy_mode);
@@ -3814,11 +3805,22 @@ static int airoha_setup_phylink(struct n
 					   MAC_2500FD | MAC_5000FD | MAC_10000FD;
 
 		err = fwnode_phylink_pcs_parse(dev_fwnode(config->dev), NULL,
-					       &dev->phylink_config.num_available_pcs);
+					       &count);
+		if (err)
+			return err;
+
+		config->available_pcs = devm_kcalloc(dev->eth->dev, count,
+						     sizeof(*config->available_pcs),
+						     GFP_KERNEL);
+		if (!config->available_pcs)
+			return -ENOMEM;
+
+		err = fwnode_phylink_pcs_parse(dev_fwnode(config->dev),
+					       config->available_pcs, &count);
 		if (err)
 			return err;
 
-		config->fill_available_pcs = airoha_fill_available_pcs;
+		config->num_available_pcs = count;
 
 		__set_bit(PHY_INTERFACE_MODE_SGMII,
 			  config->supported_interfaces);
