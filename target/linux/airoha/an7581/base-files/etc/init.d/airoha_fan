#!/bin/sh /etc/rc.common

START=99

configure_fan()
{
	local hwmon="$1"

	# Leave the fan at full speed if programming the automatic curve fails.
	echo 255 > "$hwmon/pwm1" || return 1
	echo 1 > "$hwmon/pwm1_enable" || return 1
	echo 40000 > "$hwmon/pwm1_auto_point1_temp" || return 1
	echo 50000 > "$hwmon/pwm1_auto_point2_temp" || return 1
	echo 60000 > "$hwmon/pwm1_auto_point3_temp" || return 1
	echo 70000 > "$hwmon/pwm1_auto_point4_temp" || return 1
	echo 80000 > "$hwmon/pwm1_auto_point5_temp" || return 1
	echo 54 > "$hwmon/pwm1_auto_point1_pwm" || return 1
	echo 69 > "$hwmon/pwm1_auto_point2_pwm" || return 1
	echo 95 > "$hwmon/pwm1_auto_point3_pwm" || return 1
	echo 199 > "$hwmon/pwm1_auto_point4_pwm" || return 1
	echo 2 > "$hwmon/pwm1_enable"
}

boot()
{
	local hwmon

	. /lib/functions.sh
	[ "$(board_name)" = "gemtek,xr1710g" ] || return 0
	for hwmon in /sys/class/hwmon/hwmon*; do
		[ -r "$hwmon/name" ] || continue
		[ "$(cat "$hwmon/name")" = nct7802 ] || continue
		[ -w "$hwmon/pwm1_auto_point5_temp" ] || continue
		configure_fan "$hwmon"
		return $?
	done
}
