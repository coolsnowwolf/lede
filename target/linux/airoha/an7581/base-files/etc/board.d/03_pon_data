#!/bin/sh

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

# UBI rounds the declared image size up to full logical eraseblocks.
pon_data_target()
{
	json_add_object "$1"
	json_add_string type "$2"
	json_add_int size "$3"
	[ "$2" = ubi ] && json_add_string parent ubi
	json_close_object
}

board_config_update
case "$(board_name)" in
fiberhome,hg5585f-ct|fiberhome,hg5585f-cu)
	json_add_object pon_data
	pon_data_target factory ubi 1048576
	json_close_object
	;;
esac
board_config_flush
