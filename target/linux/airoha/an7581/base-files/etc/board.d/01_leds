. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
airoha,an7581-evb)
	ucidef_set_led_usbport "usb1" "USB 1" "green:usb-1" "usb1-port1" "usb2-port1"
	ucidef_set_led_usbport "usb2" "USB 2" "green:usb-2" "usb3-port1" "usb4-port1"
	;;
h3c,hm2004-du|\
nokia,xg-040g-md-ubi|\
nokia,xg-040g-tf-ubi)
	ucidef_set_led_netdev "lan2" "lan2" "mt7530-0:0a:green:lan-2" "lan2" "link tx rx"
	ucidef_set_led_netdev "lan3" "lan3" "mt7530-0:0b:green:lan-3" "lan3" "link tx rx"
	ucidef_set_led_netdev "lan4" "lan4" "mt7530-0:0c:green:lan-4" "lan4" "link tx rx"
	;;
fiberhome,hg5585f-ct)
	# No GE port or USB3.0 LED on this panel.
	ucidef_set_led_usbport "usb1" "USB 1" "blue:usb-1" "usb3-port1" "usb4-port1"
	;;

fiberhome,hg5585f-cu)
	ucidef_set_led_netdev "lan1" "lan1" "blue:lan-1" "lan1" "link tx rx"
	ucidef_set_led_netdev "lan2" "lan2" "blue:lan-2" "lan2" "link tx rx"
	ucidef_set_led_netdev "lan3" "lan3" "blue:lan-3" "lan3" "link tx rx"
	ucidef_set_led_netdev "lan4" "lan4" "blue:lan-4" "lan4" "link tx rx"
	# The USB2.0 port is usb1 (bus 3 and 4), the USB3.0 port is usb0 (bus 1 and 2).
	ucidef_set_led_usbport "usb1" "USB 1" "blue:usb-1" "usb3-port1" "usb4-port1"
	ucidef_set_led_usbport "usb2" "USB 2" "blue:usb-2" "usb1-port1" "usb2-port1"
	;;

esac

[ "$board" = "h3c,hm2004-du" ] && ucidef_set_led_netdev "wlan" "wlan" "green:wlan" "phy0-ap0" "link"

board_config_flush

exit 0
