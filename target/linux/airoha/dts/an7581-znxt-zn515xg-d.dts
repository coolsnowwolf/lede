/dts-v1/;

/* Firmware reserves the first 2 MiB of DRAM. */
/memreserve/ 0x80000000 0x200000;

#include "an7581-znxt-zn50xg-d-common.dtsi"

/ {
	model = "ZNXT ZN515XG-D";
	compatible = "znxt,zn515xg-d", "airoha,an7581", "airoha,en7581";

	keys {
		key-wifi {
			label = "wifi";
			linux,code = <KEY_RFKILL>;
			/* The wireless button is connected to active-low GPIO4. */
			gpios = <&en7581_pinctrl 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		led-wlan {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			/* The active-low wireless LED is connected to GPIO15. */
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
		};

		led-usb2 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_USB;
			function-enumerator = <2>;
			/* The active-low USB2 LED is connected to GPIO34. */
			gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "usbport";
			trigger-sources = <&usb_port2>;
		};
	};
};

&znxt_proline_layout {
	/* Radio fields place the X-PON serial at factory offset 0x141063. */
	pon_serial: pon-serial@141063 {
		reg = <0x00141063 0x0000000c>;
	};
};

&xpon_mac {
	nvmem-cells = <&pon_serial>;
};

/* The second external USB port carries USB2 signals. */
&usb1 {
	status = "okay";
	mediatek,u3p-dis-msk = <0x1>;
	phys = <&usb1_phy PHY_TYPE_USB2>;
	vusb33-supply = <&reg_3p3v>;
	#address-cells = <1>;
	#size-cells = <0>;

	usb_port2: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};

&en7581_pinctrl {
	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};
};

/*
 * MT7916D HIF2 is 14c3:790a on PCIe0. The primary HIF on PCIe1 obtains
 * its secondary registers and interrupt through this function.
 */
/* The wireless PCIe links negotiate Gen2 when the root ports advertise it. */
&pcie0 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
		};
	};
};

/*
 * 14c3:7906 is the primary interface. mediatek,eeprom-merge-otp merges
 * per-device iCal fields from the chip into the EEPROM template.
 */
&pcie1 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			mediatek,eeprom-merge-otp;
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;

			band@0 {
				reg = <0>;
				nvmem-cells = <&macaddr_factory 4>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				reg = <1>;
				nvmem-cells = <&macaddr_factory 5>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};
