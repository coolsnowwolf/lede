/* Firmware reserves the first 2 MiB of DRAM. */
/memreserve/ 0x80000000 0x200000;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7581.dtsi"
#include "an7581-fiberhome-ubi-parts.dtsi"

/* Board resources shared by the FiberHome HG5585F variants. */

/ {
	aliases {
		/* OpenWrt diag state controls the power LED. */
		led-boot = &led_power_blue;
		led-failsafe = &led_power_blue;
		led-running = &led_power_blue;
		led-upgrade = &led_power_blue;

		serial0 = &uart1;
	};

	chosen {
		/* fitblk locates the FIT-embedded read-only rootfs through this volume. */
		rootdisk = <&ubi_fit>;
		bootargs = "console=ttyS0,115200 earlycon";
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x20000000>;
	};

	reg_usb_3p3v: regulator-usb-3p3v {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "usb-3.3V";
	};

	keys {
		compatible = "gpio-keys";

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			/*
			 * The reset key drives GPIO35 low, i.e. GPIO_DATA1 bit 3.
			 * Keep this in sync with the U-Boot copy, which starts
			 * HTTP recovery when the key is held during boot. GPIO0 is
			 * the uart1_txd pin and never sees the key.
			 */
			gpios = <&en7581_pinctrl 35 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		/* Handled by /etc/rc.button/wps. */
		key-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&en7581_pinctrl 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		/* Handled by /etc/rc.button/rfkill, toggles the WLAN radio. */
		key-rfkill {
			label = "rfkill";
			linux,code = <KEY_RFKILL>;
			gpios = <&en7581_pinctrl 3 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/*
		 * All panel LEDs are active low. The CU variant is green and
		 * the CT variant is blue, so every LED is named blue here:
		 * only the sysfs name differs, not the wiring.
		 */

		/* Active-low power LED on GPIO13. */
		led_power_blue: led-0 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&en7581_pinctrl 13 GPIO_ACTIVE_LOW>;
		};

		/* PON registration maps O1-O3 to fast blink, O4 to slow blink, and O5 on. */
		led-2 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 14 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-registration";
		};

		/* The LOS LED follows optical signal loss. */
		led-3 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&en7581_pinctrl 16 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-los";
		};

		/* Internet / broadband, follows the xPON online state. */
		led-internet {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN_ONLINE;
			gpios = <&en7581_pinctrl 5 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pon0-online";
		};

		/* Lit while the WLAN radio is up. */
		led-wlan {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN;
			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0radio";
		};

		/* POTS line indicator. */
		led-phone {
			label = "blue:phone";
			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
		};

		/* USB2.0 port, marked USB1 on the silkscreen. */
		led-usb1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_USB;
			function-enumerator = <1>;
			gpios = <&en7581_pinctrl 6 GPIO_ACTIVE_LOW>;
		};

		/* USB3.0 port, marked USB2 on the silkscreen. */
		led-usb2 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_USB;
			function-enumerator = <2>;
			gpios = <&en7581_pinctrl 8 GPIO_ACTIVE_LOW>;
		};

		/*
		 * Four panel GE ports. The netdev trigger needs a device name,
		 * so it is set in board.d/01_leds instead.
		 */
		led-lan1 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <1>;
			gpios = <&en7581_pinctrl 43 GPIO_ACTIVE_LOW>;
		};

		led-lan2 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <2>;
			gpios = <&en7581_pinctrl 44 GPIO_ACTIVE_LOW>;
		};

		led-lan3 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <3>;
			gpios = <&en7581_pinctrl 45 GPIO_ACTIVE_LOW>;
		};

		led-lan4 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_LAN;
			function-enumerator = <4>;
			gpios = <&en7581_pinctrl 46 GPIO_ACTIVE_LOW>;
		};
	};
};

&en7581_pinctrl {
	/* GPIO0 starts at pin 13 on AN7581. */
	gpio-ranges = <&en7581_pinctrl 0 13 50>;

	pon_pins: pon-pins {
		mux {
			/* Leave GPIO38/TX_DISABLE under optical frontend control. */
			function = "pon";
			groups = "pon_tx_disable_gpio";
		};
	};

	mdio_pins: mdio-pins {
		mux {
			function = "mdio";
			groups = "mdio";
		};
	};

	pnand_pins: pnand-pins {
		mux {
			/*
			 * Parallel NAND claims pins 4-7 (spi_cs0/clk/mosi/miso,
			 * no GPIO number) and pins 30-42. With the gpio-ranges
			 * offset of 13 below, that is GPIO17-29 - not GPIO4-7
			 * and GPIO30-42. GPIO3/4/35 stay free for the keys.
			 */
			function = "pnand";
			groups = "pnand";
		};
	};

	pcie0_rst_pins: pcie0-rst-pins {
		conf {
			/* PCIe0 provides the board reset line for MT7916D HIF2. */
			pins = "pcie_reset0";
			drive-open-drain = <1>;
		};
	};

	pcie1_rst_pins: pcie1-rst-pins {
		conf {
			/* The primary MT7916D HIF uses PCIe1. */
			pins = "pcie_reset1";
			drive-open-drain = <1>;
		};
	};
};

&{/soc} {
	/* HG5585F uses an 8-bit TSOP48 parallel NAND. */
	/delete-node/ spi@1fa10000;
};

&npu {
	status = "okay";
};

&eth {
	status = "okay";
};

&gdm1 {
	nvmem-cells = <&fiberhome_base_mac 1>;
	nvmem-cell-names = "mac-address";
	status = "okay";
};

&switch {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";
};

/* Internal PHY2, PHY3, and PHY4 provide three copper ports. */
&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};

&fiberhome_factory_nvmem {
	/* The MT7916 EEPROM precedes the shared identity area. */
	wifi_eeprom: eeprom@1000 {
		reg = <0x1000 0x1000>;
	};
};

/*
 * MT7916D enumerates through two PCIe HIFs: 14c3:7906 on PCIe1 is primary,
 * while PCIe0 provides HIF2.
 */
/* The wireless PCIe links negotiate Gen2 when the root ports advertise it. */
&pcie0 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
		};
	};
};

&pcie1 {
	status = "okay";
	max-link-speed = <2>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_rst_pins>;

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			nvmem-cells = <&wifi_eeprom>;
			nvmem-cell-names = "eeprom";
			airoha,npu = <&npu>;
			airoha,eth = <&eth>;
		};
	};
};

&i2c0 {
	status = "okay";

	hg5585f_bosa: optical-front-end@51 {
		/* Board data identifies either GN or UX compatible optical frontends. */
		compatible = "fiberhome,hg5x-bosa", "airoha,paged-bosa";
		reg = <0x51>;
		fiberhome,ben-active-high;
		nvmem-cells = <&pon_calibration>;
		nvmem-cell-names = "calibration";
		tx-disable-gpios = <&en7581_pinctrl 38 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&pon_pcs {
	status = "okay";
};

&xpon_mac {
	pinctrl-names = "default";
	pinctrl-0 = <&pon_pins>;
	optical-front-end = <&hg5585f_bosa>;
	data-path = <&gdm2>;
	nvmem-cells = <&fiberhome_pon_serial>;
	nvmem-cell-names = "pon-serial";
	status = "okay";
};

&gdm2 {
	nvmem-cells = <&fiberhome_base_mac 0>;
	nvmem-cell-names = "mac-address";
	airoha,pon-data-path;
	status = "okay";
};

&usb0 {
	/* The USB3 port combines a USB2 companion with the SuperSpeed lane. */
	status = "okay";
	vusb33-supply = <&reg_usb_3p3v>;
};

&usb1 {
	/* The second port uses the USB2 PHY. */
	status = "okay";
	mediatek,u3p-dis-msk = <0x1>;
	phys = <&usb1_phy PHY_TYPE_USB2>;
	vusb33-supply = <&reg_usb_3p3v>;
};
