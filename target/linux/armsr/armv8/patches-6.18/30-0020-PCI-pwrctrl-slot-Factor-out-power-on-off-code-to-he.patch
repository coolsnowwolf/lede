 	struct pci_pwrctrl pwrctrl;
 	struct regulator_bulk_data *supplies;
 	int num_supplies;
+	struct clk *clk;
+	bool powered;
 };
 
-static void devm_slot_pwrctrl_power_off(void *data)
+static int slot_pwrctrl_power_on(struct pci_pwrctrl *pwrctrl)
+{
+	struct slot_pwrctrl *slot = container_of(pwrctrl, struct slot_pwrctrl,
+					       pwrctrl);
+	int ret;
+
+	if (slot->powered)
+		return 0;
+
+	ret = regulator_bulk_enable(slot->num_supplies, slot->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(slot->clk);
+	if (ret) {
+		regulator_bulk_disable(slot->num_supplies, slot->supplies);
+		return ret;
+	}
+
+	slot->powered = true;
+	return 0;
+}
+
+static int slot_pwrctrl_power_off(struct pci_pwrctrl *pwrctrl)
+{
+	struct slot_pwrctrl *slot = container_of(pwrctrl, struct slot_pwrctrl,
+					       pwrctrl);
+	int ret;
+
+	if (!slot->powered)
+		return 0;
+
+	clk_disable_unprepare(slot->clk);
+	ret = regulator_bulk_disable(slot->num_supplies, slot->supplies);
+	if (ret) {
+		int clk_ret = clk_prepare_enable(slot->clk);
+
+		if (clk_ret)
+			dev_err(pwrctrl->dev, "Failed to restore slot clock: %d\n", clk_ret);
+		return ret;
+	}
+
+	slot->powered = false;
+	return 0;
+}
+
+static void devm_slot_pwrctrl_release(void *data)
 {
 	struct slot_pwrctrl *slot = data;
 
-	regulator_bulk_disable(slot->num_supplies, slot->supplies);
+	slot_pwrctrl_power_off(&slot->pwrctrl);
 	regulator_bulk_free(slot->num_supplies, slot->supplies);
 	kfree(slot->supplies);
 }
