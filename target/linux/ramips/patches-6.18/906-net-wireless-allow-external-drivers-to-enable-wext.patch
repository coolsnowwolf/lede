From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] net: wireless: allow external drivers to enable WEXT

Vendor wireless drivers built outside the kernel tree cannot select the
hidden WIRELESS_EXT symbol.  Give it a prompt so target configurations can
retain WEXT event and private ioctl support for mtwifi.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/net/wireless/Kconfig
+++ b/net/wireless/Kconfig
@@ -1,6 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config WIRELESS_EXT
-	bool
+	bool "Wireless extensions"
 
 config WEXT_CORE
 	def_bool y
@@ -11,7 +11,7 @@
 	depends on WEXT_CORE
 
 config WEXT_PRIV
-	bool
+	bool "Wireless extensions private ioctls"
 
 config CFG80211
 	tristate "cfg80211 - wireless configuration API"
