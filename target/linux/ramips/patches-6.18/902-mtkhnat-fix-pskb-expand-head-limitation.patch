From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] net: preserve MediaTek HNAT metadata when expanding skb

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/net/core/skbuff.c
+++ b/net/core/skbuff.c
@@ -79,6 +79,7 @@
 #include <net/mpls.h>
 #include <net/mptcp.h>
 #include <net/mctp.h>
+#include <net/ra_nat.h>
 #include <net/page_pool/helpers.h>
 #include <net/psp/types.h>
 #include <net/dropreason.h>
@@ -2273,6 +2274,9 @@
 	       skb_shinfo(skb),
 	       offsetof(struct skb_shared_info, frags[skb_shinfo(skb)->nr_frags]));
 
+	/* Preserve the HNAT metadata stored ahead of skb->data. */
+	memcpy(data, skb->head, FOE_INFO_LEN);
+
 	/*
 	 * if shinfo is shared we must drop the old head gracefully, but if it
 	 * is not we can just drop the old head and let the existing refcount
