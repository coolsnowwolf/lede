From: coolsnowwolf <coolsnowwolf@gmail.com>
Subject: [PATCH] elftosb: support native Darwin builds

Select a Darwin build directory and executable names, and link against
the C++ runtime provided by the macOS SDK.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/makefile
+++ b/makefile
@@ -23,6 +23,10 @@
 endif
 endif
 
+ifeq ("${UNAMES}", "Darwin")
+SRC_DIR = $(shell pwd)
+BUILD_DIR = bld/darwin
+endif
 
 #*******************************************************************************
 #                                 Targets
--- a/makefile.rules
+++ b/makefile.rules
@@ -116,6 +116,12 @@
 endif # ifeq ("${UNAMES}", "CYGWIN_NT-5.1")
 endif # ifeq ("${UNAMES}", "Linux")
 
+ifeq ("${UNAMES}", "Darwin")
+LIBS = -lc++ -lm
+EXEC_FILE_ELFTOSB2 = elftosb
+EXEC_FILE_SBTOOL = sbtool
+EXEC_FILE_KEYGEN = keygen
+endif
 
 #*******************************************************************************
 #                                 Targets
