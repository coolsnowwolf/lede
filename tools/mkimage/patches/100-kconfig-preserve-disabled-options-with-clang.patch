From: Yao Zi <ziyao@disroot.org>
Subject: [PATCH] kconfig: preserve disabled options with Clang preprocessing

Clang adds whitespace before preprocessed Kconfig comments. Remove it so
explicitly disabled board and host-tool options are retained instead of
reverting to their defaults.

Upstream: https://github.com/u-boot/u-boot/commit/252cd205300c1b9945079c0ae1fe5980ef9dfa56
Signed-off-by: Yao Zi <ziyao@disroot.org>
Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/scripts/kconfig/Makefile
+++ b/scripts/kconfig/Makefile
@@ -94,6 +94,7 @@
 
 %_defconfig: $(obj)/conf
 	$(Q)$(CPP) -nostdinc -P -I $(srctree) -undef -x assembler-with-cpp $(srctree)/arch/$(SRCARCH)/configs/$@ -o generated_defconfig
+	$(Q)sed -i -e 's/^[[:space:]]//' generated_defconfig
 	$(Q)$< $(silent) --defconfig=generated_defconfig $(Kconfig)
 
 # Added for U-Boot (backward compatibility)
