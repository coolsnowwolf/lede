Subject: [PATCH] Keep thread affinity calls within supported platforms

The musl workaround sets affinity after creating the thread. Guard this
Linux-specific call with the upstream capability macro so it also builds
on macOS, where pthread_setaffinity_np is unavailable.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/C/Threads.c
+++ b/C/Threads.c
@@ -265,7 +265,7 @@
       */
 
       // ret2 =
-      pthread_attr_setaffinity_np(&attr, sizeof(*cpuSet), cpuSet);
+      //pthread_attr_setaffinity_np(&attr, sizeof(*cpuSet), cpuSet);
       // if (ret2) ret = ret2;
 #endif
     }
@@ -275,14 +275,14 @@
     if (!ret)
     {
       p->_created = 1;
-      /*
+#ifdef Z7_AFFINITY_SUPPORTED
       if (cpuSet)
       {
         // ret2 =
         pthread_setaffinity_np(p->_tid, sizeof(*cpuSet), cpuSet);
         // if (ret2) ret = ret2;
       }
-      */
+#endif
     }
   }
   // ret2 =
--- a/C/Threads.h
+++ b/C/Threads.h
@@ -29,6 +29,7 @@
 #endif
 
 #include <pthread.h>
+#include <sched.h>
 
 #endif
 
