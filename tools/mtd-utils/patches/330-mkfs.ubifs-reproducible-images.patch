 		if (squash_owner)
 			root_st.st_uid = root_st.st_gid = 0;
 	} else {
-		root_st.st_mtime = time(NULL);
+		root_st.st_mtime = clamp_time(time(NULL));
 		root_st.st_atime = root_st.st_ctime = root_st.st_mtime;
 		root_st.st_mode = mode;
 	}
@@ -2554,7 +2653,8 @@
