 	struct stat st;
-	char *endp;
+	char *endp, *env;
 #ifdef WITH_CRYPTO
 	const char *cipher_name = NULL;
 #endif
 
+	env = getenv("SOURCE_DATE_EPOCH");
+	if (env && *env) {
+		errno = 0;
+		source_date_epoch = strtoll(env, &endp, 10);
+		if (errno || *endp || source_date_epoch < 0)
