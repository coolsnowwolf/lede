 "-h, --help               display this help text\n\n"
 "Note, SIZE is specified in bytes, but it may also be specified in Kilobytes,\n"
 "Megabytes, and Gigabytes if a KiB, MiB, or GiB suffix is used.\n\n"
@@ -540,17 +547,39 @@
 #endif
 }
 
+/* Take the node ID from the first 12 of at least 12 hex digits */
+static int parse_uuid_node(const char *str)
+{
+	int i;
+
+	if (strlen(str) < 12 || str[strspn(str, "0123456789abcdefABCDEF")])
+		return -1;
+	for (i = 0; i < 6; i++)
+		if (sscanf(str + 2 * i, "%2hhx", &uuid_node[i]) != 1)
+			return -1;
+	uuid_node_set = 1;
+	return 0;
+}
+
 static int get_options(int argc, char**argv)
 {
